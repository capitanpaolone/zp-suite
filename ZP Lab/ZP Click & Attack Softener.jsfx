gfx_set(slider6 >= 0.5 ? c_cyan_r : line_r, slider6 >= 0.5 ? c_cyan_g : line_g, slider6 >= 0.5 ? c_cyan_b : line_b, 0.95);
zp_rect(496, 92, 350, 3);

// LED gioiello cliccabile + titolo 2 · ATTACK SOFTENER
led2_hov = zp_mx >= 504 && zp_mx <= 526 && zp_my >= 100 && zp_my <= 122;
led2_hov ? strcpy(#hint, "Clic per attivare o bypassare lo stadio 2 Attack Softener.");
led2_hov && mouse_down && delta_spring_armed ? (ui_hold_delta_stage = 2;);
draw_hw_led(515, 111, 5.0, slider6 >= 0.5, led2_hov, c_cyan_r, c_cyan_g, c_cyan_b);
led2_hov && btn_click ? set_param(6, slider6 >= 0.5 ? 0 : 1);
zp_setfont(2, "Arial", 13, 'b'); gfx_set(txt_r, txt_g, txt_b, slider6 >= 0.5 ? 1 : 0.55);
