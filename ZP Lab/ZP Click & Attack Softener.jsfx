// LED gioiello cliccabile + titolo 1 · MACRO CLICK
led1_hov = zp_mx >= 22 && zp_mx <= 44 && zp_my >= 100 && zp_my <= 122;
led1_hov ? strcpy(#hint, "Clic per attivare o bypassare lo stadio 1A Macro Click (impulsi macro 0,5-4 ms).");
led1_hov && mouse_down && delta_spring_armed ? (ui_hold_delta_stage = 1;);
draw_hw_led(33, 111, 5.0, slider1 >= 0.5, led1_hov, c_coral_r, c_coral_g, c_coral_b);
led1_hov && btn_click ? set_param(1, slider1 >= 0.5 ? 0 : 1);
zp_setfont(2, "Arial", 13, 'b'); gfx_set(txt_r, txt_g, txt_b, slider1 >= 0.5 ? 1 : 0.55);
zp_gx = 46; zp_gy = 103; zp_drawstr("1 · MACRO CLICK");
sprintf(#g1s, "-%.1f dB", ui_ck_hold);
zp_setfont(1, "Arial", 11, 'b'); gfx_set(ui_ck_hold > 0.3 ? c_coral_r : sub_r, ui_ck_hold > 0.3 ? c_coral_g : sub_g, ui_ck_hold > 0.3 ? c_coral_b : sub_b, 1);
(gfx_measurestr(#g1s, tw, th); tw /= zp_sc; th /= zp_sc);
zp_gx = 238 - tw; zp_gy = 105; zp_drawstr(#g1s);

gfx_set(line_r, line_g, line_b, 0.7); zp_line(246, 100, 246, 122);
mr_on_ui = slider19 >= 0.5;
// LED gioiello cliccabile + pulsante MICRO-CLICK
led4_hov = zp_mx >= 254 && zp_mx <= 274 && zp_my >= 100 && zp_my <= 122;
led4_hov ? strcpy(#hint, "Clic per attivare o spegnere MICRO-CLICK spettrale (>1 kHz, zero micro-distorsioni).");
led4_hov && mouse_down && delta_spring_armed ? (ui_hold_delta_stage = 4;);
draw_hw_led(264, 111, 5.0, mr_on_ui, led4_hov, c_amber_r, c_amber_g, c_amber_b);
led4_hov && btn_click ? set_param(19, mr_on_ui ? 0 : 1);
ui_btn(278, 100, 104, 22, mr_on_ui ? "MICRO-CLICK" : "MICRO: OFF", mr_on_ui, c_amber_r, c_amber_g, c_amber_b,
  "Attiva il motore spettrale STFT (>1 kHz) per i micro-impulsi dentro e ai bordi delle consonanti.", 4) ? set_param(19, mr_on_ui ? 0 : 1);
sprintf(#g4s, "-%.1f dB", ui_mr_hold);
zp_setfont(1, "Arial", 11, 'b'); gfx_set((mr_on_ui && ui_mr_hold > 0.3) ? c_amber_r : sub_r, (mr_on_ui && ui_mr_hold > 0.3) ? c_amber_g : sub_g, (mr_on_ui && ui_mr_hold > 0.3) ? c_amber_b : sub_b, 1);
(gfx_measurestr(#g4s, tw, th); tw /= zp_sc; th /= zp_sc);
zp_gx = 476 - tw; zp_gy = 105; zp_drawstr(#g4s);

ui_knob(2, 58,  166, 19, 0, 100, 62, 0, "Sensibilita'", c_coral_r, c_coral_g, c_coral_b,
  "Sensibilita' rilevamento (guida sia Macro Click sia la soglia spettrale di Micro-Click).", 1);
ui_knob(3, 132, 166, 19, 0, 18,  14, 1, "Max Cut",      c_coral_r, c_coral_g, c_coral_b,
  "Massima attenuazione applicata dallo stadio Macro Click.", 1);
ui_knob(4, 206, 166, 19, 0, 100, 55, 0, "Prot. Cons.",  c_coral_r, c_coral_g, c_coral_b,
  "Protezione consonanti esplosive (p/t/k) su Macro Click e Micro-Click.", 1);

gfx_set(line_r, line_g, line_b, 0.7); zp_line(246, 134, 246, 220);

ui_knob(20, 296, 166, 19, 0, 100, 65, 0, "Micro %",
  mr_on_ui ? c_amber_r : sub_r, mr_on_ui ? c_amber_g : sub_g, mr_on_ui ? c_amber_b : sub_b,
  "Intensita' Micro-Click spettrale (slider20): automatizzabile in REAPER per agire solo dove serve!", 4);
zp_setfont(1, "Arial", 9); gfx_set(mr_on_ui ? c_amber_r : sub_r, mr_on_ui ? c_amber_g : sub_g, mr_on_ui ? c_amber_b : sub_b, 0.85);
(gfx_measurestr("autom.", tw, th); tw /= zp_sc; th /= zp_sc);
zp_gx = 296 - tw * 0.5; zp_gy = 205; zp_drawstr("autom.");

gfx_set(line_r, line_g, line_b, 0.7); zp_line(348, 134, 348, 220);

sk_col_r = skew_eff > 0.05 ? c_cyan_r : skew_eff < -0.05 ? c_coral_r : c_amber_r;
sk_col_g = skew_eff > 0.05 ? c_cyan_g : skew_eff < -0.05 ? c_coral_g : c_amber_g;
sk_col_b = skew_eff > 0.05 ? c_cyan_b : skew_eff < -0.05 ? c_coral_b : c_amber_b;
ui_knob(22, 414, 166, 19, -10, 10, 0, 4, "Freq Skew", sk_col_r, sk_col_g, sk_col_b,
  "Bilanciamento continuo Low <-> Air (-10..+10): negativo scende fino a 380 Hz (click bassi/umidi), positivo spinge su Air (4-16 kHz).", mr_on_ui ? 4 : 1);
mr_floor_hz >= 1000 ? sprintf(#skhz, "da %.1f kHz", mr_floor_hz * 0.001) : sprintf(#skhz, "da %.0f Hz", mr_floor_hz);
zp_setfont(1, "Arial", 9); gfx_set(sub_r, sub_g, sub_b, 0.9);
(gfx_measurestr(#skhz, tw, th); tw /= zp_sc; th /= zp_sc);
zp_gx = 414 - tw * 0.5; zp_gy = 205; zp_drawstr(#skhz);

zp_setfont(1, "Arial", 10, 'b'); gfx_set(sub_r, sub_g, sub_b, 1);
zp_gx = 24; zp_gy = 236; zp_drawstr("MACRO CLICK (0..18 dB)");
gfx_set(trk_r, trk_g, trk_b, 1); zp_rect(24, 252, 214, 12);
gfx_set(line_r, line_g, line_b, 1); zp_frame(24, 252, 214, 12);
ck_w = min(212, max(0, (ui_ck_gr / 18.0) * 212));
ck_w > 0 ? (gfx_set(c_coral_r, c_coral_g, c_coral_b, 0.92); zp_rect(25, 253, ck_w, 10););
ck_hw = min(212, max(0, (ui_ck_hold / 18.0) * 212));
ck_hw > 1 ? (gfx_set(c_amber_r, c_amber_g, c_amber_b, 1); zp_rect(25 + ck_hw - 1, 251, 2, 14););

zp_setfont(1, "Arial", 10, 'b'); gfx_set(mr_on_ui ? txt_r : sub_r, mr_on_ui ? txt_g : sub_g, mr_on_ui ? txt_b : sub_b, mr_on_ui ? 0.9 : 0.65);
zp_gx = 254; zp_gy = 236; zp_drawstr("MICRO-CLICK (0..18 dB)");
gfx_set(trk_r, trk_g, trk_b, 1); zp_rect(254, 252, 222, 12);
gfx_set(line_r, line_g, line_b, 1); zp_frame(254, 252, 222, 12);
mr_w = min(220, max(0, (ui_mr_gr / 18.0) * 220));
mr_w > 0 ? (gfx_set(c_amber_r, c_amber_g, c_amber_b, 0.94); zp_rect(255, 253, mr_w, 10););
mr_hw_px = min(220, max(0, (ui_mr_hold / 18.0) * 220));
mr_hw_px > 1 ? (gfx_set(c_coral_r, c_coral_g, c_coral_b, 1); zp_rect(255 + mr_hw_px - 1, 251, 2, 14););

