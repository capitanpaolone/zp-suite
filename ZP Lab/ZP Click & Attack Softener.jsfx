// @description ZP Click & Attack Softener
// @version 1.4
// @author Paolo Balestri
// @license GPL-3.0-or-later
// @about
//   ### ZP Click & Attack Softener
//   Strumento a tre stadi in serie con latenza PDC fissa (~14,7 ms @ 48 kHz, zero salti in automazione):
//   1A. MACRO CLICK: attenuatore simmetrico pre/post a due bande con Protezione Consonanti (p/t/k).
//   1B. MICRO-CLICK (motore spettrale STFT attivabile + Micro % automatizzabile): analisi tempo-frequenza a finestra corta (5,3 ms, 75% Hann-COLA) con coerenza locale a tasche (~940 Hz) per catturare anche micro-sfrigolii risonanti ad alta frequenza dentro e tra le consonanti, guardia armonica sulle vocali piene e controllo continuo Freq Skew (Low <-> Air, 380 Hz..2,6 kHz).
//   2. ATTACK SOFTENER: arrotonda la punta iniziale degli attacchi duri solo sopra la frequenza di taglio (crossover SVF coerente di fase).
//   Include ascolto DELTA con auto-off a 30 s, D·MOLLA per isolare ogni stadio (Macro, Micro, Attack) e monitor eventi in tempo reale.
//
//   Three-stage vocal/acoustic cleaner and onset rounder with fixed automatic PDC (~14.7 ms @ 48 kHz, zero latency jumps under automation):
//   two-band Macro Click attenuator, switchable & automatable STFT spectral Micro-Click cleaner with local ~940 Hz pocket coherence, voiced harmonic guard, and continuous Freq Skew (Low <-> Air), plus phase-coherent Attack Softener.
//
//   Audio processing is self-contained; Cue Navigator is optional and only opens the help page from the ? button.
//
//   Sviluppata su un'idea di Paolo Balestri · Lato Cardioide (latocardioide.it)
// @changelog
//   v1.4: MICRO-CLICK aggiornato a coerenza locale a tasche scorrevoli (~940 Hz / 5 bin) + guardia glottica sulle vocali piene (< 800 Hz):
//     cattura anche i micro-sfrigolii risonanti stretti (es. 5-9 kHz tra consonanti come "l -> g") prima diluiti nella media larga 4-16 kHz,
//     mantenendo 0,00 dB di opacizzazione sul parlato pulito.
//   v1.3: Nuovo controllo continuo Freq Skew (-10..+10, Low <-> Air, slider22) in stile RX per calibrare pavimento (380 Hz..2,6 kHz)
//     e bilanciamento spettrale di Macro Click e Micro-Click in base alla ripresa (cattura anche i click bassi 450-1000 Hz senza toccare la fondamentale);
//     slider5 mantenuto per retrocompatibilita' dei progetti esistenti.
//   v1.2: Corretta la scala di ricostruzione ifft_real (0.25/N per guadagno unitario 0,00 dB e null DELTA esatto su MICRO-CLICK);
//     grafica uniformata al linguaggio hardware della ZP Suite (tasti retroilluminati con barra LED, LED gioiello cliccabili, pomelli hardware e pannelli satinati).
//   v1.1: Sostituito il motore time-domain AR(6) con il nuovo motore spettrale STFT MICRO-CLICK (fft_real/ifft_real 75% Hann-COLA,
//     banda protetta < 1 kHz per zero micro-distorsioni sulla fondamentale, attenuazione morbida verso il contesto locale per zero opacizzazione);
//     nomenclatura tecnica trasversale (MACRO CLICK, MICRO-CLICK + Micro %, Focus Mid-High 1-4k / Air 4k+).
//   v1.0: Primo stadio dedicato ai micro-impulsi nelle consonanti + controllo Amount (%) automatizzabile e uscita dalla beta.
//   v0.3: Rilevamento cambio samplerate in @block (ext_noinit=1) con azzeramento ring buffer e ricalcolo lookahead/coefficienti SVF.
//   v0.2: telemetria ZP Shared Bus v3 multi-istanza verso Master Pro (Macro Click GR, Attack GR, Click/s e alert DELTA).
//   v0.1: Prima versione tarata su ripresa microfonica e catena voce di Paolo.
desc:ZP Click & Attack Softener · latocardioide.it · dubbertools.com
options:gmem=ZPVoiceoverSharedBus
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

slider1:1<0,1,1{Off,On}>1A Macro · Engage
slider2:62<0,100,1>1A/1B · Sensibilita (%)
slider3:14<0,18,0.5>1A Macro · Max Cut (dB)
slider4:55<0,100,1>1A/1B · Protezione Consonanti (%)
slider5:0<0,2,1{Bilanciato,Mid-High 1-4k,Air 4k+}>Focus Banda [Legacy]
slider6:1<0,1,1{Off,On}>2 Attack · Engage
slider7:40<0,100,1>2 Attack · Soften (%)
slider8:10<3,25,0.5>2 Attack · Finestra (ms)
slider9:1200<600,3500,10>2 Attack · Freq. Taglio (Hz)
slider10:100<0,100,1>Mix (% Wet)
slider11:0<0,1,1{Off,On}>DELTA (Ascolta Rimosso)
slider12:0<0,4,1{Custom,PRE-CHAIN (Pulizia),POST-CHAIN (Morbidezza),TAKE SPORCO,DELICATO (Broadcast)}>Preset Rapido
slider13:0<0,1,1{Scuro,Chiaro}>Tema UI
slider14:0<0,1,1{GUI,JSFX (OSARA)}>Vista
slider16:0<0,18,0.1>[Read] 1A Macro GR (dB)
slider17:0<0,12,0.1>[Read] 2 Attack GR (dB)
slider18:0<0,60,1>[Read] Click rilevati / s
slider19:0<0,1,1{Off,On}>1B Micro · Engage (Spettrale)
slider20:65<0,100,1>1B Micro · Amount % (Autom.)
slider21:0<0,18,0.1>[Read] 1B Micro GR (dB)
slider22:0<-10,10,0.5>1A/1B · Freq Skew (Low <-> Air)

@init
ext_noinit = 1;

// Costanti matematiche senza notazione scientifica (EEL2)
TINY7 = 0.0000001;
EPS2  = 0.00002;
EPS3  = 0.00003;
LN10_20 = 20.0 / log(10.0);

// Mappa memoria completamente disgiunta (fft_real in 40960..41983, non attraversa mai 65536)
r_loL = 0; r_mdL = 2048; r_hiL = 4096;
r_loR = 6144; r_mdR = 8192; r_hiR = 10240;
r_am  = 12288; r_ah = 14336; r_al = 16384;

HIST_N = 240;
h_in = 20000; h_ck = 20256; h_at = 20512; h_mr = 20768;

// Ring buffer Dry esatto (4096 campioni/canale -> fino a 192 kHz)
r_rawL = 24576;
r_rawR = 28672;

// Buffer STFT Micro-Click (N <= 1024, tutti dentro 32768..43007)
st_win   = 32768; // 1024
st_inL   = 33792; // 1024
st_inR   = 34816; // 1024
st_outL  = 35840; // 1024
st_outR  = 36864; // 1024
st_wband = 37888; // 514
st_ex    = 38402; // 514
st_ref   = 38916; // 514
st_graw  = 39430; // 514
st_g     = 39944; // 514
st_fft   = 40960; // 1024 (40960..41983, lontano dal confine 65536)

// Storia circolare di 9 frame STFT (65536..88575, solo copia/lettura, mai passato a fft_real)
ST_H = 9;
st_histL = 65536; // 9 * 1024 = 9216
st_histR = 74752; // 9 * 1024 = 9216
st_histM = 83968; // 9 * 512  = 4608

function dsp_reset_state() (
  memset(0, 0, 18432);
  memset(24576, 0, 8192);
  memset(33792, 0, 4096);
  memset(40960, 0, 1024);
  memset(65536, 0, 23040);
  ic11L = ic21L = ic12L = ic22L = 0;
  ic11R = ic21R = ic12R = ic22R = 0;
  ring_p = 0; raw_p = 0;
  st_io_p = 0; st_hop_cnt = 0; st_fwr = 0;
  st_hop_diff = 0;
  post_sum1 = post_sum2 = post_lo = 0;
  cur_mr_db = 0;
);

!dsp_booted ? (
  memset(0, 0, 88600);
  f1 = f2 = fa = 0.000001;
  s1 = s2 = sa = 0.00002;
  g_ck1 = g_ck2 = g_att = 1.0;
  dsp_reset_state();
  prev_la = 0;
  prev_osara_preset = 0;
  ck_rate_cnt = 0; ck_rate_t = 0; ck_rate_disp = 0;
  ck_cool_spl = 0; ck_prev_trig = 0;
  ui_ck_gr = 0; ui_at_gr = 0; ui_mr_gr = 0;
  ui_ck_hold = 0; ui_at_hold = 0; ui_mr_hold = 0;
  mon_ck_pk = 0; mon_at_pk = 0; mon_mr_pk = 0; mon_in_pk = 0;
  mr_amt_s = max(0, min(1, slider20 * 0.01));
  dsp_booted = 1;
);

!ui_init ? (
  delta_spring_armed = 0;
  delta_spring_stage = 0;
  delta_spring_time = 0;
  delta_spring_aud_hb = 0;
  ui_hold_delta_stage = 0;
  prev_delta_on = 0;
  delta_arm_time = 0;
  help_open = 0;
  hist_pos = 0;
  hist_t = 0;
  ui_init = 1;
);

// Ponte guida Suite (? apre la guida se Cue Navigator e' attivo)
hb_seen = 0; hb_last = 0; hb_t = -10; help_warn_until = 0;
function help_bridge_alive() local(hb, now) (
  hb = gmem[3900]; now = time_precise();
  !hb_seen ? (hb_last = hb; hb_seen = 1) : hb != hb_last ? (hb_last = hb; hb_t = now);
  hb > 0 && now - hb_t < 3;
);
function help_bridge_open(plugin_id) (
  help_bridge_alive() ? (gmem[3902] = plugin_id; gmem[3903] += 1; help_warn_until = 0;)
  : (help_warn_until = time_precise() + 4.0);
);

function update_visibility() local(show, n) (
  show = slider14 >= 0.5;
  n = 1;
  loop(14, slider_show(2 ^ (n - 1), show); n += 1;);
  slider_show(2 ^ 15, show);
  slider_show(2 ^ 16, show);
  slider_show(2 ^ 17, show);
  slider_show(2 ^ 18, show);
  slider_show(2 ^ 19, show);
  slider_show(2 ^ 20, show);
  slider_show(2 ^ 21, show);
);

function stft_build_tables() local(i, k, df, sk_s, f_lo0, f_lo1, f_spl) (
  st_n = sr_safe <= 52000 ? 256 : (sr_safe <= 104000 ? 512 : 1024);
  st_hop = st_n / 4;
  st_half = st_n / 2;
  st_la = st_n + 4 * st_hop; // 512 @ 48k (10.67 ms), 1024 @ 96k, 2048 @ 192k
  st_ola_scale = 0.25 / st_n; // ifft_real(fft_real(x,N),N) = 2*N*x, 4-frame sqrt(Hann) OLA = 2.0 -> 1/(4*N) = 0.00 dB!
  st_eps = 0.0025 * (st_n / 256.0);
  st_plos_floor = 0.02 * (st_n / 256.0);

  // Finestra sqrt(Hann): analisi + sintesi = Hann esatta, somma 4 frame = 2.000000
  i = 0;
  loop(st_n,
    st_win[i] = sqrt(0.5 * (1.0 - cos(2.0 * $pi * i / st_n)));
    i += 1;
  );

  // Maschera spettrale guidata da Freq Skew (-10..+10):
  //   0 = pavimento 950 Hz (rampa 950..1450 Hz)
  // -10 = pavimento 380 Hz (rampa 380..620 Hz -> cattura click bassi/umidi restando sopra la fondamentale)
  // +10 = pavimento 2600 Hz (rampa 2600..3500 Hz -> solo micro-impulsi in aria)
  sk_s = max(-1.0, min(1.0, skew_eff * 0.1));
  f_lo0 = sk_s < 0 ? (950.0 + sk_s * 570.0) : (950.0 + sk_s * 1650.0);
  f_lo1 = sk_s < 0 ? (1450.0 + sk_s * 830.0) : (1450.0 + sk_s * 2050.0);
  f_spl = sk_s < 0 ? (4000.0 + sk_s * 1600.0) : (4000.0 + sk_s * 1500.0);
  mr_floor_hz = f_lo0;

  df = sr_safe / st_n;
  st_k_800 = max(2, floor(800.0 / df + 0.5));
  st_k_lo0 = max(2, floor(f_lo0 / df + 0.5));
  st_k_lo1 = max(st_k_lo0 + 1, floor(f_lo1 / df + 0.5));
  st_k_spl = max(st_k_lo1 + 1, floor(f_spl / df + 0.5));
  st_k_hi1 = min(st_half - 1, floor(16000.0 / df + 0.5));
  st_sub_hw = 2; // 5 bin adiacenti (~940 Hz) costanti a tutti i sample rate

  k = 0;
  loop(st_half,
    k < st_k_lo0 ? (
      st_wband[k] = 0.0;
    ) : k < st_k_lo1 ? (
      st_wband[k] = (k - st_k_lo0) / (st_k_lo1 - st_k_lo0);
    ) : k <= st_k_hi1 ? (
      st_wband[k] = 1.0;
    ) : (
      st_wband[k] = max(0.0, 1.0 - (k - st_k_hi1) / max(1.0, st_half - st_k_hi1));
    );
    k += 1;
  );
);

function stft_process_hop(is_mono_hop) local(
  i, idx, k, j, ka, kb, b_wr, b_mwr, re, im,
  c, fm4, fm3, fp3, fp4, b_cL, b_cR, b_mc, b_m4, b_m3, b_p3, b_p4,
  mc, pre, post, f_bi, f_mn, ex_pre, ex_post, e_bi, e_on, e_off, ex,
  e_lo_c, e_lo_pre, e_lo_post, loc_sum, loc_avg, fw_k, dom_db, v_guard,
  sc_k, any_hit, plos_guard, conf_k, wb, g_tgt, b_conf, min_g, red_db, g_k
) (
  b_wr  = st_fwr * 1024;
  b_mwr = st_fwr * 512;

  // 1. Analisi FFT reale canale L
  i = 0; idx = st_io_p;
  loop(st_n,
    st_fft[i] = st_inL[idx] * st_win[i];
    idx += 1; idx >= st_n ? idx = 0;
    i += 1;
  );
  fft_real(st_fft, st_n);
  fft_permute(st_fft, st_half);
  memcpy(st_histL + b_wr, st_fft, st_n);

  // 2. Analisi canale R (copia istantanea se dual-mono)
  is_mono_hop ? (
    memcpy(st_histR + b_wr, st_fft, st_n);
    st_histM[b_mwr] = abs(st_fft[0]);
    k = 1;
    loop(st_half - 1,
      re = st_fft[2 * k]; im = st_fft[2 * k + 1];
      st_histM[b_mwr + k] = sqrt(re * re + im * im);
      k += 1;
    );
  ) : (
    i = 0; idx = st_io_p;
    loop(st_n,
      st_fft[i] = st_inR[idx] * st_win[i];
      idx += 1; idx >= st_n ? idx = 0;
      i += 1;
    );
    fft_real(st_fft, st_n);
    fft_permute(st_fft, st_half);
    memcpy(st_histR + b_wr, st_fft, st_n);
    st_histM[b_mwr] = max(abs(st_histL[b_wr]), abs(st_fft[0]));
    k = 1;
    loop(st_half - 1,
      re = st_histL[b_wr + 2 * k]; im = st_histL[b_wr + 2 * k + 1];
      mc = sqrt(re * re + im * im);
      re = st_fft[2 * k]; im = st_fft[2 * k + 1];
      st_histM[b_mwr + k] = max(mc, sqrt(re * re + im * im));
      k += 1;
    );
  );

  // 3. Frame centrale c = (st_fwr - 4) mod 9, fianchi puliti a +-3, +-4 hop (4,0..5,3 ms di distanza)
  c   = st_fwr - 4; c   < 0 ? c   += ST_H;
  fm4 = st_fwr - 8; fm4 < 0 ? fm4 += ST_H;
  fm3 = st_fwr - 7; fm3 < 0 ? fm3 += ST_H;
  fp3 = st_fwr - 1; fp3 < 0 ? fp3 += ST_H;
  fp4 = st_fwr;

  b_cL = c * 1024; b_cR = c * 1024;
  b_mc = c * 512;  b_m4 = fm4 * 512; b_m3 = fm3 * 512; b_p3 = fp3 * 512; b_p4 = fp4 * 512;

  // Guadagno unitario di partenza su tutti i bin
  k = 0;
  loop(st_half, st_g[k] = 1.0; k += 1;);
  cur_mr_db = 0;

  mr_amt_s > 0.001 ? (
    // Energia fondamentale (< 800 Hz) per guardia glottica sulle vocali piene + Protezione Consonanti (p/t/k)
    e_lo_c = 0;
    k = 1;
    loop(max(0, st_k_800 - 1),
      e_lo_c += st_histM[b_mc + k];
      k += 1;
    );
    e_lo_c /= max(1, st_k_800 - 1);

    e_lo_pre = 0; e_lo_post = 0;
    k = 1;
    loop(max(0, st_k_lo0 - 1),
      e_lo_pre  += st_histM[b_m3 + k];
      e_lo_post += st_histM[b_p3 + k];
      k += 1;
    );
    plos_guard = (e_lo_post > 2.2 * e_lo_pre + st_plos_floor) ? (1.0 - 0.65 * gw) : 1.0;

    k = st_k_lo0;
    loop(st_k_hi1 - st_k_lo0 + 1,
      mc   = st_histM[b_mc + k];
      pre  = 0.5 * (st_histM[b_m4 + k] + st_histM[b_m3 + k]);
      post = 0.5 * (st_histM[b_p3 + k] + st_histM[b_p4 + k]);
      f_bi = max(pre, post);
      f_mn = min(pre, post);

      ex_pre  = log((mc + st_eps) / (pre  + st_eps)) * LN10_20;
      ex_post = log((mc + st_eps) / (post + st_eps)) * LN10_20;
      e_bi  = min(ex_pre, ex_post);
      e_on  = min(ex_pre  - 3.5, ex_post + 1.2);
      e_off = min(ex_post - 3.5, ex_pre  + 1.2);
      ex = max(0.0, max(e_bi, max(e_on, e_off)));
      st_ex[k]  = ex;
      st_ref[k] = e_bi >= max(e_on, e_off) ? (0.5 * (pre + post)) : (0.35 * f_bi + 0.65 * f_mn);
      k += 1;
    );

    // Coerenza locale su tasche scorrevoli di 5 bin (~940 Hz): cattura sfrigolii stretti (es. 5-9 kHz) senza opacizzare le 's'
    k = 0;
    loop(st_half, st_graw[k] = 1.0; k += 1;);
    any_hit = 0;

    k = st_k_lo0;
    loop(st_k_hi1 - st_k_lo0 + 1,
      ka = max(st_k_lo0, k - st_sub_hw);
      kb = min(st_k_hi1, k + st_sub_hw);
      loc_sum = 0;
      j = ka;
      loop(kb - ka + 1,
        loc_sum += st_ex[j];
        j += 1;
      );
      loc_avg = loc_sum / (kb - ka + 1);
      fw_k = k < st_k_spl ? mr_fw1 : mr_fw2;

      // Guardia armonica sulle vocali piene (< 4 kHz): se la fondamentale < 800 Hz e' > 18 dB sopra, alza la soglia
      v_guard = 0.0;
      (k < st_k_spl && e_lo_c > st_plos_floor) ? (
        dom_db = log((e_lo_c + st_eps) / (st_histM[b_mc + k] + st_eps)) * LN10_20;
        dom_db > 18.0 ? (v_guard = min(6.0, (dom_db - 18.0) * 0.45););
      );

      sc_k = loc_avg * fw_k - (mr_base_thr + v_guard);
      ex = st_ex[k];
      wb = min(1.0, st_wband[k] * fw_k);
      (sc_k > 0.0 && ex > 2.0 && wb > 0.0) ? (
        any_hit = 1;
        conf_k = min(1.0, 0.55 + sc_k * 0.25) * mr_amt_s * plos_guard;
        mc = st_histM[b_mc + k];
        g_tgt = max(0.03, min(1.0, st_ref[k] / max(TINY7, mc)));
        b_conf = min(1.0, (ex - 2.0) / 4.0) * conf_k * wb;
        st_graw[k] = 1.0 - b_conf * (1.0 - g_tgt);
      );
      k += 1;
    );

    any_hit ? (
      // Smoothing spettrale a 3 bin per zero ringing ai bordi di banda
      min_g = 1.0;
      k = st_k_lo0;
      loop(st_k_hi1 - st_k_lo0 + 1,
        g_k = 0.25 * st_graw[k - 1] + 0.50 * st_graw[k] + 0.25 * st_graw[min(st_half - 1, k + 1)];
        st_g[k] = g_k;
        g_k < min_g ? (min_g = g_k;);
        k += 1;
      );

      red_db = max(0.0, -log(max(TINY7, min_g)) * LN10_20);
      cur_mr_db = min(18.0, red_db);
      (cur_mr_db > 2.0 && ck_cool_spl <= 0) ? (
        ck_rate_cnt += 1;
        ck_cool_spl = ck_cool_samples;
      );
    );
  );

  // 4. Sintesi IFFT reale canale L + overlap-add (DC e Nyquist sempre 1.0)
  st_fft[0] = st_histL[b_cL];
  st_fft[1] = st_histL[b_cL + 1];
  k = 1;
  loop(st_half - 1,
    g_k = st_g[k];
    st_fft[2 * k]     = st_histL[b_cL + 2 * k]     * g_k;
    st_fft[2 * k + 1] = st_histL[b_cL + 2 * k + 1] * g_k;
    k += 1;
  );
  fft_ipermute(st_fft, st_half);
  ifft_real(st_fft, st_n);
  i = 0; idx = st_io_p;
  loop(st_n,
    st_outL[idx] += st_fft[i] * st_win[i] * st_ola_scale;
    idx += 1; idx >= st_n ? idx = 0;
    i += 1;
  );

  // 5. Sintesi canale R (copia se dual-mono)
  is_mono_hop ? (
    i = 0; idx = st_io_p;
    loop(st_n,
      st_outR[idx] += st_fft[i] * st_win[i] * st_ola_scale;
      idx += 1; idx >= st_n ? idx = 0;
      i += 1;
    );
  ) : (
    st_fft[0] = st_histR[b_cR];
    st_fft[1] = st_histR[b_cR + 1];
    k = 1;
    loop(st_half - 1,
      g_k = st_g[k];
      st_fft[2 * k]     = st_histR[b_cR + 2 * k]     * g_k;
      st_fft[2 * k + 1] = st_histR[b_cR + 2 * k + 1] * g_k;
      k += 1;
    );
    fft_ipermute(st_fft, st_half);
    ifft_real(st_fft, st_n);
    i = 0; idx = st_io_p;
    loop(st_n,
      st_outR[idx] += st_fft[i] * st_win[i] * st_ola_scale;
      idx += 1; idx >= st_n ? idx = 0;
      i += 1;
    );
  );

  st_fwr += 1; st_fwr >= ST_H ? st_fwr = 0;
);

function update_params() local(g1, k1, g2, k2, foc, sk_s) (
  sr_safe = max(8000, srate);

  // Calcolo Freq Skew continuo (-10..+10) con retrocompatibilita' per progetti che usavano slider5 (0/1/2)
  foc = floor(slider5 + 0.5);
  skew_eff = max(-10.0, min(10.0, slider22 + (foc == 1 ? -4.0 : foc == 2 ? 4.0 : 0.0)));
  sk_s = skew_eff * 0.1;

  stft_build_tables();

  // Lookahead a valle per Macro Click + Attack Softener (~4.0 ms) + STFT (~10.67 ms) = PDC fisso ~14.7 ms @ 48 kHz
  LA_POST = max(32, min(1024, floor(sr_safe * 0.0040 + 0.5)));
  LA_TOT  = st_la + LA_POST;
  LOOK_TRIG  = max(4, min(LA_POST - 8, floor(sr_safe * 0.0014 + 0.5)));
  POST_START = max(LOOK_TRIG + 4, min(LA_POST - 4, floor(sr_safe * 0.0026 + 0.5)));
  POST_LEN   = max(1, LA_POST - POST_START);
  inv_post_len = 1.0 / POST_LEN;

  pdc_delay = LA_TOT;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  LA_TOT != prev_la ? (
    dsp_reset_state();
    prev_la = LA_TOT;
  );

  // Crossover SVF coerente di fase a 2 tagli (fc1 = Taglio Attacco, fc2 = 4200 Hz)
  att_fc = max(600, min(3500, slider9));
  g1 = tan($pi * min(0.45 * sr_safe, att_fc) / sr_safe);
  k1 = 1.41421356; // 1 / 0.70710678 (Butterworth)
  a1_1 = 1.0 / (1.0 + g1 * (g1 + k1));
  a2_1 = g1 * a1_1;
  a3_1 = g1 * a2_1;

  g2 = tan($pi * min(0.45 * sr_safe, 4200.0) / sr_safe);
  k2 = 1.41421356;
  a1_2 = 1.0 / (1.0 + g2 * (g2 + k2));
  a2_2 = g2 * a1_2;
  a3_2 = g2 * a2_2;

  // Costanti inviluppo e gain smoother
  c_fck = 1.0 - exp(-1.0 / (sr_safe * 0.00035));
  c_sck = 1.0 - exp(-1.0 / (sr_safe * 0.018));
  c_fat = 1.0 - exp(-1.0 / (sr_safe * 0.0012));
  c_sat = 1.0 - exp(-1.0 / (sr_safe * 0.028));
  c_ck_att = 1.0 - exp(-1.0 / (sr_safe * 0.00035));
  c_ck_rel = 1.0 - exp(-1.0 / (sr_safe * 0.0038));
  c_at_att = 1.0 - exp(-1.0 / (sr_safe * 0.0008));
  c_at_rel = 1.0 - exp(-1.0 / (sr_safe * max(0.003, slider8 * 0.001)));
  c_ui_rel = 1.0 - exp(-1.0 / (sr_safe * 0.22));
  c_mr_amt = 1.0 - exp(-1.0 / (sr_safe * 0.005));
  ck_cool_samples = floor(sr_safe * 0.028);

  ck_on = slider1 >= 0.5;
  ck_sens = max(0, min(100, slider2));
  ck_max_db = max(0, min(18, slider3));
  gw = max(0, min(100, slider4)) * 0.01;
  ck_thr_db = 16.0 - 0.10 * ck_sens;
  sk_s < 0 ? (
    foc_w1 = 1.0 - 0.30 * sk_s; foc_w2 = 1.0 + 0.45 * sk_s;
    mr_fw1 = 1.0 - 0.30 * sk_s; mr_fw2 = 1.0 + 0.45 * sk_s;
  ) : (
    foc_w1 = 1.0 - 0.45 * sk_s; foc_w2 = 1.0 + 0.30 * sk_s;
    mr_fw1 = 1.0 - 0.45 * sk_s; mr_fw2 = 1.0 + 0.30 * sk_s;
  );

  mr_on = slider19 >= 0.5;
  mr_amt_tgt = max(0, min(1, slider20 * 0.01));
  mr_base_thr = 10.6 - 0.052 * ck_sens;

  att_on = slider6 >= 0.5;
  att_amt = max(0, min(100, slider7));
  att_thr_db = 4.5;
  mix = max(0, min(1, slider10 * 0.01));
  delta_global_on = slider11 >= 0.5;
  ui_theme = floor(slider13 + 0.5);

  update_visibility();
  last_srate = srate;
);

function set_param_silent(idx, v) (
  slider(idx) = v;
  sliderchange(2 ^ (idx - 1));
  slider_automate(2 ^ (idx - 1));
);

function apply_preset(p) (
  p == 1 ? (
    set_param_silent(1, 1); set_param_silent(2, 68); set_param_silent(3, 14);
    set_param_silent(4, 55); set_param_silent(5, 0);
    set_param_silent(6, 1); set_param_silent(7, 20); set_param_silent(8, 8);
    set_param_silent(9, 1200); set_param_silent(10, 100);
    set_param_silent(19, 1); set_param_silent(20, 65); set_param_silent(22, 0);
  ) : p == 2 ? (
    set_param_silent(1, 1); set_param_silent(2, 58); set_param_silent(3, 12);
    set_param_silent(4, 55); set_param_silent(5, 0);
    set_param_silent(6, 1); set_param_silent(7, 58); set_param_silent(8, 12);
    set_param_silent(9, 1200); set_param_silent(10, 100);
    set_param_silent(19, 0); set_param_silent(20, 50); set_param_silent(22, 0);
  ) : p == 3 ? (
    set_param_silent(1, 1); set_param_silent(2, 76); set_param_silent(3, 16);
    set_param_silent(4, 35); set_param_silent(5, 0);
    set_param_silent(6, 1); set_param_silent(7, 62); set_param_silent(8, 12);
    set_param_silent(9, 1000); set_param_silent(10, 100);
    set_param_silent(19, 1); set_param_silent(20, 85); set_param_silent(22, -2);
  ) : p == 4 ? (
    set_param_silent(1, 1); set_param_silent(2, 52); set_param_silent(3, 10);
    set_param_silent(4, 70); set_param_silent(5, 0);
    set_param_silent(6, 1); set_param_silent(7, 32); set_param_silent(8, 10);
    set_param_silent(9, 1400); set_param_silent(10, 100);
    set_param_silent(19, 1); set_param_silent(20, 40); set_param_silent(22, 1);
  );
  set_param_silent(12, p);
  prev_osara_preset = p;
  update_params();
);

// ---- Sistema grafico zoomabile + palette Scuro / Chiaro (tutto definito prima di @slider) ----
zp_sc = 1.0; zp_ox = 0.0; zp_dw = 860.0; zp_dh = 540.0; zp_vw = 860.0; zp_vh = 540.0; zp_gx = 0.0; zp_gy = 0.0; zp_mx = 0.0; zp_my = 0.0;

function zp_rect(x, y, w, h) (
  (x <= 0 && y <= 0 && w >= zp_vw && h >= zp_vh - 1) ? gfx_rect(0, 0, gfx_w, gfx_h) :
  gfx_rect(floor(zp_ox + (x) * zp_sc + 0.5), floor((y) * zp_sc + 0.5), max(1, floor((w) * zp_sc + 0.5)), max(1, floor((h) * zp_sc + 0.5)));
);
function zp_line(x1, y1, x2, y2) (
  gfx_line(zp_ox + (x1) * zp_sc, (y1) * zp_sc, zp_ox + (x2) * zp_sc, (y2) * zp_sc, 1);
);
function zp_circle(x, y, r, fill) (
  gfx_circle(zp_ox + (x) * zp_sc, (y) * zp_sc, max(1, (r) * zp_sc), fill, 1);
);
function zp_setfont(idx, fname, sz) ( gfx_setfont(idx, fname, max(7, floor((sz) * zp_sc + 0.5))); );
function zp_setfont(idx, fname, sz, flg) ( gfx_setfont(idx, fname, max(7, floor((sz) * zp_sc + 0.5)), flg); );
function zp_drawstr(s) (
  gfx_x = floor(zp_ox + zp_gx * zp_sc + 0.5);
  gfx_y = floor(zp_gy * zp_sc + 0.5);
  gfx_drawstr(s);
  zp_gx = (gfx_x - zp_ox) / zp_sc;
  zp_gy = gfx_y / zp_sc;
);
function zp_drawstr_clip(s, rx, by) (
  gfx_x = floor(zp_ox + zp_gx * zp_sc + 0.5);
  gfx_y = floor(zp_gy * zp_sc + 0.5);
  gfx_drawstr(s, 0, floor(zp_ox + (rx) * zp_sc + 0.5), floor((by) * zp_sc + 0.5));
  zp_gx = (gfx_x - zp_ox) / zp_sc;
  zp_gy = gfx_y / zp_sc;
);
function zp_frame(x, y, w, h) (
  zp_line(x, y, x + w - 1, y);
  zp_line(x, y + h - 1, x + w - 1, y + h - 1);
  zp_line(x, y, x, y + h - 1);
  zp_line(x + w - 1, y, x + w - 1, y + h - 1);
);

function set_palette() (
  ui_theme == 0 ? (
    bg_r = 0.062; bg_g = 0.072; bg_b = 0.090;
    card_r = 0.098; card_g = 0.112; card_b = 0.138;
    card2_r = 0.135; card2_g = 0.152; card2_b = 0.186;
    plot_r = 0.056; plot_g = 0.066; plot_b = 0.084;
    line_r = 0.235; line_g = 0.268; line_b = 0.325;
    txt_r = 0.935; txt_g = 0.950; txt_b = 0.972;
    sub_r = 0.610; sub_g = 0.665; sub_b = 0.745;
    knob_r = 0.145; knob_g = 0.162; knob_b = 0.195;
    trk_r = 0.058; trk_g = 0.068; trk_b = 0.088;
    c_coral_r = 0.96; c_coral_g = 0.42; c_coral_b = 0.34;
    c_amber_r = 0.96; c_amber_g = 0.68; c_amber_b = 0.22;
    c_cyan_r  = 0.28; c_cyan_g  = 0.78; c_cyan_b  = 0.95;
    c_grn_r   = 0.30; c_grn_g   = 0.84; c_grn_b   = 0.54;
    c_mag_r   = 0.94; c_mag_g   = 0.32; c_mag_b   = 0.56;
    btn_txt_on_r = 0.96; btn_txt_on_g = 0.97; btn_txt_on_b = 0.99;
  ) : (
    bg_r = 0.905; bg_g = 0.920; bg_b = 0.942;
    card_r = 0.965; card_g = 0.972; card_b = 0.985;
    card2_r = 0.915; card2_g = 0.932; card2_b = 0.955;
    plot_r = 0.940; plot_g = 0.952; plot_b = 0.972;
    line_r = 0.720; line_g = 0.762; line_b = 0.822;
    txt_r = 0.105; txt_g = 0.135; txt_b = 0.185;
    sub_r = 0.365; sub_g = 0.420; sub_b = 0.505;
    knob_r = 0.955; knob_g = 0.962; knob_b = 0.975;
    trk_r = 0.835; trk_g = 0.860; trk_b = 0.898;
    c_coral_r = 0.82; c_coral_g = 0.24; c_coral_b = 0.18;
    c_amber_r = 0.80; c_amber_g = 0.46; c_amber_b = 0.05;
    c_cyan_r  = 0.08; c_cyan_g  = 0.50; c_cyan_b  = 0.78;
    c_grn_r   = 0.08; c_grn_g   = 0.56; c_grn_b   = 0.34;
    c_mag_r   = 0.78; c_mag_g   = 0.16; c_mag_b   = 0.42;
    btn_txt_on_r = 0.08; btn_txt_on_g = 0.10; btn_txt_on_b = 0.14;
  );
);

function draw_hw_panel(x, y, w, h) (
  gfx_set(card_r, card_g, card_b, 1); zp_rect(x, y, w, h);
  gfx_set(1, 1, 1, ui_theme == 0 ? 0.05 : 0.45); zp_rect(x + 1, y + 1, w - 2, 1);
  gfx_set(0, 0, 0, ui_theme == 0 ? 0.35 : 0.08); zp_rect(x + 1, y + h - 2, w - 2, 1);
  gfx_set(line_r, line_g, line_b, 0.92); zp_frame(x, y, w, h);
);

function draw_hw_led(cx, cy, r, is_on, is_hov, cr, cg, cb) local(bzr, bzg, bzb, rmr, rmg, rmb, dr, dg, db) (
  ui_theme == 1 ? (
    bzr = 0.28; bzg = 0.33; bzb = 0.40; rmr = 0.58; rmg = 0.64; rmb = 0.72;
  ) : (
    bzr = 0.03; bzg = 0.04; bzb = 0.05; rmr = 0.34; rmg = 0.38; rmb = 0.45;
  );
  gfx_set(bzr, bzg, bzb, 0.98); zp_circle(cx, cy, r + 1.6, 1);
  gfx_set(rmr, rmg, rmb, 0.82); zp_circle(cx, cy, r + 1.6, 0);
  is_on ? (
    gfx_set(cr, cg, cb, ui_theme == 1 ? 0.22 : 0.28); zp_circle(cx, cy, r + 3.8, 1);
    gfx_set(cr, cg, cb, 0.42); zp_circle(cx, cy, r + 1.9, 1);
    gfx_set(min(1, cr * 1.15 + 0.08), min(1, cg * 1.15 + 0.08), min(1, cb * 1.15 + 0.08), 1); zp_circle(cx, cy, r, 1);
    gfx_set(min(1, cr * 0.45 + 0.55), min(1, cg * 0.45 + 0.55), min(1, cb * 0.45 + 0.55), 0.62); zp_circle(cx - r * 0.14, cy - r * 0.14, r * 0.46, 1);
    gfx_set(1, 1, 1, 0.88); zp_circle(cx - r * 0.34, cy - r * 0.34, max(0.75, r * 0.22), 1);
  ) : (
    ui_theme == 1 ? (
      dr = 0.22 + cr * 0.16; dg = 0.25 + cg * 0.16; db = 0.29 + cb * 0.16;
    ) : (
      dr = 0.07 + cr * 0.14; dg = 0.08 + cg * 0.14; db = 0.10 + cb * 0.14;
    );
    is_hov ? (dr = min(1, dr + 0.08); dg = min(1, dg + 0.08); db = min(1, db + 0.08););
    gfx_set(dr, dg, db, 1); zp_circle(cx, cy, r, 1);
    gfx_set(1, 1, 1, is_hov ? 0.34 : 0.22); zp_circle(cx - r * 0.32, cy - r * 0.32, max(0.65, r * 0.18), 1);
  );
);

function set_param(idx, v) (
  slider(idx) = v;
  sliderchange(2 ^ (idx - 1));
  slider_automate(2 ^ (idx - 1));
  idx == 22 && slider5 != 0 ? (
    slider5 = 0; sliderchange(2 ^ 4);
  );
  ((idx >= 1 && idx <= 10) || idx == 19 || idx == 20 || idx == 22) && slider12 != 0 ? (
    slider12 = 0; prev_osara_preset = 0;
    sliderchange(2 ^ 11);
  );
  update_params();
);

// Tasto hardware retroilluminato stile ZP Suite (barra LED superiore + bordo tattile)
function ui_btn(x, y, w, h, label, is_on, ar, ag, ab, hint, stage_id) local(hov, tw, th, br, bg, bb, bar_h) (
  hov = zp_mx >= x && zp_mx <= x + w && zp_my >= y && zp_my <= y + h;
  hov ? strcpy(#hint, hint);
  hov && mouse_down && stage_id > 0 && delta_spring_armed ? ( ui_hold_delta_stage = stage_id; );
  ui_theme == 1 ? (
    is_on ? (
      br = min(1, 0.83 + ar * 0.08); bg = min(1, 0.86 + ag * 0.08); bb = min(1, 0.90 + ab * 0.08);
    ) : (
      br = 0.93; bg = 0.95; bb = 0.97;
    );
    hov ? (br -= 0.04; bg -= 0.04; bb -= 0.04;);
  ) : (
    is_on ? (
      br = 0.10 + ar * 0.09; bg = 0.12 + ag * 0.09; bb = 0.16 + ab * 0.09;
    ) : (
      br = card2_r - 0.01; bg = card2_g - 0.01; bb = card2_b - 0.01;
    );
    hov ? (br += 0.045; bg += 0.045; bb += 0.045;);
  );
  gfx_set(br, bg, bb, 1); zp_rect(x, y, w, h);
  bar_h = h < 20 ? 2 : 3;
  is_on ? (
    gfx_set(ar, ag, ab, 0.98); zp_rect(x + 1, y + 1, w - 2, bar_h);
    gfx_set(ar, ag, ab, 0.16); zp_rect(x + 1, y + 1 + bar_h, w - 2, 2);
  ) : (
    gfx_set(ar * 0.35 + (ui_theme == 1 ? 0.30 : 0.06), ag * 0.35 + (ui_theme == 1 ? 0.32 : 0.07), ab * 0.35 + (ui_theme == 1 ? 0.35 : 0.08), hov ? 0.65 : 0.34);
    zp_rect(x + 1, y + 1, w - 2, bar_h);
  );
  hov ? gfx_set(min(1, ar + 0.18), min(1, ag + 0.18), min(1, ab + 0.18), 0.92)
      : is_on ? gfx_set(ar * 0.78, ag * 0.78, ab * 0.78, 0.86)
              : gfx_set(line_r, line_g, line_b, 0.88);
  zp_frame(x, y, w, h);
  zp_setfont(1, "Arial", 11, is_on ? 'b' : 0);
  (gfx_measurestr(label, tw, th); tw /= zp_sc; th /= zp_sc);
  zp_gx = x + (w - tw) * 0.5; zp_gy = y + (h - th) * 0.5 + 1.0;
  is_on ? gfx_set(btn_txt_on_r, btn_txt_on_g, btn_txt_on_b, 1) : gfx_set(txt_r, txt_g, txt_b, hov ? 1.0 : 0.86);
  zp_drawstr(label);
  hov && btn_click;
);

// Pomello hardware tattile stile ZP Suite (anello incassato + arco LED + ghiera metallica)
function ui_knob(idx, cx, cy, r, minv, maxv, defv, fmt_kind, label, ar, ag, ab, hint, stage_id) local(v, hov, n, sens, a, a0, a1, k, x1, y1, x2, y2, now, tw, th) (
  v = slider(idx);
  hov = zp_mx >= cx - r - 10 && zp_mx <= cx + r + 10 && zp_my >= cy - r - 16 && zp_my <= cy + r + 20;
  hov ? strcpy(#hint, hint);
  hov && btn_click ? (
    now = time_precise();
    kn_last == idx && now - kn_last_t < 0.35 ? (
      set_param(idx, defv); kn_drag = 0;
    ) : (
      kn_drag = idx; kn_y = zp_my; kn_v = v;
    );
    kn_last = idx; kn_last_t = now;
  );
  hov && rclick && !help_open ? set_param(idx, defv);
  kn_drag == idx ? (
    mouse_cap & 1 ? (
      sens = (mouse_cap & 8) ? 450.0 : 150.0;
      n = kn_v + (kn_y - zp_my) * (maxv - minv) / sens;
      n = max(minv, min(maxv, n));
      fmt_kind == 2 || fmt_kind == 4 ? (n = floor(n * 2 + 0.5) * 0.5) :
      fmt_kind == 3 ? (n = floor(n / 10 + 0.5) * 10) :
                      (n = floor(n + 0.5));
      n != slider(idx) ? set_param(idx, n);
    ) : (
      kn_drag = 0;
    );
  );
  ((kn_drag == idx) || (hov && mouse_down)) && stage_id > 0 && delta_spring_armed ? (
    ui_hold_delta_stage = stage_id;
  );

  v = slider(idx);
  a0 = 0.75 * $pi; a1 = 2.25 * $pi;
  a = a0 + (v - minv) / max(0.0001, maxv - minv) * (a1 - a0);

  zp_setfont(1, "Arial", 10, 'b'); gfx_set(sub_r, sub_g, sub_b, 1);
  (gfx_measurestr(label, tw, th); tw /= zp_sc; th /= zp_sc);
  zp_gx = cx - tw * 0.5; zp_gy = cy - r - 15; zp_drawstr(label);

  // Ombra incassata + alone hover
  (hov || kn_drag == idx) ? (gfx_set(ar, ag, ab, 0.16); zp_circle(cx, cy, r + 6.5, 1););
  gfx_set(0, 0, 0, ui_theme == 0 ? 0.45 : 0.14); zp_circle(cx + 0.8, cy + 1.4, r + 2.5, 1);

  // Traccia arco di fondo (spenta) + arco attivo LED
  k = 0;
  loop(28,
    x1 = a0 + (a1 - a0) * k / 28; x2 = a0 + (a1 - a0) * (k + 1) / 28;
    gfx_set(line_r, line_g, line_b, ui_theme == 0 ? 0.42 : 0.65);
    zp_line(cx + cos(x1) * (r + 2.2), cy + sin(x1) * (r + 2.2), cx + cos(x2) * (r + 2.2), cy + sin(x2) * (r + 2.2));
    k += 1;
  );
  k = 0;
  loop(32,
    fmt_kind == 4 ? (
      x1 = 1.5 * $pi + (a - 1.5 * $pi) * k / 32;
      x2 = 1.5 * $pi + (a - 1.5 * $pi) * (k + 1) / 32;
    ) : (
      x1 = a0 + (a - a0) * k / 32;
      x2 = a0 + (a - a0) * (k + 1) / 32;
    );
    gfx_set(ar, ag, ab, 0.95);
    zp_line(cx + cos(x1) * (r + 2.2), cy + sin(x1) * (r + 2.2), cx + cos(x2) * (r + 2.2), cy + sin(x2) * (r + 2.2));
    zp_line(cx + cos(x1) * (r + 1.2), cy + sin(x1) * (r + 1.2), cx + cos(x2) * (r + 1.2), cy + sin(x2) * (r + 1.2));
    k += 1;
  );

  // Corpo manopola metallica + ghiera + riflesso
  gfx_set(knob_r, knob_g, knob_b, 1); zp_circle(cx, cy, r - 1.5, 1);
  gfx_set(ui_theme == 0 ? 0.24 : 0.82, ui_theme == 0 ? 0.27 : 0.85, ui_theme == 0 ? 0.32 : 0.89, 0.9); zp_circle(cx, cy, r - 1.5, 0);
  gfx_set(ui_theme == 0 ? 0.10 : 0.88, ui_theme == 0 ? 0.11 : 0.90, ui_theme == 0 ? 0.14 : 0.93, 1); zp_circle(cx, cy, r - 4.5, 1);
  gfx_set(1, 1, 1, ui_theme == 0 ? 0.08 : 0.55); zp_circle(cx - r * 0.18, cy - r * 0.20, r * 0.32, 1);

  // Lancetta ad alto contrasto
  gfx_set(txt_r, txt_g, txt_b, 0.96);
  zp_line(cx + cos(a) * (r * 0.20), cy + sin(a) * (r * 0.20), cx + cos(a) * (r - 3.5), cy + sin(a) * (r - 3.5));

  fmt_kind == 0 ? sprintf(#kval, "%.0f%%", v) :
  fmt_kind == 1 ? sprintf(#kval, "%.1f dB", v) :
  fmt_kind == 2 ? sprintf(#kval, "%.1f ms", v) :
  fmt_kind == 4 ? (v > 0.05 ? sprintf(#kval, "+%.1f AIR", v) : v < -0.05 ? sprintf(#kval, "%.1f LOW", v) : strcpy(#kval, "0.0 BAL")) :
                  sprintf(#kval, "%.0f Hz", v);
  zp_setfont(1, "Arial", 11, 'b'); gfx_set(txt_r, txt_g, txt_b, 0.95);
  (gfx_measurestr(#kval, tw, th); tw /= zp_sc; th /= zp_sc);
  zp_gx = cx - tw * 0.5; zp_gy = cy + r + 5; zp_drawstr(#kval);
);

function draw_help_overlay() local(px, py, pw, ph, cx, cy, hc, ly, tw, th) (
  pw = min(806, zp_vw - 36); ph = min(468, zp_vh - 52);
  px = floor((zp_vw - pw) * 0.5); py = 40;
  gfx_set(0.03, 0.035, 0.048, 0.96); zp_rect(px, py, pw, ph);
  gfx_set(c_cyan_r, c_cyan_g, c_cyan_b, 1); zp_frame(px, py, pw, ph); zp_rect(px, py, pw, 3);
  zp_setfont(2, "Arial", 19, 'b'); gfx_set(0.94, 0.96, 0.98, 1);
  zp_gx = px + 22; zp_gy = py + 15; zp_drawstr("ZP Click & Attack Softener (v1.4) - guida rapida");

  cx = px + pw - 42; cy = py + 14;
  hc = zp_mx >= cx && zp_mx <= cx + 26 && zp_my >= cy && zp_my <= cy + 26;
  hc ? gfx_set(0.32, 0.12, 0.12, 1) : gfx_set(0.16, 0.14, 0.16, 1); zp_rect(cx, cy, 26, 26);
  zp_setfont(1, "Arial", 14, 'b'); gfx_set(0.95, 0.80, 0.80, 1);
  (gfx_measurestr("X", tw, th); tw /= zp_sc; th /= zp_sc);
  zp_gx = cx + (26 - tw) * 0.5; zp_gy = cy + (26 - th) * 0.5; zp_drawstr("X");
  hc && click ? (help_open = 0);

  ly = py + 50; zp_setfont(1, "Arial", 13);
  gfx_set(0.96, 0.72, 0.34, 1);
  zp_gx = px + 22; zp_gy = ly; zp_drawstr("DOVE METTERLO:   PRE-CHAIN prima di Magic Voice per pulire click e micro-impulsi;   POST-CHAIN prima dell'uscita per smussare attacchi."); ly += 26;
  gfx_set(0.86, 0.88, 0.92, 1);
  zp_gx = px + 22; zp_gy = ly; zp_drawstr("1A · MACRO CLICK: attenuatore simmetrico pre/post (0,5-4 ms) con Protezione Consonanti (p/t/k) e bilanciamento continuo Freq Skew."); ly += 24;
  gfx_set(0.98, 0.76, 0.32, 1);
  zp_gx = px + 22; zp_gy = ly; zp_drawstr("1B · MICRO-CLICK (STFT) + Freq Skew (Low <-> Air): negativo abbassa il pavimento fino a 380 Hz (click bassi/umidi), positivo spinge su Air (4-16k)."); ly += 21;
  zp_gx = px + 22; zp_gy = ly; zp_drawstr("Attivabile ON/OFF e con rotore 'Micro %' (slider20) automatizzabile sulla traccia REAPER per intervenire solo dove serve (PDC fisso)."); ly += 26;
  gfx_set(0.86, 0.88, 0.92, 1);
  zp_gx = px + 22; zp_gy = ly; zp_drawstr("2 · ATTACK SOFTENER: smussa i primi millisecondi dell'attacco SOLO sopra la Freq. Taglio (crossover coerente di fase, corpo intatto)."); ly += 26;
  gfx_set(0.55, 0.90, 0.70, 1);
  zp_gx = px + 22; zp_gy = ly; zp_drawstr("DELTA: ascolti tutto cio' che viene tolto dal suono (lampeggia e si spegne da solo dopo 30 s per sicurezza)."); ly += 21;
  zp_gx = px + 22; zp_gy = ly; zp_drawstr("D·MOLLA: armalo, poi tieni premuto/trascina un controllo di Macro Click, Micro-Click o Attack per ascoltare SOLO lo scarto di quello stadio."); ly += 26;
  gfx_set(0.65, 0.75, 0.86, 1);
  zp_gx = px + 22; zp_gy = ly; zp_drawstr("Monitor: punte corallo = Macro Click, punte ambra = Micro-Click, onde ciano = Attack Softener. Doppio clic/destro = default, Shift = fine."); ly += 21;
  zp_gx = px + 22; zp_gy = ly; zp_drawstr("Vista JSFX espone tutti i controlli e le letture [Read] (Macro Click GR, Micro-Click GR, Attack GR, Click/s) per OSARA.");
);

update_params();

// ---- ZP Shared Bus v3 (telemetria multi-istanza a monte -> Master Pro) ----
function zp3_boot() (
  gmem[1000] != 905300 || gmem[1001] < 300 ? (
    gmem[1000] = 905300;
    gmem[1001] = 300;
    gmem[1002] = 64;
    gmem[1003] = 32;
  );
);
function zp3_clear_slot() local(zp3_cb) (
  zp3_slot >= 0 && zp3_slot < 64 ? (
    zp3_cb = 1024 + zp3_slot * 32;
    gmem[zp3_cb + 3] == zp3_prev_key ? (
      gmem[zp3_cb] = 0;
      gmem[zp3_cb + 2] = 0;
    );
  );
  zp3_slot = -1;
  zp3_prev_key = -1;
);
function zp3_claim(zp3_pt) local(zp3_now, zp3_key, zp3_h, zp3_i, zp3_s, zp3_b, zp3_m, zp3_found) (
  zp3_boot();
  zp3_now = time_precise();
  zp3_fx = 0; zp3_hf = 0;
  zp3_tr = get_host_placement(zp3_fx, zp3_hf);
  zp3_key = max(0, zp3_tr + 2) * 1024 + max(0, zp3_fx) * 16 + zp3_pt;
  zp3_prev_key >= 0 && zp3_prev_key != zp3_key ? zp3_clear_slot();
  zp3_found = -1;
  zp3_slot >= 0 && zp3_slot < 64 ? (
    zp3_b = 1024 + zp3_slot * 32;
    gmem[zp3_b] == 905301 && gmem[zp3_b + 3] == zp3_key ? (zp3_found = zp3_slot;);
  );
  zp3_found < 0 ? (
    zp3_i = 0;
    loop(64,
      zp3_found < 0 ? (
        zp3_b = 1024 + zp3_i * 32;
        gmem[zp3_b] == 905301 && gmem[zp3_b + 3] == zp3_key ? (zp3_found = zp3_i;);
      );
      zp3_i += 1;
    );
  );
  zp3_found < 0 ? (
    zp3_h = (max(0, zp3_tr + 2) * 13 + max(0, zp3_fx) * 7 + zp3_pt * 3) % 64;
    zp3_i = 0;
    loop(64,
      zp3_found < 0 ? (
        zp3_s = (zp3_h + zp3_i) % 64;
        zp3_b = 1024 + zp3_s * 32;
        zp3_m = gmem[zp3_b];
        (zp3_m != 905301 || (zp3_now - gmem[zp3_b + 1]) > 2.5) ? (zp3_found = zp3_s;);
      );
      zp3_i += 1;
    );
  );
  zp3_slot = zp3_found;
  zp3_prev_key = zp3_key;
  zp3_slot >= 0 ? (
    zp3_b = 1024 + zp3_slot * 32;
    zp3_seq = max(zp3_seq, floor(gmem[zp3_b + 2] + 0.5));
    zp3_b;
  ) : -1;
);
zp3_prev_key <= 0 ? (zp3_slot = -1; zp3_prev_key = -1;);
zp3_boot();

@slider
osara_p = floor(slider12 + 0.5);
osara_p > 0 && osara_p != prev_osara_preset ? (
  apply_preset(osara_p);
) : (
  osara_p == 0 ? (prev_osara_preset = 0;);
  update_params();
);

@block
srate != last_srate ? (
  dsp_reset_state();
  prev_la = -1;
  update_params();
);
blk_now = time_precise();
// Auto-off DELTA globale dopo 30 s di inattivita' (anche a GUI chiusa)
slider11 >= 0.5 ? (
  !prev_delta_on ? ( delta_arm_time = blk_now; prev_delta_on = 1; );
  blk_now - delta_arm_time >= 30.0 ? (
    slider11 = 0;
    sliderchange(2 ^ 10);
    prev_delta_on = 0;
    delta_global_on = 0;
  );
) : (
  prev_delta_on = 0;
);
// Auto-disarm D·MOLLA a 30 s + fail-safe se GUI chiusa durante drag
delta_spring_armed && (blk_now - delta_spring_time >= 30.0) ? (
  delta_spring_armed = 0; delta_spring_stage = 0;
);
delta_spring_stage > 0 && (blk_now - delta_spring_aud_hb > 0.4) ? (
  delta_spring_stage = 0;
);

// Conteggio Click/s e aggiornamento letture OSARA a ~4 Hz
blk_now - ck_rate_t >= 1.0 ? (
  ck_rate_disp = ck_rate_cnt;
  ck_rate_cnt = 0;
  ck_rate_t = blk_now;
);
(rd_t += samplesblock) >= sr_safe * 0.25 ? (
  rd_t = 0;
  slider16 = floor(ui_ck_hold * 10 + 0.5) * 0.1;
  slider17 = floor(ui_at_hold * 10 + 0.5) * 0.1;
  slider18 = min(60, ck_rate_disp);
  slider21 = floor(ui_mr_hold * 10 + 0.5) * 0.1;
  sliderchange(2 ^ 15);
  sliderchange(2 ^ 16);
  sliderchange(2 ^ 17);
  sliderchange(2 ^ 20);
);

zp3_b = zp3_claim(6);
zp3_b >= 0 ? (
  zp3_pk_db = mon_in_pk > 0.000001 ? 20 * log10(mon_in_pk) : -120;
  zp3_ck_tot = max(slider1 >= 0.5 ? ui_ck_hold : 0, slider19 >= 0.5 ? ui_mr_hold : 0);
  gmem[zp3_b + 3] = zp3_prev_key;
  gmem[zp3_b + 4] = 6;
  gmem[zp3_b + 5] = zp3_tr;
  gmem[zp3_b + 6] = zp3_fx;
  gmem[zp3_b + 7] = zp3_hf;
  gmem[zp3_b + 8] = 0;
  gmem[zp3_b + 9] = ((slider1 >= 0.5 || slider6 >= 0.5 || slider19 >= 0.5) ? 1 : 2)
    + ((slider11 >= 0.5 || delta_spring_stage > 0) ? 4 : 0);
  gmem[zp3_b + 10] = slider6 >= 0.5 ? ui_at_hold : 0;
  gmem[zp3_b + 11] = zp3_ck_tot;
  gmem[zp3_b + 12] = 0;
  gmem[zp3_b + 13] = 0;
  gmem[zp3_b + 14] = 0;
  gmem[zp3_b + 15] = 0;
  gmem[zp3_b + 16] = 0;
  gmem[zp3_b + 17] = -120;
  gmem[zp3_b + 18] = -120;
  gmem[zp3_b + 19] = zp3_pk_db;
  gmem[zp3_b + 20] = 0;
  gmem[zp3_b + 21] = max(0, min(100, (zp3_pk_db + 55) * 2.5));
  gmem[zp3_b + 22] = -1;
  gmem[zp3_b + 23] = -99;
  gmem[zp3_b + 24] = max(ui_ck_hold, ui_mr_hold);
  gmem[zp3_b + 25] = ui_at_hold;
  gmem[zp3_b + 26] = ck_rate_disp;
  gmem[zp3_b + 27] = slider10;
  gmem[zp3_b + 28] = slider1;
  gmem[zp3_b + 29] = slider6;
  gmem[zp3_b + 30] = ui_mr_hold;
  gmem[zp3_b + 31] = slider19;
  gmem[zp3_b] = 905301;
  gmem[zp3_b + 1] = time_precise();
  zp3_seq += 1;
  gmem[zp3_b + 2] = zp3_seq;
);

@sample
inL = spl0;
inR = num_ch > 1 ? spl1 : spl0;

// Smoothing continuo di Micro % per automazione in timeline priva di click/zipper
mr_amt_s += c_mr_amt * (mr_amt_tgt - mr_amt_s);

// 0A. Ring buffer Dry esatto (ritardo totale LA_TOT = st_la + LA_POST)
d_dryL = r_rawL[raw_p];
d_dryR = r_rawR[raw_p];
r_rawL[raw_p] = inL;
r_rawR[raw_p] = inR;

// 0B. Stadio 1B: MICRO-CLICK spettrale STFT (ritardo esatto st_la campioni; bypass bit-exact quando OFF)
mr_on ? (
  svf_inL = st_outL[st_io_p];
  svf_inR = st_outR[st_io_p];
  st_outL[st_io_p] = 0;
  st_outR[st_io_p] = 0;
  st_inL[st_io_p] = inL;
  st_inR[st_io_p] = inR;
  st_hop_diff = max(st_hop_diff, abs(inL - inR));
  st_io_p += 1; st_io_p >= st_n ? st_io_p = 0;
  st_hop_cnt += 1;
  st_hop_cnt >= st_hop ? (
    st_hop_cnt = 0;
    stft_process_hop(num_ch <= 1 || st_hop_diff < 0.0000005);
    st_hop_diff = 0;
  );
) : (
  // Bypass a zero CPU con lo stesso identico ritardo st_la campioni (zero salti di fase o PDC)
  st_bp = raw_p - st_la; st_bp < 0 ? st_bp += LA_TOT;
  svf_inL = r_rawL[st_bp];
  svf_inR = r_rawR[st_bp];
  // Mantiene comunque st_inL/R aggiornati per riaccensione pulita
  st_inL[st_io_p] = inL;
  st_inR[st_io_p] = inR;
  st_outL[st_io_p] = 0;
  st_outR[st_io_p] = 0;
  st_io_p += 1; st_io_p >= st_n ? st_io_p = 0;
  cur_mr_db = 0;
);

raw_p += 1; raw_p >= LA_TOT ? raw_p = 0;

// 1. Crossover SVF coerente di fase a valle di Micro-Click (lo + md + hi === svf_in)
v3 = svf_inL - ic21L; v1 = a1_1 * ic11L + a2_1 * v3; v2 = ic21L + a2_1 * ic11L + a3_1 * v3;
ic11L = 2 * v1 - ic11L; ic21L = 2 * v2 - ic21L;
loL = v2; hi1L = svf_inL - loL;

v3 = hi1L - ic22L; v1 = a1_2 * ic12L + a2_2 * v3; v2 = ic22L + a2_2 * ic12L + a3_2 * v3;
ic12L = 2 * v1 - ic12L; ic22L = 2 * v2 - ic22L;
mdL = v2; hiL = hi1L - mdL;

v3 = svf_inR - ic21R; v1 = a1_1 * ic11R + a2_1 * v3; v2 = ic21R + a2_1 * ic11R + a3_1 * v3;
ic11R = 2 * v1 - ic11R; ic21R = 2 * v2 - ic21R;
loR = v2; hi1R = svf_inR - loR;

v3 = hi1R - ic22R; v1 = a1_2 * ic12R + a2_2 * v3; v2 = ic22R + a2_2 * ic12R + a3_2 * v3;
ic12R = 2 * v1 - ic12R; ic22R = 2 * v2 - ic22R;
mdR = v2; hiR = hi1R - mdR;

// 2. Lookahead a valle (LA_POST campioni -> ritardo complessivo esatto = LA_TOT)
d_loL = r_loL[ring_p]; d_mdL = r_mdL[ring_p]; d_hiL = r_hiL[ring_p];
d_loR = r_loR[ring_p]; d_mdR = r_mdR[ring_p]; d_hiR = r_hiR[ring_p];

pt = ring_p + LOOK_TRIG; pt >= LA_POST ? pt -= LA_POST;
ps = ring_p + POST_START; ps >= LA_POST ? ps -= LA_POST;
t_loL = r_loL[pt]; t_mdL = r_mdL[pt]; t_hiL = r_hiL[pt];
t_loR = r_loR[pt]; t_mdR = r_mdR[pt]; t_hiR = r_hiR[pt];

am_new = max(abs(mdL), abs(mdR));
ah_new = max(abs(hiL), abs(hiR));
al_new = max(abs(loL), abs(loR));

ring_p == 0 ? (
  post_sum1 = 0; post_sum2 = 0; post_lo = 0;
  pj = POST_START;
  loop(POST_LEN,
    post_sum1 += r_am[pj];
    post_sum2 += r_ah[pj];
    post_lo   += r_al[pj];
    pj += 1; pj >= LA_POST ? pj = 0;
  );
);
post_sum1 += am_new - r_am[ps];
post_sum2 += ah_new - r_ah[ps];
post_lo   += al_new - r_al[ps];
post1 = max(0, post_sum1) * inv_post_len;
post2 = max(0, post_sum2) * inv_post_len;
plo   = max(0, post_lo)   * inv_post_len;

r_loL[ring_p] = loL; r_mdL[ring_p] = mdL; r_hiL[ring_p] = hiL;
r_loR[ring_p] = loR; r_mdR[ring_p] = mdR; r_hiR[ring_p] = hiR;
r_am[ring_p] = am_new; r_ah[ring_p] = ah_new; r_al[ring_p] = al_new;
ring_p += 1; ring_p >= LA_POST ? ring_p = 0;

// 3. Stadio 1A: MACRO CLICK simmetrico pre/post + protezione consonanti
am = max(abs(t_mdL), abs(t_mdR));
ah = max(abs(t_hiL), abs(t_hiR));
f1 += c_fck * (am - f1); s1 += c_sck * (am - s1);
f2 += c_fck * (ah - f2); s2 += c_sck * (ah - s2);

ck_on && ck_sens > 0.1 && ck_max_db > 0.1 ? (
  r1_pre  = log((f1 + TINY7) / (s1 + EPS2)) * LN10_20;
  r1_post = log((f1 + TINY7) / (post1 + EPS2)) * LN10_20;
  r2_pre  = log((f2 + TINY7) / (s2 + EPS2)) * LN10_20;
  r2_post = log((f2 + TINY7) / (post2 + EPS2)) * LN10_20;

  vg1 = max(0, log((plo + EPS2) / (f1 + EPS2)) * LN10_20);
  vg2 = max(0, log((plo + EPS2) / (f2 + EPS2)) * LN10_20);

  sym1 = min(r1_pre, r1_post + 4.0) - 0.30 * vg1;
  sym2 = min(r2_pre, r2_post + 4.0) - 0.25 * vg2;
  sc1 = f1 > 0.0014 ? ((1.0 - gw) * r1_pre + gw * sym1) : 0;
  sc2 = f2 > 0.0010 ? ((1.0 - gw) * r2_pre + gw * sym2) : 0;

  red1 = sc1 > ck_thr_db ? min(ck_max_db, (sc1 - ck_thr_db) * 1.5 * foc_w1) : 0;
  red2 = sc2 > ck_thr_db ? min(ck_max_db, (sc2 - ck_thr_db) * 1.5 * foc_w2) : 0;
  tgt_ck1 = red1 > 0 ? exp(-red1 / LN10_20) : 1.0;
  tgt_ck2 = red2 > 0 ? exp(-red2 / LN10_20) : 1.0;
) : (
  tgt_ck1 = 1.0; tgt_ck2 = 1.0;
);
g_ck1 += (tgt_ck1 < g_ck1 ? c_ck_att : c_ck_rel) * (tgt_ck1 - g_ck1);
g_ck2 += (tgt_ck2 < g_ck2 ? c_ck_att : c_ck_rel) * (tgt_ck2 - g_ck2);

// 4. Stadio 2: ATTACK SOFTENER selettivo sopra att_fc
aa = max(abs(t_mdL + t_hiL), abs(t_mdR + t_hiR));
fa += c_fat * (aa - fa); sa += c_sat * (aa - sa);

att_on && att_amt > 0.1 ? (
  ra = log((fa + TINY7) / (sa + EPS3)) * LN10_20;
  (fa > 0.004 && ra > att_thr_db) ? (
    red_a = min(0.09 * att_amt, (ra - att_thr_db) * (0.011 * att_amt));
    tgt_att = exp(-red_a / LN10_20);
  ) : (
    tgt_att = 1.0;
  );
) : (
  tgt_att = 1.0;
);
g_att += (tgt_att < g_att ? c_at_att : c_at_rel) * (tgt_att - g_att);

// 5. Telemetria GR istantanea + picco per monitor
cur_ck_db = max(0, -log(max(TINY7, min(g_ck1, g_ck2))) * LN10_20);
cur_at_db = max(0, -log(max(TINY7, g_att)) * LN10_20);
ui_ck_gr = max(cur_ck_db, ui_ck_gr * (1 - c_ui_rel));
ui_at_gr = max(cur_at_db, ui_at_gr * (1 - c_ui_rel));
ui_mr_gr = max(cur_mr_db, ui_mr_gr * (1 - c_ui_rel));
ui_ck_hold = max(cur_ck_db, ui_ck_hold * (1 - c_ui_rel * 0.45));
ui_at_hold = max(cur_at_db, ui_at_hold * (1 - c_ui_rel * 0.45));
ui_mr_hold = max(cur_mr_db, ui_mr_hold * (1 - c_ui_rel * 0.45));

mon_ck_pk = max(mon_ck_pk, cur_ck_db);
mon_at_pk = max(mon_at_pk, cur_at_db);
mon_mr_pk = max(mon_mr_pk, cur_mr_db);
mon_in_pk = max(mon_in_pk, max(abs(d_dryL), abs(d_dryR)));

ck_cool_spl > 0 ? (ck_cool_spl -= 1);
(cur_ck_db > 2.5 && !ck_prev_trig && ck_cool_spl <= 0) ? (
  ck_rate_cnt += 1;
  ck_cool_spl = ck_cool_samples;
);
ck_prev_trig = cur_ck_db > 2.5;

// 6. Ricombinazione al campione e instradamento Mix / DELTA globale / D·MOLLA (1=Macro, 2=Attack, 3=Globale, 4=Micro)
mrep_outL = d_loL + d_mdL + d_hiL;
mrep_outR = d_loR + d_mdR + d_hiR;
ck_outL = d_loL + d_mdL * g_ck1 + d_hiL * g_ck2;
ck_outR = d_loR + d_mdR * g_ck1 + d_hiR * g_ck2;
wetL = d_loL + d_mdL * (g_ck1 * g_att) + d_hiL * (g_ck2 * g_att);
wetR = d_loR + d_mdR * (g_ck1 * g_att) + d_hiR * (g_ck2 * g_att);

delta_spring_stage == 4 ? (
  outL = d_dryL - mrep_outL;
  outR = d_dryR - mrep_outR;
) : delta_spring_stage == 1 ? (
  outL = mrep_outL - ck_outL;
  outR = mrep_outR - ck_outR;
) : delta_spring_stage == 2 ? (
  outL = ck_outL - wetL;
  outR = ck_outR - wetR;
) : (delta_spring_stage == 3 || delta_global_on) ? (
  outL = d_dryL - wetL;
  outR = d_dryR - wetR;
) : (
  outL = d_dryL + mix * (wetL - d_dryL);
  outR = d_dryR + mix * (wetR - d_dryR);
);

spl0 = outL;
num_ch > 1 ? (spl1 = outR);

@gfx 980 620
zp_sc = max(0.55, min(2.5, min(gfx_w / zp_dw, gfx_h / zp_dh)));
zp_ox = max(0, (gfx_w - zp_dw * zp_sc) * 0.5);
zp_vw = zp_dw; zp_vh = max(zp_dh, gfx_h / zp_sc);
zp_mx = (mouse_x - zp_ox) / zp_sc; zp_my = mouse_y / zp_sc;

help_bridge_alive();
time_now = time_precise();
mouse_down = mouse_cap & 1;
click = mouse_down && !last_cap; last_cap = mouse_down;
rclick = (mouse_cap & 2) && !last_rcap; last_rcap = mouse_cap & 2;
btn_click = click && !help_open;
ui_hold_delta_stage = 0;
#hint = "";

set_palette();
gfx_set(bg_r, bg_g, bg_b, 1); zp_rect(0, 0, zp_vw, zp_vh);

// Aggiornamento storia monitor ~30 Hz (preserva i picchi di ogni intervallo)
time_now - hist_t >= 0.033 ? (
  hist_t = time_now;
  h_in[hist_pos] = min(1, max(0, (log(max(TINY7, mon_in_pk)) * LN10_20 + 48) / 48));
  h_ck[hist_pos] = min(18, mon_ck_pk);
  h_at[hist_pos] = min(12, mon_at_pk);
  h_mr[hist_pos] = min(18, mon_mr_pk);
  hist_pos += 1; hist_pos >= HIST_N ? hist_pos = 0;
  mon_ck_pk = 0; mon_at_pk = 0; mon_mr_pk = 0; mon_in_pk = 0;
);

// ---- Testata (stile hardware ZP Suite) ----
draw_hw_panel(0, 0, zp_vw, 42);
gfx_set(c_cyan_r, c_cyan_g, c_cyan_b, 0.95); zp_rect(0, 0, zp_vw, 2);
zp_setfont(2, "Arial", 17, 'b'); gfx_set(txt_r, txt_g, txt_b, 1);
zp_gx = 14; zp_gy = 11; zp_drawstr("ZP Click & Attack Softener");
gfx_set(card2_r, card2_g, card2_b, 1); zp_rect(256, 13, 46, 18);
gfx_set(c_cyan_r, c_cyan_g, c_cyan_b, 0.75); zp_frame(256, 13, 46, 18);
zp_setfont(1, "Arial", 10, 'b'); gfx_set(c_cyan_r, c_cyan_g, c_cyan_b, 1);
(gfx_measurestr("v1.4", tw, th); tw /= zp_sc; th /= zp_sc);
zp_gx = 256 + (46 - tw) * 0.5; zp_gy = 13 + (18 - th) * 0.5; zp_drawstr("v1.4");

ui_btn(676, 8, 62, 26, ui_theme == 0 ? "CHIARO" : "SCURO", ui_theme == 1, c_cyan_r, c_cyan_g, c_cyan_b,
  "Alterna tema cromatico Scuro e Chiaro.", 0) ? set_param(13, ui_theme == 0 ? 1 : 0);
ui_btn(744, 8, 72, 26, slider14 >= 0.5 ? "JSFX" : "GUI", slider14 >= 0.5, c_grn_r, c_grn_g, c_grn_b,
  "Mostra o nasconde gli slider nativi di REAPER e le letture [Read] per OSARA.", 0) ? set_param(14, slider14 >= 0.5 ? 0 : 1);
btn_click = click;
ui_btn(822, 8, 24, 26, "?", help_open, c_amber_r, c_amber_g, c_amber_b,
  "Apre la guida rapida di ZP Click & Attack Softener.", 0) ? (help_open = !help_open);
btn_click = click && !help_open;

// ---- Barra Preset + DELTA / D·MOLLA ----
draw_hw_panel(14, 48, 832, 36);
cur_p = floor(slider12 + 0.5);
ui_btn(22,  54, 104, 24, "PRE-CHAIN",   cur_p == 1, c_coral_r, c_coral_g, c_coral_b,
  "Prima di Magic Voice: Macro Click + Micro-Click spettrale (65%) per pulizia chirurgica sul pulito.", 0) ? apply_preset(1);
ui_btn(132, 54, 110, 24, "POST-CHAIN",  cur_p == 2, c_cyan_r,  c_cyan_g,  c_cyan_b,
  "Dopo il processo, prima dell'uscita: ammorbidisce gli attacchi esaltati (Micro-Click OFF).", 0) ? apply_preset(2);
ui_btn(248, 54, 112, 24, "TAKE SPORCO", cur_p == 3, c_amber_r, c_amber_g, c_amber_b,
  "Taratura incisiva con Micro-Click all'85% per riprese ricche di micro-impulsi nelle consonanti.", 0) ? apply_preset(3);
ui_btn(366, 54, 96,  24, "DELICATO",    cur_p == 4, c_grn_r,   c_grn_g,   c_grn_b,
  "Intervento leggero (Micro-Click 40%) per voiceover gia' pulito o lettura intima broadcast.", 0) ? apply_preset(4);

gfx_set(line_r, line_g, line_b, 0.75); zp_line(640, 53, 640, 79);

delta_on_ui = slider11 >= 0.5;
delta_blink = sin(time_now * 7.0) > 0;
delta_on_ui ? (
  ui_btn(652, 54, 88, 24, "DELTA", 1, delta_blink ? 0.96 : 0.98, delta_blink ? 0.22 : 0.62, delta_blink ? 0.46 : 0.14,
    "DELTA attivo: ascolti solo cio' che viene tolto (auto-off dopo 30 s).", 0) ? (
    set_param(11, 0);
  );
) : (
  ui_btn(652, 54, 88, 24, "DELTA", 0, c_mag_r, c_mag_g, c_mag_b,
    "Attiva il DELTA globale (auto-off a 30 s) per ascoltare Macro Click, Micro-Click e attacchi rimossi.", 0) ? (
