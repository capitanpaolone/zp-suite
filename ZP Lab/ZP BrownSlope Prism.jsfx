desc:ZP BrownSlope Prism - Passive Brown Slope Analyzer - Paolo Balestri
// Autore: Paolo Balestri
// Versione: 0.1-lab
//
// Analizzatore PASSIVO: l'audio passa intatto. Mostra lo spettro del programma
// come TDR Prism con "Slope 4.5 dB/oct": compensando 4,5 dB per ottava, un rumore
// brown diventa una linea piatta. Le due linee di riferimento sono i loop
// "-4.5 dB/octave" a -18 e -24 LUFS misurati con lo stesso calcolo di questo
// plugin (FFT 8192 Hann, densita' per Hz, media L/R, bande da 1/6 di ottava).
// Sei "pareggiato" quando la curva arancione e' piatta e sta sulla linea scelta.
//
// Letture: scarto in dB per zona (Bassi, Medio-bassi, Medio-alti, Alti),
// pendenza residua in dB/ottava (positiva = piu' brillante del brown) e
// livello rispetto al riferimento. In "Forma" il livello viene tolto: conta solo l'EQ.
// Calibra: suonando il file di riferimento con media Lunga, Calibra memorizza la
// curva misurata per il riferimento scelto (salvata col progetto); Default la toglie.

slider1:0<0,1,1{-18 LUFS,-24 LUFS}>Riferimento
slider2:1<0,1,1{Livello,Forma (solo EQ)}>Confronto
slider3:3<0,3,1{Veloce 0.3 s,Media 1 s,Lenta 3 s,Lunga (fino a Reset)}>Media
slider4:2<0,3,1{0 dB/oct,3 dB/oct,4.5 dB/oct,6 dB/oct}>Pendenza grafico
slider5:0<0,1,1{-,Reset}>Reset media
slider6:0<0,1,1{GUI,JSFX (lista parametri, OSARA)}>Vista
slider7:18<6,30,1>Scala grafico (+/- dB)
slider10:0<-30,30,0.1>[Read] Bassi 40-160 Hz (dB)
slider11:0<-30,30,0.1>[Read] Medio-bassi 160-800 Hz (dB)
slider12:0<-30,30,0.1>[Read] Medio-alti 800 Hz-4 kHz (dB)
slider13:0<-30,30,0.1>[Read] Alti 4-14 kHz (dB)
slider14:0<-6,6,0.01>[Read] Pendenza residua (dB/oct)
slider15:0<-40,40,0.1>[Read] Livello vs riferimento (dB)
slider16:0<0,2,1{Non pareggiato,Quasi,Pareggiato}>[Read] Esito

options:gmem=ZPVoiceoverSharedBus
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;   // la media lunga non si azzera a ogni Play

// Ponte guida (gmem ZPVoiceoverSharedBus 3900-3905, Cue Navigator): "?" apre la sezione HTML del plugin.
// Il ponte e' acceso solo se il battito (3900) cambia: un numero fermo da piu' di 3 s = Cue Navigator spento.
hb_seen = 0; hb_last = 0; hb_t = -10; help_warn_until = 0;
function help_bridge_alive() local(hb, now) (
  hb = gmem[3900]; now = time_precise();
  !hb_seen ? (hb_last = hb; hb_seen = 1) : hb != hb_last ? (hb_last = hb; hb_t = now);
  hb > 0 && now - hb_t < 3;
);
function help_bridge_open(plugin_id) (
  help_bridge_alive() ? (gmem[3902] = plugin_id; gmem[3903] += 1; help_warn_until = 0;)
  : (help_warn_until = time_precise() + 4.0);
);
function help_bridge_warn() local(tw2, th2) (
  time_precise() < help_warn_until ? (
    gfx_setfont(9, "Arial", 14);
    gfx_measurestr("Guida: avvia il Cue Navigator (33 Benvenuto) per aprirla da qui, oppure Help ZP > ZP Lab.", tw2, th2);
    gfx_set(0.10, 0.08, 0.04, 0.95); gfx_rect(16, gfx_h - th2 - 22, tw2 + 20, th2 + 12);
    gfx_set(1.0, 0.78, 0.35, 1); gfx_x = 26; gfx_y = gfx_h - th2 - 16;
    gfx_drawstr("Guida: avvia il Cue Navigator (33 Benvenuto) per aprirla da qui, oppure Help ZP > ZP Lab.");
  );
);
// JSFX non accetta la notazione scientifica (1e-30): costanti calcolate qui
TINY = 10 ^ (-30); SILENCE = 10 ^ (-8); EPSDEN = 10 ^ (-9);
target = slider1; compare = slider2; avgmode = slider3; slopesel = slider4; RANGE = slider7;
N = 8192; half = N / 2; hop = N / 2;
ringL = 0; ringR = N; buf = 2 * N; win = 3 * N; avg = 4 * N; cur = 5 * N;
NB = 63; KMIN = -36;
bfc = 6 * N; blo = bfc + 64; bhi = blo + 64; bdb = bhi + 64; dev = bdb + 64;
ref = dev + 64; cal18 = ref + 64; cal24 = cal18 + 64; reft = cal24 + 64;
REF24_OFFSET = 5.91;
LOG2 = log(2);

// Riferimento -18 LUFS misurato dal loop "-4.5dB_octave -18LUFS" (gia' compensato
// 4.5 dB/oct, lisciato su ~1/2 ottava). Bande 1000*2^(k/6), k = -36..26.
i = 0;
ref[i] = -61.22; i += 1; ref[i] = -61.18; i += 1; ref[i] = -61.03; i += 1; ref[i] = -60.97; i += 1;
ref[i] = -61.05; i += 1; ref[i] = -61.12; i += 1; ref[i] = -61.04; i += 1; ref[i] = -61.00; i += 1;
ref[i] = -60.89; i += 1; ref[i] = -60.90; i += 1; ref[i] = -60.95; i += 1; ref[i] = -60.78; i += 1;
ref[i] = -60.69; i += 1; ref[i] = -60.55; i += 1; ref[i] = -60.51; i += 1; ref[i] = -60.55; i += 1;
ref[i] = -60.58; i += 1; ref[i] = -60.55; i += 1; ref[i] = -60.58; i += 1; ref[i] = -60.57; i += 1;
ref[i] = -60.67; i += 1; ref[i] = -60.70; i += 1; ref[i] = -60.68; i += 1; ref[i] = -60.61; i += 1;
ref[i] = -60.54; i += 1; ref[i] = -60.45; i += 1; ref[i] = -60.41; i += 1; ref[i] = -60.32; i += 1;
ref[i] = -60.28; i += 1; ref[i] = -60.25; i += 1; ref[i] = -60.30; i += 1; ref[i] = -60.26; i += 1;
ref[i] = -60.24; i += 1; ref[i] = -60.20; i += 1; ref[i] = -60.14; i += 1; ref[i] = -60.03; i += 1;
ref[i] = -59.96; i += 1; ref[i] = -59.87; i += 1; ref[i] = -59.86; i += 1; ref[i] = -59.82; i += 1;
ref[i] = -59.78; i += 1; ref[i] = -59.73; i += 1; ref[i] = -59.73; i += 1; ref[i] = -59.69; i += 1;
ref[i] = -59.66; i += 1; ref[i] = -59.60; i += 1; ref[i] = -59.54; i += 1; ref[i] = -59.52; i += 1;
ref[i] = -59.49; i += 1; ref[i] = -59.46; i += 1; ref[i] = -59.44; i += 1; ref[i] = -59.42; i += 1;
ref[i] = -59.41; i += 1; ref[i] = -59.41; i += 1; ref[i] = -59.43; i += 1; ref[i] = -59.44; i += 1;
ref[i] = -59.45; i += 1; ref[i] = -59.49; i += 1; ref[i] = -59.53; i += 1; ref[i] = -59.59; i += 1;
ref[i] = -59.61; i += 1; ref[i] = -59.64; i += 1; ref[i] = -59.68;

// finestra di Hann simmetrica e sua energia
wsum2 = 0; i = 0;
loop(N, win[i] = 0.5 - 0.5 * cos(2 * $pi * i / (N - 1)); wsum2 += win[i] * win[i]; i += 1;);
psd_scale = 2 / (srate * wsum2) * 0.5;   // densita' unilaterale per Hz, media L/R

// bande da 1/6 di ottava: bin compresi in [fc*2^-1/12, fc*2^1/12)
binw = srate / N; b = 0;
loop(NB,
  fc = 1000 * 2 ^ ((b + KMIN) / 6);
  bfc[b] = fc;
  lo = max(1, ceil(fc * 2 ^ (-1 / 12) / binw));
  hi = min(half - 1, ceil(fc * 2 ^ (1 / 12) / binw) - 1);
  hi < lo ? (lo = max(1, min(half - 1, floor(fc / binw + 0.5))); hi = lo;);
  blo[b] = lo; bhi[b] = hi;
  b += 1;
);

pos = 0; hopc = 0; frames = 0; seconds = 0; have_data = 0;
memset(avg, 0, half + 1);
!cal_init ? (cal18_ok = 0; cal24_ok = 0; cal_init = 1;);

function slope_db() ( slopesel == 0 ? 0 : slopesel == 1 ? 3 : slopesel == 2 ? 4.5 : 6; );

function reset_avg() ( memset(avg, 0, half + 1); frames = 0; seconds = 0; have_data = 0; );

function do_channel(ring) local(i, j, re, im, k) (
  i = 0; j = pos;
  loop(N, buf[i] = ring[j] * win[i]; i += 1; j += 1; j >= N ? (j = 0););
  fft_real(buf, N);
  fft_permute(buf, N / 2);
  k = 1;
  loop(half - 1, re = buf[2 * k]; im = buf[2 * k + 1]; cur[k] += re * re + im * im; k += 1;);
);

// riferimento attivo per la banda b, con la stessa pendenza del grafico
function ref_at(b, which) local(base) (
  which == 0 ? (base = cal18_ok ? cal18[b] : ref[b];)
             : (base = cal24_ok ? cal24[b] : ref[b] - REF24_OFFSET;);
  base + (slope_db() - 4.5) * log(bfc[b] / 1000) / LOG2;
);

function compute_bands() local(b, k, s, n, sd, x, sx, sy, sxx, sxy, cnt, z1, z2, z3, z4, c1, c2, c3, c4, f, d, okz) (
  sd = slope_db();
  b = 0; sx = sy = sxx = sxy = cnt = 0; z1 = z2 = z3 = z4 = c1 = c2 = c3 = c4 = 0;
  loop(NB,
    s = 0; n = 0; k = blo[b];
    loop(bhi[b] - blo[b] + 1, s += avg[k]; n += 1; k += 1;);
    bdb[b] = 10 * log10(max(s / max(n, 1), TINY)) + sd * log(bfc[b] / 1000) / LOG2;
    reft[b] = ref_at(b, target);
    dev[b] = bdb[b] - reft[b];
    f = bfc[b]; d = dev[b];
    f >= 50 && f <= 12000 ? (x = log(f / 1000) / LOG2; sx += x; sy += d; sxx += x * x; sxy += x * d; cnt += 1;);
    f >= 40 && f < 160 ? (z1 += d; c1 += 1;);
    f >= 160 && f < 800 ? (z2 += d; c2 += 1;);
    f >= 800 && f < 4000 ? (z3 += d; c3 += 1;);
    f >= 4000 && f <= 14000 ? (z4 += d; c4 += 1;);
    b += 1;
  );
  level = cnt > 0 ? sy / cnt : 0;
  tilt = cnt > 1 ? (cnt * sxy - sx * sy) / max(cnt * sxx - sx * sx, EPSDEN) : 0;
  off = compare == 1 ? level : 0;
  zb = z1 / max(c1, 1) - off; zlm = z2 / max(c2, 1) - off; zmh = z3 / max(c3, 1) - off; zh = z4 / max(c4, 1) - off;
  okz = abs(zb) <= 1.5 && abs(zlm) <= 1.5 && abs(zmh) <= 1.5 && abs(zh) <= 1.5 && abs(tilt) <= 0.5;
  verdict = !have_data ? 0 : okz && (compare == 1 || abs(level) <= 1.5) ? 2
          : (abs(zb) <= 3 && abs(zlm) <= 3 && abs(zmh) <= 3 && abs(zh) <= 3 && abs(tilt) <= 1) ? 1 : 0;
);

function analyze() local(k, tot, alpha, p) (
  memset(cur, 0, half + 1);
  do_channel(ringL);
  do_channel(ringR);
  tot = 0; k = 1;
  loop(half - 1, tot += cur[k]; k += 1;);
  tot *= psd_scale * binw;   // potenza media del frame (circa il valore quadratico medio)
  tot > SILENCE ? (             // sotto -80 dB: silenzio, la misura resta ferma
    frames += 1; seconds += hop / srate; have_data = 1;
    alpha = avgmode == 3 ? 1 / frames : 1 - exp(-hop / (srate * (avgmode == 0 ? 0.3 : avgmode == 1 ? 1 : 3)));
    k = 1;
    loop(half - 1, p = cur[k] * psd_scale; avg[k] += alpha * (p - avg[k]); k += 1;);
    compute_bands();
  );
);

// Vista: in GUI la lista parametri di REAPER sparisce del tutto (restano i comandi
// grafici; i parametri esistono comunque e OSARA li raggiunge); in JSFX torna tutta,
// letture [Read] comprese.
function update_visibility() local(show, n) (
  show = slider6 >= 0.5;
  // slider_show vuole una maschera di bit: 2^(n-1) = sliderN
  n = 1; loop(5, slider_show(2 ^ (n - 1), show); n += 1;);
  slider_show(2 ^ 5, show); slider_show(2 ^ 6, show);   // in GUI anche Vista sparisce: OSARA la raggiunge lo stesso
  n = 10; loop(7, slider_show(2 ^ (n - 1), show); n += 1;);
);

function sync_params() (
  slider3 != avgmode ? (avgmode = slider3; reset_avg(););
  target = slider1; compare = slider2; slopesel = slider4; RANGE = slider7;
  update_visibility();
  have_data ? compute_bands();
);

// cambia un parametro dalla GUI come lo cambierebbe l'utente (automazione e undo)
function set_param(idx, v) local(m) (
  slider(idx) = v; m = 2 ^ (idx - 1); sliderchange(m); slider_automate(m);
  sync_params();
);

// pulsante stile Suite: restituisce 1 al clic (btn_click decide se i clic valgono)
function ui_button(x, y, w, h, label, on, hint) local(hov) (
  hov = mouse_x >= x && mouse_x <= x + w && mouse_y >= y && mouse_y <= y + h;
  hov ? strcpy(#hint, hint);
  on ? gfx_set(0.16, 0.40, 0.34, 1) : hov ? gfx_set(0.18, 0.20, 0.25, 1) : gfx_set(0.12, 0.13, 0.16, 1);
  gfx_rect(x, y, w, h);
  on ? gfx_set(0.40, 0.88, 0.60, 1) : hov ? gfx_set(0.75, 0.80, 0.88, 1) : gfx_set(0.32, 0.33, 0.40, 1);
  gfx_line(x, y, x + w - 1, y); gfx_line(x, y + h - 1, x + w - 1, y + h - 1);
  gfx_line(x, y, x, y + h - 1); gfx_line(x + w - 1, y, x + w - 1, y + h - 1);
  gfx_setfont(1, "Arial", 14); gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) / 2; gfx_y = y + (h - th) / 2;
  gfx_set(0.92, 0.94, 0.96, 1); gfx_drawstr(label);
  hov && btn_click;
);

// pomello stile Suite: trascina in verticale; doppio clic o clic destro = valore di partenza.
// steps > 0: valori interi (pomello a scatti).
function ui_knob(idx, cx, cy, r, minv, maxv, defv, steps, label, valstr, hint) local(v, hov, n, a, a0, a1, k, x1, y1, x2, y2, now)
(
  v = slider(idx);
  hov = mouse_x >= cx - r - 8 && mouse_x <= cx + r + 8 && mouse_y >= cy - r - 8 && mouse_y <= cy + r + 30;
  hov ? strcpy(#hint, hint);
  hov && btn_click ? (
    now = time_precise();
    kn_last == idx && now - kn_last_t < 0.35 ? (set_param(idx, defv); kn_drag = 0;) : (kn_drag = idx; kn_y = mouse_y; kn_v = v;);
    kn_last = idx; kn_last_t = now;
  );
  hov && rclick && !help_open ? set_param(idx, defv);
  kn_drag == idx ? (
    mouse_cap & 1 ? (
      n = kn_v + (kn_y - mouse_y) * (maxv - minv) / (steps > 0 ? 70 : 160);
      n = max(minv, min(maxv, n));
      steps > 0 ? (n = floor(n + 0.5));
      n != slider(idx) ? set_param(idx, n);
    ) : (kn_drag = 0);
  );
  v = slider(idx);
  a0 = 0.75 * $pi; a1 = 2.25 * $pi;
  a = a0 + (v - minv) / max(maxv - minv, 0.0001) * (a1 - a0);
  (hov || kn_drag == idx) ? (gfx_set(0.40, 0.88, 0.60, 0.12); gfx_circle(cx, cy, r + 7, 1, 1););
  gfx_set(0.16, 0.17, 0.20, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.30, 0.31, 0.36, 1); gfx_circle(cx, cy, r, 0, 1);
  k = 0;   // arco del valore, a segmenti
  loop(40,
    x1 = a0 + (a - a0) * k / 40; x2 = a0 + (a - a0) * (k + 1) / 40;
    gfx_set(0.40, 0.88, 0.60, 1);
    gfx_line(cx + cos(x1) * (r - 3), cy + sin(x1) * (r - 3), cx + cos(x2) * (r - 3), cy + sin(x2) * (r - 3), 1);
    gfx_line(cx + cos(x1) * (r - 4), cy + sin(x1) * (r - 4), cx + cos(x2) * (r - 4), cy + sin(x2) * (r - 4), 1);
    k += 1;
  );
  gfx_set(0.92, 0.92, 0.92, 1);
  gfx_line(cx + cos(a) * (r * 0.25), cy + sin(a) * (r * 0.25), cx + cos(a) * (r - 6), cy + sin(a) * (r - 6), 1);
  gfx_setfont(1, "Arial", 12); gfx_set(0.62, 0.66, 0.72, 1);
  gfx_measurestr(label, tw, th); gfx_x = cx - tw / 2; gfx_y = cy + r + 4; gfx_drawstr(label);
  gfx_set(0.92, 0.94, 0.96, 1);
  gfx_measurestr(valstr, tw, th); gfx_x = cx - tw / 2; gfx_y = cy + r + 17; gfx_drawstr(valstr);
);

// guida sovrapposta, come nei pannelli di Master Pro
function help_overlay() local(px, py, pw, ph, cx, cy, hc, ly) (
  pw = min(820, max(520, gfx_w - 48)); px = floor((gfx_w - pw) / 2); py = 60; ph = min(470, gfx_h - 90);
  gfx_set(0.025, 0.027, 0.030, 0.96); gfx_rect(px, py, pw, ph);
  gfx_set(0.40, 0.88, 0.60, 1); gfx_rect(px, py, pw, 2); gfx_rect(px, py + ph - 2, pw, 2); gfx_rect(px, py, 2, ph); gfx_rect(px + pw - 2, py, 2, ph);
  gfx_setfont(2, "Arial", 22, 'b'); gfx_set(0.94, 0.96, 0.98, 1); gfx_x = px + 24; gfx_y = py + 16; gfx_drawstr("BrownSlope Prism - come si legge");
  cx = px + pw - 44; cy = py + 16;
  hc = mouse_x >= cx && mouse_x <= cx + 28 && mouse_y >= cy && mouse_y <= cy + 28;
  hc ? gfx_set(0.28, 0.12, 0.10, 1) : gfx_set(0.14, 0.12, 0.12, 1); gfx_rect(cx, cy, 28, 28);
  gfx_setfont(1, "Arial", 16, 'b'); gfx_set(0.94, 0.80, 0.78, 1); gfx_measurestr("X", tw, th); gfx_x = cx + (28 - tw) / 2; gfx_y = cy + (28 - th) / 2; gfx_drawstr("X");
  hc && click ? (help_open = 0);
  // GUIDA COMPLETA: apre la sezione del plugin nella guida HTML (ponte del Cue Navigator)
  hc = mouse_x >= cx - 188 && mouse_x <= cx - 8 && mouse_y >= cy && mouse_y <= cy + 28;
  hc ? gfx_set(0.16, 0.40, 0.34, 1) : gfx_set(0.12, 0.13, 0.16, 1); gfx_rect(cx - 188, cy, 180, 28);
  gfx_setfont(9, "Arial", 14, 'b'); gfx_set(0.72, 0.92, 0.82, 1); gfx_measurestr("GUIDA COMPLETA", tw, th);
  gfx_x = cx - 188 + (180 - tw) / 2; gfx_y = cy + (28 - th) / 2; gfx_drawstr("GUIDA COMPLETA");
  hc && click ? help_bridge_open(12);
  ly = py + 58; gfx_setfont(1, "Arial", 15);
  gfx_set(0.84, 0.86, 0.86, 1);
  gfx_x = px + 24; gfx_y = ly; gfx_drawstr("Il grafico compensa 4,5 dB per ottava: un rumore brown diventa una linea piatta."); ly += 24;
  gfx_x = px + 24; gfx_y = ly; gfx_drawstr("Verde: i riferimenti -18 e -24 LUFS (misurati dai loop brown). Arancio: il tuo audio."); ly += 24;
  gfx_set(0.98, 0.74, 0.32, 1);
  gfx_x = px + 24; gfx_y = ly; gfx_drawstr("Sei pareggiato quando l'arancio e' piatto e sta sulla linea scelta."); ly += 34;
  gfx_set(0.84, 0.86, 0.86, 1);
  gfx_x = px + 24; gfx_y = ly; gfx_drawstr("Zone: scarto medio in dB. Verde entro 1,5 - giallo entro 3 - rosso oltre."); ly += 24;
  gfx_x = px + 24; gfx_y = ly; gfx_drawstr("Pendenza residua: + = piu' brillante del brown, - = piu' scuro."); ly += 24;
  gfx_x = px + 24; gfx_y = ly; gfx_drawstr("Forma: toglie la differenza di livello e confronta solo l'EQ. Livello: conta anche il volume."); ly += 34;
  gfx_set(0.72, 0.92, 0.82, 1);
  gfx_x = px + 24; gfx_y = ly; gfx_drawstr("Media lunga: misura tutto il brano finche' non premi Reset; nei silenzi si ferma."); ly += 24;
  gfx_x = px + 24; gfx_y = ly; gfx_drawstr("Pomelli: trascina in verticale; doppio clic o clic destro = valore di partenza."); ly += 24;
  gfx_x = px + 24; gfx_y = ly; gfx_drawstr("Calibra: suona il loop di riferimento con media lunga e premi Calibra. Default la toglie."); ly += 34;
  gfx_set(0.62, 0.72, 0.82, 1);
  gfx_x = px + 24; gfx_y = ly; gfx_drawstr("Vista JSFX: riporta la lista parametri di REAPER, letture comprese, per OSARA."); ly += 24;
  gfx_x = px + 24; gfx_y = ly; gfx_drawstr("Passivo: l'audio passa intatto.");
);

update_visibility();

// funzioni del grafico (definite qui, usate in @gfx)
function xf(f) ( gx0 + (log(f / 15) / log(20000 / 15)) * (gx1 - gx0); );
function yv(v) ( gy0 + (RANGE - (v - ymid)) / (2 * RANGE) * (gy1 - gy0); );
function zone_box(x, y, w, label, v) local(c) (
  c = abs(v) <= 1.5 ? 0 : abs(v) <= 3 ? 1 : 2;
  gfx_set(0.12, 0.13, 0.15, 1); gfx_rect(x, y, w, 52);
  gfx_set(0.62, 0.66, 0.72, 1); gfx_x = x + 10; gfx_y = y + 6; gfx_setfont(1, "Arial", 13); gfx_drawstr(label);
  c == 0 ? gfx_set(0.40, 0.88, 0.60, 1) : c == 1 ? gfx_set(0.95, 0.78, 0.35, 1) : gfx_set(0.98, 0.45, 0.35, 1);
  gfx_setfont(2, "Arial", 22, 'b'); gfx_x = x + 10; gfx_y = y + 24;
  have_data ? sprintf(#zs, "%+.1f dB", v) : (#zs = "--");
  gfx_drawstr(#zs);
);


@slider
slider5 ? (reset_avg(); slider5 = 0; sliderchange(slider5););
sync_params();

@block
// letture per OSARA e per la vista a parametri, aggiornate ~4 volte al secondo
(rd_t += samplesblock) >= srate * 0.25 ? (
  rd_t = 0;
  slider10 = zb; slider11 = zlm; slider12 = zmh; slider13 = zh;
  slider14 = tilt; slider15 = level; slider16 = verdict;
  sliderchange(slider10); sliderchange(slider11); sliderchange(slider12); sliderchange(slider13);
  sliderchange(slider14); sliderchange(slider15); sliderchange(slider16);
);

@sample
ringL[pos] = spl0;
ringR[pos] = num_ch > 1 ? spl1 : spl0;
pos += 1; pos >= N ? (pos = 0);
(hopc += 1) >= hop ? (hopc = 0; analyze(););

@serialize
file_var(0, cal18_ok);
file_var(0, cal24_ok);
file_mem(0, cal18, NB);
file_mem(0, cal24, NB);
cal_init = 1;

@gfx 900 600
help_bridge_alive();   // battito del ponte guida, a ogni giro
click = (mouse_cap & 1) && !last_cap; last_cap = mouse_cap & 1;
rclick = (mouse_cap & 2) && !last_rcap; last_rcap = mouse_cap & 2;
gfx_set(0.07, 0.08, 0.09, 1); gfx_rect(0, 0, gfx_w, gfx_h);
#hint = "";
btn_click = click && !help_open;

// testata
gfx_setfont(2, "Arial", 18, 'b'); gfx_set(0.92, 0.88, 0.78, 1); gfx_x = 16; gfx_y = 12;
gfx_drawstr("ZP BrownSlope Prism");

// pulsanti in alto a destra
bx = gfx_w - 16;
bx -= 34; btn_click = click;
ui_button(bx, 12, 30, 28, "?", help_open, "Guida: come leggere il grafico e come usarlo.") ? (help_open = !help_open);
btn_click = click && !help_open;
bx -= 116; ui_button(bx, 12, 112, 28, slider6 >= 0.5 ? "Vista: JSFX" : "Vista: GUI", slider6 >= 0.5,
  "JSFX riporta la lista parametri di REAPER (letture comprese) per OSARA e screen reader.") ? set_param(6, slider6 >= 0.5 ? 0 : 1);

// striscia comandi: pulsanti e pomelli
cy0 = 52;
gfx_set(0.10, 0.11, 0.13, 1); gfx_rect(12, cy0, gfx_w - 24, 74);
x = 24;
ui_button(x, cy0 + 10, 96, 26, target == 0 ? "Rif. -18" : "Rif. -24", 1,
  "Riferimento: brown a -18 o -24 LUFS. Clic per cambiare.") ? set_param(1, !target);
ui_button(x, cy0 + 40, 96, 26, compare == 1 ? "Forma" : "Livello", compare == 1,
  "Forma: confronta solo l'EQ. Livello: conta anche il volume.") ? set_param(2, !compare);
x += 110;
ui_button(x, cy0 + 10, 84, 26, "Reset", 0, "Riparte la media da zero.") ? reset_avg();
ui_button(x, cy0 + 40, 84, 26, "Calibra", (target == 0 ? cal18_ok : cal24_ok),
  "Memorizza la curva misurata come riferimento (suona il loop brown con media lunga).") && have_data ? (
  i = 0; sd = slope_db(); cbase = target == 0 ? cal18 : cal24;
  loop(NB, cbase[i] = bdb[i] - (sd - 4.5) * log(bfc[i] / 1000) / LOG2; i += 1;);
  target == 0 ? (cal18_ok = 1) : (cal24_ok = 1); compute_bands();
);
x += 98;
ui_button(x, cy0 + 40, 84, 26, "Default", 0, "Toglie la calibrazione del riferimento scelto.") ? (
  target == 0 ? (cal18_ok = 0) : (cal24_ok = 0); compute_bands(););
x += 130;
ui_knob(3, x, cy0 + 26, 17, 0, 3, 3, 1, "Media",
  avgmode == 0 ? "veloce" : avgmode == 1 ? "1 s" : avgmode == 2 ? "lenta" : "lunga",
  "Media: veloce 0,3 s, 1 s, lenta 3 s, lunga fino a Reset.");
x += 96;
ui_knob(4, x, cy0 + 26, 17, 0, 3, 2, 1, "Pendenza",
  slopesel == 0 ? "0 dB/oct" : slopesel == 1 ? "3 dB/oct" : slopesel == 2 ? "4,5 dB/oct" : "6 dB/oct",
  "Compensazione del grafico. 4,5 = come Prism: il brown e' piatto.");
x += 96;
sprintf(#scala, "+/- %d dB", RANGE);
ui_knob(7, x, cy0 + 26, 17, 6, 30, 18, 1, "Scala", #scala, "Quanti dB mostra il grafico sopra e sotto il riferimento.");

// riga di stato: il suggerimento del comando sotto il mouse, altrimenti lo stato
gfx_setfont(1, "Arial", 13); gfx_x = 220; gfx_y = 18;
strlen(#hint) ? (gfx_set(0.62, 0.78, 0.92, 1); gfx_drawstr(#hint);) : (
  gfx_set(0.56, 0.72, 0.86, 1);
  sprintf(#st, "passivo - analizzati %.0f s%s", seconds, cal18_ok || cal24_ok ? " - calibrato" : "");
  gfx_drawstr(#st);
);

// grafico
gx0 = 56; gx1 = gfx_w - 18; gy0 = 138; gy1 = gfx_h - 96;
// centro verticale: la media del riferimento scelto
i = 0; ymid = 0; loop(NB, ymid += ref_at(i, target); i += 1;); ymid /= NB;
gfx_set(0.10, 0.11, 0.12, 1); gfx_rect(gx0, gy0, gx1 - gx0, gy1 - gy0);
gfx_setfont(1, "Arial", 12);
v = -RANGE;
loop(7,
  y = yv(ymid + v); gfx_set(0.20, 0.21, 0.23, 1); gfx_line(gx0, y, gx1, y);
  gfx_set(0.55, 0.58, 0.62, 1); gfx_x = 8; gfx_y = y - 6; sprintf(#lb, "%+d", v); v == 0 ? (#lb = "0"); gfx_drawstr(#lb);
  v += 6;
);
f = 20;
loop(10,
  x = xf(f); gfx_set(0.20, 0.21, 0.23, 1); gfx_line(x, gy0, x, gy1);
  gfx_set(0.55, 0.58, 0.62, 1); gfx_x = x - 10; gfx_y = gy1 + 4;
  f >= 1000 ? sprintf(#lb, "%dk", f / 1000) : sprintf(#lb, "%d", f); gfx_drawstr(#lb);
  f = f == 20 ? 50 : f == 50 ? 100 : f == 100 ? 200 : f == 200 ? 500 : f == 500 ? 1000 : f == 1000 ? 2000 : f == 2000 ? 5000 : f == 5000 ? 10000 : 20000;
);
// zone
gfx_set(0.16, 0.17, 0.19, 1);
gfx_line(xf(160), gy0, xf(160), gy1); gfx_line(xf(800), gy0, xf(800), gy1); gfx_line(xf(4000), gy0, xf(4000), gy1);

// riferimenti: quello scelto pieno, l'altro tenue
w2 = 0;
loop(2,
  which = w2 == 0 ? (target == 0 ? 1 : 0) : target;
  which == target ? gfx_set(0.40, 0.88, 0.60, 1) : gfx_set(0.40, 0.88, 0.60, 0.35);
  i = 1;
  loop(NB - 1,
    gfx_line(xf(bfc[i - 1]), yv(ref_at(i - 1, which)), xf(bfc[i]), yv(ref_at(i, which)), 1);
    which == target ? gfx_line(xf(bfc[i - 1]), yv(ref_at(i - 1, which)) + 1, xf(bfc[i]), yv(ref_at(i, which)) + 1, 1);
    i += 1;
  );
  gfx_x = gx1 - 70; gfx_y = yv(ref_at(NB - 1, which)) - 16;
  gfx_drawstr(which == 0 ? "-18 LUFS" : "-24 LUFS");
  w2 += 1;
);

// programma (arancio), in "Forma" spostato del suo livello medio
have_data ? (
  shift = compare == 1 ? -level : 0;
  i = 0;
  loop(NB,
    y = max(gy0, min(gy1, yv(bdb[i] + shift)));
    gfx_set(1.0, 0.72, 0.45, 0.10); gfx_line(xf(bfc[i]), y, xf(bfc[i]), gy1);
    i > 0 ? (
      gfx_set(1.0, 0.72, 0.45, 1);
      gfx_line(xf(bfc[i - 1]), max(gy0, min(gy1, yv(bdb[i - 1] + shift))), xf(bfc[i]), y, 1);
      gfx_line(xf(bfc[i - 1]), max(gy0, min(gy1, yv(bdb[i - 1] + shift))) + 1, xf(bfc[i]), y + 1, 1);
    );
    i += 1;
  );
) : (
  gfx_set(0.62, 0.66, 0.72, 1); gfx_setfont(1, "Arial", 15);
  gfx_x = gx0 + 20; gfx_y = (gy0 + gy1) / 2 - 8;
  gfx_drawstr("In attesa di segnale (sotto -80 dB la misura resta ferma)");
);

// letture
zw = (gfx_w - 32 - 3 * 8 - 250) / 4; zy = gfx_h - 70;
zone_box(16, zy, zw, "Bassi 40-160", zb);
zone_box(16 + (zw + 8), zy, zw, "Medio-bassi 160-800", zlm);
zone_box(16 + 2 * (zw + 8), zy, zw, "Medio-alti 800-4k", zmh);
zone_box(16 + 3 * (zw + 8), zy, zw, "Alti 4k-14k", zh);
rx = 16 + 4 * (zw + 8);
gfx_set(0.12, 0.13, 0.15, 1); gfx_rect(rx, zy, gfx_w - 16 - rx, 52);
gfx_setfont(1, "Arial", 13); gfx_set(0.62, 0.66, 0.72, 1); gfx_x = rx + 10; gfx_y = zy + 6;
have_data ? sprintf(#t1, "Pendenza residua %+.2f dB/oct", tilt) : (#t1 = "Pendenza residua --");
gfx_drawstr(#t1);
gfx_x = rx + 10; gfx_y = zy + 21;
have_data ? sprintf(#t2, "Livello vs rif. %+.1f dB%s", level, compare == 1 ? " (ignorato)" : "") : (#t2 = "Livello --");
gfx_drawstr(#t2);
gfx_setfont(2, "Arial", 16, 'b'); gfx_x = rx + 10; gfx_y = zy + 35;
verdict == 2 ? (gfx_set(0.40, 0.88, 0.60, 1); gfx_drawstr("PAREGGIATO");)
: verdict == 1 ? (gfx_set(0.95, 0.78, 0.35, 1); gfx_drawstr("QUASI");)
: (gfx_set(0.98, 0.45, 0.35, 1); gfx_drawstr(have_data ? (tilt > 0.5 ? "PIU' BRILLANTE" : tilt < -0.5 ? "PIU' SCURO" : "NON PAREGGIATO") : "--"););

help_open ? help_overlay();
help_bridge_warn();
