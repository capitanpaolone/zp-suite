// ═══════════════════════════════════════════════════════════════
// MODULE COLOR ACCENT
// ═══════════════════════════════════════════════════════════════

// mod_active=1: colori normali; mod_active=0: grigi (modulo bypassato)
function set_mod_color(idx)
(
  idx==1 ? (mod_br=0.07;mod_bg=0.12;mod_bb=0.28; mod_er=0.16;mod_eg=0.26;mod_eb=0.52; mod_r=0.26;mod_g=0.55;mod_b=0.94;);
  idx==2 ? (mod_br=0.11;mod_bg=0.08;mod_bb=0.28; mod_er=0.22;mod_eg=0.16;mod_eb=0.54; mod_r=0.52;mod_g=0.34;mod_b=0.90;);
  idx==3 ? (mod_br=0.17;mod_bg=0.06;mod_bb=0.27; mod_er=0.34;mod_eg=0.12;mod_eb=0.52; mod_r=0.76;mod_g=0.26;mod_b=0.86;);
  idx==4 ? (mod_br=0.23;mod_bg=0.05;mod_bb=0.22; mod_er=0.46;mod_eg=0.10;mod_eb=0.44; mod_r=0.90;mod_g=0.22;mod_b=0.64;);
  idx==5 ? (mod_br=0.26;mod_bg=0.05;mod_bb=0.12; mod_er=0.52;mod_eg=0.10;mod_eb=0.22; mod_r=0.92;mod_g=0.24;mod_b=0.28;);
  idx==6 ? (mod_br=0.27;mod_bg=0.04;mod_bb=0.08; mod_er=0.54;mod_eg=0.08;mod_eb=0.16; mod_r=0.88;mod_g=0.16;mod_b=0.22;);
  idx==7 ? (mod_br=0.06;mod_bg=0.17;mod_bb=0.16; mod_er=0.10;mod_eg=0.42;mod_eb=0.40; mod_r=0.18;mod_g=0.78;mod_b=0.68;);
  mod_active == 0 ? (
    mod_br=0.10; mod_bg=0.10; mod_bb=0.11;
    mod_er=0.22; mod_eg=0.22; mod_eb=0.24;
    mod_r =0.36; mod_g =0.36; mod_b =0.40;
  );
);

// ═══════════════════════════════════════════════════════════════
// HEADER WIDGETS
// ═══════════════════════════════════════════════════════════════

function ui_tab_button(slider_id, set_val, x, y, w, h, label, cr, cg, cb, hover_id)
local(hover, selected, _tw, _th)
(
  selected = floor(slider(slider_id)+0.5) == set_val;
  hover = hit(x,y,w,h);
  hover ? ui_set_hover(hover_id);
  !ui_render_only && hover && mouse_click ? set_ui_slider(slider_id, set_val);
  selected ? gfx_set(cr,cg,cb,1) : gfx_set(0.18,0.18,0.20,1);
  gfx_rect(x,y,w,h);
  gfx_set(0.92,0.92,0.92,1); gfx_setfont(1,"Arial",12);
  gfx_measurestr(label,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+floor((h-_th)*0.5); gfx_drawstr(label);
);

function ui_profile_button(set_val, x, y, w, h, label, hover_id)
local(hover, selected, _tw, _th)
(
  selected = floor(slider(1)+0.5) == set_val;
  hover = hit(x,y,w,h);
  hover ? ui_set_hover(hover_id);
  !ui_render_only && hover && mouse_click ? apply_profile_gfx(set_val);
  selected ? gfx_set(0.12,0.42,0.18,1) : gfx_set(0.18,0.18,0.20,1);
  gfx_rect(x,y,w,h);
  gfx_set(0.92,0.92,0.92,1); gfx_setfont(1,"Arial",12);
  gfx_measurestr(label,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+floor((h-_th)*0.5); gfx_drawstr(label);
);

function ui_brown_preset_button(set_val, x, y, w, h, label, hover_id)
local(hover, selected, _tw, _th)
(
  selected = floor(slider(58)+0.5) == set_val;
  hover = hit(x,y,w,h);
  hover ? ui_set_hover(hover_id);
  !ui_render_only && hover && mouse_click ? apply_brown_preset_gfx(set_val);
  selected ? gfx_set(0.48,0.36,0.13,1) : gfx_set(0.12,0.16,0.22,1);
  gfx_rect(x,y,w,h);
  selected ? gfx_set(0.95,0.72,0.28,1) : gfx_set(0.32,0.28,0.18,1);
  gfx_rect(x,y,w,2); gfx_rect(x,y+h-2,w,2);
  selected ? gfx_set(1.0,0.92,0.70,1) : gfx_set(0.72,0.76,0.80,1);
  gfx_setfont(1,"Arial",10);
  gfx_measurestr(label,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+floor((h-_th)*0.5); gfx_drawstr(label);
);

function ui_brown_amu_button(x, y, w, h, label, hover_id)
local(hover, state, _tw, _th)
(
  state = brn_amu_on >= 0.5 ? 1 : 0;
  hover = hit(x,y,w,h);
  hover ? ui_set_hover(hover_id);
  !ui_render_only && hover && mouse_click ? (
    brn_amu_on = 1 - state;
    state = 1 - state;
  );
  state ? gfx_set(0.48,0.36,0.13,1) : gfx_set(0.12,0.16,0.22,1);
  gfx_rect(x,y,w,h);
  state ? gfx_set(0.95,0.72,0.28,1) : gfx_set(0.32,0.28,0.18,1);
  gfx_rect(x,y,w,2); gfx_rect(x,y+h-2,w,2);
  state ? gfx_set(1.0,0.92,0.70,1) : gfx_set(0.72,0.76,0.80,1);
  gfx_setfont(1,"Arial",10);
  gfx_measurestr(label,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+floor((h-_th)*0.5); gfx_drawstr(label);
);

function ui_brown_din_button(x, y, w, h, label, hover_id)
local(hover, state, _tw, _th)
(
  state = brn_points_dyn >= 0.5 ? 1 : 0;
  hover = hit(x,y,w,h);
  hover ? ui_set_hover(hover_id);
  !ui_render_only && hover && mouse_click ? (
    brn_points_dyn = 1 - state;
    state = 1 - state;
    dsp_needs_update = 1;
  );
  state ? gfx_set(0.10,0.42,0.34,1) : gfx_set(0.12,0.16,0.22,1);
  gfx_rect(x,y,w,h);
  state ? gfx_set(0.38,0.96,0.78,1) : gfx_set(0.32,0.28,0.18,1);
  gfx_rect(x,y,w,2); gfx_rect(x,y+h-2,w,2);
  state ? gfx_set(0.76,1.00,0.92,1) : gfx_set(0.72,0.76,0.80,1);
  gfx_setfont(1,"Arial",10);
  gfx_measurestr(label,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+floor((h-_th)*0.5); gfx_drawstr(label);
);

// cr/cg/cb = colore modulo (acceso); grigio se spento
function ui_mod_on(sl_idx, x, y, w, h, label, hover_id, cr, cg, cb)
local(hover, state, _tw, _th)
(
  state = floor(slider(sl_idx)+0.5);
  hover = hit(x,y,w,h);
  hover ? ui_set_hover(hover_id);
  !ui_render_only && hover && mouse_click ? ( set_ui_slider(sl_idx, 1-state); state=1-state; );
  state ? gfx_set(cr*0.45, cg*0.45, cb*0.45, 1) : gfx_set(0.14,0.14,0.16,1);
  gfx_rect(x,y,w,h);
  state ? gfx_set(cr, cg, cb, 1) : gfx_set(0.38,0.38,0.42,1);
  gfx_rect(x,y,w,2); gfx_rect(x,y+h-2,w,2);
  state ? gfx_set(1.0,1.0,1.0,1) : gfx_set(0.46,0.46,0.50,1);
  gfx_setfont(1,"Arial",12);
  gfx_measurestr(label,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+floor((h-_th)*0.5); gfx_drawstr(label);
);

// cr/cg/cb = colore modulo (pannello visibile); grigio se nascosto
function ui_io_btn(bit, x, y, w, h, label, hover_id, cr, cg, cb)
local(hover, state, mask_val, _tw, _th)
(
  mask_val = floor(slider(53)+0.5);
  state = (mask_val & bit) ? 1 : 0;
  hover = hit(x,y,w,h);
  hover ? ui_set_hover(hover_id);
  !ui_render_only && hover && mouse_click ? (
    state ? set_ui_slider(53, mask_val - (mask_val & bit)) : set_ui_slider(53, mask_val | bit);
  );
  state ? gfx_set(cr*0.30, cg*0.30, cb*0.30, 1) : gfx_set(0.11,0.11,0.13,1);
  gfx_rect(x,y,w,h);
  state ? gfx_set(cr, cg, cb, 1) : gfx_set(0.28,0.28,0.30,1);
  gfx_rect(x,y,w,1); gfx_rect(x,y+h-1,w,1);
  state ? gfx_set(1.0,1.0,1.0,1) : gfx_set(0.40,0.40,0.44,1);
  gfx_setfont(1,"Arial",10);
  gfx_measurestr(label,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+floor((h-_th)*0.5); gfx_drawstr(label);
);

function ui_sc_hpf_knob(sl_idx, cx, cy, r, hover_id)
local(val, hover, pct, angle, nx, ny, _tw, _th, new_pct, new_val, dbl, minf, maxf, log_rng)
(
  minf = 20; maxf = 10000; log_rng = log(maxf/minf);
  val = slider(sl_idx);
  pct = val < minf ? 0 : 0.08 + 0.92 * log(max(minf, val)/minf) / log_rng;
  pct = clamp(pct, 0, 1);
  hover = (mouse_x-cx)*(mouse_x-cx)+(mouse_y-cy)*(mouse_y-cy) <= (r+7)*(r+7);
  hover ? ui_set_hover(hover_id);
  hover && mouse_click ? (
    dbl = (hover_id == last_dbl_id) && (time_precise() - last_dbl_time < 0.38);
    dbl ? (
      set_ui_slider(sl_idx, 0);
      val = 0; pct = 0; knob_active_sl = 0;
    ) : (
      knob_active_sl = sl_idx;
      knob_drag_y0   = mouse_y;
      knob_drag_v0   = pct;
    );
    last_dbl_id = hover_id;
    last_dbl_time = time_precise();
  );
  knob_active_sl==sl_idx && btn_down ? (
    new_pct = clamp(knob_drag_v0 + (knob_drag_y0-mouse_y)*fine_tune/130, 0, 1);
    new_val = new_pct < 0.04 ? 0 : minf * exp(((new_pct-0.08)/0.92) * log_rng);
    new_val = new_val < minf ? 0 : min(maxf, new_val);
    abs(new_val-val) > 0.2 ? (
      set_ui_slider(sl_idx, new_val);
      val = new_val;
      pct = val < minf ? 0 : 0.08 + 0.92 * log(max(minf, val)/minf) / log_rng;
      pct = clamp(pct, 0, 1);
    );
  );

  gfx_set(val >= minf ? 0.22 : 0.12, val >= minf ? 0.17 : 0.13, val >= minf ? 0.07 : 0.10, 1);
  gfx_circle(cx,cy,r,1,1);
  gfx_set(0.78,0.54,0.16,val >= minf ? 0.95 : 0.55); gfx_circle(cx,cy,r,0,1);
  angle = -2.356 + pct*4.712;
  nx = cx+(r-2)*sin(angle); ny = cy-(r-2)*cos(angle);
  gfx_set(1.00,0.76,0.26,val >= minf ? 1 : 0.55);
  gfx_line(cx,cy,nx,ny,1);

  gfx_setfont(1,"Arial",10,'b');
  val < minf ? strcpy(#_sh,"off") :
  val >= 1000 ? sprintf(#_sh,"%.1fk",val/1000) : sprintf(#_sh,"%.0f",val);
  val >= minf ? gfx_set(1.0,0.86,0.44,1) : gfx_set(0.58,0.50,0.34,0.90);
  gfx_measurestr(#_sh,_tw,_th);
  gfx_x=cx-_tw*0.5; gfx_y=cy-r-14; gfx_drawstr(#_sh);
  gfx_setfont(1,"Arial",10,'b'); gfx_set(0.70,0.58,0.32,0.95);
  gfx_measurestr("SC",_tw,_th);
  gfx_x=cx-_tw*0.5; gfx_y=cy+r+6; gfx_drawstr("SC");
);

function ui_dbg_btn(x, y, w, h, hover_id)
local(hover, state, _tw, _th)
(
  state = floor(debug_view_state+0.5);
  hover = hit(x,y,w,h);
  hover ? ui_set_hover(hover_id);
  !ui_render_only && hover && mouse_click ? ( debug_view_state = 1-state; state=1-state; );
  state ? gfx_set(0.58,0.34,0.08,1) : gfx_set(0.18,0.18,0.22,1);
  gfx_rect(x,y,w,h);
  gfx_set(0.88,0.88,0.88,1); gfx_setfont(1,"Arial",12);
  gfx_measurestr("DBG",_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+floor((h-_th)*0.5); gfx_drawstr("DBG");
);

// ═══════════════════════════════════════════════════════════════
// PANEL WIDGETS
// ═══════════════════════════════════════════════════════════════

// Knob with double-click reset (defv) and SHIFT precision
function ui_knob(sl_idx, cx, cy, r, minv, maxv, defv, label, hover_id)
local(val, hover, pct, angle, nx, ny, _tw, _th, new_val, rng, dbl, _vf, _lf,
      meter_on, meter_db, meter_pct, meter_ang, meter_r, tick_ang)
(
  val = slider(sl_idx);
  rng = maxv - minv;
  pct = max(0, min(1, (val-minv)/max(0.0001,rng)));
  hover = (mouse_x-cx)*(mouse_x-cx)+(mouse_y-cy)*(mouse_y-cy) <= (r+6)*(r+6);
  hover ? ui_set_hover(hover_id);
  hover && mouse_click ? (
    dbl = (hover_id == last_dbl_id) && (time_precise() - last_dbl_time < 0.38);
    dbl ? (
      set_ui_slider(sl_idx, defv);
      val = defv;
      pct = max(0,min(1,(val-minv)/max(0.0001,rng)));
      knob_active_sl = 0;
    ) : (
      knob_active_sl = sl_idx;
      knob_drag_y0   = mouse_y;
      knob_drag_v0   = val;
    );
    last_dbl_id   = hover_id;
    last_dbl_time = time_precise();
  );
  knob_active_sl==sl_idx && btn_down ? (
    new_val = max(minv, min(maxv, knob_drag_v0+(knob_drag_y0-mouse_y)*fine_tune*rng/160));
    abs(new_val-val) > 0.0002 ? (
      set_ui_slider(sl_idx, new_val);
      val = new_val;
      pct = max(0,min(1,(val-minv)/max(0.0001,rng)));
    );
  );
  // Live detector ring for threshold/ceiling controls.
  meter_on = sl_idx==7 || sl_idx==14 || sl_idx==26 || sl_idx==35;
  meter_on ? (
    meter_db = sl_idx==7 ? gain2db(max(gate_env,0.000000000001)) :
               sl_idx==14 ? gain2db(sqrt(max(c1175_env,0.000000000001))) :
               sl_idx==26 ? gain2db(sqrt(max(mt_env,0.000000000001))) :
                            gain2db(max(truepeak,0.000000000001));
    meter_pct = max(0,min(1,(meter_db-minv)/max(0.0001,rng)));
    meter_ang = 2.356 + meter_pct*4.712;
    meter_r = r+5;
    gfx_set(0.24,0.25,0.29,0.72);
    gfx_arc(cx,cy,meter_r,2.356,7.068,1); gfx_arc(cx,cy,meter_r+1,2.356,7.068,1);
    meter_db>=val ? gfx_set(mod_r*0.35+0.60,mod_g*0.30+0.62,mod_b*0.24+0.68,1) :
                    gfx_set(mod_r*0.42+0.18,mod_g*0.38+0.18,mod_b*0.38+0.20,0.72);
    gfx_arc(cx,cy,meter_r,2.356,meter_ang,1); gfx_arc(cx,cy,meter_r+1,2.356,meter_ang,1);
    tick_ang = 2.356 + pct*4.712;
    gfx_set(0.94,0.95,0.98,0.92);
    gfx_line(cx+cos(tick_ang)*(meter_r-2),cy+sin(tick_ang)*(meter_r-2),
             cx+cos(tick_ang)*(meter_r+2),cy+sin(tick_ang)*(meter_r+2),1);
  );
  // Body
  knob_active_sl==sl_idx ? gfx_set(mod_r*0.30,mod_g*0.22,mod_b*0.30,1) : gfx_set(mod_r*0.15,mod_g*0.12,mod_b*0.16,1);
  gfx_circle(cx,cy,r,1,1);
  gfx_set(mod_r,mod_g,mod_b,0.85); gfx_circle(cx,cy,r,0,1);
  // Indicator
  angle = -2.356 + pct*4.712;
  nx = cx+(r-2)*sin(angle); ny = cy-(r-2)*cos(angle);
  gfx_set(mod_r*0.5+0.38, mod_g*0.25+0.60, mod_b*0.15+0.72, 1);
  gfx_line(cx,cy,nx,ny,1);
  // Value above
  _vf = ui_knob_value_font > 0 ? ui_knob_value_font : 12;
  _lf = ui_knob_label_font > 0 ? ui_knob_label_font : 12;
  gfx_setfont(1,"Arial",_vf); gfx_set(0.92,0.92,0.94,1);
  abs(val)>=100 ? sprintf(#_vk,"%.0f",val) : abs(val)>=10 ? sprintf(#_vk,"%.1f",val) : sprintf(#_vk,"%.2f",val);
  gfx_measurestr(#_vk,_tw,_th);
  gfx_x=cx-_tw*0.5; gfx_y=cy-r-15; gfx_drawstr(#_vk);
  // Label below
  gfx_set(mod_r*0.50+0.32, mod_g*0.28+0.36, mod_b*0.28+0.38, 1);
  gfx_setfont(1,"Arial",_lf);
  gfx_measurestr(label,_tw,_th);
  gfx_x=cx-_tw*0.5; gfx_y=cy+r+4; gfx_drawstr(label);
);

function ui_knob_disabled(sl_idx, cx, cy, r, minv, maxv, label, hover_id)
local(val, hover, pct, angle, nx, ny, _tw, _th, rng)
(
  val = slider(sl_idx);
  rng = maxv - minv;
  pct = max(0, min(1, (val-minv)/max(0.0001,rng)));
  hover = (mouse_x-cx)*(mouse_x-cx)+(mouse_y-cy)*(mouse_y-cy) <= (r+6)*(r+6);
  hover ? ui_set_hover(hover_id);
  gfx_set(0.09,0.09,0.105,1);
  gfx_circle(cx,cy,r,1,1);
  gfx_set(0.28,0.30,0.34,0.62); gfx_circle(cx,cy,r,0,1);
  angle = -2.356 + pct*4.712;
  nx = cx+(r-2)*sin(angle); ny = cy-(r-2)*cos(angle);
  gfx_set(0.38,0.42,0.48,0.58); gfx_line(cx,cy,nx,ny,1);
  gfx_setfont(1,"Arial",12); gfx_set(0.46,0.48,0.52,0.82);
  abs(val)>=100 ? sprintf(#_vk,"%.0f",val) : abs(val)>=10 ? sprintf(#_vk,"%.1f",val) : sprintf(#_vk,"%.2f",val);
  gfx_measurestr(#_vk,_tw,_th);
  gfx_x=cx-_tw*0.5; gfx_y=cy-r-15; gfx_drawstr(#_vk);
  gfx_setfont(1,"Arial",12); gfx_set(0.38,0.42,0.48,0.80);
  gfx_measurestr(label,_tw,_th);
  gfx_x=cx-_tw*0.5; gfx_y=cy+r+4; gfx_drawstr(label);
);

function ui_internal_knob(val, id, cx, cy, r, minv, maxv, defv, label, hover_id)
local(hover, pct, angle, nx, ny, _tw, _th, new_val, rng, dbl)
(
  val = clamp(val <= 0 ? defv : val, minv, maxv);
  rng = maxv - minv;
  pct = max(0, min(1, (val-minv)/max(0.0001,rng)));
  hover = (mouse_x-cx)*(mouse_x-cx)+(mouse_y-cy)*(mouse_y-cy) <= (r+6)*(r+6);
  hover ? ui_set_hover(hover_id);
  !ui_render_only && hover && mouse_click ? (
    dbl = (hover_id == last_dbl_id) && (time_precise() - last_dbl_time < 0.38);
    dbl ? (
      val = defv;
      pct = max(0,min(1,(val-minv)/max(0.0001,rng)));
      knob_active_sl = 0;
      dsp_needs_update = 1;
    ) : (
      knob_active_sl = id;
      knob_drag_y0   = mouse_y;
      knob_drag_v0   = val;
    );
    last_dbl_id   = hover_id;
    last_dbl_time = time_precise();
  );
  !ui_render_only && knob_active_sl==id && btn_down ? (
    new_val = max(minv, min(maxv, knob_drag_v0+(knob_drag_y0-mouse_y)*fine_tune*rng/160));
    abs(new_val-val) > 0.0002 ? (
      val = new_val;
      pct = max(0,min(1,(val-minv)/max(0.0001,rng)));
      dsp_needs_update = 1;
    );
  );
  knob_active_sl==id ? gfx_set(mod_r*0.30,mod_g*0.22,mod_b*0.30,1) : gfx_set(mod_r*0.15,mod_g*0.12,mod_b*0.16,1);
  gfx_circle(cx,cy,r,1,1);
  gfx_set(mod_r,mod_g,mod_b,0.85); gfx_circle(cx,cy,r,0,1);
  angle = -2.356 + pct*4.712;
  nx = cx+(r-2)*sin(angle); ny = cy-(r-2)*cos(angle);
  gfx_set(mod_r*0.5+0.38, mod_g*0.25+0.60, mod_b*0.15+0.72, 1);
  gfx_line(cx,cy,nx,ny,1);
  gfx_setfont(1,"Arial",11); gfx_set(0.92,0.92,0.94,1);
  val>=10 ? sprintf(#_vk,"%.1f",val) : sprintf(#_vk,"%.2f",val);
  gfx_measurestr(#_vk,_tw,_th);
  gfx_x=cx-_tw*0.5; gfx_y=cy-r-15; gfx_drawstr(#_vk);
  gfx_set(mod_r*0.50+0.32, mod_g*0.28+0.36, mod_b*0.28+0.38, 1);
  gfx_setfont(1,"Arial",12);
  gfx_measurestr(label,_tw,_th);
  gfx_x=cx-_tw*0.5; gfx_y=cy+r+4; gfx_drawstr(label);
  val;
);

// Internal capture-time knob: not a host slider, so REAPER does not expose it in the JSFX header.
// which: 0 = Input Smart Capture, 1 = Output Smart Capture.
function ui_capture_time_knob(which, cx, cy, r, hover_id)
local(val, id, hover, pct, angle, nx, ny, _tw, _th, new_val, rng, dbl)
(
  rng = 70;
  id = which < 0.5 ? -6401 : -6402;
  val = which < 0.5 ? in_capture_seconds : out_capture_seconds;
  val = clamp(val <= 0 ? 30 : val, 20, 90);
  pct = max(0, min(1, (val-20)/rng));
  hover = (mouse_x-cx)*(mouse_x-cx)+(mouse_y-cy)*(mouse_y-cy) <= (r+6)*(r+6);
  hover ? ui_set_hover(hover_id);
  !ui_render_only && hover && mouse_click ? (
    dbl = (hover_id == last_dbl_id) && (time_precise() - last_dbl_time < 0.38);
    dbl ? (
      val = 30;
      which < 0.5 ? (in_capture_seconds = val) : (out_capture_seconds = val);
      pct = max(0,min(1,(val-20)/rng));
      knob_active_sl = 0;
      dsp_needs_update = 1;
    ) : (
      knob_active_sl = id;
      knob_drag_y0   = mouse_y;
      knob_drag_v0   = val;
    );
    last_dbl_id   = hover_id;
    last_dbl_time = time_precise();
  );
  knob_active_sl==id && btn_down ? (
    new_val = max(20, min(90, knob_drag_v0+(knob_drag_y0-mouse_y)*fine_tune*rng/160));
    abs(new_val-val) > 0.0002 ? (
      val = new_val;
      which < 0.5 ? (in_capture_seconds = val) : (out_capture_seconds = val);
      pct = max(0,min(1,(val-20)/rng));
      dsp_needs_update = 1;
    );
  );
  which < 0.5 ? (in_capture_seconds = val) : (out_capture_seconds = val);
  knob_active_sl==id ? gfx_set(mod_r*0.30,mod_g*0.22,mod_b*0.30,1) : gfx_set(mod_r*0.15,mod_g*0.12,mod_b*0.16,1);
  gfx_circle(cx,cy,r,1,1);
  gfx_set(mod_r,mod_g,mod_b,0.85); gfx_circle(cx,cy,r,0,1);
  angle = -2.356 + pct*4.712;
  nx = cx+(r-2)*sin(angle); ny = cy-(r-2)*cos(angle);
  gfx_set(mod_r*0.5+0.38, mod_g*0.25+0.60, mod_b*0.15+0.72, 1);
  gfx_line(cx,cy,nx,ny,1);
  gfx_setfont(1,"Arial",11); gfx_set(0.92,0.92,0.94,1);
  sprintf(#_vk,"%.0f",val);
  gfx_measurestr(#_vk,_tw,_th);
  gfx_x=cx-_tw*0.5; gfx_y=cy-r-13; gfx_drawstr(#_vk);
  gfx_set(mod_r*0.50+0.32, mod_g*0.28+0.36, mod_b*0.28+0.38, 1);
  gfx_measurestr("",_tw,_th);
  gfx_x=cx-_tw*0.5; gfx_y=cy+r+3; gfx_drawstr("");
);

function ui_knob_target(sl_idx, mode_val, cx, cy, r, minv, maxv, defv, label, hover_id)
local(val, hover, pct, angle, nx, ny, _tw, _th, rng, active)
(
  active = (floor(slider(40)+0.5) == mode_val) && (floor(out_enable+0.5) == 1);
  active ? (
    mod_r=0.20; mod_g=0.54; mod_b=0.92;
    ui_knob(sl_idx, cx, cy, r, minv, maxv, defv, label, hover_id);
  ) : (
    val = slider(sl_idx);
    rng = maxv - minv;
    pct = max(0, min(1, (val-minv)/max(0.0001,rng)));
    hover = (mouse_x-cx)*(mouse_x-cx)+(mouse_y-cy)*(mouse_y-cy) <= (r+6)*(r+6);
    hover ? ui_set_hover(hover_id);
    !ui_render_only && hover && mouse_click && floor(out_enable+0.5) ? set_ui_slider(40, mode_val);
    gfx_set(0.13,0.13,0.15,1); gfx_circle(cx,cy,r,1,1);
    gfx_set(0.34,0.34,0.38,0.72); gfx_circle(cx,cy,r,0,1);
    angle = -2.356 + pct*4.712;
    nx = cx+(r-2)*sin(angle); ny = cy-(r-2)*cos(angle);
    gfx_set(0.42,0.44,0.48,0.75); gfx_line(cx,cy,nx,ny,1);
    gfx_setfont(1,"Arial",11); gfx_set(0.50,0.50,0.54,0.90);
    abs(val)>=100 ? sprintf(#_vk,"%.0f",val) : abs(val)>=10 ? sprintf(#_vk,"%.1f",val) : sprintf(#_vk,"%.2f",val);
    gfx_measurestr(#_vk,_tw,_th); gfx_x=cx-_tw*0.5; gfx_y=cy-r-15; gfx_drawstr(#_vk);
    gfx_setfont(1,"Arial",12);
    gfx_set(0.46,0.48,0.52,0.82);
    gfx_measurestr(label,_tw,_th); gfx_x=cx-_tw*0.5; gfx_y=cy+r+4; gfx_drawstr(label);
  );
);

function ui_opt(sl_idx, this_val, label, x, y, w, h, hover_id)
local(hover, sel, _tw, _th)
(
  sel = floor(slider(sl_idx)+0.5)==this_val;
  hover = hit(x,y,w,h);
  hover ? ui_set_hover(hover_id);
  !ui_render_only && hover && mouse_click ? set_ui_slider(sl_idx, this_val);
  sel ? gfx_set(mod_r*0.55,mod_g*0.50,mod_b*0.55,1) : gfx_set(0.12,0.16,0.22,1);
  gfx_rect(x,y,w,h);
  gfx_set(0.88,0.92,0.96,1); gfx_setfont(1,"Arial",10);
  gfx_measurestr(label,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+floor((h-_th)*0.5); gfx_drawstr(label);
);

function draw_output_row_band(x, y, w, h, label, rr, gg, bb)
local(_tw, _th)
(
  gfx_set(0.055+rr*0.022, 0.052+gg*0.017, 0.050+bb*0.020, 0.72); gfx_rect(x,y,w,h);
  gfx_set(rr*0.55+0.28, gg*0.55+0.28, bb*0.55+0.28, 0.54); gfx_rect(x+48,y+h+2,w-50,1);
  gfx_set(rr,gg,bb,0.18); gfx_rect(x+48,y+4,1,h-8);
  gfx_setfont(1,"Arial",11,'b'); gfx_set(rr*0.70+0.28, gg*0.70+0.28, bb*0.70+0.28, 0.98);
  gfx_measurestr(label,_tw,_th);
  gfx_x=x+8; gfx_y=y+6; gfx_drawstr(label);
);

// Horizontal segmented signal meter — verde/giallo/rosso + peak hold LED
// pkh_slot: indice nel buffer pkh_base (aggiornato ogni frame in @gfx)
function draw_hsegs(bx, by, bw, bh, db, pkh_slot, label)
local(ns, gp, sw, i, seg_db, is_on, is_pk, sr, sg, sb, ph, _tw, _th)
(
  ns = 24; gp = 1; sw = max(1, floor((bw - (ns-1)*gp) / ns));
  // Peak hold update (decay each frame)
  ph = pkh_base[pkh_slot];
  db > ph ? ( ph = db; ) : ( ph -= PEAK_DECAY; ph = max(ph, -90); );
  pkh_base[pkh_slot] = ph;
  // Background
  gfx_set(0.05,0.05,0.07,1); gfx_rect(bx,by,bw,bh);
  // Segments
  i = 0;
  loop(ns,
    seg_db = -60.0 + (i / (ns - 1.0)) * 66.0;
    is_on = db >= seg_db;
    is_pk = (!is_on) && (ph >= seg_db) && (ph < seg_db + 66.0/(ns-1.0));
    seg_db > 0  ? (sr=0.92; sg=0.12; sb=0.12;) :
    seg_db > -9 ? (sr=0.90; sg=0.76; sb=0.10;) : (sr=0.14; sg=0.72; sb=0.28;);
    is_pk ? gfx_set(1.0, 1.0, 1.0, 0.92) :
    is_on ? gfx_set(sr, sg, sb, 0.90) :
            gfx_set(sr*0.10, sg*0.10, sb*0.10, 0.35);
    gfx_rect(bx + i*(sw+gp), by, sw, bh);
    i += 1;
  );
  // Label + value to the right
  gfx_setfont(1,"Arial",11);
  gfx_set(0.54,0.66,0.60,1);
  db > -60 ? sprintf(#_hs,"%s %.1f",label,db) : sprintf(#_hs,"%s --",label);
  gfx_x = bx+bw+6; gfx_y = by+floor((bh-11)*0.5); gfx_drawstr(#_hs);
);

// Horizontal segmented GR meter — colore del modulo, riempie da destra, peak hold
function draw_hsegs_gr(bx, by, bw, bh, gr, pkh_slot, label)
local(ns, gp, sw, i, seg_gr, gr_pct, is_on, is_pk, ph, _tw, _th)
(
  ns = 20; gp = 1; sw = max(1, floor((bw - (ns-1)*gp) / ns));
  ph = pkh_base[pkh_slot];
  gr > ph ? ( ph = gr; ) : ( ph -= PEAK_DECAY*0.5; ph = max(ph, 0); );
  pkh_base[pkh_slot] = ph;
  gfx_set(0.05,0.05,0.07,1); gfx_rect(bx,by,bw,bh);
  i = 0;
  loop(ns,
    seg_gr = (i / (ns - 1.0)) * 24.0;  // 0..24 dB GR range
    is_on = gr >= seg_gr;
    is_pk = (!is_on) && (ph >= seg_gr) && (ph < seg_gr + 24.0/(ns-1.0));
    is_pk ? gfx_set(1.0, 1.0, 1.0, 0.88) :
    is_on ? gfx_set(mod_r*0.50+0.12, mod_g*0.22+0.06, mod_b*0.52+0.30, 0.88) :
            gfx_set(mod_r*0.06, mod_g*0.04, mod_b*0.08, 0.30);
    // GR fills from right: segment i=0 is 0dB (left), i=ns-1 is 24dB (right)
    // Draw from right side
    gfx_rect(bx + (ns-1-i)*(sw+gp), by, sw, bh);
    i += 1;
  );
  gfx_setfont(1,"Arial",12); gfx_set(0.62,0.66,0.82,1);
  gr > 0.1 ? sprintf(#_hg,"%s -%.1f",label,gr) : sprintf(#_hg,"%s 0",label);
  gfx_x = bx+bw+6; gfx_y = by+floor((bh-11)*0.5); gfx_drawstr(#_hg);
);

function draw_hsegs_byp(bx, by, bw, bh, label)
local(ns, gp, sw, i)
(
  ns = 24; gp = 1; sw = max(1, floor((bw - (ns-1)*gp) / ns));
  gfx_set(0.045,0.047,0.052,1); gfx_rect(bx,by,bw,bh);
  i = 0;
  loop(ns,
    gfx_set(0.10,0.11,0.13,0.22);
    gfx_rect(bx + i*(sw+gp), by, sw, bh);
    i += 1;
  );
  gfx_setfont(1,"Arial",12); gfx_set(0.38,0.40,0.44,0.88);
  sprintf(#_hb,"%s BYP",label);
  gfx_x = bx+bw+6; gfx_y = by+floor((bh-11)*0.5); gfx_drawstr(#_hb);
);

function brn_scope_y(v, y, h) local(vv)
(
  vv = clamp(v, -22, 22);
  y + floor(h*0.52 - vv * (h*0.34 / 22));
);

function brn_user_y(v, y, h) local(vv)
(
  vv = clamp(v, -6, 6);
  y + floor(h*0.52 - vv * (h*0.42 / 6));
);

function brn_freq_to_x(freq, x, w) local(lmin, lmax, p)
(
  lmin = log(20); lmax = log(20000);
  p = (log(clamp(freq,20,20000)) - lmin) / max(0.0001, lmax-lmin);
  x + floor(clamp(p,0,1) * w);
);

function brn_x_to_freq(mx, x, w) local(lmin, lmax, p)
(
  lmin = log(20); lmax = log(20000);
  p = clamp((mx-x) / max(1,w), 0, 1);
  exp(lmin + p * (lmax-lmin));
);

function brn_freq_to_xmove(freq, base, scale) local(xm)
(
  xm = log(max(freq,1) / max(base,1)) / log(2) / max(0.0001, scale);
  clamp(xm, -8, 8);
);

function draw_brown_band_strip(x, y, w, h)
local(i, scope_x, scope_w, scope_y, scope_h, actual, target, corr, user, user_eff, user_amt, xmove,
      freq, base, scale, flo, fhi, sx, sy, tx, ty, ux, uy, px, py, ptx, pty,
      bar_y, dyn_y, fill, hover, active_pt, new_user, new_xmove, nf, _tw, _th, lx,
      label_y, value_y, cr, cg, cb, rstx, rsty, rstw, rsth, dbl)
(
  user_amt = brn_points_dyn >= 0.5 ? max(0, brn_amount <= 100 ? brn_amount * 0.01 : 1 + (brn_amount - 100) * 0.02) : 1;
  scope_x = x + 10;
  scope_w = w - 20;
  scope_y = y + 34;
  scope_h = h - 64;
  gfx_set(0.045,0.055,0.060,1); gfx_rect(x,y,w,h);
  gfx_set(0.10,0.34,0.31,0.78); gfx_rect(x,y,w,1); gfx_rect(x,y+h-1,w,1);
  gfx_setfont(1,"Arial",11,'b'); gfx_set(0.36,0.82,0.76,0.96);
  gfx_x=x+6; gfx_y=y+5; gfx_drawstr("BROWN SLOPE MAP");
  gfx_setfont(1,"Arial",8); gfx_set(0.36,0.52,0.50,0.80);
  gfx_x=x+w-122; gfx_y=y+6; gfx_drawstr("FREQ POINTS");
  rstw = 38; rsth = 16; rstx = x+w-rstw-6; rsty = y+3;
  hit(rstx,rsty,rstw,rsth) ? (ui_set_hover(8129); gfx_set(0.34,0.16,0.14,1)) : gfx_set(0.20,0.10,0.09,1);
  gfx_rect(rstx,rsty,rstw,rsth);
  gfx_setfont(1,"Arial",8,'b'); gfx_set(0.92,0.60,0.56,1);
  gfx_measurestr("RST",_tw,_th);
  gfx_x=rstx+floor((rstw-_tw)*0.5); gfx_y=rsty+floor((rsth-_th)*0.5); gfx_drawstr("RST");
  !ui_render_only && hit(rstx,rsty,rstw,rsth) && mouse_click ? reset_brown_slope_zero_gfx();
  gfx_set(0.060,0.078,0.078,1); gfx_rect(scope_x,scope_y,scope_w,scope_h);
  gfx_set(0.13,0.18,0.18,1); gfx_rect(scope_x+3,scope_y+floor(scope_h*0.52),scope_w-6,1);
  gfx_setfont(1,"Arial",8); gfx_set(0.24,0.34,0.34,0.72);
  gfx_x=scope_x+4; gfx_y=scope_y+scope_h+3; gfx_drawstr("20");
  gfx_measurestr("1k",_tw,_th); gfx_x=brn_freq_to_x(1000,scope_x,scope_w)-floor(_tw*0.5); gfx_y=scope_y+scope_h+3; gfx_drawstr("1k");
  gfx_measurestr("20k",_tw,_th); gfx_x=scope_x+scope_w-_tw-4; gfx_y=scope_y+scope_h+3; gfx_drawstr("20k");
  !btn_down ? brn_band_drag = 0;
  i = 0;
  loop(4,
    i == 0 ? (corr = brn_corr1; actual = brn_actual1; target = brn_t1; user = brn_user1; xmove = brn_xmove1; base=max(1,brn_fc1); scale=1.60; flo=20; fhi=20000; freq=clamp(base * (2 ^ (xmove*scale)),flo,fhi); strcpy(#_bl,"LOW"););
    i == 1 ? (corr = brn_corr2; actual = brn_actual2; target = brn_t2; user = brn_user2; xmove = brn_xmove2; base=max(1,brn_fc2); scale=1.35; flo=20; fhi=20000; freq=clamp(base * (2 ^ (xmove*scale)),flo,fhi); strcpy(#_bl,"L-M"););
    i == 2 ? (corr = brn_corr3; actual = brn_actual3; target = brn_t3; user = brn_user3; xmove = brn_xmove3; base=max(1,brn_fc3); scale=1.35; flo=20; fhi=20000; freq=clamp(base * (2 ^ (xmove*scale)),flo,fhi); strcpy(#_bl,"M-H"););
    i == 3 ? (corr = brn_corr4; actual = brn_actual4; target = brn_t4; user = brn_user4; xmove = brn_xmove4; base=max(1,brn_fc4); scale=1.60; flo=20; fhi=20000; freq=clamp(base * (2 ^ (xmove*scale)),flo,fhi); strcpy(#_bl,"HIGH"););
    user_eff = clamp(user * user_amt, -6, 6);

    sx = brn_freq_to_x(freq,scope_x,scope_w);
    sy = brn_scope_y(actual, scope_y, scope_h);
    tx = sx;
    ty = brn_scope_y(target, scope_y, scope_h);
    ux = sx;
    uy = brn_user_y(user_eff, scope_y, scope_h);
    hover = (mouse_x-ux)*(mouse_x-ux)+(mouse_y-uy)*(mouse_y-uy) <= 81;
    hover ? ui_set_hover(8120+i);
    !ui_render_only && hover && mouse_click ? (
      dbl = (8120+i == last_dbl_id) && (time_precise() - last_dbl_time < 0.38);
      brn_band_focus = i + 1;
      dbl ? (
        reset_brown_slope_point_gfx(i);
        user = 0;
        user_eff = 0;
        uy = brn_user_y(0, scope_y, scope_h);
        brn_band_drag = 0;
      ) : (
        brn_band_drag = i + 1;
        brn_band_drag_y0 = mouse_y;
        brn_band_drag_v0 = user;
        brn_band_drag_x0 = mouse_x;
        brn_band_drag_xv0 = xmove;
      );
      last_dbl_id = 8120+i;
      last_dbl_time = time_precise();
    );
    !ui_render_only && brn_band_drag == i + 1 && btn_down ? (
      new_user = clamp((scope_y + floor(scope_h*0.52) - mouse_y) * (6 / (scope_h*0.42)) / max(0.01, user_amt), -6, 6);
      i == 0 ? (brn_user1 = new_user;);
      i == 1 ? (brn_user2 = new_user;);
      i == 2 ? (brn_user3 = new_user;);
      i == 3 ? (brn_user4 = new_user;);
      user = new_user;
      user_eff = clamp(user * user_amt, -6, 6);
      nf = clamp(brn_x_to_freq(mouse_x,scope_x,scope_w), flo, fhi);
      new_xmove = brn_freq_to_xmove(nf, base, scale);
      i == 0 ? (brn_xmove1 = new_xmove;);
      i == 1 ? (brn_xmove2 = new_xmove;);
      i == 2 ? (brn_xmove3 = new_xmove;);
      i == 3 ? (brn_xmove4 = new_xmove;);
      xmove = new_xmove;
      freq = clamp(base * (2 ^ (xmove*scale)), flo, fhi);
      sx = brn_freq_to_x(freq,scope_x,scope_w);
      tx = sx;
      ux = sx;
      uy = brn_user_y(user_eff, scope_y, scope_h);
      dsp_needs_update = 1;
    );
    active_pt = hover || brn_band_drag == i + 1 || floor(brn_band_focus+0.5) == i + 1;
    i == 0 ? (cr=0.42; cg=0.96; cb=0.70;);
    i == 1 ? (cr=0.35; cg=0.78; cb=1.00;);
    i == 2 ? (cr=0.98; cg=0.78; cb=0.34;);
    i == 3 ? (cr=0.80; cg=0.62; cb=1.00;);

    i > 0 ? (
      gfx_set(0.18,0.62,0.58,0.55);
      gfx_line(ptx, pty, tx, ty, 0);
      gfx_set(0.86,0.96,0.92,0.92);
      gfx_line(px, py, sx, sy, 0);
    );
    gfx_set(cr*0.65, cg*0.72, cb*0.68, active_pt?1:0.62); gfx_circle(tx,ty,active_pt?5:4,1,1);
    gfx_set(0.86,0.96,0.92,0.95); gfx_circle(sx,sy,3,1,1);
    gfx_set(0.24,0.42,0.38,0.65); gfx_line(ux, brn_user_y(0, scope_y, scope_h), ux, uy, 1);
    active_pt ? gfx_set(cr,cg,cb,1) : gfx_set(0.78,0.90,0.84,0.62);
    gfx_circle(ux,uy,active_pt?5:4,1,1);
    gfx_set(0.02,0.03,0.03,0.85); gfx_circle(ux,uy,active_pt?5:4,0,1);

    bar_y = y + h - 17;
    fill = min(24, abs(corr) * 7);
    corr < -0.02 ? (
      gfx_set(0.92,0.30,0.18,0.90);
      gfx_rect(ux - fill, bar_y, fill, 5);
    ) : corr > 0.02 ? (
      gfx_set(0.20,0.82,0.66,0.90);
      gfx_rect(ux, bar_y, fill, 5);
    );
    abs(corr) > 0.04 ? (
      corr < 0 ? gfx_set(0.92,0.30,0.18,active_pt?1:0.76) : gfx_set(0.20,0.82,0.66,active_pt?1:0.76);
      gfx_setfont(1,"Arial",8,'b');
      sprintf(#_dyn,"DYN %+.1f",corr);
      gfx_measurestr(#_dyn,_tw,_th);
      dyn_y = y + h - 9;
      gfx_x=clamp(ux-floor(_tw*0.5),scope_x,scope_x+scope_w-_tw);
      gfx_y=dyn_y;
      gfx_drawstr(#_dyn);
    );

    label_y = (i == 1 || i == 3) ? y + 18 : y + 27;
    value_y = (i == 1 || i == 3) ? y + h - 42 : y + h - 30;
    gfx_setfont(1,"Arial",9,'b');
    active_pt ? gfx_set(cr,cg,cb,1) : gfx_set(0.50,0.62,0.60,0.72);
    gfx_measurestr(#_bl,_tw,_th); lx=clamp(ux-floor(_tw*0.5),scope_x,scope_x+scope_w-_tw);
    gfx_x=lx; gfx_y=label_y; gfx_drawstr(#_bl);
    gfx_setfont(1,"Arial",12,'b');
    user_eff >= 0 ? sprintf(#_bc,"%.0f  +%.1f",freq,user_eff) : sprintf(#_bc,"%.0f  %.1f",freq,user_eff);
    active_pt ? gfx_set(cr,cg,cb,1) : gfx_set(0.60,0.72,0.70,0.62);
    gfx_measurestr(#_bc,_tw,_th);
    gfx_x=clamp(ux-floor(_tw*0.5),scope_x,scope_x+scope_w-_tw); gfx_y=value_y; gfx_drawstr(#_bc);

    px = sx; py = sy; ptx = tx; pty = ty;
    i += 1;
  );
);

// Saturation indicator — small waveform box showing tape-sat effect
// sat_pct: 0..1 (from slider 39 / 100)
function draw_sat_indicator(bx, by, bw, bh, sat_pct)
local(i, t, val, clip_lv, warm, px1, py1, px2, py2, amp, steps)
(
  warm = sat_pct;
  // Background + border
  gfx_set(0.09,0.06,0.05,1); gfx_rect(bx,by,bw,bh);
  gfx_set(0.38+warm*0.52, 0.18+warm*0.08, 0.06, 0.65+warm*0.35);
  gfx_rect(bx,by,bw,1); gfx_rect(bx,by+bh-1,bw,1);
  gfx_rect(bx,by,1,bh); gfx_rect(bx+bw-1,by,1,bh);
  // "SAT" micro-label top-left
  gfx_setfont(1,"Arial",8);
  gfx_set(0.38+warm*0.50, 0.20+warm*0.05, 0.08, 0.70);
  gfx_x=bx+3; gfx_y=by+2; gfx_drawstr("SAT");
  // Clean sine reference (dim blue-grey)
  gfx_set(0.28,0.32,0.44,0.40);
  amp = (bh-12)*0.40; steps = bw - 4;
  i = 1; loop(steps - 1,
    t  = (i-1)/steps * $pi * 2.2;
    t2 = i    /steps * $pi * 2.2;
    px1=bx+2+i-1; py1=by+bh*0.52 - sin(t)*amp;
    px2=bx+2+i;   py2=by+bh*0.52 - sin(t2)*amp;
    gfx_line(px1,py1,px2,py2,0);
    i += 1;
  );
  // Saturated wave (warm amber, clipped top)
  clip_lv = amp * max(0.20, 1.0 - sat_pct * 0.62);
  gfx_set(0.38+warm*0.55, 0.24-warm*0.12, 0.06, 0.92);
  i = 1; loop(steps - 1,
    t  = (i-1)/steps * $pi * 2.2;
    t2 = i    /steps * $pi * 2.2;
    px1=bx+2+i-1; py1=by+bh*0.52 - clamp(sin(t) *(amp*(1+sat_pct*0.7)), -clip_lv, clip_lv);
    px2=bx+2+i;   py2=by+bh*0.52 - clamp(sin(t2)*(amp*(1+sat_pct*0.7)), -clip_lv, clip_lv);
    gfx_line(px1,py1,px2,py2,0);
    i += 1;
  );
  // Saturation % value
  gfx_setfont(1,"Arial",8);
  sat_pct > 0.01 ? sprintf(#_sv,"%.0f%%",sat_pct*100) : strcpy(#_sv,"off");
  gfx_set(0.70+warm*0.25, 0.40-warm*0.20, 0.12, 0.80);
  gfx_measurestr(#_sv,px1,py1);
  gfx_x=bx+bw-px1-3; gfx_y=by+bh-py1-3; gfx_drawstr(#_sv);
);

function draw_shell(x, y, w, h, title)
local(_tw, _th)
(
  gfx_set(mod_br,mod_bg,mod_bb,1); gfx_rect(x,y,w,h);
  gfx_set(mod_er,mod_eg,mod_eb,1);
  gfx_rect(x,y,w,1); gfx_rect(x,y+h-1,w,1); gfx_rect(x,y,1,h); gfx_rect(x+w-1,y,1,h);
  gfx_setfont(1,"Arial",12,'b');
  gfx_set(mod_r*0.44+0.46,mod_g*0.24+0.32,mod_b*0.34+0.32,1);
  gfx_x=x+10; gfx_y=y+6; gfx_drawstr(title);
);

// Vertical segmented meter (Harmonic_Space_Carver style), valore corrente letterale.
// nr/ng/nb = base color for normal segments (below -9 dB)
// Value display uses larger font with more vertical space
function draw_vseg(bx, by, bw, bh, db, label, nr, ng, nb, val_offset, meter_id)
local(num_segs, gap, seg_h, i, seg_val, is_on, sr, sg, sb, _tw, _th, voff, tnow, db_now, db_max, hold_sec, rel_coef)
(
  voff = val_offset ? val_offset : 18; // Default value offset for larger text
  num_segs=48; gap=1; seg_h=max(1,floor((bh-(num_segs-1)*gap)/num_segs)); i=0;

  db_now = db;
  db_max = -100;
  meter_id >= 0 ? (
    tnow = time_precise();
    hold_sec = meter_id == 4 ? 0.12 : 0.50;
    rel_coef = meter_id == 4 ? 0.28 : 0.12;
    live_meter_now[meter_id] < -900 ? live_meter_now[meter_id] = db;
    db > -60 ? (
      db > live_meter_max[meter_id] ? live_meter_max[meter_id] = db;
      live_meter_now[meter_id] <= -90 ? (
        live_meter_now[meter_id] = db;
        live_meter_hold_until[meter_id] = tnow + hold_sec;
      ) : db >= live_meter_now[meter_id] ? (
        live_meter_now[meter_id] += (db - live_meter_now[meter_id]) * 0.75;
        live_meter_hold_until[meter_id] = tnow + hold_sec;
      ) : tnow > live_meter_hold_until[meter_id] ? (
        live_meter_now[meter_id] += (db - live_meter_now[meter_id]) * rel_coef;
      );
    ) : (
      tnow > live_meter_hold_until[meter_id] ? live_meter_now[meter_id] += (-100 - live_meter_now[meter_id]) * rel_coef;
    );
    hit(bx, by, bw, bh) && mouse_click ? (
      live_meter_max[meter_id] = db;
      live_meter_now[meter_id] = db;
      live_meter_hold_until[meter_id] = tnow + hold_sec;
    );
    db_now = live_meter_now[meter_id];
    db_max = live_meter_max[meter_id];
  );
  
  loop(num_segs,
    seg_val = -60.0 + (i/(num_segs-1))*66.0;
    seg_val>0  ? (sr=0.92;sg=0.12;sb=0.12;) :
    seg_val>-9 ? (sr=0.90;sg=0.76;sb=0.10;) : (sr=nr; sg=ng; sb=nb;);
    
    // Segmento attivo (livello attuale)
    is_on = db_now >= seg_val;
    gfx_r=sr*(is_on?1.0:0.12); gfx_g=sg*(is_on?1.0:0.12); gfx_b=sb*(is_on?1.0:0.12); gfx_a=is_on?0.95:0.35;
    gfx_rect(bx, by+bh-(i+1)*(seg_h+gap)+gap, bw, seg_h);
    i+=1;
  );
  
  gfx_setfont(1,"Arial",9); gfx_set(0.52,0.62,0.58,1);
  gfx_measurestr(label,_tw,_th);
  gfx_x=bx+(bw-_tw)*0.5; gfx_y=by+bh+4; gfx_drawstr(label);
  // Larger value display above meter. TP shows max + readable now.
  meter_id == 4 ? (
    db_max>-60 ? sprintf(#_vm,"%.1f",db_max) : sprintf(#_vm,"--");
    gfx_setfont(1,"Arial",11,'b'); gfx_set(0.92,0.82,0.20,0.95);
    gfx_measurestr(#_vm,_tw,_th);
    gfx_x=bx+(bw-_tw)*0.5; gfx_y=by-voff-15; gfx_drawstr(#_vm);
    db_now>-60 ? sprintf(#_vv,"%.1f",db_now) : sprintf(#_vv,"--");
    gfx_setfont(1,"Arial",12,'b'); gfx_set(0.52,0.82,1.00,1);
    gfx_measurestr(#_vv,_tw,_th);
    gfx_x=bx+(bw-_tw)*0.5; gfx_y=by-voff-1; gfx_drawstr(#_vv);
  ) : (
    db_now>-60 ? sprintf(#_vv,"%.1f",db_now) : sprintf(#_vv,"--");
    gfx_setfont(1,"Arial",12,'b'); gfx_set(0.82,0.88,0.84,1);
    gfx_measurestr(#_vv,_tw,_th);
    gfx_x=bx+(bw-_tw)*0.5; gfx_y=by-voff; gfx_drawstr(#_vv);
  );
);

function draw_vseg_byp(bx, by, bw, bh, label)
local(num_segs, gap, seg_h, i, _tw, _th)
(
  num_segs=48; gap=1; seg_h=max(1,floor((bh-(num_segs-1)*gap)/num_segs)); i=0;
  loop(num_segs,
    gfx_set(0.10,0.11,0.13,0.18);
    gfx_rect(bx, by+bh-(i+1)*(seg_h+gap)+gap, bw, seg_h);
    i+=1;
  );
  gfx_setfont(1,"Arial",9); gfx_set(0.40,0.42,0.46,0.90);
  gfx_measurestr(label,_tw,_th);
  gfx_x=bx+(bw-_tw)*0.5; gfx_y=by+bh+4; gfx_drawstr(label);
  gfx_setfont(1,"Arial",11,'b'); gfx_set(0.40,0.42,0.46,0.90);
  gfx_measurestr("--",_tw,_th);
  gfx_x=bx+(bw-_tw)*0.5; gfx_y=by-22; gfx_drawstr("--");
);

// ═══════════════════════════════════════════════════════════════
// MODULE PANELS
// ═══════════════════════════════════════════════════════════════

PH=134; BROWN_H=196; MW=165; MXOFS=258; KR=17;
MBY0=33; MBY1=66; MBY2=99; MBH=11;

function mx(px,pw) ( px+pw-MXOFS; );

function draw_input_smart_box(x,y,w,h)
local(trim_db,trim_norm,mid,fill,_tw,_th,state,cap,btn_hover,txt_r,txt_g,txt_b,bx,by,bw,bh,cap_sec,kx,ky,kr,old_r,old_g,old_b,smart_engaged)
(
  gfx_set(0.075,0.085,0.10,1); gfx_rect(x,y,w,h);
  gfx_set(0.18,0.50,0.90,0.20); gfx_rect(x,y,w,1);
  gfx_set(0.18,0.50,0.90,0.12); gfx_rect(x,y+h-1,w,1);

  trim_db = ui_input_smart_trim_db;
  trim_norm = clamp(trim_db / max(0.1, in_smart_max), -1, 1);
  state = floor(ui_input_smart_state + 0.5);
  cap = floor(ui_input_smart_cap + 0.5);
  cap_sec = floor(clamp(in_capture_seconds, 20, 90) + 0.5);
  smart_engaged = (floor(in_smart_on+0.5) && (in_smart_capture_state == 1 || ui_input_smart_ready >= 0.5)) ? 1 : 0;

  gfx_setfont(1,"Arial",10,'b'); gfx_set(0.50,0.66,0.88,0.95);
  gfx_x=x+24; gfx_y=y+4; gfx_drawstr("SMART CAP");

  kx = x+12; ky = y+23; kr = 8;
  old_r=mod_r; old_g=mod_g; old_b=mod_b;
  mod_r=0.18; mod_g=0.56; mod_b=0.98;
  ui_capture_time_knob(0, kx, ky, kr, 9016);
  mod_r=old_r; mod_g=old_g; mod_b=old_b;

  gfx_setfont(1,"Arial",23,'b');
  trim_db >= 0 ? gfx_set(0.58,0.96,0.66,1) : gfx_set(1.0,0.58,0.50,1);
  sprintf(#_ism,"%+.1f",trim_db);
  gfx_measurestr(#_ism,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+14; gfx_drawstr(#_ism);

  mid = x + floor(w*0.5);
  gfx_set(0.12,0.14,0.17,1); gfx_rect(x+8, y+42, w-16, 11);
  gfx_set(0.34,0.38,0.44,1); gfx_rect(mid, y+40, 1, 15);
  fill = floor(abs(trim_norm) * (w*0.5 - 10));
  trim_db >= 0 ? gfx_set(0.20,0.72,0.34,0.90) : gfx_set(0.90,0.32,0.26,0.90);
  trim_db >= 0 ? gfx_rect(mid, y+45, fill, 6)
               : gfx_rect(mid-fill, y+45, fill, 6);

  state == 0 ? (strcpy(#_ist,"OFF"); txt_r=0.46; txt_g=0.50; txt_b=0.56;) :
  state == 1 ? (sprintf(#_ist,"CAP %.0f%%",ui_input_smart_progress); txt_r=0.92; txt_g=0.76; txt_b=0.28;) :
  state == 2 ? (strcpy(#_ist,"LOCK"); txt_r=0.34; txt_g=0.90; txt_b=0.48;) :
               (sprintf(#_ist,"READY %ds",cap_sec);  txt_r=0.50; txt_g=0.66; txt_b=0.88;);
  gfx_setfont(1,"Arial",12,'b'); gfx_set(txt_r,txt_g,txt_b,0.95);
  gfx_x=x+6; gfx_y=y+57; gfx_drawstr(#_ist);
  cap ? (
    gfx_set(0.86,0.28,0.22,0.95);
    gfx_x=x+72; gfx_y=y+57; gfx_drawstr("MAX");
  );

  bx = x+w-72; by = y+55; bw = 62; bh = 24;
  btn_hover = hit(bx, by, bw, bh);
  !ui_render_only && btn_hover ? ui_set_hover(3004);
  !ui_render_only && btn_hover && mouse_click ? reset_in_smart_capture();
  ui_input_smart_ready >= 0.5 ? (
    btn_hover ? gfx_set(0.16,0.86,0.34,0.98) : gfx_set(0.12,0.70,0.28,0.95)
  ) : (
    btn_hover ? gfx_set(0.22,0.44,0.70,0.92) : gfx_set(0.13,0.22,0.34,0.92)
  );
  gfx_rect(bx,by,bw,bh);
  gfx_setfont(1,"Arial",12,'b');
  ui_input_smart_ready >= 0.5 ? gfx_set(0.92,1.0,0.92,1) : gfx_set(0.76,0.86,0.98,1);
  ui_input_smart_ready >= 0.5 ? strcpy(#_capbtn,"NEW") : strcpy(#_capbtn,"CAP");
  gfx_measurestr(#_capbtn,_tw,_th);
  gfx_x=bx+floor((bw-_tw)*0.5); gfx_y=by+floor((bh-_th)*0.5); gfx_drawstr(#_capbtn);

  gfx_setfont(1,"Arial",10); gfx_set(0.48,0.56,0.62,0.90);
  sprintf(#_iin,"PK %.1f",ui_input_smart_in_db);
  gfx_x=x+6; gfx_y=y+h-13; gfx_drawstr(#_iin);
  sprintf(#_itg,"RMS %.1f",ui_input_smart_rms_db);
  gfx_measurestr(#_itg,_tw,_th); gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+h-13; gfx_drawstr(#_itg);
  smart_engaged ? sprintf(#_iot,"T %.1f",ui_input_smart_target_db) : sprintf(#_iot,"G %+.1f",in_trim);
  gfx_measurestr(#_iot,_tw,_th); gfx_x=x+w-_tw-6; gfx_y=y+h-13; gfx_drawstr(#_iot);
);

function draw_panel_input(px,py,pw)  local(ky,ks,ki,m,smart_engaged)
(
  mod_active = floor(slider(2)+0.5);
  set_mod_color(1);
  draw_shell(px,py,pw,PH,"1  Input Smart");
  m=mx(px,pw); ky=py+62; ks=56; ki=px+44;
  smart_engaged = (floor(in_smart_on+0.5) && (in_smart_capture_state == 1 || in_smart_capture_ready >= 0.5)) ? 1 : 0;
  smart_engaged ? (
    ui_knob(3, ki, ky,KR,-30, 0, -18,"TARGET",3001);
  ) : (
    ui_knob(50,ki, ky,KR,-18,18,   0,"GAININ",3001);
  );
  smart_engaged ? (
    ui_knob(4, ki+ks,   ky,KR, 0,  18,   6,"MAX",   3002);
  ) : (
    ui_knob_disabled(4, ki+ks, ky,KR, 0, 18, "MAX", 3002);
  );
  smart_engaged ? (
    ui_knob(5, ki+ks*2, ky,KR, 0.2,10, 2.0,"SPEED", 3003);
  ) : (
    ui_knob_disabled(5, ki+ks*2, ky,KR, 0.2,10, "SPEED", 3003);
  );
  draw_input_smart_box(px+214, py+8, 228, 96);
  mod_active ? (
    draw_hsegs(   m,py+MBY0,MW,MBH,ui_input_in_db, 0,"IN");
    draw_hsegs(   m,py+MBY1,MW,MBH,ui_input_out_db,1,"OUT");
  ) : (
    draw_hsegs_byp(m,py+MBY0,MW,MBH,"IN");
    draw_hsegs_byp(m,py+MBY1,MW,MBH,"OUT");
  );
  gfx_setfont(1,"Arial",10); gfx_set(0.52,0.72,0.58,1);
  smart_engaged ? sprintf(#,"TGT %.1f",ui_input_smart_target_db) : sprintf(#,"GAIN %+.1f",in_trim);
  gfx_x=m; gfx_y=py+MBY2+14; gfx_drawstr(#);
);

function draw_gate_curve_display(x,y,w,h)
local(i,steps,in_db,xdb,p,curve_db,gain_db,gx,gy,pgx,pgy,thr_x,hys_x,hys_db,hys_gain,hys_y,_tw,_th)
(
  gfx_set(0.050,0.055,0.065,1); gfx_rect(x,y,w,h);
  gfx_set(0.36,0.25,0.10,0.45); gfx_rect(x,y,w,1); gfx_rect(x,y+h-1,w,1);
  gfx_setfont(1,"Arial",8,'b'); gfx_set(0.80,0.58,0.24,0.88);
  gfx_x=x+4; gfx_y=y+3; gfx_drawstr("CURVE");
  gfx_set(0.18,0.18,0.21,0.85); gfx_rect(x+5,y+h-9,w-10,1);
  gfx_rect(x+5,y+13,1,h-22);

  thr_x = x + 5 + floor((gate_thresh + profile_gate + 80) / 65 * (w-10));
  thr_x = clamp(thr_x,x+5,x+w-5);
  gfx_set(0.45,0.38,0.22,0.55); gfx_rect(thr_x,y+13,1,h-22);

  // HYST marker: soglia di chiusura = THRS + HYST, a sinistra della soglia di apertura.
  hys_db = gate_thresh + profile_gate + gate_hyst;
  hys_x = x + 5 + floor((hys_db + 80) / 65 * (w-10));
  hys_x = clamp(hys_x,x+5,x+w-5);
  i = 0; loop(max(1,floor((h-22)/6)),
    gfx_set(0.24,0.62,0.88,0.55);
    gfx_rect(hys_x, y+13+i*6, 1, 3);
    i += 1;
  );
  xdb = gate_hyst;
  gate_curve > 0.1 ? (
    p = clamp((xdb + gate_curve*0.5) / gate_curve, 0, 1);
    p = p*p*(3 - 2*p);
    hys_gain = gate_range * (1 - p);
  ) : (
    hys_gain = xdb >= 0 ? 0 : gate_range;
  );
  hys_y = y + 13 + floor((0 - hys_gain) / max(1, abs(gate_range)) * (h-22));

  i = 0; steps = 38;
  loop(steps+1,
    in_db = -80 + (i/steps)*65;
    xdb = in_db - (gate_thresh + profile_gate);
    gate_curve > 0.1 ? (
      p = clamp((xdb + gate_curve*0.5) / gate_curve, 0, 1);
      p = p*p*(3 - 2*p);
      gain_db = gate_range * (1 - p);
    ) : (
      gain_db = xdb >= 0 ? 0 : gate_range;
    );
    gx = x + 5 + floor((i/steps)*(w-10));
    gy = y + 13 + floor((0 - gain_db) / max(1, abs(gate_range)) * (h-22));
    i > 0 ? (
      gfx_set(0.96,0.70,0.24,0.95);
      gfx_line(pgx,pgy,gx,gy,0);
    );
    pgx = gx; pgy = gy;
    i += 1;
  );

  gfx_set(0.30,0.74,1.00,0.95);
  gfx_circle(hys_x,hys_y,3,1,1);
  gfx_setfont(1,"Arial",8,'b');
  gfx_measurestr("H",_tw,_th);
  gfx_x=clamp(hys_x-_tw*0.5,x+2,x+w-_tw-2); gfx_y=clamp(hys_y-12,y+13,y+h-20); gfx_drawstr("H");

  gfx_setfont(1,"Arial",8); gfx_set(0.52,0.48,0.38,0.88);
  sprintf(#_gc,"%.0fdB",gate_curve);
  gfx_measurestr(#_gc,_tw,_th);
  gfx_x=x+w-_tw-3; gfx_y=y+h-10; gfx_drawstr(#_gc);
);

function draw_panel_gate(px,py,pw)  local(ky,ks,ki,m)
(
  mod_active = floor(slider(6)+0.5);
  set_mod_color(2);
  draw_shell(px,py,pw,PH,"2  Expander");
  m=mx(px,pw); ky=py+62; ks=46; ki=px+40;
  ui_knob(7, ki,      ky,KR,-70,-10,-46,"THRS",  4001);
  ui_knob(8, ki+ks,   ky,KR,-40, 0,  -8,"RANGE", 4002);
  ui_knob(9, ki+ks*2, ky,KR,-12, 0,  -3,"HYST",  4003);
  ui_knob(10,ki+ks*3, ky,KR,0.5,100,2.0,"ATTK",  4004);
  ui_knob(11,ki+ks*4, ky,KR, 20,2000,180,"REL",  4005);
  ui_knob(49,ki+ks*5, ky,KR, 0,48,24,"CURVE", 4007);
  ui_sc_hpf_knob(12,ki+ks*5+42, ky,10, 4006);
  draw_gate_curve_display(px+352, py+19, 88, 84);
  mod_active ? (
    draw_hsegs(   m,py+MBY0,MW,MBH,ui_gate_in_db, 2,"IN");
    draw_hsegs_gr(m,py+MBY1,MW,MBH,ui_gate_act_db,3,"GR");
    draw_hsegs(   m,py+MBY2,MW,MBH,ui_gate_out_db,4,"OUT");
  ) : (
    draw_hsegs_byp(m,py+MBY0,MW,MBH,"IN");
    draw_hsegs_byp(m,py+MBY1,MW,MBH,"GR");
    draw_hsegs_byp(m,py+MBY2,MW,MBH,"OUT");
  );
);

