  wetL = bL*mt_g;
  wetR = bR*mt_g;
  bL = wetL*mt_mix_w + bL*(1-mt_mix_w);
  bR = wetR*mt_mix_w + bR*(1-mt_mix_w);

  mt_fb_det = 0.5*(abs(bL)+abs(bR));
	);
	!mt_on ? mt_det_active_db = pk_la2_db;
	pk_mt_env = peak_meter_tick(max(abs(bL), abs(bR)), pk_mt_env);
	pk_mt_db = gain2db(pk_mt_env);
mt_sig = 0.5*(bL*bL + bR*bR);
