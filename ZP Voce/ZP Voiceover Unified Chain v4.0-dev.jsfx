ui_tab_button(52,1,HBTN_X+47+TNAV_W+4,   RY3,TNAV_W,20,"JSFX",0.18,0.45,0.90,102);
ui_render_only = 0;

); // end gfx_view_i==0

// ──────────────────── JSFX VIEW ─────────────────────────────
gfx_view_i == 1 ? (
  HDR_H = 36; HDR_Y = 8;
  gfx_set(0.10,0.10,0.12,1); gfx_rect(10,HDR_Y,gfx_w-20,HDR_H);
  ui_tab_button(52,0,gfx_w-154,14,66,20,"GUI", 0.18,0.45,0.90,101);
  ui_tab_button(52,1,gfx_w-82, 14,66,20,"JSFX",0.18,0.45,0.90,102);
  // BRN/OUT on/off toggles visible in JSFX view header
  ui_mod_on(57, gfx_w-292, 14, 62, 20, "BRN", 218, 0.18, 0.78, 0.68);
  ui_mod_on(56, gfx_w-224, 14, 62, 20, "OUT", 217, 0.20, 0.54, 0.92);
  apply_host_slider_visibility(1);
  VX=10; VY=HDR_Y+HDR_H+4; VW=gfx_w-20;
  PBH=24; PBY=max(VY+88, gfx_h - TIP_H - PBH - 6);
  VH=max(60, PBY - VY - 4);
  gfx_set(0.09,0.09,0.11,1); gfx_rect(VX,VY,VW,VH);
  gfx_setfont(1,"Arial",14,'b'); gfx_set(0.88,0.90,0.94,1);
  gfx_x=VX+16; gfx_y=VY+16; gfx_drawstr("JSFX HOST VIEW ACTIVE");
  gfx_setfont(1,"Arial",11); gfx_set(0.68,0.72,0.76,1);
  profile_nm=profile==1?"Natural":profile==2?"Broadcast":profile==3?"Dense":profile==4?"Warm":profile==5?"Match":profile==6?"Flat":"Manual";
  sprintf(#,"Profile: %s   LUFS-I %.1f   RMS %.1f",profile_nm,ui_global_lufs_i,ui_global_rms_db);
  gfx_x=VX+16; gfx_y=VY+44; gfx_drawstr(#);
  gfx_setfont(1,"Arial",10); gfx_set(0.50,0.58,0.64,1);
  gfx_x=VX+16; gfx_y=VY+66; gfx_drawstr("Usa i cursori host per modificare i parametri. Il pannello Output e' in fondo.");

  // Fixed JSFX module navigation bar: stable position regardless of host slider list height.
  gfx_set(0.07,0.08,0.10,1); gfx_rect(10,PBY-2,gfx_w-20,PBH+4);
  gfx_set(0.18,0.20,0.24,1); gfx_rect(10,PBY-2,gfx_w-20,1);
  PBW=46; PBG=3; PBX=16;
  ui_tab_button(47,0,PBX+(PBW+PBG)*0,PBY,PBW,18,"QCK", 0.18,0.45,0.90,301);
  ui_tab_button(47,1,PBX+(PBW+PBG)*1,PBY,PBW,18,"IN",  0.26,0.55,0.94,302);
  ui_tab_button(47,2,PBX+(PBW+PBG)*2,PBY,PBW,18,"EXP", 0.52,0.34,0.90,303);
  ui_tab_button(47,3,PBX+(PBW+PBG)*3,PBY,PBW,18,"1175",0.76,0.26,0.86,304);
  ui_tab_button(47,4,PBX+(PBW+PBG)*4,PBY,PBW,18,"LA2", 0.90,0.22,0.64,305);
  ui_tab_button(47,5,PBX+(PBW+PBG)*5,PBY,PBW,18,"MT",  0.92,0.24,0.28,306);
  ui_tab_button(47,6,PBX+(PBW+PBG)*6,PBY,PBW,18,"BRN", 0.18,0.78,0.68,307);
  ui_tab_button(47,7,PBX+(PBW+PBG)*7,PBY,PBW,18,"LIM", 0.88,0.16,0.22,308);
  ui_tab_button(47,8,PBX+(PBW+PBG)*8,PBY,PBW,18,"OUT", 0.20,0.54,0.92,309);

  // Output panel also in JSFX view (conditional on out_vis)
  out_vis ? draw_panel_output(PX, max(VY+90, PBY - OUT_H - 6), PW);
);

// ──────────────────── SCROLL ORIZZONTALE (sempre, quando attivo) ─────
max_scroll_x > 0 ? (
  HSBY = gfx_h - TIP_H - 5;
  HSBW = gfx_w - 8;
  tw = max(24, HSBW * gfx_w / max(PW + 20, gfx_w));
  tr = max(1, HSBW - tw);
  tx = 4 + floor(ui_scroll_x / max(0.001, max_scroll_x) * tr);
  gfx_set(0.14,0.14,0.16,1); gfx_rect(4, HSBY, HSBW, 4);
  gfx_set(0.34,0.60,0.90,0.9); gfx_rect(tx, HSBY, tw, 4);
);

// ──────────────────── TOOLTIP BAR (always) ──────────────────
draw_tip_bar();

ui_prev_mouse_down = btn_down;

// ZP Shared Bus status: compact footer badge, clear of header controls.
zp_bus_read();
zp_bus_profile==1?strcpy(#zp_bus_profile_text,"VOICEOVER"):zp_bus_profile==2?strcpy(#zp_bus_profile_text,"ADR"):zp_bus_profile==3?strcpy(#zp_bus_profile_text,"ELEARNING"):zp_bus_profile==4?strcpy(#zp_bus_profile_text,"PODCAST"):zp_bus_profile==5?strcpy(#zp_bus_profile_text,"SPOT"):strcpy(#zp_bus_profile_text,"RADIO");
zp_bus_master_conn==0 ? strcpy(#zp_bus_status_text,"MASTER MISSING") : zp_bus_probe_conn==0 ? strcpy(#zp_bus_status_text,"VOICE PROBE MISSING") : zp_bus_master_conn==2 && zp_bus_probe_conn==2 ? strcpy(#zp_bus_status_text,"BUS CONNECTED") : strcpy(#zp_bus_status_text,"BUS DATA OLD");
sprintf(#zp_bus_line, "%s | %s", #zp_bus_status_text, #zp_bus_profile_text);
zp_bus_box_w = min(190, gfx_w - 8); zp_bus_box_x = max(4, gfx_w - zp_bus_box_w - 4); zp_bus_box_y=max(4,gfx_h-20);
gfx_set(0.035,0.045,0.055,0.96); gfx_rect(zp_bus_box_x,zp_bus_box_y,zp_bus_box_w,18);
zp_bus_master_conn==2 && zp_bus_probe_conn==2 ? gfx_set(0.34,0.92,0.66,1) : zp_bus_master_conn>0 && zp_bus_probe_conn>0 ? gfx_set(1.0,0.72,0.20,1) : gfx_set(1.0,0.42,0.34,1);
gfx_setfont(1,"Arial",9,'b'); gfx_x=zp_bus_box_x+7; gfx_y=zp_bus_box_y+4; gfx_drawstr(#zp_bus_line);
