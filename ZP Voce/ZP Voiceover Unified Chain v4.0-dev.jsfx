    ui_input_smart_cap = in_smart_on && in_smart_capture_ready >= 0.5 && abs(in_smart_capture_trim_db) >= max(0.05, in_smart_max - 0.05) ? 1 : 0;
    ui_input_smart_progress = in_smart_capture_progress; ui_input_smart_ready = in_smart_capture_ready;
    ui_gate_in_db = -100; ui_gate_out_db = -100; ui_gate_act_db = 0;
    ui_1175_in_db = -100; ui_1175_out_db = -100; ui_1175_act_db = 0;
    ui_la2_in_db = -100; ui_la2_out_db = -100; ui_la2_act_db = 0;
    ui_mt_in_db = -100; ui_mt_out_db = -100; ui_mt_act_db = 0;
    ui_brown_in_db = -100; ui_brown_out_db = -100; ui_brown_act_db = 0;
    ui_lim_in_db = -100; ui_lim_out_db = -100; ui_lim_act_db = 0;
    ui_out_in_db = -100; ui_out_out_db = -100; ui_out_act_db = 0;
    ui_out_trim_db = 0; ui_out_pre_auto_dbfs = -100; ui_out_peak_dbfs = -100; ui_out_peak_bar_dbfs = -100; ui_out_peak_max_dbfs = -100;
    ui_global_lufs_m = -100; ui_global_lufs_s = -100; ui_global_lufs_i = -100; ui_global_rms_db = -100;
    // Solo display: non resettare stati DSP da @gfx mentre il monitoring live passa audio.
  );
  ui_input_smart_trim_db = (in_smart_on && in_smart_capture_ready >= 0.5) ? in_smart_capture_trim_db : 0;
  ui_input_smart_rms_db = in_smart_capture_ready >= 0.5 ? in_smart_capture_rms_db : -100;
  ui_input_smart_target_db = in_smart_target;
  ui_input_smart_state = !in_smart_on ? 0 : (in_smart_capture_ready >= 0.5 ? 2 : (in_smart_capture_state == 1 ? 1 : 3));
  ui_input_smart_cap = in_smart_on && in_smart_capture_ready >= 0.5 && abs(in_smart_capture_trim_db) >= max(0.05, in_smart_max - 0.05) ? 1 : 0;
  ui_input_smart_progress = in_smart_capture_progress;
  ui_input_smart_ready = in_smart_capture_ready;
);
