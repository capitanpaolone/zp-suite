      brn_actual2 = brn_actual2 * brn_gc + brn_r2 * (1 - brn_gc);
      brn_gc = brn_r3 > brn_actual3 ? brn_graph_attack_coef : brn_graph_release_coef;
      brn_actual3 = brn_actual3 * brn_gc + brn_r3 * (1 - brn_gc);
      brn_gc = brn_r4 > brn_actual4 ? brn_graph_attack_coef : brn_graph_release_coef;
      brn_actual4 = brn_actual4 * brn_gc + brn_r4 * (1 - brn_gc);
