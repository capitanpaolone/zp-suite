);

// ═══════════════════════════════════════════════════════════════
// MAIN BODY
// ═══════════════════════════════════════════════════════════════

// Force fixed window size — unconditional every frame
gfx_setimgdim(-1, 792, 1300);

// One-time init
gfx_init_done ? 0 : (
  gfx_init_done   = 1;
  avg_lufs_disp   = -999; avg_rms_disp = -999; avg_out_disp = -999; avg_peak_disp = -999;
  disp_lufs_m = -999; disp_lufs_s = -999; disp_lra = -999;
  avg_hold_frames = 0;
  ui_prev_play_state = 0;
  ui_scroll_y    = 0;
  ui_scroll_x    = 0;
  last_mouse_wheel  = 0;
  last_mouse_hwheel = 0;
  // Peak hold per RMS e TP nella sezione Measure
  measure_rms_peak = -100;
  measure_pk_peak = -100;
  // Smoothing/hold per valori RMS/TP visualizzati (più leggibili)
  measure_rms_smooth = -100;
  measure_pk_smooth = -100;
  measure_pk_hold_frames = 0;
  measure_smooth_coef = 0.025; // RMS più stabile; TP usa hold tipo TR5.
  memset(live_meter_now, -100, 8);
  memset(live_meter_max, -100, 8);
  memset(live_meter_hold_until, 0, 8);
  // True Peak previous samples
  outL_prev = 0;
  outR_prev = 0;
);

// Display values: update while transport is running or live monitoring carries signal.
meter_display_active = (play_state > 0) || (ui_out_peak_dbfs > -80) || (ui_global_rms_db > -80) || (ui_global_lufs_m > -80);
meter_display_active ? (
  ui_prev_play_state == 0 ? (
    avg_lufs_disp = -999; avg_rms_disp = -999; avg_out_disp = -999; avg_peak_disp = -999;
    disp_lufs_m = -999; disp_lufs_s = -999; disp_lra = -999;
    avg_hold_frames = 4;
    lra_needs_reset = 1;
    // Reset hold e smoothing a nuovo passaggio attivo.
    measure_rms_peak = -100;
    measure_pk_peak = -100;
    measure_rms_smooth = -100;
    measure_pk_smooth = -100;
    measure_pk_hold_frames = 0;
    memset(live_meter_now, -100, 8);
    memset(live_meter_max, -100, 8);
    memset(live_meter_hold_until, 0, 8);
  );
  avg_hold_frames > 0 ? avg_hold_frames -= 1 : (
    avg_lufs_disp = ui_global_lufs_i;
    // RMS stabilizzato per lettura; TP con peak-hold leggibile stile TR5.
    measure_rms_smooth <= -90 ? measure_rms_smooth = ui_global_rms_db
                              : measure_rms_smooth = measure_rms_smooth + measure_smooth_coef * (ui_global_rms_db - measure_rms_smooth);
    ui_out_peak_dbfs > measure_pk_smooth || measure_pk_smooth <= -90 ? (
      measure_pk_smooth = ui_out_peak_dbfs;
      measure_pk_hold_frames = 75;
    ) : measure_pk_hold_frames > 0 ? (
      measure_pk_hold_frames -= 1;
    ) : (
      measure_pk_smooth = max(ui_out_peak_dbfs, measure_pk_smooth - 0.18);
    );
    avg_rms_disp  = measure_rms_smooth;
    avg_out_disp  = ui_out_out_db;
    avg_peak_disp = measure_pk_smooth;
    disp_lufs_m   = ui_global_lufs_m;
    disp_lufs_s   = ui_global_lufs_s;
    disp_lra      = ui_lra;
    // Max reale da inizio Play: resta congelato allo stop per confronto con meter esterni.
    ui_global_rms_db > measure_rms_peak ? measure_rms_peak = ui_global_rms_db;
    ui_out_peak_max_dbfs > measure_pk_peak ? measure_pk_peak = ui_out_peak_max_dbfs;
  );
) : (
  ui_prev_play_state > 0 ? (
    _i = 0; loop(20, pkh_base[_i] = -90; _i += 1;);
    ui_input_in_db = -100; ui_input_out_db = -100; ui_input_act_db = 0;
    ui_input_smart_trim_db = (in_smart_on && in_smart_capture_ready >= 0.5) ? in_smart_capture_trim_db : 0;
    ui_input_smart_in_db = -100; ui_input_smart_out_db = -100;
