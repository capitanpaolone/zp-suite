  brn_amu_out_env = brn_amu_post_p + brn_amu_env_c*(brn_amu_out_env - brn_amu_post_p);
  brn_amu_in_db = gain2db(sqrt(max(brn_amu_in_env, brn_eps)));
  brn_amu_out_db = gain2db(sqrt(max(brn_amu_out_env, brn_eps)));
  brn_amu_target_db = 0;
  brn_amu_on >= 0.5 && brn_amu_in_db > brn_amu_floor_db && brn_amu_out_db > -80 ? (
    brn_amu_target_db = clamp(brn_amu_in_db - brn_amu_out_db, 0, brn_amu_max_db);
  );
  brn_amu_gain_db = brn_amu_target_db + (brn_amu_target_db < brn_amu_gain_db ? brn_amu_fall_c : brn_amu_rise_c) * (brn_amu_gain_db - brn_amu_target_db);
  brn_amu_g = db2gain(brn_amu_gain_db);
  bL *= brn_amu_g;
  bR *= brn_amu_g;
) : (
  brn_g1 = brn_g2 = brn_g3 = brn_g4 = 1;
  brn_tg1 = brn_tg2 = brn_tg3 = brn_tg4 = 1;
  brn_gd1 = brn_gd2 = brn_gd3 = brn_gd4 = 0;
  brn_amu_gain_db = 0;
  brn_amu_target_db = 0;
);

brn_sig = 0.5*(bL*bL + bR*bR);
dbg_brown_env = brn_sig + dbg_meter_c*(dbg_brown_env - brn_sig);
dbg_brown_db = gain2db(sqrt(max(dbg_brown_env,0.000000000001)));
pk_brown_env = peak_meter_tick(max(abs(bL), abs(bR)), pk_brown_env);
pk_brown_db = gain2db(pk_brown_env);

// v4.1 BUS beta: post-Brown tone trim for voice bus, before density/limiting.
// Static points add broad taste; the air guard only pulls excess upper energy.
bus_beta_on ? (
  bL = bus_pk1L.biquad_tick(bL); bR = bus_pk1R.biquad_tick(bR);
  bL = bus_pk2L.biquad_tick(bL); bR = bus_pk2R.biquad_tick(bR);
  bL = bus_pk3L.biquad_tick(bL); bR = bus_pk3R.biquad_tick(bR);
  bL = bus_pk4L.biquad_tick(bL); bR = bus_pk4R.biquad_tick(bR);

  bus_tone_air_lpL += (1 - bus_tone_air_c) * (bL - bus_tone_air_lpL);
  bus_tone_air_lpR += (1 - bus_tone_air_c) * (bR - bus_tone_air_lpR);
  bus_airL = bL - bus_tone_air_lpL;
  bus_airR = bR - bus_tone_air_lpR;
  bus_lowL = bus_tone_air_lpL;
  bus_lowR = bus_tone_air_lpR;
  bus_air_p = 0.5*(bus_airL*bus_airL + bus_airR*bus_airR);
  bus_full_p = 0.5*(bL*bL + bR*bR);
  bus_tone_air_env = bus_air_p + bus_tone_air_env_c*(bus_tone_air_env - bus_air_p);
  bus_tone_full_env = bus_full_p + bus_tone_full_env_c*(bus_tone_full_env - bus_full_p);
  bus_air_rel_db = gain2db(sqrt(max(bus_tone_air_env, 0.000000000001))) - gain2db(sqrt(max(bus_tone_full_env, 0.000000000001)));
  bus_air_cut_db = clamp(-(bus_air_rel_db - bus_tone_air_target_db) * 0.35, -bus_tone_air_cut_max_db, 0);
  bus_air_tg = db2gain(bus_air_cut_db);
  bus_tone_air_gain = bus_air_tg + bus_tone_air_gain_c*(bus_tone_air_gain - bus_air_tg);
  bL = bus_lowL + bus_airL * bus_tone_air_gain;
  bR = bus_lowR + bus_airR * bus_tone_air_gain;
);

// Dense promo soft-peak stage before limiter.
dense_mode && lim_on ? (
  absbL = abs(bL);
  absbR = abs(bR);
  absbL > dense_soft_thr_g ? (
    sgL = bL < 0 ? -1 : 1;
    xL = (absbL/dense_soft_thr_g)*dense_soft_drive;
    yL = tanh_fast(xL)/dense_soft_drive;
    softL = sgL * dense_soft_thr_g * yL;
    bL = bL*(1-dense_soft_mix) + softL*dense_soft_mix;
  );
  absbR > dense_soft_thr_g ? (
    sgR = bR < 0 ? -1 : 1;
    xR = (absbR/dense_soft_thr_g)*dense_soft_drive;
    yR = tanh_fast(xR)/dense_soft_drive;
    softR = sgR * dense_soft_thr_g * yR;
    bR = bR*(1-dense_soft_mix) + softR*dense_soft_mix;
  );
);

// 7) Zero-latency voice limiter/clipper. This is a tone and density stage,
// not a mastering limiter; final delivery protection lives in OUT.
cL = bL;
cR = bR;
lim_on ? (
  cL *= lim_pre_g;
  cR *= lim_pre_g;

  truepeak_full = max(abs(cL), abs(cR));
  bus_beta_on ? (
    lim_bus_det_lp1L += (1 - lim_bus_det_hpf_c) * (cL - lim_bus_det_lp1L);
    lim_bus_det_lp1R += (1 - lim_bus_det_hpf_c) * (cR - lim_bus_det_lp1R);
    lim_detL = cL - lim_bus_det_lp1L;
    lim_detR = cR - lim_bus_det_lp1R;
    lim_bus_det_lp2L += (1 - lim_bus_det_hpf_c) * (lim_detL - lim_bus_det_lp2L);
    lim_bus_det_lp2R += (1 - lim_bus_det_hpf_c) * (lim_detR - lim_bus_det_lp2R);
    lim_detL -= lim_bus_det_lp2L;
    lim_detR -= lim_bus_det_lp2R;
    truepeak = max(max(abs(lim_detL), abs(lim_detR)), truepeak_full * lim_bus_det_floor_w);
  ) : (
    truepeak = truepeak_full;
  );
  lim_target_gain = truepeak > lim_ceiling_g ? lim_ceiling_g / max(truepeak, 0.000000000001) : 1;
  bus_beta_on ? lim_target_gain = max(lim_target_gain, lim_bus_min_gain);

  // Soft controls how gently the limiter grabs. The final guard below catches samples.
  lim_target_gain < lim_gain_smooth ? (
    lim_attack_c > 0 ? (
      lim_gain_smooth = lim_target_gain + lim_attack_c * (lim_gain_smooth - lim_target_gain);
    ) : (
      lim_gain_smooth = lim_target_gain;
    );
  ) : (
    bus_beta_on ? (
      lim_gr_now_db = max(0, -gain2db(max(lim_gain_smooth, 0.000000000001)));
      lim_bus_rel_ms = clamp(lim_rel * (0.55 + lim_gr_now_db/12), 20, lim_rel * 1.8);
      lim_bus_release_c = exp(-1/(max(1, lim_bus_rel_ms*0.001*srate)));
      lim_gain_smooth = min(1, 1 + (lim_gain_smooth - 1) * lim_bus_release_c);
    ) : (
      lim_gain_smooth = min(1, 1 + (lim_gain_smooth - 1) * lim_release_c);
    );
  );

  cL *= lim_gain_smooth;
  cR *= lim_gain_smooth;

  // Optional gentle saturation after gain control, then a final sample guard.
  lim_sat_w > 0 ? (
    sat_drive = 1 + lim_sat_w * 3.0;
    satL = tanh_fast((cL / max(lim_ceiling_g, 0.000000000001)) * sat_drive) * lim_ceiling_g / sat_drive;
    satR = tanh_fast((cR / max(lim_ceiling_g, 0.000000000001)) * sat_drive) * lim_ceiling_g / sat_drive;
    cL = cL * (1 - lim_sat_w) + satL * lim_sat_w;
    cR = cR * (1 - lim_sat_w) + satR * lim_sat_w;
  );

  pk_post_lim = max(abs(cL), abs(cR));
  pk_post_lim > lim_ceiling_g ? (
    guard_g = lim_ceiling_g / max(pk_post_lim, 0.000000000001);
    cL *= guard_g;
    cR *= guard_g;
    lim_gain_smooth *= guard_g;
  );

  lim_gain = lim_gain_smooth;
) : (
  lim_gain = 1;
  lim_gain_smooth = 1;
);
pk_lim_env = peak_meter_tick(max(abs(cL), abs(cR)), pk_lim_env);
pk_lim_db = gain2db(pk_lim_env);
lim_sig = 0.5*(cL*cL + cR*cR);
dbg_lim_env = lim_sig + dbg_meter_c*(dbg_lim_env - lim_sig);
dbg_lim_db = gain2db(sqrt(max(dbg_lim_env,0.000000000001)));

// Output target control (post chain). OUT off is a true bypass of this module.
out_enabled = floor(out_enable+0.5);
outL = cL;
outR = cR;

// Output stage:
// Off = true module bypass.
// out_mode selects the target. out_auto_apply decides whether correction is applied.
// MAN: Gain In -> metering/target delta only -> Gain Out.
// AUTO: Gain In -> Auto/Capture correction -> Gain Out.
out_enabled ? (
  auto_mode_eff = clamp(floor(out_mode + 0.5), 0, 3);
  auto_apply_eff = floor(out_auto_apply + 0.5);
  outL *= out_in_g;
  outR *= out_in_g;
  out_pre_auto_pk = max(abs(outL), abs(outR));
  out_pre_auto_dbfs = gain2db(max(out_pre_auto_pk, 0.000000000001));
  out_smart_capture_sig = 0.5*(outL*outL + outR*outR);
  auto_mode_eff > 0 ? (
  out_smart_capture_state == 1 ? (
    meter_play_state && out_smart_capture_sig > 0.000000000001 ? (
      out_smart_capture_sum += out_smart_capture_sig;
      out_smart_capture_count += 1;
      out_smart_capture_progress = min(100, 100 * out_smart_capture_count / max(1, out_smart_capture_target_spl));
      out_smart_capture_count >= out_smart_capture_target_spl ? commit_out_smart_capture();
    ) : (out_smart_capture_progress = min(99.9, 100 * out_smart_capture_count / max(1, out_smart_capture_target_spl)););
  );
  out_smart_capture_ready >= 0.5 ? (
    out_smart_capture_state = 2;
    refresh_out_smart_capture_trim();
    out_smart_capture_smooth_trim = out_smart_capture_trim_db + out_smart_capture_c*(out_smart_capture_smooth_trim - out_smart_capture_trim_db);
  );
  // AUTO dB is always a live target delta. Capture remains memory/display only.
  err = 0;
  mono_comp = mono_lufs_comp();
  meter_prime_pending ? (err = 0;) : (
    auto_mode_eff == 1 ? (
      auto_lufs_ref = cur_lufs_i > -80 ? cur_lufs_i + mono_comp : cur_lufs_s + mono_comp;
      err = auto_lufs_ref > -80 ? out_target_lufs - auto_lufs_ref : 0;
    ) : auto_mode_eff == 2 ? (
      err = rms_db > -80 ? out_target_rms - rms_db : 0;
    ) : auto_mode_eff == 3 ? (
      auto_lufs_ref = cur_lufs_i > -80 ? cur_lufs_i + mono_comp : cur_lufs_s + mono_comp;
      auto_lufs_err = auto_lufs_ref > -80 ? out_lr_lufs_target() - auto_lufs_ref : 0;
      auto_rms_err = rms_db > -80 ? out_lr_rms_target() - rms_db : 0;
      err = (auto_lufs_err + auto_rms_err) * 0.5;
    );
  );
  tgt_trim = clamp(err, -out_trim_cap, out_trim_cap);
  meter_just_primed && auto_mode_eff > 0 ? (out_trim_db = tgt_trim; meter_just_primed = 0;) : (out_trim_db = tgt_trim + out_trim_c*(out_trim_db - tgt_trim););
  out_auto_g = db2gain(out_trim_db);
  auto_apply_eff > 0 ? (outL *= out_auto_g; outR *= out_auto_g;);
  ) : (
    out_trim_db = 0;
    out_auto_g = 1;
  );
) : (
  out_pre_auto_pk = max(abs(outL), abs(outR));
  out_pre_auto_dbfs = gain2db(max(out_pre_auto_pk, 0.000000000001));
  out_trim_db = 0;
  out_auto_g = 1;
);

// Output manual gain is the final make-up of the Output module: it does not
// steer compressors, Capture or Auto Trim, and it is bypassed with OUT off.
out_enabled ? (
  outL *= out_man_g;
  outR *= out_man_g;
);

// Final Output Safety Limiter — LAST AUDIO STAGE.
// This is intentionally after Output Smart Capture / Auto Trim, so any makeup or preset lift
// cannot clip the rendered file. It is independent from the voice limiter/clipper: OUT on =
// delivery protection on. Instant attack, musical release; final hard guard for numerical safety.
// FIX: il final limiter deve lavorare SOLO se out_enabled E out_final_lim_on sono entrambi true
out_enabled && out_final_lim_on ? (
  pk = max(abs(outL), abs(outR));
  pk > out_final_ceil_g ? (
    out_final_lim_gain = min(out_final_lim_gain, out_final_ceil_g / max(pk, 0.000000000001));
  ) : (
    out_final_lim_gain = min(1, 1 + (out_final_lim_gain - 1) * out_final_rel_c);
  );
  outL *= out_final_lim_gain;
  outR *= out_final_lim_gain;

  // absolute last-sample guard, similar to a post-delivery ceiling
  pk = max(abs(outL), abs(outR));
  pk > out_final_ceil_g ? (
    sc = out_final_ceil_g / max(pk, 0.000000000001);
    outL *= sc;
    outR *= sc;
    out_final_lim_gain *= sc;
  );
  out_final_gr_db = gain2db(max(out_final_lim_gain, 0.000000000001));
) : (
  out_final_lim_gain = 1;
  out_final_gr_db = 0;
);

play_declick_remaining > 0 ? (
  play_declick_g = 1 - play_declick_remaining/play_declick_total;
  play_declick_g = play_declick_g*play_declick_g*(3 - 2*play_declick_g);
  outL *= play_declick_g;
  outR *= play_declick_g;
  play_declick_remaining -= 1;
);

spl0 = outL;
spl1 = outR;

// True Peak calculation with 4x oversampling (linear interpolation)
// Interpolate 3 points between previous and current samples
tp1L = 0.75*outL_prev + 0.25*outL;
tp2L = 0.5*outL_prev + 0.5*outL;
tp3L = 0.25*outL_prev + 0.75*outL;
tp1R = 0.75*outR_prev + 0.25*outR;
tp2R = 0.5*outR_prev + 0.5*outR;
tp3R = 0.25*outR_prev + 0.75*outR;

// Find max absolute value across all 4 interpolated samples
tp_max = max(
  max(max(abs(outL), abs(outR)),
  max(abs(tp1L), abs(tp1R))),
  max(max(abs(tp2L), abs(tp2R)),
  max(abs(tp3L), abs(tp3R)))
);

out_peak_dbfs = gain2db(max(tp_max, 0.000000000001));
meter_play_state ? (
  out_peak_dbfs > out_peak_max_dbfs ? out_peak_max_dbfs = out_peak_dbfs;
  out_peak_dbfs > out_peak_bar_dbfs || out_peak_bar_dbfs <= -90 ? (
    out_peak_bar_dbfs = out_peak_dbfs;
    out_peak_bar_hold_spl = floor(0.08 * srate);
  ) : out_peak_bar_hold_spl > 0 ? (
    out_peak_bar_hold_spl -= 1;
  ) : (
    out_peak_bar_dbfs = max(out_peak_dbfs, out_peak_bar_dbfs - 36 / max(1, srate));
  );
  out_peak_dbfs > out_peak_hold_dbfs || out_peak_hold_dbfs <= -90 ? (
    out_peak_hold_dbfs = out_peak_dbfs;
    out_peak_hold_spl = floor(0.55 * srate);
  ) : out_peak_hold_spl > 0 ? (
    out_peak_hold_spl -= 1;
  ) : (
    out_peak_hold_dbfs = max(out_peak_dbfs, out_peak_hold_dbfs - 12 / max(1, srate));
  );
) : (
  out_peak_bar_dbfs = out_peak_dbfs;
  out_peak_hold_dbfs = out_peak_dbfs;
);

// Store current samples for next iteration
outL_prev = outL;
outR_prev = outR;

sig_rms = 0.5*(outL*outL + outR*outR);

// ZP Loudness Meter v43 measurement core: BS.1770-style K-weighting,
// 100 ms blocks, 400 ms momentary, 3 s short-term, gated integrated/LRA.
kmL = meter_kL.zp_lufs_tick(outL);
kmR = meter_kR.zp_lufs_tick(outR);
ke = kmL*kmL + kmR*kmR;

meter_rms_block += sig_rms;
meter_lufs_block += ke;
meter_signal_active = (sig_rms > 0.00000001 || ke > 0.00000001);
meter_block_active = max(meter_block_active, meter_signal_active);

(meter_win_pos += 1) >= meter_win_len ? (
  meter_win_pos = 0;
  meter_win_cnt += 1;

  prev_rval = meter_rms_buf_base[meter_cur_buf];
  meter_rms_buf_base[meter_cur_buf] = meter_rms_block;
  prev_lval = meter_lufs_m_buf_base[meter_cur_buf];
  meter_lufs_m_buf_base[meter_cur_buf] = meter_lufs_block;
  prev_lval2 = meter_lufs_s_buf_base[meter_cur_buf2];
  meter_lufs_s_buf_base[meter_cur_buf2] = meter_lufs_block;

  (meter_cur_buf += 1) >= meter_m_win_cnt ? meter_cur_buf = 0;
  (meter_cur_buf2 += 1) >= meter_s_win_cnt ? meter_cur_buf2 = 0;

  meter_rms_m_sum += (meter_rms_block - prev_rval) * meter_i_m_win;
  meter_lufs_m_sum += (meter_lufs_block - prev_lval) * meter_i_m_win;
  meter_lufs_s_sum += (meter_lufs_block - prev_lval2) * meter_i_s_win;

  meter_rms_m_sum > 0 && meter_win_cnt >= meter_m_win_cnt ? (
    rms_db = gain2db(sqrt(max(meter_rms_m_sum, 0.000000000001)));
  ) : (
    rms_db = -100;
  );

  meter_lufs_m_sum > 0 && meter_win_cnt >= meter_m_win_cnt ? (
    cur_lufs_m = LUFS_CAL_DB -0.691 + 10*log(max(meter_lufs_m_sum,0.000000000001))/log(10);
  ) : (
    cur_lufs_m = -100;
  );

  meter_lufs_s_sum > 0 && meter_win_cnt >= meter_s_win_cnt ? (
    cur_lufs_s = LUFS_CAL_DB -0.691 + 10*log(max(meter_lufs_s_sum,0.000000000001))/log(10);
  ) : (
    cur_lufs_s = -100;
  );

  meter_play_state && cur_lufs_m > -70 ? (
    _mi_b = floor((cur_lufs_m + 70) * LRA_BPD);
    _mi_b = max(0, min(LRA_BINS-1, _mi_b));
    lufs_i_hist_cnt_base[_mi_b] += 1;
    lufs_i_hist_sum_base[_mi_b] += meter_lufs_m_sum;
    lufs_i_hist_total += 1;
    lufs_i_hist_energy += meter_lufs_m_sum;

    _mi_avg = LUFS_CAL_DB -0.691 + 10*log(max(lufs_i_hist_energy / max(1, lufs_i_hist_total), 0.000000000001))/log(10);
    _mi_gate = max(0, min(LRA_BINS-1, floor((_mi_avg - 10 + 70) * LRA_BPD)));
    _mi_sum = 0; _mi_cnt = 0; _mi_b = _mi_gate;
    loop(LRA_BINS - _mi_gate,
      _mi_cnt += lufs_i_hist_cnt_base[_mi_b];
      _mi_sum += lufs_i_hist_sum_base[_mi_b];
      _mi_b += 1;
    );
    cur_lufs_i = _mi_sum > 0 ? LUFS_CAL_DB -0.691 + 10*log(max(_mi_sum / max(1, _mi_cnt), 0.000000000001))/log(10) : -100;
  );

  meter_play_state && cur_lufs_s > -70 ? (
    _lra_b = floor((cur_lufs_s + 70) * LRA_BPD);
    _lra_b = max(0, min(LRA_BINS-1, _lra_b));
    lra_hist_base[_lra_b] += 1;
    lra_hist_total += 1;
    lra_hist_energy += meter_lufs_s_sum;

    lra_hist_total >= 20 ? (
      _lra_avg_db = LUFS_CAL_DB -0.691 + 10*log(max(lra_hist_energy / max(1, lra_hist_total), 0.000000000001))/log(10);
      _lra_gate = max(0, min(LRA_BINS-1, floor((_lra_avg_db - 20 + 70) * LRA_BPD)));
      _lra_gtot = 0; _lra_b = _lra_gate;
      loop(LRA_BINS - _lra_gate, _lra_gtot += lra_hist_base[_lra_b]; _lra_b += 1;);
      _lra_gtot >= 10 ? (
        _lra_p10 = _lra_gtot * 0.10;
        _lra_p95 = _lra_gtot * 0.95;
        _lra_cum = 0; _lra_b = _lra_gate;
        while (_lra_b < LRA_BINS && _lra_cum < _lra_p10) (
          _lra_cum += lra_hist_base[_lra_b]; _lra_b += 1;
        );
        _lra_bin_lo = max(_lra_gate, _lra_b - 1);
        _lra_cum = 0; _lra_b = _lra_gate;
        while (_lra_b < LRA_BINS && _lra_cum < _lra_p95) (
          _lra_cum += lra_hist_base[_lra_b]; _lra_b += 1;
        );
        _lra_bin_hi = max(_lra_bin_lo, _lra_b - 1);
        ui_lra = max(0, (_lra_bin_hi - _lra_bin_lo) * 0.1);
      );
    );
  );

  meter_prime_pending && (rms_db > -80 || cur_lufs_m > -80) ? (
    meter_prime_pending = 0;
    meter_just_primed = 1;
  );

  meter_rms_block = 0;
  meter_lufs_block = 0;
  meter_block_active = 0;
);

out_sig = 0.5*(outL*outL + outR*outR);
dbg_out_env = out_sig + dbg_meter_c*(dbg_out_env - out_sig);
dbg_out_db = gain2db(sqrt(max(dbg_out_env,0.000000000001)));
pk_out_env = peak_meter_tick(max(abs(outL), abs(outR)), pk_out_env);
pk_out_db = gain2db(pk_out_env);

// v3.0 telemetry contract for GUI rendering.
ui_input_in_db = pk_in_pre_db;
ui_input_act_db = in_smart_on ? abs(in_smart_trim_db) : 0;
ui_input_out_db = pk_in_post_db;
ui_input_smart_trim_db = in_smart_on ? in_smart_trim_db : 0;
ui_input_smart_in_db = pk_in_trim_db;
ui_input_smart_rms_db = in_smart_capture_ready >= 0.5 ? in_smart_capture_rms_db :
                        (in_smart_capture_count > 0 ? gain2db(sqrt(max(in_smart_capture_sum / max(1, in_smart_capture_count), 0.000000000001))) : smart_view_rms_db);
ui_input_smart_out_db = pk_in_post_db;
ui_input_smart_target_db = in_smart_target;
ui_input_smart_progress = in_smart_capture_progress;
ui_input_smart_ready = in_smart_capture_ready;
ui_input_smart_cap = in_smart_on && in_smart_capture_ready >= 0.5 && abs(in_smart_capture_trim_db) >= max(0.05, in_smart_max - 0.05) ? 1 : 0;
ui_input_smart_state = !in_smart_on ? 0 :
                       (in_smart_capture_ready >= 0.5 ? 2 :
                       (in_smart_capture_state == 1 ? 1 : 3));

ui_gate_in_db = pk_in_post_db;
ui_gate_act_db = max(0, -gain2db(max(gate_gain, 0.000000000001)));
ui_gate_out_db = pk_gate_db;

ui_1175_in_db = pk_gate_db;
ui_1175_act_db = max(0, -c1175_gr_db);
ui_1175_out_db = pk_1175_db;

ui_la2_in_db = pk_1175_db;
ui_la2_act_db = max(0, -la2_gr_db);
ui_la2_out_db = pk_la2_db;

ui_mt_in_db = mt_det_active_db;
ui_mt_act_db = max(0, -mt_gr_db);
ui_mt_out_db = pk_mt_db;

ui_brown_in_db = pk_brown_in_db;
ui_brown_act_db = max(max(max(abs(brn_gd1), abs(brn_gd2)), max(abs(brn_gd3), abs(brn_gd4))), max(max(abs(brn_user1_eff), abs(brn_user2_eff)), max(abs(brn_user3_eff), abs(brn_user4_eff)))); // Max dynamic/focus correction in dB
ui_brown_out_db = pk_brown_db;

ui_lim_in_db = pk_brown_db;
ui_lim_act_db = max(0, -gain2db(max(lim_gain, 0.000000000001)));
ui_lim_out_db = pk_lim_db;

ui_out_in_db = pk_lim_db;
ui_out_act_db = abs(out_final_gr_db);
ui_out_out_db = pk_out_db;
ui_out_trim_db = out_trim_db;
ui_out_pre_auto_dbfs = out_pre_auto_dbfs;
ui_out_peak_dbfs = meter_play_state ? out_peak_hold_dbfs : out_peak_dbfs;
ui_out_peak_bar_dbfs = meter_play_state ? out_peak_bar_dbfs : out_peak_dbfs;
ui_out_peak_max_dbfs = out_peak_max_dbfs;

ui_global_rms_db = rms_db;
// Compensazione +3dB in modalità mono per LUFS (standard ITU-R BS.1770)
mono_comp = mono_lufs_comp();
ui_global_lufs_i = cur_lufs_i + mono_comp;
ui_global_lufs_m = cur_lufs_m + mono_comp;
ui_global_lufs_s = cur_lufs_s + mono_comp;

// LRA e LUFS-I sono aggiornati nel core meter a blocchi 100 ms.
lra_needs_reset ? (
  memset(lra_hist_base, 0, LRA_BINS);
  memset(lufs_i_hist_cnt_base, 0, LRA_BINS);
  memset(lufs_i_hist_sum_base, 0, LRA_BINS);
  lra_hist_total = 0;
  lra_hist_energy = 0;
  lufs_i_hist_total = 0;
  lufs_i_hist_energy = 0;
  ui_lra = 0; disp_lra = -999;
  cur_lufs_i = -100;
  lra_needs_reset = 0;
);

ext_gr_meter = c1175_gr_db + la2_gr_db + mt_gr_db;




@gfx 792 1300

// ╔══════════════════════════════════════════════════════════════════════╗
// ║  MANUALE OPERATIVO — Voiceover Unified Chain ZP v4.1.0-bus-tone-beta ║
// ╠══════════════════════════════════════════════════════════════════════╣
// ║  STRUTTURA CATENA (dall'alto verso il basso)                        ║
// ║  1  Input Smart  — GainIn manuale prima di CAP; poi Target RMS,     ║
// ║                    Speed rampa trim, CAP/NEW nuova cattura           ║
// ║  2  Expander     — Gate espansore per ridurre il rumore di fondo:   ║
// ║                    THRS soglia, RANGE riduzione max, HYST isteresi, ║
// ║                    ATTK/REL, HPF SC dorato, Curve knee morbido       ║
// ║  3  1175         — Compressore FET veloce:                          ║
// ║                    THRS, RATIO, MKP, ATTK/REL, MIX, SC sidechain,   ║
// ║                    ATTK/REL tempi, MIX parallel compression          ║
// ║  4  LA2          — Compressore opto lento:                          ║
// ║                    P-Red Peak Reduction, GAIN make-up,              ║
// ║                    MIX parallel, COMP/LIM mode, SC sidechain        ║
// ║  5  Major Tom    — Compressore feed-forward/back con AMU:           ║
// ║                    THRS, RATIO, MKP, MIX, ATTK scalabile,           ║
// ║                    Hard/Soft knee, Peak/RMS detect, SC sidechain,   ║
// ║                    FFW/FFB feed mode, NoAM/AMU auto make-up          ║
// ║  6  Brown Guard  — Correzione tonale dinamica 4 bande verso slope   ║
// ║                    brown, preset toggle, Slope Map XY e AMU.        ║
// ║  7  Voice Limiter — zero latency, controllo picchi/densita':         ║
// ║                    Ceil tetto, Soft presa ms, Rel release,           ║
// ║                    PreG pre-gain, SAT saturazione soft               ║
// ╠══════════════════════════════════════════════════════════════════════╣
// ║  PANNELLO OUTPUT (fisso in fondo - visibile in GUI e JSFX)          ║
// ║  Gain finale Output, MaxTrm tetto trim auto,                        ║
// ║  LUFS/RMS/L+R target, Speed auto-trim. GainIn resta nel modulo Input.║
// ║  Meter verticali: LUFS M/S/I live | RMS live | TP reale.            ║
// ║  Measure: valori numerici post-plugin, max da inizio Play.          ║
// ╠══════════════════════════════════════════════════════════════════════╣
// ║  CONTROLLI HEADER                                                   ║
// ║  Row 1 – Preset: NAT Natural | BRD Broadcast | DNS Dense |          ║
// ║          WRM Warm | MCH Machine | FLT Flat (bypass DSP)             ║
// ║  Row 2 – ON/OFF moduli (blu=attivo, grigio=bypass DSP)              ║
// ║  Row 3 – I/O visibilità pannelli (verde=visibile, scuro=nascosto)   ║
// ╠══════════════════════════════════════════════════════════════════════╣
// ║  INTERAZIONE                                                        ║
// ║  Drag verticale    — modifica valore knob                           ║
// ║  SHIFT + drag      — precisione 12.5x                               ║
// ║  Doppio click      — reset al valore di default                      ║
// ║  Scroll mouse      — naviga i pannelli nella zona centrale           ║
// ║  Barra in fondo    — tooltip contestuale sul controllo attivo        ║
// ╚══════════════════════════════════════════════════════════════════════╝

// ═══════════════════════════════════════════════════════════════
// PRIMITIVES
// ═══════════════════════════════════════════════════════════════

function set_ui_slider(sl_idx, new_val) local(mask)(
  slider(sl_idx) = new_val;
  sl_idx <= 64 ? (
    mask = slider_mask(sl_idx);
    sliderchange(mask);
    slider_automate(mask);
  ) : sl_idx == 65 ? (
    sliderchange(slider65);
    slider_automate(slider65);
  ) : sl_idx == 66 ? (
    sliderchange(slider66);
    slider_automate(slider66);
  );
  dsp_needs_update = 1;  // forza compute_dsp_params() al prossimo @sample
);
function ui_set_hover(id) ( ui_hover_id = id; );
function hit(x, y, w, h) ( mouse_x>=x && mouse_x<=(x+w) && mouse_y>=y && mouse_y<=(y+h); );
function refresh_auto_mono_state()
local(hch)
(
  hch = get_host_numchan();
  hch <= 0 ? hch = num_ch;
  auto_mono_host_ch = hch;
  auto_mono_mode = hch < 2 ? 1 : 0;
  auto_mono_from_gfx = 1;
);
// ═══════════════════════════════════════════════════════════════
// PROFILE PRESETS
// ═══════════════════════════════════════════════════════════════

function apply_brown_manual_flat_gfx()
local(keep_slope, keep_amount, keep_attack, keep_release)
(
  keep_slope = brn_slope;
  keep_amount = max(1, brn_amount);
  keep_attack = brn_attack;
  keep_release = brn_release;
  set_ui_slider(59,0);
  set_ui_slider(60,keep_slope);
  set_ui_slider(61,keep_amount);
  set_ui_slider(62,keep_attack);
  set_ui_slider(63,keep_release);
  brn_max_cut=4; brn_max_boost=0.8; brn_low_protect=90;
  brn_xover_lm=200; brn_xover_mid=1300; brn_xover_high=2600;
  brn_hpf=80; brn_hpf_slope=2; brn_lpf=18000; brn_lpf_slope=1;
  brn_out_trim=0; brn_mix=100;
  brn_cut1=3.0; brn_cut2=3.0; brn_cut3=3.0; brn_cut4=3.0;
  brn_boost1=0.5; brn_boost2=0.5; brn_boost3=0.5; brn_boost4=0.5;
  brn_user1=0; brn_user2=0; brn_user3=0; brn_user4=0;
  brn_xmove1=0; brn_xmove2=0; brn_xmove3=0; brn_xmove4=0;
  brn_preset = 0;
  set_ui_slider(58, 0);
  last_brn_preset = 0;
  dsp_needs_update=1;
);

function reset_brown_slope_zero_gfx()
(
  set_ui_slider(58,0); // Brown Preset Manual
  set_ui_slider(59,0); // Brown Input Trim
  set_ui_slider(60,0); // Brown Target Slope
  brn_user1=0; brn_user2=0; brn_user3=0; brn_user4=0;
  brn_xmove1=brn_reset_xmove_for_freq(20, max(1,brn_fc1), 1.60);
  brn_xmove2=brn_reset_xmove_for_freq(200, max(1,brn_fc2), 1.35);
  brn_xmove3=brn_reset_xmove_for_freq(1500, max(1,brn_fc3), 1.35);
  brn_xmove4=brn_reset_xmove_for_freq(20000, max(1,brn_fc4), 1.60);
  brn_preset=0;
  last_brn_preset=0;
  dsp_needs_update=1;
);

function reset_brown_slope_point_gfx(pt)
(
  pt == 0 ? (brn_user1 = 0;);
  pt == 1 ? (brn_user2 = 0;);
  pt == 2 ? (brn_user3 = 0;);
  pt == 3 ? (brn_user4 = 0;);
  dsp_needs_update=1;
);

function apply_brown_preset_gfx(val)
(
  floor(brn_preset + 0.5) == val ? (
    apply_brown_manual_flat_gfx();
  ) : (
  brn_user1=0; brn_user2=0; brn_user3=0; brn_user4=0;
  brn_xmove1=0; brn_xmove2=0; brn_xmove3=0; brn_xmove4=0;
  val==1 ? (
    // BAL - Balanced: controllo morbido 800-1800Hz, protezione sub e alte
    set_ui_slider(59,0); set_ui_slider(60,1.0); set_ui_slider(61,35); set_ui_slider(62,180); set_ui_slider(63,1200);
    brn_max_cut=3; brn_max_boost=0.5; brn_low_protect=90;
    brn_xover_lm=200; brn_xover_mid=1300; brn_xover_high=2600;
    brn_hpf=80; brn_hpf_slope=2; brn_lpf=18000; brn_lpf_slope=1;
    brn_out_trim=0; brn_mix=100;
    brn_cut1=0; brn_cut2=2.0; brn_cut3=2.0; brn_cut4=0;
    brn_boost1=0; brn_boost2=0.3; brn_boost3=0.3; brn_boost4=0; dsp_needs_update=1;
  );
  val==2 ? (
    set_ui_slider(59,0); set_ui_slider(60,1.2); set_ui_slider(61,50); set_ui_slider(62,80); set_ui_slider(63,1000);
    brn_max_cut=6; brn_max_boost=0.3; brn_low_protect=85; brn_xover_lm=120; brn_xover_mid=250; brn_xover_high=800;
    brn_hpf=100; brn_hpf_slope=3; brn_lpf=16000; brn_lpf_slope=0; brn_out_trim=0; brn_mix=100;
    brn_cut1=4.0; brn_cut2=3.0; brn_cut3=0; brn_cut4=0; brn_boost1=0; brn_boost2=0; brn_boost3=0.5; brn_boost4=0.3; dsp_needs_update=1;
  );
  val==3 ? (
    set_ui_slider(59,0); set_ui_slider(60,1.4); set_ui_slider(61,45); set_ui_slider(62,120); set_ui_slider(63,1100);
    brn_max_cut=5; brn_max_boost=1.0; brn_low_protect=88; brn_xover_lm=200; brn_xover_mid=600; brn_xover_high=2500;
    brn_hpf=80; brn_hpf_slope=2; brn_lpf=16000; brn_lpf_slope=0; brn_out_trim=0; brn_mix=100;
    brn_cut1=0; brn_cut2=4.5; brn_cut3=2.0; brn_cut4=0; brn_boost1=0; brn_boost2=0; brn_boost3=1.0; brn_boost4=0.8; dsp_needs_update=1;
  );
  val==4 ? (
    set_ui_slider(59,0); set_ui_slider(60,1.0); set_ui_slider(61,55); set_ui_slider(62,60); set_ui_slider(63,900);
    brn_max_cut=6; brn_max_boost=0.5; brn_low_protect=90; brn_xover_lm=300; brn_xover_mid=1500; brn_xover_high=5000;
    brn_hpf=80; brn_hpf_slope=2; brn_lpf=12000; brn_lpf_slope=2; brn_out_trim=0; brn_mix=100;
    brn_cut1=0; brn_cut2=0; brn_cut3=2.0; brn_cut4=5.0; brn_boost1=0.2; brn_boost2=0.5; brn_boost3=0; brn_boost4=0; dsp_needs_update=1;
  );
  val==5 ? (
    set_ui_slider(59,0); set_ui_slider(60,1.0); set_ui_slider(61,0); set_ui_slider(62,200); set_ui_slider(63,1400);
    brn_max_cut=0; brn_max_boost=0; brn_low_protect=100; brn_xover_lm=200; brn_xover_mid=1300; brn_xover_high=2600;
    brn_hpf=80; brn_hpf_slope=2; brn_lpf=18000; brn_lpf_slope=1; brn_out_trim=0; brn_mix=100;
    brn_cut1=0; brn_cut2=0; brn_cut3=0; brn_cut4=0; brn_boost1=0; brn_boost2=0; brn_boost3=0; brn_boost4=0; dsp_needs_update=1;
  );
  brn_preset = val;
  set_ui_slider(58, val);
  last_brn_preset = val;
  );
);

