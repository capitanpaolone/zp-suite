dbg_mt_db = gain2db(sqrt(max(dbg_mt_env,0.000000000001)));

// 5) BrownSlope Dynamic Guard: 4-band tonal guard before peak control.
pk_brown_in_env = peak_meter_tick(max(abs(bL), abs(bR)), pk_brown_in_env);
pk_brown_in_db = gain2db(pk_brown_in_env);
brn_in_sig = 0.5*(bL*bL + bR*bR);
dbg_brown_in_env = brn_in_sig + dbg_meter_c*(dbg_brown_in_env - brn_in_sig);
dbg_brown_in_db = gain2db(sqrt(max(dbg_brown_in_env,0.000000000001)));

brn_on ? (
  brn_dry_l = bL;
  brn_dry_r = bR;
  brn_in_l = brn_dry_l * brn_in_g;
  brn_in_r = brn_dry_r * brn_in_g;

  // Mic-bus guard: HPF before detection so pops do not steer the brown map.
  brn_hpf_slope_i >= 1 ? ( brn_hp1_l += brn_hp_c*(brn_in_l-brn_hp1_l); brn_in_l -= brn_hp1_l; brn_hp1_r += brn_hp_c*(brn_in_r-brn_hp1_r); brn_in_r -= brn_hp1_r; );
  brn_hpf_slope_i >= 2 ? ( brn_hp2_l += brn_hp_c*(brn_in_l-brn_hp2_l); brn_in_l -= brn_hp2_l; brn_hp2_r += brn_hp_c*(brn_in_r-brn_hp2_r); brn_in_r -= brn_hp2_r; );
  brn_hpf_slope_i >= 3 ? ( brn_hp3_l += brn_hp_c*(brn_in_l-brn_hp3_l); brn_in_l -= brn_hp3_l; brn_hp3_r += brn_hp_c*(brn_in_r-brn_hp3_r); brn_in_r -= brn_hp3_r; );
  brn_hpf_slope_i >= 4 ? ( brn_hp4_l += brn_hp_c*(brn_in_l-brn_hp4_l); brn_in_l -= brn_hp4_l; brn_hp4_r += brn_hp_c*(brn_in_r-brn_hp4_r); brn_in_r -= brn_hp4_r; );

  brn_lp1_l += brn_c1 * (brn_in_l - brn_lp1_l);
  brn_lp1_r += brn_c1 * (brn_in_r - brn_lp1_r);
  brn_b1_l = brn_lp1_l;
  brn_b1_r = brn_lp1_r;
  brn_rem1_l = brn_in_l - brn_b1_l;
  brn_rem1_r = brn_in_r - brn_b1_r;

  brn_lp2_l += brn_c2 * (brn_rem1_l - brn_lp2_l);
  brn_lp2_r += brn_c2 * (brn_rem1_r - brn_lp2_r);
  brn_b2_l = brn_lp2_l;
  brn_b2_r = brn_lp2_r;
  brn_rem2_l = brn_rem1_l - brn_b2_l;
  brn_rem2_r = brn_rem1_r - brn_b2_r;

  brn_lp3_l += brn_c3 * (brn_rem2_l - brn_lp3_l);
  brn_lp3_r += brn_c3 * (brn_rem2_r - brn_lp3_r);
  brn_b3_l = brn_lp3_l;
  brn_b3_r = brn_lp3_r;
  brn_b4_l = brn_rem2_l - brn_b3_l;
  brn_b4_r = brn_rem2_r - brn_b3_r;

