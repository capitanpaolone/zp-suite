    brn_e2 = brn_p2 > brn_e2 ? brn_env_attack*brn_e2 + (1-brn_env_attack)*brn_p2 : brn_env_release*brn_e2 + (1-brn_env_release)*brn_p2;
    brn_e3 = brn_p3 > brn_e3 ? brn_env_attack*brn_e3 + (1-brn_env_attack)*brn_p3 : brn_env_release*brn_e3 + (1-brn_env_release)*brn_p3;
    brn_e4 = brn_p4 > brn_e4 ? brn_env_attack*brn_e4 + (1-brn_env_attack)*brn_p4 : brn_env_release*brn_e4 + (1-brn_env_release)*brn_p4;
  );

