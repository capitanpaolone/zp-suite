function draw_panel_la2(px,py,pw)  local(ky,ks,ki,m,bx,by,ratio_eff,_tw,_th)
(
  mod_active = floor(slider(20)+0.5);
  set_mod_color(4);
  draw_shell(px,py,pw,PH,"4  LA2");
  m=mx(px,pw); ky=py+62; ks=56; ki=px+44;
  ui_knob(21,ki,      ky,KR, 0,100, 38,"P-RED",6001);
  ui_knob(23,ki+ks,   ky,KR, 0,15,   0,"GAIN", 6002);
  ui_knob(24,ki+ks*2, ky,KR, 0,100,100,"MIX",  6003);
  bx=ki+ks*3+8; by=py+38;
  ui_sc_hpf_knob(48, bx+4, py+62, 10, 6010);
  ui_opt(22,0,"COMP",bx+62,by,   52,21,6004);
  ui_opt(22,1,"LIM", bx+62,by+26,52,21,6005);
  ratio_eff = floor(slider(22)+0.5) ? 10 : 3;
  gfx_setfont(1,"Arial",11); gfx_set(0.28,0.82,1.0,0.95);
  sprintf(#_la2r,"RATIO %d:1",ratio_eff);
  gfx_measurestr(#_la2r,_tw,_th);
  gfx_x=bx+138; gfx_y=py+58; gfx_drawstr(#_la2r);
  mod_active ? (
    draw_hsegs(   m,py+MBY0,MW,MBH,ui_la2_in_db, 8,"IN");
    draw_hsegs_gr(m,py+MBY1,MW,MBH,ui_la2_act_db,9,"GR");
    draw_hsegs(   m,py+MBY2,MW,MBH,ui_la2_out_db,10,"OUT");
  ) : (
    draw_hsegs_byp(m,py+MBY0,MW,MBH,"IN");
    draw_hsegs_byp(m,py+MBY1,MW,MBH,"GR");
    draw_hsegs_byp(m,py+MBY2,MW,MBH,"OUT");
  );
);

function draw_panel_mt(px,py,pw)  local(ky,ks,ki,m,bx,by,bw,bh)
(
  mod_active = floor(slider(25)+0.5);
  set_mod_color(5);
  draw_shell(px,py,pw,PH,"5  Major Tom");
  m=mx(px,pw); ky=py+62; ks=56; ki=px+44;
  ui_knob(26,ki,      ky,KR,-40, 0,  -14,"THRS", 7001);
  ui_knob(27,ki+ks,   ky,KR, 1,  20, 2.6,"RATIO",7002);
  ui_knob(32,ki+ks*2, ky,KR,-6,  20,   0,"MKP",  7003);
  ui_knob(33,ki+ks*3, ky,KR, 0, 100, 100,"MIX",  7004);
  mt_attack_ms = ui_internal_knob(mt_attack_ms, -7019, ki+ks*4, ky, KR, 0.2, 50, 10, "ATTK", 7019);
  ui_sc_hpf_knob(51, ki+ks*5, py+62, 10, 7020);
  bx=ki+ks*5+36; bw=48; bh=16; by=py+21;
  ui_opt(28,0,"HARD",bx,   by,   bw,bh,7011);
  ui_opt(28,1,"SOFT",bx,   by+20,bw,bh,7012);
  ui_opt(29,0,"PEAK",bx+52,by,   bw,bh,7013);
  ui_opt(29,1,"RMS", bx+52,by+20,bw,bh,7014);
  ui_opt(30,0,"FFW", bx,   by+42,bw,bh,7015);
  ui_opt(30,1,"FFB", bx,   by+62,bw,bh,7016);
  ui_opt(31,0,"NOAM",bx+52,by+42,bw,bh,7017);
  ui_opt(31,1,"AMU", bx+52,by+62,bw,bh,7018);
  mod_active ? (
    mt_detect ? draw_hsegs(m,py+MBY0,MW,MBH,ui_mt_in_db, 11,"RMS")
              : draw_hsegs(m,py+MBY0,MW,MBH,ui_mt_in_db, 11,"PK");
    draw_hsegs_gr(m,py+MBY1,MW,MBH,ui_mt_act_db,12,"GR");
    draw_hsegs(   m,py+MBY2,MW,MBH,ui_mt_out_db,13,"OUT");
  ) : (
    mt_detect ? draw_hsegs_byp(m,py+MBY0,MW,MBH,"RMS")
              : draw_hsegs_byp(m,py+MBY0,MW,MBH,"PK");
    draw_hsegs_byp(m,py+MBY1,MW,MBH,"GR");
    draw_hsegs_byp(m,py+MBY2,MW,MBH,"OUT");
  );
);

function draw_panel_brown(px,py,pw)  local(ky1,ky2,ks,ki,m,bx,by,bw,bh,stripx,stripy,stripw,striph,conn_x,conn_y,conn_h)
(
  mod_active = floor(slider(57)+0.5);
  set_mod_color(7);
  draw_shell(px,py,pw,BROWN_H,"6  Brown Guard");
  m=mx(px,pw); ky1=py+63; ky2=py+140; ks=72; ki=px+46;
  ui_knob(60,ki,    ky1,KR, -3,  8, 1.0,"SLOPE", 8101);
  ui_knob(61,ki+ks, ky1,KR, 0,150,  60,"AMT",   8102);
  ui_knob(62,ki,    ky2,KR, 20,2000,200,"ATK", 8103);
  ui_knob(63,ki+ks, ky2,KR,100,6000,1400,"REL",8104);
  bx=px+150; by=py+38; bw=50; bh=20;
  ui_brown_preset_button(1,bx,by,      bw,bh,"STD",8111);
  ui_brown_preset_button(2,bx,by+26,   bw,bh,"BAL",8112);
  ui_brown_preset_button(3,bx,by+52,   bw,bh,"DRK",8113);
  ui_brown_preset_button(4,bx,by+78,   bw,bh,"BRT",8114);
  ui_brown_amu_button(      bx,   by+104, 24,bh,"AMU",8115);
  ui_brown_din_button(      bx+26,by+104, 24,bh,"DIN",8116);
  stripx=px+210; stripy=py+12; stripw=max(262,m-stripx-14); striph=BROWN_H-24;
  draw_brown_band_strip(stripx, stripy, stripw, striph);
  conn_x = bx + bw + 3; conn_y = by; conn_h = 124;
  mod_active ? gfx_set(0.20,0.82,0.66,0.95) : gfx_set(0.12,0.20,0.16,0.55);
  gfx_rect(conn_x, conn_y, 1, conn_h);
  mod_active ? (
    draw_hsegs(   m+8,py+52, MW-8,MBH,ui_brown_in_db, 17,"IN");
    draw_hsegs_gr(m+8,py+95, MW-8,MBH,ui_brown_act_db,18,"TONE");
    draw_hsegs(   m+8,py+138,MW-8,MBH,ui_brown_out_db,19,"OUT");
  ) : (
    draw_hsegs_byp(m+8,py+52, MW-8,MBH,"IN");
    draw_hsegs_byp(m+8,py+95, MW-8,MBH,"TONE");
    draw_hsegs_byp(m+8,py+138,MW-8,MBH,"OUT");
  );
);

function draw_panel_lim(px,py,pw)  local(ky,ks,ki,m,sat_x,sat_l,sat_w)
(
  mod_active = floor(slider(34)+0.5);
  set_mod_color(6);
  draw_shell(px,py,pw,PH,"7  Voice Limiter");
  m=mx(px,pw); ky=py+62; ks=56; ki=px+44;
  ui_knob(35,ki,      ky,KR,-12, 0,  -1.0,"CEIL", 8001);
  ui_knob(36,ki+ks,   ky,KR, 0,  20,  0.0,"SOFT", 8002);
  ui_knob(37,ki+ks*2, ky,KR, 5, 500,   90,"REL",  8003);
  ui_knob(38,ki+ks*3, ky,KR,-12, 12,    0,"PREG", 8004);
  ui_knob(39,ki+ks*4, ky,KR, 0, 100,    0,"SAT",  8005);
  // SAT indicator: centrato nello spazio tra knob e meter
  sat_w = 76;
  sat_l = ki+ks*4+KR;
  sat_x = sat_l + floor((m - sat_l - sat_w)*0.5);
  draw_sat_indicator(sat_x, py+24, sat_w, 76, slider(39)*0.01);
  mod_active ? (
    draw_hsegs(   m,py+MBY0,MW,MBH,ui_lim_in_db, 14,"IN");
    draw_hsegs_gr(m,py+MBY1,MW,MBH,ui_lim_act_db,15,"GR");
    draw_hsegs(   m,py+MBY2,MW,MBH,ui_lim_out_db,16,"OUT");
  ) : (
    draw_hsegs_byp(m,py+MBY0,MW,MBH,"IN");
    draw_hsegs_byp(m,py+MBY1,MW,MBH,"GR");
    draw_hsegs_byp(m,py+MBY2,MW,MBH,"OUT");
  );
);

// Output presets — imposta tutti i parametri Output senza toccare la catena DSP
function apply_out_preset(pid, lufs, rms, maxtrm, spd, mkp, mode)
(
  set_ui_slider(41, lufs);    // LUFS target
  set_ui_slider(42, rms);     // RMS target
  set_ui_slider(55, clamp((lufs + rms) * 0.5, -29, -9)); // L+R target unico
  set_ui_slider(43, maxtrm);  // MaxTrm
  set_ui_slider(44, spd);     // Speed
  set_ui_slider(65, 0);       // Output Gain In manuale
  set_ui_slider(45, mkp);     // Output Gain finale
  set_ui_slider(40, mode);    // Auto mode
  out_preset_sel = pid;       // track active preset
  refresh_out_smart_capture_trim(); // LOCK resta valido: cambia solo il calcolo
);

function ui_out_preset(pid, label, x, y, w, h, hover_id, lufs, rms, maxtrm, spd, mkp, mode)
local(hover, _tw, _th, active, out_on)
(
  out_on = floor(out_enable+0.5);
  hover = hit(x,y,w,h);
  hover ? ui_set_hover(hover_id);
  out_on && hover && mouse_click ? apply_out_preset(pid, lufs, rms, maxtrm, spd, mkp, mode);
  active = (out_preset_sel == pid);
  !out_on ? gfx_set(0.10,0.11,0.13,1) :
  active  ? gfx_set(0.16,0.38,0.80,1) :
  hover   ? gfx_set(0.20,0.30,0.52,1) :
            gfx_set(0.12,0.16,0.24,1);
  gfx_rect(x,y,w,h);
  // highlight border when active
  out_on && active ? (
    gfx_set(0.32,0.64,0.98,1);
    gfx_rect(x,y,w,1); gfx_rect(x,y+h-1,w,1);
    gfx_rect(x,y,1,h); gfx_rect(x+w-1,y,1,h);
  );
  !out_on ? gfx_set(0.42,0.44,0.48,0.85) :
  active ? gfx_set(1.0,1.0,1.0,1) : gfx_set(0.72,0.84,0.98,0.88);
  gfx_setfont(1,"Arial",9,'b');
  gfx_measurestr(label,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5); gfx_y=y+floor((h-_th)*0.5); gfx_drawstr(label);
);

// Output panel — presets + TARGET 2 righe + Auto Trim esclusivo + LIVE meters + MEASURE
function draw_panel_output(px,py,pw)
local(ky1,ky2,ks,ki,_tw,_th,oh,tx2,vx,vy,vh,bx,bw,mi,mg,sp,live_w,bbw,bbg,bby,pbw,krr,kyref,
      calc_tgt,ref_active,hover_apply,out_en,bx_y,bx_h,rstx,auto_tm,
      ax,aw,trim_db,trim_norm,trim_mid,trim_fill,trim_y,pre_db,post_db,live_tp_disp,cap_sec,
      cap_kx,cap_ky,cap_kr,old_r,old_g,old_b,auto_apply,mode_y,mode_btn_w,mode_btn_h,man_x,auto_x)
(
  oh = PH + 210;   // scaled fixed output area
  out_en  = floor(out_enable+0.5);
  auto_tm = floor(slider(40)+0.5);   // 0=Off, 1=LUFS, 2=RMS, 3=L+R
  auto_apply = floor(slider(66)+0.5); // 0=MAN, 1=AUTO
  cap_sec = floor(clamp(out_capture_seconds, 20, 90) + 0.5);

  // ── Shell ────────────────────────────────────────────────────────────────
  gfx_set(out_en ? 0.14 : 0.10, out_en ? 0.16 : 0.10, out_en ? 0.17 : 0.11, 1);
  gfx_rect(px,py,pw,oh);
  out_en ? gfx_set(0.16,0.50,0.96,1) : gfx_set(0.28,0.28,0.32,1);
  gfx_rect(px,py,pw,2); gfx_rect(px,py+oh-2,pw,2);
  gfx_rect(px,py,2,oh); gfx_rect(px+pw-2,py,2,oh);

  // ── Layout constants ─────────────────────────────────────────────────────
  mod_r=0.20; mod_g=0.54; mod_b=0.92;
  ky1  = py + 96;     ky2  = py + 184;
  ks   = 56;          ki   = px + 64;   krr = 11;
  tx2  = px + 266;    // fine area Target: knobs, preset e Final Limiter
  vy   = py + 52;     vh   = oh - 52 - 22;   // meter height ridotto per fare spazio ai valori più grandi
  // Layout meter LIVE: M/S/I compatti, RMS/TP larghi per valori sopra 0 dBFS
  mi1  = 30;  // M, S, I width
  mi2  = 40;  // RMS, TP width
  mg   = 4;   // Gap aumentato
  sp   = 8;   // Spacer extra dopo I
  live_w = (mi1+mg)*2 + mi1 + sp + mi2 + mg + mi2;
  bw   = 116; // Measure piu' largo: la riga descrittiva resta leggibile
  // Flusso Output: Target -> Auto dB/Capture -> Measure -> LIVE meter
  vx   = px + pw - 8 - live_w;               // LIVE meter a destra
  bx   = vx - bw - 8;                        // Measure subito prima dei meter
  ax   = tx2 + 4;                            // Auto dB/Capture dopo Target
  aw   = bx - ax - 6;
  bby  = py + 192;
  kyref= py + 252;
  bx_y = py + 31;    bx_h = oh - 31 - 10;   // Misure box: 259px

  // ── Title ────────────────────────────────────────────────────────────────
  gfx_setfont(1,"Arial",12,'b');
  out_en ? gfx_set(0.58,0.80,0.98,1) : gfx_set(0.40,0.40,0.44,1);
  gfx_x=px+10; gfx_y=py+7; gfx_drawstr("Output");

  // ── Section labels: TARGET / LIVE / MEASURE — moved up one row ─────────
  gfx_setfont(1,"Arial",11,'b');
  gfx_set(0.56,0.72,0.96,0.90);
  gfx_x=px+8;  gfx_y=py+20; gfx_drawstr("TARGET");
  out_en && auto_tm == 0 ? (
    gfx_set(0.88,0.76,0.42,0.98);
    gfx_x=px+74; gfx_y=py+20; gfx_drawstr("MANUAL OUT");
  );
  gfx_set(0.22,0.80,0.36,0.90);
  gfx_x=vx+4;  gfx_y=py+20; gfx_drawstr("LIVE");
  gfx_set(0.36,0.68,0.96,1.0);
  gfx_x=bx+6;  gfx_y=py+20; gfx_drawstr("MEASURE");

  // separator below header
  gfx_set(0.18,0.20,0.24,1); gfx_rect(px+4,py+31,pw-8,1);

  // ── TARGET background ────────────────────────────────────────────────────
  gfx_set(0.11,0.12,0.14,1); gfx_rect(px+2, py+32, tx2-px-4, oh-35);

  // ── Preset Output buttons ────────────────────────────────────────────────
  pbw = floor((tx2 - px - 14) / 5) - 2;
  ui_out_preset(1,"POD", px+8,           py+35, pbw,14, 9020, -16,-18, 6,1.2,0,1);
  ui_out_preset(2,"AUD", px+8+(pbw+2),   py+35, pbw,14, 9021, -19,-21, 5,1.5,0,1);
  ui_out_preset(3,"MIX", px+8+(pbw+2)*2, py+35, pbw,14, 9022, -14,-16, 8,2.0,0,3);
  ui_out_preset(4,"BRD", px+8+(pbw+2)*3, py+35, pbw,14, 9023, -23,-25, 4,1.0,0,1);
  ui_out_preset(5,"RAD", px+8+(pbw+2)*4, py+35, pbw,14, 9024, -12,-14, 6,1.0,0,3);
  gfx_set(0.28,0.36,0.54,0.22); gfx_rect(px+4,py+55,tx2-px-8,1);

  // ── Knobs Riga 1: manual Output — IN pre-auto · OUT finale · MaxTrm
  ui_knob_value_font=12; ui_knob_label_font=12;
  out_en ? (mod_r=0.20; mod_g=0.54; mod_b=0.92) : (mod_r=0.34; mod_g=0.34; mod_b=0.36);
  draw_output_row_band(px+5, ky1-38, tx2-px-10, 66, "MAN", 0.20,0.54,0.92);
  out_en ? (
    ui_knob(65, ki,      ky1, KR, -12,  12,   0, "IN",     9065);
    ui_knob(45, ki+ks,   ky1, KR, -12,  12,   0, "OUT",    9003);
    ui_knob(43, ki+ks*2, ky1, KR,   0,  12,   6, "MAXTRM", 9002);
  ) : (
    ui_knob_disabled(65, ki,      ky1, KR, -12, 12, "IN",     9065);
    ui_knob_disabled(45, ki+ks,   ky1, KR, -12, 12, "OUT",    9003);
    ui_knob_disabled(43, ki+ks*2, ky1, KR,   0, 12, "MAXTRM", 9002);
  );

  // ── Knobs Riga 2: target auto-trim esclusivi — LUFS · RMS · L+R · Speed
  draw_output_row_band(px+5, ky2-38, tx2-px-10, 66, "REG", 0.20,0.54,0.92);
  ui_knob_target(41, 1, ki,       ky2, KR, -23,  -9, -16, "LUFS", 9001);
  ui_knob_target(42, 2, ki+ks,    ky2, KR, -30,  -9, -18, "RMS",  9004);
  ui_knob_target(55, 3, ki+ks*2,  ky2, KR, -29,  -9, -17, "L+R",  9014);
  out_en && auto_tm > 0 ? (mod_r=0.20; mod_g=0.54; mod_b=0.92)
                        : (mod_r=0.34; mod_g=0.34; mod_b=0.36);
  out_en ? ui_knob(44, ki+ks*3,  ky2, KR, 0.1,  5, 1.2, "SPEED",  9005)
         : ui_knob_disabled(44, ki+ks*3, ky2, KR, 0.1, 5, "SPEED", 9005);
  ui_knob_value_font=0; ui_knob_label_font=0;
  mod_r=0.20; mod_g=0.54; mod_b=0.92;

  // ── Auto Trim + RST ──────────────────────────────────────────────────────
  // Layout: alzato di 3 pulsanti (48px) rispetto alla posizione precedente
  bbw = floor((tx2-px-14)/5) - 2;  bbg = 2;
  bbh = 16; // Altezza pulsanti aumentata del 10%
  bby = py + 242;
  // Fondo logico dorato: questa riga governa la stessa funzione di Auto dB/Capture.
  gfx_set(0.15,0.12,0.065,0.72); gfx_rect(px+4,bby-20,tx2-px-8,bbh+26);
  gfx_set(0.70,0.58,0.32,0.42); gfx_rect(px+4,bby-20,tx2-px-8,1);
  gfx_set(0.70,0.58,0.32,0.18); gfx_rect(px+4,bby+bbh+5,tx2-px-8,1);
  // Label "Auto Trim" leggibile e separata dai knob
  gfx_setfont(1,"Arial",10,'b');
  out_en ? gfx_set(0.88,0.76,0.42,0.98) : gfx_set(0.58,0.50,0.34,0.85);
  auto_tm > 0 ? (gfx_x=px+6; gfx_y=bby-16; gfx_drawstr("Auto Trim:");) : (gfx_x=px+6; gfx_y=bby-16; gfx_drawstr("Manual:"););
  out_en ? (
    ui_opt(40, 0, "OFF",  px+6,             bby, bbw, bbh, 9010);
    ui_opt(40, 1, "LUFS", px+6+(bbw+bbg),   bby, bbw, bbh, 9011);
    ui_opt(40, 2, "RMS",  px+6+(bbw+bbg)*2, bby, bbw, bbh, 9012);
    ui_opt(40, 3, "L+R",  px+6+(bbw+bbg)*3, bby, bbw, bbh, 9013);
  ) : (
    gfx_set(0.10,0.11,0.13,1); gfx_rect(px+6,             bby, bbw, bbh);
    gfx_rect(px+6+(bbw+bbg),   bby, bbw, bbh);
    gfx_rect(px+6+(bbw+bbg)*2, bby, bbw, bbh);
    gfx_rect(px+6+(bbw+bbg)*3, bby, bbw, bbh);
    gfx_setfont(1,"Arial",10); gfx_set(0.42,0.44,0.48,0.85);
    gfx_x=px+6+floor((bbw-18)*0.5); gfx_y=bby+3; gfx_drawstr("Off");
    gfx_x=px+6+(bbw+bbg)+floor((bbw-22)*0.5); gfx_y=bby+3; gfx_drawstr("LUFS");
    gfx_x=px+6+(bbw+bbg)*2+floor((bbw-20)*0.5); gfx_y=bby+3; gfx_drawstr("RMS");
    gfx_x=px+6+(bbw+bbg)*3+floor((bbw-18)*0.5); gfx_y=bby+3; gfx_drawstr("L+R");
  );
  rstx = px+6+(bbw+bbg)*4;
  out_en && hit(rstx,bby,bbw,bbh) ? (ui_set_hover(9015); gfx_set(0.52,0.18,0.18,1)) : out_en ? gfx_set(0.26,0.12,0.12,1) : gfx_set(0.10,0.11,0.13,1);
  gfx_rect(rstx, bby, bbw, bbh);
  gfx_setfont(1,"Arial",10,'b'); gfx_set(0.88,0.56,0.56,1);
  gfx_measurestr("RST",_tw,_th);
  gfx_x=rstx+floor((bbw-_tw)*0.5); gfx_y=bby+floor((bbh-_th)*0.5); gfx_drawstr("RST");
  !ui_render_only && out_en && hit(rstx,bby,bbw,bbh) && mouse_click ? (
    set_ui_slider(40, 0);  set_ui_slider(41,-16); set_ui_slider(42,-18); set_ui_slider(55,-17);
    set_ui_slider(43, 6);  set_ui_slider(44,1.2); set_ui_slider(65,  0); set_ui_slider(45,  0); set_ui_slider(66,0);
    out_preset_sel = 0;
    reset_out_smart_capture();
  );

  // ── Final Limiter + GR Indicator ─────────────────────────────────────────
  // Distanza ridotta: solo 1 pulsante (16px) sotto Auto Trim
  fl_y = py + 286;
  fl_h = 16; // Stessa altezza dei pulsanti Auto Trim
  gfx_set(0.28,0.36,0.54,0.22); gfx_rect(px+4,fl_y-4,tx2-px-8,1); // Linea più in basso
  // Label "Final Limiter" ingrandita del 10%
  gfx_setfont(1,"Arial",10,'b');
  out_en ? gfx_set(0.58,0.80,0.98,0.95) : gfx_set(0.44,0.54,0.72,0.80);
  gfx_x=px+6; gfx_y=fl_y-16; gfx_drawstr("Final Limiter:");
  
  // ON/OFF button per final limiter (stessa dimensione pulsanti Auto Trim)
  flx = px+90; fly = fl_y; flw = bbw; 
  fl_on = floor(slider(54)+0.5);
  out_en && hit(flx,fly,flw,fl_h) ? ui_set_hover(9040);
  !ui_render_only && out_en && hit(flx,fly,flw,fl_h) && mouse_click ? set_ui_slider(54, 1-fl_on);
  !out_en ? gfx_set(0.10,0.11,0.13,1) :
  fl_on ? (hit(flx,fly,flw,fl_h) ? gfx_set(0.22,0.62,0.92,1) : gfx_set(0.16,0.50,0.88,1))
        : (hit(flx,fly,flw,fl_h) ? gfx_set(0.42,0.42,0.46,1) : gfx_set(0.24,0.24,0.28,1));
  gfx_rect(flx,fly,flw,fl_h);
  gfx_setfont(1,"Arial",10,'b');
  !out_en ? gfx_set(0.44,0.46,0.50,0.85) : fl_on ? gfx_set(1,1,1,0.95) : gfx_set(0.60,0.60,0.64,0.85);
  !out_en ? strcpy(#_flbl,"BYP") : fl_on ? strcpy(#_flbl,"ON") : strcpy(#_flbl,"OFF");
  gfx_measurestr(#_flbl,_tw,_th);
  gfx_x=flx+floor((flw-_tw)*0.5); gfx_y=fly+floor((fl_h-_th)*0.5); gfx_drawstr(#_flbl);
  
  fl_active = out_en && fl_on;

  // GR indicator - barra orizzontale
  grx = px+140; gry = fl_y+3; grw = (tx2-px-8) - 140 - 8; grh = 10;
  fl_active ? gfx_set(0.08,0.10,0.12,1) : gfx_set(0.07,0.07,0.08,1);
  gfx_rect(grx,gry,grw,grh);
  fl_active ? gfx_set(0.18,0.22,0.28,1) : gfx_set(0.14,0.14,0.16,1);
  gfx_rect(grx,gry,grw,1); gfx_rect(grx,gry+grh-1,grw,1);
  
  // Calcola GR per display (usa out_final_gr_db già disponibile)
  gr_db = abs(ui_out_act_db);
  gr_pct = min(1.0, gr_db / 12.0); // Max 12dB GR per la barra
  gr_fill = floor(grw * gr_pct);
  
  // Colore GR: verde->giallo->rosso
  gr_pct > 0.7 ? (gr_r=0.92; gr_g=0.28; gr_b=0.18;) :
  gr_pct > 0.4 ? (gr_r=0.90; gr_g=0.76; gr_b=0.10;) :
                 (gr_r=0.20; gr_g=0.72; gr_b=0.34;);
  
  fl_active && gr_fill > 0 ? (
    gfx_set(gr_r,gr_g,gr_b,0.85);
    gfx_rect(grx+1,gry+1,gr_fill,grh-2);
  );
  
  // Valore GR numerico
  gfx_setfont(1,"Arial",10,'b');
  !fl_active ? (
    gfx_set(0.46,0.46,0.50,0.90);
    strcpy(#_grv,"BYP");
  ) : gr_db > 0.1 ? (
    gfx_set(gr_r*0.8+0.2,gr_g*0.8+0.2,gr_b*0.8+0.2,1);
    sprintf(#_grv,"-%.1fdB",gr_db);
  ) : (
    gfx_set(0.50,0.58,0.64,0.85);
    strcpy(#_grv,"0.0dB");
  );
  gfx_measurestr(#_grv,_tw,_th);
  gfx_x=grx+floor((grw-_tw)*0.5); gfx_y=gry-14; gfx_drawstr(#_grv);
  
  // Ceiling indicator - ingrandito e più chiaro
  gfx_setfont(1,"Arial",9,'b');
  fl_active ? gfx_set(0.66,0.74,0.82,0.90) : gfx_set(0.42,0.46,0.50,0.85);
  fl_active ? (
    lim_on ? sprintf(#_ceil,"Ceil: %.1f",lim_ceiling + 0.7) : sprintf(#_ceil,"Ceil: -1.0");
  ) : (
    strcpy(#_ceil,"Ceil: BYP");
  );
  gfx_measurestr(#_ceil,_tw,_th); gfx_x=grx+grw-_tw; gfx_y=gry+grh+4; gfx_drawstr(#_ceil);

  // ── Meter LIVE ──────────────────────────────────────────────────────────
  // Layout: M/S/I compatti, RMS e TP più larghi per numeri leggibili.
  mi1 = 30;
  mi2 = 40;
  mg = 4;    // Gap aumentato per più spazio
  sp = 8;    // Spacer extra dopo I
  voff = 24; // Valori più in alto per font più grande
  
  out_en ? (
    draw_vseg(vx,                              vy, mi1, vh, ui_global_lufs_m, "M",   0.18,0.50,0.90, voff, 0);
    draw_vseg(vx+(mi1+mg),                      vy, mi1, vh, ui_global_lufs_s, "S",   0.18,0.50,0.90, voff, 1);
    draw_vseg(vx+(mi1+mg)*2,                    vy, mi1, vh, ui_global_lufs_i, "I",   0.22,0.60,0.96, voff, 2);
    draw_vseg(vx+(mi1+mg)*2+mi1+sp,             vy, mi2, vh, ui_global_rms_db, "RMS", 0.10,0.56,0.22, voff, 3);
    live_tp_disp = ui_out_peak_bar_dbfs;
    draw_vseg(vx+(mi1+mg)*2+mi1+sp+mi2+mg,      vy, mi2, vh, live_tp_disp, "TP",  0.16,0.80,0.36, voff, 4);
  ) : (
    draw_vseg_byp(vx,                              vy, mi1, vh, "M");
    draw_vseg_byp(vx+(mi1+mg),                      vy, mi1, vh, "S");
    draw_vseg_byp(vx+(mi1+mg)*2,                    vy, mi1, vh, "I");
    draw_vseg_byp(vx+(mi1+mg)*2+mi1+sp,             vy, mi2, vh, "RMS");
    draw_vseg_byp(vx+(mi1+mg)*2+mi1+sp+mi2+mg,      vy, mi2, vh, "TP");
  );

  // ── Auto Trim A/B indicator ─────────────────────────────────────────────
  aw > 44 ? (
    gfx_set(0.12,0.105,0.060,1); gfx_rect(ax, bx_y, aw, bx_h);
    gfx_set(0.70,0.58,0.32,0.42); gfx_rect(ax, bx_y, aw, 1);
    gfx_setfont(1,"Arial",11,'b'); gfx_set(0.88,0.76,0.42,0.98);
    gfx_x=ax+6; gfx_y=bx_y+5; gfx_drawstr("AUTO dB");
    trim_db = out_en ? ui_out_trim_db : 0;
    trim_norm = clamp(trim_db / max(0.1, out_trim_cap), -1, 1);
    trim_mid = ax + floor(aw*0.5);
    trim_y = bx_y + 45;
    gfx_set(0.09,0.10,0.12,1); gfx_rect(ax+6, trim_y, aw-12, 11);
    gfx_set(0.50,0.42,0.26,1); gfx_rect(trim_mid, trim_y-2, 1, 15);
    trim_fill = floor(abs(trim_norm) * (aw*0.5 - 8));
    trim_db >= 0 ? gfx_set(0.20,0.72,0.34,0.90) : gfx_set(0.90,0.32,0.26,0.90);
    trim_db >= 0 ? gfx_rect(trim_mid, trim_y+2, trim_fill, 7)
                 : gfx_rect(trim_mid-trim_fill, trim_y+2, trim_fill, 7);
    gfx_setfont(1,"Arial",16,'b');
    !out_en ? gfx_set(0.42,0.44,0.48,0.95) : trim_db >= 0 ? gfx_set(0.58,0.96,0.66,1) : gfx_set(1.0,0.58,0.50,1);
    !out_en ? strcpy(#_ot,"BYP") : auto_tm == 0 ? strcpy(#_ot,"MAN") : sprintf(#_ot,"%+.1f",trim_db);
    gfx_measurestr(#_ot,_tw,_th); gfx_x=ax+floor((aw-_tw)*0.5); gfx_y=bx_y+21; gfx_drawstr(#_ot);
    gfx_setfont(1,"Arial",11); gfx_set(0.56,0.68,0.78,0.98);
    pre_db = out_en ? ui_out_pre_auto_dbfs : -100;
    post_db = out_en ? ui_out_peak_dbfs : -100;
    gfx_x=ax+6; gfx_y=bx_y+68; auto_tm == 0 ? gfx_drawstr("PRE") : gfx_drawstr("NO A");
    gfx_setfont(1,"Arial",12,'b'); gfx_set(0.78,0.84,0.88,0.98);
    sprintf(#_op,"%.1f",pre_db); gfx_measurestr(#_op,_tw,_th); gfx_x=ax+aw-_tw-8; gfx_y=bx_y+67; gfx_drawstr(#_op);
    gfx_setfont(1,"Arial",11); gfx_set(0.56,0.68,0.78,0.98);
    gfx_x=ax+6; gfx_y=bx_y+92; auto_tm == 0 ? gfx_drawstr("OUT") : gfx_drawstr("AUTO");
    gfx_setfont(1,"Arial",12,'b'); gfx_set(0.78,0.84,0.88,0.98);
    sprintf(#_oa,"%.1f",post_db); gfx_measurestr(#_oa,_tw,_th); gfx_x=ax+aw-_tw-8; gfx_y=bx_y+91; gfx_drawstr(#_oa);
    gfx_setfont(1,"Arial",10); gfx_set(0.46,0.58,0.68,0.92);
    gfx_x=ax+6; gfx_y=bx_y+116; gfx_drawstr("dBFS peak");

    // MAN/AUTO apply switch: target is selected above, this only applies or measures.
    mode_y = bx_y + 134;
    mode_btn_h = 16;
    mode_btn_w = max(34, floor((aw - 20) * 0.5));
    man_x = ax + 6;
    auto_x = man_x + mode_btn_w + 8;
    gfx_setfont(1,"Arial",9,'b'); gfx_set(0.58,0.66,0.72,0.95);
    gfx_x=man_x; gfx_y=mode_y-12; gfx_drawstr("MODE");
    out_en && hit(man_x,mode_y,mode_btn_w,mode_btn_h) ? ui_set_hover(9066);
    out_en && hit(auto_x,mode_y,mode_btn_w,mode_btn_h) ? ui_set_hover(9066);
    !ui_render_only && out_en && hit(man_x,mode_y,mode_btn_w,mode_btn_h) && mouse_click ? set_ui_slider(66,0);
    !ui_render_only && out_en && hit(auto_x,mode_y,mode_btn_w,mode_btn_h) && mouse_click ? set_ui_slider(66,1);
    !out_en ? gfx_set(0.10,0.11,0.13,1) :
    auto_apply == 0 ? gfx_set(0.72,0.54,0.20,1) : gfx_set(0.22,0.22,0.25,1);
    gfx_rect(man_x,mode_y,mode_btn_w,mode_btn_h);
    !out_en ? gfx_set(0.10,0.11,0.13,1) :
    auto_apply == 1 ? gfx_set(0.20,0.58,0.92,1) : gfx_set(0.22,0.22,0.25,1);
    gfx_rect(auto_x,mode_y,mode_btn_w,mode_btn_h);
    gfx_setfont(1,"Arial",9,'b');
    gfx_set(auto_apply == 0 && out_en ? 1 : 0.62, auto_apply == 0 && out_en ? 0.96 : 0.64, auto_apply == 0 && out_en ? 0.80 : 0.66, 1);
    gfx_measurestr("MAN",_tw,_th); gfx_x=man_x+floor((mode_btn_w-_tw)*0.5); gfx_y=mode_y+floor((mode_btn_h-_th)*0.5); gfx_drawstr("MAN");
    gfx_set(auto_apply == 1 && out_en ? 1 : 0.62, auto_apply == 1 && out_en ? 1 : 0.64, auto_apply == 1 && out_en ? 1 : 0.66, 1);
    gfx_measurestr("AUTO",_tw,_th); gfx_x=auto_x+floor((mode_btn_w-_tw)*0.5); gfx_y=mode_y+floor((mode_btn_h-_th)*0.5); gfx_drawstr("AUTO");
  );

  // ── Output Smart Capture / LOCK ──────────────────────────────────────────
  // Sempre visibile sotto AUTO dB, nello stile del modulo ZP Unified Master.
  aw > 44 ? (
    _scap_x = ax;
    _scap_y = bx_y + floor(bx_h * 0.55);
    _scap_w = aw;
    _scap_h = bx_h - floor(bx_h * 0.55) - 5;
    _scap_h = max(58, _scap_h);

    !out_en ? (
      gfx_set(0.055,0.058,0.064,1); gfx_rect(_scap_x,_scap_y,_scap_w,_scap_h);
      gfx_set(0.22,0.24,0.28,0.45); gfx_rect(_scap_x,_scap_y,_scap_w,1); gfx_rect(_scap_x,_scap_y+_scap_h-1,_scap_w,1);
      gfx_setfont(1,"Arial",11,'b'); gfx_set(0.42,0.44,0.48,0.95); gfx_x=_scap_x+8; gfx_y=_scap_y+6; gfx_drawstr("CAPTURE BYP");
      gfx_setfont(1,"Arial",18,'b'); gfx_set(0.42,0.44,0.48,0.95); gfx_measurestr("BYP",_tw,_th);
      gfx_x=_scap_x+floor((_scap_w-_tw)*0.5); gfx_y=_scap_y+floor((_scap_h-_th)*0.5); gfx_drawstr("BYP");
    ) : auto_tm == 0 ? (
      gfx_set(0.085,0.095,0.105,1); gfx_rect(_scap_x,_scap_y,_scap_w,_scap_h);
      gfx_set(0.28,0.36,0.54,0.35); gfx_rect(_scap_x,_scap_y,_scap_w,1); gfx_rect(_scap_x,_scap_y+_scap_h-1,_scap_w,1);
      auto_apply ? strcpy(#_out_mode_lbl,"AUTO OUT") : strcpy(#_out_mode_lbl,"MAN OUT");
      gfx_setfont(1,"Arial",11,'b'); gfx_set(0.88,0.76,0.42,0.98); gfx_x=_scap_x+8; gfx_y=_scap_y+6; gfx_drawstr(#_out_mode_lbl);
      gfx_setfont(1,"Arial",18,'b'); gfx_set(0.58,0.80,0.98,1); gfx_measurestr("IN / OUT",_tw,_th);
      gfx_x=_scap_x+floor((_scap_w-_tw)*0.5); gfx_y=_scap_y+24; gfx_drawstr("IN / OUT");
      gfx_setfont(1,"Arial",10); gfx_set(0.54,0.66,0.76,0.95);
      gfx_x=_scap_x+6; gfx_y=_scap_y+_scap_h-16; gfx_drawstr("No Auto/Capture");
    ) : out_smart_capture_state < 1 ? (
      gfx_set(0.12,0.105,0.060,1); gfx_rect(_scap_x,_scap_y,_scap_w,_scap_h);
      gfx_set(0.70,0.58,0.32,0.42); gfx_rect(_scap_x,_scap_y,_scap_w,1); gfx_rect(_scap_x,_scap_y+_scap_h-1,_scap_w,1);
      cap_kx=_scap_x+12; cap_ky=_scap_y+22; cap_kr=8;
      old_r=mod_r; old_g=mod_g; old_b=mod_b;
      mod_r=0.18; mod_g=0.56; mod_b=0.98;
      ui_capture_time_knob(1, cap_kx, cap_ky, cap_kr, 9016);
      mod_r=old_r; mod_g=old_g; mod_b=old_b;
      gfx_setfont(1,"Arial",11,'b'); gfx_set(0.88,0.76,0.42,0.98); gfx_x=_scap_x+25; gfx_y=_scap_y+4; gfx_drawstr("CAPTURE");
      gfx_setfont(1,"Arial",19,'b'); gfx_set(0.58,0.96,0.66,1);
      sprintf(#_scap_val,"%+.1f",0.0); gfx_measurestr(#_scap_val,_tw,_th);
      gfx_x=_scap_x+floor(_scap_w*0.28); gfx_y=_scap_y+22; gfx_drawstr(#_scap_val);
      gfx_setfont(1,"Arial",10); gfx_set(0.54,0.66,0.76,0.95);
      sprintf(#_capdur,"%ds pre-auto",cap_sec);
      gfx_x=_scap_x+6; gfx_y=_scap_y+_scap_h-16; gfx_drawstr(#_capdur);
      _cap_btn_w=min(50,max(34,_scap_w*0.28)); _cap_btn_h=18;
      _cap_btn_x=_scap_x+_scap_w-_cap_btn_w-6;
      _cap_btn_y=_scap_y+floor(_scap_h*0.5)-floor(_cap_btn_h*0.5);
      out_en && hit(_cap_btn_x,_cap_btn_y,_cap_btn_w,_cap_btn_h) ? (ui_set_hover(9050); gfx_set(0.22,0.52,0.92,1); !ui_render_only && mouse_click ? prime_out_smart_capture();) : out_en ? gfx_set(0.16,0.36,0.72,1) : gfx_set(0.10,0.11,0.13,1);
      gfx_rect(_cap_btn_x,_cap_btn_y,_cap_btn_w,_cap_btn_h);
      gfx_setfont(1,"Arial",9,'b'); gfx_set(1,1,1,0.95); gfx_measurestr("CAP",_tw,_th);
      gfx_x=_cap_btn_x+floor((_cap_btn_w-_tw)*0.5); gfx_y=_cap_btn_y+floor((_cap_btn_h-_th)*0.5); gfx_drawstr("CAP");
    ) : out_smart_capture_state == 1 ? (
      gfx_set(0.12,0.10,0.06,1); gfx_rect(_scap_x,_scap_y,_scap_w,_scap_h);
      gfx_set(0.92,0.76,0.28,0.58); gfx_rect(_scap_x,_scap_y,_scap_w,1); gfx_rect(_scap_x,_scap_y+_scap_h-1,_scap_w,1);
      cap_kx=_scap_x+12; cap_ky=_scap_y+22; cap_kr=8;
      old_r=mod_r; old_g=mod_g; old_b=mod_b;
      mod_r=0.18; mod_g=0.56; mod_b=0.98;
      ui_capture_time_knob(1, cap_kx, cap_ky, cap_kr, 9016);
      mod_r=old_r; mod_g=old_g; mod_b=old_b;
      gfx_setfont(1,"Arial",11,'b'); gfx_set(0.92,0.76,0.28,0.95); gfx_x=_scap_x+25; gfx_y=_scap_y+4; gfx_drawstr("CAPTURING...");
      gfx_setfont(1,"Arial",17,'b'); gfx_set(0.92,0.76,0.28,1);
      sprintf(#_scap_val,"%.0f%%",out_smart_capture_progress); gfx_measurestr(#_scap_val,_tw,_th);
      gfx_x=_scap_x+floor((_scap_w-_tw)*0.5); gfx_y=_scap_y+24; gfx_drawstr(#_scap_val);
      _prog_w=floor((_scap_w-12)*out_smart_capture_progress*0.01);
      gfx_set(0.10,0.14,0.20,1); gfx_rect(_scap_x+6,_scap_y+_scap_h-14,_scap_w-12,6);
      gfx_set(0.92,0.76,0.28,1); gfx_rect(_scap_x+6,_scap_y+_scap_h-14,_prog_w,6);
    ) : (
      gfx_set(0.09,0.13,0.075,1); gfx_rect(_scap_x,_scap_y,_scap_w,_scap_h);
      gfx_set(0.70,0.58,0.32,0.35); gfx_rect(_scap_x,_scap_y,_scap_w,1); gfx_rect(_scap_x,_scap_y+_scap_h-1,_scap_w,1);
      cap_kx=_scap_x+12; cap_ky=_scap_y+22; cap_kr=8;
      old_r=mod_r; old_g=mod_g; old_b=mod_b;
      mod_r=0.18; mod_g=0.56; mod_b=0.98;
      ui_capture_time_knob(1, cap_kx, cap_ky, cap_kr, 9016);
      mod_r=old_r; mod_g=old_g; mod_b=old_b;
      gfx_setfont(1,"Arial",11,'b'); gfx_set(0.34,0.90,0.48,0.95); gfx_x=_scap_x+25; gfx_y=_scap_y+4; gfx_drawstr("LOCK");
      gfx_setfont(1,"Arial",19,'b'); out_smart_capture_trim_db>=0?gfx_set(0.58,0.96,0.66,1):gfx_set(1.0,0.58,0.50,1);
      sprintf(#_scap_val,"%+.1f",out_smart_capture_trim_db); gfx_measurestr(#_scap_val,_tw,_th);
      gfx_x=_scap_x+floor(_scap_w*0.25); gfx_y=_scap_y+22; gfx_drawstr(#_scap_val);
      gfx_setfont(1,"Arial",10); gfx_set(0.54,0.66,0.76,0.95); sprintf(#_scap_src,"src %.1f",out_smart_capture_rms_db);
      gfx_x=_scap_x+6; gfx_y=_scap_y+_scap_h-16; gfx_drawstr(#_scap_src);
      _new_btn_w=38; _new_btn_h=16;
      _new_btn_x=_scap_x+_scap_w-_new_btn_w-6;
      _new_btn_y=_scap_y+floor(_scap_h*0.5)-floor(_new_btn_h*0.5);
      out_en && hit(_new_btn_x,_new_btn_y,_new_btn_w,_new_btn_h) ? (ui_set_hover(9051); gfx_set(0.28,0.82,0.48,1); mouse_click ? out_smart_capture_confirm_time=time_precise();) : out_en ? gfx_set(0.18,0.62,0.38,1) : gfx_set(0.10,0.11,0.13,1);
      out_en && mouse_cap&1 && hit(_new_btn_x,_new_btn_y,_new_btn_w,_new_btn_h) && out_smart_capture_confirm_time>0 && (time_precise()-out_smart_capture_confirm_time)>0.8 ? (reset_out_smart_capture(); out_smart_capture_confirm_time=0;);
      !(mouse_cap&1) ? out_smart_capture_confirm_time=0;
      gfx_rect(_new_btn_x,_new_btn_y,_new_btn_w,_new_btn_h);
      gfx_setfont(1,"Arial",8,'b'); gfx_set(1,1,1,0.95); gfx_measurestr("NEW",_tw,_th);
      gfx_x=_new_btn_x+floor((_new_btn_w-_tw)*0.5); gfx_y=_new_btn_y+floor((_new_btn_h-_th)*0.5); gfx_drawstr("NEW");
    );
  );

  // ── Box MEASURE (right-anchored, sempre visibile) ───────────────────────
  gfx_set(0.09,0.10,0.12,1); gfx_rect(bx, bx_y, bw, bx_h);
  gfx_set(0.18,0.50,0.90,0.35); gfx_rect(bx, bx_y, bw, 1);
  gfx_set(0.18,0.50,0.90,0.18); gfx_rect(bx, bx_y+bx_h-1, bw, 1);
  gfx_set(0.18,0.50,0.90,0.18); gfx_rect(bx, bx_y, 1, bx_h);
  gfx_set(0.18,0.50,0.90,0.18); gfx_rect(bx+bw-1, bx_y, 1, bx_h);
  play_state > 0 ? gfx_set(0.22,0.82,0.28,1) : gfx_set(0.36,0.36,0.40,1);
  gfx_circle(bx+bw-7, bx_y+8, 3, 1, 1);
	  gfx_setfont(1,"Arial",9,'b'); gfx_set(0.48,0.62,0.78,0.90);
		  gfx_x=bx+6; gfx_y=bx_y+4; gfx_drawstr("LUFS M/S/I + RMS/TP");
  gfx_set(0.18,0.50,0.90,0.22); gfx_rect(bx, bx_y+18, bw, 1);

  // Values — step 40px, start offset 24
  // M
  gfx_setfont(1,"Arial",11);   gfx_set(0.54,0.68,0.76,1);
  gfx_x=bx+8; gfx_y=bx_y+24; gfx_drawstr("M");
  disp_lufs_m > -998 ? sprintf(#_d1,"%.1f",disp_lufs_m) : sprintf(#_d1,"--");
  gfx_setfont(1,"Arial",13,'b'); gfx_set(0.88,0.94,0.90,1);
  gfx_measurestr(#_d1,_tw,_th); gfx_x=bx+bw-_tw-8; gfx_y=bx_y+22; gfx_drawstr(#_d1);
  // S
  gfx_setfont(1,"Arial",11);   gfx_set(0.54,0.68,0.76,1);
  gfx_x=bx+8; gfx_y=bx_y+64; gfx_drawstr("S");
  disp_lufs_s > -998 ? sprintf(#_d2,"%.1f",disp_lufs_s) : sprintf(#_d2,"--");
  gfx_setfont(1,"Arial",13,'b'); gfx_set(0.88,0.94,0.90,1);
  gfx_measurestr(#_d2,_tw,_th); gfx_x=bx+bw-_tw-8; gfx_y=bx_y+62; gfx_drawstr(#_d2);
  // I
  gfx_setfont(1,"Arial",11);   gfx_set(0.54,0.68,0.76,1);
  gfx_x=bx+8; gfx_y=bx_y+104; gfx_drawstr("I");
  avg_lufs_disp > -998 ? sprintf(#_d3,"%.1f",avg_lufs_disp) : sprintf(#_d3,"--");
  gfx_setfont(1,"Arial",13,'b'); gfx_set(0.22,0.72,0.98,1);
  gfx_measurestr(#_d3,_tw,_th); gfx_x=bx+bw-_tw-8; gfx_y=bx_y+102; gfx_drawstr(#_d3);
  gfx_set(0.18,0.50,0.90,0.18); gfx_rect(bx, bx_y+128, bw, 1);
  // LRA
  gfx_setfont(1,"Arial",11);   gfx_set(0.54,0.68,0.76,1);
  gfx_x=bx+8; gfx_y=bx_y+132; gfx_drawstr("LRA");
  disp_lra > -998 ? sprintf(#_d4,"%.1f",disp_lra) : sprintf(#_d4,"--");
  gfx_setfont(1,"Arial",13,'b'); gfx_set(0.92,0.78,0.26,1);
  gfx_measurestr(#_d4,_tw,_th); gfx_x=bx+bw-_tw-8; gfx_y=bx_y+130; gfx_drawstr(#_d4);
  gfx_set(0.18,0.50,0.90,0.18); gfx_rect(bx, bx_y+172, bw, 1);
  // RMS con peak hold
  gfx_setfont(1,"Arial",11);   gfx_set(0.54,0.68,0.76,1);
  gfx_x=bx+8; gfx_y=bx_y+176; gfx_drawstr("RMS");
  avg_rms_disp > -998 ? sprintf(#_d5,"%.1f",avg_rms_disp) : sprintf(#_d5,"--");
  gfx_setfont(1,"Arial",13,'b'); gfx_set(0.88,0.94,0.90,1);
  gfx_measurestr(#_d5,_tw,_th); gfx_x=bx+bw-_tw-8; gfx_y=bx_y+174; gfx_drawstr(#_d5);
  // Max RMS da inizio Play
  gfx_setfont(1,"Arial",12,'b'); gfx_set(0.92,0.82,0.20,0.95); // Giallo
  measure_rms_peak > -90 ? sprintf(#_d5p,"max %.1f",measure_rms_peak) : strcpy(#_d5p,"");
  gfx_measurestr(#_d5p,_tw,_th); gfx_x=bx+bw-_tw-8; gfx_y=bx_y+191; gfx_drawstr(#_d5p);
  
  // True Peak post-plugin: lettura con hold stile meter esterno + massimo reale.
  gfx_setfont(1,"Arial",11);   gfx_set(0.54,0.68,0.76,1);
  gfx_x=bx+8; gfx_y=bx_y+220; gfx_drawstr("TP");
  avg_peak_disp > -998 ? sprintf(#_d6,"%.1f",avg_peak_disp) : sprintf(#_d6,"--");
  gfx_setfont(1,"Arial",13,'b'); gfx_set(0.88,0.94,0.90,1);
  gfx_measurestr(#_d6,_tw,_th); gfx_x=bx+bw-_tw-8; gfx_y=bx_y+218; gfx_drawstr(#_d6);
  // Max TP da inizio Play
  gfx_setfont(1,"Arial",12,'b'); gfx_set(0.92,0.82,0.20,0.95); // Giallo
  measure_pk_peak > -90 ? sprintf(#_d6p,"max %.1f",measure_pk_peak) : strcpy(#_d6p,"");
  gfx_measurestr(#_d6p,_tw,_th); gfx_x=bx+bw-_tw-8; gfx_y=bx_y+235; gfx_drawstr(#_d6p);
);

function draw_tip_message(tip_y)
local(max_w,_tw,_th,len,cut)
(
  max_w = gfx_w - 16;
  gfx_setfont(1,"Arial",13,'b'); gfx_set(0.84,0.91,0.95,1);
  gfx_measurestr(#_tip_msg,_tw,_th);
  _tw <= max_w ? (
    gfx_x=8; gfx_y=tip_y+13; gfx_drawstr(#_tip_msg);
  ) : (
    len = strlen(#_tip_msg);
    cut = floor(len * max_w / max(1,_tw) * 0.94);
    cut = clamp(cut, 18, len-2);
    strcpy_substr(#_tip_1,#_tip_msg,0,cut);
    strcpy_substr(#_tip_2,#_tip_msg,cut,len-cut);
    gfx_x=8; gfx_y=tip_y+4;  gfx_drawstr(#_tip_1);
    gfx_x=8; gfx_y=tip_y+22; gfx_drawstr(#_tip_2);
  );
);

// Tooltip bar (always drawn last)
function draw_tip_bar()
local(tip_y)
(
  tip_y = gfx_h - TIP_H;
  gfx_set(0.055,0.065,0.075,1); gfx_rect(0,tip_y,gfx_w,TIP_H);
  gfx_set(0.16,0.44,0.86,0.55); gfx_rect(0,tip_y,gfx_w,1);

  ui_hover_id==101 ? strcpy(#_tip_msg,"GUI: vista grafica pannelli modulo con knob interattivi e meter") :
