    brn_cut_cap2 = min(brn_max_cut, brn_cut2) * brn_amount_cap_w;
    brn_cut_cap3 = min(brn_max_cut, brn_cut3) * brn_amount_cap_w;
    brn_cut_cap4 = min(brn_max_cut, brn_cut4) * brn_amount_cap_w;
    brn_boost_cap1 = min(brn_max_boost, brn_boost1) * brn_amount_cap_w;
    brn_boost_cap2 = min(brn_max_boost, brn_boost2) * brn_amount_cap_w;
    brn_boost_cap3 = min(brn_max_boost, brn_boost3) * brn_amount_cap_w;
    brn_boost_cap4 = min(brn_max_boost, brn_boost4) * brn_amount_cap_w;

    brn_gd1 = clamp(-brn_err1 * brn_amount_w, -brn_cut_cap1 * (1 - brn_low_protect_w), brn_boost_cap1);
    brn_gd2 = clamp(-brn_err2 * brn_amount_w, -brn_cut_cap2, brn_boost_cap2);
    brn_gd3 = clamp(-brn_err3 * brn_amount_w, -brn_cut_cap3, brn_boost_cap3);
