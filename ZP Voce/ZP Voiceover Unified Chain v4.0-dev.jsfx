  brn_g1 = (brn_tg1 < brn_g1 ? brn_attack_coef : brn_release_coef) * brn_g1 + (1 - (brn_tg1 < brn_g1 ? brn_attack_coef : brn_release_coef)) * brn_tg1;
  brn_g2 = (brn_tg2 < brn_g2 ? brn_attack_coef : brn_release_coef) * brn_g2 + (1 - (brn_tg2 < brn_g2 ? brn_attack_coef : brn_release_coef)) * brn_tg2;
  brn_g3 = (brn_tg3 < brn_g3 ? brn_attack_coef : brn_release_coef) * brn_g3 + (1 - (brn_tg3 < brn_g3 ? brn_attack_coef : brn_release_coef)) * brn_tg3;
  brn_g4 = (brn_tg4 < brn_g4 ? brn_attack_coef : brn_release_coef) * brn_g4 + (1 - (brn_tg4 < brn_g4 ? brn_attack_coef : brn_release_coef)) * brn_tg4;

  brn_out_l = brn_b1_l*brn_g1 + brn_b2_l*brn_g2 + brn_b3_l*brn_g3 + brn_b4_l*brn_g4;
  brn_out_r = brn_b1_r*brn_g1 + brn_b2_r*brn_g2 + brn_b3_r*brn_g3 + brn_b4_r*brn_g4;

  brn_lpf_slope_i >= 1 ? ( brn_lpo1_l += brn_lp_c*(brn_out_l-brn_lpo1_l); brn_out_l = brn_lpo1_l; brn_lpo1_r += brn_lp_c*(brn_out_r-brn_lpo1_r); brn_out_r = brn_lpo1_r; );
  brn_lpf_slope_i >= 2 ? ( brn_lpo2_l += brn_lp_c*(brn_out_l-brn_lpo2_l); brn_out_l = brn_lpo2_l; brn_lpo2_r += brn_lp_c*(brn_out_r-brn_lpo2_r); brn_out_r = brn_lpo2_r; );
  brn_lpf_slope_i >= 3 ? ( brn_lpo3_l += brn_lp_c*(brn_out_l-brn_lpo3_l); brn_out_l = brn_lpo3_l; brn_lpo3_r += brn_lp_c*(brn_out_r-brn_lpo3_r); brn_out_r = brn_lpo3_r; );
  brn_lpf_slope_i >= 4 ? ( brn_lpo4_l += brn_lp_c*(brn_out_l-brn_lpo4_l); brn_out_l = brn_lpo4_l; brn_lpo4_r += brn_lp_c*(brn_out_r-brn_lpo4_r); brn_out_r = brn_lpo4_r; );

