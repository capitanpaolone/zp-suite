  bL = brn_pk2L.biquad_tick(bL); bR = brn_pk2R.biquad_tick(bR);
  bL = brn_pk3L.biquad_tick(bL); bR = brn_pk3R.biquad_tick(bR);
  bL = brn_pk4L.biquad_tick(bL); bR = brn_pk4R.biquad_tick(bR);

