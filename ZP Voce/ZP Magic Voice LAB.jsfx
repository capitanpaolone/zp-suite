view_mode != 2 ? (
  mon_y = view_mode == 0 ? 504 : 132;
  mon_h = max(242, bars_top_d - 10 - mon_y);
  draw_panel(16, mon_y, 1068, mon_h);
  mon_name = mon_sel == 0 ? "FILTER STAGE" : mon_sel == 1 ? "PEAK LEVELER (OPTO + RCOMP)" : mon_sel == 2 ? "DYNAMIC RESONANCE CONTROLLER" :
             mon_sel == 3 ? "DYNAMIC EQ" : mon_sel == 4 ? "TONE EQ + MID BUMP" : mon_sel == 5 ? "DYNAMIC BALANCE" : "OUTPUT";
  sprintf(#mt, "MONITOR · %s", mon_name);
  draw_group_title(16, mon_y, 1068, #mt, c_cyan_r, c_cyan_g, c_cyan_b, -1);

  tx = 30; ty = mon_y + 34;
  ui_tab_btn(52, 0, tx,       ty, 84, 24, "FILTER",  230, c_cyan_r,  c_cyan_g,  c_cyan_b, -1);
  ui_tab_btn(52, 1, tx + 90,  ty, 84, 24, "PEAK",    230, c_amber_r, c_amber_g, c_amber_b, -1);
  ui_tab_btn(52, 2, tx + 180, ty, 84, 24, "DRC",     230, c_mag_r,   c_mag_g,   c_mag_b, -1);
  ui_tab_btn(52, 3, tx + 270, ty, 84, 24, "DYN EQ",  230, c_cyan_r,  c_cyan_g,  c_cyan_b, -1);
  ui_tab_btn(52, 4, tx + 360, ty, 84, 24, "TONE",    230, c_amber_r, c_amber_g, c_amber_b, -1);
  ui_tab_btn(52, 5, tx + 450, ty, 84, 24, "DYN BAL", 230, c_grn_r,   c_grn_g,   c_grn_b, -1);
  ui_tab_btn(52, 6, tx + 540, ty, 84, 24, "OUTPUT",  230, c_grn_r,   c_grn_g,   c_grn_b, -1);

  d_x = 30; d_y = mon_y + 66; d_w = 700; d_h = mon_h - 76; fy = d_h / 166;

  mon_sel == 0 ? (
    // ---- FILTER: curva reale HPF*LPF ----
    mon_frame(c_cyan_r, c_cyan_g, c_cyan_b);
    draw_freq_grid();
    draw_db_line(0, -24, 6, "0"); draw_db_line(-12, -24, 6, "-12"); draw_db_line(-24, -24, 6, "-24");
    draw_curve(0, -24, 6, c_cyan_r + 0.2, c_cyan_g + 0.1, 1);
    gfx_setfont(6); gfx_r = 0.62; gfx_g = 0.82; gfx_b = 1; gfx_a = 1;
    fmt_freq(#fa, slider2); fmt_freq(#fb, slider3);
    sprintf(#ft, "LOW CUT %s Hz", #fa); g_txt(d_x + 40, d_y + 8, #ft);
    gfx_r = slider4 >= 0.5 ? 0.45 : 1; gfx_g = slider4 >= 0.5 ? 0.85 : 0.5; gfx_b = slider4 >= 0.5 ? 1 : 0.4;
    g_txtc(d_x + d_w * 0.5, d_y + 8, slider4 >= 0.5 ? "FILTERS ENGAGED" : "FILTERS BYPASSED");
    gfx_r = 0.62; gfx_g = 0.82; gfx_b = 1;
    sprintf(#ft, "HIGH CUT %s Hz", #fb); g_txtr(d_x + d_w - 20, d_y + 8, #ft);
  ) : mon_sel == 1 ? (
    // ---- PEAK: riduzioni Opto / RComp ----
    mon_frame(c_amber_r, c_amber_g, c_amber_b);
    gfx_setfont(6); gfx_r = 1; gfx_g = 0.82; gfx_b = 0.5; gfx_a = 1;
    sprintf(#pt, "SOGLIA %.1f dBFS   ·   PEAK RED %.0f%%   ·   %s", ui_pk_thr_db, slider6, slider7 >= 0.5 ? "ENGAGED" : "BYPASSED");
    g_txt(d_x + 18, d_y + 10 * fy, #pt);
    hbar_lvl(d_y + 38 * fy, "LIVELLO", max(-60, ui_pk_lvl_db), -48, 0, 0.45, 0.6, 1.0, ui_pk_thr_db);
    hbar_gr(d_y + 66 * fy, "OPTO", ui_gr_opt, 12, 0.55, 0.35, 0.95);
    hbar_gr(d_y + 92 * fy, "RCOMP", ui_gr_rc, 12, 0.90, 0.25, 0.45);
    hbar_gr(d_y + 118 * fy, "TOTALE", ui_peak_gr_db, 12, c_amber_r, c_amber_g, c_amber_b);
    gr_scale(d_y + 142 * fy, 12);
  ) : mon_sel == 2 ? (
    // ---- DRC: bande sullo spettro con riduzione ----
    mon_frame(c_mag_r, c_mag_g, c_mag_b);
    draw_freq_grid();
    drc_on = slider8 >= 0.5;
    sprintf(#rA, "A·%s", band_role(slider10, slider11));
    sprintf(#rB, "B·%s", band_role(slider14, slider15));
    sprintf(#rC, "C·%s", band_role(slider18, slider19));
    sprintf(#rD, "D·%s", band_role(slider22, slider23));
    band_gr(slider10, slider11, ui_drcA, 12, drc_on && slider9 >= 0.5,  #rA, 0, c_cyan_r,  c_cyan_g,  c_cyan_b);
    band_gr(slider14, slider15, ui_drcB, 12, drc_on && slider13 >= 0.5, #rB, 1, c_amber_r, c_amber_g, c_amber_b);
    band_gr(slider18, slider19, ui_drcC, 12, drc_on && slider17 >= 0.5, #rC, 2, c_mag_r,   c_mag_g,   c_mag_b);
    band_gr(slider22, slider23, ui_drcD, 12, drc_on && slider21 >= 0.5, #rD, 3, c_grn_r,   c_grn_g,   c_grn_b);
    gfx_setfont(7); gfx_r = 0.62; gfx_g = 0.70; gfx_b = 0.9; gfx_a = 0.9;
    g_txt(d_x + 40, d_y + 7, msg("altezza = riduzione (0..12 dB)", "height = reduction (0..12 dB)"));
  ) : mon_sel == 3 ? (
    // ---- DYNAMIC EQ ----
    mon_frame(c_cyan_r, c_cyan_g, c_cyan_b);
    draw_freq_grid();
    deq_on = slider26 >= 0.5;
    band_gr(130, 340, ui_deq_lo, 8, deq_on, "BOOM", 0, c_amber_r, c_amber_g, c_amber_b);
    band_gr(2100, 4600, ui_deq_hi, 8, deq_on, "BITE", 0, c_cyan_r, c_cyan_g, c_cyan_b);
    dq = floor(slider27 + 0.5);
    sprintf(#dt, "CURVA %s  ·  THR %.0f%%  ·  altezza = taglio dinamico (0..8 dB)", dq == 0 ? "A" : dq == 1 ? "B" : dq == 2 ? "C" : "D", slider28);
    gfx_setfont(7); gfx_r = 0.62; gfx_g = 0.70; gfx_b = 0.9; gfx_a = 0.9; g_txt(d_x + 40, d_y + 7, #dt);
  ) : mon_sel == 4 ? (
    // ---- TONE EQ: curva reale ----
    mon_frame(c_amber_r, c_amber_g, c_amber_b);
    draw_freq_grid();
    draw_db_line(12, -12, 12, "+12"); draw_db_line(6, -12, 12, "+6"); draw_db_line(0, -12, 12, "0");
    draw_db_line(-6, -12, 12, "-6"); draw_db_line(-12, -12, 12, "-12");
    draw_curve(1, -12, 12, 1, 0.70, 0.25);
    tq = floor(slider30 + 0.5);
    sprintf(#tt, "TONE %s  ·  SCALE %.2fx  ·  MID BUMP %s", tq == 0 ? "A" : tq == 1 ? "B" : tq == 2 ? "C" : "D", slider31, slider32 >= 0.5 ? "ON" : "OFF");
    gfx_setfont(6); gfx_r = 1; gfx_g = 0.82; gfx_b = 0.5; gfx_a = slider29 >= 0.5 ? 1 : 0.5; g_txt(d_x + 40, d_y + 8, #tt);
  ) : mon_sel == 5 ? (
    // ---- DYNAMIC BALANCE: distribuzione misurata vs target ----
    mon_frame(c_grn_r, c_grn_g, c_grn_b);
    draw_freq_grid();
    base = d_y + d_h - 30; hh = d_h - 72;
    i = 0;
    loop(3,
      fa = i == 0 ? 20 : i == 1 ? 280 : 2800;
      fb = i == 0 ? 280 : i == 1 ? 2800 : 20000;
      shv = i == 0 ? ui_sh_lo : i == 1 ? ui_sh_mid : ui_sh_hi;
      tgv = i == 0 ? t_lo : i == 1 ? t_mid : t_hi;
      gv  = i == 0 ? g_lo : i == 1 ? g_mid : g_hi;
      xa = fx_map(fa) + 3; xb = fx_map(fb) - 3;
      gfx_r = c_grn_r; gfx_g = c_grn_g; gfx_b = c_grn_b; gfx_a = 0.10; g_rect(xa, d_y + 34, xb - xa, base - d_y - 34);
      h = clamp(shv / 0.7, 0, 1) * hh;
      gfx_a = 0.85; g_rect(xa + 10, base - h, xb - xa - 20, h);
      ty2 = base - clamp(tgv / 0.7, 0, 1) * hh;
      gfx_r = 1; gfx_g = 0.85; gfx_b = 0.3; gfx_a = 1; g_rect(xa + 4, ty2 - 1, xb - xa - 8, 2);
      gfx_setfont(6); gfx_r = 0.9; gfx_g = 1; gfx_b = 0.92;
      sprintf(#bt, "%s  %.0f%% / target %.0f%%", i == 0 ? "LOW" : i == 1 ? "MID" : "HIGH", shv * 100, tgv * 100);
      g_txtc((xa + xb) * 0.5, d_y + 22, #bt);
      gfx_setfont(5); sprintf(#bg, "%+.1f dB", lin2db(gv)); g_txtc((xa + xb) * 0.5, d_y + 40, #bg);
      i += 1;
    );
    gfx_setfont(7); gfx_r = 0.62; gfx_g = 0.70; gfx_b = 0.9; gfx_a = 0.9;
    g_txtr(d_x + d_w - 12, d_y + 6, slider33 >= 0.5 ? "barra = energia misurata · linea gialla = target" : "BYPASSED: solo analisi");
  ) : (
    // ---- OUTPUT ----
    mon_frame(c_grn_r, c_grn_g, c_grn_b);
    hbar_lvl(d_y + 22 * fy, "RMS IN", ui_rms_in_db, -60, 0, c_cyan_r, c_cyan_g, c_cyan_b, -100);
    hbar_lvl(d_y + 48 * fy, "RMS OUT", ui_rms_out_db, -60, 0, c_grn_r, c_grn_g, c_grn_b, -100);
    hbar_lvl(d_y + 74 * fy, "SAMPLE PEAK", max(-60, lin2db(tp_meter_peak)), -36, 0, c_mag_r, c_mag_g, c_mag_b, slider41);
    hbar_lvl(d_y + 100 * fy, "GAIN MATCH", ui_gm_db, -6, 6, c_amber_r, c_amber_g, c_amber_b, 0);
    hbar_gr(d_y + 126 * fy, "LIMITER", ui_tp_gr_db, 12, c_mag_r, c_mag_g, c_mag_b);
  );

  // ---- Telemetria fissa a destra ----
  tl = 748; tm = 846; tw2 = 148; tvr = 1070;
  i = 0;
  loop(6,
    yy = mon_y + 40 + i * max(32, (mon_h - 60) / 6);
    gfx_setfont(5); set_sub_col();
    lbl_t = i == 0 ? "RMS In" : i == 1 ? "RMS Out" : i == 2 ? "Peak GR" : i == 3 ? "DRC max" : i == 4 ? "DynBal" : "Limit GR";
    g_txt(tl, yy - 2, lbl_t);
    i == 0 ? ( pc = clamp((ui_rms_in_db + 60) / 0.66, 0, 100);  sprintf(#tv, "%.1f dB", ui_rms_in_db);  draw_meter_h(tm, yy, tw2, 12, pc, c_cyan_r, c_cyan_g, c_cyan_b); );
    i == 1 ? ( pc = clamp((ui_rms_out_db + 60) / 0.66, 0, 100); sprintf(#tv, "%.1f dB", ui_rms_out_db); draw_meter_h(tm, yy, tw2, 12, pc, c_grn_r, c_grn_g, c_grn_b); );
    i == 2 ? ( fmt_gr(#tv, ui_peak_gr_db); draw_meter_h(tm, yy, tw2, 12, min(100, ui_peak_gr_db * 7), c_amber_r, c_amber_g, c_amber_b); );
    i == 3 ? ( fmt_gr(#tv, ui_drc_gr_db);  draw_meter_h(tm, yy, tw2, 12, min(100, ui_drc_gr_db * 8), c_mag_r, c_mag_g, c_mag_b); );
    i == 4 ? ( sprintf(#tv, "%.0f%%", dbal_act_pct);     draw_meter_h(tm, yy, tw2, 12, dbal_act_pct, c_grn_r, c_grn_g, c_grn_b); );
    i == 5 ? ( fmt_gr(#tv, ui_tp_gr_db);   draw_meter_h(tm, yy, tw2, 12, min(100, ui_tp_gr_db * 10), c_mag_r, c_mag_g, c_mag_b); );
    gfx_setfont(5); set_text_col(); g_txtr(tvr, yy - 2, #tv);
    i += 1;
  );
);

// ============================================================================
// ANALISI -> SUGGERIMENTI (solo lettura della telemetria)
// ============================================================================
function add_sug(s) (
  sug_n == 0 ? strcpy(#sug1, s) : sug_n == 1 ? strcpy(#sug2, s);
  sug_n += 1;
);
function check_drc_hi(eng, gr, fa, fb, letter) (
  eng && gr > 6.5 ? (
    fmt_freq(#sfa, min(fa, fb)); fmt_freq(#sfb, max(fa, fb));
    sprintf(#sgt, msg("DRC %s (%s-%s Hz) toglie %.1f dB: riduci THR %s o restringi la banda.",
                      "DRC %s (%s-%s Hz) removes %.1f dB: lower THR %s or narrow the band."), letter, #sfa, #sfb, gr, letter);
    add_sug(#sgt);
  );
);
function check_drc_idle(eng, gr, thr, letter) (
  eng && thr > 1 && gr < 0.15 ? (
    sprintf(#sgt, msg("DRC %s non interviene: se senti quella risonanza alza THR %s.",
                      "DRC %s is idle: if you hear that resonance raise THR %s."), letter, letter);
    add_sug(#sgt);
  );
);
function compute_suggestions() local(drc_on) (
  sug_n = 0; strcpy(#sug1, ""); strcpy(#sug2, "");
  drc_on = slider8 >= 0.5;
  ui_rms_in_db < -52 ? (
    add_sug(msg("In attesa di segnale: l'analisi parte quando arriva la voce.", "Waiting for signal: analysis starts when the voice arrives."));
  ) : (
    ui_tp_gr_db > 1.0 ? ( sprintf(#sgt, msg("Limiter finale attivo (-%.1f dB): abbassa OUTPUT o TONE SCL.", "Final limiter active (-%.1f dB): lower OUTPUT or TONE SCL."), ui_tp_gr_db); add_sug(#sgt); );
    ui_rms_in_db < -38 ? ( sprintf(#sgt, msg("Ingresso basso (%.0f dB RMS): alza INPUT di circa %.0f dB per far lavorare i detector.", "Low input (%.0f dB RMS): raise INPUT by about %.0f dB so detectors can work."), ui_rms_in_db, -26 - ui_rms_in_db); add_sug(#sgt); );
    ui_rms_in_db > -12 ? ( sprintf(#sgt, msg("Ingresso caldo (%.0f dB RMS): abbassa INPUT di circa %.0f dB.", "Hot input (%.0f dB RMS): lower INPUT by about %.0f dB."), ui_rms_in_db, ui_rms_in_db + 18); add_sug(#sgt); );
    slider7 >= 0.5 && ui_peak_gr_db > 9 ? ( sprintf(#sgt, msg("Peak Leveler molto spinto (-%.1f dB): porta PEAK RED verso 35-45%%.", "Peak Leveler pushed hard (-%.1f dB): bring PEAK RED toward 35-45%%."), ui_peak_gr_db); add_sug(#sgt); );
    check_drc_hi(drc_on && slider9 >= 0.5,  ui_drcA, slider10, slider11, "A");
    check_drc_hi(drc_on && slider13 >= 0.5, ui_drcB, slider14, slider15, "B");
    check_drc_hi(drc_on && slider17 >= 0.5, ui_drcC, slider18, slider19, "C");
    check_drc_hi(drc_on && slider21 >= 0.5, ui_drcD, slider22, slider23, "D");
    ui_sh_lo > t_lo + 0.12 ? add_sug(msg("Molto peso sulle basse (stanza o effetto prossimita'): prova LOWCUT piu' alto o una banda DRC su 200-500 Hz.", "Heavy low end (room or proximity): try a higher LOWCUT or a DRC band on 200-500 Hz."));
    ui_sh_hi < t_hi - 0.08 ? add_sug(msg("Voce scura rispetto al target: prova TONE A o MID BUMP, oppure alza DYN BAL.", "Dark voice vs target: try TONE A or MID BUMP, or raise DYN BAL."));
    ui_sh_hi > t_hi + 0.10 ? add_sug(msg("Voce brillante/sibilante: verifica una banda DRC tra 6k e 10k.", "Bright/sibilant voice: check a DRC band between 6k and 10k."));
    slider33 >= 0.5 && dbal_act_pct > 75 ? add_sug(msg("Dynamic Balance al limite: il microfono e' lontano dalla curva target. Abbassa DYN BAL o cambia A/B.", "Dynamic Balance at its limit: the mic is far from target. Lower DYN BAL or switch A/B."));
    slider7 >= 0.5 && slider6 > 5 && ui_peak_gr_db < 0.3 ? add_sug(msg("Peak Leveler quasi fermo: alza PEAK RED per livellare le distanze dal microfono.", "Peak Leveler nearly idle: raise PEAK RED to even out mic distance."));
    check_drc_idle(drc_on && slider9 >= 0.5,  ui_drcA, slider12, "A");
    check_drc_idle(drc_on && slider13 >= 0.5, ui_drcB, slider16, "B");
    check_drc_idle(drc_on && slider17 >= 0.5, ui_drcC, slider20, "C");
    check_drc_idle(drc_on && slider21 >= 0.5, ui_drcD, slider24, "D");
    sug_n == 0 ? add_sug(msg("Catena in equilibrio: nessun intervento eccessivo rilevato.", "Chain balanced: no excessive processing detected."));
  );
);

// ============================================================================
// BARRE IN BASSO: SUGGERIMENTI (opzionale) + GUIDA
// ============================================================================
ana_on ? (
  time_now - sug_t > 0.6 ? ( compute_suggestions(); sug_t = time_now; );
  gfx_r = show_simple ? 0.99 : 0.10; gfx_g = show_simple ? 0.95 : 0.09; gfx_b = show_simple ? 0.86 : 0.05; gfx_a = 1;
  gfx_rect(0, gyp(ana_yd), gfx_w, gyp(AB) + 1);
  gfx_r = c_amber_r; gfx_g = c_amber_g; gfx_b = c_amber_b; gfx_a = 0.9; gfx_rect(0, gyp(ana_yd), gfx_w, max(1, floor(2 * sc)));
  gfx_setfont(6); gfx_r = c_amber_r; gfx_g = c_amber_g; gfx_b = c_amber_b;
  g_txt(30, ana_yd + 9, msg("ANALISI", "ANALYSIS"));
  gfx_setfont(5); set_text_col();
  g_txt(110, ana_yd + 9, "•  "); g_txt(126, ana_yd + 9, #sug1);
  sug_n > 1 ? ( g_txt(110, ana_yd + 31, "•  "); g_txt(126, ana_yd + 31, #sug2); );
);

gfx_r = show_simple ? 0.86 : 0.11; gfx_g = show_simple ? 0.90 : 0.12; gfx_b = show_simple ? 0.95 : 0.15; gfx_a = 1;
gfx_rect(0, gyp(help_yd), gfx_w, gfx_h - gyp(help_yd));
gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_rect(0, gyp(help_yd), gfx_w, 1);

// Pulsante SUGGERIMENTI (in basso a destra)
sbw = 150; sbx = xr_d - sbw - 12; sby = help_yd + 4;
s_hover = mxd >= sbx && mxd <= sbx + sbw && myd >= sby && myd <= sby + 24;
s_hover ? active_info_id = 231;
s_hover && mouse_click_raw ? ( set_ui_state(51, ana_on ? 0 : 1); sug_t = -10; );
btn_face(sbx, sby, sbw, 24, msg("SUGGERIMENTI", "SUGGESTIONS"), ana_on, s_hover, c_amber_r, c_amber_g, c_amber_b);

gfx_setfont(4); set_text_col();
help_s = lab_edit ? msg("Frequenza in Hz: digita il valore. Invio applica, Esc annulla.", "Frequency in Hz: type a value. Enter applies, Esc cancels.") : active_info_id == 101 ? msg("INPUT: livello d'ingresso prima di Preamp e detector (doppio clic = 0 dB).", "INPUT: input level before Preamp and detectors (double click = 0 dB).") :
active_info_id == 102 ? msg("PEAK RED: livellatore Opto + RComp, uniforma la distanza dal microfono. L'anello mostra la riduzione.", "PEAK RED: Opto + RComp leveler, evens out mic distance. The ring shows gain reduction.") :
active_info_id == 103 ? msg("LOWCUT: passa-alto 12 dB/oct contro subsoniche, colpi d'aria ed effetto prossimita'.", "LOWCUT: 12 dB/oct high-pass against rumble, plosive air and proximity effect.") :
active_info_id == 104 ? msg("HICUT: passa-basso morbido, toglie il frizzio digitale fuori banda.", "HICUT: gentle low-pass, removes out-of-band digital fizz.") :
active_info_id == 105 ? msg("TUBE PREAMP: saturazione armonica leggera per dare densita' ai microfoni poveri.", "TUBE PREAMP: light harmonic saturation to add density to thin mics.") :
active_info_id == 106 ? msg("FILTERS: attiva/esclude Lowcut e Hicut.", "FILTERS: enable/bypass Lowcut and Hicut.") :
active_info_id >= 111 && active_info_id <= 114 ? msg("DRC: attiva la banda. Il nome (LOW/BOX/HARSH/PRES/SIB/AIR) segue la frequenza impostata.", "DRC: enable the band. Its name (LOW/BOX/HARSH/PRES/SIB/AIR) follows the set frequency.") :
active_info_id >= 121 && active_info_id <= 124 ? msg("THR: piu' alto = interviene prima e di piu'. L'anello e la barra mostrano la riduzione reale.", "THR: higher = acts sooner and more. Ring and bar show the actual reduction.") :
active_info_id >= 131 && active_info_id <= 134 ? msg("HP / LP: limiti della banda DRC (20 Hz - 20 kHz). SHIFT = precisione. Doppio clic = scrivi gli Hz.", "HP / LP: DRC band limits (20 Hz - 20 kHz). SHIFT = fine. Double click to type Hz.") :
active_info_id == 125 ? msg("SOLO: isola la banda per trovare la risonanza. Torna su OFF per sentire la correzione sulla voce intera.", "SOLO: isolate the band to find the resonance. Return to OFF to hear the correction on the whole voice.") :
active_info_id == 140 ? msg("DYN EQ: taglio dinamico su boom (~210 Hz) e bite (~3.1 kHz) solo quando la voce spinge.", "DYN EQ: dynamic cut on boom (~210 Hz) and bite (~3.1 kHz) only when the voice pushes.") :
active_info_id == 141 ? msg("Curve Dynamic EQ: A Clarity, B Warm Control, C Male Focus, D Smooth Presence.", "Dynamic EQ curves: A Clarity, B Warm Control, C Male Focus, D Smooth Presence.") :
active_info_id == 142 ? msg("TONE SCL: intensita' della curva tonale. Guarda la curva nel MONITOR TONE.", "TONE SCL: tonal curve intensity. See the curve in MONITOR TONE.") :
active_info_id == 143 ? msg("Curve Tone: A Open Air, B Rich Body, C Vocal Forward, D Male Authority.", "Tone curves: A Open Air, B Rich Body, C Vocal Forward, D Male Authority.") :
active_info_id == 144 ? msg("DYN BAL: porta il peso di basse/medie/alte verso la curva target. E' il cuore dell'omogeneita' tra microfoni.", "DYN BAL: moves low/mid/high weight toward the target curve. Core of mic-to-mic consistency.") :
active_info_id == 145 ? msg("Target Balance: A naturale, B denso da studio (piu' corpo).", "Balance target: A natural, B dense studio (more body).") :
active_info_id == 146 ? msg("MIX: parallelo della catena (0% dry, 100% processato).", "MIX: chain parallel blend (0% dry, 100% processed).") :
active_info_id == 147 ? msg("OUTPUT: guadagno finale prima del limiter.", "OUTPUT: final gain before the limiter.") :
active_info_id == 148 ? msg("PEAK CEIL: imposta il tetto del limiter sui picchi dei campioni (dBFS).", "PEAK CEIL: sets the sample peak limiter ceiling (dBFS).") :
active_info_id == 201 ? msg("MALE LD: taratura MagicFlow per voce maschile.", "MALE LD: MagicFlow calibration for male voice.") :
active_info_id == 202 ? msg("FEMALE LD: taratura MagicFlow per voce femminile, 4 bande DRC.", "FEMALE LD: MagicFlow calibration for female voice, 4 DRC bands.") :
active_info_id == 203 ? msg("CLARITY: pulizia medio-bassa e apertura.", "CLARITY: low-mid cleanup and openness.") :
active_info_id == 204 ? msg("MID PC: parallelo al 49% con spinta sui medi.", "MID PC: 49% parallel with mid push.") :
active_info_id == 205 ? msg("HOME BOOTH: per cabine domestiche e microfoni eterogenei.", "HOME BOOTH: for home booths and mixed microphones.") :
active_info_id == 206 ? msg("BROADCAST: voce ferma e autorevole.", "BROADCAST: steady, authoritative voice.") :
active_info_id == 207 ? msg("MAGIC 1: preset di Paolo (da Magic1.mfp): DRC su 20-200 Hz, 1.6k-2.3k, 3.6k-5.7k.", "MAGIC 1: Paolo's preset (from Magic1.mfp): DRC on 20-200 Hz, 1.6k-2.3k, 3.6k-5.7k.") :
active_info_id >= 210 && active_info_id <= 217 ? msg("Attiva/esclude lo stadio e lo mostra nel MONITOR.", "Enable/bypass the stage and show it in the MONITOR.") :
active_info_id == 220 ? msg("FULL tutta la grafica, MINI solo monitor, JSFX lista parametri (OSARA).", "FULL complete GUI, MINI monitor only, JSFX parameter list (OSARA).") :
active_info_id == 221 ? msg("SIMPLE tema chiaro e bande in sola lettura, ADVANCED tema scuro con HP/LP delle bande.", "SIMPLE light theme, read-only bands; ADVANCED dark theme with band HP/LP.") :
active_info_id == 222 ? msg("GAIN MATCH: compensa il volume percepito per confronti onesti.", "GAIN MATCH: compensates perceived loudness for fair comparisons.") :
active_info_id == 223 ? msg("DELTA: ascolta solo cio' che il plugin toglie/aggiunge.", "DELTA: hear only what the plugin removes/adds.") :
active_info_id == 230 ? msg("MONITOR: scegli il modulo da osservare (anche cliccando titoli, knob o pulsanti).", "MONITOR: pick the module to watch (also by clicking titles, knobs or buttons).") :
active_info_id == 231 ? msg("SUGGERIMENTI: barra con i consigli dell'analisi in tempo reale.", "SUGGESTIONS: bar with real-time analysis advice.") :
active_info_id == 232 ? msg("Clic sul titolo: mostra questo modulo nel MONITOR.", "Click the title: show this module in the MONITOR.") :
msg("ZP MAGIC VOICE LAB  ·  Passa il mouse su un controllo per la guida  ·  SHIFT = precisione  ·  Doppio clic sugli Hz = scrivi",
            "ZP MAGIC VOICE LAB  ·  Hover a control for help  ·  SHIFT = fine  ·  Double click Hz = type");
g_txt(30, help_yd + 8, help_s);

last_mouse_cap = mouse_cap;
