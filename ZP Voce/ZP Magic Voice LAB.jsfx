  ui_drc_oct_knob( 18, 19, cxC + 78, r1y + 220, 18, 0.86, c_mag_r,   c_mag_g,   c_mag_b,   137);
  ui_drc_freq_knob(22, 23, cxD + 28, r1y + 220, 18, 7357, c_grn_r,   c_grn_g,   c_grn_b,   134);
  ui_drc_oct_knob( 22, 23, cxD + 78, r1y + 220, 18, 0.64, c_grn_r,   c_grn_g,   c_grn_b,   138);

  fmt_freq(#sp1, min(slider10, slider11)); fmt_freq(#sp2, max(slider10, slider11)); sprintf(#spa, "%s-%s", #sp1, #sp2);
  fmt_freq(#sp1, min(slider14, slider15)); fmt_freq(#sp2, max(slider14, slider15)); sprintf(#spb, "%s-%s", #sp1, #sp2);
  fmt_freq(#sp1, min(slider18, slider19)); fmt_freq(#sp2, max(slider18, slider19)); sprintf(#spc, "%s-%s", #sp1, #sp2);
  fmt_freq(#sp1, min(slider22, slider23)); fmt_freq(#sp2, max(slider22, slider23)); sprintf(#spd, "%s-%s", #sp1, #sp2);
  gfx_setfont(7); set_sub_col(); gfx_a = 0.85;
  g_txtc(cxA + 53, r1y + 258, #spa);
  g_txtc(cxB + 53, r1y + 258, #spb);
  g_txtc(cxC + 53, r1y + 258, #spc);
  g_txtc(cxD + 53, r1y + 258, #spd);

  draw_meter_h(cxA + 8, r1y + 274, 90, 10, min(100, ui_drcA * 10), c_cyan_r,  c_cyan_g,  c_cyan_b);
  draw_meter_h(cxB + 8, r1y + 274, 90, 10, min(100, ui_drcB * 10), c_amber_r, c_amber_g, c_amber_b);
  draw_meter_h(cxC + 8, r1y + 274, 90, 10, min(100, ui_drcC * 10), c_mag_r,   c_mag_g,   c_mag_b);
  draw_meter_h(cxD + 8, r1y + 274, 90, 10, min(100, ui_drcD * 10), c_grn_r,   c_grn_g,   c_grn_b);
  gfx_setfont(7); set_sub_col();
  fmt_gr(#gv, ui_drcA); g_txtc(cxA + 53, r1y + 289, #gv);
  fmt_gr(#gv, ui_drcB); g_txtc(cxB + 53, r1y + 289, #gv);
  fmt_gr(#gv, ui_drcC); g_txtc(cxC + 53, r1y + 289, #gv);
  fmt_gr(#gv, ui_drcD); g_txtc(cxD + 53, r1y + 289, #gv);

  // Logica sistema a molla (Auto-Solo sui 3 rotori della zona armata + rilascio automatico)
  cur_solo_arm = floor(slider25 + 0.5);
  drag_drc_zone = (ui_drag_id >= 10 && ui_drag_id <= 12) ? 1 :
                  (ui_drag_id >= 14 && ui_drag_id <= 16) ? 2 :
                  (ui_drag_id >= 18 && ui_drag_id <= 20) ? 3 :
                  (ui_drag_id >= 22 && ui_drag_id <= 24) ? 4 : 0;
  // Se tocchi un controllo di un'altra zona o un altro modulo, oppure dopo 10s di inattivita', il Solo si disarma da solo
  cur_solo_arm > 0 && (
    (ui_drag_id > 0 && drag_drc_zone != cur_solo_arm) ||
    (time_now - solo_arm_time > 10.0 && ui_hold_solo_btn == 0 && drag_drc_zone == 0)
  ) ? (
    set_param_slider(25, 0);
    cur_solo_arm = 0;
    drc_solo_audition_band = 0;
  );
  mouse_down && cur_solo_arm > 0 && drag_drc_zone == cur_solo_arm ? (
    solo_arm_time = time_now;
    drc_solo_audition_band = cur_solo_arm;
  ) : mouse_down && ui_hold_solo_btn > 0 ? (
    solo_arm_time = time_now;
    drc_solo_audition_band = ui_hold_solo_btn;
  ) : (
    drc_solo_audition_band = 0;
  );

  // Pulsantino / spia di sgancio in alto accanto a "2 · DRC" quando la molla e' armata
  cur_solo_arm > 0 ? (
    sprintf(#hdr_solo, drc_solo_audition_band > 0 ? "IN PREASCOLTO %s [X]" : "MOLLA %s (%ds) [X]",
            cur_solo_arm == 1 ? "A" : cur_solo_arm == 2 ? "B" : cur_solo_arm == 3 ? "C" : "D",
            max(1, floor(10.9 - (time_now - solo_arm_time))));
    ui_drc_solo_btn(0, 0, 355, r1y + 6, 138, 20, #hdr_solo, 1.0, 0.72, 0.16);
  );

  // Avviso visivo di preascolto nel pannello DRC
  drc_solo_audition_band > 0 ? (
    gfx_r = 0.98; gfx_g = 0.58; gfx_b = 0.12; gfx_a = 0.95;
    g_rect(288, r1y + 298, 424, 17);
    gfx_setfont(7); gfx_r = 0.05; gfx_g = 0.05; gfx_b = 0.07; gfx_a = 1;
    sprintf(#swrn, "PREASCOLTO ATTIVO BANDA %s (rilascia il mouse per tornare alla voce intera)",
            drc_solo_audition_band == 1 ? "A" : drc_solo_audition_band == 2 ? "B" : drc_solo_audition_band == 3 ? "C" : "D");
    g_txtc(500, r1y + 300, #swrn);
  ) : cur_solo_arm > 0 ? (
    gfx_r = 0.24; gfx_g = 0.19; gfx_b = 0.08; gfx_a = 0.95;
    g_rect(288, r1y + 298, 424, 17);
    gfx_r = 1.0; gfx_g = 0.76; gfx_b = 0.22; gfx_a = 0.9;
    g_frame(288, r1y + 298, 424, 17);
    gfx_setfont(7); gfx_r = 1.0; gfx_g = 0.84; gfx_b = 0.35; gfx_a = 1;
    sprintf(#swrn, "MOLLA SOLO %s ARMATA: tocca THR / FREQ / OCT sopra per preascoltare (auto-off %ds)",
            cur_solo_arm == 1 ? "A" : cur_solo_arm == 2 ? "B" : cur_solo_arm == 3 ? "C" : "D",
            max(1, floor(10.9 - (time_now - solo_arm_time))));
    g_txtc(500, r1y + 300, #swrn);
  );

  slider8 < 0.5 ? (
    drc_byp_hv = hit(362, r1y + 5, 136, 18);
    drc_byp_bn = hit(288, r1y + 298, 424, 17);
    drc_byp_hv || drc_byp_bn ? (
      active_info_id = 213;
      mouse_click ? ( set_param_slider(8, 1); set_mon(2); update_dsp_params(); );
    );
    gfx_r = drc_byp_hv ? 1.0 : 0.92; gfx_g = 0.30; gfx_b = 0.26; gfx_a = 0.95;
    g_rect(362, r1y + 5, 136, 18);
    gfx_setfont(7); gfx_r = 0.05; gfx_g = 0.05; gfx_b = 0.07; gfx_a = 1;
    g_txtc(430, r1y + 7, msg("BYPASSED [ATTIVA]", "BYPASSED [ENABLE]"));

    gfx_r = drc_byp_bn ? 0.38 : 0.26; gfx_g = 0.10; gfx_b = 0.10; gfx_a = 0.95;
    g_rect(288, r1y + 298, 424, 17);
    gfx_r = 0.95; gfx_g = 0.34; gfx_b = 0.28; gfx_a = 0.92;
    g_frame(288, r1y + 298, 424, 17);
    gfx_setfont(7); gfx_r = 1.0; gfx_g = 0.78; gfx_b = 0.74; gfx_a = 1;
    g_txtc(500, r1y + 300, msg("4·DRC SPENTO IN TESTATA: clicca qui o su 4·DRC per riattivare", "4·DRC BYPASSED IN HEADER: click here or 4·DRC to enable"));
  );

  // 4 pulsanti SOLO allineati esattamente sotto le 4 colonne A, B, C, D (larghezza 100 px ciascuno)
  ui_drc_solo_btn(1, 9,  cxA + 3, r1y + 318, 100, 28, drc_solo_audition_band == 1 ? "IN SOLO A" : cur_solo_arm == 1 ? "MOLLA A" : "SOLO A", c_cyan_r,  c_cyan_g,  c_cyan_b);
  ui_drc_solo_btn(2, 13, cxB + 3, r1y + 318, 100, 28, drc_solo_audition_band == 2 ? "IN SOLO B" : cur_solo_arm == 2 ? "MOLLA B" : "SOLO B", c_amber_r, c_amber_g, c_amber_b);
  ui_drc_solo_btn(3, 17, cxC + 3, r1y + 318, 100, 28, drc_solo_audition_band == 3 ? "IN SOLO C" : cur_solo_arm == 3 ? "MOLLA C" : "SOLO C", c_mag_r,   c_mag_g,   c_mag_b);
  ui_drc_solo_btn(4, 21, cxD + 3, r1y + 318, 100, 28, drc_solo_audition_band == 4 ? "IN SOLO D" : cur_solo_arm == 4 ? "MOLLA D" : "SOLO D", c_grn_r,   c_grn_g,   c_grn_b);

  // ---- 3 · DYN EQ TONE & BALANCE ----
  p3_deq_act = (mon_sel == 3); p3_ton_act = (mon_sel == 4); p3_bal_act = (mon_sel == 5);
  p3_act = p3_deq_act || p3_ton_act || p3_bal_act;
  p3_deq_act ? ( p3_r = c_cyan_r;  p3_g = c_cyan_g;  p3_b = c_cyan_b; ) :
  p3_ton_act ? ( p3_r = c_amber_r; p3_g = c_amber_g; p3_b = c_amber_b; ) :
               ( p3_r = c_grn_r;   p3_g = c_grn_g;   p3_b = c_grn_b; );
  p3_next_mon = mon_sel == 3 ? 4 : mon_sel == 4 ? 5 : 3;
  draw_panel_hl(736, r1y, 348, 236, p3_act, p3_r, p3_g, p3_b);
  draw_group_title_ex(736, r1y, 348, 28, "3 · DYN EQ TONE & BALANCE", p3_r, p3_g, p3_b, p3_next_mon, p3_act);

  gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.45;
  g_line(746, r1y + 97, 1074, r1y + 97);
  g_line(746, r1y + 165, 1074, r1y + 165);

  ry0 = r1y + 30;
  draw_p3_row_bg(ry0, p3_deq_act, lkq_r, lkq_g, lkq_b, "DYN EQ", msg("Curva A-D", "Curve A-D"), 3, 26, 214);
  cur_mod = 3;
  ui_knob(28, 782, ry0 + 26, 18, 0, 100, 52, "", "%", lkq_r, lkq_g, lkq_b, 140, min(100, max(ui_deq_lo, ui_deq_hi) * 14));
  ui_link_btn(55, 912, ry0 + 4, gq_ref - gq_now, 157, lkq_r, lkq_g, lkq_b);
  ui_tab_btn(27, 0, 830,  ry0 + 29, 56, 26, "A", 141, lkq_r, lkq_g, lkq_b, 3);
  ui_tab_btn(27, 1, 892,  ry0 + 29, 56, 26, "B", 141, lkq_r, lkq_g, lkq_b, 3);
  ui_tab_btn(27, 2, 954,  ry0 + 29, 56, 26, "C", 141, lkq_r, lkq_g, lkq_b, 3);
  ui_tab_btn(27, 3, 1016, ry0 + 29, 56, 26, "D", 141, lkq_r, lkq_g, lkq_b, 3);

  ry1 = r1y + 98;
  draw_p3_row_bg(ry1, p3_ton_act, lkt_r, lkt_g, lkt_b, "TONE", msg("Curva A-D", "Curve A-D"), 4, 29, 215);
  cur_mod = 4;
  ui_knob(31, 782, ry1 + 26, 18, 0.2, 3.5, 1.56, "", "x", lkt_r, lkt_g, lkt_b, 142, -1);
  ui_link_btn(54, 912, ry1 + 4, gt_ref - gt_now, 159, lkt_r, lkt_g, lkt_b);
  ui_tab_btn(30, 0, 830,  ry1 + 29, 56, 26, "A", 143, lkt_r, lkt_g, lkt_b, 4);
  ui_tab_btn(30, 1, 892,  ry1 + 29, 56, 26, "B", 143, lkt_r, lkt_g, lkt_b, 4);
  ui_tab_btn(30, 2, 954,  ry1 + 29, 56, 26, "C", 143, lkt_r, lkt_g, lkt_b, 4);
  ui_tab_btn(30, 3, 1016, ry1 + 29, 56, 26, "D", 143, lkt_r, lkt_g, lkt_b, 4);

  ry2 = r1y + 166;
  draw_p3_row_bg(ry2, p3_bal_act, lkd_r, lkd_g, lkd_b, "DYN BAL", msg("Profilo A/B", "Profile A/B"), 5, 33, 217);
  cur_mod = 5;
  ui_knob(35, 782, ry2 + 26, 18, 0, 100, 31, "", "%", lkd_r, lkd_g, lkd_b, 144, dbal_act_pct);
  ui_link_btn(53, 912, ry2 + 4, gd_ref - gd_now, 158, lkd_r, lkd_g, lkd_b);
  ui_tab_btn(34, 0, 830, ry2 + 29, 118, 26, "A · NATURAL", 145, lkd_r, lkd_g, lkd_b, 5);
  ui_tab_btn(34, 1, 954, ry2 + 29, 118, 26, "B · DENSE",   145, lkd_r, lkd_g, lkd_b, 5);

  // ---- Isoletta dedicata: USCITA · OUTPUT ----
  out_y = r1y + 242; out_h = 118;
  p4_act = (mon_sel == 6);
  draw_panel_hl(736, out_y, 348, out_h, p4_act, c_grn_r, c_grn_g, c_grn_b);
  !p4_act ? (
    gfx_r = panel2_r; gfx_g = panel2_g; gfx_b = panel2_b; gfx_a = 0.45;
    g_rect(738, out_y + 24, 344, out_h - 26);
  );
  hit(736, out_y + 24, 348, out_h - 24) && mouse_click ? set_mon(6);
  draw_group_title_ex(736, out_y, 348, 24, msg("USCITA · OUTPUT", "OUTPUT STAGE"), c_grn_r, c_grn_g, c_grn_b, 6, p4_act);
  ui_ab_btn(892, out_y + 3, 24, "A", ab_on && ab_cur == 0, 1, 160) ? ( ab_on ? ab_go(0) : ab_start(); );
  ui_ab_btn(918, out_y + 3, 24, "B", ab_on && ab_cur == 1, 1, 160) ? ( ab_on ? ab_go(1) : ab_start(); );
  ui_ab_btn(944, out_y + 3, 36, "A=B", 0, ab_on, 161) ? ab_close();
  cur_mod = 6;
  ui_knob(36, 798,  out_y + 71, 21, 0, 100, 100, "MIX", "%", c_grn_r, c_grn_g, c_grn_b, 146, -1);
  ui_knob(37, 910,  out_y + 71, 21, -24, 24, 0, "OUTPUT", "dB", lko_r, lko_g, lko_b, 147, -1);
  ui_knob(41, 1022, out_y + 71, 21, -3.0, -0.1, -0.5, "PEAK CEIL", "dB", c_mag_r, c_mag_g, c_mag_b, 148, clamp(((lin2db(tp_meter_peak) + 18) / 18) * 100, 0, 100));
);

!mouse_down ? ( ui_hold_delta_stage = 0; );
drag_delta_stage = (ui_drag_id == 2 || ui_drag_id == 3) ? 1 :
                   (ui_drag_id == 6) ? 3 :
                   (ui_drag_id >= 10 && ui_drag_id <= 12) ? 4 :
                   (ui_drag_id >= 14 && ui_drag_id <= 16) ? 5 :
                   (ui_drag_id >= 18 && ui_drag_id <= 20) ? 6 :
                   (ui_drag_id >= 22 && ui_drag_id <= 24) ? 7 :
                   (ui_drag_id == 28) ? 8 :
                   (ui_drag_id == 31) ? 9 :
                   (ui_drag_id == 35) ? 10 :
                   (ui_drag_id == 1 || ui_drag_id == 36 || ui_drag_id == 37) ? 11 :
                   (ui_drag_id == 41) ? 12 : 0;
delta_spring_armed && mouse_down ? (
  delta_spring_stage = drag_delta_stage > 0 ? drag_delta_stage : ui_hold_delta_stage;
  delta_spring_stage > 0 ? ( delta_spring_time = time_now; delta_spring_aud_hb = time_now; );
) : (
  delta_spring_stage = 0;
);
drc_solo_audition_band > 0 ? ( drc_solo_aud_hb = time_now; );

// Avviso lampeggiante DELTA MODE / DELTA MOLLA in testata (con disattivazione rapida e auto-off 30s)
slider39 >= 0.5 ? (
  dp_hv = hit(586, 18, 212, 24);
  dp_hv ? ( active_info_id = 223; );
  dp_hv && mouse_click ? (
    set_param_slider(39, 0);
  ) : (
    (mouse_down || ui_drag_id > 0) ? ( delta_arm_time = time_now; );
    delta_rem = max(1, floor(30.9 - (time_now - delta_arm_time)));
    delta_blink ? ( gfx_r = 0.96; gfx_g = 0.20; gfx_b = 0.44; ) : ( gfx_r = 1.0; gfx_g = 0.62; gfx_b = 0.14; );
    gfx_a = 0.96; g_rect(586, 18, 212, 24);
    gfx_r = 1.0; gfx_g = 0.90; gfx_b = 0.65; gfx_a = dp_hv ? 1.0 : 0.75; g_frame(586, 18, 212, 24);
    gfx_setfont(6); gfx_r = 0.04; gfx_g = 0.05; gfx_b = 0.07; gfx_a = 1;
    sprintf(#dpill, "DELTA MODE (%ds)  [OFF]", delta_rem);
    g_txtc(692, 18 + (24 - g_th()) * 0.5, #dpill);
  );
) : delta_spring_stage > 0 ? (
  stg_nm = delta_spring_stage == 13 ? "HW INSERT" :
           delta_spring_stage == 1 ? "FILTERS" :
           delta_spring_stage == 2 ? "PREAMP" :
           delta_spring_stage == 3 ? "PEAK" :
           delta_spring_stage == 4 ? "DRC A" :
           delta_spring_stage == 5 ? "DRC B" :
           delta_spring_stage == 6 ? "DRC C" :
           delta_spring_stage == 7 ? "DRC D" :
           delta_spring_stage == 8 ? "DYN EQ" :
           delta_spring_stage == 9 ? "TONE" :
           delta_spring_stage == 10 ? "DYN BAL" :
           delta_spring_stage == 12 ? "LIMITER" : "GLOBAL";
  delta_blink ? ( gfx_r = 1.0; gfx_g = 0.58; gfx_b = 0.12; ) : ( gfx_r = 0.94; gfx_g = 0.24; gfx_b = 0.50; );
  gfx_a = 0.96; g_rect(586, 18, 212, 24);
  gfx_r = 1.0; gfx_g = 0.90; gfx_b = 0.65; gfx_a = 0.9; g_frame(586, 18, 212, 24);
  gfx_setfont(6); gfx_r = 0.04; gfx_g = 0.05; gfx_b = 0.07; gfx_a = 1;
  sprintf(#dpill, "DELTA: %s", stg_nm);
  g_txtc(692, 18 + (24 - g_th()) * 0.5, #dpill);
) : delta_spring_armed ? (
  dp_hv = hit(586, 18, 212, 24);
  dp_hv ? ( active_info_id = 224; );
  dp_hv && mouse_click ? (
    delta_spring_armed = 0; delta_spring_stage = 0; ui_hold_delta_stage = 0;
  ) : (
    sp_rem = max(1, floor(30.9 - (time_now - delta_spring_time)));
    gfx_r = show_simple ? 0.98 : 0.22; gfx_g = show_simple ? 0.90 : 0.14; gfx_b = show_simple ? 0.78 : 0.16; gfx_a = 0.96;
    g_rect(586, 18, 212, 24);
    gfx_r = dp_hv ? 1.0 : 0.95; gfx_g = 0.58; gfx_b = 0.18; gfx_a = 0.95; g_frame(586, 18, 212, 24);
    gfx_setfont(6);
    show_simple ? ( gfx_r = 0.30; gfx_g = 0.12; gfx_b = 0.06; ) : ( gfx_r = 1.0; gfx_g = 0.84; gfx_b = 0.42; );
    gfx_a = 1;
    sprintf(#dpill, msg("DELTA MOLLA (%ds)  [X]", "SPRING DELTA (%ds) [X]"), sp_rem);
    g_txtc(692, 18 + (24 - g_th()) * 0.5, #dpill);
  );
);

function jsfx_param_meta(idx) (
  p_min = 0; p_max = 1; p_def = 0; p_ro = 0; strcpy(#p_unit, "");
  idx == 1  ? ( strcpy(#p_nm, "1. Input Level");            p_min=-12;  p_max=12;    p_def=0;     strcpy(#p_unit, "dB"); ) :
  idx == 2  ? ( strcpy(#p_nm, "2. Lowcut Freq");            p_min=20;   p_max=250;   p_def=75;    strcpy(#p_unit, "Hz"); ) :
  idx == 3  ? ( strcpy(#p_nm, "3. Hicut Freq");             p_min=8000; p_max=20000; p_def=18000; strcpy(#p_unit, "Hz"); ) :
  idx == 4  ? ( strcpy(#p_nm, "4. Filter Engage");          p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 5  ? ( strcpy(#p_nm, "5. Preamp Engage");          p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 6  ? ( strcpy(#p_nm, "6. Peak Reduction");         p_min=0;    p_max=100;   p_def=45;    strcpy(#p_unit, "%"); ) :
  idx == 7  ? ( strcpy(#p_nm, "7. Peak Level Engage");      p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 8  ? ( strcpy(#p_nm, "8. DRC Master Engage");      p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 9  ? ( strcpy(#p_nm, "9. DRC A Engage");           p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 10 ? ( strcpy(#p_nm, "10. DRC A HiPass");          p_min=20;   p_max=20000; p_def=6529;  strcpy(#p_unit, "Hz"); ) :
  idx == 11 ? ( strcpy(#p_nm, "11. DRC A LowPass");         p_min=20;   p_max=20000; p_def=9788;  strcpy(#p_unit, "Hz"); ) :
  idx == 12 ? ( strcpy(#p_nm, "12. DRC A Threshold");       p_min=0;    p_max=100;   p_def=75.9;  strcpy(#p_unit, "%"); ) :
  idx == 13 ? ( strcpy(#p_nm, "13. DRC B Engage");          p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 14 ? ( strcpy(#p_nm, "14. DRC B HiPass");          p_min=20;   p_max=20000; p_def=233;   strcpy(#p_unit, "Hz"); ) :
  idx == 15 ? ( strcpy(#p_nm, "15. DRC B LowPass");         p_min=20;   p_max=20000; p_def=384;   strcpy(#p_unit, "Hz"); ) :
  idx == 16 ? ( strcpy(#p_nm, "16. DRC B Threshold");       p_min=0;    p_max=100;   p_def=59.7;  strcpy(#p_unit, "%"); ) :
  idx == 17 ? ( strcpy(#p_nm, "17. DRC C Engage");          p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 18 ? ( strcpy(#p_nm, "18. DRC C HiPass");          p_min=20;   p_max=20000; p_def=1456;  strcpy(#p_unit, "Hz"); ) :
  idx == 19 ? ( strcpy(#p_nm, "19. DRC C LowPass");         p_min=20;   p_max=20000; p_def=2641;  strcpy(#p_unit, "Hz"); ) :
  idx == 20 ? ( strcpy(#p_nm, "20. DRC C Threshold");       p_min=0;    p_max=100;   p_def=50.0;  strcpy(#p_unit, "%"); ) :
  idx == 21 ? ( strcpy(#p_nm, "21. DRC D Engage");          p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 22 ? ( strcpy(#p_nm, "22. DRC D HiPass");          p_min=20;   p_max=20000; p_def=5884;  strcpy(#p_unit, "Hz"); ) :
  idx == 23 ? ( strcpy(#p_nm, "23. DRC D LowPass");         p_min=20;   p_max=20000; p_def=9200;  strcpy(#p_unit, "Hz"); ) :
  idx == 24 ? ( strcpy(#p_nm, "24. DRC D Threshold");       p_min=0;    p_max=100;   p_def=0.0;   strcpy(#p_unit, "%"); ) :
  idx == 25 ? ( strcpy(#p_nm, "25. DRC Band Solo (Molla)"); p_min=0;    p_max=4;     p_def=0;     strcpy(#p_unit, "int"); ) :
  idx == 26 ? ( strcpy(#p_nm, "26. Dynamic EQ Engage");     p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 27 ? ( strcpy(#p_nm, "27. Dynamic EQ Curve (A-D)");p_min=0;    p_max=3;     p_def=2;     strcpy(#p_unit, "abcd"); ) :
  idx == 28 ? ( strcpy(#p_nm, "28. Dynamic EQ Threshold");  p_min=0;    p_max=100;   p_def=52.1;  strcpy(#p_unit, "%"); ) :
  idx == 29 ? ( strcpy(#p_nm, "29. Tone EQ Engage");        p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 30 ? ( strcpy(#p_nm, "30. Tone EQ Curve (A-D)");   p_min=0;    p_max=3;     p_def=3;     strcpy(#p_unit, "abcd"); ) :
  idx == 31 ? ( strcpy(#p_nm, "31. Tone EQ Gain Scale");    p_min=0.2;  p_max=3.5;   p_def=1.56;  strcpy(#p_unit, "x"); ) :
  idx == 32 ? ( strcpy(#p_nm, "32. Mid Bump Engage");       p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 33 ? ( strcpy(#p_nm, "33. Dynamic Balance Engage");p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 34 ? ( strcpy(#p_nm, "34. Dynamic Balance Mode");  p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "ab"); ) :
  idx == 35 ? ( strcpy(#p_nm, "35. Dynamic Balance Amount");p_min=0;    p_max=100;   p_def=31.1;  strcpy(#p_unit, "%"); ) :
  idx == 36 ? ( strcpy(#p_nm, "36. Parallel Mix Wet");      p_min=0;    p_max=100;   p_def=100;   strcpy(#p_unit, "%"); ) :
  idx == 37 ? ( strcpy(#p_nm, "37. Output Gain");           p_min=-24;  p_max=24;    p_def=0;     strcpy(#p_unit, "dB"); ) :
  idx == 38 ? ( strcpy(#p_nm, "38. Auto Gain Match");       p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 39 ? ( strcpy(#p_nm, "39. Delta (Solo Intervento)");p_min=0;   p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 40 ? ( strcpy(#p_nm, "40. Sample Peak Limiter");   p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 41 ? ( strcpy(#p_nm, "41. Sample Peak Ceiling");   p_min=-3.0; p_max=-0.1;  p_def=-0.5;  strcpy(#p_unit, "dBFS"); ) :
  idx == 42 ? ( strcpy(#p_nm, "42. UI Theme (Light/Dark)");  p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "int"); ) :
  idx == 43 ? ( strcpy(#p_nm, "43. View Mode (Full/Mini/JSFX)"); p_min=0; p_max=2;   p_def=0;     strcpy(#p_unit, "int"); ) :
  idx == 44 ? ( strcpy(#p_nm, "44. Preset Voce [OSARA]");   p_min=0;    p_max=7;     p_def=0;     strcpy(#p_unit, "int"); ) :
  idx == 45 ? ( strcpy(#p_nm, "45. [Read] Peak Leveler GR");p_min=0;    p_max=24;    p_def=0;     p_ro=1; strcpy(#p_unit, "dB"); ) :
  idx == 46 ? ( strcpy(#p_nm, "46. [Read] DRC Max Band GR");p_min=0;    p_max=24;    p_def=0;     p_ro=1; strcpy(#p_unit, "dB"); ) :
  idx == 47 ? ( strcpy(#p_nm, "47. [Read] DynEQ+DynBal Act");p_min=0;   p_max=100;   p_def=0;     p_ro=1; strcpy(#p_unit, "%"); ) :
  idx == 48 ? ( strcpy(#p_nm, "48. [Read] RMS In");         p_min=-60;  p_max=6;     p_def=-60;   p_ro=1; strcpy(#p_unit, "dBFS"); ) :
  idx == 49 ? ( strcpy(#p_nm, "49. [Read] RMS Out");        p_min=-60;  p_max=6;     p_def=-60;   p_ro=1; strcpy(#p_unit, "dBFS"); ) :
  idx == 50 ? ( strcpy(#p_nm, "50. [Read] Peak Limiter GR");p_min=0;    p_max=18;    p_def=0;     p_ro=1; strcpy(#p_unit, "dB"); ) :
  idx == 51 ? ( strcpy(#p_nm, "51. Barra Suggerimenti");    p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 52 ? ( strcpy(#p_nm, "52. Monitor Modulo");        p_min=0;    p_max=6;     p_def=2;     strcpy(#p_unit, "int"); ) :
  idx == 53 ? ( strcpy(#p_nm, "53. DynBal Link Output");    p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 54 ? ( strcpy(#p_nm, "54. Tone EQ Link Output");   p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 55 ? ( strcpy(#p_nm, "55. Dyn EQ Link Output");    p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 56 ? ( strcpy(#p_nm, "56. Peak Link Output");      p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 57 ? ( strcpy(#p_nm, "57. Hardware Insert (Glue)");p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
              ( strcpy(#p_nm, "58. Hardware Character");    p_min=0;    p_max=4;     p_def=0;     strcpy(#p_unit, "hwprof"); );
);

view_mode == 2 ? (
  j_y = 132; j_h = max(360, bars_top_d - 10 - j_y);
  draw_panel(16, j_y, 1068, j_h);
  draw_group_title(16, j_y, 1068, "JSFX VIEW · LISTA PARAMETRI SCORREVOLE (USA ROTELLA O BARRA A DESTRA · FULL/MINI IN ALTO PER USCIRE)", c_grn_r, c_grn_g, c_grn_b, -1);

  row_h = 28;
  vis_rows = max(8, floor((j_h - 46) / row_h));
  max_scroll = max(0, 58 - vis_rows);
  mouse_wheel != 0 ? (
    jsfx_scroll = clamp(jsfx_scroll - sign(mouse_wheel) * 3, 0, max_scroll);
    mouse_wheel = 0;
  );
  jsfx_scroll = clamp(jsfx_scroll, 0, max_scroll);

  // Scrollbar verticale a destra
  sb_x = 1060; sb_y = j_y + 38; sb_w = 14; sb_h = j_h - 48;
  gfx_r = 0.06; gfx_g = 0.08; gfx_b = 0.12; gfx_a = 1; g_rect(sb_x, sb_y, sb_w, sb_h);
  thumb_h = max(28, sb_h * vis_rows / 58);
  thumb_y = sb_y + (max_scroll > 0 ? (jsfx_scroll / max_scroll) * (sb_h - thumb_h) : 0);
  sb_hov = hit(sb_x - 4, sb_y, sb_w + 8, sb_h);
  sb_hov && mouse_click ? ui_drag_id = 999;
  ui_drag_id == 999 && mouse_down ? (
    jsfx_scroll = floor(clamp((myd - sb_y - thumb_h * 0.5) / max(1, sb_h - thumb_h), 0, 1) * max_scroll + 0.5);
  ) : ( ui_drag_id == 999 && !mouse_down ? ui_drag_id = 0; );
  gfx_r = c_grn_r; gfx_g = c_grn_g; gfx_b = c_grn_b; gfx_a = (sb_hov || ui_drag_id == 999) ? 0.95 : 0.7;
  g_rect(sb_x + 2, thumb_y, sb_w - 4, thumb_h);

  ri = 0;
  loop(vis_rows,
    p_idx = floor(jsfx_scroll + 0.5) + ri + 1;
    p_idx <= 58 ? (
      jsfx_param_meta(p_idx);
      ry = j_y + 38 + ri * row_h;
      ri % 2 == 0 ? ( gfx_r = panel2_r; gfx_g = panel2_g; gfx_b = panel2_b; gfx_a = 0.45; g_rect(26, ry, 1026, row_h - 2); );
      gfx_setfont(5); set_text_col();
      g_txt(36, ry + 5, #p_nm);

      // Barra slider interattiva
      bx0 = 370; bw0 = 490; by0 = ry + 6; bh0 = row_h - 14;
      pval = slider(p_idx);
      pnorm = clamp((pval - p_min) / max(0.0001, p_max - p_min), 0, 1);
      gfx_r = 0.06; gfx_g = 0.08; gfx_b = 0.12; gfx_a = 1; g_rect(bx0, by0, bw0, bh0);
      gfx_r = p_ro ? c_mag_r : c_cyan_r; gfx_g = p_ro ? c_mag_g : c_cyan_g; gfx_b = p_ro ? c_mag_b : c_cyan_b;
      gfx_a = p_ro ? 0.65 : 0.85;
      g_rect(bx0, by0, max(2, pnorm * bw0), bh0);
      gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.7; g_frame(bx0, by0, bw0, bh0);

      r_hov = !p_ro && hit(bx0, ry, bw0, row_h);
      r_hov && mouse_click ? (
        strcmp(#p_unit, "bool") == 0 ? (
          set_param_slider(p_idx, pval >= 0.5 ? 0 : 1);
          update_dsp_params();
        ) : (
          ui_drag_id = 500 + p_idx;
        );
      );
      r_hov && mouse_right_click ? ( set_param_slider(p_idx, p_def); update_dsp_params(); );
      ui_drag_id == (500 + p_idx) && mouse_down ? (
        nn = clamp((mxd - bx0) / bw0, 0, 1);
        nv = p_min + nn * (p_max - p_min);
        (strcmp(#p_unit, "int") == 0 || strcmp(#p_unit, "abcd") == 0 || strcmp(#p_unit, "ab") == 0 || strcmp(#p_unit, "hwprof") == 0 || strcmp(#p_unit, "Hz") == 0) ? nv = floor(nv + 0.5);
        p_idx == 43 ? set_ui_state(43, nv) : set_param_slider(p_idx, nv);
        update_dsp_params();
      ) : ( ui_drag_id == (500 + p_idx) && !mouse_down ? ui_drag_id = 0; );

      // Valore formattato a destra
      strcmp(#p_unit, "bool") == 0 ? strcpy(#pv_s, pval >= 0.5 ? "ON" : "OFF") :
      strcmp(#p_unit, "abcd") == 0 ? ( c_i = floor(pval + 0.5); strcpy(#pv_s, c_i == 0 ? "Curva A" : c_i == 1 ? "Curva B" : c_i == 2 ? "Curva C" : "Curva D"); ) :
      strcmp(#p_unit, "ab") == 0   ? ( c_i = floor(pval + 0.5); strcpy(#pv_s, c_i == 0 ? "A · Natural" : "B · Dense"); ) :
      strcmp(#p_unit, "hwprof") == 0 ? ( c_i = floor(pval + 0.5); strcpy(#pv_s, c_i == 0 ? "GLUE (MagicFlow)" : c_i == 1 ? "VOXBOX (Tube)" : c_i == 2 ? "NEVE (1073)" : c_i == 3 ? "VCA (Console)" : "TAPE (15 IPS)"); ) :
      strcmp(#p_unit, "int") == 0  ? sprintf(#pv_s, "%.0f", pval) :
      strcmp(#p_unit, "Hz") == 0   ? sprintf(#pv_s, "%.0f Hz", pval) :
                                     sprintf(#pv_s, "%.2f %s", pval, #p_unit);
      set_text_col(); g_txtr(1042, ry + 5, #pv_s);
    );
    ri += 1;
  );
);

// ============================================================================
// MONITOR (FULL e MINI)
// ============================================================================
view_mode != 2 ? (
  mon_y = view_mode == 0 ? 504 : 132;
  mon_h = max(242, bars_top_d - 10 - mon_y);
  draw_panel(16, mon_y, 1068, mon_h);
  mon_name = mon_sel == 0 ? "INSERT · FILTER · PREAMP" : mon_sel == 1 ? "PEAK LEVELER (OPTO + RCOMP)" : mon_sel == 2 ? "DRC" :
             mon_sel == 3 ? "DYNAMIC EQ" : mon_sel == 4 ? "TONE EQ + MID BUMP" : mon_sel == 5 ? "DYNAMIC BALANCE" : "OUTPUT";
  sprintf(#mt, "MONITOR · %s", mon_name);
  draw_group_title(16, mon_y, 1068, #mt, c_cyan_r, c_cyan_g, c_cyan_b, -1);

  tx = 30; ty = mon_y + 34;
  ui_tab_btn(52, 0, tx,       ty, 84, 24, "FILTER",  230, c_cyan_r,  c_cyan_g,  c_cyan_b, -1);
  ui_tab_btn(52, 1, tx + 90,  ty, 84, 24, "PEAK",    230, c_amber_r, c_amber_g, c_amber_b, -1);
  ui_tab_btn(52, 2, tx + 180, ty, 84, 24, "DRC",     233, c_mag_r,   c_mag_g,   c_mag_b, -1);
  ui_tab_btn(52, 3, tx + 270, ty, 84, 24, "DYN EQ",  230, c_cyan_r,  c_cyan_g,  c_cyan_b, -1);
  ui_tab_btn(52, 4, tx + 360, ty, 84, 24, "TONE",    230, c_amber_r, c_amber_g, c_amber_b, -1);
  ui_tab_btn(52, 5, tx + 450, ty, 84, 24, "DYN BAL", 230, c_grn_r,   c_grn_g,   c_grn_b, -1);
  ui_tab_btn(52, 6, tx + 540, ty, 84, 24, "OUTPUT",  230, c_grn_r,   c_grn_g,   c_grn_b, -1);

  d_x = 30; d_y = mon_y + 66; d_w = 700; d_h = mon_h - 76; fy = d_h / 166;

  mon_sel == 0 ? (
    // ---- INSERT + FILTER + PREAMP: curva combinata reale ----
    mon_frame(c_cyan_r, c_cyan_g, c_cyan_b);
    draw_freq_grid();
    draw_db_line(3, -24, 6, "+3"); draw_db_line(0, -24, 6, "0"); draw_db_line(-12, -24, 6, "-12"); draw_db_line(-24, -24, 6, "-24");
    draw_curve(0, -24, 6, c_cyan_r + 0.2, c_cyan_g + 0.1, 1);
    gfx_setfont(6); gfx_r = 0.62; gfx_g = 0.82; gfx_b = 1; gfx_a = 1;
    fmt_freq(#fa, slider2); fmt_freq(#fb, slider3);
    sprintf(#ft, "LOW CUT %s Hz", #fa); g_txt(d_x + 40, d_y + 8, #ft);
    st1_any = (slider57 >= 0.5) || (slider5 >= 0.5) || (slider4 >= 0.5);
    hw_pnm = floor(slider58 + 0.5) == 0 ? "GLUE" : floor(slider58 + 0.5) == 1 ? "VOXBOX" : floor(slider58 + 0.5) == 2 ? "NEVE" : floor(slider58 + 0.5) == 3 ? "VCA" : "TAPE";
    gfx_r = st1_any ? 0.55 : 1; gfx_g = st1_any ? 0.88 : 0.5; gfx_b = st1_any ? 1 : 0.4;
    sprintf(#st1_m, "[%s]  INS %s · PRE %s · FLT %s", hw_pnm, slider57 >= 0.5 ? "ON" : "OFF", slider5 >= 0.5 ? "ON" : "OFF", slider4 >= 0.5 ? "ON" : "OFF");
    g_txtc(d_x + d_w * 0.5, d_y + 8, #st1_m);
    gfx_r = 0.62; gfx_g = 0.82; gfx_b = 1;
    sprintf(#ft, "HIGH CUT %s Hz", #fb); g_txtr(d_x + d_w - 20, d_y + 8, #ft);
  ) : mon_sel == 1 ? (
    // ---- PEAK: riduzioni Opto / RComp ----
    mon_frame(c_amber_r, c_amber_g, c_amber_b);
    gfx_setfont(6); gfx_r = 1; gfx_g = 0.82; gfx_b = 0.5; gfx_a = 1;
    sprintf(#pt, "SOGLIA %.1f dBFS   ·   PEAK RED %.0f%%   ·   %s", ui_pk_thr_db, slider6, slider7 >= 0.5 ? "ENGAGED" : "BYPASSED");
    g_txt(d_x + 18, d_y + 10 * fy, #pt);
    hbar_lvl(d_y + 38 * fy, "LIVELLO", max(-60, ui_pk_lvl_db), -48, 0, 0.45, 0.6, 1.0, ui_pk_thr_db);
    hbar_gr(d_y + 66 * fy, "OPTO", ui_gr_opt, 12, 0.55, 0.35, 0.95);
    hbar_gr(d_y + 92 * fy, "RCOMP", ui_gr_rc, 12, 0.90, 0.25, 0.45);
    hbar_gr(d_y + 118 * fy, "TOTALE", ui_peak_gr_db, 12, c_amber_r, c_amber_g, c_amber_b);
    gr_scale(d_y + 142 * fy, 12);
  ) : mon_sel == 2 ? (
    // ---- DRC: curve a campana SVF reali sullo spettro (0..-12 dB) ----
    mon_frame(c_mag_r, c_mag_g, c_mag_b);
    draw_freq_grid();
    draw_db_line(0, -12, 0, "0"); draw_db_line(-3, -12, 0, "-3"); draw_db_line(-6, -12, 0, "-6");
    draw_db_line(-9, -12, 0, "-9"); draw_db_line(-12, -12, 0, "-12");
    drc_on = slider8 >= 0.5;
    sprintf(#rA, "A·%s", band_role(slider10, slider11));
    sprintf(#rB, "B·%s", band_role(slider14, slider15));
    sprintf(#rC, "C·%s", band_role(slider18, slider19));
    sprintf(#rD, "D·%s", band_role(slider22, slider23));
    band_gr(slider10, slider11, ui_drcA, 12, drc_on && slider9 >= 0.5,  #rA, 0, c_cyan_r,  c_cyan_g,  c_cyan_b);
    band_gr(slider14, slider15, ui_drcB, 12, drc_on && slider13 >= 0.5, #rB, 1, c_amber_r, c_amber_g, c_amber_b);
    band_gr(slider18, slider19, ui_drcC, 12, drc_on && slider17 >= 0.5, #rC, 2, c_mag_r,   c_mag_g,   c_mag_b);
    band_gr(slider22, slider23, ui_drcD, 12, drc_on && slider21 >= 0.5, #rD, 3, c_grn_r,   c_grn_g,   c_grn_b);

    // Curva somma complessiva quando 2+ bande stanno attenuando insieme
    drc_on ? (
      drc_act_cnt = ((slider9 >= 0.5 && ui_drcA > 0.1) ? 1 : 0) + ((slider13 >= 0.5 && ui_drcB > 0.1) ? 1 : 0)
                  + ((slider17 >= 0.5 && ui_drcC > 0.1) ? 1 : 0) + ((slider21 >= 0.5 && ui_drcD > 0.1) ? 1 : 0);
      drc_act_cnt >= 2 ? (
        drc_srm = max(22050, srate);
        d_px = -1; d_i = 0;
        loop(141,
          d_f = 20 * 10 ^ (3 * d_i / 140);
          d_f < drc_srm * 0.48 ? (
            d_tot = 0;
            slider9  >= 0.5 && ui_drcA > 0.1 ? ( d_tot += drc_band_mag_db(d_f, min(sqrt(min(slider10,slider11)*max(slider10,slider11)), drc_srm*0.44), clamp(min(sqrt(min(slider10,slider11)*max(slider10,slider11)), drc_srm*0.44)/max(20,abs(slider11-slider10)),0.5,12.0), 1.0 - db2lin(-clamp(ui_drcA,0,12)), drc_srm); );
            slider13 >= 0.5 && ui_drcB > 0.1 ? ( d_tot += drc_band_mag_db(d_f, min(sqrt(min(slider14,slider15)*max(slider14,slider15)), drc_srm*0.44), clamp(min(sqrt(min(slider14,slider15)*max(slider14,slider15)), drc_srm*0.44)/max(20,abs(slider15-slider14)),0.5,12.0), 1.0 - db2lin(-clamp(ui_drcB,0,12)), drc_srm); );
            slider17 >= 0.5 && ui_drcC > 0.1 ? ( d_tot += drc_band_mag_db(d_f, min(sqrt(min(slider18,slider19)*max(slider18,slider19)), drc_srm*0.44), clamp(min(sqrt(min(slider18,slider19)*max(slider18,slider19)), drc_srm*0.44)/max(20,abs(slider19-slider18)),0.5,12.0), 1.0 - db2lin(-clamp(ui_drcC,0,12)), drc_srm); );
            slider21 >= 0.5 && ui_drcD > 0.1 ? ( d_tot += drc_band_mag_db(d_f, min(sqrt(min(slider22,slider23)*max(slider22,slider23)), drc_srm*0.44), clamp(min(sqrt(min(slider22,slider23)*max(slider22,slider23)), drc_srm*0.44)/max(20,abs(slider23-slider22)),0.5,12.0), 1.0 - db2lin(-clamp(ui_drcD,0,12)), drc_srm); );
            d_x1 = fx_map(d_f); d_y1 = dbv_map(d_tot, -12, 0);
            d_px >= 0 ? ( gfx_r = 0.94; gfx_g = 0.97; gfx_b = 1.0; gfx_a = 0.85; g_line(d_px, d_py, d_x1, d_y1); );
            d_px = d_x1; d_py = d_y1;
          );
          d_i += 1;
        );
      );
    );

    gfx_setfont(7);
    drc_solo_audition_band > 0 ? (
      gfx_r = 1.0; gfx_g = 0.76; gfx_b = 0.22; gfx_a = 1;
      sprintf(#mwrn, "PREASCOLTO ATTIVO BANDA %s (rilascia il mouse per tornare alla voce intera)",
              drc_solo_audition_band == 1 ? "A" : drc_solo_audition_band == 2 ? "B" : drc_solo_audition_band == 3 ? "C" : "D");
      g_txt(d_x + 40, d_y + 7, #mwrn);
    ) : (
      gfx_r = 0.62; gfx_g = 0.70; gfx_b = 0.9; gfx_a = 0.9;
      g_txt(d_x + 40, d_y + 7, msg("campana SVF reale (0..-12 dB)  ·  SOLO a molla: suona mentre tocchi THR / FREQ / OCT", "real SVF bell (0..-12 dB)  ·  Spring SOLO: auditions while touching THR / FREQ / OCT"));
    );
  ) : mon_sel == 3 ? (
    // ---- DYNAMIC EQ (Curva reale 5-Band SVF centrata & zoomabile: ±5 / ±12 dB) ----
    mon_frame(c_cyan_r, c_cyan_g, c_cyan_b);
    draw_freq_grid();
    deq_on = slider26 >= 0.5 && slider28 > 0.1;
    deq_z_hv = hit(d_x + d_w - 76, d_y + 4, 68, 16);
    deq_z_hv ? ( active_info_id = 234; );
    deq_z_hv && mouse_click ? ( deq_mon_zoom = !deq_mon_zoom; );
    deq_rng = deq_mon_zoom ? 12.0 : 5.0;
    deq_top = d_y + 42;
    deq_bot = d_y + d_h - 26;
    deq_mid = (deq_top + deq_bot) * 0.5;
    deq_half = (deq_bot - deq_top) * 0.5;
    // Confini delle 5 bande + riferimento lift a riposo
    gi = 0;
    loop(4,
      bfz = gi == 0 ? 105 : gi == 1 ? 460 : gi == 2 ? 1450 : 5600;
      gfx_r = c_cyan_r; gfx_g = c_cyan_g; gfx_b = c_cyan_b; gfx_a = 0.16;
      g_line(fx_map(bfz), deq_top, fx_map(bfz), deq_bot);
      gi += 1;
    );
    deq_on && deq_lift0 > 0.1 ? (
      gy_l0 = deq_mid - (clamp(deq_lift0, -deq_rng, deq_rng) / deq_rng) * deq_half;
      gfx_r = c_grn_r; gfx_g = c_grn_g; gfx_b = c_grn_b; gfx_a = 0.28;
      g_line(d_x + 34, gy_l0, d_x + d_w - 18, gy_l0);
    );
    gi = 0;
    loop(5,
      ldb = deq_mon_zoom ? (12 - gi * 6) : (4 - gi * 2);
      gy = deq_mid - (ldb / deq_rng) * deq_half;
      gfx_r = 0.55; gfx_g = 0.62; gfx_b = 0.85; gfx_a = ldb == 0 ? 0.65 : 0.22;
      g_line(d_x + 34, gy, d_x + d_w - 18, gy);
      gfx_setfont(7); gfx_a = ldb == 0 ? 0.95 : 0.80;
      ldb > 0 ? sprintf(#dgl, "+%d", ldb) : sprintf(#dgl, "%d", ldb);
      g_txtr(d_x + 30, gy - 6, #dgl);
      gi += 1;
    );
    // Curva complessa reale 5-Band SVF
    deq_srm = max(22050, srate);
    dg_0 = deq_on ? db2lin(ui_deq0) : 1.0;
    dg_1 = deq_on ? db2lin(ui_deq1) : 1.0;
    dg_2 = deq_on ? db2lin(ui_deq2) : 1.0;
    dg_3 = deq_on ? db2lin(ui_deq3) : 1.0;
    dg_4 = deq_on ? db2lin(ui_deq4) : 1.0;
    deq_px = -1; deq_i = 0;
    loop(161,
      deq_f = 20 * 10 ^ (3 * deq_i / 160);
      deq_f < deq_srm * 0.48 ? (
        deq_db = deq_mag_db(deq_f, dg_0, dg_1, dg_2, dg_3, dg_4, deq_srm);
        deq_xc = fx_map(deq_f);
        deq_yc = deq_mid - (clamp(deq_db, -deq_rng, deq_rng) / deq_rng) * deq_half;
        deq_px >= 0 ? (
          gfx_r = deq_db >= 0 ? c_grn_r : c_cyan_r;
          gfx_g = deq_db >= 0 ? c_grn_g : c_cyan_g;
          gfx_b = deq_db >= 0 ? c_grn_b : c_cyan_b;
          gfx_a = deq_on ? 0.30 : 0.08;
          g_line(deq_px, deq_py, deq_px, deq_mid);
          abs(deq_db) > deq_rng ? ( gfx_r = c_amber_r; gfx_g = c_amber_g; gfx_b = c_amber_b; );
          gfx_a = deq_on ? 0.98 : 0.42;
          g_line(deq_px, deq_py, deq_xc, deq_yc);
          g_line(deq_px, deq_py + 1 / sc, deq_xc, deq_yc + 1 / sc);
        );
        deq_px = deq_xc; deq_py = deq_yc;
      );
      deq_i += 1;
    );
    bi = 0;
    loop(5,
      bfa = bi == 0 ? 20  : bi == 1 ? 105 : bi == 2 ? 460  : bi == 3 ? 1450 : 5600;
      bfb = bi == 0 ? 105 : bi == 1 ? 460 : bi == 2 ? 1450 : bi == 3 ? 5600 : 20000;
      bgv = bi == 0 ? ui_deq0 : bi == 1 ? ui_deq1 : bi == 2 ? ui_deq2 : bi == 3 ? ui_deq3 : ui_deq4;
      b_nm = bi == 0 ? "SUB" : bi == 1 ? "BODY" : bi == 2 ? "PIVOT" : bi == 3 ? "BITE" : "AIR";
      bxa = fx_map(bfa) + 2; bxb = fx_map(bfb) - 2;
      gfx_setfont(7);
      gfx_r = bgv >= 0 ? c_grn_r : c_cyan_r;
      gfx_g = bgv >= 0 ? c_grn_g : c_cyan_g;
      gfx_b = bgv >= 0 ? c_grn_b : c_cyan_b;
      gfx_a = deq_on ? 0.98 : 0.45;
      sprintf(#dbl, "%s %+.1f", b_nm, bgv);
      g_txtc((bxa + bxb) * 0.5, d_y + 23, #dbl);
      bi += 1;
    );
    dq = floor(slider27 + 0.5);
    sprintf(#dt, "CURVA %s (SVF 5-Band Reale)  ·  THR %.1f%%  ·  verde = lift, azzurro = taglio", dq == 0 ? "A" : dq == 1 ? "B" : dq == 2 ? "C" : "D", slider28);
    gfx_setfont(7); gfx_r = 0.62; gfx_g = 0.70; gfx_b = 0.9; gfx_a = 0.95; g_txt(d_x + 40, d_y + 7, #dt);
    btn_face(d_x + d_w - 76, d_y + 4, 68, 16, deq_mon_zoom ? "±12 dB" : "±5 dB", 0, deq_z_hv, c_cyan_r, c_cyan_g, c_cyan_b);
  ) : mon_sel == 4 ? (
    // ---- TONE EQ: curva reale ----
    mon_frame(c_amber_r, c_amber_g, c_amber_b);
    draw_freq_grid();
    draw_db_line(12, -12, 12, "+12"); draw_db_line(6, -12, 12, "+6"); draw_db_line(0, -12, 12, "0");
    draw_db_line(-6, -12, 12, "-6"); draw_db_line(-12, -12, 12, "-12");
    draw_curve(1, -12, 12, 1, 0.70, 0.25);
    tq = floor(slider30 + 0.5);
    sprintf(#tt, "TONE %s  ·  SCALE %.2fx  ·  MID BUMP %s", tq == 0 ? "A" : tq == 1 ? "B" : tq == 2 ? "C" : "D", slider31, slider32 >= 0.5 ? "ON" : "OFF");
    gfx_setfont(6); gfx_r = 1; gfx_g = 0.82; gfx_b = 0.5; gfx_a = slider29 >= 0.5 ? 1 : 0.5; g_txt(d_x + 40, d_y + 8, #tt);
  ) : mon_sel == 5 ? (
    // ---- DYNAMIC BALANCE: curva EQ reale 3-bande (zoomabile ±6 / ±12 dB) + barre energia/target ----
    mon_frame(c_grn_r, c_grn_g, c_grn_b);
    draw_freq_grid();
    dbal_on = slider33 >= 0.5 && slider35 > 0.1;
    dbal_z_hv = hit(d_x + d_w - 76, d_y + 4, 68, 16);
    dbal_z_hv ? ( active_info_id = 235; );
    dbal_z_hv && mouse_click ? ( dbal_mon_zoom = !dbal_mon_zoom; );
    dbal_rng = dbal_mon_zoom ? 12.0 : 6.0;
    dbal_top = d_y + 48;
    dbal_bot = d_y + d_h - 26;
    dbal_mid = (dbal_top + dbal_bot) * 0.5;
    dbal_half = (dbal_bot - dbal_top) * 0.5;
    gfx_r = c_grn_r; gfx_g = c_grn_g; gfx_b = c_grn_b; gfx_a = 0.22;
    g_line(fx_map(280), dbal_top, fx_map(280), dbal_bot);
    g_line(fx_map(2800), dbal_top, fx_map(2800), dbal_bot);
    gi = 0;
    loop(5,
      ldb = dbal_mon_zoom ? (12 - gi * 6) : (6 - gi * 3);
      gy = dbal_mid - (ldb / dbal_rng) * dbal_half;
      gfx_r = 0.55; gfx_g = 0.62; gfx_b = 0.85; gfx_a = ldb == 0 ? 0.65 : 0.22;
      g_line(d_x + 34, gy, d_x + d_w - 18, gy);
      gfx_setfont(7); gfx_a = ldb == 0 ? 0.95 : 0.80;
      ldb > 0 ? sprintf(#dblg, "+%d", ldb) : sprintf(#dblg, "%d", ldb);
      g_txtr(d_x + 30, gy - 6, #dblg);
      gi += 1;
    );
    db_srm = max(22050, srate);
    db_gl = dbal_on ? ui_dbal_glo  : 1.0;
    db_gm = dbal_on ? ui_dbal_gmid : 1.0;
    db_gh = dbal_on ? ui_dbal_ghi  : 1.0;
    db_px = -1; db_i = 0;
    loop(161,
      db_f = 20 * 10 ^ (3 * db_i / 160);
      db_f < db_srm * 0.48 ? (
        db_val = dbal_mag_db(db_f, db_gl, db_gm, db_gh, db_srm);
        db_xc = fx_map(db_f);
        db_yc = dbal_mid - (clamp(db_val, -dbal_rng, dbal_rng) / dbal_rng) * dbal_half;
        db_px >= 0 ? (
          gfx_r = db_val >= 0 ? c_grn_r : c_cyan_r;
          gfx_g = db_val >= 0 ? c_grn_g : c_cyan_g;
          gfx_b = db_val >= 0 ? c_grn_b : c_cyan_b;
          gfx_a = dbal_on ? 0.30 : 0.08;
          g_line(db_px, db_py, db_px, dbal_mid);
          abs(db_val) > dbal_rng ? ( gfx_r = c_amber_r; gfx_g = c_amber_g; gfx_b = c_amber_b; );
          gfx_a = dbal_on ? 0.98 : 0.42;
          g_line(db_px, db_py, db_xc, db_yc);
          g_line(db_px, db_py + 1 / sc, db_xc, db_yc + 1 / sc);
        );
        db_px = db_xc; db_py = db_yc;
      );
      db_i += 1;
    );
    i = 0;
    loop(3,
      fa = i == 0 ? 20 : i == 1 ? 280 : 2800;
      fb = i == 0 ? 280 : i == 1 ? 2800 : 20000;
      shv = i == 0 ? ui_sh_lo : i == 1 ? ui_sh_mid : ui_sh_hi;
      tgv = i == 0 ? t_lo : i == 1 ? t_mid : t_hi;
      gv  = i == 0 ? ui_dbal_glo : i == 1 ? ui_dbal_gmid : ui_dbal_ghi;
      gdb = dbal_on ? lin2db(gv) : 0;
      xa = fx_map(fa) + 6; xb = fx_map(fb) - 6;
      bw3 = xb - xa;
      gfx_setfont(7); gfx_r = 0.88; gfx_g = 0.98; gfx_b = 0.92; gfx_a = 0.95;
      sprintf(#bt, "%s %.0f%%/%.0f%% (%+.1f)", i == 0 ? "LOW" : i == 1 ? "MID" : "HIGH", shv * 100, tgv * 100, gdb);
      g_txtc((xa + xb) * 0.5, d_y + 21, #bt);
      gfx_r = 0.08; gfx_g = 0.14; gfx_b = 0.18; gfx_a = 0.95; g_rect(xa + 4, d_y + 36, bw3 - 8, 4);
      gfx_r = c_grn_r; gfx_g = c_grn_g; gfx_b = c_grn_b; gfx_a = 0.92;
      g_rect(xa + 4, d_y + 36, clamp(shv / 0.7, 0, 1) * (bw3 - 8), 4);
      tx_mk = xa + 4 + clamp(tgv / 0.7, 0, 1) * (bw3 - 8);
      gfx_r = 1; gfx_g = 0.86; gfx_b = 0.30; gfx_a = 1; g_rect(tx_mk - 1, d_y + 34, 2, 8);
      i += 1;
    );
    sprintf(#dt_b, dbal_on ? "DYN BAL %s (Curva Reale)  ·  %.0f%%  ·  verde = boost, azzurro = taglio"
                           : "BYPASSED: solo analisi energia vs target",
            slider34 >= 0.5 ? "B·DENSE" : "A·NATURAL", slider35);
    gfx_setfont(7); gfx_r = 0.62; gfx_g = 0.70; gfx_b = 0.9; gfx_a = 0.95;
    g_txt(d_x + 40, d_y + 7, #dt_b);
    btn_face(d_x + d_w - 76, d_y + 4, 68, 16, dbal_mon_zoom ? "±12 dB" : "±6 dB", 0, dbal_z_hv, c_grn_r, c_grn_g, c_grn_b);
  ) : (
    // ---- OUTPUT ----
    mon_frame(c_grn_r, c_grn_g, c_grn_b);
    hbar_lvl(d_y + 22 * fy, "RMS IN", ui_rms_in_db, -60, 0, c_cyan_r, c_cyan_g, c_cyan_b, -100);
    hbar_lvl(d_y + 48 * fy, "RMS OUT", ui_rms_out_db, -60, 0, c_grn_r, c_grn_g, c_grn_b, -100);
    hbar_lvl(d_y + 74 * fy, "SAMPLE PEAK", max(-60, lin2db(tp_meter_peak)), -36, 0, c_mag_r, c_mag_g, c_mag_b, slider41);
    hbar_lvl(d_y + 100 * fy, "GAIN MATCH", ui_gm_db, -6, 6, c_amber_r, c_amber_g, c_amber_b, 0);
    hbar_gr(d_y + 126 * fy, "LIMITER", ui_tp_gr_db, 12, c_mag_r, c_mag_g, c_mag_b);
  );

  // ---- Telemetria fissa a destra ----
  tl = 748; tm = 846; tw2 = 148; tvr = 1070;
  i = 0;
  loop(6,
    yy = mon_y + 40 + i * max(32, (mon_h - 60) / 6);
    gfx_setfont(5); set_sub_col();
    lbl_t = i == 0 ? "RMS In" : i == 1 ? "RMS Out" : i == 2 ? "Peak GR" : i == 3 ? "DRC max" : i == 4 ? "DynBal" : "Limit GR";
    g_txt(tl, yy - 2, lbl_t);
    i == 0 ? ( pc = clamp((ui_rms_in_db + 60) / 0.66, 0, 100);  sprintf(#tv, "%.1f dB", ui_rms_in_db);  draw_meter_h(tm, yy, tw2, 12, pc, c_cyan_r, c_cyan_g, c_cyan_b); );
    i == 1 ? ( pc = clamp((ui_rms_out_db + 60) / 0.66, 0, 100); sprintf(#tv, "%.1f dB", ui_rms_out_db); draw_meter_h(tm, yy, tw2, 12, pc, c_grn_r, c_grn_g, c_grn_b); );
    i == 2 ? ( fmt_gr(#tv, ui_peak_gr_db); draw_meter_h(tm, yy, tw2, 12, min(100, ui_peak_gr_db * 7), c_amber_r, c_amber_g, c_amber_b); );
    i == 3 ? ( fmt_gr(#tv, ui_drc_gr_db);  draw_meter_h(tm, yy, tw2, 12, min(100, ui_drc_gr_db * 8), c_mag_r, c_mag_g, c_mag_b); );
    i == 4 ? ( sprintf(#tv, "%.0f%%", dbal_act_pct);     draw_meter_h(tm, yy, tw2, 12, dbal_act_pct, c_grn_r, c_grn_g, c_grn_b); );
    i == 5 ? ( fmt_gr(#tv, ui_tp_gr_db);   draw_meter_h(tm, yy, tw2, 12, min(100, ui_tp_gr_db * 10), c_mag_r, c_mag_g, c_mag_b); );
    gfx_setfont(5); set_text_col(); g_txtr(tvr, yy - 2, #tv);
    i += 1;
  );
);

// ============================================================================
// ANALISI -> SUGGERIMENTI (solo lettura della telemetria)
// ============================================================================
function add_sug(s) (
  sug_n == 0 ? strcpy(#sug1, s) : sug_n == 1 ? strcpy(#sug2, s);
  sug_n += 1;
);
function check_drc_hi(eng, gr, fa, fb, letter) (
  eng && gr > 6.0 ? (
    fmt_freq(#sfa, min(fa, fb)); fmt_freq(#sfb, max(fa, fb));
    sprintf(#sgt, msg("DRC %s (%s-%s Hz) toglie %.1f dB: riduci THR %s o restringi la banda.",
                      "DRC %s (%s-%s Hz) removes %.1f dB: lower THR %s or narrow the band."), letter, #sfa, #sfb, gr, letter);
    add_sug(#sgt);
  );
);
function check_drc_idle(eng, gr, thr, letter) (
  eng && thr > 1 && gr < 0.12 ? (
    sprintf(#sgt, msg("DRC %s non interviene: se senti quella risonanza alza THR %s.",
                      "DRC %s is idle: if you hear that resonance raise THR %s."), letter, letter);
    add_sug(#sgt);
  );
);
function compute_suggestions() local(drc_on, aud_on) (
  sug_n = 0; strcpy(#sug1, ""); strcpy(#sug2, "");
  drc_on = slider8 >= 0.5;
  aud_on = (slider39 >= 0.5) || (delta_spring_stage > 0) || (drc_solo_audition_band > 0);
  aud_on ? (
    add_sug(msg("Analisi in pausa durante DELTA / SOLO: rilascia o disattiva per riprendere la misura.",
                "Analysis paused during DELTA / SOLO: release or disable to resume."));
  ) : !sug_ready ? (
    ui_rms_in_db < -52 && sug_blk_n == 0 ? (
      add_sug(msg("In attesa di segnale: l'analisi parte quando arriva la voce.", "Waiting for signal: analysis starts when the voice arrives."));
    ) : (
      sprintf(#sgt, msg("Raccolta blocco analisi (4 s di parlato: %.0f%%)...",
                        "Collecting analysis block (4 s speech: %.0f%%)..."),
              min(99, 100 * sug_blk_n / max(1, sug_blk_target)));
      add_sug(#sgt);
    );
  ) : (
    sug_avg_lim > 1.2 ? ( sprintf(#sgt, msg("Limiter finale attivo (-%.1f dB medi): abbassa OUTPUT o TONE SCL.", "Final limiter active (-%.1f dB avg): lower OUTPUT or TONE SCL."), sug_avg_lim); add_sug(#sgt); );
    sug_avg_in_db < -34 ? ( sprintf(#sgt, msg("Ingresso basso (%.0f dB RMS sul blocco): alza INPUT di circa %.0f dB per far lavorare i detector.", "Low input (%.0f dB RMS on block): raise INPUT by about %.0f dB so detectors can work."), sug_avg_in_db, clamp(-24 - sug_avg_in_db, 1, 12)); add_sug(#sgt); );
    sug_avg_in_db > -11 ? ( sprintf(#sgt, msg("Ingresso caldo (%.0f dB RMS sul blocco): abbassa INPUT di circa %.0f dB.", "Hot input (%.0f dB RMS on block): lower INPUT by about %.0f dB."), sug_avg_in_db, clamp(sug_avg_in_db + 18, 1, 12)); add_sug(#sgt); );
    slider7 >= 0.5 && sug_avg_pk_gr > 8.0 ? ( sprintf(#sgt, msg("Peak Leveler molto spinto (-%.1f dB medi): porta PEAK RED verso 35-45%%.", "Peak Leveler pushed hard (-%.1f dB avg): bring PEAK RED toward 35-45%%."), sug_avg_pk_gr); add_sug(#sgt); );
    check_drc_hi(drc_on && slider9 >= 0.5,  sug_avg_drcA, slider10, slider11, "A");
    check_drc_hi(drc_on && slider13 >= 0.5, sug_avg_drcB, slider14, slider15, "B");
    check_drc_hi(drc_on && slider17 >= 0.5, sug_avg_drcC, slider18, slider19, "C");
    check_drc_hi(drc_on && slider21 >= 0.5, sug_avg_drcD, slider22, slider23, "D");
    sug_avg_lo_mid_db > 0.5 ? add_sug(msg("Molto peso sulle basse (stanza o effetto prossimita'): prova LOWCUT piu' alto o una banda DRC su 200-500 Hz.", "Heavy low end (room or proximity): try a higher LOWCUT or a DRC band on 200-500 Hz."));
    sug_avg_hi_mid_db < -21.0 ? add_sug(msg("Voce scura sul blocco da 4 s: prova TONE A o MID BUMP, oppure alza DYN BAL.", "Dark voice over 4 s block: try TONE A or MID BUMP, or raise DYN BAL."));
    sug_avg_hi_mid_db > -9.5 ? add_sug(msg("Voce brillante/sibilante sul blocco da 4 s: verifica una banda DRC tra 6k e 10k.", "Bright/sibilant voice over 4 s block: check a DRC band between 6k and 10k."));
    slider33 >= 0.5 && sug_avg_dbal > 75 ? add_sug(msg("Dynamic Balance al limite: il microfono e' lontano dalla curva target. Abbassa DYN BAL o cambia A/B.", "Dynamic Balance at its limit: the mic is far from target. Lower DYN BAL or switch A/B."));
    slider7 >= 0.5 && slider6 > 5 && sug_avg_pk_gr < 0.25 ? add_sug(msg("Peak Leveler quasi fermo: alza PEAK RED per livellare le distanze dal microfono.", "Peak Leveler nearly idle: raise PEAK RED to even out mic distance."));
    check_drc_idle(drc_on && slider9 >= 0.5,  sug_avg_drcA, slider12, "A");
    check_drc_idle(drc_on && slider13 >= 0.5, sug_avg_drcB, slider16, "B");
    check_drc_idle(drc_on && slider17 >= 0.5, sug_avg_drcC, slider20, "C");
    check_drc_idle(drc_on && slider21 >= 0.5, sug_avg_drcD, slider24, "D");
    sug_n == 0 ? add_sug(msg("Catena in equilibrio (blocco 4 s): nessun intervento eccessivo rilevato.", "Chain balanced (4 s block): no excessive processing detected."));
  );
);

// ============================================================================
// BARRE IN BASSO: SUGGERIMENTI (opzionale) + GUIDA
// ============================================================================
ana_on ? (
  time_now - sug_t > 0.6 ? ( compute_suggestions(); sug_t = time_now; );
  gfx_r = show_simple ? 0.99 : 0.10; gfx_g = show_simple ? 0.95 : 0.09; gfx_b = show_simple ? 0.86 : 0.05; gfx_a = 1;
  gfx_rect(0, gyp(ana_yd), gfx_w, gyp(AB) + 1);
  gfx_r = c_amber_r; gfx_g = c_amber_g; gfx_b = c_amber_b; gfx_a = 0.9; gfx_rect(0, gyp(ana_yd), gfx_w, max(1, floor(2 * sc)));
  gfx_setfont(6); gfx_r = c_amber_r; gfx_g = c_amber_g; gfx_b = c_amber_b;
  g_txt(30, ana_yd + 9, msg("ANALISI", "ANALYSIS"));
  gfx_setfont(5); set_text_col();
  g_txt(110, ana_yd + 9, "•  "); g_txt(126, ana_yd + 9, #sug1);
  sug_n > 1 ? ( g_txt(110, ana_yd + 31, "•  "); g_txt(126, ana_yd + 31, #sug2); );
);

gfx_r = show_simple ? 0.86 : 0.11; gfx_g = show_simple ? 0.90 : 0.12; gfx_b = show_simple ? 0.95 : 0.15; gfx_a = 1;
gfx_rect(0, gyp(help_yd), gfx_w, gfx_h - gyp(help_yd));
gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_rect(0, gyp(help_yd), gfx_w, 1);

// Pulsante SUGGERIMENTI (in basso a destra)
sbw = 150; sbx = xr_d - sbw - 12; sby = help_yd + 4;
s_hover = mxd >= sbx && mxd <= sbx + sbw && myd >= sby && myd <= sby + 24;
s_hover ? active_info_id = 231;
s_hover && mouse_click_raw ? ( set_ui_state(51, ana_on ? 0 : 1); sug_t = -10; );
btn_face(sbx, sby, sbw, 24, msg("SUGGERIMENTI", "SUGGESTIONS"), ana_on, s_hover, c_amber_r, c_amber_g, c_amber_b);

gfx_setfont(4); set_text_col();
active_info_id == 108 ? (
  sprintf(#pk_tip, msg("Spia dinamica PEAK GR (-%.1f dB): si illumina in base alla riduzione reale del Peak Leveler (ON/OFF da 3·PEAK in alto).",
                       "Dynamic PEAK GR lamp (-%.1f dB): lights up proportionally to Peak Leveler reduction (ON/OFF via 3·PEAK above)."), ui_peak_gr_db);
) : (active_info_id >= 156 && active_info_id <= 159) ? (
