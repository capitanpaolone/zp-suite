// ---------------- Filtri ----------------
function svf_bp_coeff(f_a, f_b, sr) local(lo, hi, fc, bw, w0, oct_w, sens_db) (
  lo = max(20, min(f_a, f_b));
  hi = max(lo + 8, max(f_a, f_b));
  fc = min(sqrt(lo * hi), sr * 0.44);
  bw = max(8, hi - lo);
  oct_w = log(hi / lo) / log(2.0);
  this.q = clamp(fc / bw, 0.5, 12.0);
  w0 = 2 * $pi * fc / sr;
  this.g = tan(w0 * 0.5);
  this.k = 1.0 / this.q;
  this.a1 = 1.0 / (1.0 + this.g * (this.g + this.k));
  this.a2 = this.g * this.a1;
  this.a3 = this.g * this.a2;
  // Compensazione spettrale voce (BrownSlope): sensibilita' proporzionata a centro banda e larghezza
  sens_db = clamp(log(fc / 250.0) / log(2.0), -2.5, 5.5) * 1.5 + clamp((1.0 - oct_w) * 0.9, -3.5, 2.5);
  this.sens_lin = db2lin(sens_db);
);
function svf_bp_procL(x) local(v3, v1, v2) (
  v3 = x - this.ic2L;
  v1 = this.a1 * this.ic1L + this.a2 * v3;
  v2 = this.ic2L + this.a2 * this.ic1L + this.a3 * v3;
  this.ic1L = 2.0 * v1 - this.ic1L;
  this.ic2L = 2.0 * v2 - this.ic2L;
  v1 * this.k;
);
function svf_bp_procR(x) local(v3, v1, v2) (
  v3 = x - this.ic2R;
  v1 = this.a1 * this.ic1R + this.a2 * v3;
  v2 = this.ic2R + this.a2 * this.ic1R + this.a3 * v3;
  this.ic1R = 2.0 * v1 - this.ic1R;
  this.ic2R = 2.0 * v2 - this.ic2R;
  v1 * this.k;
);
function bq_peaking(freq, q_val, gain_db, sr) local(Ag, w0, cw, sw, alpha, a0_inv) (
  freq = clamp(freq, 20, sr * 0.45);
  Ag = 10 ^ (gain_db / 40.0);
  w0 = 2 * $pi * freq / sr;
  cw = cos(w0); sw = sin(w0);
  alpha = sw / (2.0 * max(0.2, q_val));
  a0_inv = 1.0 / (1.0 + alpha / Ag);
  this.b0 = (1.0 + alpha * Ag) * a0_inv;
  this.b1 = (-2.0 * cw) * a0_inv;
  this.b2 = (1.0 - alpha * Ag) * a0_inv;
  this.a1 = this.b1;
  this.a2 = (1.0 - alpha / Ag) * a0_inv;
);
function bq_lpf(freq, q_val, sr) local(w0, cw, sw, alpha, a0_inv) (
  freq = clamp(freq, 20, sr * 0.44);
  w0 = 2 * $pi * freq / sr;
  cw = cos(w0); sw = sin(w0);
  alpha = sw / (2.0 * max(0.2, q_val));
  a0_inv = 1.0 / (1.0 + alpha);
  this.b0 = (1.0 - cw) * 0.5 * a0_inv;
  this.b1 = (1.0 - cw) * a0_inv;
  this.b2 = this.b0;
  this.a1 = (-2.0 * cw) * a0_inv;
  this.a2 = (1.0 - alpha) * a0_inv;
);
function bq_hshelf(freq, q_val, gain_db, sr) local(Ag, w0, cw, sw, alpha, sA, a0_inv) (
  freq = clamp(freq, 20, sr * 0.44);
  Ag = 10 ^ (gain_db / 40.0);
  w0 = 2 * $pi * freq / sr;
  cw = cos(w0); sw = sin(w0);
  alpha = sw / (2.0 * max(0.2, q_val));
  sA = 2.0 * sqrt(Ag) * alpha;
  a0_inv = 1.0 / ((Ag + 1.0) - (Ag - 1.0) * cw + sA);
  this.b0 = Ag * ((Ag + 1.0) + (Ag - 1.0) * cw + sA) * a0_inv;
  this.b1 = -2.0 * Ag * ((Ag - 1.0) + (Ag + 1.0) * cw) * a0_inv;
  this.b2 = Ag * ((Ag + 1.0) + (Ag - 1.0) * cw - sA) * a0_inv;
  this.a1 = 2.0 * ((Ag - 1.0) - (Ag + 1.0) * cw) * a0_inv;
  this.a2 = ((Ag + 1.0) - (Ag - 1.0) * cw - sA) * a0_inv;
);
function bq_ap2(freq, q_val, sr) local(w0, cw, sw, alpha, a0_inv) (
  freq = clamp(freq, 20, sr * 0.44);
  w0 = 2 * $pi * freq / sr;
  cw = cos(w0); sw = sin(w0);
  alpha = sw / (2.0 * max(0.2, q_val));
  a0_inv = 1.0 / (1.0 + alpha);
  this.b0 = (1.0 - alpha) * a0_inv;
  this.b1 = (-2.0 * cw) * a0_inv;
  this.b2 = (1.0 + alpha) * a0_inv;
  this.a1 = this.b1;
  this.a2 = this.b0;
);
function bq_procL(x) local(y) (
  y = this.b0 * x + this.b1 * this.x1L + this.b2 * this.x2L - this.a1 * this.y1L - this.a2 * this.y2L;
  this.x2L = this.x1L; this.x1L = x; this.y2L = this.y1L; this.y1L = y; y;
);
function bq_procR(x) local(y) (
  y = this.b0 * x + this.b1 * this.x1R + this.b2 * this.x2R - this.a1 * this.y1R - this.a2 * this.y2R;
  this.x2R = this.x1R; this.x1R = x; this.y2R = this.y1R; this.y1R = y; y;
);

function svf_split_coeff(fc, q_val, sr) local(w0) (
  fc = clamp(fc, 20, sr * 0.44);
  this.q = max(0.25, q_val);
  w0 = 2 * $pi * fc / sr;
  this.g = tan(w0 * 0.5);
  this.k = 1.0 / this.q;
  this.a1 = 1.0 / (1.0 + this.g * (this.g + this.k));
  this.a2 = this.g * this.a1;
  this.a3 = this.g * this.a2;
);
function svf_split_procL(x) local(v3, v1, v2) (
  v3 = x - this.ic2L;
  v1 = this.a1 * this.ic1L + this.a2 * v3;
  v2 = this.ic2L + this.a2 * this.ic1L + this.a3 * v3;
  this.ic1L = 2.0 * v1 - this.ic1L;
  this.ic2L = 2.0 * v2 - this.ic2L;
  this.lpL = v2;
  this.bpL = v1 * this.k;
  this.hpL = x - v2 - this.bpL;
);
function svf_split_procR(x) local(v3, v1, v2) (
  v3 = x - this.ic2R;
  v1 = this.a1 * this.ic1R + this.a2 * v3;
  v2 = this.ic2R + this.a2 * this.ic1R + this.a3 * v3;
  this.ic1R = 2.0 * v1 - this.ic1R;
  this.ic2R = 2.0 * v2 - this.ic2R;
  this.lpR = v2;
  this.bpR = v1 * this.k;
  this.hpR = x - v2 - this.bpR;
);
function deq_calc_band_db(L_db, lift0, T_db, S_val, M_db) local(ex, sex, cut) (
  ex = L_db - T_db;
  sex = 0.5 * (ex + sqrt(ex * ex + 64.0)) - 1.6;
  sex < 0 ? sex = 0.0;
  cut = min(M_db, S_val * sex);
  lift0 - cut;
);

function dbal_band_curve_db(L_db, b_t, modeB, tilt_db) local(u, shape, max_lift26, lift26, slope_lo, slope_hi, d26, comp) (
  b_t <= 0.001 ? 0.0 : (
    u = max(0.0, (b_t - 0.18) / 0.82);
    shape = 1.0 - exp(-3.2 * pow(u, 1.35));
    max_lift26 = modeB ? 9.65 : 7.90;
    lift26 = max_lift26 * shape;
    slope_lo = (0.14 + 0.60 * pow(u, 1.1)) * (modeB ? 1.12 : 1.0);
    slope_hi = (0.46 + 0.18 * u) * (modeB ? 1.12 : 1.0);
    d26 = L_db - (-26.0);
    d26 <= 0 ? (
      comp = max(-14.0, d26) * (0.35 * pow(u, 1.4));
    ) : d26 <= 8.0 ? (
      comp = -d26 * slope_lo;
    ) : (
      comp = -8.0 * slope_lo - (d26 - 8.0) * slope_hi;
    );
    clamp(lift26 + comp + tilt_db * min(1.0, b_t * 1.5), -12.0, 14.5);
  );
);

// LEGA OUTPUT: guadagno medio del modulo calcolato dai suoi parametri (non misurato sull'audio)
function bq_mag2(w) local(c1, s1, c2, s2, nr, ni, dr, di) (
  c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
  nr = this.b0 + this.b1 * c1 + this.b2 * c2; ni = -(this.b1 * s1 + this.b2 * s2);
  dr = 1 + this.a1 * c1 + this.a2 * c2;       di = -(this.a1 * s1 + this.a2 * s2);
  (nr * nr + ni * ni) / max(0.000000000001, dr * dr + di * di);
);
// Tone EQ + Mid Bump: media di potenza su 24 frequenze, pesata come lo spettro medio della voce parlata
function tone_gain_db() local(k, fq, w, wt, p, sw, sp) (
  (slider29 >= 0.5 || slider32 >= 0.5) ? (
    sw = 0; sp = 0; k = 0;
    loop(24,
      fq = min(80 * pow(150, k / 23), max(22050, srate) * 0.45); w = 2 * $pi * fq / max(22050, srate);
      wt = fq < 100 ? sqr(fq / 100) : fq > 500 ? pow(500 / fq, 1.5) : 1;
      p = 1;
      slider29 >= 0.5 ? p = tone_lo.bq_mag2(w) * tone_mid.bq_mag2(w) * tone_hi.bq_mag2(w);
      slider32 >= 0.5 ? p *= mid_bump_bq.bq_mag2(w) * mid_bump_gain * mid_bump_gain;
      sw += wt; sp += wt * p; k += 1;
    );
    10 * log10(sp / sw);
  ) : 0;
);
// Dynamic Balance: la sua curva sui livelli di banda fissati quando si lega, pesata sulle quote target
function dbal_gain_db() local(bt, mB, g1, g2, g3) (
  slider33 >= 0.5 && slider35 > 0.1 ? (
    bt = slider35 * 0.01; mB = slider34 >= 0.5;
    g1 = dbal_band_curve_db(lk_Llo + in_drive_db + lk_shd, bt, mB, 0.35); g2 = dbal_band_curve_db(lk_Lmid + in_drive_db + lk_shd, bt, mB, 0.20); g3 = dbal_band_curve_db(lk_Lhi + in_drive_db + lk_shd, bt, mB, -0.45);
    10 * log10((t_lo * 10 ^ (g1 / 10) + t_mid * 10 ^ (g2 / 10) + t_hi * 10 ^ (g3 / 10)) / max(0.001, t_lo + t_mid + t_hi));
  ) : 0;
);
// DYN EQ: lift a riposo meno i tagli, sulle 5 bande ai livelli letti quando si lega (senza Input Drive, riapplicato qui)
function deq_gain_db() local(g0, g1, g2, g3, g4) (
  slider26 >= 0.5 && slider28 > 0.1 ? (
    g0 = deq_calc_band_db(lk_Q0 + in_drive_db + lk_shq, deq_lift0, deq_T0, deq_S0, deq_M0);
    g1 = deq_calc_band_db(lk_Q1 + in_drive_db + lk_shq, deq_lift0, deq_T1, deq_S1, deq_M1);
    g2 = deq_calc_band_db(lk_Q2 + in_drive_db + lk_shq, deq_lift0, deq_T2, deq_S2, deq_M2);
    g3 = deq_calc_band_db(lk_Q3 + in_drive_db + lk_shq, deq_lift0, deq_T3, deq_S3, deq_M3);
    g4 = deq_calc_band_db(lk_Q4 + in_drive_db + lk_shq, deq_lift0, deq_T4, deq_S4, deq_M4);
    10 * log10((lk_W0 * 10 ^ (g0 / 10) + lk_W1 * 10 ^ (g1 / 10) + lk_W2 * 10 ^ (g2 / 10) + lk_W3 * 10 ^ (g3 / 10) + lk_W4 * 10 ^ (g4 / 10))
               / max(0.001, lk_W0 + lk_W1 + lk_W2 + lk_W3 + lk_W4));
  ) : 0;
);
function deq_ref_levels() (
  av_dq_ok ? (
    lk_Q0 = av_Q0; lk_Q1 = av_Q1; lk_Q2 = av_Q2; lk_Q3 = av_Q3; lk_Q4 = av_Q4;
    lk_W0 = av_W0; lk_W1 = av_W1; lk_W2 = av_W2; lk_W3 = av_W3; lk_W4 = av_W4;
  ) : (
    lk_Q0 = lk_Q1 = lk_Q2 = lk_Q3 = lk_Q4 = -20;
    lk_W0 = 0.10; lk_W1 = 0.30; lk_W2 = 0.35; lk_W3 = 0.18; lk_W4 = 0.07;
  );
);
// Peak Leveler: makeup meno riduzione (Opto + RComp) al livello di picco medio della voce
function pk_gain_db() local(amt, thr, L, go, gr) (
  slider7 >= 0.5 && slider6 > 0.1 ? (
    amt = slider6 * 0.01; thr = -9.5 - amt * 23.0; L = lk_pklev + in_drive_db;
    go = L > thr ? (L - thr) * 0.48 : 0; gr = L > thr + 2.5 ? (L - thr - 2.5) * 0.62 : 0;
    min(5.0, 0.10 + amt * 2.2 + clamp(-in_drive_db, -4.0, 6.0) * 0.08) - min(16.0, go * 0.55 + gr * 0.45);
  ) : 0;
);
function dbal_ref_levels() (
  av_db_ok ? ( lk_Llo = av_Llo; lk_Lmid = av_Lmid; lk_Lhi = av_Lhi; ) : ( lk_Llo = lk_Lmid = lk_Lhi = -20; );
);

function update_dsp_params() local(sr, hw_prof, w_hp, cw_hp, sw_hp, al_hp, a0_hp, w_lp, cw_lp, sw_lp, al_lp, a0_lp, eq_curve, eq_scale) (
  sr = max(22050, srate);
  // Input Drive dritto (-12.0 .. +12.0 dB, default 0.0 dB): spinge i detector senza sbalzi sul percorso lineare
  in_drive_db = clamp(slider1, -12.0, 12.0);
  in_drive_lin = db2lin(in_drive_db);
  out_gain_lin = db2lin(slider37);
  tp_ceiling = db2lin(slider41);

  w_hp = 2 * $pi * clamp(slider2, 20, sr * 0.4) / sr;
  cw_hp = cos(w_hp); sw_hp = sin(w_hp); al_hp = sw_hp / 1.41421356; a0_hp = 1.0 / (1.0 + al_hp);
  hp_b0 = (1.0 + cw_hp) * 0.5 * a0_hp; hp_b1 = -(1.0 + cw_hp) * a0_hp; hp_b2 = hp_b0;
  hp_a1 = -2.0 * cw_hp * a0_hp; hp_a2 = (1.0 - al_hp) * a0_hp;

  w_lp = 2 * $pi * clamp(slider3, 4000, sr * 0.46) / sr;
  cw_lp = cos(w_lp); sw_lp = sin(w_lp); al_lp = sw_lp / 1.41421356; a0_lp = 1.0 / (1.0 + al_lp);
  lp_b0 = (1.0 - cw_lp) * 0.5 * a0_lp; lp_b1 = (1.0 - cw_lp) * a0_lp; lp_b2 = lp_b0;
  lp_a1 = -2.0 * cw_lp * a0_lp; lp_a2 = (1.0 - al_lp) * a0_lp;

  // Banco firme hardware interno (slider58: 0=GLUE, 1=VOXBOX, 2=NEVE, 3=VCA, 4=TAPE)
  // Profilo 0 identico bit-per-bit alla calibrazione MagicFlow AU; profili 1..4 calibrati su misure UAD a 0.00 ± 0.02 dB RMS su parlato.
  hw_prof = floor(clamp(slider58, 0, 4) + 0.5);
  pre_dc_r = exp(-2.0 * $pi * 5.0 / sr);
  hw_prof == 0 ? (
    // 0 · GLUE (MagicFlow AU Insert + Preamp — invariato al 100%)
    ins_eq1.bq_peaking(82.5,   0.278,  0.531, sr);
    ins_eq2.bq_peaking(854.2,  0.301, -2.326, sr);
    ins_lp1.bq_lpf(17146.0, 0.447, sr);
    ins_lp2.bq_lpf(18574.0, 0.866, sr);
    ins_gain_db = -0.0782;
    ins_ap1.bq_ap2(87.1,   0.852, sr);
    ins_ap2.bq_ap2(176.0,  0.698, sr);
    ins_ap3.bq_ap2(596.1,  0.709, sr);
    ins_ap4.bq_ap2(1102.6, 0.563, sr);
    ins_ap5.bq_ap2(1280.6, 0.573, sr);
    ins_ap6.bq_ap2(6504.8, 0.676, sr);
    ins_ap5_en = 1;
    pre_b1.bq_peaking(53.0,   1.129,  2.846, sr);
    pre_b2.bq_peaking(114.3,  0.454, -0.785, sr);
    pre_b3.bq_peaking(1681.9, 1.309,  0.715, sr);
    pre_b4.bq_hshelf(3113.7,  0.397,  0.642, sr);
    pre_gain_db = 0.0;
    pre_att = exp(-1.0 / (sr * 0.0015)); pre_rel = exp(-1.0 / (sr * 0.025));
    pre_sag_k = 0.065; pre_k2 = 0.0; pre_k3 = 0.0024; pre_d3 = 0.5;
  ) : hw_prof == 1 ? (
    // 1 · VOXBOX (calibrato su UAD Manley VOXBOX: risposta vellutata e lineare, seta -0.2 dB @ 20 kHz, H2 pura Classe A)
    ins_eq1.bq_peaking(90.0,   0.550,  0.300, sr);
    ins_eq2.bq_peaking(420.0,  0.650, -0.320, sr);
    ins_lp1.bq_peaking(3200.0, 0.700,  0.140, sr);
    ins_lp2.bq_hshelf(11000.0, 0.550, -0.260, sr);
    ins_gain_db = 0.070;
    ins_ap1.bq_ap2(58.0,   0.650, sr);
    ins_ap2.bq_ap2(165.0,  0.700, sr);
    ins_ap3.bq_ap2(520.0,  0.720, sr);
    ins_ap4.bq_ap2(1500.0, 0.680, sr);
    ins_ap5_en = 0;
    pre_b1.bq_peaking(72.0,   0.650,  0.360, sr);
    pre_b2.bq_peaking(340.0,  0.650, -0.220, sr);
    pre_b3.bq_peaking(2800.0, 0.750,  0.150, sr);
    pre_b4.bq_hshelf(11500.0, 0.550, -0.200, sr);
    pre_gain_db = 0.026;
    pre_att = exp(-1.0 / (sr * 0.0038)); pre_rel = exp(-1.0 / (sr * 0.060));
    pre_sag_k = 0.055; pre_k2 = 0.0042; pre_k3 = 0.00030; pre_d3 = 0.45;
  ) : hw_prof == 2 ? (
    // 2 · NEVE (calibrato su UAD Neve 1073: sub controllate <55 Hz, corpo 120-135 Hz, presenza 1.8 kHz, seta Marinair +0.15 dB @ 20k, 2N3055 Classe A)
    ins_eq1.bq_peaking(34.0,   0.550, -0.850, sr);
    ins_eq2.bq_peaking(135.0,  0.650,  0.620, sr);
    ins_lp1.bq_peaking(1850.0, 0.700,  0.550, sr);
    ins_lp2.bq_hshelf(11500.0, 0.580,  0.420, sr);
    ins_gain_db = -0.288;
    ins_ap1.bq_ap2(54.0,   0.820, sr);
    ins_ap2.bq_ap2(180.0,  0.800, sr);
    ins_ap3.bq_ap2(680.0,  0.840, sr);
    ins_ap4.bq_ap2(2100.0, 0.780, sr);
    ins_ap5_en = 0;
    pre_b1.bq_peaking(38.0,   0.600, -0.550, sr);
    pre_b2.bq_peaking(120.0,  0.700,  0.680, sr);
    pre_b3.bq_peaking(1750.0, 0.800,  0.550, sr);
    pre_b4.bq_hshelf(11500.0, 0.580,  0.350, sr);
    pre_gain_db = -0.285;
    pre_att = exp(-1.0 / (sr * 0.0035)); pre_rel = exp(-1.0 / (sr * 0.032));
    pre_sag_k = 0.075; pre_k2 = 0.0085; pre_k3 = 0.0042; pre_d3 = 0.65;
  ) : hw_prof == 3 ? (
    // 3 · VCA (calibrato su UAD SSL E / API Vision: sub asciutte, pulizia 350 Hz, articolazione 3.1 kHz, estensione dritta a 20 kHz, THD minima)
    ins_eq1.bq_peaking(36.0,   0.600, -0.950, sr);
    ins_eq2.bq_peaking(380.0,  0.650, -0.480, sr);
    ins_lp1.bq_peaking(3100.0, 0.750,  0.720, sr);
    ins_lp2.bq_hshelf(12000.0, 0.580, -0.180, sr);
    ins_gain_db = 0.183;
    ins_ap1.bq_ap2(95.0,   0.480, sr);
    ins_ap2.bq_ap2(360.0,  0.520, sr);
    ins_ap3.bq_ap2(1200.0, 0.520, sr);
    ins_ap4.bq_ap2(3400.0, 0.500, sr);
    ins_ap5_en = 0;
    pre_b1.bq_peaking(42.0,   0.700, -0.450, sr);
    pre_b2.bq_peaking(320.0,  0.700, -0.320, sr);
    pre_b3.bq_peaking(3200.0, 0.850,  0.580, sr);
    pre_b4.bq_hshelf(12000.0, 0.600, -0.140, sr);
    pre_gain_db = 0.098;
    pre_att = exp(-1.0 / (sr * 0.0035)); pre_rel = exp(-1.0 / (sr * 0.020));
    pre_sag_k = 0.020; pre_k2 = 0.0014; pre_k3 = 0.00035; pre_d3 = 0.40;
  ) : (
    // 4 · TAPE (calibrato su UAD Studer A800 15 IPS 456: head-bump 42 Hz con 120 Hz puliti, alte aperte -0.25 dB @ 20k, H3 magnetica calda)
    ins_eq1.bq_peaking(42.0,   0.780,  2.350, sr);
    ins_eq2.bq_peaking(135.0,  0.850, -0.420, sr);
    ins_lp1.bq_peaking(5200.0, 0.620, -0.400, sr);
    ins_lp2.bq_hshelf(12500.0, 0.580, -0.280, sr);
    ins_gain_db = 0.028;
    ins_ap1.bq_ap2(58.0,   0.920, sr);
    ins_ap2.bq_ap2(185.0,  0.900, sr);
    ins_ap3.bq_ap2(620.0,  0.920, sr);
    ins_ap4.bq_ap2(2100.0, 0.880, sr);
    ins_ap5_en = 0;
    pre_b1.bq_peaking(44.0,   0.820,  1.500, sr);
    pre_b2.bq_peaking(130.0,  0.850, -0.350, sr);
    pre_b3.bq_peaking(5000.0, 0.650, -0.320, sr);
    pre_b4.bq_hshelf(12500.0, 0.580, -0.240, sr);
    pre_gain_db = 0.045;
    pre_att = exp(-1.0 / (sr * 0.0035)); pre_rel = exp(-1.0 / (sr * 0.040));
    pre_sag_k = 0.125; pre_k2 = 0.0018; pre_k3 = 0.0280; pre_d3 = 0.90;
  );
  ins_gain_lin = db2lin(ins_gain_db);
  pre_gain_lin = db2lin(pre_gain_db);

  opt_att = exp(-1.0 / (sr * 0.018)); opt_rel = exp(-1.0 / (sr * 0.240));
  rc_att  = exp(-1.0 / (sr * 0.0035)); rc_rel  = exp(-1.0 / (sr * 0.085));

  drcA.svf_bp_coeff(slider10, slider11, sr);
  drcB.svf_bp_coeff(slider14, slider15, sr);
  drcC.svf_bp_coeff(slider18, slider19, sr);
  drcD.svf_bp_coeff(slider22, slider23, sr);
  drc_att = exp(-1.0 / (sr * 0.0015)); drc_rel = exp(-1.0 / (sr * 0.045));
  drc_ui_att = exp(-1.0 / (sr * 0.004));
  drc_ui_rel = exp(-1.0 / (sr * 0.140));

  // Dynamic EQ 5-band phase-coherent 2-SVF tree (calibrated to MagicFlow AU measurements)
  deq_svf1.svf_split_coeff(210.0, 0.52, sr);
  deq_svf2.svf_split_coeff(2950.0, 0.45, sr);
  deq_c = floor(slider27 + 0.5);
  deq_t = slider28 * 0.01;
  // Time constants per curve and frequency region (from steps.csv / RAPPORTO.md)
  deq_att_lo  = exp(-1.0 / (sr * (deq_c == 3 ? 0.020 : 0.015)));
  deq_rel_lo  = exp(-1.0 / (sr * (deq_c == 3 ? 0.090 : deq_c == 1 ? 0.085 : 0.075)));
  deq_att_mid = exp(-1.0 / (sr * 0.012));
  deq_rel_mid = exp(-1.0 / (sr * (deq_c == 2 ? 0.050 : 0.085)));
  deq_att_hi  = exp(-1.0 / (sr * (deq_c == 3 ? 0.008 : 0.005)));
  deq_rel_hi  = exp(-1.0 / (sr * (deq_c == 2 ? 0.038 : deq_c == 3 ? 0.095 : 0.085)));

  // Table of 50% and 100% calibrated parameters (T50, S50, M50, T100, S100, M100) for bands 0..4
  deq_c == 0 ? (
    // Curve A (Clarity)
    T50_0=-46; S50_0=0.25; M50_0=4.0;  T100_0=-48; S100_0=0.55; M100_0=16.0;
    T50_1=-28; S50_1=0.30; M50_1=6.5;  T100_1=-30; S100_1=0.70; M100_1=16.0;
    T50_2=-20; S50_2=0.35; M50_2=4.0;  T100_2=-24; S100_2=0.60; M100_2=10.5;
    T50_3=-32; S50_3=0.25; M50_3=5.5;  T100_3=-32; S100_3=0.65; M100_3=16.0;
    T50_4=-32; S50_4=0.15; M50_4=3.5;  T100_4=-30; S100_4=0.55; M100_4=13.0;
  ) : deq_c == 1 ? (
    // Curve B (Warm Control / MAGIC 1 / Female LD / Podcast1)
    T50_0=-44; S50_0=0.30; M50_0=4.0;  T100_0=-48; S100_0=0.70; M100_0=16.0;
    T50_1=-34; S50_1=0.20; M50_1=6.5;  T100_1=-36; S100_1=0.60; M100_1=17.5;
    T50_2=-24; S50_2=0.25; M50_2=4.0;  T100_2=-26; S100_2=0.60; M100_2=12.0;
    T50_3=-32; S50_3=0.20; M50_3=4.0;  T100_3=-32; S100_3=0.55; M100_3=14.0;
    T50_4=-40; S50_4=0.15; M50_4=5.0;  T100_4=-38; S100_4=0.50; M100_4=15.0;
  ) : deq_c == 2 ? (
    // Curve C (Male Focus - fast release, deep chest control)
    T50_0=-44; S50_0=1.05; M50_0=4.0;  T100_0=-50; S100_0=1.10; M100_0=16.0;
    T50_1=-34; S50_1=0.40; M50_1=7.0;  T100_1=-38; S100_1=0.75; M100_1=22.5;
    T50_2=-24; S50_2=0.25; M50_2=4.0;  T100_2=-26; S100_2=0.60; M100_2=12.0;
    T50_3=-28; S50_3=0.30; M50_3=5.0;  T100_3=-30; S100_3=0.70; M100_3=16.5;
    T50_4=-40; S50_4=0.20; M50_4=6.0;  T100_4=-44; S100_4=0.50; M100_4=18.0;
  ) : (
    // Curve D (Smooth Presence / VO1 / Bus - preserves sub low end, tames 250 Hz & 12.8 kHz)
    T50_0=-14; S50_0=0.20; M50_0=2.0;  T100_0=-18; S100_0=0.35; M100_0=4.5;
    T50_1=-22; S50_1=0.55; M50_1=8.0;  T100_1=-28; S100_1=0.70; M100_1=14.5;
    T50_2=-16; S50_2=0.35; M50_2=3.5;  T100_2=-20; S100_2=0.55; M100_2=7.5;
    T50_3=-20; S50_3=0.45; M50_3=6.5;  T100_3=-24; S100_3=0.65; M100_3=11.5;
    T50_4=-30; S50_4=0.30; M50_4=6.5;  T100_4=-32; S100_4=0.50; M100_4=13.0;
  );

  deq_t <= 0.5 ? (
    deq_u = deq_t * 2.0;
    deq_lift0 = 3.0 * deq_u;
    deq_T0 = T50_0; deq_S0 = S50_0 * deq_u; deq_M0 = M50_0 * deq_u;
    deq_T1 = T50_1; deq_S1 = S50_1 * deq_u; deq_M1 = M50_1 * deq_u;
    deq_T2 = T50_2; deq_S2 = S50_2 * deq_u; deq_M2 = M50_2 * deq_u;
    deq_T3 = T50_3; deq_S3 = S50_3 * deq_u; deq_M3 = M50_3 * deq_u;
    deq_T4 = T50_4; deq_S4 = S50_4 * deq_u; deq_M4 = M50_4 * deq_u;
  ) : (
    deq_u = (deq_t - 0.5) * 2.0;
    deq_lift0 = 3.0;
    deq_T0 = T50_0 + deq_u*(T100_0 - T50_0); deq_S0 = S50_0 + deq_u*(S100_0 - S50_0); deq_M0 = M50_0 + deq_u*(M100_0 - M50_0);
    deq_T1 = T50_1 + deq_u*(T100_1 - T50_1); deq_S1 = S50_1 + deq_u*(S100_1 - S50_1); deq_M1 = M50_1 + deq_u*(M100_1 - M50_1);
    deq_T2 = T50_2 + deq_u*(T100_2 - T50_2); deq_S2 = S50_2 + deq_u*(S100_2 - S50_2); deq_M2 = M50_2 + deq_u*(M100_2 - M50_2);
    deq_T3 = T50_3 + deq_u*(T100_3 - T50_3); deq_S3 = S50_3 + deq_u*(S100_3 - S50_3); deq_M3 = M50_3 + deq_u*(M100_3 - M50_3);
    deq_T4 = T50_4 + deq_u*(T100_4 - T50_4); deq_S4 = S50_4 + deq_u*(S100_4 - S50_4); deq_M4 = M50_4 + deq_u*(M100_4 - M50_4);
  );

  // Tone EQ calibrated on MagicFlow AU measurements (Eq_A/B/C/D + MidBump)
  eq_curve = floor(slider30 + 0.5);
  eq_scale = slider31;
  eq_curve == 0 ? (
    // Eq_A: +2.0 dB @ 140 Hz, +2.6..+3.66 dB across 1.6..9 kHz @ 3.06x
    tone_lo.bq_peaking(105,  0.55, 0.60 * eq_scale, sr);
    tone_mid.bq_peaking(1650, 0.50, 0.35 * eq_scale, sr);
    tone_hi.bq_peaking(8200, 0.35, 1.15 * eq_scale, sr);
  ) : eq_curve == 1 ? (
    // Eq_B (MAGIC 1): +1.56 dB @ 200 Hz, +1.8..+3.46 dB across 1.6..9 kHz @ 3.06x (mean err 0.23 dB)
    tone_lo.bq_peaking(190,   0.90, 0.47 * eq_scale, sr);
    tone_mid.bq_peaking(4600,  0.38, 0.92 * eq_scale, sr);
    tone_hi.bq_peaking(10200, 0.55, 0.36 * eq_scale, sr);
  ) : eq_curve == 2 ? (
    // Eq_C: +1.52 dB @ 63 Hz, flat low-mids, +1.66..+3.47 dB across 1.6..18 kHz @ 3.06x
    tone_lo.bq_peaking(65,    1.10, 0.48 * eq_scale, sr);
    tone_mid.bq_peaking(1900,  0.75, 0.28 * eq_scale, sr);
    tone_hi.bq_peaking(14500, 0.32, 1.12 * eq_scale, sr);
  ) : (
    // Eq_D: +1.51 dB @ 100 Hz, +1.95..+4.80 dB across 1.6..18 kHz @ 3.06x
    tone_lo.bq_peaking(105,   0.90, 0.48 * eq_scale, sr);
    tone_mid.bq_peaking(2600,  0.65, 0.25 * eq_scale, sr);
    tone_hi.bq_peaking(14800, 0.32, 1.54 * eq_scale, sr);
  );
  // Measured MidBump: broad +1.0 dB lift + 0.30 dB centered at 5.2 kHz
  mid_bump_bq.bq_peaking(5200, 0.45, 0.35, sr);
  mid_bump_gain = db2lin(0.98);

  dbal_c_lo = 1.0 - exp(-2.0 * $pi * 280.0 / sr);
  dbal_c_hi = 1.0 - exp(-2.0 * $pi * 2800.0 / sr);
  dbal_env_c = 1.0 - exp(-1.0 / (sr * 0.065));
  slider34 < 0.5 ? ( t_lo = 0.27; t_mid = 0.45; t_hi = 0.28; ) : ( t_lo = 0.31; t_mid = 0.43; t_hi = 0.26; );

  gm_coeff = 1.0 - exp(-1.0 / (sr * 0.350));
  meter_decay_ui = exp(-1.0 / (sr * 0.200));
  in_mtr_att = exp(-1.0 / (sr * 0.003));
  in_mtr_rel = exp(-1.0 / (sr * 0.160));
  pk_led_att = exp(-1.0 / (sr * 0.002));
  pk_led_rel = exp(-1.0 / (sr * 0.110));
  tp_att_coeff = exp(-1.0 / (sr * 0.00035));
  tp_rel_coeff = exp(-1.0 / (sr * 0.085));
  sug_c_lo  = 1.0 - exp(-2.0 * $pi * 250.0 / sr);
  sug_c_mhp = 1.0 - exp(-2.0 * $pi * 280.0 / sr);
  sug_c_hi  = 1.0 - exp(-2.0 * $pi * 2800.0 / sr);
  sug_env_c = 1.0 - exp(-1.0 / (sr * 1.8));
  sug_blk_target = max(1, floor(sr * 4.0));
);

function set_drc_band_fc_oct(sl_hp, sl_lp, fc_in, oct_in) local(fc, oct, half_r, lo, hi) (
  fc = clamp(fc_in, 24, 19000);
  oct = clamp(oct_in, 0.12, 3.50);
  half_r = 2 ^ (oct * 0.5);
  lo = fc / half_r;
  hi = fc * half_r;
  // Se un estremo tocca il muro (20 Hz o 20 kHz), la banda si restringe simmetricamente
  // attorno a fc (lo * hi = fc^2) cosi' il vertice FREQ scivola libero fino ai limiti anche con Q largo
  lo < 20 ? ( lo = 20; hi = clamp(fc * fc / lo, 28, 20000); );
  hi > 20000 ? ( hi = 20000; lo = clamp(fc * fc / hi, 20, 19960); );
  lo = floor(clamp(lo, 20, 19960) + 0.5);
  hi = floor(clamp(max(lo + 8, hi), 28, 20000) + 0.5);
  set_param_slider(sl_hp, lo);
  set_param_slider(sl_lp, hi);
  floor(slider44 + 0.5) != 0 ? ( set_param_slider(44, 0); prev_osara_preset = 0; );
  update_dsp_params();
);

update_dsp_params();
last_srate = srate;

// Ponte guida (gmem ZPVoiceoverSharedBus 3900-3905, Cue Navigator): "?" apre magic_voice_lab.html (plugin 14).
// Il ponte e' acceso solo se il battito (3900) cambia: un numero fermo da piu' di 3 s = Cue Navigator spento.
hb_seen = 0; hb_last = 0; hb_t = -10; help_warn_until = 0;
function help_bridge_alive() local(hb, now) (
  hb = gmem[3900]; now = time_precise();
  !hb_seen ? (hb_last = hb; hb_seen = 1) : hb != hb_last ? (hb_last = hb; hb_t = now);
  hb > 0 && now - hb_t < 3;
);
function help_bridge_open(plugin_id) (
  help_bridge_alive() ? (gmem[3902] = plugin_id; gmem[3903] += 1; help_warn_until = 0;)
  : (help_warn_until = time_precise() + 4.0);
);

// --- MEMORIA A/B (dopo update_dsp_params, che ab_recall chiama)
function ab_store(m) local(k) ( k = 0; loop(AB_N, AB_MEM[m * 100 + k] = slider(ab_list[k]); k += 1; ); );
function ab_recall(m) local(k, idx) (
  k = 0; loop(AB_N, idx = ab_list[k]; slider(idx) = AB_MEM[m * 100 + k]; sliderchange(2 ^ (idx - 1)); k += 1; );
  update_dsp_params(); out_gain_lin = db2lin(slider37);
);
function ab_start() ( (!ab_on || ab_cur == 0) ? ( ab_store(0); ab_store(1); ab_on = 1; ab_cur = 1; ); );   // A = stato di adesso, si lavora in B (anche ripartendo da A)
function ab_go(m) ( ab_on && m != ab_cur ? ( ab_store(ab_cur); ab_recall(m); ab_cur = m; ); );
function ab_close() ( ab_on ? ( ab_store(ab_cur); ab_store(1 - ab_cur); ab_on = 0; ); );

@slider
osara_p = floor(slider44 + 0.5);
osara_p > 0 && osara_p != prev_osara_preset ? (
  prev_osara_preset = osara_p;
  apply_magic_preset(osara_p);
);
osara_p == 0 ? prev_osara_preset = 0;
update_dsp_params();

@block
srate != last_srate ? (
  update_dsp_params();
  last_srate = srate;
);
// medie lente dei livelli per i legami (aggiornate solo con voce presente, sopra -55 dB circa)
av_c = 1 - exp(-samplesblock / (max(22050, srate) * 2.5));
dbal_mid_env > 0.0018 ? (
  av_x = av_db_ok ? av_c : 1;
  av_Llo  += av_x * (lin2db(dbal_low_env * 2.4) + 3.3 - av_Llo);
  av_Lmid += av_x * (lin2db(dbal_mid_env * 2.1) + 3.3 - av_Lmid);
  av_Lhi  += av_x * (lin2db(dbal_hi_env  * 3.2) + 3.3 - av_Lhi); av_db_ok = 1;
);
slider26 >= 0.5 && deq_e2 > 0.0018 ? (
  av_x = av_dq_ok ? av_c : 1; av_s = max(0.000000001, sqr(deq_e0) + sqr(deq_e1) + sqr(deq_e2) + sqr(deq_e3) + sqr(deq_e4));
  av_Q0 += av_x * (lin2db(deq_e0 * 1.42) - in_drive_db - av_Q0); av_W0 += av_x * (sqr(deq_e0) / av_s - av_W0);
  av_Q1 += av_x * (lin2db(deq_e1 * 1.42) - in_drive_db - av_Q1); av_W1 += av_x * (sqr(deq_e1) / av_s - av_W1);
  av_Q2 += av_x * (lin2db(deq_e2 * 1.42) - in_drive_db - av_Q2); av_W2 += av_x * (sqr(deq_e2) / av_s - av_W2);
  av_Q3 += av_x * (lin2db(deq_e3 * 1.42) - in_drive_db - av_Q3); av_W3 += av_x * (sqr(deq_e3) / av_s - av_W3);
  av_Q4 += av_x * (lin2db(deq_e4 * 1.42) - in_drive_db - av_Q4); av_W4 += av_x * (sqr(deq_e4) / av_s - av_W4); av_dq_ok = 1;
);
slider7 >= 0.5 && rcomp_env > 0.0018 ? ( av_x = av_pk_ok ? av_c : 1; av_pklev += av_x * (lin2db(rcomp_env) - in_drive_db - av_pklev); av_pk_ok = 1; );

// LEGA OUTPUT: OUTPUT = punto di partenza - (guadagno del modulo ora - guadagno quando si e' legato), per ogni modulo legato
lk_t = slider54 >= 0.5; lk_d = slider53 >= 0.5; lk_q = slider55 >= 0.5; lk_p = slider56 >= 0.5;
lk_any = lk_t || lk_d || lk_q || lk_p; lk_prev_any = lk_prev_t || lk_prev_d || lk_prev_q || lk_prev_p;
(lk_any || lk_prev_any) ? (
  // nuovo punto di partenza solo se OUTPUT e' stato mosso davvero (manopola o preset): un valore vecchio
  // rimandato da REAPER quando cambia un altro parametro non conta, il legame lo riscrive qui sotto
  !lk_prev_any ? ( lk_base = slider37; lk_user_move = 0; ) : ( lk_user_move ? ( lk_base += slider37 - lk_written; lk_user_move = 0; ); );
  // primo legame: una sola fotografia dei livelli per tutta la catena (media degli ultimi secondi di voce)
  (lk_any && !lk_prev_any) ? (
    lk_pklev = av_pk_ok ? av_pklev : -19; deq_ref_levels(); dbal_ref_levels(); lk_shq = 0; lk_shd = 0;
    gp_snap = pk_gain_db(); gq_snap = deq_gain_db(); gt_snap = tone_gain_db();
  );
  // in ordine di catena: ogni stadio riceve INPUT e quanto e' cambiato il guadagno degli stadi prima di lui
  gp_now = pk_gain_db();
  lk_shq = gp_now - gp_snap;                                    // DYN EQ dopo il Peak Leveler
  gq_now = deq_gain_db(); gt_now = tone_gain_db();
  lk_shd = lk_shq + (gq_now - gq_snap) + (gt_now - gt_snap);    // DYN BAL dopo DYN EQ e Tone
  gd_now = dbal_gain_db();
  (lk_t && !lk_prev_t) ? ( gt_ref = gt_now; );
  (lk_d && !lk_prev_d) ? ( gd_ref = gd_now; );
  (lk_q && !lk_prev_q) ? ( gq_ref = gq_now; );
  (lk_p && !lk_prev_p) ? ( gp_ref = gp_now; );
  (!lk_t && lk_prev_t) ? ( lk_base += gt_ref - gt_now; );
  (!lk_d && lk_prev_d) ? ( lk_base += gd_ref - gd_now; );
  (!lk_q && lk_prev_q) ? ( lk_base += gq_ref - gq_now; );
  (!lk_p && lk_prev_p) ? ( lk_base += gp_ref - gp_now; );
  lk_any ? (
    lk_raw = lk_base + (lk_t ? gt_ref - gt_now : 0) + (lk_d ? gd_ref - gd_now : 0) + (lk_q ? gq_ref - gq_now : 0) + (lk_p ? gp_ref - gp_now : 0);
    lk_clamped = lk_raw > 24 || lk_raw < -24;   // OUTPUT al tetto: il legame non compensa piu' tutto
    lk_target = clamp(lk_raw, -24, 24);
    abs(lk_target - slider37) > 0.01 ? ( slider37 = lk_target; out_gain_lin = db2lin(slider37); sliderchange(slider37); );
  );
  lk_written = slider37;
);
lk_prev_t = lk_t; lk_prev_d = lk_d; lk_prev_q = lk_q; lk_prev_p = lk_p;
zp_bus_refresh(ZP_BUS_ID);
blk_now = time_precise();
// Auto-off DELTA globale dopo 30s di inattivita' (anche a finestra FX chiusa)
slider39 >= 0.5 ? (
  !prev_delta_on ? ( delta_arm_time = blk_now; prev_delta_on = 1; );
  blk_now - delta_arm_time >= 30.0 ? (
    slider39 = 0;
    sliderchange(2 ^ 38);
    prev_delta_on = 0;
  );
) : ( prev_delta_on = 0; );
// Auto-disarm DELTA MOLLA dopo 30s di inattivita' e fail-safe se la GUI chiude durante un drag
delta_spring_armed && (blk_now - delta_spring_time >= 30.0) ? (
  delta_spring_armed = 0; delta_spring_stage = 0;
);
delta_spring_stage > 0 && (blk_now - delta_spring_aud_hb > 0.4) ? (
  delta_spring_stage = 0;
);
drc_solo_audition_band > 0 && (blk_now - drc_solo_aud_hb > 0.4) ? (
  drc_solo_audition_band = 0;
);
ui_gm_db = lin2db(gm_gain);
slider45 = floor(ui_peak_gr_db * 10 + 0.5) * 0.1;
slider46 = floor(ui_drc_gr_db * 10 + 0.5) * 0.1;
slider47 = floor(dbal_act_pct + 0.5);
slider48 = floor(ui_rms_in_db * 10 + 0.5) * 0.1;
slider49 = floor(ui_rms_out_db * 10 + 0.5) * 0.1;
slider50 = floor(ui_tp_gr_db * 10 + 0.5) * 0.1;

zp3_b = zp3_claim(3);
zp3_b >= 0 ? (
  zp3_pk_db = lin2db(max(0.000001, tp_meter_peak));
  gmem[zp3_b + 3] = zp3_prev_key;
  gmem[zp3_b + 4] = 3;
  gmem[zp3_b + 5] = zp3_tr;
  gmem[zp3_b + 6] = zp3_fx;
  gmem[zp3_b + 7] = zp3_hf;
  gmem[zp3_b + 8] = 0;
  gmem[zp3_b + 9] = ((slider4 >= 0.5 || slider5 >= 0.5 || slider7 >= 0.5 || slider8 >= 0.5 || slider26 >= 0.5 || slider29 >= 0.5 || slider32 >= 0.5 || slider33 >= 0.5 || slider40 >= 0.5 || slider57 >= 0.5) ? 1 : 2)
    + ((slider39 >= 0.5 || delta_spring_stage > 0) ? 4 : 0)
    + (drc_solo_audition_band > 0 ? 8 : 0)
    + (lk_clamped >= 0.5 ? 32 : 0);
  gmem[zp3_b + 10] = slider7 >= 0.5 ? ui_peak_gr_db : 0;
  gmem[zp3_b + 11] = max(slider8 >= 0.5 ? ui_drc_gr_db : 0, slider26 >= 0.5 ? deq_gr_db : 0);
  gmem[zp3_b + 12] = slider40 >= 0.5 ? ui_tp_gr_db : 0;
  gmem[zp3_b + 13] = slider33 >= 0.5 ? lin2db(max(0.05, ui_dbal_glo)) : 0;
  gmem[zp3_b + 14] = slider33 >= 0.5 ? lin2db(max(0.05, ui_dbal_gmid)) : 0;
  gmem[zp3_b + 15] = slider33 >= 0.5 ? lin2db(max(0.05, ui_dbal_ghi)) : 0;
  gmem[zp3_b + 16] = (slider5 >= 0.5 ? 25 : 0) + (slider57 >= 0.5 ? 15 : 0);
  gmem[zp3_b + 17] = ui_rms_in_db;
  gmem[zp3_b + 18] = ui_rms_out_db;
  gmem[zp3_b + 19] = zp3_pk_db;
  gmem[zp3_b + 20] = ui_rms_in_db > -55 ? clamp(ui_rms_out_db - ui_rms_in_db, -24, 24) : 0;
  gmem[zp3_b + 21] = clamp((ui_rms_out_db + 55) * 2.5, 0, 100);
  gmem[zp3_b + 22] = max(0, zp3_pk_db - ui_rms_out_db);
  gmem[zp3_b + 23] = -99;
  gmem[zp3_b + 24] = ui_peak_gr_db;
  gmem[zp3_b + 25] = ui_drc_gr_db;
  gmem[zp3_b + 26] = deq_gr_db;
  gmem[zp3_b + 27] = dbal_act_pct;
  gmem[zp3_b + 28] = ui_tp_gr_db;
  gmem[zp3_b + 29] = slider37;
  gmem[zp3_b + 30] = 0;
  gmem[zp3_b + 31] = 0;
  gmem[zp3_b] = 905301;
  gmem[zp3_b + 1] = time_precise();
  zp3_seq += 1;
  gmem[zp3_b + 2] = zp3_seq;
);

@sample
dryL = spl0;
dryR = spl1;
dry_curL = dryL;
dry_curR = dryR;

// ---- Stage 0 & 1: Hardware Insert + Input/Filters + Preamp ----
xL = dryL;
xR = dryR;

s_ins_inL = xL; s_ins_inR = xR;
mix_dry_curL = dryL; mix_dry_curR = dryR;
slider57 >= 0.5 ? (
  xL = ins_ap1.bq_procL(xL); xL = ins_ap2.bq_procL(xL); xL = ins_ap3.bq_procL(xL); xL = ins_ap4.bq_procL(xL);
  xR = ins_ap1.bq_procR(xR); xR = ins_ap2.bq_procR(xR); xR = ins_ap3.bq_procR(xR); xR = ins_ap4.bq_procR(xR);
  ins_ap5_en ? ( xL = ins_ap5.bq_procL(xL); xR = ins_ap5.bq_procR(xR); xL = ins_ap6.bq_procL(xL); xR = ins_ap6.bq_procR(xR); );
  slider36 > 0.1 ? ( mix_dry_curL = xL; mix_dry_curR = xR; );
  xL = ins_eq1.bq_procL(xL); xL = ins_eq2.bq_procL(xL); xL = ins_lp1.bq_procL(xL); xL = ins_lp2.bq_procL(xL);
  xR = ins_eq1.bq_procR(xR); xR = ins_eq2.bq_procR(xR); xR = ins_lp1.bq_procR(xR); xR = ins_lp2.bq_procR(xR);
  xL *= ins_gain_lin; xR *= ins_gain_lin;
);
s_ins_dL = xL - s_ins_inL; s_ins_dR = xR - s_ins_inR;

s_flt_inL = xL; s_flt_inR = xR;
slider4 >= 0.5 ? (
  yL = hp_b0*xL + hp_b1*hp_x1L + hp_b2*hp_x2L - hp_a1*hp_y1L - hp_a2*hp_y2L;
  hp_x2L = hp_x1L; hp_x1L = xL; hp_y2L = hp_y1L; hp_y1L = yL; xL = yL;
  yR = hp_b0*xR + hp_b1*hp_x1R + hp_b2*hp_x2R - hp_a1*hp_y1R - hp_a2*hp_y2R;
  hp_x2R = hp_x1R; hp_x1R = xR; hp_y2R = hp_y1R; hp_y1R = yR; xR = yR;
  yL = lp_b0*xL + lp_b1*lp_x1L + lp_b2*lp_x2L - lp_a1*lp_y1L - lp_a2*lp_y2L;
  lp_x2L = lp_x1L; lp_x1L = xL; lp_y2L = lp_y1L; lp_y1L = yL; xL = yL;
  yR = lp_b0*xR + lp_b1*lp_x1R + lp_b2*lp_x2R - lp_a1*lp_y1R - lp_a2*lp_y2R;
  lp_x2R = lp_x1R; lp_x1R = xR; lp_y2R = lp_y1R; lp_y1R = yR; xR = yR;
);
s_flt_dL = xL - s_flt_inL; s_flt_dR = xR - s_flt_inR;

s_pre_inL = xL; s_pre_inR = xR;
slider5 >= 0.5 ? (
  xL = pre_b1.bq_procL(xL); xL = pre_b2.bq_procL(xL); xL = pre_b3.bq_procL(xL); xL = pre_b4.bq_procL(xL) * pre_gain_lin;
  xR = pre_b1.bq_procR(xR); xR = pre_b2.bq_procR(xR); xR = pre_b3.bq_procR(xR); xR = pre_b4.bq_procR(xR) * pre_gain_lin;
  pL = xL * in_drive_lin; pR = xR * in_drive_lin;
  pre_lvl = max(abs(pL), abs(pR));
  pre_env = pre_lvl > pre_env ? (pre_att * pre_env + (1 - pre_att) * pre_lvl) : (pre_rel * pre_env + (1 - pre_rel) * pre_lvl);
  pre_sag = 1.0 / (1.0 + pre_sag_k * pre_env * pre_env);
  pL *= pre_sag; pR *= pre_sag;
  !pre_active_prev ? (
    pre_os_px_l = pL; pre_os_px_r = pR;
    pre_os_ym_l = pre_os_yc_l = pre_os_ym_r = pre_os_yc_r = 0;
    pre_dc_nl_l = pre_dc_nl_r = 0;
    pre_in_d1_l = s_pre_inL; pre_in_d1_r = s_pre_inR;
    pre_dry_d1_l = dry_curL; pre_dry_d1_r = dry_curR;
    pre_mdry_d1_l = mix_dry_curL; pre_mdry_d1_r = mix_dry_curR;
    pre_active_prev = 1;
  );
  // Oversampling 2x sul SOLO residuo armonico f(x)-x: 0.00 dB perdita lineare fino a Nyquist e anti-aliasing H2/H3
  pre_m_l = 0.5 * (pre_os_px_l + pL); pre_m_r = 0.5 * (pre_os_px_r + pR);
  pre_ym_l = pre_shape(pre_m_l) - pre_m_l; pre_ym_r = pre_shape(pre_m_r) - pre_m_r;
  pre_yc_l = pre_shape(pL) - pL;           pre_yc_r = pre_shape(pR) - pR;
  pre_rl = 0.25 * pre_os_ym_l + 0.50 * pre_os_yc_l + 0.25 * pre_ym_l;
  pre_rr = 0.25 * pre_os_ym_r + 0.50 * pre_os_yc_r + 0.25 * pre_ym_r;
  pre_os_ym_l = pre_ym_l; pre_os_ym_r = pre_ym_r;
  pre_os_yc_l = pre_yc_l; pre_os_yc_r = pre_yc_r;
  pre_k2 > 0 ? (
    pre_dc_nl_l = pre_rl + pre_dc_r * (pre_dc_nl_l - pre_rl); pre_rl -= pre_dc_nl_l;
    pre_dc_nl_r = pre_rr + pre_dc_r * (pre_dc_nl_r - pre_rr); pre_rr -= pre_dc_nl_r;
  ) : (
    pre_dc_nl_l = 0; pre_dc_nl_r = 0;
  );
  p_out_l = pre_os_px_l + pre_rl; pre_os_px_l = pL;
  p_out_r = pre_os_px_r + pre_rr; pre_os_px_r = pR;
  xL = p_out_l / max(0.25, in_drive_lin);
  xR = p_out_r / max(0.25, in_drive_lin);
  s_pre_dL = xL - pre_in_d1_l; s_pre_dR = xR - pre_in_d1_r;
  pre_in_d1_l = s_pre_inL; pre_in_d1_r = s_pre_inR;
  pre_tmp_d = dry_curL; dry_curL = pre_dry_d1_l; pre_dry_d1_l = pre_tmp_d;
  pre_tmp_d = dry_curR; dry_curR = pre_dry_d1_r; pre_dry_d1_r = pre_tmp_d;
  pre_tmp_d = mix_dry_curL; mix_dry_curL = pre_mdry_d1_l; pre_mdry_d1_l = pre_tmp_d;
  pre_tmp_d = mix_dry_curR; mix_dry_curR = pre_mdry_d1_r; pre_mdry_d1_r = pre_tmp_d;
) : (
  pre_active_prev = 0;
  pre_env *= 0.99; pre_dc_nl_l = 0; pre_dc_nl_r = 0;
  s_pre_dL = 0; s_pre_dR = 0;
);

// Meter livello reale d'ingresso (post-INPUT drive verso i detector)
in_mtr_pk = max(abs(xL), abs(xR)) * in_drive_lin;
ui_in_mtr_env = in_mtr_pk > ui_in_mtr_env ? (in_mtr_att * ui_in_mtr_env + (1.0 - in_mtr_att) * in_mtr_pk) : (in_mtr_rel * ui_in_mtr_env + (1.0 - in_mtr_rel) * in_mtr_pk);
ui_in_mtr_db = ui_in_mtr_env > 0.000001 ? lin2db(ui_in_mtr_env) : -60.0;

// ---- Stage 2: Peak Leveler (Opto + RComp, guidato da in_drive_lin come MagicFlow AU) ----
s_pk_inL = xL; s_pk_inR = xR;
slider7 >= 0.5 && slider6 > 0.1 ? (
  in_abs = max(abs(xL), abs(xR)) * in_drive_lin;
  opt_env = in_abs > opt_env ? (opt_att * opt_env + (1 - opt_att) * in_abs) : (opt_rel * opt_env + (1 - opt_rel) * in_abs);
  rcomp_env = in_abs > rcomp_env ? (rc_att * rcomp_env + (1 - rc_att) * in_abs) : (rc_rel * rcomp_env + (1 - rc_rel) * in_abs);
  pk_amt = slider6 * 0.01;
  pk_thr_db = -9.5 - pk_amt * 23.0;
  opt_db = lin2db(opt_env);
  rc_db  = lin2db(rcomp_env);
  gr_opt_db = opt_db > pk_thr_db ? (opt_db - pk_thr_db) * 0.48 : 0.0;
  gr_rc_db  = rc_db  > (pk_thr_db + 2.5) ? (rc_db - (pk_thr_db + 2.5)) * 0.62 : 0.0;
  c_opt = gr_opt_db * 0.55; c_rc = gr_rc_db * 0.45;
  tot_pk_gr_db = min(16.0, c_opt + c_rc);
  // Makeup ottico calibrato su MagicFlow AU e voce parlata
  pk_makeup_db = min(5.0, 0.10 + pk_amt * 2.2 + clamp(-in_drive_db, -4.0, 6.0) * 0.08);
  pk_gain = db2lin(-tot_pk_gr_db + pk_makeup_db);
  xL *= pk_gain; xR *= pk_gain;
  ui_peak_gr_db = ui_peak_gr_db * 0.995 + tot_pk_gr_db * 0.005;
  ui_peak_led_db = tot_pk_gr_db > ui_peak_led_db ? (pk_led_att * ui_peak_led_db + (1.0 - pk_led_att) * tot_pk_gr_db) : (pk_led_rel * ui_peak_led_db + (1.0 - pk_led_rel) * tot_pk_gr_db);
  ui_gr_opt = ui_gr_opt * 0.995 + c_opt * 0.005;
  ui_gr_rc  = ui_gr_rc  * 0.995 + c_rc  * 0.005;
  ui_pk_lvl_db = rc_db; ui_pk_thr_db = pk_thr_db;
) : (
  tot_pk_gr_db = 0;
  ui_peak_gr_db *= 0.99; ui_peak_led_db *= pk_led_rel; ui_gr_opt *= 0.99; ui_gr_rc *= 0.99; ui_pk_lvl_db = -90;
);
s_pk_dL = xL - s_pk_inL; s_pk_dR = xR - s_pk_inR;

// ---- Stage 3: DRC A/B/C/D ----
bAL = drcA.svf_bp_procL(xL); bAR = drcA.svf_bp_procR(xR);
bBL = drcB.svf_bp_procL(xL); bBR = drcB.svf_bp_procR(xR);
bCL = drcC.svf_bp_procL(xL); bCR = drcC.svf_bp_procR(xR);
bDL = drcD.svf_bp_procL(xL); bDR = drcD.svf_bp_procR(xR);

slider8 >= 0.5 ? (
  slider9 >= 0.5 && slider12 > 0.1 ? (
    eA = max(abs(bAL), abs(bAR)) * in_drive_lin * drcA.sens_lin;
    drcA_env = eA > drcA_env ? (drc_att * drcA_env + (1 - drc_att) * eA) : (drc_rel * drcA_env + (1 - drc_rel) * eA);
    ovA = lin2db(drcA_env) - (-10.0 - (slider12 * 0.01) * 30.0);
    drcA_gr_db = ovA > 0 ? min(12.0, ovA * 0.65) : 0;
    redA = 1.0 - db2lin(-drcA_gr_db);
    xL -= bAL * redA; xR -= bAR * redA;
  ) : ( drcA_gr_db = 0; redA = 0; );
  slider13 >= 0.5 && slider16 > 0.1 ? (
    eB = max(abs(bBL), abs(bBR)) * in_drive_lin * drcB.sens_lin;
    drcB_env = eB > drcB_env ? (drc_att * drcB_env + (1 - drc_att) * eB) : (drc_rel * drcB_env + (1 - drc_rel) * eB);
    ovB = lin2db(drcB_env) - (-10.0 - (slider16 * 0.01) * 30.0);
    drcB_gr_db = ovB > 0 ? min(12.0, ovB * 0.65) : 0;
    redB = 1.0 - db2lin(-drcB_gr_db);
    xL -= bBL * redB; xR -= bBR * redB;
  ) : ( drcB_gr_db = 0; redB = 0; );
  slider17 >= 0.5 && slider20 > 0.1 ? (
    eC = max(abs(bCL), abs(bCR)) * in_drive_lin * drcC.sens_lin;
    drcC_env = eC > drcC_env ? (drc_att * drcC_env + (1 - drc_att) * eC) : (drc_rel * drcC_env + (1 - drc_rel) * eC);
    ovC = lin2db(drcC_env) - (-10.0 - (slider20 * 0.01) * 30.0);
    drcC_gr_db = ovC > 0 ? min(12.0, ovC * 0.65) : 0;
    redC = 1.0 - db2lin(-drcC_gr_db);
    xL -= bCL * redC; xR -= bCR * redC;
  ) : ( drcC_gr_db = 0; redC = 0; );
  slider21 >= 0.5 && slider24 > 0.1 ? (
    eD = max(abs(bDL), abs(bDR)) * in_drive_lin * drcD.sens_lin;
    drcD_env = eD > drcD_env ? (drc_att * drcD_env + (1 - drc_att) * eD) : (drc_rel * drcD_env + (1 - drc_rel) * eD);
    ovD = lin2db(drcD_env) - (-10.0 - (slider24 * 0.01) * 30.0);
    drcD_gr_db = ovD > 0 ? min(12.0, ovD * 0.65) : 0;
    redD = 1.0 - db2lin(-drcD_gr_db);
    xL -= bDL * redD; xR -= bDR * redD;
  ) : ( drcD_gr_db = 0; redD = 0; );
) : (
  drcA_gr_db = drcB_gr_db = drcC_gr_db = drcD_gr_db = 0;
  redA = redB = redC = redD = 0;
);
ui_drcA = drcA_gr_db > ui_drcA ? (drc_ui_att * ui_drcA + (1 - drc_ui_att) * drcA_gr_db) : (drc_ui_rel * ui_drcA + (1 - drc_ui_rel) * drcA_gr_db);
ui_drcB = drcB_gr_db > ui_drcB ? (drc_ui_att * ui_drcB + (1 - drc_ui_att) * drcB_gr_db) : (drc_ui_rel * ui_drcB + (1 - drc_ui_rel) * drcB_gr_db);
ui_drcC = drcC_gr_db > ui_drcC ? (drc_ui_att * ui_drcC + (1 - drc_ui_att) * drcC_gr_db) : (drc_ui_rel * ui_drcC + (1 - drc_ui_rel) * drcC_gr_db);
ui_drcD = drcD_gr_db > ui_drcD ? (drc_ui_att * ui_drcD + (1 - drc_ui_att) * drcD_gr_db) : (drc_ui_rel * ui_drcD + (1 - drc_ui_rel) * drcD_gr_db);
ui_drc_gr_db = max(max(ui_drcA, ui_drcB), max(ui_drcC, ui_drcD));

// ---- Stage 4: Dynamic EQ (5-Band Phase-Coherent 2-SVF Tree calibrated on MagicFlow AU) ----
s_deq_inL = xL; s_deq_inR = xR;
slider26 >= 0.5 && slider28 > 0.1 ? (
  deq_svf1.svf_split_procL(xL); deq_svf1.svf_split_procR(xR);
  deq_svf2.svf_split_procL(deq_svf1.hpL); deq_svf2.svf_split_procR(deq_svf1.hpR);

  // 5 phase-coherent bands whose sum is identically xL / xR:
  d0L = deq_svf1.lpL; d0R = deq_svf1.lpR; // Band 0: Sub (<100 Hz)
  d1L = deq_svf1.bpL; d1R = deq_svf1.bpR; // Band 1: Body (~200 Hz)
  d2L = deq_svf2.lpL; d2R = deq_svf2.lpR; // Band 2: Pivot (~800 Hz)
  d3L = deq_svf2.bpL; d3R = deq_svf2.bpR; // Band 3: Bite (~2.9 kHz)
  d4L = deq_svf2.hpL; d4R = deq_svf2.hpR; // Band 4: Air (>7 kHz)

  r0 = max(abs(d0L), abs(d0R)) * in_drive_lin;
  r1 = max(abs(d1L), abs(d1R)) * in_drive_lin;
  r2 = max(abs(d2L), abs(d2R)) * in_drive_lin;
  r3 = max(abs(d3L), abs(d3R)) * in_drive_lin;
  r4 = max(abs(d4L), abs(d4R)) * in_drive_lin;

  // Cross-band detector coupling (matches shapes.csv multi-probe widths)
  c0 = max(r0, max(0.90 * r1, 0.15 * r2));
  c1 = max(r1, max(0.75 * r0, 0.65 * r2));
  c2 = max(r2, max(0.65 * r1, 0.65 * r3));
  c3 = max(r3, max(0.75 * r2, 0.80 * r4));
  c4 = max(r4, max(0.75 * r3, 0.30 * r2));

  deq_e0 = c0 > deq_e0 ? (deq_att_lo  * deq_e0 + (1 - deq_att_lo)  * c0) : (deq_rel_lo  * deq_e0 + (1 - deq_rel_lo)  * c0);
  deq_e1 = c1 > deq_e1 ? (deq_att_lo  * deq_e1 + (1 - deq_att_lo)  * c1) : (deq_rel_lo  * deq_e1 + (1 - deq_rel_lo)  * c1);
  deq_e2 = c2 > deq_e2 ? (deq_att_mid * deq_e2 + (1 - deq_att_mid) * c2) : (deq_rel_mid * deq_e2 + (1 - deq_rel_mid) * c2);
  deq_e3 = c3 > deq_e3 ? (deq_att_hi  * deq_e3 + (1 - deq_att_hi)  * c3) : (deq_rel_hi  * deq_e3 + (1 - deq_rel_hi)  * c3);
  deq_e4 = c4 > deq_e4 ? (deq_att_hi  * deq_e4 + (1 - deq_att_hi)  * c4) : (deq_rel_hi  * deq_e4 + (1 - deq_rel_hi)  * c4);

  // Peak-equivalent dBFS detector level (pi/2 compensation for average rectified value of sine)
  deq_gdb0 = deq_calc_band_db(lin2db(deq_e0 * 1.42), deq_lift0, deq_T0, deq_S0, deq_M0);
  deq_gdb1 = deq_calc_band_db(lin2db(deq_e1 * 1.42), deq_lift0, deq_T1, deq_S1, deq_M1);
  deq_gdb2 = deq_calc_band_db(lin2db(deq_e2 * 1.42), deq_lift0, deq_T2, deq_S2, deq_M2);
  deq_gdb3 = deq_calc_band_db(lin2db(deq_e3 * 1.42), deq_lift0, deq_T3, deq_S3, deq_M3);
  deq_gdb4 = deq_calc_band_db(lin2db(deq_e4 * 1.42), deq_lift0, deq_T4, deq_S4, deq_M4);

  dg0 = db2lin(deq_gdb0);
  dg1 = db2lin(deq_gdb1);
  dg2 = db2lin(deq_gdb2);
  dg3 = db2lin(deq_gdb3);
  dg4 = db2lin(deq_gdb4);

  xL = d0L * dg0 + d1L * dg1 + d2L * dg2 + d3L * dg3 + d4L * dg4;
  xR = d0R * dg0 + d1R * dg1 + d2R * dg2 + d3R * dg3 + d4R * dg4;

  // Dynamic cut below rest lift for telemetry
  deq_lo_db = max(0, deq_lift0 - min(deq_gdb0, deq_gdb1));
  deq_hi_db = max(0, deq_lift0 - min(deq_gdb3, deq_gdb4));
  deq_gr_db = max(deq_lo_db, deq_hi_db);
) : (
  deq_gdb0 = deq_gdb1 = deq_gdb2 = deq_gdb3 = deq_gdb4 = 0;
  deq_lo_db = deq_hi_db = deq_gr_db = 0;
);
ui_deq_lo = ui_deq_lo * 0.995 + deq_lo_db * 0.005;
ui_deq_hi = ui_deq_hi * 0.995 + deq_hi_db * 0.005;
ui_deq0 = ui_deq0 * 0.98 + deq_gdb0 * 0.02;
ui_deq1 = ui_deq1 * 0.98 + deq_gdb1 * 0.02;
ui_deq2 = ui_deq2 * 0.98 + deq_gdb2 * 0.02;
ui_deq3 = ui_deq3 * 0.98 + deq_gdb3 * 0.02;
ui_deq4 = ui_deq4 * 0.98 + deq_gdb4 * 0.02;
s_deq_dL = xL - s_deq_inL; s_deq_dR = xR - s_deq_inR;

// ---- Stage 5: Tone EQ + Mid Bump ----
s_ton_inL = xL; s_ton_inR = xR;
slider29 >= 0.5 ? (
  xL = tone_lo.bq_procL(xL); xL = tone_mid.bq_procL(xL); xL = tone_hi.bq_procL(xL);
  xR = tone_lo.bq_procR(xR); xR = tone_mid.bq_procR(xR); xR = tone_hi.bq_procR(xR);
);
slider32 >= 0.5 ? (
  xL = mid_bump_bq.bq_procL(xL) * mid_bump_gain;
  xR = mid_bump_bq.bq_procR(xR) * mid_bump_gain;
);
s_ton_dL = xL - s_ton_inL; s_ton_dR = xR - s_ton_inR;

// ---- Stage 6: Dynamic Balance (analisi sempre attiva, correzione solo se ON) ----
db_loL += dbal_c_lo * (xL - db_loL);
db_loR += dbal_c_lo * (xR - db_loR);
db_top_lpL += dbal_c_hi * (xL - db_top_lpL);
db_top_lpR += dbal_c_hi * (xR - db_top_lpR);
band_loL = db_loL;                 band_loR = db_loR;
band_midL = db_top_lpL - db_loL;   band_midR = db_top_lpR - db_loR;
band_hiL = xL - db_top_lpL;        band_hiR = xR - db_top_lpR;
dbal_low_env += dbal_env_c * (0.5*(abs(band_loL)+abs(band_loR)) - dbal_low_env);
dbal_mid_env += dbal_env_c * (0.5*(abs(band_midL)+abs(band_midR)) - dbal_mid_env);
dbal_hi_env  += dbal_env_c * (0.5*(abs(band_hiL)+abs(band_hiR)) - dbal_hi_env);
tot_e = max(0.0005, dbal_low_env + dbal_mid_env + dbal_hi_env);
ui_sh_lo = dbal_low_env / tot_e; ui_sh_mid = dbal_mid_env / tot_e; ui_sh_hi = dbal_hi_env / tot_e;

s_dbal_inL = xL; s_dbal_inR = xR;
slider33 >= 0.5 && slider35 > 0.1 ? (
  dbal_bt = slider35 * 0.01;
  dbal_mB = slider34 >= 0.5;
  // Livelli equivalenti per banda (compensati sul riferimento -14.7 dB delle misure AU)
  dbal_L_lo  = lin2db(dbal_low_env * 2.4 * in_drive_lin) + 3.3;
  dbal_L_mid = lin2db(dbal_mid_env * 2.1 * in_drive_lin) + 3.3;
  dbal_L_hi  = lin2db(dbal_hi_env  * 3.2 * in_drive_lin) + 3.3;

  // Curva Upward/Downward Multiband Leveler misurata su MagicFlow AU (Mode A: +7.8 dB @100%/-26dBFS; Mode B: +9.4 dB @100%/-26dBFS)
  dbal_gdb_lo  = dbal_band_curve_db(dbal_L_lo,  dbal_bt, dbal_mB,  0.35) + ((t_lo  - ui_sh_lo)  * 4.5) * dbal_bt;
  dbal_gdb_mid = dbal_band_curve_db(dbal_L_mid, dbal_bt, dbal_mB,  0.20) + ((t_mid - ui_sh_mid) * 3.8) * dbal_bt;
  dbal_gdb_hi  = dbal_band_curve_db(dbal_L_hi,  dbal_bt, dbal_mB, -0.45) + ((t_hi  - ui_sh_hi)  * 4.8) * dbal_bt;

  g_lo  = db2lin(clamp(dbal_gdb_lo,  -12.0, 14.5));
  g_mid = db2lin(clamp(dbal_gdb_mid, -12.0, 14.5));
  g_hi  = db2lin(clamp(dbal_gdb_hi,  -12.0, 14.5));

  s_loL = band_loL * g_lo;    s_loR = band_loR * g_lo;
  s_midL = band_midL * g_mid; s_midR = band_midR * g_mid;
  s_hiL = band_hiL * g_hi;    s_hiR = band_hiR * g_hi;
  sat_dr = 0.06 * dbal_bt;
  !db_active_prev ? (
    db_lo_px_l = s_loL; db_lo_px_r = s_loR;
    db_lo_ym_l = db_lo_yc_l = db_lo_ym_r = db_lo_yc_r = 0;
    db_md_px_l = s_midL; db_md_px_r = s_midR;
    db_md_ym_l = db_md_yc_l = db_md_ym_r = db_md_yc_r = 0;
    db_hi_px_l = s_hiL; db_hi_px_r = s_hiR;
    db_in_d1_l = s_dbal_inL; db_in_d1_r = s_dbal_inR;
    db_dry_d1_l = dry_curL; db_dry_d1_r = dry_curR;
    db_mdry_d1_l = mix_dry_curL; db_mdry_d1_r = mix_dry_curR;
    db_active_prev = 1;
  );
  // Oversampling 2x sul SOLO residuo f(x)-x di Low/Mid + allineamento 1-campione su High: 0.00 dB piatto sul crossover
  db_lo_ml = 0.5 * (db_lo_px_l + s_loL); db_lo_mr = 0.5 * (db_lo_px_r + s_loR);
  db_lo_yml = dbal_sat_shape(db_lo_ml, sat_dr) - db_lo_ml; db_lo_ymr = dbal_sat_shape(db_lo_mr, sat_dr) - db_lo_mr;
  db_lo_ycl = dbal_sat_shape(s_loL, sat_dr) - s_loL;       db_lo_ycr = dbal_sat_shape(s_loR, sat_dr) - s_loR;
  db_lo_ol = db_lo_px_l + 0.25 * db_lo_ym_l + 0.50 * db_lo_yc_l + 0.25 * db_lo_yml;
  db_lo_or = db_lo_px_r + 0.25 * db_lo_ym_r + 0.50 * db_lo_yc_r + 0.25 * db_lo_ymr;
  db_lo_px_l = s_loL; db_lo_px_r = s_loR;
  db_lo_ym_l = db_lo_yml; db_lo_ym_r = db_lo_ymr; db_lo_yc_l = db_lo_ycl; db_lo_yc_r = db_lo_ycr;

  db_md_ml = 0.5 * (db_md_px_l + s_midL); db_md_mr = 0.5 * (db_md_px_r + s_midR);
  db_md_yml = dbal_sat_shape(db_md_ml, sat_dr) - db_md_ml; db_md_ymr = dbal_sat_shape(db_md_mr, sat_dr) - db_md_mr;
  db_md_ycl = dbal_sat_shape(s_midL, sat_dr) - s_midL;     db_md_ycr = dbal_sat_shape(s_midR, sat_dr) - s_midR;
  db_md_ol = db_md_px_l + 0.25 * db_md_ym_l + 0.50 * db_md_yc_l + 0.25 * db_md_yml;
  db_md_or = db_md_px_r + 0.25 * db_md_ym_r + 0.50 * db_md_yc_r + 0.25 * db_md_ymr;
  db_md_px_l = s_midL; db_md_px_r = s_midR;
  db_md_ym_l = db_md_yml; db_md_ym_r = db_md_ymr; db_md_yc_l = db_md_ycl; db_md_yc_r = db_md_ycr;

  db_hi_ol = db_hi_px_l; db_hi_or = db_hi_px_r;
  db_hi_px_l = s_hiL;    db_hi_px_r = s_hiR;

  xL = db_lo_ol + db_md_ol + db_hi_ol;
  xR = db_lo_or + db_md_or + db_hi_or;
  s_dbal_dL = xL - db_in_d1_l; s_dbal_dR = xR - db_in_d1_r;
  db_in_d1_l = s_dbal_inL; db_in_d1_r = s_dbal_inR;
  db_tmp_d = dry_curL; dry_curL = db_dry_d1_l; db_dry_d1_l = db_tmp_d;
  db_tmp_d = dry_curR; dry_curR = db_dry_d1_r; db_dry_d1_r = db_tmp_d;
  db_tmp_d = mix_dry_curL; mix_dry_curL = db_mdry_d1_l; db_mdry_d1_l = db_tmp_d;
  db_tmp_d = mix_dry_curR; mix_dry_curR = db_mdry_d1_r; db_mdry_d1_r = db_tmp_d;
  dbal_act_pct = min(100, (abs(dbal_gdb_lo) + abs(dbal_gdb_mid) + abs(dbal_gdb_hi)) * 4.2 + deq_gr_db * 4);
) : (
  db_active_prev = 0;
  g_lo = g_mid = g_hi = 1;
  s_dbal_dL = 0; s_dbal_dR = 0;
  dbal_act_pct = min(100, deq_gr_db * 8);
);
ui_dbal_glo  = ui_dbal_glo  * 0.98 + g_lo  * 0.02;
ui_dbal_gmid = ui_dbal_gmid * 0.98 + g_mid * 0.02;
ui_dbal_ghi  = ui_dbal_ghi  * 0.98 + g_hi  * 0.02;

// ---- DRC Solo (Sistema a molla: suona in preascolto SOLO mentre premi SOLO o tocchi i 3 rotori della banda attiva) ----
drc_solo_audition_band == 1 && slider8 >= 0.5 && slider9  >= 0.5 ? ( xL = bAL * (1.0 - redA); xR = bAR * (1.0 - redA); ) :
drc_solo_audition_band == 2 && slider8 >= 0.5 && slider13 >= 0.5 ? ( xL = bBL * (1.0 - redB); xR = bBR * (1.0 - redB); ) :
drc_solo_audition_band == 3 && slider8 >= 0.5 && slider17 >= 0.5 ? ( xL = bCL * (1.0 - redC); xR = bCR * (1.0 - redC); ) :
drc_solo_audition_band == 4 && slider8 >= 0.5 && slider21 >= 0.5 ? ( xL = bDL * (1.0 - redD); xR = bDR * (1.0 - redD); );

// ---- Stage 7: Output ----
in_sq = 0.5 * (dry_curL*dry_curL + dry_curR*dry_curR);
out_sq = 0.5 * (xL*xL + xR*xR);
gm_rms_in  += gm_coeff * (in_sq - gm_rms_in);
gm_rms_out += gm_coeff * (out_sq - gm_rms_out);
// GAIN MATCH e LEGA OUTPUT compensano lo stesso guadagno: con un LEGA OUTPUT attivo (lk_any) il Gain Match si sospende (guadagno 1), niente doppia correzione.
slider38 >= 0.5 && !lk_any && gm_rms_out > 0.00001 && gm_rms_in > 0.00001 ? (
  gm_target = clamp(sqrt(gm_rms_in / gm_rms_out), 0.70, 1.45);
  gm_gain = gm_gain * 0.998 + gm_target * 0.002;
) : ( gm_gain = 1.0; );

wetL = xL * gm_gain * out_gain_lin;
wetR = xR * gm_gain * out_gain_lin;

(delta_spring_stage > 0 && delta_spring_stage < 12) || delta_spring_stage == 13 ? (
  delta_spring_stage == 13 ? ( spl0 = s_ins_dL;   spl1 = s_ins_dR;   ) :
  delta_spring_stage == 1  ? ( spl0 = s_flt_dL;   spl1 = s_flt_dR;   ) :
  delta_spring_stage == 2  ? ( spl0 = s_pre_dL;   spl1 = s_pre_dR;   ) :
  delta_spring_stage == 3  ? ( spl0 = s_pk_dL;    spl1 = s_pk_dR;    ) :
  delta_spring_stage == 4  ? ( spl0 = -bAL*redA;  spl1 = -bAR*redA;  ) :
  delta_spring_stage == 5  ? ( spl0 = -bBL*redB;  spl1 = -bBR*redB;  ) :
  delta_spring_stage == 6  ? ( spl0 = -bCL*redC;  spl1 = -bCR*redC;  ) :
  delta_spring_stage == 7  ? ( spl0 = -bDL*redD;  spl1 = -bDR*redD;  ) :
  delta_spring_stage == 8  ? ( spl0 = s_deq_dL;   spl1 = s_deq_dR;   ) :
  delta_spring_stage == 9  ? ( spl0 = s_ton_dL;   spl1 = s_ton_dR;   ) :
  delta_spring_stage == 10 ? ( spl0 = s_dbal_dL;  spl1 = s_dbal_dR;  ) :
                             ( spl0 = wetL - dry_curL; spl1 = wetR - dry_curR; );
  delta_spring_stage != 11 ? ( spl0 *= out_gain_lin; spl1 *= out_gain_lin; );
) : slider39 >= 0.5 ? (
  spl0 = wetL - dry_curL;
  spl1 = wetR - dry_curR;
) : (
  mix_w = slider36 * 0.01;
  spl0 = wetL * mix_w + mix_dry_curL * (1.0 - mix_w);
  spl1 = wetR * mix_w + mix_dry_curR * (1.0 - mix_w);
);
pre_limL = spl0; pre_limR = spl1;

slider40 >= 0.5 ? (
  curL = spl0; curR = spl1;
  // Rilevamento True Peak 4x cubico reale (Catmull-Rom) + micro-attacco morbido + catcher 2x solo sul residuo
  pk = max(tp_isp4_chan(tp_h3_l, tp_h2_l, tp_h1_l, curL), tp_isp4_chan(tp_h3_r, tp_h2_r, tp_h1_r, curR));
  tp_h3_l = tp_h2_l; tp_h2_l = tp_h1_l; tp_h1_l = curL;
  tp_h3_r = tp_h2_r; tp_h2_r = tp_h1_r; tp_h1_r = curR;
  tp_prevL = curL; tp_prevR = curR;
  tp_meter_peak = max(pk, tp_meter_peak * 0.9995);
  tp_tgt = pk > tp_ceiling ? (tp_ceiling / pk) : 1.0;
  tp_gr = tp_tgt < tp_gr ? (tp_att_coeff * tp_gr + (1.0 - tp_att_coeff) * tp_tgt) : (tp_rel_coeff * tp_gr + (1.0 - tp_rel_coeff) * tp_tgt);
  tp_gr = clamp(tp_gr, 0.0, 1.0);
  spl0 *= tp_gr; spl1 *= tp_gr;
  // Arrotondamento dolce 2x oversampled sul SOLO residuo negli ultimi 1.0 dB sotto ceiling: 0.00 dB perdita lineare
  tp_sk_thr = tp_ceiling * 0.89125094;
  !tp_active_prev ? (
    tp_os_px_l = spl0; tp_os_px_r = spl1;
    tp_os_ym_l = tp_os_yc_l = tp_os_ym_r = tp_os_yc_r = 0;
    tp_prelim_d1_l = pre_limL; tp_prelim_d1_r = pre_limR;
    tp_active_prev = 1;
  );
  tp_ml = 0.5 * (tp_os_px_l + spl0); tp_mr = 0.5 * (tp_os_px_r + spl1);
  tp_yml = tp_soft_shape(tp_ml, tp_sk_thr, tp_ceiling) - tp_ml; tp_ymr = tp_soft_shape(tp_mr, tp_sk_thr, tp_ceiling) - tp_mr;
  tp_ycl = tp_soft_shape(spl0,  tp_sk_thr, tp_ceiling) - spl0;  tp_ycr = tp_soft_shape(spl1,  tp_sk_thr, tp_ceiling) - spl1;
  tp_rl = 0.25 * tp_os_ym_l + 0.50 * tp_os_yc_l + 0.25 * tp_yml;
  tp_rr = 0.25 * tp_os_ym_r + 0.50 * tp_os_yc_r + 0.25 * tp_ymr;
  tp_os_ym_l = tp_yml; tp_os_ym_r = tp_ymr; tp_os_yc_l = tp_ycl; tp_os_yc_r = tp_ycr;
  tp_out_l = tp_os_px_l + tp_rl; tp_os_px_l = spl0;
  tp_out_r = tp_os_px_r + tp_rr; tp_os_px_r = spl1;
  spl0 = tp_soft_shape(tp_out_l, tp_ceiling * 0.985, tp_ceiling);
  spl1 = tp_soft_shape(tp_out_r, tp_ceiling * 0.985, tp_ceiling);
  pre_lim_alignedL = tp_prelim_d1_l; pre_lim_alignedR = tp_prelim_d1_r;
  tp_prelim_d1_l = pre_limL; tp_prelim_d1_r = pre_limR;
  tp_gr_smooth = tp_gr_smooth * 0.92 + tp_gr * 0.08;
  ui_tp_gr_db = tp_gr_smooth < 0.999 ? -lin2db(tp_gr_smooth) : 0.0;
) : (
  tp_active_prev = 0;
  tp_h3_l = tp_h2_l; tp_h2_l = tp_h1_l; tp_h1_l = spl0;
  tp_h3_r = tp_h2_r; tp_h2_r = tp_h1_r; tp_h1_r = spl1;
  tp_prevL = spl0; tp_prevR = spl1;
  tp_gr = 1.0; tp_gr_smooth = 1.0;
  pre_lim_alignedL = pre_limL; pre_lim_alignedR = pre_limR;
  tp_meter_peak = max(max(abs(spl0), abs(spl1)), tp_meter_peak * 0.9995);
  ui_tp_gr_db = 0;
);
delta_spring_stage == 12 ? (
  spl0 = spl0 - pre_lim_alignedL;
  spl1 = spl1 - pre_lim_alignedR;
);

ui_rms_in_sq  = ui_rms_in_sq * meter_decay_ui + (1 - meter_decay_ui) * in_sq;
ui_rms_out_sq = ui_rms_out_sq * meter_decay_ui + (1 - meter_decay_ui) * (0.5 * (spl0*spl0 + spl1*spl1));
ui_rms_in_db  = ui_rms_in_sq  > 0.000000001 ? 10 * log10(ui_rms_in_sq)  : -60;
ui_rms_out_db = ui_rms_out_sq > 0.000000001 ? 10 * log10(ui_rms_out_sq) : -60;

// Blocco analisi lento (4 s di parlato attivo, 2° ordine) escluso durante DELTA / MOLLA / SOLO
audition_active = (slider39 >= 0.5) || (delta_spring_stage > 0) || (drc_solo_audition_band > 0);
!audition_active ? (
  out_m = 0.5 * (spl0 + spl1);
  sug_lo1 += sug_c_lo * (out_m - sug_lo1); sug_lo2 += sug_c_lo * (sug_lo1 - sug_lo2);
  sug_hi1 += sug_c_hi * (out_m - sug_hi1); sug_h1 = out_m - sug_hi1;
  sug_hi2 += sug_c_hi * (sug_h1 - sug_hi2); sug_h2 = sug_h1 - sug_hi2;
  sug_mhp += sug_c_mhp * (out_m - sug_mhp); sug_m1 = out_m - sug_mhp;
  sug_mlp += sug_c_hi * (sug_m1 - sug_mlp);
  ui_rms_in_sq > 0.0000316 ? (
    sug_blk_in_sq += in_sq;
    sug_blk_p_lo  += sug_lo2 * sug_lo2;
    sug_blk_p_mid += sug_mlp * sug_mlp;
    sug_blk_p_hi  += sug_h2  * sug_h2;
    sug_blk_pk_gr += tot_pk_gr_db;
    sug_blk_drcA  += drcA_gr_db;
    sug_blk_drcB  += drcB_gr_db;
    sug_blk_drcC  += drcC_gr_db;
    sug_blk_drcD  += drcD_gr_db;
    sug_blk_dbal  += dbal_act_pct;
    sug_blk_lim   += ui_tp_gr_db;
    sug_blk_n += 1;
    sug_blk_n >= sug_blk_target ? (
      inv_n = 1.0 / sug_blk_n;
      sug_avg_in_db     = 10 * log10(max(0.000000000001, sug_blk_in_sq * inv_n));
      sug_avg_hi_mid_db = 10 * log10(max(0.000000000001, sug_blk_p_hi) / max(0.000000000001, sug_blk_p_mid));
      sug_avg_lo_mid_db = 10 * log10(max(0.000000000001, sug_blk_p_lo) / max(0.000000000001, sug_blk_p_mid));
      sug_avg_pk_gr     = sug_blk_pk_gr * inv_n;
      sug_avg_drcA      = sug_blk_drcA  * inv_n;
      sug_avg_drcB      = sug_blk_drcB  * inv_n;
      sug_avg_drcC      = sug_blk_drcC  * inv_n;
      sug_avg_drcD      = sug_blk_drcD  * inv_n;
      sug_avg_dbal      = sug_blk_dbal  * inv_n;
      sug_avg_lim       = sug_blk_lim   * inv_n;
      sug_ready = 1;
      sug_blk_in_sq = 0; sug_blk_p_lo = 0; sug_blk_p_mid = 0; sug_blk_p_hi = 0;
      sug_blk_pk_gr = 0; sug_blk_drcA = 0; sug_blk_drcB = 0; sug_blk_drcC = 0; sug_blk_drcD = 0;
      sug_blk_dbal = 0; sug_blk_lim = 0; sug_blk_n = 0;
    );
  );
);

@serialize
ab_ver = 1; file_var(0, ab_ver);
ab_ver == 1 ? (
  file_var(0, ab_on); file_var(0, ab_cur);
  ab_i = 0; loop(64, file_var(0, AB_MEM[ab_i]); file_var(0, AB_MEM[100 + ab_i]); ab_i += 1; );
) : ( ab_on = 0; ab_cur = 1; );

@gfx 1240 900
// ============================================================================
// GUI — scalabile: layout in unita' di progetto (larghezza 1100), scala sc.
// La GUI legge soltanto variabili del DSP; non scrive nulla nel percorso audio
// tranne i parametri (slider) scelti dall'utente.
// ============================================================================
zp_hb = gmem[3900]; zp_hb_now = time_precise();
!zp_hb_seen ? (zp_hb_last = zp_hb; zp_hb_seen = 1; zp_hb_t = -10;) : zp_hb != zp_hb_last ? (zp_hb_last = zp_hb; zp_hb_t = zp_hb_now;);
zp_hb_ok = zp_hb > 0 && zp_hb_now - zp_hb_t < 3;
ui_gfx_frame += 1;
time_now = time_precise();
zp_hb_ok ? ( help_bridge_last_alive_t = time_now; ui_lang = gmem[3901] == 1 ? 1 : 0; ) :
           ( time_now - help_bridge_last_alive_t > 3.0 ? ui_lang = 0; );

show_simple = floor(slider42 + 0.5) == 0;
view_mode = floor(slider43 + 0.5);
view_mode != prev_view_mode ? update_view_mode_visibility();
mon_sel = floor(slider52 + 0.5);
ana_on = slider51 >= 0.5;

// ---- Scala ----
HB = 32; AB = 58;
content_bottom = view_mode == 0 ? 754 : view_mode == 1 ? 384 : 226;
designH = content_bottom + 10 + HB + (ana_on ? AB : 0);
sc = max(0.7, min(2.2, min(gfx_w / 1100, gfx_h / designH)));
ox = max(0, (gfx_w - 1100 * sc) * 0.5);
view_hd = gfx_h / sc;
help_yd = view_hd - HB;
ana_yd = help_yd - AB;
bars_top_d = ana_on ? ana_yd : help_yd;
xl_d = -ox / sc;
xr_d = (gfx_w - ox) / sc;

gfx_setfont(1, "Arial", 22 * sc, 'b');
gfx_setfont(2, "Arial", 14.5 * sc);
gfx_setfont(3, "Arial", 14 * sc, 'b');
gfx_setfont(4, "Arial", 13.5 * sc, 'b');
gfx_setfont(5, "Arial", 13 * sc);
gfx_setfont(6, "Arial", 12 * sc, 'b');
gfx_setfont(7, "Arial", 11.5 * sc);
gfx_setfont(8, "Arial", 11 * sc, 'b');

show_simple ? (
  bg_r = 0.92; bg_g = 0.94; bg_b = 0.97;
  panel_r = 0.97; panel_g = 0.98; panel_b = 0.99;
  panel2_r = 0.89; panel2_g = 0.92; panel2_b = 0.96;
  text_r = 0.12; text_g = 0.16; text_b = 0.22;
  sub_r = 0.32; sub_g = 0.39; sub_b = 0.47;
  line_r = 0.70; line_g = 0.77; line_b = 0.85;
) : (
  bg_r = 0.05; bg_g = 0.06; bg_b = 0.08;
  panel_r = 0.10; panel_g = 0.12; panel_b = 0.15;
  panel2_r = 0.14; panel2_g = 0.17; panel2_b = 0.21;
  text_r = 0.90; text_g = 0.92; text_b = 0.95;
  sub_r = 0.66; sub_g = 0.70; sub_b = 0.76;
  line_r = 0.26; line_g = 0.30; line_b = 0.36;
);
c_cyan_r = 0.15; c_cyan_g = 0.69; c_cyan_b = 0.84;
c_amber_r = 0.92; c_amber_g = 0.58; c_amber_b = 0.18;
c_ins_r = 0.92; c_ins_g = 0.44; c_ins_b = 0.26;
c_mag_r = 0.82; c_mag_g = 0.34; c_mag_b = 0.56;
c_grn_r = 0.26; c_grn_g = 0.76; c_grn_b = 0.46;
// LEGA OUTPUT: colore unico del legame; i comandi coinvolti prendono questo colore quando sono legati
c_lnk_r = 0.64; c_lnk_g = 0.48; c_lnk_b = 1.00;
lk_gt = slider54 >= 0.5; lk_gd = slider53 >= 0.5; lk_gq = slider55 >= 0.5; lk_gp = slider56 >= 0.5;
lkp_r = lk_gp ? c_lnk_r : c_amber_r; lkp_g = lk_gp ? c_lnk_g : c_amber_g; lkp_b = lk_gp ? c_lnk_b : c_amber_b;
lkp7_r = lk_gp ? c_lnk_r : c_cyan_r; lkp7_g = lk_gp ? c_lnk_g : c_cyan_g; lkp7_b = lk_gp ? c_lnk_b : c_cyan_b;
lki_r = (lk_gd || lk_gq || lk_gp) ? c_lnk_r : c_cyan_r; lki_g = (lk_gd || lk_gq || lk_gp) ? c_lnk_g : c_cyan_g; lki_b = (lk_gd || lk_gq || lk_gp) ? c_lnk_b : c_cyan_b;
lkq_r = lk_gq ? c_lnk_r : c_cyan_r;  lkq_g = lk_gq ? c_lnk_g : c_cyan_g;  lkq_b = lk_gq ? c_lnk_b : c_cyan_b;
lkt_r = lk_gt ? c_lnk_r : c_amber_r; lkt_g = lk_gt ? c_lnk_g : c_amber_g; lkt_b = lk_gt ? c_lnk_b : c_amber_b;
lkm_r = lk_gt ? c_lnk_r : c_mag_r;   lkm_g = lk_gt ? c_lnk_g : c_mag_g;   lkm_b = lk_gt ? c_lnk_b : c_mag_b;
lkd_r = lk_gd ? c_lnk_r : c_grn_r;   lkd_g = lk_gd ? c_lnk_g : c_grn_g;   lkd_b = lk_gd ? c_lnk_b : c_grn_b;
lko_r = (lk_gt || lk_gd || lk_gq || lk_gp) ? c_lnk_r : c_cyan_r; lko_g = (lk_gt || lk_gd || lk_gq || lk_gp) ? c_lnk_g : c_cyan_g; lko_b = (lk_gt || lk_gd || lk_gq || lk_gp) ? c_lnk_b : c_cyan_b;

// ---- Mouse (unita' di progetto) ----
mxd = (mouse_x - ox) / sc;
myd = mouse_y / sc;
mouse_down = mouse_cap & 1;
mouse_click_raw = mouse_down && !(last_mouse_cap & 1);
mouse_rclick_raw = (mouse_cap & 2) && !(last_mouse_cap & 2);
mouse_click = mouse_click_raw && myd < bars_top_d;
mouse_right_click = mouse_rclick_raw && myd < bars_top_d;
fine_tune = (mouse_cap & 8) ? 0.08 : 1.0;
// Edit frequency in place; discard pending input when focus or control changes.
mouse_click_raw || mouse_rclick_raw ? lab_edit = 0;
lab_key = gfx_getchar();
while (lab_key > 0) (
  lab_edit ? (
    lab_key >= 48 && lab_key <= 57 && lab_digits < 5 ? (
      lab_value = lab_value*10 + lab_key-48; lab_digits += 1;
    ) : lab_key == 8 ? (
      lab_value = floor(lab_value/10); lab_digits = max(0,lab_digits-1);
    ) : lab_key == 27 ? lab_edit = 0 :
    lab_key == 13 && lab_digits && lab_value >= lab_min && lab_value <= lab_max ? (
      (lab_edit == 10 || lab_edit == 14 || lab_edit == 18 || lab_edit == 22) && lab_edit_lp > 0 ? (
        cur_lo = clamp(min(slider(lab_edit), slider(lab_edit_lp)), 20, 19980);
        cur_hi = clamp(max(cur_lo + 20, max(slider(lab_edit), slider(lab_edit_lp))), 40, 20000);
        cur_oct = clamp(log(cur_hi / cur_lo) / log(2.0), 0.12, 3.50);
        set_drc_band_fc_oct(lab_edit, lab_edit_lp, lab_value, cur_oct);
      ) : (
        set_param_slider(lab_edit, lab_value); set_param_slider(44, 0); prev_osara_preset = 0;
        update_dsp_params();
      );
      lab_edit = 0; lab_edit_lp = 0;
    );
  );
  lab_key = gfx_getchar();
);
active_info_id = 0;
ui_hover_link_on = 0;
ui_hover_comp_db = 0;
cur_mod = -1;

// ---- Helper di disegno ----
function gxp(x) ( floor(ox + x * sc + 0.5); );
function gyp(y) ( floor(y * sc + 0.5); );
function g_rect(x, y, w, h) ( gfx_rect(gxp(x), gyp(y), max(1, floor(w * sc + 0.5)), max(1, floor(h * sc + 0.5))); );
function g_frame(x, y, w, h) local(X, Y, W, H) (
  X = gxp(x); Y = gyp(y); W = max(2, floor(w * sc + 0.5)); H = max(2, floor(h * sc + 0.5));
  gfx_rect(X, Y, W, 1); gfx_rect(X, Y + H - 1, W, 1); gfx_rect(X, Y, 1, H); gfx_rect(X + W - 1, Y, 1, H);
);
function g_line(x1, y1, x2, y2) ( gfx_line(ox + x1 * sc, y1 * sc, ox + x2 * sc, y2 * sc, 1); );
function g_circ(x, y, r, f) ( gfx_circle(ox + x * sc, y * sc, r * sc, f, 1); );
function g_arc(x, y, r, a1, a2) ( gfx_arc(ox + x * sc, y * sc, r * sc, a1, a2, 1); );
function g_txt(x, y, s) ( gfx_x = gxp(x); gfx_y = gyp(y); gfx_drawstr(s); );
function g_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function g_th() local(tw, th) ( gfx_measurestr("Ag", tw, th); th / sc; );
function g_txtc(cx, y, s) ( g_txt(cx - g_tw(s) * 0.5, y, s); );
function g_txtr(xr, y, s) ( g_txt(xr - g_tw(s), y, s); );
function hit(x, y, w, h) ( mxd >= x && mxd <= x + w && myd >= y && myd <= y + h; );
function msg(it, en) ( ui_lang == 1 ? en : it; );
function set_text_col() ( gfx_r = text_r; gfx_g = text_g; gfx_b = text_b; gfx_a = 1; );
function set_sub_col() ( gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; );

function fmt_freq(dst, v) local(k) (
  v >= 1000 ? (
    k = v / 1000;
    abs(k - floor(k + 0.5)) < 0.05 ? sprintf(dst, "%.0fk", k) : sprintf(dst, "%.1fk", k);
  ) : sprintf(dst, "%.0f", v);
  dst;
);
function fmt_gr(dst, gr) (
  gr < 0.05 ? sprintf(dst, "0.0 dB") : sprintf(dst, "-%.1f dB", gr);
  dst;
);
function band_role(fa, fb) local(c) (
  c = sqrt(max(20, fa) * max(20, fb));
  c < 250 ? "LOW" : c < 1100 ? "BOX" : c < 3000 ? "HARSH" : c < 5500 ? "PRES" : c < 11000 ? "SIB" : "AIR";
);
function set_mon(m) ( m >= 0 ? set_ui_state(52, m); );

function draw_panel(x, y, w, h) (
  gfx_r = panel_r; gfx_g = panel_g; gfx_b = panel_b; gfx_a = 1; g_rect(x, y, w, h);
  gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.9; g_frame(x, y, w, h);
);
function draw_panel_hl(x, y, w, h, is_act, rr, gg, bb) (
  gfx_r = panel_r; gfx_g = panel_g; gfx_b = panel_b; gfx_a = 1; g_rect(x, y, w, h);
  is_act ? (
    gfx_r = rr; gfx_g = gg; gfx_b = bb;
    gfx_a = show_simple ? 0.08 : 0.09; g_rect(x + 1, y + 1, w - 2, h - 2);
    gfx_a = 0.98; g_frame(x, y, w, h);
    gfx_a = 0.65; g_frame(x + 1, y + 1, w - 2, h - 2);
  ) : (
    gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.85; g_frame(x, y, w, h);
  );
);
function draw_mon_badge(xr, y, is_act, hv, rr, gg, bb) local(bw, bh, bx, th) (
  is_act ? (
    bw = 62; bh = 16; bx = xr - bw;
    gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = 0.96; g_rect(bx, y, bw, bh);
    gfx_setfont(7); gfx_r = 0.04; gfx_g = 0.05; gfx_b = 0.07; gfx_a = 1;
    th = g_th();
    g_txtc(bx + bw * 0.5, y + (bh - th) * 0.5, "MONITOR");
  ) : (
    gfx_setfont(7); gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = hv ? 0.95 : 0.45;
    g_txtr(xr, y + 2, "monitor");
  );
);
// titolo cliccabile: seleziona il modulo nel monitor
function draw_group_title_ex(x, y, w, h, lbl, rr, gg, bb, mon, is_act) local(hv, ty_txt, by_bdg) (
  hv = mon >= 0 && hit(x, y, w, h);
  hv ? ( active_info_id = mon == 2 ? 233 : 232; mouse_click ? set_mon(mon); );
  mon < 0 ? (
    gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = 0.95; g_rect(x, y, w, 4);
  ) : is_act ? (
    gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = 1; g_rect(x, y, w, 5);
    gfx_a = show_simple ? 0.28 : 0.34; g_rect(x + 1, y + 5, w - 2, h - 5);
    gfx_a = 0.70; g_rect(x + 1, y + h - 1, w - 2, 1);
  ) : (
    gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = hv ? 0.85 : 0.45; g_rect(x, y, w, 3);
    hv ? ( gfx_a = 0.14; g_rect(x + 1, y + 3, w - 2, h - 3); );
  );
  h >= 26 ? gfx_setfont(3) : gfx_setfont(6);
  is_act ? (
    show_simple ? ( gfx_r = 0.06; gfx_g = 0.08; gfx_b = 0.12; ) : ( gfx_r = 0.98; gfx_g = 0.99; gfx_b = 1.0; );
    gfx_a = 1;
  ) : (
    set_text_col();
    mon >= 0 ? ( gfx_a = 0.88; );
  );
  ty_txt = y + floor((h - g_th()) * 0.5) + 1;
  g_txt(x + 12, ty_txt, lbl);
  mon >= 0 ? (
    by_bdg = y + floor((h - 16) * 0.5) + 1;
    draw_mon_badge(x + w - 8, by_bdg, is_act, hv, rr, gg, bb);
  );
);
function draw_group_title(x, y, w, lbl, rr, gg, bb, mon) (
  draw_group_title_ex(x, y, w, 28, lbl, rr, gg, bb, mon, mon >= 0 && mon == mon_sel);
);
function draw_meter_h(x, y, w, h, val_pct, rr, gg, bb) local(fill) (
  gfx_r = show_simple ? 0.80 : 0.07; gfx_g = show_simple ? 0.84 : 0.09; gfx_b = show_simple ? 0.90 : 0.13; gfx_a = 1;
  g_rect(x, y, w, h);
  fill = clamp(w * val_pct * 0.01, 0, w);
  fill > 0 ? ( gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = 0.98; g_rect(x, y, fill, h); );
);
function draw_hw_led(hw_x, hw_y, hw_r, is_on, is_hover, cr, cg, cb) local(hw_bzr, hw_bzg, hw_bzb, hw_rmr, hw_rmg, hw_rmb, hw_dr, hw_dg, hw_db) (
  // Ghiera metallica esterna del LED
  show_simple ? (
    hw_bzr = 0.28; hw_bzg = 0.33; hw_bzb = 0.40;
    hw_rmr = 0.58; hw_rmg = 0.64; hw_rmb = 0.72;
  ) : (
    hw_bzr = 0.03; hw_bzg = 0.04; hw_bzb = 0.05;
    hw_rmr = 0.34; hw_rmg = 0.38; hw_rmb = 0.45;
  );
  gfx_r = hw_bzr; gfx_g = hw_bzg; gfx_b = hw_bzb; gfx_a = 0.98;
  g_circ(hw_x, hw_y, hw_r + 1.6, 1);
  gfx_r = hw_rmr; gfx_g = hw_rmg; gfx_b = hw_rmb; gfx_a = 0.80;
  g_circ(hw_x, hw_y, hw_r + 1.6, 0);
  is_on ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb;
    gfx_a = show_simple ? 0.22 : 0.28;
    g_circ(hw_x, hw_y, hw_r + 3.8, 1);
    gfx_a = 0.42;
    g_circ(hw_x, hw_y, hw_r + 1.9, 1);
    gfx_r = min(1, cr * 1.15 + 0.08); gfx_g = min(1, cg * 1.15 + 0.08); gfx_b = min(1, cb * 1.15 + 0.08);
    gfx_a = 1;
    g_circ(hw_x, hw_y, hw_r, 1);
    gfx_r = min(1, cr * 0.45 + 0.55); gfx_g = min(1, cg * 0.45 + 0.55); gfx_b = min(1, cb * 0.45 + 0.55);
    gfx_a = 0.62;
    g_circ(hw_x - hw_r * 0.14, hw_y - hw_r * 0.14, hw_r * 0.46, 1);
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.88;
    g_circ(hw_x - hw_r * 0.34, hw_y - hw_r * 0.34, max(0.75, hw_r * 0.22), 1);
  ) : (
    show_simple ? (
      hw_dr = 0.20 + cr * 0.16; hw_dg = 0.23 + cg * 0.16; hw_db = 0.27 + cb * 0.16;
    ) : (
      hw_dr = 0.07 + cr * 0.14; hw_dg = 0.08 + cg * 0.14; hw_db = 0.10 + cb * 0.14;
    );
    is_hover ? ( hw_dr = min(1, hw_dr + 0.08); hw_dg = min(1, hw_dg + 0.08); hw_db = min(1, hw_db + 0.08); );
    gfx_r = hw_dr; gfx_g = hw_dg; gfx_b = hw_db; gfx_a = 1;
    g_circ(hw_x, hw_y, hw_r, 1);
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = is_hover ? 0.34 : 0.22;
    g_circ(hw_x - hw_r * 0.32, hw_y - hw_r * 0.32, max(0.65, hw_r * 0.18), 1);
  );
);

function draw_dymo_plate(hw_x, hw_y, hw_w, hw_h, lbl, is_on, is_hover, cr, cg, cb, hw_font, hw_acc) local(hw_br, hw_bg, hw_bb, hw_th) (
  // Ombra aderente della fascetta vinilica Dymo sulla lamiera
  gfx_r = 0.03; gfx_g = 0.04; gfx_b = 0.05; gfx_a = show_simple ? 0.42 : 0.78;
  g_rect(hw_x + 1, hw_y + 1, hw_w, hw_h);
  is_on ? (
    hw_br = show_simple ? 0.11 : 0.07; hw_bg = show_simple ? 0.12 : 0.08; hw_bb = show_simple ? 0.14 : 0.10;
  ) : (
    hw_br = show_simple ? 0.20 : 0.11; hw_bg = show_simple ? 0.22 : 0.12; hw_bb = show_simple ? 0.25 : 0.14;
  );
  is_hover ? ( hw_br += 0.04; hw_bg += 0.04; hw_bb += 0.04; );
  gfx_r = hw_br; gfx_g = hw_bg; gfx_b = hw_bb; gfx_a = 0.98;
  g_rect(hw_x, hw_y, hw_w, hw_h);
  // Riflesso satinato superiore
  gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.06;
  g_rect(hw_x + 1, hw_y + 1, hw_w - 2, 1);
  // Bordo targhetta
  is_hover ? (
    gfx_r = min(1, cr + 0.18); gfx_g = min(1, cg + 0.18); gfx_b = min(1, cb + 0.18); gfx_a = 0.92;
  ) : is_on ? (
    gfx_r = cr * 0.60; gfx_g = cg * 0.60; gfx_b = cb * 0.60; gfx_a = 0.70;
  ) : (
    gfx_r = show_simple ? 0.40 : 0.27; gfx_g = show_simple ? 0.44 : 0.30; gfx_b = show_simple ? 0.49 : 0.35; gfx_a = 0.72;
  );
  g_frame(hw_x, hw_y, hw_w, hw_h);
  // Eventuale filetto di banda (es. bande DRC A..D)
  hw_acc >= 0.5 ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = is_on ? 0.92 : 0.32;
    g_rect(hw_x + 1, hw_y + hw_h - 2, hw_w - 2, 2);
  );
  gfx_setfont(hw_font);
  is_on ? (
    gfx_r = 0.96; gfx_g = 0.95; gfx_b = 0.90; gfx_a = 1;
  ) : (
    gfx_r = is_hover ? 0.90 : 0.66; gfx_g = is_hover ? 0.90 : 0.68; gfx_b = is_hover ? 0.88 : 0.72; gfx_a = 1;
  );
  hw_th = g_th();
  g_txtc(hw_x + hw_w * 0.5, hw_y + (hw_h - hw_th) * 0.5 - (hw_acc >= 0.5 ? 0.5 : 0), lbl);
);

function draw_hw_pushcap(hw_x, hw_y, hw_w, hw_h, is_on, is_hover, cr, cg, cb, enabled) local(hw_br, hw_bg, hw_bb, hw_lw, hw_lh) (
  // Sede incassata
  gfx_r = show_simple ? 0.46 : 0.03; gfx_g = show_simple ? 0.51 : 0.04; gfx_b = show_simple ? 0.58 : 0.05;
  gfx_a = enabled ? 0.92 : 0.40;
  g_rect(hw_x - 1, hw_y - 1, hw_w + 2, hw_h + 2);
  // Corpo tasto tattile (incassato se is_on, sollevato con smusso se spento)
  is_on ? (
    hw_br = show_simple ? 0.66 : 0.14; hw_bg = show_simple ? 0.70 : 0.16; hw_bb = show_simple ? 0.75 : 0.19;
  ) : (
    hw_br = show_simple ? 0.82 : 0.22; hw_bg = show_simple ? 0.85 : 0.25; hw_bb = show_simple ? 0.89 : 0.29;
  );
  is_hover && enabled ? ( hw_br += 0.05; hw_bg += 0.05; hw_bb += 0.05; );
  gfx_r = min(1, hw_br); gfx_g = min(1, hw_bg); gfx_b = min(1, hw_bb);
  gfx_a = enabled ? 1 : 0.42;
  g_rect(hw_x, hw_y, hw_w, hw_h);
  // Smusso 3D
  is_on ? (
    gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = enabled ? 0.38 : 0.18;
    g_rect(hw_x, hw_y, hw_w, 1); g_rect(hw_x, hw_y, 1, hw_h);
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = enabled ? 0.10 : 0.05;
    g_rect(hw_x + 1, hw_y + hw_h - 1, hw_w - 1, 1);
  ) : (
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = enabled ? (show_simple ? 0.65 : 0.16) : 0.06;
    g_rect(hw_x, hw_y, hw_w - 1, 1); g_rect(hw_x, hw_y, 1, hw_h - 1);
    gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = enabled ? 0.35 : 0.15;
    g_rect(hw_x + 1, hw_y + hw_h - 1, hw_w - 1, 1);
  );
  is_hover && enabled ? (
    gfx_r = min(1, cr + 0.18); gfx_g = min(1, cg + 0.18); gfx_b = min(1, cb + 0.18); gfx_a = 0.88;
  ) : is_on && enabled ? (
    gfx_r = cr * 0.80; gfx_g = cg * 0.80; gfx_b = cb * 0.80; gfx_a = 0.82;
  ) : (
    gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = enabled ? 0.78 : 0.35;
  );
  g_frame(hw_x, hw_y, hw_w, hw_h);
  // Finestrella LED interna nella parte alta del tasto
  hw_lw = max(6, hw_w - 6); hw_lh = 3.5;
  is_on && enabled ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 0.28;
    g_rect(hw_x + 1, hw_y + 1, hw_w - 2, 7);
    gfx_r = min(1, cr * 1.15 + 0.10); gfx_g = min(1, cg * 1.15 + 0.10); gfx_b = min(1, cb * 1.15 + 0.10); gfx_a = 1;
    g_rect(hw_x + 3, hw_y + 3, hw_lw, hw_lh);
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.55;
    g_rect(hw_x + 4, hw_y + 3, max(2, hw_lw - 4), 1);
  ) : (
    gfx_r = show_simple ? (0.36 + cr * 0.16) : (0.08 + cr * 0.15);
    gfx_g = show_simple ? (0.38 + cg * 0.16) : (0.09 + cg * 0.15);
    gfx_b = show_simple ? (0.42 + cb * 0.16) : (0.11 + cb * 0.15);
    gfx_a = enabled ? 0.88 : 0.32;
    g_rect(hw_x + 3, hw_y + 3, hw_lw, hw_lh);
  );
);

function hw_key_face_ex(bx, by, bw, bh, lbl, is_on, is_hover, cr, cg, cb, hw_fnt, hw_dim) local(hw_br, hw_bg, hw_bb, hw_bar, hw_th) (
  show_simple ? (
    is_on ? (
      hw_br = min(1, 0.83 + cr * 0.08); hw_bg = min(1, 0.86 + cg * 0.08); hw_bb = min(1, 0.90 + cb * 0.08);
    ) : (
      hw_br = 0.93; hw_bg = 0.95; hw_bb = 0.97;
    );
    is_hover ? ( hw_br -= 0.04; hw_bg -= 0.04; hw_bb -= 0.04; );
  ) : (
    is_on ? (
      hw_br = 0.10 + cr * 0.08; hw_bg = 0.12 + cg * 0.08; hw_bb = 0.16 + cb * 0.08;
    ) : (
      hw_br = panel2_r - 0.01; hw_bg = panel2_g - 0.01; hw_bb = panel2_b - 0.01;
    );
    is_hover ? ( hw_br += 0.05; hw_bg += 0.05; hw_bb += 0.05; );
  );
  gfx_r = hw_br; gfx_g = hw_bg; gfx_b = hw_bb; gfx_a = 1;
  g_rect(bx, by, bw, bh);
  hw_bar = bh < 20 ? 2 : 3;
  is_on ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = hw_dim >= 0.5 ? 0.42 : 0.98;
    g_rect(bx + 1, by + 1, bw - 2, hw_bar);
    gfx_a = hw_dim >= 0.5 ? 0.08 : 0.16;
    g_rect(bx + 1, by + 1 + hw_bar, bw - 2, 2);
  ) : (
    gfx_r = cr * 0.35 + (show_simple ? 0.30 : 0.06);
    gfx_g = cg * 0.35 + (show_simple ? 0.32 : 0.07);
    gfx_b = cb * 0.35 + (show_simple ? 0.35 : 0.08);
    gfx_a = is_hover ? 0.65 : 0.34;
    g_rect(bx + 1, by + 1, bw - 2, hw_bar);
  );
  is_hover ? (
    gfx_r = min(1, cr + 0.18); gfx_g = min(1, cg + 0.18); gfx_b = min(1, cb + 0.18); gfx_a = 0.92;
  ) : is_on ? (
    gfx_r = cr * 0.78; gfx_g = cg * 0.78; gfx_b = cb * 0.78; gfx_a = hw_dim >= 0.5 ? 0.48 : 0.85;
  ) : (
    gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.88;
  );
  g_frame(bx, by, bw, bh);
  gfx_setfont(hw_fnt);
  is_on ? (
    show_simple ? ( gfx_r = 0.08; gfx_g = 0.10; gfx_b = 0.14; ) : ( gfx_r = 0.96; gfx_g = 0.97; gfx_b = 0.99; );
    gfx_a = hw_dim >= 0.5 ? 0.65 : 1;
  ) : (
    set_text_col();
    gfx_a = is_hover ? 1.0 : (hw_dim >= 0.5 ? 0.62 : 0.86);
  );
  hw_th = g_th();
  g_txtc(bx + bw * 0.5, by + (bh - hw_th) * 0.5 + 1.0, lbl);
);

function hw_key_face(bx, by, bw, bh, lbl, is_on, is_hover, cr, cg, cb) (
  hw_key_face_ex(bx, by, bw, bh, lbl, is_on, is_hover, cr, cg, cb, 6, 0);
);

function ui_hw_push_face(bx, by, bw, bh, lbl, is_on, is_hover, cr, cg, cb, enabled) local(hw_cap, hw_tw, hw_th, hw_sx, hw_cy) (
  is_hover && enabled ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = show_simple ? 0.10 : 0.09;
    g_rect(bx, by, bw, bh);
    gfx_a = 0.45;
    g_frame(bx, by, bw, bh);
  );
  hw_cap = min(15, bh - 8);
  gfx_setfont(8);
  hw_tw = g_tw(lbl);
  hw_th = g_th();
  hw_sx = max(bx + 2, bx + (bw - (hw_cap + 5 + hw_tw)) * 0.5);
  hw_cy = by + (bh - hw_cap) * 0.5;
  draw_hw_pushcap(hw_sx, hw_cy, hw_cap, hw_cap, is_on, is_hover, cr, cg, cb, enabled);
  !enabled ? (
    set_sub_col(); gfx_a = 0.34;
  ) : is_on ? (
    show_simple ? ( gfx_r = 0.08; gfx_g = 0.10; gfx_b = 0.14; ) : ( gfx_r = 0.96; gfx_g = 0.97; gfx_b = 0.99; );
    gfx_a = 1;
  ) : (
    set_text_col(); gfx_a = is_hover ? 0.98 : 0.78;
  );
  g_txt(hw_sx + hw_cap + 5, by + (bh - hw_th) * 0.5, lbl);
);

function btn_face(bx, by, bw, bh, label, is_on, is_hover, cr, cg, cb) (
  hw_key_face(bx, by, bw, bh, label, is_on, is_hover, cr, cg, cb);
);
// Spia gioiello dinamica PEAK GR (senza scritta: si illumina proporzionalmente alla riduzione reale in dB)
function draw_peak_gr_led(hw_x, hw_y, hw_r, stg_on, gr_db, is_hover)
local(hw_bzr, hw_bzg, hw_bzb, hw_rmr, hw_rmg, hw_rmb, lvl, hot, cr, cg, cb, dr, dg, db) (
  show_simple ? (
    hw_bzr = 0.28; hw_bzg = 0.33; hw_bzb = 0.40;
    hw_rmr = 0.58; hw_rmg = 0.64; hw_rmb = 0.72;
  ) : (
    hw_bzr = 0.03; hw_bzg = 0.04; hw_bzb = 0.05;
    hw_rmr = 0.34; hw_rmg = 0.38; hw_rmb = 0.45;
  );
  gfx_r = hw_bzr; gfx_g = hw_bzg; gfx_b = hw_bzb; gfx_a = 0.98;
  g_circ(hw_x, hw_y, hw_r + 1.6, 1);
  gfx_r = hw_rmr; gfx_g = hw_rmg; gfx_b = hw_rmb; gfx_a = 0.82;
  g_circ(hw_x, hw_y, hw_r + 1.6, 0);
  lvl = (stg_on && gr_db > 0.06) ? clamp(0.24 + 0.76 * sqrt(clamp(gr_db / 6.0, 0, 1)), 0, 1) : 0;
  hot = clamp((gr_db - 4.0) / 6.0, 0, 1);
  cr = 0.96 + 0.04 * hot;
  cg = 0.64 - 0.32 * hot;
  cb = 0.14;
  show_simple ? (
    dr = stg_on ? 0.34 : 0.24; dg = stg_on ? 0.30 : 0.26; db = stg_on ? 0.22 : 0.30;
  ) : (
    dr = stg_on ? 0.16 : 0.08; dg = stg_on ? 0.12 : 0.09; db = stg_on ? 0.07 : 0.11;
  );
  is_hover ? ( dr = min(1, dr + 0.07); dg = min(1, dg + 0.07); db = min(1, db + 0.07); );
  lvl > 0.01 ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb;
    gfx_a = (show_simple ? 0.24 : 0.32) * lvl;
    g_circ(hw_x, hw_y, hw_r + 1.8 + 2.6 * lvl, 1);
    gfx_a = 0.46 * lvl;
    g_circ(hw_x, hw_y, hw_r + 1.7, 1);
    gfx_r = dr + (min(1, cr * 1.12 + 0.06) - dr) * lvl;
    gfx_g = dg + (min(1, cg * 1.12 + 0.06) - dg) * lvl;
    gfx_b = db + (min(1, cb * 1.12 + 0.06) - db) * lvl;
    gfx_a = 1;
    g_circ(hw_x, hw_y, hw_r, 1);
    gfx_r = min(1, cr * 0.45 + 0.55); gfx_g = min(1, cg * 0.45 + 0.55); gfx_b = min(1, cb * 0.45 + 0.55);
    gfx_a = 0.62 * lvl;
    g_circ(hw_x - hw_r * 0.14, hw_y - hw_r * 0.14, hw_r * 0.46, 1);
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.35 + 0.55 * lvl;
