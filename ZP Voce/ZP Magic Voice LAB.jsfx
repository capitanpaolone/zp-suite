    set_param_slider(13, 1); set_param_slider(14, 260);  set_param_slider(15, 520);   set_param_slider(16, 66.0);
    set_param_slider(17, 1); set_param_slider(18, 1600); set_param_slider(19, 2900);  set_param_slider(20, 58.0);
    set_param_slider(21, 1); set_param_slider(22, 11500);set_param_slider(23, 18500); set_param_slider(24, 62.0);
    set_param_slider(26, 1); set_param_slider(27, 2);    set_param_slider(28, 56.0);
    set_param_slider(29, 1); set_param_slider(30, 2);    set_param_slider(31, 1.35);  set_param_slider(32, 1);
    set_param_slider(33, 1); set_param_slider(34, 1);    set_param_slider(35, 54.0);
    set_param_slider(36, 85);  set_param_slider(37, -1.0);
  ) : pid == 6 ? (
    // BROADCAST READY (drive -2.5 dB)
    set_param_slider(1, -2.5);
    set_param_slider(2, 85); set_param_slider(3, 17500); set_param_slider(4, 1);
    set_param_slider(5, 1);
    set_param_slider(6, 62.0); set_param_slider(7, 1);
    set_param_slider(8, 1);
    set_param_slider(9, 1);  set_param_slider(10, 6400); set_param_slider(11, 10500); set_param_slider(12, 72.0);
    set_param_slider(13, 1); set_param_slider(14, 220);  set_param_slider(15, 390);   set_param_slider(16, 54.0);
    set_param_slider(17, 1); set_param_slider(18, 1800); set_param_slider(19, 3100);  set_param_slider(20, 46.0);
    set_param_slider(21, 0); set_param_slider(22, 9000); set_param_slider(23, 15000); set_param_slider(24, 0.0);
    set_param_slider(26, 1); set_param_slider(27, 3);    set_param_slider(28, 48.0);
    set_param_slider(29, 1); set_param_slider(30, 3);    set_param_slider(31, 1.65);  set_param_slider(32, 1);
    set_param_slider(33, 1); set_param_slider(34, 1);    set_param_slider(35, 42.0);
    set_param_slider(36, 92);  set_param_slider(37, -1.2);
  ) : pid == 7 ? (
    // MAGIC 1 (da Magic1.mfp di Paolo: drive -3.3 dB)
    set_param_slider(1, -3.3);
    set_param_slider(2, 66); set_param_slider(3, 18561); set_param_slider(4, 1);
    set_param_slider(5, 0);
    set_param_slider(6, 39.7); set_param_slider(7, 1);
    set_param_slider(8, 1);
    set_param_slider(9, 1);  set_param_slider(10, 20);   set_param_slider(11, 200);   set_param_slider(12, 72.2);
    set_param_slider(13, 1); set_param_slider(14, 1565); set_param_slider(15, 2261);  set_param_slider(16, 81.0);
    set_param_slider(17, 1); set_param_slider(18, 3600); set_param_slider(19, 5734);  set_param_slider(20, 88.7);
    set_param_slider(21, 0); set_param_slider(22, 5024); set_param_slider(23, 8527);  set_param_slider(24, 88.6);
    set_param_slider(26, 1); set_param_slider(27, 1);    set_param_slider(28, 37.7);
    set_param_slider(29, 1); set_param_slider(30, 1);    set_param_slider(31, 3.06);  set_param_slider(32, 0);
    set_param_slider(33, 1); set_param_slider(34, 0);    set_param_slider(35, 39.1);
    set_param_slider(36, 100); set_param_slider(37, 0.3);
  );
  set_param_slider(25, 0);
);

// ---------------- Filtri ----------------
function svf_bp_coeff(f_a, f_b, sr) local(lo, hi, fc, bw, w0) (
  lo = max(20, min(f_a, f_b));
  hi = max(lo + 20, max(f_a, f_b));
  fc = min(sqrt(lo * hi), sr * 0.44);
  bw = max(20, hi - lo);
  this.q = clamp(fc / bw, 0.5, 12.0);
  w0 = 2 * $pi * fc / sr;
  this.g = tan(w0 * 0.5);
  this.k = 1.0 / this.q;
  this.a1 = 1.0 / (1.0 + this.g * (this.g + this.k));
  this.a2 = this.g * this.a1;
  this.a3 = this.g * this.a2;
);
function svf_bp_procL(x) local(v3, v1, v2) (
  v3 = x - this.ic2L;
  v1 = this.a1 * this.ic1L + this.a2 * v3;
  v2 = this.ic2L + this.a2 * this.ic1L + this.a3 * v3;
  this.ic1L = 2.0 * v1 - this.ic1L;
  this.ic2L = 2.0 * v2 - this.ic2L;
  v1 * this.k;
);
function svf_bp_procR(x) local(v3, v1, v2) (
  v3 = x - this.ic2R;
  v1 = this.a1 * this.ic1R + this.a2 * v3;
  v2 = this.ic2R + this.a2 * this.ic1R + this.a3 * v3;
  this.ic1R = 2.0 * v1 - this.ic1R;
  this.ic2R = 2.0 * v2 - this.ic2R;
  v1 * this.k;
);
function bq_peaking(freq, q_val, gain_db, sr) local(Ag, w0, cw, sw, alpha, a0_inv) (
  freq = clamp(freq, 20, sr * 0.45);
  Ag = 10 ^ (gain_db / 40.0);
  w0 = 2 * $pi * freq / sr;
  cw = cos(w0); sw = sin(w0);
  alpha = sw / (2.0 * max(0.2, q_val));
  a0_inv = 1.0 / (1.0 + alpha / Ag);
  this.b0 = (1.0 + alpha * Ag) * a0_inv;
  this.b1 = (-2.0 * cw) * a0_inv;
  this.b2 = (1.0 - alpha * Ag) * a0_inv;
  this.a1 = this.b1;
  this.a2 = (1.0 - alpha / Ag) * a0_inv;
);
function bq_procL(x) local(y) (
  y = this.b0 * x + this.b1 * this.x1L + this.b2 * this.x2L - this.a1 * this.y1L - this.a2 * this.y2L;
  this.x2L = this.x1L; this.x1L = x; this.y2L = this.y1L; this.y1L = y; y;
);
function bq_procR(x) local(y) (
  y = this.b0 * x + this.b1 * this.x1R + this.b2 * this.x2R - this.a1 * this.y1R - this.a2 * this.y2R;
  this.x2R = this.x1R; this.x1R = x; this.y2R = this.y1R; this.y1R = y; y;
);

function svf_split_coeff(fc, q_val, sr) local(w0) (
  fc = clamp(fc, 20, sr * 0.44);
  this.q = max(0.25, q_val);
  w0 = 2 * $pi * fc / sr;
  this.g = tan(w0 * 0.5);
  this.k = 1.0 / this.q;
  this.a1 = 1.0 / (1.0 + this.g * (this.g + this.k));
  this.a2 = this.g * this.a1;
  this.a3 = this.g * this.a2;
);
function svf_split_procL(x) local(v3, v1, v2) (
  v3 = x - this.ic2L;
  v1 = this.a1 * this.ic1L + this.a2 * v3;
  v2 = this.ic2L + this.a2 * this.ic1L + this.a3 * v3;
  this.ic1L = 2.0 * v1 - this.ic1L;
  this.ic2L = 2.0 * v2 - this.ic2L;
  this.lpL = v2;
  this.bpL = v1 * this.k;
  this.hpL = x - v2 - this.bpL;
);
function svf_split_procR(x) local(v3, v1, v2) (
  v3 = x - this.ic2R;
  v1 = this.a1 * this.ic1R + this.a2 * v3;
  v2 = this.ic2R + this.a2 * this.ic1R + this.a3 * v3;
  this.ic1R = 2.0 * v1 - this.ic1R;
  this.ic2R = 2.0 * v2 - this.ic2R;
  this.lpR = v2;
  this.bpR = v1 * this.k;
  this.hpR = x - v2 - this.bpR;
);
function deq_calc_band_db(L_db, lift0, T_db, S_val, M_db) local(ex, sex, cut) (
  ex = L_db - T_db;
  sex = 0.5 * (ex + sqrt(ex * ex + 64.0)) - 1.6;
  sex < 0 ? sex = 0.0;
  cut = min(M_db, S_val * sex);
  lift0 - cut;
);

function dbal_band_curve_db(L_db, b_t, modeB, tilt_db) local(u, shape, max_lift26, lift26, slope_lo, slope_hi, d26, comp) (
  b_t <= 0.001 ? 0.0 : (
    u = max(0.0, (b_t - 0.18) / 0.82);
    shape = 1.0 - exp(-3.2 * pow(u, 1.35));
    max_lift26 = modeB ? 9.65 : 7.90;
    lift26 = max_lift26 * shape;
    slope_lo = (0.14 + 0.60 * pow(u, 1.1)) * (modeB ? 1.12 : 1.0);
    slope_hi = (0.46 + 0.18 * u) * (modeB ? 1.12 : 1.0);
    d26 = L_db - (-26.0);
    d26 <= 0 ? (
      comp = max(-14.0, d26) * (0.35 * pow(u, 1.4));
    ) : d26 <= 8.0 ? (
      comp = -d26 * slope_lo;
    ) : (
      comp = -8.0 * slope_lo - (d26 - 8.0) * slope_hi;
    );
    clamp(lift26 + comp + tilt_db * min(1.0, b_t * 1.5), -12.0, 14.5);
  );
);

function update_dsp_params() local(sr, w_hp, cw_hp, sw_hp, al_hp, a0_hp, w_lp, cw_lp, sw_lp, al_lp, a0_lp, eq_curve, eq_scale) (
  sr = max(22050, srate);
  // Input Drive dritto (-12.0 .. +12.0 dB, default 0.0 dB): spinge i detector senza sbalzi sul percorso lineare
  in_drive_db = clamp(slider1, -12.0, 12.0);
  in_drive_lin = db2lin(in_drive_db);
  out_gain_lin = db2lin(slider37);
  tp_ceiling = db2lin(slider41);

  w_hp = 2 * $pi * clamp(slider2, 20, sr * 0.4) / sr;
  cw_hp = cos(w_hp); sw_hp = sin(w_hp); al_hp = sw_hp / 1.41421356; a0_hp = 1.0 / (1.0 + al_hp);
  hp_b0 = (1.0 + cw_hp) * 0.5 * a0_hp; hp_b1 = -(1.0 + cw_hp) * a0_hp; hp_b2 = hp_b0;
  hp_a1 = -2.0 * cw_hp * a0_hp; hp_a2 = (1.0 - al_hp) * a0_hp;

  w_lp = 2 * $pi * clamp(slider3, 4000, sr * 0.46) / sr;
  cw_lp = cos(w_lp); sw_lp = sin(w_lp); al_lp = sw_lp / 1.41421356; a0_lp = 1.0 / (1.0 + al_lp);
  lp_b0 = (1.0 - cw_lp) * 0.5 * a0_lp; lp_b1 = (1.0 - cw_lp) * a0_lp; lp_b2 = lp_b0;
  lp_a1 = -2.0 * cw_lp * a0_lp; lp_a2 = (1.0 - al_lp) * a0_lp;

  opt_att = exp(-1.0 / (sr * 0.018)); opt_rel = exp(-1.0 / (sr * 0.240));
  rc_att  = exp(-1.0 / (sr * 0.0035)); rc_rel  = exp(-1.0 / (sr * 0.085));

  drcA.svf_bp_coeff(slider10, slider11, sr);
  drcB.svf_bp_coeff(slider14, slider15, sr);
  drcC.svf_bp_coeff(slider18, slider19, sr);
  drcD.svf_bp_coeff(slider22, slider23, sr);
  drc_att = exp(-1.0 / (sr * 0.0015)); drc_rel = exp(-1.0 / (sr * 0.045));
  drc_ui_att = exp(-1.0 / (sr * 0.004));
  drc_ui_rel = exp(-1.0 / (sr * 0.140));

  // Dynamic EQ 5-band phase-coherent 2-SVF tree (calibrated to MagicFlow AU measurements)
  deq_svf1.svf_split_coeff(210.0, 0.52, sr);
  deq_svf2.svf_split_coeff(2950.0, 0.45, sr);
  deq_c = floor(slider27 + 0.5);
  deq_t = slider28 * 0.01;
  // Time constants per curve and frequency region (from steps.csv / RAPPORTO.md)
  deq_att_lo  = exp(-1.0 / (sr * (deq_c == 3 ? 0.020 : 0.015)));
  deq_rel_lo  = exp(-1.0 / (sr * (deq_c == 3 ? 0.090 : deq_c == 1 ? 0.085 : 0.075)));
  deq_att_mid = exp(-1.0 / (sr * 0.012));
  deq_rel_mid = exp(-1.0 / (sr * (deq_c == 2 ? 0.050 : 0.085)));
  deq_att_hi  = exp(-1.0 / (sr * (deq_c == 3 ? 0.008 : 0.005)));
  deq_rel_hi  = exp(-1.0 / (sr * (deq_c == 2 ? 0.038 : deq_c == 3 ? 0.095 : 0.085)));

  // Table of 50% and 100% calibrated parameters (T50, S50, M50, T100, S100, M100) for bands 0..4
  deq_c == 0 ? (
    // Curve A (Clarity)
    T50_0=-46; S50_0=0.25; M50_0=4.0;  T100_0=-48; S100_0=0.55; M100_0=16.0;
    T50_1=-28; S50_1=0.30; M50_1=6.5;  T100_1=-30; S100_1=0.70; M100_1=16.0;
    T50_2=-20; S50_2=0.35; M50_2=4.0;  T100_2=-24; S100_2=0.60; M100_2=10.5;
    T50_3=-32; S50_3=0.25; M50_3=5.5;  T100_3=-32; S100_3=0.65; M100_3=16.0;
    T50_4=-32; S50_4=0.15; M50_4=3.5;  T100_4=-30; S100_4=0.55; M100_4=13.0;
  ) : deq_c == 1 ? (
    // Curve B (Warm Control / MAGIC 1 / Female LD / Podcast1)
    T50_0=-58; S50_0=0.30; M50_0=4.0;  T100_0=-58; S100_0=0.70; M100_0=16.0;
    T50_1=-38; S50_1=0.20; M50_1=6.5;  T100_1=-36; S100_1=0.60; M100_1=17.5;
    T50_2=-24; S50_2=0.25; M50_2=4.0;  T100_2=-26; S100_2=0.60; M100_2=12.0;
    T50_3=-32; S50_3=0.20; M50_3=4.0;  T100_3=-32; S100_3=0.55; M100_3=14.0;
    T50_4=-40; S50_4=0.15; M50_4=5.0;  T100_4=-38; S100_4=0.50; M100_4=15.0;
  ) : deq_c == 2 ? (
    // Curve C (Male Focus - fast release, deep chest control)
    T50_0=-44; S50_0=1.05; M50_0=4.0;  T100_0=-50; S100_0=1.10; M100_0=16.0;
    T50_1=-34; S50_1=0.40; M50_1=7.0;  T100_1=-38; S100_1=0.75; M100_1=22.5;
    T50_2=-24; S50_2=0.25; M50_2=4.0;  T100_2=-26; S100_2=0.60; M100_2=12.0;
    T50_3=-28; S50_3=0.30; M50_3=5.0;  T100_3=-30; S100_3=0.70; M100_3=16.5;
    T50_4=-40; S50_4=0.20; M50_4=6.0;  T100_4=-44; S100_4=0.50; M100_4=18.0;
  ) : (
    // Curve D (Smooth Presence / VO1 / Bus - preserves sub low end, tames 250 Hz & 12.8 kHz)
    T50_0=-14; S50_0=0.20; M50_0=2.0;  T100_0=-18; S100_0=0.35; M100_0=4.5;
    T50_1=-22; S50_1=0.55; M50_1=8.0;  T100_1=-28; S100_1=0.70; M100_1=14.5;
    T50_2=-16; S50_2=0.35; M50_2=3.5;  T100_2=-20; S100_2=0.55; M100_2=7.5;
    T50_3=-20; S50_3=0.45; M50_3=6.5;  T100_3=-24; S100_3=0.65; M100_3=11.5;
    T50_4=-30; S50_4=0.30; M50_4=6.5;  T100_4=-32; S100_4=0.50; M100_4=13.0;
  );

  deq_t <= 0.5 ? (
    deq_u = deq_t * 2.0;
    deq_lift0 = 3.0 * deq_u;
    deq_T0 = T50_0; deq_S0 = S50_0 * deq_u; deq_M0 = M50_0 * deq_u;
    deq_T1 = T50_1; deq_S1 = S50_1 * deq_u; deq_M1 = M50_1 * deq_u;
    deq_T2 = T50_2; deq_S2 = S50_2 * deq_u; deq_M2 = M50_2 * deq_u;
    deq_T3 = T50_3; deq_S3 = S50_3 * deq_u; deq_M3 = M50_3 * deq_u;
    deq_T4 = T50_4; deq_S4 = S50_4 * deq_u; deq_M4 = M50_4 * deq_u;
  ) : (
    deq_u = (deq_t - 0.5) * 2.0;
    deq_lift0 = 3.0;
    deq_T0 = T50_0 + deq_u*(T100_0 - T50_0); deq_S0 = S50_0 + deq_u*(S100_0 - S50_0); deq_M0 = M50_0 + deq_u*(M100_0 - M50_0);
    deq_T1 = T50_1 + deq_u*(T100_1 - T50_1); deq_S1 = S50_1 + deq_u*(S100_1 - S50_1); deq_M1 = M50_1 + deq_u*(M100_1 - M50_1);
    deq_T2 = T50_2 + deq_u*(T100_2 - T50_2); deq_S2 = S50_2 + deq_u*(S100_2 - S50_2); deq_M2 = M50_2 + deq_u*(M100_2 - M50_2);
    deq_T3 = T50_3 + deq_u*(T100_3 - T50_3); deq_S3 = S50_3 + deq_u*(S100_3 - S50_3); deq_M3 = M50_3 + deq_u*(M100_3 - M50_3);
    deq_T4 = T50_4 + deq_u*(T100_4 - T50_4); deq_S4 = S50_4 + deq_u*(S100_4 - S50_4); deq_M4 = M50_4 + deq_u*(M100_4 - M50_4);
  );

  // Tone EQ calibrated on MagicFlow AU measurements (Eq_A/B/C/D + MidBump)
  eq_curve = floor(slider30 + 0.5);
  eq_scale = slider31;
  eq_curve == 0 ? (
    // Eq_A: +2.0 dB @ 140 Hz, +2.6..+3.66 dB across 1.6..9 kHz @ 3.06x
    tone_lo.bq_peaking(105,  0.55, 0.60 * eq_scale, sr);
    tone_mid.bq_peaking(1650, 0.50, 0.35 * eq_scale, sr);
    tone_hi.bq_peaking(8200, 0.35, 1.15 * eq_scale, sr);
  ) : eq_curve == 1 ? (
    // Eq_B (MAGIC 1): +1.56 dB @ 200 Hz, +1.8..+3.46 dB across 1.6..9 kHz @ 3.06x (mean err 0.23 dB)
    tone_lo.bq_peaking(190,   0.90, 0.47 * eq_scale, sr);
    tone_mid.bq_peaking(4600,  0.38, 0.92 * eq_scale, sr);
    tone_hi.bq_peaking(10200, 0.55, 0.36 * eq_scale, sr);
  ) : eq_curve == 2 ? (
    // Eq_C: +1.52 dB @ 63 Hz, flat low-mids, +1.66..+3.47 dB across 1.6..18 kHz @ 3.06x
    tone_lo.bq_peaking(65,    1.10, 0.48 * eq_scale, sr);
    tone_mid.bq_peaking(1900,  0.75, 0.28 * eq_scale, sr);
    tone_hi.bq_peaking(14500, 0.32, 1.12 * eq_scale, sr);
  ) : (
    // Eq_D: +1.51 dB @ 100 Hz, +1.95..+4.80 dB across 1.6..18 kHz @ 3.06x
    tone_lo.bq_peaking(105,   0.90, 0.48 * eq_scale, sr);
    tone_mid.bq_peaking(2600,  0.65, 0.25 * eq_scale, sr);
    tone_hi.bq_peaking(14800, 0.32, 1.54 * eq_scale, sr);
  );
  // Measured MidBump: broad +1.0 dB lift + 0.30 dB centered at 5.2 kHz
  mid_bump_bq.bq_peaking(5200, 0.45, 0.35, sr);
  mid_bump_gain = db2lin(0.98);

  dbal_c_lo = 1.0 - exp(-2.0 * $pi * 280.0 / sr);
  dbal_c_hi = 1.0 - exp(-2.0 * $pi * 2800.0 / sr);
  dbal_env_c = 1.0 - exp(-1.0 / (sr * 0.065));
  slider34 < 0.5 ? ( t_lo = 0.27; t_mid = 0.45; t_hi = 0.28; ) : ( t_lo = 0.31; t_mid = 0.43; t_hi = 0.26; );

  gm_coeff = 1.0 - exp(-1.0 / (sr * 0.350));
  meter_decay_ui = exp(-1.0 / (sr * 0.200));
  tp_rel_coeff = exp(-1.0 / (sr * 0.080));
  sug_c_lo  = 1.0 - exp(-2.0 * $pi * 250.0 / sr);
  sug_c_mhp = 1.0 - exp(-2.0 * $pi * 280.0 / sr);
  sug_c_hi  = 1.0 - exp(-2.0 * $pi * 2800.0 / sr);
  sug_env_c = 1.0 - exp(-1.0 / (sr * 1.8));
  sug_blk_target = max(1, floor(sr * 4.0));
);

function set_drc_band_fc_oct(sl_hp, sl_lp, fc_in, oct_in) local(fc, oct, half_r, lo, hi) (
  fc = clamp(fc_in, 25, 18000);
  oct = clamp(oct_in, 0.12, 3.50);
  half_r = 2 ^ (oct * 0.5);
  lo = fc / half_r;
  hi = fc * half_r;
  lo < 20 ? ( lo = 20; hi = min(20000, max(40, lo * (2 ^ oct))); );
  hi > 20000 ? ( hi = 20000; lo = max(20, min(19980, hi / (2 ^ oct))); );
  lo = floor(clamp(lo, 20, 19980) + 0.5);
  hi = floor(clamp(max(lo + 20, hi), 40, 20000) + 0.5);
  set_param_slider(sl_hp, lo);
  set_param_slider(sl_lp, hi);
  floor(slider44 + 0.5) != 0 ? ( set_param_slider(44, 0); prev_osara_preset = 0; );
  update_dsp_params();
);

update_dsp_params();

@slider
osara_p = floor(slider44 + 0.5);
osara_p > 0 && osara_p != prev_osara_preset ? (
  prev_osara_preset = osara_p;
  apply_magic_preset(osara_p);
);
osara_p == 0 ? prev_osara_preset = 0;
update_dsp_params();

@block
zp_bus_refresh(ZP_BUS_ID);
blk_now = time_precise();
// Auto-off DELTA globale dopo 30s di inattivita' (anche a finestra FX chiusa)
slider39 >= 0.5 ? (
  !prev_delta_on ? ( delta_arm_time = blk_now; prev_delta_on = 1; );
  blk_now - delta_arm_time >= 30.0 ? (
    slider39 = 0;
    sliderchange(2 ^ 38);
    prev_delta_on = 0;
  );
) : ( prev_delta_on = 0; );
// Auto-disarm DELTA MOLLA dopo 30s di inattivita' e fail-safe se la GUI chiude durante un drag
delta_spring_armed && (blk_now - delta_spring_time >= 30.0) ? (
  delta_spring_armed = 0; delta_spring_stage = 0;
);
delta_spring_stage > 0 && (blk_now - delta_spring_aud_hb > 0.4) ? (
  delta_spring_stage = 0;
);
drc_solo_audition_band > 0 && (blk_now - drc_solo_aud_hb > 0.4) ? (
  drc_solo_audition_band = 0;
);
ui_gm_db = lin2db(gm_gain);
slider45 = floor(ui_peak_gr_db * 10 + 0.5) * 0.1;
slider46 = floor(ui_drc_gr_db * 10 + 0.5) * 0.1;
slider47 = floor(dbal_act_pct + 0.5);
slider48 = floor(ui_rms_in_db * 10 + 0.5) * 0.1;
slider49 = floor(ui_rms_out_db * 10 + 0.5) * 0.1;
slider50 = floor(ui_tp_gr_db * 10 + 0.5) * 0.1;

@sample
dryL = spl0;
dryR = spl1;

// ---- Stage 1: Input (Calibrazione Drive Detector come MagicFlow AU) + Filters + Preamp ----
xL = dryL;
xR = dryR;

s_flt_inL = xL; s_flt_inR = xR;
slider4 >= 0.5 ? (
  yL = hp_b0*xL + hp_b1*hp_x1L + hp_b2*hp_x2L - hp_a1*hp_y1L - hp_a2*hp_y2L;
  hp_x2L = hp_x1L; hp_x1L = xL; hp_y2L = hp_y1L; hp_y1L = yL; xL = yL;
  yR = hp_b0*xR + hp_b1*hp_x1R + hp_b2*hp_x2R - hp_a1*hp_y1R - hp_a2*hp_y2R;
  hp_x2R = hp_x1R; hp_x1R = xR; hp_y2R = hp_y1R; hp_y1R = yR; xR = yR;
  yL = lp_b0*xL + lp_b1*lp_x1L + lp_b2*lp_x2L - lp_a1*lp_y1L - lp_a2*lp_y2L;
  lp_x2L = lp_x1L; lp_x1L = xL; lp_y2L = lp_y1L; lp_y1L = yL; xL = yL;
  yR = lp_b0*xR + lp_b1*lp_x1R + lp_b2*lp_x2R - lp_a1*lp_y1R - lp_a2*lp_y2R;
  lp_x2R = lp_x1R; lp_x1R = xR; lp_y2R = lp_y1R; lp_y1R = yR; xR = yR;
);
s_flt_dL = xL - s_flt_inL; s_flt_dR = xR - s_flt_inR;

s_pre_inL = xL; s_pre_inR = xR;
slider5 >= 0.5 ? (
  pL = xL * in_drive_lin; pR = xR * in_drive_lin;
  xL = xL + (0.08 * (pL * pL) - 0.11 * (pL * pL * pL)) / max(0.25, in_drive_lin);
  xR = xR + (0.08 * (pR * pR) - 0.11 * (pR * pR * pR)) / max(0.25, in_drive_lin);
);
s_pre_dL = xL - s_pre_inL; s_pre_dR = xR - s_pre_inR;

// ---- Stage 2: Peak Leveler (Opto + RComp, guidato da in_drive_lin come MagicFlow AU) ----
s_pk_inL = xL; s_pk_inR = xR;
slider7 >= 0.5 && slider6 > 0.1 ? (
  in_abs = max(abs(xL), abs(xR)) * in_drive_lin;
  opt_env = in_abs > opt_env ? (opt_att * opt_env + (1 - opt_att) * in_abs) : (opt_rel * opt_env + (1 - opt_rel) * in_abs);
  rcomp_env = in_abs > rcomp_env ? (rc_att * rcomp_env + (1 - rc_att) * in_abs) : (rc_rel * rcomp_env + (1 - rc_rel) * in_abs);
  pk_amt = slider6 * 0.01;
  pk_thr_db = -6.0 - pk_amt * 22.0;
  opt_db = lin2db(opt_env);
  rc_db  = lin2db(rcomp_env);
  gr_opt_db = opt_db > pk_thr_db ? (opt_db - pk_thr_db) * 0.48 : 0.0;
  gr_rc_db  = rc_db  > (pk_thr_db + 2.5) ? (rc_db - (pk_thr_db + 2.5)) * 0.62 : 0.0;
  c_opt = gr_opt_db * 0.55; c_rc = gr_rc_db * 0.45;
  tot_pk_gr_db = min(16.0, c_opt + c_rc);
  // Makeup ottico misurato su MagicFlow AU (+1.5 dB con PeakRed 39.7% e Input -3.3 dB)
  pk_makeup_db = min(5.0, pk_amt * 3.4 + clamp(-in_drive_db, -4.0, 6.0) * 0.18);
  pk_gain = db2lin(-tot_pk_gr_db + pk_makeup_db);
  xL *= pk_gain; xR *= pk_gain;
  ui_peak_gr_db = ui_peak_gr_db * 0.995 + tot_pk_gr_db * 0.005;
  ui_gr_opt = ui_gr_opt * 0.995 + c_opt * 0.005;
  ui_gr_rc  = ui_gr_rc  * 0.995 + c_rc  * 0.005;
  ui_pk_lvl_db = rc_db; ui_pk_thr_db = pk_thr_db;
) : (
  tot_pk_gr_db = 0;
  ui_peak_gr_db *= 0.99; ui_gr_opt *= 0.99; ui_gr_rc *= 0.99; ui_pk_lvl_db = -90;
);
s_pk_dL = xL - s_pk_inL; s_pk_dR = xR - s_pk_inR;

// ---- Stage 3: DRC A/B/C/D ----
bAL = drcA.svf_bp_procL(xL); bAR = drcA.svf_bp_procR(xR);
bBL = drcB.svf_bp_procL(xL); bBR = drcB.svf_bp_procR(xR);
bCL = drcC.svf_bp_procL(xL); bCR = drcC.svf_bp_procR(xR);
bDL = drcD.svf_bp_procL(xL); bDR = drcD.svf_bp_procR(xR);

slider8 >= 0.5 ? (
  slider9 >= 0.5 && slider12 > 0.1 ? (
    eA = max(abs(bAL), abs(bAR)) * in_drive_lin;
    drcA_env = eA > drcA_env ? (drc_att * drcA_env + (1 - drc_att) * eA) : (drc_rel * drcA_env + (1 - drc_rel) * eA);
    ovA = lin2db(drcA_env) - (-10.0 - (slider12 * 0.01) * 32.0);
    drcA_gr_db = ovA > 0 ? min(12.0, ovA * 0.72) : 0;
    redA = 1.0 - db2lin(-drcA_gr_db);
    xL -= bAL * redA; xR -= bAR * redA;
  ) : ( drcA_gr_db = 0; redA = 0; );
  slider13 >= 0.5 && slider16 > 0.1 ? (
    eB = max(abs(bBL), abs(bBR)) * in_drive_lin;
    drcB_env = eB > drcB_env ? (drc_att * drcB_env + (1 - drc_att) * eB) : (drc_rel * drcB_env + (1 - drc_rel) * eB);
    ovB = lin2db(drcB_env) - (-8.0 - (slider16 * 0.01) * 30.0);
    drcB_gr_db = ovB > 0 ? min(10.0, ovB * 0.65) : 0;
    redB = 1.0 - db2lin(-drcB_gr_db);
    xL -= bBL * redB; xR -= bBR * redB;
  ) : ( drcB_gr_db = 0; redB = 0; );
  slider17 >= 0.5 && slider20 > 0.1 ? (
    eC = max(abs(bCL), abs(bCR)) * in_drive_lin;
    drcC_env = eC > drcC_env ? (drc_att * drcC_env + (1 - drc_att) * eC) : (drc_rel * drcC_env + (1 - drc_rel) * eC);
    ovC = lin2db(drcC_env) - (-10.0 - (slider20 * 0.01) * 30.0);
    drcC_gr_db = ovC > 0 ? min(10.0, ovC * 0.68) : 0;
    redC = 1.0 - db2lin(-drcC_gr_db);
    xL -= bCL * redC; xR -= bCR * redC;
  ) : ( drcC_gr_db = 0; redC = 0; );
  slider21 >= 0.5 && slider24 > 0.1 ? (
    eD = max(abs(bDL), abs(bDR)) * in_drive_lin;
    drcD_env = eD > drcD_env ? (drc_att * drcD_env + (1 - drc_att) * eD) : (drc_rel * drcD_env + (1 - drc_rel) * eD);
    ovD = lin2db(drcD_env) - (-12.0 - (slider24 * 0.01) * 32.0);
    drcD_gr_db = ovD > 0 ? min(12.0, ovD * 0.72) : 0;
    redD = 1.0 - db2lin(-drcD_gr_db);
    xL -= bDL * redD; xR -= bDR * redD;
  ) : ( drcD_gr_db = 0; redD = 0; );
) : (
  drcA_gr_db = drcB_gr_db = drcC_gr_db = drcD_gr_db = 0;
  redA = redB = redC = redD = 0;
);
ui_drcA = drcA_gr_db > ui_drcA ? (drc_ui_att * ui_drcA + (1 - drc_ui_att) * drcA_gr_db) : (drc_ui_rel * ui_drcA + (1 - drc_ui_rel) * drcA_gr_db);
ui_drcB = drcB_gr_db > ui_drcB ? (drc_ui_att * ui_drcB + (1 - drc_ui_att) * drcB_gr_db) : (drc_ui_rel * ui_drcB + (1 - drc_ui_rel) * drcB_gr_db);
ui_drcC = drcC_gr_db > ui_drcC ? (drc_ui_att * ui_drcC + (1 - drc_ui_att) * drcC_gr_db) : (drc_ui_rel * ui_drcC + (1 - drc_ui_rel) * drcC_gr_db);
ui_drcD = drcD_gr_db > ui_drcD ? (drc_ui_att * ui_drcD + (1 - drc_ui_att) * drcD_gr_db) : (drc_ui_rel * ui_drcD + (1 - drc_ui_rel) * drcD_gr_db);
ui_drc_gr_db = max(max(ui_drcA, ui_drcB), max(ui_drcC, ui_drcD));

// ---- Stage 4: Dynamic EQ (5-Band Phase-Coherent 2-SVF Tree calibrated on MagicFlow AU) ----
s_deq_inL = xL; s_deq_inR = xR;
slider26 >= 0.5 && slider28 > 0.1 ? (
  deq_svf1.svf_split_procL(xL); deq_svf1.svf_split_procR(xR);
  deq_svf2.svf_split_procL(deq_svf1.hpL); deq_svf2.svf_split_procR(deq_svf1.hpR);

  // 5 phase-coherent bands whose sum is identically xL / xR:
  d0L = deq_svf1.lpL; d0R = deq_svf1.lpR; // Band 0: Sub (<100 Hz)
  d1L = deq_svf1.bpL; d1R = deq_svf1.bpR; // Band 1: Body (~200 Hz)
  d2L = deq_svf2.lpL; d2R = deq_svf2.lpR; // Band 2: Pivot (~800 Hz)
  d3L = deq_svf2.bpL; d3R = deq_svf2.bpR; // Band 3: Bite (~2.9 kHz)
  d4L = deq_svf2.hpL; d4R = deq_svf2.hpR; // Band 4: Air (>7 kHz)

  r0 = max(abs(d0L), abs(d0R)) * in_drive_lin;
  r1 = max(abs(d1L), abs(d1R)) * in_drive_lin;
  r2 = max(abs(d2L), abs(d2R)) * in_drive_lin;
  r3 = max(abs(d3L), abs(d3R)) * in_drive_lin;
  r4 = max(abs(d4L), abs(d4R)) * in_drive_lin;

  // Cross-band detector coupling (matches shapes.csv multi-probe widths)
  c0 = max(r0, max(0.90 * r1, 0.15 * r2));
  c1 = max(r1, max(0.75 * r0, 0.65 * r2));
  c2 = max(r2, max(0.65 * r1, 0.65 * r3));
  c3 = max(r3, max(0.75 * r2, 0.80 * r4));
  c4 = max(r4, max(0.75 * r3, 0.30 * r2));

  deq_e0 = c0 > deq_e0 ? (deq_att_lo  * deq_e0 + (1 - deq_att_lo)  * c0) : (deq_rel_lo  * deq_e0 + (1 - deq_rel_lo)  * c0);
  deq_e1 = c1 > deq_e1 ? (deq_att_lo  * deq_e1 + (1 - deq_att_lo)  * c1) : (deq_rel_lo  * deq_e1 + (1 - deq_rel_lo)  * c1);
  deq_e2 = c2 > deq_e2 ? (deq_att_mid * deq_e2 + (1 - deq_att_mid) * c2) : (deq_rel_mid * deq_e2 + (1 - deq_rel_mid) * c2);
  deq_e3 = c3 > deq_e3 ? (deq_att_hi  * deq_e3 + (1 - deq_att_hi)  * c3) : (deq_rel_hi  * deq_e3 + (1 - deq_rel_hi)  * c3);
  deq_e4 = c4 > deq_e4 ? (deq_att_hi  * deq_e4 + (1 - deq_att_hi)  * c4) : (deq_rel_hi  * deq_e4 + (1 - deq_rel_hi)  * c4);

  // Peak-equivalent dBFS detector level (pi/2 compensation for average rectified value of sine)
  deq_gdb0 = deq_calc_band_db(lin2db(deq_e0 * 1.42), deq_lift0, deq_T0, deq_S0, deq_M0);
  deq_gdb1 = deq_calc_band_db(lin2db(deq_e1 * 1.42), deq_lift0, deq_T1, deq_S1, deq_M1);
  deq_gdb2 = deq_calc_band_db(lin2db(deq_e2 * 1.42), deq_lift0, deq_T2, deq_S2, deq_M2);
  deq_gdb3 = deq_calc_band_db(lin2db(deq_e3 * 1.42), deq_lift0, deq_T3, deq_S3, deq_M3);
  deq_gdb4 = deq_calc_band_db(lin2db(deq_e4 * 1.42), deq_lift0, deq_T4, deq_S4, deq_M4);

  dg0 = db2lin(deq_gdb0);
  dg1 = db2lin(deq_gdb1);
  dg2 = db2lin(deq_gdb2);
  dg3 = db2lin(deq_gdb3);
  dg4 = db2lin(deq_gdb4);

  xL = d0L * dg0 + d1L * dg1 + d2L * dg2 + d3L * dg3 + d4L * dg4;
  xR = d0R * dg0 + d1R * dg1 + d2R * dg2 + d3R * dg3 + d4R * dg4;

  // Dynamic cut below rest lift for telemetry
  deq_lo_db = max(0, deq_lift0 - min(deq_gdb0, deq_gdb1));
  deq_hi_db = max(0, deq_lift0 - min(deq_gdb3, deq_gdb4));
  deq_gr_db = max(deq_lo_db, deq_hi_db);
) : (
  deq_gdb0 = deq_gdb1 = deq_gdb2 = deq_gdb3 = deq_gdb4 = 0;
  deq_lo_db = deq_hi_db = deq_gr_db = 0;
);
ui_deq_lo = ui_deq_lo * 0.995 + deq_lo_db * 0.005;
ui_deq_hi = ui_deq_hi * 0.995 + deq_hi_db * 0.005;
ui_deq0 = ui_deq0 * 0.98 + deq_gdb0 * 0.02;
ui_deq1 = ui_deq1 * 0.98 + deq_gdb1 * 0.02;
ui_deq2 = ui_deq2 * 0.98 + deq_gdb2 * 0.02;
ui_deq3 = ui_deq3 * 0.98 + deq_gdb3 * 0.02;
ui_deq4 = ui_deq4 * 0.98 + deq_gdb4 * 0.02;
s_deq_dL = xL - s_deq_inL; s_deq_dR = xR - s_deq_inR;

// ---- Stage 5: Tone EQ + Mid Bump ----
s_ton_inL = xL; s_ton_inR = xR;
slider29 >= 0.5 ? (
  xL = tone_lo.bq_procL(xL); xL = tone_mid.bq_procL(xL); xL = tone_hi.bq_procL(xL);
  xR = tone_lo.bq_procR(xR); xR = tone_mid.bq_procR(xR); xR = tone_hi.bq_procR(xR);
);
slider32 >= 0.5 ? (
  xL = mid_bump_bq.bq_procL(xL) * mid_bump_gain;
  xR = mid_bump_bq.bq_procR(xR) * mid_bump_gain;
);
s_ton_dL = xL - s_ton_inL; s_ton_dR = xR - s_ton_inR;

// ---- Stage 6: Dynamic Balance (analisi sempre attiva, correzione solo se ON) ----
db_loL += dbal_c_lo * (xL - db_loL);
db_loR += dbal_c_lo * (xR - db_loR);
db_top_lpL += dbal_c_hi * (xL - db_top_lpL);
db_top_lpR += dbal_c_hi * (xR - db_top_lpR);
band_loL = db_loL;                 band_loR = db_loR;
band_midL = db_top_lpL - db_loL;   band_midR = db_top_lpR - db_loR;
band_hiL = xL - db_top_lpL;        band_hiR = xR - db_top_lpR;
dbal_low_env += dbal_env_c * (0.5*(abs(band_loL)+abs(band_loR)) - dbal_low_env);
dbal_mid_env += dbal_env_c * (0.5*(abs(band_midL)+abs(band_midR)) - dbal_mid_env);
dbal_hi_env  += dbal_env_c * (0.5*(abs(band_hiL)+abs(band_hiR)) - dbal_hi_env);
tot_e = max(0.0005, dbal_low_env + dbal_mid_env + dbal_hi_env);
ui_sh_lo = dbal_low_env / tot_e; ui_sh_mid = dbal_mid_env / tot_e; ui_sh_hi = dbal_hi_env / tot_e;

s_dbal_inL = xL; s_dbal_inR = xR;
slider33 >= 0.5 && slider35 > 0.1 ? (
  dbal_bt = slider35 * 0.01;
  dbal_mB = slider34 >= 0.5;
  // Livelli equivalenti per banda (compensati sul riferimento -14.7 dB delle misure AU)
  dbal_L_lo  = lin2db(dbal_low_env * 2.4 * in_drive_lin) + 3.3;
  dbal_L_mid = lin2db(dbal_mid_env * 2.1 * in_drive_lin) + 3.3;
  dbal_L_hi  = lin2db(dbal_hi_env  * 3.2 * in_drive_lin) + 3.3;

  // Curva Upward/Downward Multiband Leveler misurata su MagicFlow AU (Mode A: +7.8 dB @100%/-26dBFS; Mode B: +9.4 dB @100%/-26dBFS)
  dbal_gdb_lo  = dbal_band_curve_db(dbal_L_lo,  dbal_bt, dbal_mB,  0.35) + ((t_lo  - ui_sh_lo)  * 4.5) * dbal_bt;
  dbal_gdb_mid = dbal_band_curve_db(dbal_L_mid, dbal_bt, dbal_mB,  0.20) + ((t_mid - ui_sh_mid) * 3.8) * dbal_bt;
  dbal_gdb_hi  = dbal_band_curve_db(dbal_L_hi,  dbal_bt, dbal_mB, -0.45) + ((t_hi  - ui_sh_hi)  * 4.8) * dbal_bt;

  g_lo  = db2lin(clamp(dbal_gdb_lo,  -12.0, 14.5));
  g_mid = db2lin(clamp(dbal_gdb_mid, -12.0, 14.5));
  g_hi  = db2lin(clamp(dbal_gdb_hi,  -12.0, 14.5));

  s_loL = band_loL * g_lo;    s_loR = band_loR * g_lo;
  s_midL = band_midL * g_mid; s_midR = band_midR * g_mid;
  s_hiL = band_hiL * g_hi;    s_hiR = band_hiR * g_hi;
  sat_dr = 0.06 * dbal_bt;
  xL = (s_loL - sat_dr * s_loL*s_loL*s_loL) + (s_midL - sat_dr * s_midL*s_midL*s_midL) + s_hiL;
  xR = (s_loR - sat_dr * s_loR*s_loR*s_loR) + (s_midR - sat_dr * s_midR*s_midR*s_midR) + s_hiR;
  dbal_act_pct = min(100, (abs(dbal_gdb_lo) + abs(dbal_gdb_mid) + abs(dbal_gdb_hi)) * 4.2 + deq_gr_db * 4);
) : (
  g_lo = g_mid = g_hi = 1;
  dbal_act_pct = min(100, deq_gr_db * 8);
);
s_dbal_dL = xL - s_dbal_inL; s_dbal_dR = xR - s_dbal_inR;
ui_dbal_glo  = ui_dbal_glo  * 0.98 + g_lo  * 0.02;
ui_dbal_gmid = ui_dbal_gmid * 0.98 + g_mid * 0.02;
ui_dbal_ghi  = ui_dbal_ghi  * 0.98 + g_hi  * 0.02;

// ---- DRC Solo (Sistema a molla: suona in preascolto SOLO mentre premi SOLO o tocchi i 3 rotori della banda attiva) ----
drc_solo_audition_band == 1 && slider8 >= 0.5 && slider9  >= 0.5 ? ( xL = bAL * (1.0 - redA); xR = bAR * (1.0 - redA); ) :
drc_solo_audition_band == 2 && slider8 >= 0.5 && slider13 >= 0.5 ? ( xL = bBL * (1.0 - redB); xR = bBR * (1.0 - redB); ) :
drc_solo_audition_band == 3 && slider8 >= 0.5 && slider17 >= 0.5 ? ( xL = bCL * (1.0 - redC); xR = bCR * (1.0 - redC); ) :
drc_solo_audition_band == 4 && slider8 >= 0.5 && slider21 >= 0.5 ? ( xL = bDL * (1.0 - redD); xR = bDR * (1.0 - redD); );

// ---- Stage 7: Output ----
in_sq = 0.5 * (dryL*dryL + dryR*dryR);
out_sq = 0.5 * (xL*xL + xR*xR);
gm_rms_in  += gm_coeff * (in_sq - gm_rms_in);
gm_rms_out += gm_coeff * (out_sq - gm_rms_out);
slider38 >= 0.5 && gm_rms_out > 0.00001 && gm_rms_in > 0.00001 ? (
  gm_target = clamp(sqrt(gm_rms_in / gm_rms_out), 0.70, 1.45);
  gm_gain = gm_gain * 0.998 + gm_target * 0.002;
) : ( gm_gain = 1.0; );

wetL = xL * gm_gain * out_gain_lin;
wetR = xR * gm_gain * out_gain_lin;

delta_spring_stage > 0 && delta_spring_stage < 12 ? (
  delta_spring_stage == 1  ? ( spl0 = s_flt_dL;   spl1 = s_flt_dR;   ) :
  delta_spring_stage == 2  ? ( spl0 = s_pre_dL;   spl1 = s_pre_dR;   ) :
  delta_spring_stage == 3  ? ( spl0 = s_pk_dL;    spl1 = s_pk_dR;    ) :
  delta_spring_stage == 4  ? ( spl0 = -bAL*redA;  spl1 = -bAR*redA;  ) :
  delta_spring_stage == 5  ? ( spl0 = -bBL*redB;  spl1 = -bBR*redB;  ) :
  delta_spring_stage == 6  ? ( spl0 = -bCL*redC;  spl1 = -bCR*redC;  ) :
  delta_spring_stage == 7  ? ( spl0 = -bDL*redD;  spl1 = -bDR*redD;  ) :
  delta_spring_stage == 8  ? ( spl0 = s_deq_dL;   spl1 = s_deq_dR;   ) :
  delta_spring_stage == 9  ? ( spl0 = s_ton_dL;   spl1 = s_ton_dR;   ) :
  delta_spring_stage == 10 ? ( spl0 = s_dbal_dL;  spl1 = s_dbal_dR;  ) :
                             ( spl0 = wetL - dryL; spl1 = wetR - dryR; );
  delta_spring_stage < 11 ? ( spl0 *= out_gain_lin; spl1 *= out_gain_lin; );
) : slider39 >= 0.5 ? (
  spl0 = wetL - dryL;
  spl1 = wetR - dryR;
) : (
  mix_w = slider36 * 0.01;
  spl0 = wetL * mix_w + dryL * (1.0 - mix_w);
  spl1 = wetR * mix_w + dryR * (1.0 - mix_w);
);
pre_limL = spl0; pre_limR = spl1;

slider40 >= 0.5 ? (
  curL = spl0; curR = spl1;
  stL = curL - tp_prevL; stR = curR - tp_prevR;
  pk = max(max(abs(tp_prevL), abs(tp_prevR)), max(abs(curL), abs(curR)));
  pk = max(pk, max(abs(tp_prevL + stL*0.25), abs(tp_prevR + stR*0.25)));
  pk = max(pk, max(abs(tp_prevL + stL*0.50), abs(tp_prevR + stR*0.50)));
  pk = max(pk, max(abs(tp_prevL + stL*0.75), abs(tp_prevR + stR*0.75)));
  tp_prevL = curL; tp_prevR = curR;
  tp_meter_peak = max(pk, tp_meter_peak * 0.9995);
  pk > tp_ceiling ? ( tp_gr = min(tp_gr, tp_ceiling / pk); ) : ( tp_gr = tp_rel_coeff * tp_gr + (1.0 - tp_rel_coeff); );
  tp_gr = clamp(tp_gr, 0.0, 1.0);
  spl0 *= tp_gr; spl1 *= tp_gr;
  post_pk = max(abs(spl0), abs(spl1));
  post_pk > tp_ceiling ? ( saf = tp_ceiling / post_pk; spl0 *= saf; spl1 *= saf; tp_gr = min(tp_gr, saf); );
  tp_gr_smooth = tp_gr_smooth * 0.92 + tp_gr * 0.08;
  ui_tp_gr_db = tp_gr_smooth < 0.999 ? -lin2db(tp_gr_smooth) : 0.0;
) : (
  tp_prevL = spl0; tp_prevR = spl1;
  tp_meter_peak = max(max(abs(spl0), abs(spl1)), tp_meter_peak * 0.9995);
  ui_tp_gr_db = 0;
);
delta_spring_stage == 12 ? (
  spl0 = spl0 - pre_limL;
  spl1 = spl1 - pre_limR;
);

ui_rms_in_sq  = ui_rms_in_sq * meter_decay_ui + (1 - meter_decay_ui) * in_sq;
ui_rms_out_sq = ui_rms_out_sq * meter_decay_ui + (1 - meter_decay_ui) * (0.5 * (spl0*spl0 + spl1*spl1));
ui_rms_in_db  = ui_rms_in_sq  > 0.000000001 ? 10 * log10(ui_rms_in_sq)  : -60;
ui_rms_out_db = ui_rms_out_sq > 0.000000001 ? 10 * log10(ui_rms_out_sq) : -60;

// Blocco analisi lento (4 s di parlato attivo, 2° ordine) escluso durante DELTA / MOLLA / SOLO
audition_active = (slider39 >= 0.5) || (delta_spring_stage > 0) || (drc_solo_audition_band > 0);
!audition_active ? (
  out_m = 0.5 * (spl0 + spl1);
  sug_lo1 += sug_c_lo * (out_m - sug_lo1); sug_lo2 += sug_c_lo * (sug_lo1 - sug_lo2);
  sug_hi1 += sug_c_hi * (out_m - sug_hi1); sug_h1 = out_m - sug_hi1;
  sug_hi2 += sug_c_hi * (sug_h1 - sug_hi2); sug_h2 = sug_h1 - sug_hi2;
  sug_mhp += sug_c_mhp * (out_m - sug_mhp); sug_m1 = out_m - sug_mhp;
  sug_mlp += sug_c_hi * (sug_m1 - sug_mlp);
  ui_rms_in_sq > 0.0000316 ? (
    sug_blk_in_sq += in_sq;
    sug_blk_p_lo  += sug_lo2 * sug_lo2;
    sug_blk_p_mid += sug_mlp * sug_mlp;
    sug_blk_p_hi  += sug_h2  * sug_h2;
    sug_blk_pk_gr += tot_pk_gr_db;
    sug_blk_drcA  += drcA_gr_db;
    sug_blk_drcB  += drcB_gr_db;
    sug_blk_drcC  += drcC_gr_db;
    sug_blk_drcD  += drcD_gr_db;
    sug_blk_dbal  += dbal_act_pct;
    sug_blk_lim   += ui_tp_gr_db;
    sug_blk_n += 1;
    sug_blk_n >= sug_blk_target ? (
      inv_n = 1.0 / sug_blk_n;
      sug_avg_in_db     = 10 * log10(max(0.000000000001, sug_blk_in_sq * inv_n));
      sug_avg_hi_mid_db = 10 * log10(max(0.000000000001, sug_blk_p_hi) / max(0.000000000001, sug_blk_p_mid));
      sug_avg_lo_mid_db = 10 * log10(max(0.000000000001, sug_blk_p_lo) / max(0.000000000001, sug_blk_p_mid));
      sug_avg_pk_gr     = sug_blk_pk_gr * inv_n;
      sug_avg_drcA      = sug_blk_drcA  * inv_n;
      sug_avg_drcB      = sug_blk_drcB  * inv_n;
      sug_avg_drcC      = sug_blk_drcC  * inv_n;
      sug_avg_drcD      = sug_blk_drcD  * inv_n;
      sug_avg_dbal      = sug_blk_dbal  * inv_n;
      sug_avg_lim       = sug_blk_lim   * inv_n;
      sug_ready = 1;
      sug_blk_in_sq = 0; sug_blk_p_lo = 0; sug_blk_p_mid = 0; sug_blk_p_hi = 0;
      sug_blk_pk_gr = 0; sug_blk_drcA = 0; sug_blk_drcB = 0; sug_blk_drcC = 0; sug_blk_drcD = 0;
      sug_blk_dbal = 0; sug_blk_lim = 0; sug_blk_n = 0;
    );
  );
);

@gfx 1240 900
// ============================================================================
// GUI — scalabile: layout in unita' di progetto (larghezza 1100), scala sc.
// La GUI legge soltanto variabili del DSP; non scrive nulla nel percorso audio
// tranne i parametri (slider) scelti dall'utente.
// ============================================================================
zp_hb = gmem[3900]; zp_hb_now = time_precise();
!zp_hb_seen ? (zp_hb_last = zp_hb; zp_hb_seen = 1; zp_hb_t = -10;) : zp_hb != zp_hb_last ? (zp_hb_last = zp_hb; zp_hb_t = zp_hb_now;);
zp_hb_ok = zp_hb > 0 && zp_hb_now - zp_hb_t < 3;
ui_gfx_frame += 1;
time_now = time_precise();
zp_hb_ok ? ( help_bridge_last_alive_t = time_now; ui_lang = gmem[3901] == 1 ? 1 : 0; ) :
           ( time_now - help_bridge_last_alive_t > 3.0 ? ui_lang = 0; );

show_simple = floor(slider42 + 0.5) == 0;
view_mode = floor(slider43 + 0.5);
view_mode != prev_view_mode ? update_view_mode_visibility();
mon_sel = floor(slider52 + 0.5);
ana_on = slider51 >= 0.5;

// ---- Scala ----
HB = 32; AB = 58;
content_bottom = view_mode == 0 ? 754 : view_mode == 1 ? 384 : 226;
designH = content_bottom + 10 + HB + (ana_on ? AB : 0);
sc = max(0.7, min(2.2, min(gfx_w / 1100, gfx_h / designH)));
ox = max(0, (gfx_w - 1100 * sc) * 0.5);
view_hd = gfx_h / sc;
help_yd = view_hd - HB;
ana_yd = help_yd - AB;
bars_top_d = ana_on ? ana_yd : help_yd;
xl_d = -ox / sc;
xr_d = (gfx_w - ox) / sc;

gfx_setfont(1, "Arial", 22 * sc, 'b');
gfx_setfont(2, "Arial", 14.5 * sc);
gfx_setfont(3, "Arial", 14 * sc, 'b');
gfx_setfont(4, "Arial", 13.5 * sc, 'b');
gfx_setfont(5, "Arial", 13 * sc);
gfx_setfont(6, "Arial", 12 * sc, 'b');
gfx_setfont(7, "Arial", 11.5 * sc);

show_simple ? (
  bg_r = 0.92; bg_g = 0.94; bg_b = 0.97;
  panel_r = 0.97; panel_g = 0.98; panel_b = 0.99;
  panel2_r = 0.89; panel2_g = 0.92; panel2_b = 0.96;
  text_r = 0.12; text_g = 0.16; text_b = 0.22;
  sub_r = 0.32; sub_g = 0.39; sub_b = 0.47;
  line_r = 0.70; line_g = 0.77; line_b = 0.85;
) : (
  bg_r = 0.05; bg_g = 0.06; bg_b = 0.08;
  panel_r = 0.10; panel_g = 0.12; panel_b = 0.15;
  panel2_r = 0.14; panel2_g = 0.17; panel2_b = 0.21;
  text_r = 0.90; text_g = 0.92; text_b = 0.95;
  sub_r = 0.66; sub_g = 0.70; sub_b = 0.76;
  line_r = 0.26; line_g = 0.30; line_b = 0.36;
);
c_cyan_r = 0.15; c_cyan_g = 0.69; c_cyan_b = 0.84;
c_amber_r = 0.92; c_amber_g = 0.58; c_amber_b = 0.18;
c_mag_r = 0.82; c_mag_g = 0.34; c_mag_b = 0.56;
c_grn_r = 0.26; c_grn_g = 0.76; c_grn_b = 0.46;

// ---- Mouse (unita' di progetto) ----
mxd = (mouse_x - ox) / sc;
myd = mouse_y / sc;
mouse_down = mouse_cap & 1;
mouse_click_raw = mouse_down && !(last_mouse_cap & 1);
mouse_rclick_raw = (mouse_cap & 2) && !(last_mouse_cap & 2);
mouse_click = mouse_click_raw && myd < bars_top_d;
mouse_right_click = mouse_rclick_raw && myd < bars_top_d;
fine_tune = (mouse_cap & 8) ? 0.08 : 1.0;
// Edit frequency in place; discard pending input when focus or control changes.
mouse_click_raw || mouse_rclick_raw ? lab_edit = 0;
lab_key = gfx_getchar();
while (lab_key > 0) (
  lab_edit ? (
    lab_key >= 48 && lab_key <= 57 && lab_digits < 5 ? (
      lab_value = lab_value*10 + lab_key-48; lab_digits += 1;
    ) : lab_key == 8 ? (
      lab_value = floor(lab_value/10); lab_digits = max(0,lab_digits-1);
    ) : lab_key == 27 ? lab_edit = 0 :
    lab_key == 13 && lab_digits && lab_value >= lab_min && lab_value <= lab_max ? (
      (lab_edit == 10 || lab_edit == 14 || lab_edit == 18 || lab_edit == 22) && lab_edit_lp > 0 ? (
        cur_lo = clamp(min(slider(lab_edit), slider(lab_edit_lp)), 20, 19980);
        cur_hi = clamp(max(cur_lo + 20, max(slider(lab_edit), slider(lab_edit_lp))), 40, 20000);
        cur_oct = clamp(log(cur_hi / cur_lo) / log(2.0), 0.12, 3.50);
        set_drc_band_fc_oct(lab_edit, lab_edit_lp, lab_value, cur_oct);
      ) : (
        set_param_slider(lab_edit, lab_value); set_param_slider(44, 0); prev_osara_preset = 0;
        update_dsp_params();
      );
      lab_edit = 0; lab_edit_lp = 0;
    );
  );
  lab_key = gfx_getchar();
);
active_info_id = 0;
cur_mod = -1;

// ---- Helper di disegno ----
function gxp(x) ( floor(ox + x * sc + 0.5); );
function gyp(y) ( floor(y * sc + 0.5); );
function g_rect(x, y, w, h) ( gfx_rect(gxp(x), gyp(y), max(1, floor(w * sc + 0.5)), max(1, floor(h * sc + 0.5))); );
function g_frame(x, y, w, h) local(X, Y, W, H) (
  X = gxp(x); Y = gyp(y); W = max(2, floor(w * sc + 0.5)); H = max(2, floor(h * sc + 0.5));
  gfx_rect(X, Y, W, 1); gfx_rect(X, Y + H - 1, W, 1); gfx_rect(X, Y, 1, H); gfx_rect(X + W - 1, Y, 1, H);
);
function g_line(x1, y1, x2, y2) ( gfx_line(ox + x1 * sc, y1 * sc, ox + x2 * sc, y2 * sc, 1); );
function g_circ(x, y, r, f) ( gfx_circle(ox + x * sc, y * sc, r * sc, f, 1); );
function g_arc(x, y, r, a1, a2) ( gfx_arc(ox + x * sc, y * sc, r * sc, a1, a2, 1); );
function g_txt(x, y, s) ( gfx_x = gxp(x); gfx_y = gyp(y); gfx_drawstr(s); );
function g_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function g_th() local(tw, th) ( gfx_measurestr("Ag", tw, th); th / sc; );
function g_txtc(cx, y, s) ( g_txt(cx - g_tw(s) * 0.5, y, s); );
function g_txtr(xr, y, s) ( g_txt(xr - g_tw(s), y, s); );
function hit(x, y, w, h) ( mxd >= x && mxd <= x + w && myd >= y && myd <= y + h; );
function msg(it, en) ( ui_lang == 1 ? en : it; );
function set_text_col() ( gfx_r = text_r; gfx_g = text_g; gfx_b = text_b; gfx_a = 1; );
function set_sub_col() ( gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; );

function fmt_freq(dst, v) local(k) (
  v >= 1000 ? (
    k = v / 1000;
    abs(k - floor(k + 0.5)) < 0.05 ? sprintf(dst, "%.0fk", k) : sprintf(dst, "%.1fk", k);
  ) : sprintf(dst, "%.0f", v);
  dst;
);
function fmt_gr(dst, gr) (
  gr < 0.05 ? sprintf(dst, "0.0 dB") : sprintf(dst, "-%.1f dB", gr);
  dst;
);
function band_role(fa, fb) local(c) (
  c = sqrt(max(20, fa) * max(20, fb));
  c < 250 ? "LOW" : c < 1100 ? "BOX" : c < 3000 ? "HARSH" : c < 5500 ? "PRES" : c < 11000 ? "SIB" : "AIR";
);
function set_mon(m) ( m >= 0 ? set_ui_state(52, m); );

function draw_panel(x, y, w, h) (
  gfx_r = panel_r; gfx_g = panel_g; gfx_b = panel_b; gfx_a = 1; g_rect(x, y, w, h);
  gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.9; g_frame(x, y, w, h);
);
function draw_panel_hl(x, y, w, h, is_act, rr, gg, bb) (
  gfx_r = panel_r; gfx_g = panel_g; gfx_b = panel_b; gfx_a = 1; g_rect(x, y, w, h);
  is_act ? (
    gfx_r = rr; gfx_g = gg; gfx_b = bb;
    gfx_a = show_simple ? 0.08 : 0.09; g_rect(x + 1, y + 1, w - 2, h - 2);
    gfx_a = 0.98; g_frame(x, y, w, h);
    gfx_a = 0.65; g_frame(x + 1, y + 1, w - 2, h - 2);
  ) : (
    gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.85; g_frame(x, y, w, h);
  );
);
function draw_mon_badge(xr, y, is_act, hv, rr, gg, bb) local(bw, bh, bx, th) (
  is_act ? (
    bw = 62; bh = 16; bx = xr - bw;
    gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = 0.96; g_rect(bx, y, bw, bh);
    gfx_setfont(7); gfx_r = 0.04; gfx_g = 0.05; gfx_b = 0.07; gfx_a = 1;
    th = g_th();
    g_txtc(bx + bw * 0.5, y + (bh - th) * 0.5, "MONITOR");
  ) : (
    gfx_setfont(7); gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = hv ? 0.95 : 0.45;
    g_txtr(xr, y + 2, "monitor");
  );
);
// titolo cliccabile: seleziona il modulo nel monitor
function draw_group_title_ex(x, y, w, h, lbl, rr, gg, bb, mon, is_act) local(hv, ty_txt, by_bdg) (
  hv = mon >= 0 && hit(x, y, w, h);
  hv ? ( active_info_id = mon == 2 ? 233 : 232; mouse_click ? set_mon(mon); );
  mon < 0 ? (
    gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = 0.95; g_rect(x, y, w, 4);
  ) : is_act ? (
    gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = 1; g_rect(x, y, w, 5);
    gfx_a = show_simple ? 0.28 : 0.34; g_rect(x + 1, y + 5, w - 2, h - 5);
    gfx_a = 0.70; g_rect(x + 1, y + h - 1, w - 2, 1);
  ) : (
    gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = hv ? 0.85 : 0.45; g_rect(x, y, w, 3);
    hv ? ( gfx_a = 0.14; g_rect(x + 1, y + 3, w - 2, h - 3); );
  );
  h >= 26 ? gfx_setfont(3) : gfx_setfont(6);
  is_act ? (
    show_simple ? ( gfx_r = 0.06; gfx_g = 0.08; gfx_b = 0.12; ) : ( gfx_r = 0.98; gfx_g = 0.99; gfx_b = 1.0; );
    gfx_a = 1;
  ) : (
    set_text_col();
    mon >= 0 ? ( gfx_a = 0.88; );
  );
  ty_txt = y + floor((h - g_th()) * 0.5) + 1;
  g_txt(x + 12, ty_txt, lbl);
  mon >= 0 ? (
    by_bdg = y + floor((h - 16) * 0.5) + 1;
    draw_mon_badge(x + w - 8, by_bdg, is_act, hv, rr, gg, bb);
  );
);
function draw_group_title(x, y, w, lbl, rr, gg, bb, mon) (
  draw_group_title_ex(x, y, w, 28, lbl, rr, gg, bb, mon, mon >= 0 && mon == mon_sel);
);
function draw_p3_row_bg(ry, is_act, rr, gg, bb, title, hint_str, mon) local(hv) (
  hv = hit(742, ry, 336, 66);
  hv && mouse_click ? set_mon(mon);
  is_act ? (
    gfx_r = rr; gfx_g = gg; gfx_b = bb;
    gfx_a = show_simple ? 0.13 : 0.15; g_rect(742, ry, 336, 66);
    gfx_a = 0.98; g_rect(742, ry + 2, 3, 62);
    gfx_a = 0.55; g_frame(742, ry, 336, 66);
  ) : hv ? (
    gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = 0.07; g_rect(742, ry, 336, 66);
  );
  gfx_setfont(6);
  is_act ? ( gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = 1; ) : set_text_col();
  g_txt(830, ry + 7, title);
  is_act ? (
    draw_mon_badge(1072, ry + 5, 1, hv, rr, gg, bb);
  ) : (
    gfx_setfont(7); set_sub_col(); gfx_a = 0.80;
    g_txtr(1072, ry + 8, hint_str);
  );
);
function draw_meter_h(x, y, w, h, val_pct, rr, gg, bb) local(fill) (
  gfx_r = show_simple ? 0.80 : 0.07; gfx_g = show_simple ? 0.84 : 0.09; gfx_b = show_simple ? 0.90 : 0.13; gfx_a = 1;
  g_rect(x, y, w, h);
  fill = clamp(w * val_pct * 0.01, 0, w);
  fill > 0 ? ( gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = 0.98; g_rect(x, y, fill, h); );
);
function btn_face(bx, by, bw, bh, label, is_on, is_hover, cr, cg, cb) local(th) (
  is_on ? ( gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 0.95; ) :
          ( gfx_r = panel2_r; gfx_g = panel2_g; gfx_b = panel2_b; gfx_a = 1;
            is_hover ? ( gfx_r += 0.06; gfx_g += 0.06; gfx_b += 0.06; ); );
  g_rect(bx, by, bw, bh);
  gfx_r = is_hover ? min(1, cr + 0.2) : line_r; gfx_g = is_hover ? min(1, cg + 0.2) : line_g; gfx_b = is_hover ? min(1, cb + 0.2) : line_b; gfx_a = 0.95;
  g_frame(bx, by, bw, bh);
  gfx_setfont(6);
  is_on ? ( gfx_r = 0.04; gfx_g = 0.05; gfx_b = 0.07; gfx_a = 1; ) : set_text_col();
  th = g_th();
  g_txtc(bx + bw * 0.5, by + (bh - th) * 0.5, label);
);
function ui_tab_btn(sl_idx, target_val, bx, by, bw, bh, label, info_id, cr, cg, cb, mon) local(is_on, is_hover) (
  is_on = floor(slider(sl_idx) + 0.5) == target_val;
  is_hover = hit(bx, by, bw, bh);
  is_hover ? active_info_id = info_id;
  is_hover && mouse_click ? (
    (sl_idx == 52 || sl_idx == 43 || sl_idx == 42) ? set_ui_state(sl_idx, target_val) : set_param_slider(sl_idx, target_val);
    sl_idx == 44 && target_val > 0 ? ( apply_magic_preset(target_val); prev_osara_preset = target_val; );
    set_mon(mon);
    update_dsp_params();
    delta_spring_armed ? (
      sl_idx == 27 ? ( ui_hold_delta_stage = 8; ) :
      sl_idx == 30 ? ( ui_hold_delta_stage = 9; ) :
      sl_idx == 34 ? ( ui_hold_delta_stage = 10; );
    );
  );
  btn_face(bx, by, bw, bh, label, is_on, is_hover, cr, cg, cb);
);
function ui_drc_solo_btn(target_band, eng_sl, bx, by, bw, bh, label, cr, cg, cb) local(cur_arm, band_active, is_on, is_hover, is_aud) (
  cur_arm = floor(slider25 + 0.5);
  band_active = target_band == 0 ? 1 : (slider8 >= 0.5 && slider(eng_sl) >= 0.5);
  !band_active && cur_arm == target_band ? ( set_param_slider(25, 0); cur_arm = 0; );
  is_on = (cur_arm == target_band) && band_active;
  is_aud = (target_band > 0) && (drc_solo_audition_band == target_band);
  is_hover = hit(bx, by, bw, bh);
  is_hover ? active_info_id = (band_active ? 125 : 126);
  is_hover && mouse_click ? (
    set_mon(2);
    target_band == 0 ? (
      set_param_slider(25, 0);
      ui_hold_solo_btn = 0;
      drc_solo_audition_band = 0;
    ) : band_active ? (
      delta_spring_armed = 0; delta_spring_stage = 0; ui_hold_delta_stage = 0;
      slider39 >= 0.5 ? ( set_param_slider(39, 0); );
      cur_arm == target_band ? (
        // Se era gia' armato e lo riclicchi, tiene il preascolto finche' tieni premuto e al rilascio si spegne
        ui_hold_solo_btn = target_band;
        ui_solo_toggle_off_on_release = 1;
        solo_arm_time = time_now;
      ) : (
        set_param_slider(25, target_band);
        ui_hold_solo_btn = target_band;
        ui_solo_toggle_off_on_release = 0;
        solo_arm_time = time_now;
      );
    );
  );
  !mouse_down && ui_hold_solo_btn == target_band && target_band > 0 ? (
    ui_hold_solo_btn = 0;
    ui_solo_toggle_off_on_release ? ( set_param_slider(25, 0); ui_solo_toggle_off_on_release = 0; );
  );
  !band_active ? (
    gfx_r = panel2_r; gfx_g = panel2_g; gfx_b = panel2_b; gfx_a = 0.45; g_rect(bx, by, bw, bh);
    gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.35; g_frame(bx, by, bw, bh);
    gfx_setfont(6); set_sub_col(); gfx_a = 0.38;
    g_txtc(bx + bw * 0.5, by + (bh - g_th()) * 0.5, label);
  ) : is_aud ? (
    btn_face(bx, by, bw, bh, label, 1, is_hover, 1.0, 0.72, 0.16);
  ) : (
    btn_face(bx, by, bw, bh, label, is_on, is_hover, cr, cg, cb);
  );
);
function ui_toggle_btn(sl_idx, bx, by, bw, bh, lbl, info_id, cr, cg, cb, mon) local(is_on, is_hover) (
  is_on = slider(sl_idx) >= 0.5;
  is_hover = hit(bx, by, bw, bh);
  is_hover ? active_info_id = info_id;
  is_hover && mouse_click ? (
    set_param_slider(sl_idx, is_on ? 0 : 1);
    set_mon(mon);
    update_dsp_params();
    is_on = !is_on;
    sl_idx == 39 && is_on ? (
      delta_arm_time = time_now;
      delta_spring_armed = 0; delta_spring_stage = 0; ui_hold_delta_stage = 0;
      slider25 > 0 ? ( set_param_slider(25, 0); );
      ui_hold_solo_btn = 0; drc_solo_audition_band = 0;
    );
    delta_spring_armed && is_on ? (
      sl_idx == 4 ? ( ui_hold_delta_stage = 1; ) :
      sl_idx == 5 ? ( ui_hold_delta_stage = 2; ) :
      sl_idx == 7 ? ( ui_hold_delta_stage = 3; ) :
      sl_idx == 9 ? ( ui_hold_delta_stage = 4; ) :
      sl_idx == 13 ? ( ui_hold_delta_stage = 5; ) :
      sl_idx == 17 ? ( ui_hold_delta_stage = 6; ) :
      sl_idx == 21 ? ( ui_hold_delta_stage = 7; ) :
      sl_idx == 26 ? ( ui_hold_delta_stage = 8; ) :
      (sl_idx == 29 || sl_idx == 32) ? ( ui_hold_delta_stage = 9; ) :
      sl_idx == 33 ? ( ui_hold_delta_stage = 10; );
    );
  );
  btn_face(bx, by, bw, bh, lbl, is_on, is_hover, cr, cg, cb);
);
// Knob: arco corretto (gfx_arc: 0 = ore 12) allineato all'indicatore (cos/sin: 0 = ore 3)
function ui_knob(sl_idx, kx, ky, r, min_v, max_v, def_v, label, unit, cr, cg, cb, info_id, ring_pct)
local(val, norm_val, ang_min, ang_max, ang, is_hover, drag_sens, hover_mul, is_dbl, meter_ang, meter_r, HP, hz, has_lbl, val_y) (
  hz = strcmp(unit, "Hz") == 0;
  has_lbl = strlen(label) > 0;
  val = slider(sl_idx);
  HP = $pi * 0.5;
  is_hover = has_lbl ? hit(kx - r - 10, ky - r - 22, (r + 10) * 2, (r + 22) * 2 + 4) :
                       hit(kx - r - 8,  ky - r - 6,  (r + 8) * 2,  (r + 6) + (r + 20));
  is_hover ? (
    active_info_id = info_id;
    mouse_click ? (
      set_mon(cur_mod);
      is_dbl = (ui_last_click_id == sl_idx) && ((ui_gfx_frame - ui_last_click_frame) <= 18);
      ui_last_click_id = sl_idx; ui_last_click_frame = ui_gfx_frame;
      is_dbl && hz ? ( lab_edit = sl_idx; lab_digits = 0; lab_value = 0; lab_min = min_v; lab_max = max_v; ui_drag_id = 0; ui_last_click_id = -1; ) :
      is_dbl ? ( set_param_slider(sl_idx, def_v); val = def_v; ui_drag_id = 0; update_dsp_params(); ) :
               ( ui_drag_id = sl_idx; ui_drag_start_y = myd; ui_drag_start_v = val; );
    );
    mouse_right_click ? ( set_param_slider(sl_idx, def_v); val = def_v; update_dsp_params(); );
  );
  ui_drag_id == sl_idx && mouse_down && (myd != ui_drag_start_y || slider(sl_idx) != ui_drag_start_v) ? (
    drag_sens = ((max_v - min_v) / 170.0) * fine_tune;
    hz ? val = floor(clamp(ui_drag_start_v * exp(log(max_v/min_v) * (ui_drag_start_y-myd) * fine_tune / 170), min_v, max_v) + 0.5) :
    val = clamp(ui_drag_start_v + (ui_drag_start_y - myd) * drag_sens, min_v, max_v);
    set_param_slider(sl_idx, val);
    floor(slider44 + 0.5) != 0 ? ( set_param_slider(44, 0); prev_osara_preset = 0; );
    update_dsp_params();
  ) : ( ui_drag_id == sl_idx && !mouse_down ? ui_drag_id = 0; );

  hover_mul = (is_hover || ui_drag_id == sl_idx) ? 1.25 : 0.92;
  ang_min = 2.356; ang_max = 7.068;
  norm_val = hz ? clamp(log(max(min_v,val)/min_v)/log(max_v/min_v),0,1) : clamp((val - min_v) / max(0.0001, max_v - min_v), 0, 1);
  ang = ang_min + norm_val * (ang_max - ang_min);

  ring_pct >= 0 ? (
    meter_r = has_lbl ? (r + 6) : (r + 5);
    gfx_r = show_simple ? 0.74 : 0.22; gfx_g = show_simple ? 0.77 : 0.24; gfx_b = show_simple ? 0.82 : 0.29; gfx_a = 0.8;
    g_arc(kx, ky, meter_r, ang_min + HP, ang_max + HP);
    ring_pct > 1 ? (
      meter_ang = ang_min + clamp(ring_pct * 0.01, 0, 1) * (ang_max - ang_min);
      gfx_r = min(1, cr + 0.25); gfx_g = min(1, cg + 0.25); gfx_b = min(1, cb + 0.25); gfx_a = 1;
      g_arc(kx, ky, meter_r, ang_min + HP, meter_ang + HP);
      g_arc(kx, ky, meter_r + 1.2, ang_min + HP, meter_ang + HP);
    );
  );
  show_simple ? ( gfx_r = 0.99; gfx_g = 0.99; gfx_b = 1.0; ) : ( gfx_r = 0.17; gfx_g = 0.18; gfx_b = 0.22; );
  gfx_a = 1; g_circ(kx, ky, r, 1);
  show_simple ? ( gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.55; g_circ(kx, ky, r, 0); );
  gfx_r = show_simple ? 0.82 : 0.26; gfx_g = show_simple ? 0.85 : 0.28; gfx_b = show_simple ? 0.90 : 0.33; gfx_a = 1;
  g_arc(kx, ky, r - 2.5, ang_min + HP, ang_max + HP);
  gfx_r = min(1, cr * hover_mul); gfx_g = min(1, cg * hover_mul); gfx_b = min(1, cb * hover_mul); gfx_a = 1;
  g_arc(kx, ky, r - 2, ang_min + HP, ang + HP); g_arc(kx, ky, r - 3, ang_min + HP, ang + HP); g_arc(kx, ky, r - 4, ang_min + HP, ang + HP);
  show_simple ? ( gfx_r = 0.15; gfx_g = 0.18; gfx_b = 0.24; ) : ( gfx_r = 0.95; gfx_g = 0.95; gfx_b = 0.96; );
  g_line(kx + cos(ang) * r * 0.25, ky + sin(ang) * r * 0.25, kx + cos(ang) * (r - 3), ky + sin(ang) * (r - 3));

  has_lbl ? (
    gfx_setfont(6); set_text_col();
    g_txtc(kx, ky - r - 19, label);
  );
  strcmp(unit, "Hz") == 0 ? (
    fmt_freq(#kv, val); val < 1000 ? strcat(#kv, " Hz");
  ) : (
    abs(val - floor(val + 0.5)) < 0.03 ? sprintf(#kv, "%.0f %s", val, unit) : sprintf(#kv, "%.1f %s", val, unit);
  );
  gfx_setfont(5);
  gfx_r = min(1, cr * hover_mul); gfx_g = min(1, cg * hover_mul); gfx_b = min(1, cb * hover_mul); gfx_a = 1;
  lab_edit == sl_idx ? ( lab_digits ? sprintf(#kv, "%d_", lab_value) : strcpy(#kv, "_ Hz"); );
  val_y = has_lbl ? (ky + r + 6) : (ky + r + 4);
  g_txtc(kx, val_y, #kv);
);

function ui_drc_freq_knob(sl_hp, sl_lp, kx, ky, r, def_fc, cr, cg, cb, info_id)
local(lo, hi, fc, oct, norm_val, ang_min, ang_max, ang, is_hover, hover_mul, is_dbl, HP, new_fc, fspan_lo, fspan_hi) (
  lo = clamp(min(slider(sl_hp), slider(sl_lp)), 20, 19980);
  hi = clamp(max(lo + 20, max(slider(sl_hp), slider(sl_lp))), 40, 20000);
  fc = sqrt(lo * hi);
  oct = clamp(log(hi / lo) / log(2.0), 0.12, 3.50);
  HP = $pi * 0.5;
  is_hover = hit(kx - r - 10, ky - r - 22, (r + 10) * 2, (r + 22) * 2 + 4);
  is_hover ? (
    active_info_id = info_id;
    mouse_click ? (
      set_mon(cur_mod);
      is_dbl = (ui_last_click_id == sl_hp) && ((ui_gfx_frame - ui_last_click_frame) <= 18);
      ui_last_click_id = sl_hp; ui_last_click_frame = ui_gfx_frame;
      is_dbl ? ( lab_edit = sl_hp; lab_edit_lp = sl_lp; lab_digits = 0; lab_value = 0; lab_min = 25; lab_max = 18000; ui_drag_id = 0; ui_last_click_id = -1; ) :
               ( ui_drag_id = sl_hp; ui_drag_start_y = myd; ui_drag_start_v = fc; ui_drag_aux = oct; );
    );
    mouse_right_click ? ( set_drc_band_fc_oct(sl_hp, sl_lp, def_fc, oct); );
  );
  ui_drag_id == sl_hp && mouse_down ? (
    myd != ui_drag_start_y ? (
      new_fc = clamp(ui_drag_start_v * exp(log(18000.0 / 25.0) * (ui_drag_start_y - myd) * fine_tune / 170.0), 25, 18000);
      set_drc_band_fc_oct(sl_hp, sl_lp, new_fc, ui_drag_aux);
      lo = clamp(min(slider(sl_hp), slider(sl_lp)), 20, 19980);
      hi = clamp(max(lo + 20, max(slider(sl_hp), slider(sl_lp))), 40, 20000);
      fc = sqrt(lo * hi);
    );
  ) : ( ui_drag_id == sl_hp && !mouse_down ? ui_drag_id = 0; );

  hover_mul = (is_hover || ui_drag_id == sl_hp) ? 1.25 : 0.92;
  ang_min = 2.356; ang_max = 7.068;
  norm_val = clamp(log(max(25, fc) / 25.0) / log(18000.0 / 25.0), 0, 1);
  ang = ang_min + norm_val * (ang_max - ang_min);

  show_simple ? ( gfx_r = 0.99; gfx_g = 0.99; gfx_b = 1.0; ) : ( gfx_r = 0.17; gfx_g = 0.18; gfx_b = 0.22; );
  gfx_a = 1; g_circ(kx, ky, r, 1);
  show_simple ? ( gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.55; g_circ(kx, ky, r, 0); );
  gfx_r = show_simple ? 0.82 : 0.26; gfx_g = show_simple ? 0.85 : 0.28; gfx_b = show_simple ? 0.90 : 0.33; gfx_a = 1;
  g_arc(kx, ky, r - 2.5, ang_min + HP, ang_max + HP);
  gfx_r = min(1, cr * hover_mul); gfx_g = min(1, cg * hover_mul); gfx_b = min(1, cb * hover_mul); gfx_a = 1;
  g_arc(kx, ky, r - 2, ang_min + HP, ang + HP); g_arc(kx, ky, r - 3, ang_min + HP, ang + HP); g_arc(kx, ky, r - 4, ang_min + HP, ang + HP);
  show_simple ? ( gfx_r = 0.15; gfx_g = 0.18; gfx_b = 0.24; ) : ( gfx_r = 0.95; gfx_g = 0.95; gfx_b = 0.96; );
  g_line(kx + cos(ang) * r * 0.25, ky + sin(ang) * r * 0.25, kx + cos(ang) * (r - 3), ky + sin(ang) * (r - 3));

  gfx_setfont(6); set_text_col();
  g_txtc(kx, ky - r - 19, "FREQ");
  fmt_freq(#kv, floor(fc + 0.5)); fc < 1000 ? strcat(#kv, " Hz");
  gfx_setfont(5);
  gfx_r = min(1, cr * hover_mul); gfx_g = min(1, cg * hover_mul); gfx_b = min(1, cb * hover_mul); gfx_a = 1;
  lab_edit == sl_hp ? ( lab_digits ? sprintf(#kv, "%d_", lab_value) : strcpy(#kv, "_ Hz"); );
  g_txtc(kx, ky + r + 5, #kv);
);

function ui_drc_oct_knob(sl_hp, sl_lp, kx, ky, r, def_oct, cr, cg, cb, info_id)
local(lo, hi, fc, oct, norm_val, ang_min, ang_max, ang, is_hover, hover_mul, is_dbl, HP, new_oct) (
  lo = clamp(min(slider(sl_hp), slider(sl_lp)), 20, 19980);
  hi = clamp(max(lo + 20, max(slider(sl_hp), slider(sl_lp))), 40, 20000);
  fc = sqrt(lo * hi);
  oct = clamp(log(hi / lo) / log(2.0), 0.12, 3.50);
  HP = $pi * 0.5;
  is_hover = hit(kx - r - 10, ky - r - 22, (r + 10) * 2, (r + 22) * 2 + 4);
  is_hover ? (
    active_info_id = info_id;
    mouse_click ? (
      set_mon(cur_mod);
      is_dbl = (ui_last_click_id == sl_lp) && ((ui_gfx_frame - ui_last_click_frame) <= 18);
      ui_last_click_id = sl_lp; ui_last_click_frame = ui_gfx_frame;
      is_dbl ? ( set_drc_band_fc_oct(sl_hp, sl_lp, fc, def_oct); ui_drag_id = 0; ) :
               ( ui_drag_id = sl_lp; ui_drag_start_y = myd; ui_drag_start_v = oct; ui_drag_aux = fc; );
    );
    mouse_right_click ? ( set_drc_band_fc_oct(sl_hp, sl_lp, fc, def_oct); );
  );
  ui_drag_id == sl_lp && mouse_down ? (
    myd != ui_drag_start_y ? (
      new_oct = clamp(ui_drag_start_v + (ui_drag_start_y - myd) * ((3.50 - 0.12) / 170.0) * fine_tune, 0.12, 3.50);
      set_drc_band_fc_oct(sl_hp, sl_lp, ui_drag_aux, new_oct);
      lo = clamp(min(slider(sl_hp), slider(sl_lp)), 20, 19980);
      hi = clamp(max(lo + 20, max(slider(sl_hp), slider(sl_lp))), 40, 20000);
      oct = clamp(log(hi / lo) / log(2.0), 0.12, 3.50);
    );
  ) : ( ui_drag_id == sl_lp && !mouse_down ? ui_drag_id = 0; );

  hover_mul = (is_hover || ui_drag_id == sl_lp) ? 1.25 : 0.92;
  ang_min = 2.356; ang_max = 7.068;
  norm_val = clamp((oct - 0.12) / (3.50 - 0.12), 0, 1);
  ang = ang_min + norm_val * (ang_max - ang_min);

  show_simple ? ( gfx_r = 0.99; gfx_g = 0.99; gfx_b = 1.0; ) : ( gfx_r = 0.17; gfx_g = 0.18; gfx_b = 0.22; );
  gfx_a = 1; g_circ(kx, ky, r, 1);
  show_simple ? ( gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.55; g_circ(kx, ky, r, 0); );
  gfx_r = show_simple ? 0.82 : 0.26; gfx_g = show_simple ? 0.85 : 0.28; gfx_b = show_simple ? 0.90 : 0.33; gfx_a = 1;
  g_arc(kx, ky, r - 2.5, ang_min + HP, ang_max + HP);
  gfx_r = min(1, cr * hover_mul); gfx_g = min(1, cg * hover_mul); gfx_b = min(1, cb * hover_mul); gfx_a = 1;
  g_arc(kx, ky, r - 2, ang_min + HP, ang + HP); g_arc(kx, ky, r - 3, ang_min + HP, ang + HP); g_arc(kx, ky, r - 4, ang_min + HP, ang + HP);
  show_simple ? ( gfx_r = 0.15; gfx_g = 0.18; gfx_b = 0.24; ) : ( gfx_r = 0.95; gfx_g = 0.95; gfx_b = 0.96; );
  g_line(kx + cos(ang) * r * 0.25, ky + sin(ang) * r * 0.25, kx + cos(ang) * (r - 3), ky + sin(ang) * (r - 3));

  gfx_setfont(6); set_text_col();
  g_txtc(kx, ky - r - 19, "OCT");
  sprintf(#kv, "%.2f", oct);
  gfx_setfont(5);
  gfx_r = min(1, cr * hover_mul); gfx_g = min(1, cg * hover_mul); gfx_b = min(1, cb * hover_mul); gfx_a = 1;
  g_txtc(kx, ky + r + 5, #kv);
);

// ---- Monitor: helper ----
function bq_mag_db(b0, b1, b2, a1, a2, w) local(c1, c2, num, den) (
  c1 = cos(w); c2 = cos(2 * w);
  num = b0*b0 + b1*b1 + b2*b2 + 2*(b0*b1 + b1*b2)*c1 + 2*b0*b2*c2;
  den = 1 + a1*a1 + a2*a2 + 2*(a1 + a1*a2)*c1 + 2*a2*c2;
  10 * log10(max(0.000000000001, num) / max(0.000000000001, den));
);
function fx_map(f) ( d_x + 36 + (log10(clamp(f, 20, 20000) / 20) / 3) * (d_w - 56); );
function dbv_map(db, lo, hi) ( d_y + 26 + (1 - (clamp(db, lo, hi) - lo) / (hi - lo)) * (d_h - 54); );
function mon_frame(cr, cg, cb) (
  gfx_r = 0.025; gfx_g = 0.04; gfx_b = 0.10; gfx_a = 1; g_rect(d_x, d_y, d_w, d_h);
  gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 0.9; g_frame(d_x, d_y, d_w, d_h);
);
function draw_freq_grid() local(i, f, x) (
  gfx_setfont(7);
  i = 0;
  loop(10,
    f = i == 0 ? 20 : i == 1 ? 50 : i == 2 ? 100 : i == 3 ? 200 : i == 4 ? 500 : i == 5 ? 1000 : i == 6 ? 2000 : i == 7 ? 5000 : i == 8 ? 10000 : 20000;
    x = fx_map(f);
    gfx_r = 0.35; gfx_g = 0.45; gfx_b = 0.75; gfx_a = 0.22; g_line(x, d_y + 22, x, d_y + d_h - 26);
    gfx_r = 0.62; gfx_g = 0.70; gfx_b = 0.90; gfx_a = 0.95;
    fmt_freq(#gl, f); g_txtc(x, d_y + d_h - 20, #gl);
    i += 1;
  );
);
function draw_db_line(db, lo, hi, lbl) local(y) (
  y = dbv_map(db, lo, hi);
  gfx_r = 0.55; gfx_g = 0.62; gfx_b = 0.85; gfx_a = db == 0 ? 0.55 : 0.18;
  g_line(d_x + 34, y, d_x + d_w - 18, y);
  gfx_setfont(7); gfx_a = 0.85; g_txtr(d_x + 30, y - 7, lbl);
);
function draw_curve(mode, lo, hi, cr, cg, cb) local(i, N, f, w, db, x, y, px, py) (
  N = 160; i = 0; px = -1;
  loop(N + 1,
    f = 20 * 10 ^ (3 * i / N);
    w = 2 * $pi * f / srate;
    f < srate * 0.49 ? (
      db = 0;
      mode == 0 ? (
        slider4 >= 0.5 ? db = bq_mag_db(hp_b0, hp_b1, hp_b2, hp_a1, hp_a2, w) + bq_mag_db(lp_b0, lp_b1, lp_b2, lp_a1, lp_a2, w);
      ) : (
        slider29 >= 0.5 ? db = bq_mag_db(tone_lo.b0, tone_lo.b1, tone_lo.b2, tone_lo.a1, tone_lo.a2, w)
                             + bq_mag_db(tone_mid.b0, tone_mid.b1, tone_mid.b2, tone_mid.a1, tone_mid.a2, w)
                             + bq_mag_db(tone_hi.b0, tone_hi.b1, tone_hi.b2, tone_hi.a1, tone_hi.a2, w);
        slider32 >= 0.5 ? db += 0.98 + bq_mag_db(mid_bump_bq.b0, mid_bump_bq.b1, mid_bump_bq.b2, mid_bump_bq.a1, mid_bump_bq.a2, w);
      );
      x = fx_map(f); y = dbv_map(db, lo, hi);
      px >= 0 ? (
        gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 0.18; g_line(px, py, px, dbv_map(0, lo, hi));
        gfx_a = 1; g_line(px, py, x, y); g_line(px, py + 1 / sc, x, y + 1 / sc);
      );
      px = x; py = y;
    );
    i += 1;
  );
);
// barra di riduzione stile Magic: cresce da destra (0 dB) verso sinistra
function hbar_gr(y, lbl, gr_db, maxdb, cr, cg, cb) local(x0, x1, w, fill) (
  x0 = d_x + 128; x1 = d_x + d_w - 96; w = x1 - x0;
  gfx_setfont(5); gfx_r = 0.72; gfx_g = 0.80; gfx_b = 0.96; gfx_a = 1; g_txt(d_x + 18, y - 2, lbl);
  gfx_r = 0.07; gfx_g = 0.10; gfx_b = 0.22; gfx_a = 1; g_rect(x0, y, w, 13);
  fill = clamp(gr_db / maxdb, 0, 1) * w;
  fill > 0 ? ( gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 0.95; g_rect(x1 - fill, y, fill, 13); );
  fmt_gr(#hb, gr_db); gfx_r = 0.95; gfx_g = 0.96; gfx_b = 1; g_txtr(d_x + d_w - 16, y - 2, #hb);
);
function gr_scale(y, maxdb) local(x0, x1, i, v, x) (
  x0 = d_x + 128; x1 = d_x + d_w - 96;
  gfx_setfont(7); gfx_r = 0.62; gfx_g = 0.70; gfx_b = 0.90; gfx_a = 0.95;
  i = 0;
  loop(5,
    v = maxdb * i / 4; x = x1 - (x1 - x0) * i / 4;
    sprintf(#gs, i == 0 ? "0dB" : "-%.0f", v); g_txtc(x, y, #gs);
    gfx_a = 0.25; g_line(x, y - 4, x, y - 104 * fy); gfx_a = 0.95;
    i += 1;
  );
);
// barra di livello sinistra->destra con eventuale marcatore
function hbar_lvl(y, lbl, db, lo, hi, cr, cg, cb, mark_db) local(x0, x1, w, fill, mx) (
  x0 = d_x + 128; x1 = d_x + d_w - 96; w = x1 - x0;
  gfx_setfont(5); gfx_r = 0.72; gfx_g = 0.80; gfx_b = 0.96; gfx_a = 1; g_txt(d_x + 18, y - 2, lbl);
  gfx_r = 0.07; gfx_g = 0.10; gfx_b = 0.22; gfx_a = 1; g_rect(x0, y, w, 13);
  fill = clamp((db - lo) / (hi - lo), 0, 1) * w;
  fill > 0 ? ( gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 0.95; g_rect(x0, y, fill, 13); );
  mark_db > lo ? ( mx = x0 + clamp((mark_db - lo) / (hi - lo), 0, 1) * w; gfx_r = 1; gfx_g = 0.85; gfx_b = 0.3; gfx_a = 1; g_rect(mx - 1, y - 3, 2, 19); );
  sprintf(#hl, "%.1f dB", db); gfx_r = 0.95; gfx_g = 0.96; gfx_b = 1; g_txtr(d_x + d_w - 16, y - 2, #hl);
);
// Risposta esatta (dB) di una banda DRC: y = x - red * SVF_BP(x)
function drc_band_mag_db(f, fc, q_val, red, sr) local(om, om0, u, u2, num, den) (
  red <= 0.0005 ? 0.0 : (
    om = tan($pi * clamp(f, 15, sr * 0.48) / sr);
    om0 = tan($pi * clamp(fc, 20, sr * 0.44) / sr);
    u = q_val * (om / max(0.0000001, om0) - om0 / max(0.0000001, om));
    u2 = u * u;
    num = (1.0 - red) * (1.0 - red) + u2;
    den = 1.0 + u2;
    10.0 * log10(max(0.000000000001, num) / max(0.000000000001, den));
  );
);
// Funzione di trasferimento complessa esatta di Dynamic EQ (albero 2 SVF a 5 bande coerenti di fase)
function deq_mag_db(f, g0, g1, g2, g3, g4, sr)
local(om, om1, k1, r1, r1sq, kr1, d1, om2, k2, r2, r2sq, kr2, d2, re2, im2, hp1_re, hp1_im, tot_re, tot_im, mag2) (
  om = tan($pi * clamp(f, 15, sr * 0.48) / sr);
  om1 = deq_svf1.g; k1 = deq_svf1.k;
  r1 = om / max(0.0000001, om1); r1sq = r1 * r1; kr1 = k1 * r1;
  d1 = (1.0 - r1sq) * (1.0 - r1sq) + kr1 * kr1;
  om2 = deq_svf2.g; k2 = deq_svf2.k;
  r2 = om / max(0.0000001, om2); r2sq = r2 * r2; kr2 = k2 * r2;
  d2 = (1.0 - r2sq) * (1.0 - r2sq) + kr2 * kr2;
  re2 = (g2 * (1.0 - r2sq) + g3 * (kr2 * kr2) - g4 * r2sq * (1.0 - r2sq)) / max(0.000000000001, d2);
  im2 = (-g2 * kr2 + g3 * kr2 * (1.0 - r2sq) + g4 * kr2 * r2sq) / max(0.000000000001, d2);
  hp1_re = (-r1sq * (1.0 - r1sq)) / max(0.000000000001, d1);
  hp1_im = (kr1 * r1sq) / max(0.000000000001, d1);
  tot_re = (g0 * (1.0 - r1sq) + g1 * (kr1 * kr1)) / max(0.000000000001, d1) + (hp1_re * re2 - hp1_im * im2);
  tot_im = (-g0 * kr1 + g1 * kr1 * (1.0 - r1sq)) / max(0.000000000001, d1) + (hp1_re * im2 + hp1_im * re2);
  mag2 = tot_re * tot_re + tot_im * tot_im;
  10.0 * log10(max(0.000000000001, mag2));
);
// Funzione di trasferimento complessa esatta di Dynamic Balance (split 1-pole a 3 bande)
function dbal_mag_db(f, g_l, g_m, g_h, sr)
local(w, cw, sw, a1, c1, den1, re1, im1, a2, c2, den2, re2, im2, tot_re, tot_im, mag2) (
  w = 2.0 * $pi * clamp(f, 15, sr * 0.48) / sr;
  cw = cos(w); sw = sin(w);
  c1 = dbal_c_lo; a1 = 1.0 - c1;
  den1 = (1.0 - a1 * cw) * (1.0 - a1 * cw) + (a1 * sw) * (a1 * sw);
  re1 = c1 * (1.0 - a1 * cw) / max(0.000000000001, den1);
  im1 = -c1 * a1 * sw / max(0.000000000001, den1);
  c2 = dbal_c_hi; a2 = 1.0 - c2;
  den2 = (1.0 - a2 * cw) * (1.0 - a2 * cw) + (a2 * sw) * (a2 * sw);
  re2 = c2 * (1.0 - a2 * cw) / max(0.000000000001, den2);
  im2 = -c2 * a2 * sw / max(0.000000000001, den2);
  tot_re = (g_l - g_m) * re1 + (g_m - g_h) * re2 + g_h;
  tot_im = (g_l - g_m) * im1 + (g_m - g_h) * im2;
  mag2 = tot_re * tot_re + tot_im * tot_im;
  10.0 * log10(max(0.000000000001, mag2));
);
// Campana SVF reale della singola banda DRC (anteprima statica + taglio dinamico su [-maxdb..0])
function band_gr(f_a, f_b, gr_db, maxdb, eng, lbl, idx, cr, cg, cb)
local(lo, hi, fc, q_val, oct, red, sr_m, N, i, f, x, y, gy, y0, y_bot, y_apx, is_focus, px, py, pgx, pgy, g_red, db_g, db_c, xc, xl, xh, xl_lbl, y_lbl, pw_lbl) (
  lo = clamp(min(f_a, f_b), 20, 19980);
  hi = clamp(max(lo + 20, max(f_a, f_b)), 40, 20000);
  sr_m = max(22050, srate);
  fc = min(sqrt(lo * hi), sr_m * 0.44);
  q_val = clamp(fc / max(20, hi - lo), 0.5, 12.0);
  oct = clamp(log(hi / lo) / log(2.0), 0.12, 3.50);
  red = eng ? (1.0 - db2lin(-clamp(gr_db, 0, maxdb))) : 0;
  y0 = dbv_map(0, -maxdb, 0);
  y_bot = dbv_map(-maxdb, -maxdb, 0);
  is_focus = (ui_drag_id >= (10 + idx * 4) && ui_drag_id <= (12 + idx * 4))
          || (lab_edit == (10 + idx * 4))
          || (drc_solo_audition_band == (idx + 1));
  g_red = 1.0 - db2lin(-2.6);

  // Riferimenti verticali: linea apice centro frequenza fc + tacche a -3 dB (lo / hi)
  xc = fx_map(fc); xl = fx_map(lo); xh = fx_map(hi);
  gfx_r = cr; gfx_g = cg; gfx_b = cb;
  gfx_a = eng ? (is_focus ? 0.88 : 0.54) : 0.16;
  g_line(xc, y0, xc, y_bot);
  eng ? (
    gfx_a = is_focus ? 0.42 : 0.20;
    g_line(xc + 1 / sc, y0, xc + 1 / sc, y_bot);
    gfx_a = is_focus ? 1.0 : 0.85;
    g_rect(xc - 1.5, y0 - 2.5, 3, 5);
    g_rect(xc - 1.5, y_bot - 4, 3, 5);
  );
  gfx_a = eng ? 0.45 : 0.18; g_line(xl, y0 - 2, xl, y0 + 5); g_line(xh, y0 - 2, xh, y0 + 5);

  N = 140; i = 0; pgx = -1; px = -1;
  loop(N + 1,
    f = 20 * 10 ^ (3 * i / N);
    f < sr_m * 0.48 ? (
      x = fx_map(f);
      // Guida statica morbida della campana
      db_g = drc_band_mag_db(f, fc, q_val, g_red, sr_m);
      gy = dbv_map(db_g, -maxdb, 0);
      pgx >= 0 ? (
        gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = eng ? (is_focus ? 0.56 : 0.36) : 0.14;
        g_line(pgx, pgy, x, gy);
      );
      pgx = x; pgy = gy;

      // Curva dinamica reale durante l'attenuazione
      eng && gr_db > 0.05 ? (
        db_c = drc_band_mag_db(f, fc, q_val, red, sr_m);
        y = dbv_map(db_c, -maxdb, 0);
        px >= 0 ? (
          gfx_r = cr; gfx_g = cg; gfx_b = cb;
          gfx_a = 0.26; g_line(px, py, px, y0);
          gfx_a = 0.98; g_line(px, py, x, y); g_line(px, py + 1 / sc, x, y + 1 / sc);
        );
        px = x; py = y;
      );
    );
    i += 1;
  );

  eng && gr_db > 0.05 ? (
    y_apx = dbv_map(-clamp(gr_db, 0, maxdb), -maxdb, 0);
    gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 1.0;
    g_circ(xc, y_apx, 2.5, 1);
  );

  // Pillola informativa sopra o vicino alla campana
  fmt_freq(#bf_s, floor(fc + 0.5));
  gr_db < 0.05 ? sprintf(#bl, "%s %s (%.1fo) 0.0", lbl, #bf_s, oct)
               : sprintf(#bl, "%s %s (%.1fo) -%.1f", lbl, #bf_s, oct, gr_db);
  gfx_setfont(7);
  pw_lbl = g_tw(#bl) + 10;
  xl_lbl = clamp(xc, d_x + 36 + pw_lbl * 0.5, d_x + d_w - 20 - pw_lbl * 0.5);
  y_lbl = d_y + 30 + (idx % 2) * 15;
  gfx_r = 0.025; gfx_g = 0.04; gfx_b = 0.10; gfx_a = 0.78;
  g_rect(xl_lbl - pw_lbl * 0.5, y_lbl - 1, pw_lbl, 13);
  gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = eng ? 0.98 : 0.48;
  g_txtc(xl_lbl, y_lbl, #bl);
);

// ============================================================================
// SFONDO + HEADER
// ============================================================================
gfx_r = bg_r; gfx_g = bg_g; gfx_b = bg_b; gfx_a = 1; gfx_rect(0, 0, gfx_w, gfx_h);

draw_panel(16, 10, 1068, 110);
gfx_r = c_cyan_r; gfx_g = c_cyan_g; gfx_b = c_cyan_b; gfx_a = 0.95; g_rect(16, 10, 1068, 4);
gfx_setfont(1); set_text_col();
g_txt(30, 21, "ZP MAGIC VOICE LAB");
dot_x = 30 + g_tw("ZP MAGIC VOICE LAB") + 16;
zp_bus_read();
zp_bus_master_conn == 2 && zp_bus_probe_conn == 2 ? (gfx_r = 0.30; gfx_g = 0.92; gfx_b = 0.58;) :
zp_bus_master_conn > 0 && zp_bus_probe_conn > 0 ? (gfx_r = 1.0; gfx_g = 0.72; gfx_b = 0.20;) : (gfx_r = 1.0; gfx_g = 0.34; gfx_b = 0.28;);
gfx_a = 1; g_circ(dot_x, 32, 5, 1);
cur_preset = floor(slider44 + 0.5);
pname = cur_preset == 1 ? "MALE LD" : cur_preset == 2 ? "FEMALE LD" : cur_preset == 3 ? "CLARITY" : cur_preset == 4 ? "MID PC" :
        cur_preset == 5 ? "HOME BOOTH FIX" : cur_preset == 6 ? "BROADCAST" : cur_preset == 7 ? "MAGIC 1" : "Custom";
sprintf(#hdr, "v1.2.3  ·  Paolo Balestri  ·  Preset: %s", pname);
gfx_setfont(5); set_sub_col(); g_txt(dot_x + 14, 25, #hdr);

px = 30; py = 50;
ui_tab_btn(44, 1, px,       py, 100, 25, "MALE LD",    201, c_cyan_r,  c_cyan_g,  c_cyan_b, -1);
ui_tab_btn(44, 2, px + 106, py, 108, 25, "FEMALE LD",  202, c_mag_r,   c_mag_g,   c_mag_b, -1);
ui_tab_btn(44, 3, px + 220, py, 96,  25, "CLARITY",    203, c_cyan_r,  c_cyan_g,  c_cyan_b, -1);
ui_tab_btn(44, 4, px + 322, py, 86,  25, "MID PC",     204, c_amber_r, c_amber_g, c_amber_b, -1);
ui_tab_btn(44, 5, px + 414, py, 118, 25, "HOME BOOTH", 205, c_grn_r,   c_grn_g,   c_grn_b, -1);
ui_tab_btn(44, 6, px + 538, py, 106, 25, "BROADCAST",  206, c_amber_r, c_amber_g, c_amber_b, -1);
ui_tab_btn(44, 7, px + 650, py, 96,  25, "MAGIC 1",    207, c_mag_r,   c_mag_g,   c_mag_b, -1);

sy = 84;
ui_toggle_btn(4,  px,       sy, 88, 25, "1·FILTERS", 210, c_cyan_r,  c_cyan_g,  c_cyan_b, 0);
ui_toggle_btn(5,  px + 94,  sy, 88, 25, "2·PREAMP",  211, c_amber_r, c_amber_g, c_amber_b, 0);
ui_toggle_btn(7,  px + 188, sy, 80, 25, "3·PEAK",    212, c_cyan_r,  c_cyan_g,  c_cyan_b, 1);
ui_toggle_btn(8,  px + 274, sy, 76, 25, "4·DRC",     213, c_mag_r,   c_mag_g,   c_mag_b, 2);
ui_toggle_btn(26, px + 356, sy, 88, 25, "5·DYN EQ",  214, c_cyan_r,  c_cyan_g,  c_cyan_b, 3);
ui_toggle_btn(29, px + 450, sy, 80, 25, "6·TONE",    215, c_amber_r, c_amber_g, c_amber_b, 4);
ui_toggle_btn(32, px + 536, sy, 96, 25, "MID BUMP",  216, c_mag_r,   c_mag_g,   c_mag_b, 4);
ui_toggle_btn(33, px + 638, sy, 108,25, "7·DYN BAL", 217, c_grn_r,   c_grn_g,   c_grn_b, 5);

rx = 810;
ui_tab_btn(43, 0, rx,       20, 82, 24, "FULL", 220, c_grn_r, c_grn_g, c_grn_b, -1);
ui_tab_btn(43, 1, rx + 89,  20, 82, 24, "MINI", 220, c_grn_r, c_grn_g, c_grn_b, -1);
ui_tab_btn(43, 2, rx + 178, 20, 82, 24, "JSFX", 220, c_grn_r, c_grn_g, c_grn_b, -1);
ui_tab_btn(42, 0, rx,       50, 126, 25, msg("CHIARO", "LIGHT"), 221, c_cyan_r,  c_cyan_g,  c_cyan_b, -1);
ui_tab_btn(42, 1, rx + 134, 50, 126, 25, msg("SCURO",  "DARK"),  221, c_amber_r, c_amber_g, c_amber_b, -1);
ui_toggle_btn(38, rx,       84, 94,  25, "GAIN MATCH", 222, c_grn_r, c_grn_g, c_grn_b, 6);

// DELTA globale (lampeggiante quando attivo, con auto-off a 30s)
delta_on_ui = slider39 >= 0.5;
delta_blink = sin(time_now * 7.0) > 0;
d_hv = hit(rx + 100, 84, 74, 25);
d_hv ? ( active_info_id = 223; );
d_hv && mouse_click ? (
  set_param_slider(39, delta_on_ui ? 0 : 1);
  set_mon(6);
  update_dsp_params();
  !delta_on_ui ? (
    delta_arm_time = time_now;
    delta_spring_armed = 0; delta_spring_stage = 0; ui_hold_delta_stage = 0;
    slider25 > 0 ? ( set_param_slider(25, 0); );
    ui_hold_solo_btn = 0; drc_solo_audition_band = 0;
  );
  delta_on_ui = !delta_on_ui;
);
delta_on_ui ? (
  btn_face(rx + 100, 84, 74, 25, "DELTA", 1, d_hv, delta_blink ? 0.98 : 1.00, delta_blink ? 0.22 : 0.62, delta_blink ? 0.46 : 0.14);
) : (
  btn_face(rx + 100, 84, 74, 25, "DELTA", 0, d_hv, c_mag_r, c_mag_g, c_mag_b);
);

// DELTA MOLLA esteso a tutti i moduli
dm_hv = hit(rx + 180, 84, 80, 25);
dm_hv ? ( active_info_id = 224; );
dm_hv && mouse_click ? (
  delta_spring_armed = !delta_spring_armed;
  delta_spring_armed ? (
    delta_spring_time = time_now;
    slider39 >= 0.5 ? ( set_param_slider(39, 0); );
    slider25 > 0 ? ( set_param_slider(25, 0); );
    ui_hold_solo_btn = 0; drc_solo_audition_band = 0;
  ) : (
    delta_spring_stage = 0; ui_hold_delta_stage = 0;
  );
);
delta_spring_stage > 0 ? (
  btn_face(rx + 180, 84, 80, 25, msg("D·MOLLA", "S·DELTA"), 1, dm_hv, 1.0, 0.64, 0.16);
) : delta_spring_armed ? (
  btn_face(rx + 180, 84, 80, 25, msg("D·MOLLA", "S·DELTA"), 1, dm_hv, 0.90, 0.36, 0.62);
) : (
  btn_face(rx + 180, 84, 80, 25, msg("D·MOLLA", "S·DELTA"), 0, dm_hv, c_amber_r, c_amber_g, c_amber_b);
);

// ============================================================================
// PANNELLI (vista FULL)
// ============================================================================
view_mode == 0 ? (
  r1y = 132; r1h = 360;

  // ---- 1 · INPUT & PEAK / FILTERS & PREAMP ----
  p1_pk_act = (mon_sel == 1);
  p1_fl_act = (mon_sel == 0);
  p1_act = p1_pk_act || p1_fl_act;
  p1_pk_act ? ( p1_r = c_amber_r; p1_g = c_amber_g; p1_b = c_amber_b; ) :
              ( p1_r = c_cyan_r;  p1_g = c_cyan_g;  p1_b = c_cyan_b; );
  draw_panel_hl(16, r1y, 252, r1h, p1_act, p1_r, p1_g, p1_b);
  draw_group_title_ex(16, r1y, 252, 28, "1 · INPUT & PEAK", p1_pk_act ? c_amber_r : c_cyan_r, p1_pk_act ? c_amber_g : c_cyan_g, p1_pk_act ? c_amber_b : c_cyan_b, 1, p1_pk_act);

  // Zona superiore: Input & Peak Leveler
  hit(18, r1y + 29, 248, 141) && mouse_click ? set_mon(1);
  p1_pk_act ? (
    gfx_r = c_amber_r; gfx_g = c_amber_g; gfx_b = c_amber_b;
    gfx_a = show_simple ? 0.10 : 0.11; g_rect(18, r1y + 29, 248, 141);
    gfx_a = 0.95; g_rect(18, r1y + 30, 3, 139);
  );
  cur_mod = 1;
  ui_knob(1, 82,  r1y + 86, 27, -12, 12, 0, "INPUT", "dB", c_cyan_r, c_cyan_g, c_cyan_b, 101, -1);
  ui_knob(6, 202, r1y + 86, 27, 0, 100, 45, "PEAK RED", "%", c_amber_r, c_amber_g, c_amber_b, 102, min(100, ui_peak_gr_db * 8));
  gfx_setfont(5); set_sub_col(); g_txt(28, r1y + 146, "Opto+RComp");
  draw_meter_h(116, r1y + 149, 136, 11, min(100, ui_peak_gr_db * 7), c_amber_r, c_amber_g, c_amber_b);

  // Linea di separazione e sotto-testata cliccabile: Filters & Preamp
  p1_fl_act ? ( gfx_r = c_cyan_r; gfx_g = c_cyan_g; gfx_b = c_cyan_b; gfx_a = 0.95; g_rect(18, r1y + 172, 248, 2); ) :
              ( gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.95; g_rect(22, r1y + 172, 240, 1); );
  fl_hdr_hv = hit(18, r1y + 174, 248, 22);
  fl_hdr_hv ? ( active_info_id = 232; mouse_click ? set_mon(0); );
  p1_fl_act ? (
    gfx_r = c_cyan_r; gfx_g = c_cyan_g; gfx_b = c_cyan_b;
    gfx_a = show_simple ? 0.26 : 0.30; g_rect(18, r1y + 174, 248, 22);
  ) : fl_hdr_hv ? (
    gfx_r = c_cyan_r; gfx_g = c_cyan_g; gfx_b = c_cyan_b; gfx_a = 0.14; g_rect(18, r1y + 174, 248, 22);
  );
  gfx_setfont(6);
  p1_fl_act ? ( show_simple ? ( gfx_r = 0.06; gfx_g = 0.08; gfx_b = 0.12; ) : ( gfx_r = 0.98; gfx_g = 0.99; gfx_b = 1.0; ); gfx_a = 1; ) : set_text_col();
  g_txt(28, r1y + 179, "FILTERS & PREAMP");
  draw_mon_badge(260, r1y + 177, p1_fl_act, fl_hdr_hv, c_cyan_r, c_cyan_g, c_cyan_b);

  // Zona inferiore: Filters & Preamp
  hit(18, r1y + 196, 248, 162) && mouse_click ? set_mon(0);
  p1_fl_act ? (
    gfx_r = c_cyan_r; gfx_g = c_cyan_g; gfx_b = c_cyan_b;
    gfx_a = show_simple ? 0.10 : 0.11; g_rect(18, r1y + 196, 248, 161);
    gfx_a = 0.95; g_rect(18, r1y + 196, 3, 160);
  );
  cur_mod = 0;
  ui_knob(2, 82,  r1y + 250, 26, 20, 250, 75, "LOWCUT", "Hz", c_cyan_r, c_cyan_g, c_cyan_b, 103, -1);
  ui_knob(3, 202, r1y + 250, 26, 8000, 20000, 18000, "HICUT", "Hz", c_cyan_r, c_cyan_g, c_cyan_b, 104, -1);
  ui_toggle_btn(5, 28,  r1y + 318, 108, 28, "TUBE PREAMP", 105, c_amber_r, c_amber_g, c_amber_b, 0);
  ui_toggle_btn(4, 144, r1y + 318, 112, 28, "FILTERS",     106, c_cyan_r,  c_cyan_g,  c_cyan_b, 0);

  // ---- 2 · DRC ----
  p2_act = (mon_sel == 2);
  draw_panel_hl(280, r1y, 444, r1h, p2_act, c_mag_r, c_mag_g, c_mag_b);
  hit(280, r1y + 28, 444, r1h - 28) && mouse_click ? set_mon(2);
  draw_group_title_ex(280, r1y, 444, 28, "2 · DRC", c_mag_r, c_mag_g, c_mag_b, 2, p2_act);
  cur_mod = 2;
  sprintf(#lbA, "A · %s", band_role(slider10, slider11));
  sprintf(#lbB, "B · %s", band_role(slider14, slider15));
  sprintf(#lbC, "C · %s", band_role(slider18, slider19));
  sprintf(#lbD, "D · %s", band_role(slider22, slider23));
  cxA = 288; cxB = 396; cxC = 504; cxD = 612;

  // Confini grafici verticali tra le 4 colonne A | B | C | D
  gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.75;
  g_line(395, r1y + 38, 395, r1y + 346);
  g_line(503, r1y + 38, 503, r1y + 346);
  g_line(611, r1y + 38, 611, r1y + 346);

  ui_toggle_btn(9,  cxA + 3, r1y + 38, 100, 25, #lbA, 111, c_cyan_r,  c_cyan_g,  c_cyan_b, 2);
  ui_toggle_btn(13, cxB + 3, r1y + 38, 100, 25, #lbB, 112, c_amber_r, c_amber_g, c_amber_b, 2);
  ui_toggle_btn(17, cxC + 3, r1y + 38, 100, 25, #lbC, 113, c_mag_r,   c_mag_g,   c_mag_b, 2);
  ui_toggle_btn(21, cxD + 3, r1y + 38, 100, 25, #lbD, 114, c_grn_r,   c_grn_g,   c_grn_b, 2);

  ui_knob(12, cxA + 53, r1y + 120, 27, 0, 100, 75, "THR A", "%", c_cyan_r,  c_cyan_g,  c_cyan_b,  121, min(100, ui_drcA * 10));
  ui_knob(16, cxB + 53, r1y + 120, 27, 0, 100, 59, "THR B", "%", c_amber_r, c_amber_g, c_amber_b, 122, min(100, ui_drcB * 10));
  ui_knob(20, cxC + 53, r1y + 120, 27, 0, 100, 50, "THR C", "%", c_mag_r,   c_mag_g,   c_mag_b,   123, min(100, ui_drcC * 10));
  ui_knob(24, cxD + 53, r1y + 120, 27, 0, 100, 0,  "THR D", "%", c_grn_r,   c_grn_g,   c_grn_b,   124, min(100, ui_drcD * 10));

  ui_drc_freq_knob(10, 11, cxA + 28, r1y + 220, 18, 7994, c_cyan_r,  c_cyan_g,  c_cyan_b,  131);
  ui_drc_oct_knob( 10, 11, cxA + 78, r1y + 220, 18, 0.58, c_cyan_r,  c_cyan_g,  c_cyan_b,  135);
  ui_drc_freq_knob(14, 15, cxB + 28, r1y + 220, 18, 299,  c_amber_r, c_amber_g, c_amber_b, 132);
  ui_drc_oct_knob( 14, 15, cxB + 78, r1y + 220, 18, 0.72, c_amber_r, c_amber_g, c_amber_b, 136);
  ui_drc_freq_knob(18, 19, cxC + 28, r1y + 220, 18, 1961, c_mag_r,   c_mag_g,   c_mag_b,   133);
  ui_drc_oct_knob( 18, 19, cxC + 78, r1y + 220, 18, 0.86, c_mag_r,   c_mag_g,   c_mag_b,   137);
  ui_drc_freq_knob(22, 23, cxD + 28, r1y + 220, 18, 7357, c_grn_r,   c_grn_g,   c_grn_b,   134);
  ui_drc_oct_knob( 22, 23, cxD + 78, r1y + 220, 18, 0.64, c_grn_r,   c_grn_g,   c_grn_b,   138);

  fmt_freq(#sp1, min(slider10, slider11)); fmt_freq(#sp2, max(slider10, slider11)); sprintf(#spa, "%s-%s", #sp1, #sp2);
  fmt_freq(#sp1, min(slider14, slider15)); fmt_freq(#sp2, max(slider14, slider15)); sprintf(#spb, "%s-%s", #sp1, #sp2);
  fmt_freq(#sp1, min(slider18, slider19)); fmt_freq(#sp2, max(slider18, slider19)); sprintf(#spc, "%s-%s", #sp1, #sp2);
  fmt_freq(#sp1, min(slider22, slider23)); fmt_freq(#sp2, max(slider22, slider23)); sprintf(#spd, "%s-%s", #sp1, #sp2);
  gfx_setfont(7); set_sub_col(); gfx_a = 0.85;
  g_txtc(cxA + 53, r1y + 258, #spa);
  g_txtc(cxB + 53, r1y + 258, #spb);
  g_txtc(cxC + 53, r1y + 258, #spc);
  g_txtc(cxD + 53, r1y + 258, #spd);

  draw_meter_h(cxA + 8, r1y + 274, 90, 10, min(100, ui_drcA * 10), c_cyan_r,  c_cyan_g,  c_cyan_b);
  draw_meter_h(cxB + 8, r1y + 274, 90, 10, min(100, ui_drcB * 10), c_amber_r, c_amber_g, c_amber_b);
  draw_meter_h(cxC + 8, r1y + 274, 90, 10, min(100, ui_drcC * 10), c_mag_r,   c_mag_g,   c_mag_b);
  draw_meter_h(cxD + 8, r1y + 274, 90, 10, min(100, ui_drcD * 10), c_grn_r,   c_grn_g,   c_grn_b);
  gfx_setfont(7); set_sub_col();
  fmt_gr(#gv, ui_drcA); g_txtc(cxA + 53, r1y + 289, #gv);
  fmt_gr(#gv, ui_drcB); g_txtc(cxB + 53, r1y + 289, #gv);
  fmt_gr(#gv, ui_drcC); g_txtc(cxC + 53, r1y + 289, #gv);
  fmt_gr(#gv, ui_drcD); g_txtc(cxD + 53, r1y + 289, #gv);

  // Logica sistema a molla (Auto-Solo sui 3 rotori della zona armata + rilascio automatico)
  cur_solo_arm = floor(slider25 + 0.5);
  drag_drc_zone = (ui_drag_id >= 10 && ui_drag_id <= 12) ? 1 :
                  (ui_drag_id >= 14 && ui_drag_id <= 16) ? 2 :
                  (ui_drag_id >= 18 && ui_drag_id <= 20) ? 3 :
                  (ui_drag_id >= 22 && ui_drag_id <= 24) ? 4 : 0;
  // Se tocchi un controllo di un'altra zona o un altro modulo, oppure dopo 10s di inattivita', il Solo si disarma da solo
  cur_solo_arm > 0 && (
    (ui_drag_id > 0 && drag_drc_zone != cur_solo_arm) ||
    (time_now - solo_arm_time > 10.0 && ui_hold_solo_btn == 0 && drag_drc_zone == 0)
  ) ? (
    set_param_slider(25, 0);
    cur_solo_arm = 0;
    drc_solo_audition_band = 0;
  );
  mouse_down && cur_solo_arm > 0 && drag_drc_zone == cur_solo_arm ? (
    solo_arm_time = time_now;
    drc_solo_audition_band = cur_solo_arm;
  ) : mouse_down && ui_hold_solo_btn > 0 ? (
    solo_arm_time = time_now;
    drc_solo_audition_band = ui_hold_solo_btn;
  ) : (
    drc_solo_audition_band = 0;
  );

  // Pulsantino / spia di sgancio in alto accanto a "2 · DRC" quando la molla e' armata
  cur_solo_arm > 0 ? (
    sprintf(#hdr_solo, drc_solo_audition_band > 0 ? "IN PREASCOLTO %s [X]" : "MOLLA %s (%ds) [X]",
            cur_solo_arm == 1 ? "A" : cur_solo_arm == 2 ? "B" : cur_solo_arm == 3 ? "C" : "D",
            max(1, floor(10.9 - (time_now - solo_arm_time))));
    ui_drc_solo_btn(0, 0, 355, r1y + 6, 138, 20, #hdr_solo, 1.0, 0.72, 0.16);
  );

  // Avviso visivo di preascolto nel pannello DRC
  drc_solo_audition_band > 0 ? (
    gfx_r = 0.98; gfx_g = 0.58; gfx_b = 0.12; gfx_a = 0.95;
    g_rect(288, r1y + 298, 424, 17);
    gfx_setfont(7); gfx_r = 0.05; gfx_g = 0.05; gfx_b = 0.07; gfx_a = 1;
    sprintf(#swrn, "PREASCOLTO ATTIVO BANDA %s (rilascia il mouse per tornare alla voce intera)",
            drc_solo_audition_band == 1 ? "A" : drc_solo_audition_band == 2 ? "B" : drc_solo_audition_band == 3 ? "C" : "D");
    g_txtc(500, r1y + 300, #swrn);
  ) : cur_solo_arm > 0 ? (
    gfx_r = 0.24; gfx_g = 0.19; gfx_b = 0.08; gfx_a = 0.95;
    g_rect(288, r1y + 298, 424, 17);
    gfx_r = 1.0; gfx_g = 0.76; gfx_b = 0.22; gfx_a = 0.9;
    g_frame(288, r1y + 298, 424, 17);
    gfx_setfont(7); gfx_r = 1.0; gfx_g = 0.84; gfx_b = 0.35; gfx_a = 1;
    sprintf(#swrn, "MOLLA SOLO %s ARMATA: tocca THR / FREQ / OCT sopra per preascoltare (auto-off %ds)",
            cur_solo_arm == 1 ? "A" : cur_solo_arm == 2 ? "B" : cur_solo_arm == 3 ? "C" : "D",
            max(1, floor(10.9 - (time_now - solo_arm_time))));
    g_txtc(500, r1y + 300, #swrn);
  );

  slider8 < 0.5 ? (
    drc_byp_hv = hit(362, r1y + 5, 136, 18);
    drc_byp_bn = hit(288, r1y + 298, 424, 17);
    drc_byp_hv || drc_byp_bn ? (
      active_info_id = 213;
      mouse_click ? ( set_param_slider(8, 1); set_mon(2); update_dsp_params(); );
    );
    gfx_r = drc_byp_hv ? 1.0 : 0.92; gfx_g = 0.30; gfx_b = 0.26; gfx_a = 0.95;
    g_rect(362, r1y + 5, 136, 18);
    gfx_setfont(7); gfx_r = 0.05; gfx_g = 0.05; gfx_b = 0.07; gfx_a = 1;
    g_txtc(430, r1y + 7, msg("BYPASSED [ATTIVA]", "BYPASSED [ENABLE]"));

    gfx_r = drc_byp_bn ? 0.38 : 0.26; gfx_g = 0.10; gfx_b = 0.10; gfx_a = 0.95;
    g_rect(288, r1y + 298, 424, 17);
    gfx_r = 0.95; gfx_g = 0.34; gfx_b = 0.28; gfx_a = 0.92;
    g_frame(288, r1y + 298, 424, 17);
    gfx_setfont(7); gfx_r = 1.0; gfx_g = 0.78; gfx_b = 0.74; gfx_a = 1;
    g_txtc(500, r1y + 300, msg("4·DRC SPENTO IN TESTATA: clicca qui o su 4·DRC per riattivare", "4·DRC BYPASSED IN HEADER: click here or 4·DRC to enable"));
  );

  // 4 pulsanti SOLO allineati esattamente sotto le 4 colonne A, B, C, D (larghezza 100 px ciascuno)
  ui_drc_solo_btn(1, 9,  cxA + 3, r1y + 318, 100, 28, drc_solo_audition_band == 1 ? "IN SOLO A" : cur_solo_arm == 1 ? "MOLLA A" : "SOLO A", c_cyan_r,  c_cyan_g,  c_cyan_b);
  ui_drc_solo_btn(2, 13, cxB + 3, r1y + 318, 100, 28, drc_solo_audition_band == 2 ? "IN SOLO B" : cur_solo_arm == 2 ? "MOLLA B" : "SOLO B", c_amber_r, c_amber_g, c_amber_b);
  ui_drc_solo_btn(3, 17, cxC + 3, r1y + 318, 100, 28, drc_solo_audition_band == 3 ? "IN SOLO C" : cur_solo_arm == 3 ? "MOLLA C" : "SOLO C", c_mag_r,   c_mag_g,   c_mag_b);
  ui_drc_solo_btn(4, 21, cxD + 3, r1y + 318, 100, 28, drc_solo_audition_band == 4 ? "IN SOLO D" : cur_solo_arm == 4 ? "MOLLA D" : "SOLO D", c_grn_r,   c_grn_g,   c_grn_b);

  // ---- 3 · DYN EQ, TONE & BALANCE ----
  p3_deq_act = (mon_sel == 3); p3_ton_act = (mon_sel == 4); p3_bal_act = (mon_sel == 5);
  p3_act = p3_deq_act || p3_ton_act || p3_bal_act;
  p3_deq_act ? ( p3_r = c_cyan_r;  p3_g = c_cyan_g;  p3_b = c_cyan_b; ) :
  p3_ton_act ? ( p3_r = c_amber_r; p3_g = c_amber_g; p3_b = c_amber_b; ) :
               ( p3_r = c_grn_r;   p3_g = c_grn_g;   p3_b = c_grn_b; );
  p3_next_mon = mon_sel == 3 ? 4 : mon_sel == 4 ? 5 : 3;
  draw_panel_hl(736, r1y, 348, 236, p3_act, p3_r, p3_g, p3_b);
  draw_group_title_ex(736, r1y, 348, 28, "3 · DYN EQ, TONE & BALANCE", p3_r, p3_g, p3_b, p3_next_mon, p3_act);

  gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.45;
  g_line(746, r1y + 97, 1074, r1y + 97);
  g_line(746, r1y + 165, 1074, r1y + 165);

  ry0 = r1y + 30;
  draw_p3_row_bg(ry0, p3_deq_act, c_cyan_r, c_cyan_g, c_cyan_b, "DYN EQ", msg("Curva A-D", "Curve A-D"), 3);
  cur_mod = 3;
  ui_knob(28, 782, ry0 + 26, 18, 0, 100, 52, "", "%", c_cyan_r, c_cyan_g, c_cyan_b, 140, min(100, max(ui_deq_lo, ui_deq_hi) * 14));
  ui_tab_btn(27, 0, 830,  ry0 + 29, 56, 26, "A", 141, c_cyan_r, c_cyan_g, c_cyan_b, 3);
  ui_tab_btn(27, 1, 892,  ry0 + 29, 56, 26, "B", 141, c_cyan_r, c_cyan_g, c_cyan_b, 3);
  ui_tab_btn(27, 2, 954,  ry0 + 29, 56, 26, "C", 141, c_cyan_r, c_cyan_g, c_cyan_b, 3);
  ui_tab_btn(27, 3, 1016, ry0 + 29, 56, 26, "D", 141, c_cyan_r, c_cyan_g, c_cyan_b, 3);

  ry1 = r1y + 98;
  draw_p3_row_bg(ry1, p3_ton_act, c_amber_r, c_amber_g, c_amber_b, "TONE SCL", msg("Curva A-D", "Curve A-D"), 4);
  cur_mod = 4;
  ui_knob(31, 782, ry1 + 26, 18, 0.2, 3.5, 1.56, "", "x", c_amber_r, c_amber_g, c_amber_b, 142, -1);
  ui_tab_btn(30, 0, 830,  ry1 + 29, 56, 26, "A", 143, c_amber_r, c_amber_g, c_amber_b, 4);
  ui_tab_btn(30, 1, 892,  ry1 + 29, 56, 26, "B", 143, c_amber_r, c_amber_g, c_amber_b, 4);
  ui_tab_btn(30, 2, 954,  ry1 + 29, 56, 26, "C", 143, c_amber_r, c_amber_g, c_amber_b, 4);
  ui_tab_btn(30, 3, 1016, ry1 + 29, 56, 26, "D", 143, c_amber_r, c_amber_g, c_amber_b, 4);

  ry2 = r1y + 166;
  draw_p3_row_bg(ry2, p3_bal_act, c_grn_r, c_grn_g, c_grn_b, "DYN BAL", msg("Profilo A/B", "Profile A/B"), 5);
  cur_mod = 5;
  ui_knob(35, 782, ry2 + 26, 18, 0, 100, 31, "", "%", c_grn_r, c_grn_g, c_grn_b, 144, dbal_act_pct);
  ui_tab_btn(34, 0, 830, ry2 + 29, 118, 26, "A · NATURAL", 145, c_grn_r, c_grn_g, c_grn_b, 5);
  ui_tab_btn(34, 1, 954, ry2 + 29, 118, 26, "B · DENSE",   145, c_grn_r, c_grn_g, c_grn_b, 5);

  // ---- Isoletta dedicata: USCITA · OUTPUT ----
  out_y = r1y + 242; out_h = 118;
  p4_act = (mon_sel == 6);
  draw_panel_hl(736, out_y, 348, out_h, p4_act, c_grn_r, c_grn_g, c_grn_b);
  !p4_act ? (
    gfx_r = panel2_r; gfx_g = panel2_g; gfx_b = panel2_b; gfx_a = 0.45;
    g_rect(738, out_y + 24, 344, out_h - 26);
  );
  hit(736, out_y + 24, 348, out_h - 24) && mouse_click ? set_mon(6);
  draw_group_title_ex(736, out_y, 348, 24, msg("USCITA · OUTPUT", "OUTPUT STAGE"), c_grn_r, c_grn_g, c_grn_b, 6, p4_act);
  cur_mod = 6;
  ui_knob(36, 798,  out_y + 71, 21, 0, 100, 100, "MIX", "%", c_grn_r, c_grn_g, c_grn_b, 146, -1);
  ui_knob(37, 910,  out_y + 71, 21, -12, 12, 0, "OUTPUT", "dB", c_cyan_r, c_cyan_g, c_cyan_b, 147, -1);
  ui_knob(41, 1022, out_y + 71, 21, -3.0, -0.1, -0.5, "PEAK CEIL", "dB", c_mag_r, c_mag_g, c_mag_b, 148, clamp(((lin2db(tp_meter_peak) + 18) / 18) * 100, 0, 100));
);

!mouse_down ? ( ui_hold_delta_stage = 0; );
drag_delta_stage = (ui_drag_id == 2 || ui_drag_id == 3) ? 1 :
                   (ui_drag_id == 6) ? 3 :
                   (ui_drag_id >= 10 && ui_drag_id <= 12) ? 4 :
                   (ui_drag_id >= 14 && ui_drag_id <= 16) ? 5 :
                   (ui_drag_id >= 18 && ui_drag_id <= 20) ? 6 :
                   (ui_drag_id >= 22 && ui_drag_id <= 24) ? 7 :
                   (ui_drag_id == 28) ? 8 :
                   (ui_drag_id == 31) ? 9 :
                   (ui_drag_id == 35) ? 10 :
                   (ui_drag_id == 1 || ui_drag_id == 36 || ui_drag_id == 37) ? 11 :
                   (ui_drag_id == 41) ? 12 : 0;
delta_spring_armed && mouse_down ? (
  delta_spring_stage = drag_delta_stage > 0 ? drag_delta_stage : ui_hold_delta_stage;
  delta_spring_stage > 0 ? ( delta_spring_time = time_now; delta_spring_aud_hb = time_now; );
) : (
  delta_spring_stage = 0;
);
drc_solo_audition_band > 0 ? ( drc_solo_aud_hb = time_now; );

// Avviso lampeggiante DELTA MODE / DELTA MOLLA in testata (con disattivazione rapida e auto-off 30s)
slider39 >= 0.5 ? (
  dp_hv = hit(586, 18, 212, 24);
  dp_hv ? ( active_info_id = 223; );
  dp_hv && mouse_click ? (
    set_param_slider(39, 0);
  ) : (
    (mouse_down || ui_drag_id > 0) ? ( delta_arm_time = time_now; );
    delta_rem = max(1, floor(30.9 - (time_now - delta_arm_time)));
    delta_blink ? ( gfx_r = 0.96; gfx_g = 0.20; gfx_b = 0.44; ) : ( gfx_r = 1.0; gfx_g = 0.62; gfx_b = 0.14; );
    gfx_a = 0.96; g_rect(586, 18, 212, 24);
    gfx_r = 1.0; gfx_g = 0.90; gfx_b = 0.65; gfx_a = dp_hv ? 1.0 : 0.75; g_frame(586, 18, 212, 24);
    gfx_setfont(6); gfx_r = 0.04; gfx_g = 0.05; gfx_b = 0.07; gfx_a = 1;
    sprintf(#dpill, "DELTA MODE (%ds)  [OFF]", delta_rem);
    g_txtc(692, 18 + (24 - g_th()) * 0.5, #dpill);
  );
) : delta_spring_stage > 0 ? (
  stg_nm = delta_spring_stage == 1 ? "FILTERS" :
           delta_spring_stage == 2 ? "PREAMP" :
           delta_spring_stage == 3 ? "PEAK" :
           delta_spring_stage == 4 ? "DRC A" :
           delta_spring_stage == 5 ? "DRC B" :
           delta_spring_stage == 6 ? "DRC C" :
           delta_spring_stage == 7 ? "DRC D" :
           delta_spring_stage == 8 ? "DYN EQ" :
           delta_spring_stage == 9 ? "TONE" :
           delta_spring_stage == 10 ? "DYN BAL" :
           delta_spring_stage == 12 ? "LIMITER" : "GLOBAL";
  delta_blink ? ( gfx_r = 1.0; gfx_g = 0.58; gfx_b = 0.12; ) : ( gfx_r = 0.94; gfx_g = 0.24; gfx_b = 0.50; );
  gfx_a = 0.96; g_rect(586, 18, 212, 24);
  gfx_r = 1.0; gfx_g = 0.90; gfx_b = 0.65; gfx_a = 0.9; g_frame(586, 18, 212, 24);
  gfx_setfont(6); gfx_r = 0.04; gfx_g = 0.05; gfx_b = 0.07; gfx_a = 1;
  sprintf(#dpill, "DELTA: %s", stg_nm);
  g_txtc(692, 18 + (24 - g_th()) * 0.5, #dpill);
) : delta_spring_armed ? (
  dp_hv = hit(586, 18, 212, 24);
  dp_hv ? ( active_info_id = 224; );
  dp_hv && mouse_click ? (
    delta_spring_armed = 0; delta_spring_stage = 0; ui_hold_delta_stage = 0;
  ) : (
    sp_rem = max(1, floor(30.9 - (time_now - delta_spring_time)));
    gfx_r = show_simple ? 0.98 : 0.22; gfx_g = show_simple ? 0.90 : 0.14; gfx_b = show_simple ? 0.78 : 0.16; gfx_a = 0.96;
    g_rect(586, 18, 212, 24);
    gfx_r = dp_hv ? 1.0 : 0.95; gfx_g = 0.58; gfx_b = 0.18; gfx_a = 0.95; g_frame(586, 18, 212, 24);
    gfx_setfont(6);
    show_simple ? ( gfx_r = 0.30; gfx_g = 0.12; gfx_b = 0.06; ) : ( gfx_r = 1.0; gfx_g = 0.84; gfx_b = 0.42; );
    gfx_a = 1;
    sprintf(#dpill, msg("DELTA MOLLA (%ds)  [X]", "SPRING DELTA (%ds) [X]"), sp_rem);
    g_txtc(692, 18 + (24 - g_th()) * 0.5, #dpill);
  );
);

function jsfx_param_meta(idx) (
  p_min = 0; p_max = 1; p_def = 0; p_ro = 0; strcpy(#p_unit, "");
  idx == 1  ? ( strcpy(#p_nm, "1. Input Level");            p_min=-12;  p_max=12;    p_def=0;     strcpy(#p_unit, "dB"); ) :
  idx == 2  ? ( strcpy(#p_nm, "2. Lowcut Freq");            p_min=20;   p_max=250;   p_def=75;    strcpy(#p_unit, "Hz"); ) :
  idx == 3  ? ( strcpy(#p_nm, "3. Hicut Freq");             p_min=8000; p_max=20000; p_def=18000; strcpy(#p_unit, "Hz"); ) :
  idx == 4  ? ( strcpy(#p_nm, "4. Filter Engage");          p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 5  ? ( strcpy(#p_nm, "5. Preamp Engage");          p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 6  ? ( strcpy(#p_nm, "6. Peak Reduction");         p_min=0;    p_max=100;   p_def=45;    strcpy(#p_unit, "%"); ) :
  idx == 7  ? ( strcpy(#p_nm, "7. Peak Level Engage");      p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 8  ? ( strcpy(#p_nm, "8. DRC Master Engage");      p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 9  ? ( strcpy(#p_nm, "9. DRC A Engage");           p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 10 ? ( strcpy(#p_nm, "10. DRC A HiPass");          p_min=20;   p_max=20000; p_def=6529;  strcpy(#p_unit, "Hz"); ) :
  idx == 11 ? ( strcpy(#p_nm, "11. DRC A LowPass");         p_min=20;   p_max=20000; p_def=9788;  strcpy(#p_unit, "Hz"); ) :
  idx == 12 ? ( strcpy(#p_nm, "12. DRC A Threshold");       p_min=0;    p_max=100;   p_def=75.9;  strcpy(#p_unit, "%"); ) :
  idx == 13 ? ( strcpy(#p_nm, "13. DRC B Engage");          p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 14 ? ( strcpy(#p_nm, "14. DRC B HiPass");          p_min=20;   p_max=20000; p_def=233;   strcpy(#p_unit, "Hz"); ) :
  idx == 15 ? ( strcpy(#p_nm, "15. DRC B LowPass");         p_min=20;   p_max=20000; p_def=384;   strcpy(#p_unit, "Hz"); ) :
  idx == 16 ? ( strcpy(#p_nm, "16. DRC B Threshold");       p_min=0;    p_max=100;   p_def=59.7;  strcpy(#p_unit, "%"); ) :
  idx == 17 ? ( strcpy(#p_nm, "17. DRC C Engage");          p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 18 ? ( strcpy(#p_nm, "18. DRC C HiPass");          p_min=20;   p_max=20000; p_def=1456;  strcpy(#p_unit, "Hz"); ) :
  idx == 19 ? ( strcpy(#p_nm, "19. DRC C LowPass");         p_min=20;   p_max=20000; p_def=2641;  strcpy(#p_unit, "Hz"); ) :
  idx == 20 ? ( strcpy(#p_nm, "20. DRC C Threshold");       p_min=0;    p_max=100;   p_def=50.0;  strcpy(#p_unit, "%"); ) :
  idx == 21 ? ( strcpy(#p_nm, "21. DRC D Engage");          p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 22 ? ( strcpy(#p_nm, "22. DRC D HiPass");          p_min=20;   p_max=20000; p_def=5884;  strcpy(#p_unit, "Hz"); ) :
  idx == 23 ? ( strcpy(#p_nm, "23. DRC D LowPass");         p_min=20;   p_max=20000; p_def=9200;  strcpy(#p_unit, "Hz"); ) :
  idx == 24 ? ( strcpy(#p_nm, "24. DRC D Threshold");       p_min=0;    p_max=100;   p_def=0.0;   strcpy(#p_unit, "%"); ) :
  idx == 25 ? ( strcpy(#p_nm, "25. DRC Band Solo (Molla)"); p_min=0;    p_max=4;     p_def=0;     strcpy(#p_unit, "int"); ) :
  idx == 26 ? ( strcpy(#p_nm, "26. Dynamic EQ Engage");     p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 27 ? ( strcpy(#p_nm, "27. Dynamic EQ Curve (A-D)");p_min=0;    p_max=3;     p_def=2;     strcpy(#p_unit, "abcd"); ) :
  idx == 28 ? ( strcpy(#p_nm, "28. Dynamic EQ Threshold");  p_min=0;    p_max=100;   p_def=52.1;  strcpy(#p_unit, "%"); ) :
  idx == 29 ? ( strcpy(#p_nm, "29. Tone EQ Engage");        p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 30 ? ( strcpy(#p_nm, "30. Tone EQ Curve (A-D)");   p_min=0;    p_max=3;     p_def=3;     strcpy(#p_unit, "abcd"); ) :
  idx == 31 ? ( strcpy(#p_nm, "31. Tone EQ Gain Scale");    p_min=0.2;  p_max=3.5;   p_def=1.56;  strcpy(#p_unit, "x"); ) :
  idx == 32 ? ( strcpy(#p_nm, "32. Mid Bump Engage");       p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 33 ? ( strcpy(#p_nm, "33. Dynamic Balance Engage");p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 34 ? ( strcpy(#p_nm, "34. Dynamic Balance Mode");  p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "ab"); ) :
  idx == 35 ? ( strcpy(#p_nm, "35. Dynamic Balance Amount");p_min=0;    p_max=100;   p_def=31.1;  strcpy(#p_unit, "%"); ) :
  idx == 36 ? ( strcpy(#p_nm, "36. Parallel Mix Wet");      p_min=0;    p_max=100;   p_def=100;   strcpy(#p_unit, "%"); ) :
  idx == 37 ? ( strcpy(#p_nm, "37. Output Gain");           p_min=-12;  p_max=12;    p_def=0;     strcpy(#p_unit, "dB"); ) :
  idx == 38 ? ( strcpy(#p_nm, "38. Auto Gain Match");       p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 39 ? ( strcpy(#p_nm, "39. Delta (Solo Intervento)");p_min=0;   p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
  idx == 40 ? ( strcpy(#p_nm, "40. Sample Peak Limiter");   p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "bool"); ) :
  idx == 41 ? ( strcpy(#p_nm, "41. Sample Peak Ceiling");   p_min=-3.0; p_max=-0.1;  p_def=-0.5;  strcpy(#p_unit, "dBFS"); ) :
  idx == 42 ? ( strcpy(#p_nm, "42. UI Theme (Light/Dark)");  p_min=0;    p_max=1;     p_def=1;     strcpy(#p_unit, "int"); ) :
  idx == 43 ? ( strcpy(#p_nm, "43. View Mode (Full/Mini/JSFX)"); p_min=0; p_max=2;   p_def=0;     strcpy(#p_unit, "int"); ) :
  idx == 44 ? ( strcpy(#p_nm, "44. Preset Voce [OSARA]");   p_min=0;    p_max=7;     p_def=0;     strcpy(#p_unit, "int"); ) :
  idx == 45 ? ( strcpy(#p_nm, "45. [Read] Peak Leveler GR");p_min=0;    p_max=24;    p_def=0;     p_ro=1; strcpy(#p_unit, "dB"); ) :
  idx == 46 ? ( strcpy(#p_nm, "46. [Read] DRC Max Band GR");p_min=0;    p_max=24;    p_def=0;     p_ro=1; strcpy(#p_unit, "dB"); ) :
  idx == 47 ? ( strcpy(#p_nm, "47. [Read] DynEQ+DynBal Act");p_min=0;   p_max=100;   p_def=0;     p_ro=1; strcpy(#p_unit, "%"); ) :
  idx == 48 ? ( strcpy(#p_nm, "48. [Read] RMS In");         p_min=-60;  p_max=6;     p_def=-60;   p_ro=1; strcpy(#p_unit, "dBFS"); ) :
  idx == 49 ? ( strcpy(#p_nm, "49. [Read] RMS Out");        p_min=-60;  p_max=6;     p_def=-60;   p_ro=1; strcpy(#p_unit, "dBFS"); ) :
  idx == 50 ? ( strcpy(#p_nm, "50. [Read] Peak Limiter GR");p_min=0;    p_max=18;    p_def=0;     p_ro=1; strcpy(#p_unit, "dB"); ) :
  idx == 51 ? ( strcpy(#p_nm, "51. Barra Suggerimenti");    p_min=0;    p_max=1;     p_def=0;     strcpy(#p_unit, "bool"); ) :
              ( strcpy(#p_nm, "52. Monitor Modulo");        p_min=0;    p_max=6;     p_def=2;     strcpy(#p_unit, "int"); );
);

view_mode == 2 ? (
  j_y = 132; j_h = max(360, bars_top_d - 10 - j_y);
  draw_panel(16, j_y, 1068, j_h);
  draw_group_title(16, j_y, 1068, "JSFX VIEW · LISTA PARAMETRI SCORREVOLE (USA ROTELLA O BARRA A DESTRA · FULL/MINI IN ALTO PER USCIRE)", c_grn_r, c_grn_g, c_grn_b, -1);

  row_h = 28;
  vis_rows = max(8, floor((j_h - 46) / row_h));
  max_scroll = max(0, 52 - vis_rows);
  mouse_wheel != 0 ? (
    jsfx_scroll = clamp(jsfx_scroll - sign(mouse_wheel) * 3, 0, max_scroll);
    mouse_wheel = 0;
  );
  jsfx_scroll = clamp(jsfx_scroll, 0, max_scroll);

  // Scrollbar verticale a destra
  sb_x = 1060; sb_y = j_y + 38; sb_w = 14; sb_h = j_h - 48;
  gfx_r = 0.06; gfx_g = 0.08; gfx_b = 0.12; gfx_a = 1; g_rect(sb_x, sb_y, sb_w, sb_h);
  thumb_h = max(28, sb_h * vis_rows / 52);
  thumb_y = sb_y + (max_scroll > 0 ? (jsfx_scroll / max_scroll) * (sb_h - thumb_h) : 0);
  sb_hov = hit(sb_x - 4, sb_y, sb_w + 8, sb_h);
  sb_hov && mouse_click ? ui_drag_id = 999;
  ui_drag_id == 999 && mouse_down ? (
    jsfx_scroll = floor(clamp((myd - sb_y - thumb_h * 0.5) / max(1, sb_h - thumb_h), 0, 1) * max_scroll + 0.5);
  ) : ( ui_drag_id == 999 && !mouse_down ? ui_drag_id = 0; );
  gfx_r = c_grn_r; gfx_g = c_grn_g; gfx_b = c_grn_b; gfx_a = (sb_hov || ui_drag_id == 999) ? 0.95 : 0.7;
  g_rect(sb_x + 2, thumb_y, sb_w - 4, thumb_h);

  ri = 0;
  loop(vis_rows,
    p_idx = floor(jsfx_scroll + 0.5) + ri + 1;
    p_idx <= 52 ? (
      jsfx_param_meta(p_idx);
      ry = j_y + 38 + ri * row_h;
      ri % 2 == 0 ? ( gfx_r = panel2_r; gfx_g = panel2_g; gfx_b = panel2_b; gfx_a = 0.45; g_rect(26, ry, 1026, row_h - 2); );
      gfx_setfont(5); set_text_col();
      g_txt(36, ry + 5, #p_nm);

      // Barra slider interattiva
      bx0 = 370; bw0 = 490; by0 = ry + 6; bh0 = row_h - 14;
      pval = slider(p_idx);
      pnorm = clamp((pval - p_min) / max(0.0001, p_max - p_min), 0, 1);
      gfx_r = 0.06; gfx_g = 0.08; gfx_b = 0.12; gfx_a = 1; g_rect(bx0, by0, bw0, bh0);
      gfx_r = p_ro ? c_mag_r : c_cyan_r; gfx_g = p_ro ? c_mag_g : c_cyan_g; gfx_b = p_ro ? c_mag_b : c_cyan_b;
      gfx_a = p_ro ? 0.65 : 0.85;
      g_rect(bx0, by0, max(2, pnorm * bw0), bh0);
      gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.7; g_frame(bx0, by0, bw0, bh0);

      r_hov = !p_ro && hit(bx0, ry, bw0, row_h);
      r_hov && mouse_click ? (
        strcmp(#p_unit, "bool") == 0 ? (
          set_param_slider(p_idx, pval >= 0.5 ? 0 : 1);
          update_dsp_params();
        ) : (
          ui_drag_id = 500 + p_idx;
        );
      );
      r_hov && mouse_right_click ? ( set_param_slider(p_idx, p_def); update_dsp_params(); );
      ui_drag_id == (500 + p_idx) && mouse_down ? (
        nn = clamp((mxd - bx0) / bw0, 0, 1);
        nv = p_min + nn * (p_max - p_min);
        (strcmp(#p_unit, "int") == 0 || strcmp(#p_unit, "abcd") == 0 || strcmp(#p_unit, "ab") == 0 || strcmp(#p_unit, "Hz") == 0) ? nv = floor(nv + 0.5);
        p_idx == 43 ? set_ui_state(43, nv) : set_param_slider(p_idx, nv);
        update_dsp_params();
      ) : ( ui_drag_id == (500 + p_idx) && !mouse_down ? ui_drag_id = 0; );

      // Valore formattato a destra
      strcmp(#p_unit, "bool") == 0 ? strcpy(#pv_s, pval >= 0.5 ? "ON" : "OFF") :
      strcmp(#p_unit, "abcd") == 0 ? ( c_i = floor(pval + 0.5); strcpy(#pv_s, c_i == 0 ? "Curva A" : c_i == 1 ? "Curva B" : c_i == 2 ? "Curva C" : "Curva D"); ) :
      strcmp(#p_unit, "ab") == 0   ? ( c_i = floor(pval + 0.5); strcpy(#pv_s, c_i == 0 ? "A · Natural" : "B · Dense"); ) :
      strcmp(#p_unit, "int") == 0  ? sprintf(#pv_s, "%.0f", pval) :
      strcmp(#p_unit, "Hz") == 0   ? sprintf(#pv_s, "%.0f Hz", pval) :
                                     sprintf(#pv_s, "%.2f %s", pval, #p_unit);
      set_text_col(); g_txtr(1042, ry + 5, #pv_s);
    );
    ri += 1;
  );
);

// ============================================================================
// MONITOR (FULL e MINI)
// ============================================================================
view_mode != 2 ? (
  mon_y = view_mode == 0 ? 504 : 132;
  mon_h = max(242, bars_top_d - 10 - mon_y);
  draw_panel(16, mon_y, 1068, mon_h);
  mon_name = mon_sel == 0 ? "FILTER STAGE" : mon_sel == 1 ? "PEAK LEVELER (OPTO + RCOMP)" : mon_sel == 2 ? "DRC" :
             mon_sel == 3 ? "DYNAMIC EQ" : mon_sel == 4 ? "TONE EQ + MID BUMP" : mon_sel == 5 ? "DYNAMIC BALANCE" : "OUTPUT";
  sprintf(#mt, "MONITOR · %s", mon_name);
  draw_group_title(16, mon_y, 1068, #mt, c_cyan_r, c_cyan_g, c_cyan_b, -1);

  tx = 30; ty = mon_y + 34;
  ui_tab_btn(52, 0, tx,       ty, 84, 24, "FILTER",  230, c_cyan_r,  c_cyan_g,  c_cyan_b, -1);
  ui_tab_btn(52, 1, tx + 90,  ty, 84, 24, "PEAK",    230, c_amber_r, c_amber_g, c_amber_b, -1);
  ui_tab_btn(52, 2, tx + 180, ty, 84, 24, "DRC",     233, c_mag_r,   c_mag_g,   c_mag_b, -1);
  ui_tab_btn(52, 3, tx + 270, ty, 84, 24, "DYN EQ",  230, c_cyan_r,  c_cyan_g,  c_cyan_b, -1);
  ui_tab_btn(52, 4, tx + 360, ty, 84, 24, "TONE",    230, c_amber_r, c_amber_g, c_amber_b, -1);
  ui_tab_btn(52, 5, tx + 450, ty, 84, 24, "DYN BAL", 230, c_grn_r,   c_grn_g,   c_grn_b, -1);
  ui_tab_btn(52, 6, tx + 540, ty, 84, 24, "OUTPUT",  230, c_grn_r,   c_grn_g,   c_grn_b, -1);

  d_x = 30; d_y = mon_y + 66; d_w = 700; d_h = mon_h - 76; fy = d_h / 166;

  mon_sel == 0 ? (
    // ---- FILTER: curva reale HPF*LPF ----
    mon_frame(c_cyan_r, c_cyan_g, c_cyan_b);
    draw_freq_grid();
    draw_db_line(0, -24, 6, "0"); draw_db_line(-12, -24, 6, "-12"); draw_db_line(-24, -24, 6, "-24");
    draw_curve(0, -24, 6, c_cyan_r + 0.2, c_cyan_g + 0.1, 1);
    gfx_setfont(6); gfx_r = 0.62; gfx_g = 0.82; gfx_b = 1; gfx_a = 1;
    fmt_freq(#fa, slider2); fmt_freq(#fb, slider3);
    sprintf(#ft, "LOW CUT %s Hz", #fa); g_txt(d_x + 40, d_y + 8, #ft);
    gfx_r = slider4 >= 0.5 ? 0.45 : 1; gfx_g = slider4 >= 0.5 ? 0.85 : 0.5; gfx_b = slider4 >= 0.5 ? 1 : 0.4;
    g_txtc(d_x + d_w * 0.5, d_y + 8, slider4 >= 0.5 ? "FILTERS ENGAGED" : "FILTERS BYPASSED");
    gfx_r = 0.62; gfx_g = 0.82; gfx_b = 1;
    sprintf(#ft, "HIGH CUT %s Hz", #fb); g_txtr(d_x + d_w - 20, d_y + 8, #ft);
  ) : mon_sel == 1 ? (
    // ---- PEAK: riduzioni Opto / RComp ----
    mon_frame(c_amber_r, c_amber_g, c_amber_b);
    gfx_setfont(6); gfx_r = 1; gfx_g = 0.82; gfx_b = 0.5; gfx_a = 1;
    sprintf(#pt, "SOGLIA %.1f dBFS   ·   PEAK RED %.0f%%   ·   %s", ui_pk_thr_db, slider6, slider7 >= 0.5 ? "ENGAGED" : "BYPASSED");
    g_txt(d_x + 18, d_y + 10 * fy, #pt);
    hbar_lvl(d_y + 38 * fy, "LIVELLO", max(-60, ui_pk_lvl_db), -48, 0, 0.45, 0.6, 1.0, ui_pk_thr_db);
    hbar_gr(d_y + 66 * fy, "OPTO", ui_gr_opt, 12, 0.55, 0.35, 0.95);
    hbar_gr(d_y + 92 * fy, "RCOMP", ui_gr_rc, 12, 0.90, 0.25, 0.45);
    hbar_gr(d_y + 118 * fy, "TOTALE", ui_peak_gr_db, 12, c_amber_r, c_amber_g, c_amber_b);
    gr_scale(d_y + 142 * fy, 12);
  ) : mon_sel == 2 ? (
    // ---- DRC: curve a campana SVF reali sullo spettro (0..-12 dB) ----
    mon_frame(c_mag_r, c_mag_g, c_mag_b);
    draw_freq_grid();
    draw_db_line(0, -12, 0, "0"); draw_db_line(-3, -12, 0, "-3"); draw_db_line(-6, -12, 0, "-6");
    draw_db_line(-9, -12, 0, "-9"); draw_db_line(-12, -12, 0, "-12");
    drc_on = slider8 >= 0.5;
    sprintf(#rA, "A·%s", band_role(slider10, slider11));
    sprintf(#rB, "B·%s", band_role(slider14, slider15));
    sprintf(#rC, "C·%s", band_role(slider18, slider19));
    sprintf(#rD, "D·%s", band_role(slider22, slider23));
    band_gr(slider10, slider11, ui_drcA, 12, drc_on && slider9 >= 0.5,  #rA, 0, c_cyan_r,  c_cyan_g,  c_cyan_b);
    band_gr(slider14, slider15, ui_drcB, 12, drc_on && slider13 >= 0.5, #rB, 1, c_amber_r, c_amber_g, c_amber_b);
    band_gr(slider18, slider19, ui_drcC, 12, drc_on && slider17 >= 0.5, #rC, 2, c_mag_r,   c_mag_g,   c_mag_b);
    band_gr(slider22, slider23, ui_drcD, 12, drc_on && slider21 >= 0.5, #rD, 3, c_grn_r,   c_grn_g,   c_grn_b);

    // Curva somma complessiva quando 2+ bande stanno attenuando insieme
    drc_on ? (
      drc_act_cnt = ((slider9 >= 0.5 && ui_drcA > 0.1) ? 1 : 0) + ((slider13 >= 0.5 && ui_drcB > 0.1) ? 1 : 0)
                  + ((slider17 >= 0.5 && ui_drcC > 0.1) ? 1 : 0) + ((slider21 >= 0.5 && ui_drcD > 0.1) ? 1 : 0);
      drc_act_cnt >= 2 ? (
        drc_srm = max(22050, srate);
        d_px = -1; d_i = 0;
        loop(141,
          d_f = 20 * 10 ^ (3 * d_i / 140);
          d_f < drc_srm * 0.48 ? (
            d_tot = 0;
            slider9  >= 0.5 && ui_drcA > 0.1 ? ( d_tot += drc_band_mag_db(d_f, min(sqrt(min(slider10,slider11)*max(slider10,slider11)), drc_srm*0.44), clamp(min(sqrt(min(slider10,slider11)*max(slider10,slider11)), drc_srm*0.44)/max(20,abs(slider11-slider10)),0.5,12.0), 1.0 - db2lin(-clamp(ui_drcA,0,12)), drc_srm); );
            slider13 >= 0.5 && ui_drcB > 0.1 ? ( d_tot += drc_band_mag_db(d_f, min(sqrt(min(slider14,slider15)*max(slider14,slider15)), drc_srm*0.44), clamp(min(sqrt(min(slider14,slider15)*max(slider14,slider15)), drc_srm*0.44)/max(20,abs(slider15-slider14)),0.5,12.0), 1.0 - db2lin(-clamp(ui_drcB,0,12)), drc_srm); );
            slider17 >= 0.5 && ui_drcC > 0.1 ? ( d_tot += drc_band_mag_db(d_f, min(sqrt(min(slider18,slider19)*max(slider18,slider19)), drc_srm*0.44), clamp(min(sqrt(min(slider18,slider19)*max(slider18,slider19)), drc_srm*0.44)/max(20,abs(slider19-slider18)),0.5,12.0), 1.0 - db2lin(-clamp(ui_drcC,0,12)), drc_srm); );
            slider21 >= 0.5 && ui_drcD > 0.1 ? ( d_tot += drc_band_mag_db(d_f, min(sqrt(min(slider22,slider23)*max(slider22,slider23)), drc_srm*0.44), clamp(min(sqrt(min(slider22,slider23)*max(slider22,slider23)), drc_srm*0.44)/max(20,abs(slider23-slider22)),0.5,12.0), 1.0 - db2lin(-clamp(ui_drcD,0,12)), drc_srm); );
            d_x1 = fx_map(d_f); d_y1 = dbv_map(d_tot, -12, 0);
            d_px >= 0 ? ( gfx_r = 0.94; gfx_g = 0.97; gfx_b = 1.0; gfx_a = 0.85; g_line(d_px, d_py, d_x1, d_y1); );
            d_px = d_x1; d_py = d_y1;
          );
          d_i += 1;
        );
      );
    );

    gfx_setfont(7);
    drc_solo_audition_band > 0 ? (
      gfx_r = 1.0; gfx_g = 0.76; gfx_b = 0.22; gfx_a = 1;
      sprintf(#mwrn, "PREASCOLTO ATTIVO BANDA %s (rilascia il mouse per tornare alla voce intera)",
              drc_solo_audition_band == 1 ? "A" : drc_solo_audition_band == 2 ? "B" : drc_solo_audition_band == 3 ? "C" : "D");
      g_txt(d_x + 40, d_y + 7, #mwrn);
    ) : (
      gfx_r = 0.62; gfx_g = 0.70; gfx_b = 0.9; gfx_a = 0.9;
      g_txt(d_x + 40, d_y + 7, msg("campana SVF reale (0..-12 dB)  ·  SOLO a molla: suona mentre tocchi THR / FREQ / OCT", "real SVF bell (0..-12 dB)  ·  Spring SOLO: auditions while touching THR / FREQ / OCT"));
    );
  ) : mon_sel == 3 ? (
    // ---- DYNAMIC EQ (Curva reale 5-Band SVF centrata & zoomabile: ±5 / ±12 dB) ----
    mon_frame(c_cyan_r, c_cyan_g, c_cyan_b);
    draw_freq_grid();
    deq_on = slider26 >= 0.5 && slider28 > 0.1;
    deq_z_hv = hit(d_x + d_w - 76, d_y + 4, 68, 16);
    deq_z_hv ? ( active_info_id = 234; );
    deq_z_hv && mouse_click ? ( deq_mon_zoom = !deq_mon_zoom; );
    deq_rng = deq_mon_zoom ? 12.0 : 5.0;
    deq_top = d_y + 42;
    deq_bot = d_y + d_h - 26;
    deq_mid = (deq_top + deq_bot) * 0.5;
    deq_half = (deq_bot - deq_top) * 0.5;
    // Confini delle 5 bande + riferimento lift a riposo
    gi = 0;
    loop(4,
      bfz = gi == 0 ? 105 : gi == 1 ? 460 : gi == 2 ? 1450 : 5600;
      gfx_r = c_cyan_r; gfx_g = c_cyan_g; gfx_b = c_cyan_b; gfx_a = 0.16;
      g_line(fx_map(bfz), deq_top, fx_map(bfz), deq_bot);
      gi += 1;
    );
    deq_on && deq_lift0 > 0.1 ? (
      gy_l0 = deq_mid - (clamp(deq_lift0, -deq_rng, deq_rng) / deq_rng) * deq_half;
      gfx_r = c_grn_r; gfx_g = c_grn_g; gfx_b = c_grn_b; gfx_a = 0.28;
      g_line(d_x + 34, gy_l0, d_x + d_w - 18, gy_l0);
    );
    gi = 0;
    loop(5,
      ldb = deq_mon_zoom ? (12 - gi * 6) : (4 - gi * 2);
      gy = deq_mid - (ldb / deq_rng) * deq_half;
      gfx_r = 0.55; gfx_g = 0.62; gfx_b = 0.85; gfx_a = ldb == 0 ? 0.65 : 0.22;
      g_line(d_x + 34, gy, d_x + d_w - 18, gy);
      gfx_setfont(7); gfx_a = ldb == 0 ? 0.95 : 0.80;
      ldb > 0 ? sprintf(#dgl, "+%d", ldb) : sprintf(#dgl, "%d", ldb);
      g_txtr(d_x + 30, gy - 6, #dgl);
      gi += 1;
    );
    // Curva complessa reale 5-Band SVF
    deq_srm = max(22050, srate);
    dg_0 = deq_on ? db2lin(ui_deq0) : 1.0;
    dg_1 = deq_on ? db2lin(ui_deq1) : 1.0;
    dg_2 = deq_on ? db2lin(ui_deq2) : 1.0;
    dg_3 = deq_on ? db2lin(ui_deq3) : 1.0;
    dg_4 = deq_on ? db2lin(ui_deq4) : 1.0;
    deq_px = -1; deq_i = 0;
    loop(161,
      deq_f = 20 * 10 ^ (3 * deq_i / 160);
      deq_f < deq_srm * 0.48 ? (
        deq_db = deq_mag_db(deq_f, dg_0, dg_1, dg_2, dg_3, dg_4, deq_srm);
        deq_xc = fx_map(deq_f);
        deq_yc = deq_mid - (clamp(deq_db, -deq_rng, deq_rng) / deq_rng) * deq_half;
        deq_px >= 0 ? (
          gfx_r = deq_db >= 0 ? c_grn_r : c_cyan_r;
          gfx_g = deq_db >= 0 ? c_grn_g : c_cyan_g;
          gfx_b = deq_db >= 0 ? c_grn_b : c_cyan_b;
          gfx_a = deq_on ? 0.30 : 0.08;
          g_line(deq_px, deq_py, deq_px, deq_mid);
          abs(deq_db) > deq_rng ? ( gfx_r = c_amber_r; gfx_g = c_amber_g; gfx_b = c_amber_b; );
          gfx_a = deq_on ? 0.98 : 0.42;
          g_line(deq_px, deq_py, deq_xc, deq_yc);
          g_line(deq_px, deq_py + 1 / sc, deq_xc, deq_yc + 1 / sc);
        );
        deq_px = deq_xc; deq_py = deq_yc;
      );
      deq_i += 1;
    );
    bi = 0;
    loop(5,
      bfa = bi == 0 ? 20  : bi == 1 ? 105 : bi == 2 ? 460  : bi == 3 ? 1450 : 5600;
      bfb = bi == 0 ? 105 : bi == 1 ? 460 : bi == 2 ? 1450 : bi == 3 ? 5600 : 20000;
      bgv = bi == 0 ? ui_deq0 : bi == 1 ? ui_deq1 : bi == 2 ? ui_deq2 : bi == 3 ? ui_deq3 : ui_deq4;
      b_nm = bi == 0 ? "SUB" : bi == 1 ? "BODY" : bi == 2 ? "PIVOT" : bi == 3 ? "BITE" : "AIR";
      bxa = fx_map(bfa) + 2; bxb = fx_map(bfb) - 2;
      gfx_setfont(7);
      gfx_r = bgv >= 0 ? c_grn_r : c_cyan_r;
      gfx_g = bgv >= 0 ? c_grn_g : c_cyan_g;
      gfx_b = bgv >= 0 ? c_grn_b : c_cyan_b;
      gfx_a = deq_on ? 0.98 : 0.45;
      sprintf(#dbl, "%s %+.1f", b_nm, bgv);
      g_txtc((bxa + bxb) * 0.5, d_y + 23, #dbl);
      bi += 1;
    );
    dq = floor(slider27 + 0.5);
    sprintf(#dt, "CURVA %s (SVF 5-Band Reale)  ·  THR %.1f%%  ·  verde = lift, azzurro = taglio", dq == 0 ? "A" : dq == 1 ? "B" : dq == 2 ? "C" : "D", slider28);
    gfx_setfont(7); gfx_r = 0.62; gfx_g = 0.70; gfx_b = 0.9; gfx_a = 0.95; g_txt(d_x + 40, d_y + 7, #dt);
    btn_face(d_x + d_w - 76, d_y + 4, 68, 16, deq_mon_zoom ? "±12 dB" : "±5 dB", 0, deq_z_hv, c_cyan_r, c_cyan_g, c_cyan_b);
  ) : mon_sel == 4 ? (
    // ---- TONE EQ: curva reale ----
    mon_frame(c_amber_r, c_amber_g, c_amber_b);
    draw_freq_grid();
    draw_db_line(12, -12, 12, "+12"); draw_db_line(6, -12, 12, "+6"); draw_db_line(0, -12, 12, "0");
    draw_db_line(-6, -12, 12, "-6"); draw_db_line(-12, -12, 12, "-12");
    draw_curve(1, -12, 12, 1, 0.70, 0.25);
    tq = floor(slider30 + 0.5);
    sprintf(#tt, "TONE %s  ·  SCALE %.2fx  ·  MID BUMP %s", tq == 0 ? "A" : tq == 1 ? "B" : tq == 2 ? "C" : "D", slider31, slider32 >= 0.5 ? "ON" : "OFF");
    gfx_setfont(6); gfx_r = 1; gfx_g = 0.82; gfx_b = 0.5; gfx_a = slider29 >= 0.5 ? 1 : 0.5; g_txt(d_x + 40, d_y + 8, #tt);
  ) : mon_sel == 5 ? (
    // ---- DYNAMIC BALANCE: curva EQ reale 3-bande (zoomabile ±6 / ±12 dB) + barre energia/target ----
    mon_frame(c_grn_r, c_grn_g, c_grn_b);
    draw_freq_grid();
    dbal_on = slider33 >= 0.5 && slider35 > 0.1;
    dbal_z_hv = hit(d_x + d_w - 76, d_y + 4, 68, 16);
    dbal_z_hv ? ( active_info_id = 235; );
    dbal_z_hv && mouse_click ? ( dbal_mon_zoom = !dbal_mon_zoom; );
    dbal_rng = dbal_mon_zoom ? 12.0 : 6.0;
    dbal_top = d_y + 48;
    dbal_bot = d_y + d_h - 26;
    dbal_mid = (dbal_top + dbal_bot) * 0.5;
    dbal_half = (dbal_bot - dbal_top) * 0.5;
    gfx_r = c_grn_r; gfx_g = c_grn_g; gfx_b = c_grn_b; gfx_a = 0.22;
    g_line(fx_map(280), dbal_top, fx_map(280), dbal_bot);
    g_line(fx_map(2800), dbal_top, fx_map(2800), dbal_bot);
    gi = 0;
    loop(5,
      ldb = dbal_mon_zoom ? (12 - gi * 6) : (6 - gi * 3);
      gy = dbal_mid - (ldb / dbal_rng) * dbal_half;
      gfx_r = 0.55; gfx_g = 0.62; gfx_b = 0.85; gfx_a = ldb == 0 ? 0.65 : 0.22;
      g_line(d_x + 34, gy, d_x + d_w - 18, gy);
      gfx_setfont(7); gfx_a = ldb == 0 ? 0.95 : 0.80;
      ldb > 0 ? sprintf(#dblg, "+%d", ldb) : sprintf(#dblg, "%d", ldb);
      g_txtr(d_x + 30, gy - 6, #dblg);
      gi += 1;
    );
    db_srm = max(22050, srate);
    db_gl = dbal_on ? ui_dbal_glo  : 1.0;
    db_gm = dbal_on ? ui_dbal_gmid : 1.0;
    db_gh = dbal_on ? ui_dbal_ghi  : 1.0;
    db_px = -1; db_i = 0;
    loop(161,
      db_f = 20 * 10 ^ (3 * db_i / 160);
      db_f < db_srm * 0.48 ? (
        db_val = dbal_mag_db(db_f, db_gl, db_gm, db_gh, db_srm);
        db_xc = fx_map(db_f);
        db_yc = dbal_mid - (clamp(db_val, -dbal_rng, dbal_rng) / dbal_rng) * dbal_half;
        db_px >= 0 ? (
          gfx_r = db_val >= 0 ? c_grn_r : c_cyan_r;
          gfx_g = db_val >= 0 ? c_grn_g : c_cyan_g;
          gfx_b = db_val >= 0 ? c_grn_b : c_cyan_b;
          gfx_a = dbal_on ? 0.30 : 0.08;
          g_line(db_px, db_py, db_px, dbal_mid);
          abs(db_val) > dbal_rng ? ( gfx_r = c_amber_r; gfx_g = c_amber_g; gfx_b = c_amber_b; );
          gfx_a = dbal_on ? 0.98 : 0.42;
          g_line(db_px, db_py, db_xc, db_yc);
          g_line(db_px, db_py + 1 / sc, db_xc, db_yc + 1 / sc);
        );
        db_px = db_xc; db_py = db_yc;
      );
      db_i += 1;
    );
    i = 0;
    loop(3,
      fa = i == 0 ? 20 : i == 1 ? 280 : 2800;
      fb = i == 0 ? 280 : i == 1 ? 2800 : 20000;
      shv = i == 0 ? ui_sh_lo : i == 1 ? ui_sh_mid : ui_sh_hi;
      tgv = i == 0 ? t_lo : i == 1 ? t_mid : t_hi;
      gv  = i == 0 ? ui_dbal_glo : i == 1 ? ui_dbal_gmid : ui_dbal_ghi;
      gdb = dbal_on ? lin2db(gv) : 0;
      xa = fx_map(fa) + 6; xb = fx_map(fb) - 6;
      bw3 = xb - xa;
      gfx_setfont(7); gfx_r = 0.88; gfx_g = 0.98; gfx_b = 0.92; gfx_a = 0.95;
      sprintf(#bt, "%s %.0f%%/%.0f%% (%+.1f)", i == 0 ? "LOW" : i == 1 ? "MID" : "HIGH", shv * 100, tgv * 100, gdb);
      g_txtc((xa + xb) * 0.5, d_y + 21, #bt);
      gfx_r = 0.08; gfx_g = 0.14; gfx_b = 0.18; gfx_a = 0.95; g_rect(xa + 4, d_y + 36, bw3 - 8, 4);
      gfx_r = c_grn_r; gfx_g = c_grn_g; gfx_b = c_grn_b; gfx_a = 0.92;
      g_rect(xa + 4, d_y + 36, clamp(shv / 0.7, 0, 1) * (bw3 - 8), 4);
      tx_mk = xa + 4 + clamp(tgv / 0.7, 0, 1) * (bw3 - 8);
      gfx_r = 1; gfx_g = 0.86; gfx_b = 0.30; gfx_a = 1; g_rect(tx_mk - 1, d_y + 34, 2, 8);
      i += 1;
    );
    sprintf(#dt_b, dbal_on ? "DYN BAL %s (Curva Reale)  ·  %.0f%%  ·  verde = boost, azzurro = taglio"
                           : "BYPASSED: solo analisi energia vs target",
            slider34 >= 0.5 ? "B·DENSE" : "A·NATURAL", slider35);
    gfx_setfont(7); gfx_r = 0.62; gfx_g = 0.70; gfx_b = 0.9; gfx_a = 0.95;
    g_txt(d_x + 40, d_y + 7, #dt_b);
    btn_face(d_x + d_w - 76, d_y + 4, 68, 16, dbal_mon_zoom ? "±12 dB" : "±6 dB", 0, dbal_z_hv, c_grn_r, c_grn_g, c_grn_b);
  ) : (
    // ---- OUTPUT ----
    mon_frame(c_grn_r, c_grn_g, c_grn_b);
    hbar_lvl(d_y + 22 * fy, "RMS IN", ui_rms_in_db, -60, 0, c_cyan_r, c_cyan_g, c_cyan_b, -100);
    hbar_lvl(d_y + 48 * fy, "RMS OUT", ui_rms_out_db, -60, 0, c_grn_r, c_grn_g, c_grn_b, -100);
    hbar_lvl(d_y + 74 * fy, "SAMPLE PEAK", max(-60, lin2db(tp_meter_peak)), -36, 0, c_mag_r, c_mag_g, c_mag_b, slider41);
    hbar_lvl(d_y + 100 * fy, "GAIN MATCH", ui_gm_db, -6, 6, c_amber_r, c_amber_g, c_amber_b, 0);
    hbar_gr(d_y + 126 * fy, "LIMITER", ui_tp_gr_db, 12, c_mag_r, c_mag_g, c_mag_b);
  );

  // ---- Telemetria fissa a destra ----
  tl = 748; tm = 846; tw2 = 148; tvr = 1070;
  i = 0;
  loop(6,
    yy = mon_y + 40 + i * max(32, (mon_h - 60) / 6);
    gfx_setfont(5); set_sub_col();
    lbl_t = i == 0 ? "RMS In" : i == 1 ? "RMS Out" : i == 2 ? "Peak GR" : i == 3 ? "DRC max" : i == 4 ? "DynBal" : "Limit GR";
    g_txt(tl, yy - 2, lbl_t);
    i == 0 ? ( pc = clamp((ui_rms_in_db + 60) / 0.66, 0, 100);  sprintf(#tv, "%.1f dB", ui_rms_in_db);  draw_meter_h(tm, yy, tw2, 12, pc, c_cyan_r, c_cyan_g, c_cyan_b); );
    i == 1 ? ( pc = clamp((ui_rms_out_db + 60) / 0.66, 0, 100); sprintf(#tv, "%.1f dB", ui_rms_out_db); draw_meter_h(tm, yy, tw2, 12, pc, c_grn_r, c_grn_g, c_grn_b); );
    i == 2 ? ( fmt_gr(#tv, ui_peak_gr_db); draw_meter_h(tm, yy, tw2, 12, min(100, ui_peak_gr_db * 7), c_amber_r, c_amber_g, c_amber_b); );
    i == 3 ? ( fmt_gr(#tv, ui_drc_gr_db);  draw_meter_h(tm, yy, tw2, 12, min(100, ui_drc_gr_db * 8), c_mag_r, c_mag_g, c_mag_b); );
    i == 4 ? ( sprintf(#tv, "%.0f%%", dbal_act_pct);     draw_meter_h(tm, yy, tw2, 12, dbal_act_pct, c_grn_r, c_grn_g, c_grn_b); );
    i == 5 ? ( fmt_gr(#tv, ui_tp_gr_db);   draw_meter_h(tm, yy, tw2, 12, min(100, ui_tp_gr_db * 10), c_mag_r, c_mag_g, c_mag_b); );
    gfx_setfont(5); set_text_col(); g_txtr(tvr, yy - 2, #tv);
    i += 1;
  );
);

// ============================================================================
// ANALISI -> SUGGERIMENTI (solo lettura della telemetria)
// ============================================================================
function add_sug(s) (
  sug_n == 0 ? strcpy(#sug1, s) : sug_n == 1 ? strcpy(#sug2, s);
  sug_n += 1;
);
function check_drc_hi(eng, gr, fa, fb, letter) (
  eng && gr > 6.0 ? (
    fmt_freq(#sfa, min(fa, fb)); fmt_freq(#sfb, max(fa, fb));
    sprintf(#sgt, msg("DRC %s (%s-%s Hz) toglie %.1f dB: riduci THR %s o restringi la banda.",
                      "DRC %s (%s-%s Hz) removes %.1f dB: lower THR %s or narrow the band."), letter, #sfa, #sfb, gr, letter);
    add_sug(#sgt);
  );
);
function check_drc_idle(eng, gr, thr, letter) (
  eng && thr > 1 && gr < 0.12 ? (
    sprintf(#sgt, msg("DRC %s non interviene: se senti quella risonanza alza THR %s.",
                      "DRC %s is idle: if you hear that resonance raise THR %s."), letter, letter);
    add_sug(#sgt);
  );
);
function compute_suggestions() local(drc_on, aud_on) (
  sug_n = 0; strcpy(#sug1, ""); strcpy(#sug2, "");
  drc_on = slider8 >= 0.5;
  aud_on = (slider39 >= 0.5) || (delta_spring_stage > 0) || (drc_solo_audition_band > 0);
  aud_on ? (
    add_sug(msg("Analisi in pausa durante DELTA / SOLO: rilascia o disattiva per riprendere la misura.",
                "Analysis paused during DELTA / SOLO: release or disable to resume."));
  ) : !sug_ready ? (
    ui_rms_in_db < -52 && sug_blk_n == 0 ? (
      add_sug(msg("In attesa di segnale: l'analisi parte quando arriva la voce.", "Waiting for signal: analysis starts when the voice arrives."));
    ) : (
      sprintf(#sgt, msg("Raccolta blocco analisi (4 s di parlato: %.0f%%)...",
                        "Collecting analysis block (4 s speech: %.0f%%)..."),
              min(99, 100 * sug_blk_n / max(1, sug_blk_target)));
      add_sug(#sgt);
    );
  ) : (
    sug_avg_lim > 1.2 ? ( sprintf(#sgt, msg("Limiter finale attivo (-%.1f dB medi): abbassa OUTPUT o TONE SCL.", "Final limiter active (-%.1f dB avg): lower OUTPUT or TONE SCL."), sug_avg_lim); add_sug(#sgt); );
    sug_avg_in_db < -34 ? ( sprintf(#sgt, msg("Ingresso basso (%.0f dB RMS sul blocco): alza INPUT di circa %.0f dB per far lavorare i detector.", "Low input (%.0f dB RMS on block): raise INPUT by about %.0f dB so detectors can work."), sug_avg_in_db, clamp(-24 - sug_avg_in_db, 1, 12)); add_sug(#sgt); );
    sug_avg_in_db > -11 ? ( sprintf(#sgt, msg("Ingresso caldo (%.0f dB RMS sul blocco): abbassa INPUT di circa %.0f dB.", "Hot input (%.0f dB RMS on block): lower INPUT by about %.0f dB."), sug_avg_in_db, clamp(sug_avg_in_db + 18, 1, 12)); add_sug(#sgt); );
    slider7 >= 0.5 && sug_avg_pk_gr > 8.0 ? ( sprintf(#sgt, msg("Peak Leveler molto spinto (-%.1f dB medi): porta PEAK RED verso 35-45%%.", "Peak Leveler pushed hard (-%.1f dB avg): bring PEAK RED toward 35-45%%."), sug_avg_pk_gr); add_sug(#sgt); );
    check_drc_hi(drc_on && slider9 >= 0.5,  sug_avg_drcA, slider10, slider11, "A");
    check_drc_hi(drc_on && slider13 >= 0.5, sug_avg_drcB, slider14, slider15, "B");
    check_drc_hi(drc_on && slider17 >= 0.5, sug_avg_drcC, slider18, slider19, "C");
    check_drc_hi(drc_on && slider21 >= 0.5, sug_avg_drcD, slider22, slider23, "D");
    sug_avg_lo_mid_db > 0.5 ? add_sug(msg("Molto peso sulle basse (stanza o effetto prossimita'): prova LOWCUT piu' alto o una banda DRC su 200-500 Hz.", "Heavy low end (room or proximity): try a higher LOWCUT or a DRC band on 200-500 Hz."));
    sug_avg_hi_mid_db < -21.0 ? add_sug(msg("Voce scura sul blocco da 4 s: prova TONE A o MID BUMP, oppure alza DYN BAL.", "Dark voice over 4 s block: try TONE A or MID BUMP, or raise DYN BAL."));
    sug_avg_hi_mid_db > -9.5 ? add_sug(msg("Voce brillante/sibilante sul blocco da 4 s: verifica una banda DRC tra 6k e 10k.", "Bright/sibilant voice over 4 s block: check a DRC band between 6k and 10k."));
    slider33 >= 0.5 && sug_avg_dbal > 75 ? add_sug(msg("Dynamic Balance al limite: il microfono e' lontano dalla curva target. Abbassa DYN BAL o cambia A/B.", "Dynamic Balance at its limit: the mic is far from target. Lower DYN BAL or switch A/B."));
    slider7 >= 0.5 && slider6 > 5 && sug_avg_pk_gr < 0.25 ? add_sug(msg("Peak Leveler quasi fermo: alza PEAK RED per livellare le distanze dal microfono.", "Peak Leveler nearly idle: raise PEAK RED to even out mic distance."));
    check_drc_idle(drc_on && slider9 >= 0.5,  sug_avg_drcA, slider12, "A");
    check_drc_idle(drc_on && slider13 >= 0.5, sug_avg_drcB, slider16, "B");
    check_drc_idle(drc_on && slider17 >= 0.5, sug_avg_drcC, slider20, "C");
    check_drc_idle(drc_on && slider21 >= 0.5, sug_avg_drcD, slider24, "D");
    sug_n == 0 ? add_sug(msg("Catena in equilibrio (blocco 4 s): nessun intervento eccessivo rilevato.", "Chain balanced (4 s block): no excessive processing detected."));
  );
);

// ============================================================================
// BARRE IN BASSO: SUGGERIMENTI (opzionale) + GUIDA
// ============================================================================
ana_on ? (
  time_now - sug_t > 0.6 ? ( compute_suggestions(); sug_t = time_now; );
  gfx_r = show_simple ? 0.99 : 0.10; gfx_g = show_simple ? 0.95 : 0.09; gfx_b = show_simple ? 0.86 : 0.05; gfx_a = 1;
  gfx_rect(0, gyp(ana_yd), gfx_w, gyp(AB) + 1);
  gfx_r = c_amber_r; gfx_g = c_amber_g; gfx_b = c_amber_b; gfx_a = 0.9; gfx_rect(0, gyp(ana_yd), gfx_w, max(1, floor(2 * sc)));
  gfx_setfont(6); gfx_r = c_amber_r; gfx_g = c_amber_g; gfx_b = c_amber_b;
  g_txt(30, ana_yd + 9, msg("ANALISI", "ANALYSIS"));
  gfx_setfont(5); set_text_col();
  g_txt(110, ana_yd + 9, "•  "); g_txt(126, ana_yd + 9, #sug1);
  sug_n > 1 ? ( g_txt(110, ana_yd + 31, "•  "); g_txt(126, ana_yd + 31, #sug2); );
);

gfx_r = show_simple ? 0.86 : 0.11; gfx_g = show_simple ? 0.90 : 0.12; gfx_b = show_simple ? 0.95 : 0.15; gfx_a = 1;
gfx_rect(0, gyp(help_yd), gfx_w, gfx_h - gyp(help_yd));
gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_rect(0, gyp(help_yd), gfx_w, 1);

// Pulsante SUGGERIMENTI (in basso a destra)
sbw = 150; sbx = xr_d - sbw - 12; sby = help_yd + 4;
s_hover = mxd >= sbx && mxd <= sbx + sbw && myd >= sby && myd <= sby + 24;
s_hover ? active_info_id = 231;
s_hover && mouse_click_raw ? ( set_ui_state(51, ana_on ? 0 : 1); sug_t = -10; );
btn_face(sbx, sby, sbw, 24, msg("SUGGERIMENTI", "SUGGESTIONS"), ana_on, s_hover, c_amber_r, c_amber_g, c_amber_b);

gfx_setfont(4); set_text_col();
help_s = lab_edit ? msg("Frequenza in Hz: digita il valore. Invio applica, Esc annulla.", "Frequency in Hz: type a value. Enter applies, Esc cancels.") : active_info_id == 101 ? msg("INPUT: drive d'ingresso verso i detector (-12..+12 dB, auto-compensato; doppio clic = 0 dB).", "INPUT: input drive into detectors (-12..+12 dB, auto-compensated; double click = 0 dB).") :
active_info_id == 102 ? msg("PEAK RED: livellatore Opto + RComp, uniforma la distanza dal microfono. L'anello mostra la riduzione.", "PEAK RED: Opto + RComp leveler, evens out mic distance. The ring shows gain reduction.") :
active_info_id == 103 ? msg("LOWCUT: passa-alto 12 dB/oct contro subsoniche, colpi d'aria ed effetto prossimita'.", "LOWCUT: 12 dB/oct high-pass against rumble, plosive air and proximity effect.") :
