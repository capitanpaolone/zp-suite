@init
ext_noinit = 1;
ui_lang = 0;
help_bridge_last_alive_t = -100;

// ---------------- ZP Shared Bus ----------------
ZP_BUS_MAGIC = 905026;
ZP_BUS_VERSION = 220;
ZP_BUS_ID = 35;
ZP_BUS_FRESH_SEC = 12;

function zp_bus_boot() (
  gmem[0] != ZP_BUS_MAGIC || gmem[1] < ZP_BUS_VERSION ? (
    gmem[0] = ZP_BUS_MAGIC;
    gmem[1] = ZP_BUS_VERSION;
    gmem[2] = 1;
  );
);
function zp_bus_read() local(now) (
  zp_bus_boot();
  now = time_precise();
  zp_bus_master_conn = gmem[40] == 905040 ? (now - gmem[41] <= ZP_BUS_FRESH_SEC ? 2 : 1) : 0;
  zp_bus_probe_conn  = gmem[50] == 905050 ? (now - gmem[51] <= ZP_BUS_FRESH_SEC ? 2 : 1) : 0;
);
function zp_bus_refresh(plugin_id) (
  zp_bus_boot();
  gmem[plugin_id] = 905000 + plugin_id;
  gmem[plugin_id + 1] = time_precise();
  gmem[plugin_id + 2] += 1;
);
zp_bus_boot();
zp_bus_read();

// ---- ZP Shared Bus v3 (telemetria multi-istanza a monte -> Master Pro) ----
function zp3_boot() (
  gmem[1000] != 905300 || gmem[1001] < 300 ? (
    gmem[1000] = 905300;
    gmem[1001] = 300;
    gmem[1002] = 64;
    gmem[1003] = 32;
  );
);
function zp3_clear_slot() local(zp3_cb) (
  zp3_slot >= 0 && zp3_slot < 64 ? (
    zp3_cb = 1024 + zp3_slot * 32;
    gmem[zp3_cb + 3] == zp3_prev_key ? (
      gmem[zp3_cb] = 0;
      gmem[zp3_cb + 2] = 0;
    );
  );
  zp3_slot = -1;
  zp3_prev_key = -1;
);
function zp3_claim(zp3_pt) local(zp3_now, zp3_key, zp3_h, zp3_i, zp3_s, zp3_b, zp3_m, zp3_found) (
  zp3_boot();
  zp3_now = time_precise();
  zp3_fx = 0; zp3_hf = 0;
  zp3_tr = get_host_placement(zp3_fx, zp3_hf);
  zp3_key = max(0, zp3_tr + 2) * 1024 + max(0, zp3_fx) * 16 + zp3_pt;
  zp3_prev_key >= 0 && zp3_prev_key != zp3_key ? zp3_clear_slot();
  zp3_found = -1;
  zp3_slot >= 0 && zp3_slot < 64 ? (
    zp3_b = 1024 + zp3_slot * 32;
    gmem[zp3_b] == 905301 && gmem[zp3_b + 3] == zp3_key ? (zp3_found = zp3_slot;);
  );
  zp3_found < 0 ? (
    zp3_i = 0;
    loop(64,
      zp3_found < 0 ? (
        zp3_b = 1024 + zp3_i * 32;
        gmem[zp3_b] == 905301 && gmem[zp3_b + 3] == zp3_key ? (zp3_found = zp3_i;);
      );
      zp3_i += 1;
    );
  );
  zp3_found < 0 ? (
    zp3_h = (max(0, zp3_tr + 2) * 13 + max(0, zp3_fx) * 7 + zp3_pt * 3) % 64;
    zp3_i = 0;
    loop(64,
      zp3_found < 0 ? (
        zp3_s = (zp3_h + zp3_i) % 64;
        zp3_b = 1024 + zp3_s * 32;
        zp3_m = gmem[zp3_b];
        (zp3_m != 905301 || (zp3_now - gmem[zp3_b + 1]) > 2.5) ? (zp3_found = zp3_s;);
      );
      zp3_i += 1;
    );
  );
  zp3_slot = zp3_found;
  zp3_prev_key = zp3_key;
  zp3_slot >= 0 ? (
    zp3_b = 1024 + zp3_slot * 32;
    zp3_seq = max(zp3_seq, floor(gmem[zp3_b + 2] + 0.5));
    zp3_b;
  ) : -1;
);
zp3_prev_key <= 0 ? (zp3_slot = -1; zp3_prev_key = -1;);
zp3_boot();

function db2lin(db) ( 10 ^ (db * 0.05); );
function lin2db(lin) ( 20 * log10(max(lin, 0.0000001)); );
function clamp(v, mn, mx) ( max(mn, min(mx, v)); );

function pre_shape(v) local(u) (
  u = v;
  pre_k2 > 0 ? ( u = u + (pre_k2 * u * u) / (1.0 + 0.8 * abs(u)); );
  u - (pre_k3 * u * u * u) / (1.0 + pre_d3 * u * u);
);

function dbal_sat_shape(v, dr) (
  // Razionale monotona: identica a v - dr*v^3 a livelli normali, mai folding anche oltre +24 dBFS
  v / (1.0 + dr * v * v);
);

function tp_soft_shape(v, thr, ceil_g) local(av, span, ex, sh) (
  av = abs(v);
  av > thr ? (
    span = max(0.0001, ceil_g - thr);
    ex = (av - thr) / span;
    sh = thr + span * (ex / (1.0 + ex));
    v >= 0 ? sh : -sh;
  ) : v;
);

function tp_isp4_chan(x0, x1, x2, x3) local(pk, c0, c1, c2, c3, y1, y2, y3) (
  pk = max(abs(x1), abs(x2));
  c0 = x1;
  c1 = 0.5 * (x2 - x0);
  c2 = x0 - 2.5 * x1 + 2.0 * x2 - 0.5 * x3;
  c3 = 0.5 * (x3 - x0) + 1.5 * (x1 - x2);
  y1 = ((c3 * 0.25 + c2) * 0.25 + c1) * 0.25 + c0;
  y2 = ((c3 * 0.50 + c2) * 0.50 + c1) * 0.50 + c0;
  y3 = ((c3 * 0.75 + c2) * 0.75 + c1) * 0.75 + c0;
  max(pk, max(abs(y1), max(abs(y2), abs(y3))));
);

// ---------------- State ----------------
pre_env = 0; pre_dc_nl_l = 0; pre_dc_nl_r = 0;
pre_os_px_l = pre_os_px_r = pre_os_ym_l = pre_os_ym_r = pre_os_yc_l = pre_os_yc_r = 0;
pre_in_d1_l = pre_in_d1_r = pre_dry_d1_l = pre_dry_d1_r = pre_mdry_d1_l = pre_mdry_d1_r = 0;
pre_active_prev = 0;
db_lo_px_l = db_lo_px_r = db_lo_ym_l = db_lo_ym_r = db_lo_yc_l = db_lo_yc_r = 0;
db_md_px_l = db_md_px_r = db_md_ym_l = db_md_ym_r = db_md_yc_l = db_md_yc_r = 0;
db_hi_px_l = db_hi_px_r = db_in_d1_l = db_in_d1_r = db_dry_d1_l = db_dry_d1_r = db_mdry_d1_l = db_mdry_d1_r = 0;
db_active_prev = 0;
tp_h1_l = tp_h2_l = tp_h3_l = tp_h1_r = tp_h2_r = tp_h3_r = 0;
tp_os_px_l = tp_os_px_r = tp_os_ym_l = tp_os_ym_r = tp_os_yc_l = tp_os_yc_r = 0;
tp_prelim_d1_l = tp_prelim_d1_r = 0;
tp_active_prev = 0;
ui_in_mtr_env = 0; ui_in_mtr_db = -60; ui_peak_led_db = 0;
ins_gain_db = -0.0782; ins_gain_lin = db2lin(ins_gain_db); ins_ap5_en = 1;
pre_gain_db = 0.0; pre_gain_lin = 1.0;
pre_sag_k = 0.065; pre_k2 = 0.0; pre_k3 = 0.0024; pre_d3 = 0.5;
pre_dc_r = exp(-2.0 * $pi * 5.0 / max(22050, srate));
opt_env = 0; rcomp_env = 0;
drcA_env = 0; drcB_env = 0; drcC_env = 0; drcD_env = 0;
drcA_gr_db = 0; drcB_gr_db = 0; drcC_gr_db = 0; drcD_gr_db = 0;
deq_e0 = 0; deq_e1 = 0; deq_e2 = 0; deq_e3 = 0; deq_e4 = 0;
deq_gdb0 = 0; deq_gdb1 = 0; deq_gdb2 = 0; deq_gdb3 = 0; deq_gdb4 = 0;
deq_gr_db = 0;
dbal_low_env = 0.01; dbal_mid_env = 0.01; dbal_hi_env = 0.01;
dbal_act_pct = 0;
g_lo = 1; g_mid = 1; g_hi = 1;
t_lo = 0.38; t_mid = 0.42; t_hi = 0.20;
gm_rms_in = 0.001; gm_rms_out = 0.001; gm_gain = 1.0;
lk_user_move = 0; lk_shq = lk_shd = 0; gp_snap = gq_snap = gt_snap = 0; lk_clamped = 0; lk_prev_t = 0; lk_prev_d = 0; lk_base = 0; lk_written = 0; gt_ref = gd_ref = gt_now = gd_now = 0; // LEGA OUTPUT
lk_Llo = lk_Lmid = lk_Lhi = -20;
lk_prev_q = 0; gq_ref = gq_now = 0; lk_Q0 = lk_Q1 = lk_Q2 = lk_Q3 = lk_Q4 = -20;
