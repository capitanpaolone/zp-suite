// ---------------- Slider helpers (masks via 2^(n-1), valid oltre slider 32) ----------------
function set_param_slider(sl_idx, new_val) local(mask) (
  sl_idx == 37 ? lk_user_move = 1;   // LEGA OUTPUT: mossa vera di OUTPUT dalla GUI o da un preset
  slider(sl_idx) = new_val;
  mask = 2 ^ (sl_idx - 1);
  sliderchange(mask);
  slider_automate(mask);
);
function set_ui_state(sl_idx, new_val) (
  slider(sl_idx) = new_val;
  sliderchange(2 ^ (sl_idx - 1));
);

function update_view_mode_visibility() local(s) (
  // Teniamo sempre nascosta la lista nativa di slider di REAPER (che non ha scrollbar
  // e spingerebbe il canvas @gfx fuori dallo schermo impedendo di cliccare FULL/MINI).
  // La vista JSFX (view_mode == 2) disegna una lista interattiva completa e scorrevole dentro @gfx.
  s = 0;
  slider_show(slider1, s);  slider_show(slider2, s);  slider_show(slider3, s);  slider_show(slider4, s);
  slider_show(slider5, s);  slider_show(slider6, s);  slider_show(slider7, s);  slider_show(slider8, s);
  slider_show(slider9, s);  slider_show(slider10, s); slider_show(slider11, s); slider_show(slider12, s);
  slider_show(slider13, s); slider_show(slider14, s); slider_show(slider15, s); slider_show(slider16, s);
  slider_show(slider17, s); slider_show(slider18, s); slider_show(slider19, s); slider_show(slider20, s);
  slider_show(slider21, s); slider_show(slider22, s); slider_show(slider23, s); slider_show(slider24, s);
  slider_show(slider25, s); slider_show(slider26, s); slider_show(slider27, s); slider_show(slider28, s);
  slider_show(slider29, s); slider_show(slider30, s); slider_show(slider31, s); slider_show(slider32, s);
  slider_show(slider33, s); slider_show(slider34, s); slider_show(slider35, s); slider_show(slider36, s);
  slider_show(slider37, s); slider_show(slider38, s); slider_show(slider39, s); slider_show(slider40, s);
  slider_show(slider41, s);
  slider_show(slider42, s); slider_show(slider43, s); slider_show(slider44, s);
  slider_show(slider45, s); slider_show(slider46, s); slider_show(slider47, s); slider_show(slider48, s);
  slider_show(slider49, s); slider_show(slider50, s);
  slider_show(slider51, s); slider_show(slider52, s);
  slider_show(slider53, s); slider_show(slider54, s); slider_show(slider55, s); slider_show(slider56, s); slider_show(slider57, s); slider_show(slider58, s);
  prev_view_mode = floor(slider43 + 0.5);
);

