active_info_id >= 121 && active_info_id <= 124 ? msg("THR: piu' alto = interviene prima e di piu'. L'anello e la barra mostrano la riduzione reale.", "THR: higher = acts sooner and more. Ring and bar show the actual reduction.") :
active_info_id >= 131 && active_info_id <= 134 ? msg("FREQ: centro della campana DRC (25 Hz - 18 kHz, sposta HP/LP insieme). SHIFT = fine. Doppio clic = scrivi gli Hz.", "FREQ: DRC bell center frequency (25 Hz - 18 kHz, moves HP/LP together). SHIFT = fine. Double click to type Hz.") :
active_info_id >= 135 && active_info_id <= 138 ? msg("OCT: ampiezza della campana DRC in ottave (0.12 - 3.50 oct, destra = piu' larga; bordi morbida curva SVF a -3 dB).", "OCT: DRC bell width in octaves (0.12 - 3.50 oct, right = wider; smooth SVF -3 dB skirts).") :
active_info_id == 125 ? msg("SOLO A MOLLA: arma la banda attiva; preascolti SOLO mentre tieni premuto o mentre muovi THR / FREQ / OCT sopra (auto-off 10s).", "SPRING SOLO: arms active band; auditions ONLY while holding button or dragging THR / FREQ / OCT above (10s auto-off).") :
