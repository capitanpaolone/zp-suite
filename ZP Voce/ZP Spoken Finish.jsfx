    set_ui_slider(6, 56);   set_ui_slider(7, 1);   set_ui_slider(13, 52);
  ) : preset_id == 5 ? (
    set_ui_slider(1, 2400); set_ui_slider(2,-18);  set_ui_slider(3,-42);
    set_ui_slider(6, 62);   set_ui_slider(7, 1);   set_ui_slider(13, 70);
  ) : preset_id == 6 ? (
    set_ui_slider(1, 950);  set_ui_slider(2, 22);  set_ui_slider(3, 12);
    set_ui_slider(6, 38);   set_ui_slider(7, 1);   set_ui_slider(13, 28);
  ) : preset_id == 7 ? (
    set_ui_slider(1, 1200); set_ui_slider(2, 30);  set_ui_slider(3, 20);
    set_ui_slider(6, 45);   set_ui_slider(7, 1);   set_ui_slider(13, 35);
  ) : (
