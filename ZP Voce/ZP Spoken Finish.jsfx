function ui_action_button(bx, by, bw, bh, label, is_active, info_id, cr, cg, cb)
local(is_hover, tw, th, clicked) (
  is_hover = hit(mouse_x, mouse_y, bx, by, bw, bh);
  clicked = is_hover && mouse_click;
  is_hover ? active_info_id = info_id;

  is_active ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 0.95;
  ) : (
    gfx_r = panel2_r; gfx_g = panel2_g; gfx_b = panel2_b; gfx_a = 1;
    is_hover ? ( gfx_r += 0.05; gfx_g += 0.05; gfx_b += 0.05; );
  );
  gfx_rect(bx, by, bw, bh);
  gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.9;
  gfx_rect(bx, by, bw, 1); gfx_rect(bx, by + bh - 1, bw, 1); gfx_rect(bx, by, 1, bh); gfx_rect(bx + bw - 1, by, 1, bh);

  gfx_setfont(5);
  is_active ? (
    gfx_r = 0.05; gfx_g = 0.06; gfx_b = 0.08;
  ) : (
    gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
  );
  gfx_measurestr(label, tw, th);
  gfx_x = bx + (bw - tw) * 0.5; gfx_y = by + (bh - th) * 0.5; gfx_drawstr(label);
  clicked;
);

function ui_tab_button(sl_idx, target_val, bx, by, bw, bh, label, info_id, cr, cg, cb)
local(cur, is_active, is_hover, tw, th) (
  cur = floor(slider(sl_idx) + 0.5);
  is_active = cur == target_val;
  is_hover = hit(mouse_x, mouse_y, bx, by, bw, bh);

  is_hover ? active_info_id = info_id;
  is_hover && mouse_click ? set_ui_slider(sl_idx, target_val);

  is_active ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 0.95;
  ) : (
    gfx_r = panel2_r; gfx_g = panel2_g; gfx_b = panel2_b; gfx_a = 1;
    is_hover ? ( gfx_r += 0.05; gfx_g += 0.05; gfx_b += 0.05; );
  );
  gfx_rect(bx, by, bw, bh);
  gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.9;
  gfx_rect(bx, by, bw, 1); gfx_rect(bx, by + bh - 1, bw, 1); gfx_rect(bx, by, 1, bh); gfx_rect(bx + bw - 1, by, 1, bh);

  gfx_setfont(3);
  is_active ? (
    gfx_r = 0.05; gfx_g = 0.06; gfx_b = 0.08;
  ) : (
    gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
  );
  gfx_measurestr(label, tw, th);
  gfx_x = bx + (bw - tw) * 0.5; gfx_y = by + (bh - th) * 0.5; gfx_drawstr(label);
);

function ui_toggle_button(sl_idx, bx, by, bw, bh, lbl_on, lbl_off, info_id, cr, cg, cb)
local(val, is_on, is_hover, tw, th) (
  val = slider(sl_idx);
  is_on = val >= 0.5;
  is_hover = hit(mouse_x, mouse_y, bx, by, bw, bh);

  is_hover ? active_info_id = info_id;
  is_hover && mouse_click ? set_ui_slider(sl_idx, 1 - floor(val + 0.5));

  is_on ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 0.95;
  ) : (
    gfx_r = panel2_r; gfx_g = panel2_g; gfx_b = panel2_b; gfx_a = 1;
    is_hover ? ( gfx_r += 0.04; gfx_g += 0.04; gfx_b += 0.04; );
  );
  gfx_rect(bx, by, bw, bh);
  gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_a = 0.9;
  gfx_rect(bx, by, bw, 1); gfx_rect(bx, by + bh - 1, bw, 1); gfx_rect(bx, by, 1, bh); gfx_rect(bx + bw - 1, by, 1, bh);
  gfx_setfont(3);
  is_on ? ( gfx_r = 0.05; gfx_g = 0.06; gfx_b = 0.08; ) : ( gfx_r = text_r; gfx_g = text_g; gfx_b = text_b; );
  is_on ? ( #tg_lbl = lbl_on; ) : ( #tg_lbl = lbl_off; );
  gfx_measurestr(#tg_lbl, tw, th);
  gfx_x = bx + (bw - tw) * 0.5; gfx_y = by + (bh - th) * 0.5; gfx_drawstr(#tg_lbl);
);

function ui_knob(sl_idx, kx, ky, r, min_v, max_v, def_v, label, unit, cr, cg, cb, info_id)
local(val, draw_val, norm_val, ang_min, ang_max, ang, is_hover, mouse_dy, drag_sens, tw, th, hover_mul, is_double_click, is_locked,
      meter_on, meter_db, meter_norm, meter_ang, meter_r) (
  val = slider(sl_idx);
  is_locked = (sl_idx == 28) && (delta_mode >= 0.5);
  draw_val = is_locked ? 100 : val;
  is_hover = hit(mouse_x, mouse_y, kx - r - 8, ky - r - 20, (r + 8) * 2, (r + 20) * 2);

  is_hover ? (
    active_info_id = info_id;
    !is_locked && mouse_click ? (
      is_double_click = (ui_last_click_id == sl_idx) && ((ui_gfx_frame - ui_last_click_frame) <= ui_double_click_frames);
      ui_last_click_id = sl_idx;
      ui_last_click_frame = ui_gfx_frame;
      is_double_click ? (
        set_ui_slider(sl_idx, def_v);
        val = def_v;
        draw_val = def_v;
        ui_drag_id = 0;
      ) : (
        ui_drag_id = sl_idx;
        ui_drag_start_y = mouse_y;
        ui_drag_start_v = val;
      );
    );
    !is_locked && mouse_right_click ? ( set_ui_slider(sl_idx, def_v); val = def_v; draw_val = def_v; );
  );

  !is_locked && ui_drag_id == sl_idx && mouse_down ? (
    drag_sens = ((max_v - min_v) / 150.0) * fine_tune;
    mouse_dy = ui_drag_start_y - mouse_y;
    val = ui_drag_start_v + mouse_dy * drag_sens;
    val = max(min_v, min(max_v, val));
    set_ui_slider(sl_idx, val);
    draw_val = val;
  ) : ( ui_drag_id == sl_idx ? ui_drag_id = 0; );

  hover_mul = (is_hover || ui_drag_id == sl_idx) ? 1.35 : 0.85;
  ang_min = 2.356; ang_max = 7.068;
  norm_val = (draw_val - min_v) / max(0.0001, max_v - min_v);
  norm_val = max(0, min(1, norm_val));
  ang = ang_min + norm_val * (ang_max - ang_min);

  (is_hover || ui_drag_id == sl_idx) ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = show_simple ? 0.15 : 0.10;
    gfx_circle(kx, ky, r + 8, 1, 1);
  );

  // Live true-peak detector ring around the limiter ceiling.
  meter_on = sl_idx==31;
  meter_on ? (
    meter_db = 20*log(max(tp_meter_peak,0.000000000001))/log(10);
    meter_norm = max(0,min(1,(meter_db-min_v)/max(0.0001,max_v-min_v)));
    meter_ang = ang_min + meter_norm*(ang_max-ang_min); meter_r = r+5;
    gfx_r=show_simple?0.70:0.24;gfx_g=show_simple?0.72:0.25;gfx_b=show_simple?0.76:0.29;gfx_a=0.72;
    gfx_arc(kx,ky,meter_r,ang_min,ang_max,1);gfx_arc(kx,ky,meter_r+1,ang_min,ang_max,1);
    meter_db>=draw_val ? (gfx_r=min(1,cr*0.42+0.58);gfx_g=min(1,cg*0.36+0.60);gfx_b=min(1,cb*0.30+0.66);gfx_a=1;) :
                         (gfx_r=cr*0.52+0.16;gfx_g=cg*0.48+0.16;gfx_b=cb*0.48+0.18;gfx_a=0.72;);
    gfx_arc(kx,ky,meter_r,ang_min,meter_ang,1);gfx_arc(kx,ky,meter_r+1,ang_min,meter_ang,1);
    gfx_r=show_simple?0.18:0.94;gfx_g=show_simple?0.21:0.95;gfx_b=show_simple?0.26:0.98;gfx_a=0.92;
    gfx_line(kx+cos(ang)*(meter_r-2),ky+sin(ang)*(meter_r-2),
             kx+cos(ang)*(meter_r+2),ky+sin(ang)*(meter_r+2),1);
  );

  show_simple ? ( gfx_r = 0.98; gfx_g = 0.99; gfx_b = 1.0; ) : ( gfx_r = 0.16; gfx_g = 0.17; gfx_b = 0.20; );
  gfx_a = 1; gfx_circle(kx, ky, r, 1, 1);

  gfx_r = min(1, cr * hover_mul); gfx_g = min(1, cg * hover_mul); gfx_b = min(1, cb * hover_mul); gfx_a = 1;
  gfx_arc(kx, ky, r - 2, ang_min, ang, 3); gfx_arc(kx, ky, r - 3, ang_min, ang, 3);

  gfx_r = show_simple ? 0.18 : 0.92; gfx_g = show_simple ? 0.21 : 0.92; gfx_b = show_simple ? 0.26 : 0.92;
  gfx_line(kx, ky, kx + cos(ang) * r, ky + sin(ang) * r);

  gfx_setfont(3);
  show_simple ? ( gfx_r = 0.22 * hover_mul; gfx_g = 0.26 * hover_mul; gfx_b = 0.32 * hover_mul; ) :
                ( gfx_r = 0.83 * hover_mul; gfx_g = 0.83 * hover_mul; gfx_b = 0.86 * hover_mul; );
  is_locked ? ( gfx_r = grp_prof_r; gfx_g = grp_prof_g; gfx_b = grp_prof_b; );
  gfx_measurestr(label, tw, th); gfx_x = kx - tw * 0.5; gfx_y = ky - r - 16; gfx_drawstr(label);

  gfx_r = min(1, cr * hover_mul); gfx_g = min(1, cg * hover_mul); gfx_b = min(1, cb * hover_mul);
  abs(draw_val - floor(draw_val + 0.5)) < 0.03 ? sprintf(#knob_val, "%.0f %s", draw_val, unit) : sprintf(#knob_val, "%.1f %s", draw_val, unit);
  gfx_measurestr(#knob_val, tw, th); gfx_x = kx - tw * 0.5; gfx_y = ky + r + 6; gfx_drawstr(#knob_val);
  is_locked ? (
    gfx_setfont(2);
    gfx_r = grp_prof_r; gfx_g = grp_prof_g; gfx_b = grp_prof_b;
    gfx_measurestr("LOCK", tw, th); gfx_x = kx - tw * 0.5; gfx_y = ky + r + 22; gfx_drawstr("LOCK");
  );
);

gfx_r = bg_r; gfx_g = bg_g; gfx_b = bg_b; gfx_a = 1; gfx_rect(0, 0, gfx_w, gfx_h);
gfx_r = bg2_r; gfx_g = bg2_g; gfx_b = bg2_b; gfx_a = show_simple ? 0.32 : 0.22; gfx_rect(0, 0, gfx_w, 132);

pad = 18;
gap = 14;
head_w_nom = gfx_w - pad * 2;
head_h_nom = view_mode == 1 ? 62 : 96;
  row_h = 292;
tele_h_nom = 228;
mini_h_nom = 116;
jsfx_h_nom = 176;
jsfx_guide_h_nom = 110;
compact_full = view_mode == 0 && head_w_nom < 860;
head_compact = head_w_nom < 820;
head_ultra = head_w_nom < 620;
content_view_h = gfx_h - (view_mode == 0 ? 28 : 0);
content_h = 12 + head_h_nom + 12;
view_mode == 0 ? (
  compact_full ? (
    show_simple ? (
      content_h += row_h + 12 + row_h + 12 + tele_h_nom + 12;
    ) : (
      content_h += row_h + 12 + row_h + 12 + row_h + 12 + tele_h_nom + 12;
    );
  ) : (
    content_h += row_h + 12 + tele_h_nom + 12;
  );
);
view_mode == 1 ? content_h += mini_h_nom + 12;
view_mode == 2 ? content_h += jsfx_h_nom + 12 + jsfx_guide_h_nom + 12;
max_scroll = max(0, content_h - content_view_h);
abs(mouse_wheel) > 0 ? (
  ui_scroll_y -= mouse_wheel * 0.25;
  mouse_wheel = 0;
);
ui_scroll_y = max(0, min(max_scroll, ui_scroll_y));
max_scroll <= 0 ? ui_scroll_drag = 0;

head_x = pad; head_y = 12 - ui_scroll_y; head_w = head_w_nom; head_h = head_h_nom;
max_scroll > 0 ? ui_scrollbar(gfx_w - 14, 8, content_view_h - 16, max_scroll);
draw_panel(head_x, head_y, head_w, head_h, panel_r, panel_g, panel_b, 1);
gfx_r = grp_eng_r; gfx_g = grp_eng_g; gfx_b = grp_eng_b; gfx_a = 0.95; gfx_rect(head_x, head_y, head_w, 4);

gfx_setfont(1); gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
gfx_x = head_x + 16; gfx_y = head_y + 14; gfx_drawstr("SPOKEN FINISH");
zp_bus_read();
zp_bus_master_conn==2 && zp_bus_probe_conn==2 ? (gfx_r=0.30;gfx_g=0.92;gfx_b=0.58;) : zp_bus_master_conn>0 && zp_bus_probe_conn>0 ? (gfx_r=1.0;gfx_g=0.72;gfx_b=0.20;) : (gfx_r=1.0;gfx_g=0.34;gfx_b=0.28;);
gfx_circle(head_x+175,head_y+22,5,1); gfx_setfont(5); gfx_x=head_x+185; gfx_y=head_y+15; gfx_drawstr("ZP");
!head_ultra ? (
  gfx_setfont(2); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b;
  gfx_x = head_x + 16; gfx_y = head_y + 40; gfx_drawstr("Voice Harmonic Exciter / De-Exciter  |  v3.9.8 - di Paolo Balestri");
);

show_simple ? (
  prev_adv_profile = -1;
) : (
  (prev_adv_profile >= 0 && prev_adv_profile != ui_profile) ? (
    ui_profile == 0 ? apply_adv_vb_preset(adv_last_vb_preset) : apply_adv_tr_preset(adv_last_tr_preset);
  );
  prev_adv_profile = ui_profile;
);

adv_vb_preset_cur = (!show_simple && ui_profile == 0) ? detect_adv_vb_preset() : -1;
adv_tr_preset_cur = (!show_simple && ui_profile == 1) ? detect_adv_tr_preset() : -1;
adv_vb_preset_cur >= 0 ? adv_last_vb_preset = adv_vb_preset_cur;
adv_tr_preset_cur >= 0 ? adv_last_tr_preset = adv_tr_preset_cur;
view_mode != 1 && !head_compact ? (
