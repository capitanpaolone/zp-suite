zp_bus_read();
zp_bus_profile==1?strcpy(#zp_bus_profile_text,"VOICEOVER"):zp_bus_profile==2?strcpy(#zp_bus_profile_text,"ADR"):zp_bus_profile==3?strcpy(#zp_bus_profile_text,"ELEARNING"):zp_bus_profile==4?strcpy(#zp_bus_profile_text,"PODCAST"):zp_bus_profile==5?strcpy(#zp_bus_profile_text,"SPOT"):strcpy(#zp_bus_profile_text,"RADIO");
zp_bus_master_conn==0 ? strcpy(#zp_bus_status_text,"MASTER MISSING") : zp_bus_probe_conn==0 ? strcpy(#zp_bus_status_text,"VOICE PROBE MISSING") : zp_bus_master_conn==2 && zp_bus_probe_conn==2 ? strcpy(#zp_bus_status_text,"BUS CONNECTED") : strcpy(#zp_bus_status_text,"BUS DATA OLD");
sprintf(#zp_bus_line, "%s | %s", #zp_bus_status_text, #zp_bus_profile_text);
zp_bus_box_w = min(190, gfx_w - 8); zp_bus_box_x = max(4, gfx_w - zp_bus_box_w - 4); zp_bus_box_y=max(4,gfx_h-22);
gfx_set(0.035,0.045,0.055,0.96); gfx_rect(zp_bus_box_x,zp_bus_box_y,zp_bus_box_w,18);
zp_bus_master_conn==2 && zp_bus_probe_conn==2 ? gfx_set(0.34,0.92,0.66,1) : zp_bus_master_conn>0 && zp_bus_probe_conn>0 ? gfx_set(1.0,0.72,0.20,1) : gfx_set(1.0,0.42,0.34,1);
gfx_setfont(1,"Arial",9,'b'); gfx_x=zp_bus_box_x+7; gfx_y=zp_bus_box_y+4; gfx_drawstr(#zp_bus_line);
