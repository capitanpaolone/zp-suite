      st == 3 ? (gfx_r=0.95; gfx_g=0.62; gfx_b=0.15;) : (st == 4 || st == 7) ? (gfx_r=0.95; gfx_g=0.28; gfx_b=0.25;) :
      st == 6 ? (gfx_r=0.45; gfx_g=0.60; gfx_b=0.48;) : (gfx_r=0.25; gfx_g=0.25; gfx_b=0.30;);
      gfx_circle(243, ui_sy(sy_row + 10), 5, 1, 1);
      ui_hit(18, sy_row, 236, 20) ? active_info_id = 65 + i;
