  ui_dark_panel = 0;
);

view_mode == 0 ? (
  footer_top = gfx_h - footer_h;
  show_simple ? ( gfx_r=0.85; gfx_g=0.89; gfx_b=0.94; gfx_a=1; ) : ( gfx_r=0.11; gfx_g=0.11; gfx_b=0.14; gfx_a=1; );
  gfx_rect(0, footer_top, gfx_w, footer_h);
  show_simple ? (gfx_r=0.71; gfx_g=0.76; gfx_b=0.82;) : (gfx_r=0.2; gfx_g=0.2; gfx_b=0.25;);
  gfx_line(0, footer_top, gfx_w, footer_top);

  gfx_setfont(5);
  show_simple ? (gfx_r=0.28; gfx_g=0.33; gfx_b=0.39;) : (gfx_r=0.7; gfx_g=0.7; gfx_b=0.7;);
  gfx_x = 15; gfx_y = footer_top + 6;

  quick_now < help_warn_until ? (
    gfx_r = 0.95; gfx_g = 0.65; gfx_b = 0.20;
    ui_lang == 1 ?
      gfx_drawstr("Guide: open ZP Help > Harmonic Space Carver (start Cue Navigator from 33 Welcome to open it from here)") :
      gfx_drawstr("Guida: apri Help ZP > Harmonic Space Carver (avvia il Cue Navigator dal 33 Benvenuto per aprirla da qui)");
  ) :
  active_info_id == 99 ? (
    ui_lang == 1 ? gfx_drawstr("GUIDE: click to open the dedicated HTML guide section in browser.") :
                   gfx_drawstr("GUIDA: clic per aprire la sezione dedicata della guida HTML nel browser.");
  ) :
  active_info_id == 2  ? (ui_lang == 1 ? gfx_drawstr("IN: music level before processing.") : gfx_drawstr("IN: livello della musica prima del processamento.")) :
  active_info_id == 4  ? (ui_lang == 1 ? gfx_drawstr("PROFILE: SIMPLE shows primary controls, ADVANCED shows all. Same DSP engine and sound.") : gfx_drawstr("PROFILO: SIMPLE mostra i controlli principali, ADVANCED tutti. Il motore e il suono sono gli stessi.")) :
  active_info_id == 6  ? (ui_lang == 1 ? gfx_drawstr("VOICE THRESH: voice detected above threshold activates VCA. Outer ring = voice level.") : gfx_drawstr("THRESH VOCE: sopra questa soglia c'e' voce e il VCA lavora. Anello esterno = livello della voce.")) :
  active_info_id == 7  ? (ui_lang == 1 ? gfx_drawstr("CARVER THRESH: voice threshold per band. Outer ring = loudest voice band.") : gfx_drawstr("THRESH CARVER: soglia di ogni banda della voce. Anello esterno = banda della voce piu' forte.")) :
  active_info_id == 8  ? (ui_lang == 1 ? gfx_drawstr("RMS STAB: makes voice detection more stable (100%) or more reactive (0%). Does not compress voice.") : gfx_drawstr("RMS STAB: rende la lettura della voce piu' stabile (100%) o piu' pronta (0%). Non comprime la voce.")) :
  active_info_id == 13 ? (ui_lang == 1 ? gfx_drawstr("LOW: maximum ducking amount in music low frequencies.") : gfx_drawstr("LOW: quanto il Carver puo' scavare nei bassi della musica.")) :
  active_info_id == 14 ? (ui_lang == 1 ? gfx_drawstr("MID: maximum ducking amount in music midrange (voice region).") : gfx_drawstr("MID: quanto il Carver puo' scavare nelle medie (dove sta la voce).")) :
  active_info_id == 15 ? (ui_lang == 1 ? gfx_drawstr("HIGH: maximum ducking amount in music high frequencies.") : gfx_drawstr("HIGH: quanto il Carver puo' scavare negli alti della musica.")) :
  active_info_id == 16 ? (ui_lang == 1 ? gfx_drawstr("INTENS (Simple: SPACE): overall Carver carving strength across all bands.") : gfx_drawstr("INTENS (in Simple: SPAZIO): forza complessiva del Carver su tutte le bande.")) :
  active_info_id == 17 ? (ui_lang == 1 ? gfx_drawstr("CARVER ATTACK: how quickly spectral carving opens for speech.") : gfx_drawstr("CARVER ATTACK: velocita' con cui lo scavo si apre alla voce.")) :
  active_info_id == 18 ? (ui_lang == 1 ? gfx_drawstr("CARVER RELEASE: how smoothly music recovers across spectral bands.") : gfx_drawstr("CARVER RELEASE: quanto dolcemente la musica torna piena nelle bande.")) :
  active_info_id == 19 ? (ui_lang == 1 ? gfx_drawstr("SPREAD: broadens carving to adjacent bands for smoother transition.") : gfx_drawstr("SPREAD: allarga lo scavo alle bande vicine per un effetto piu' morbido.")) :
  active_info_id == 22 ? (ui_lang == 1 ? gfx_drawstr("CEILING: VCA acts when music exceeds this level. Outer ring = music level.") : gfx_drawstr("CEILING: il VCA agisce quando la musica supera questo livello. Anello esterno = livello della musica.")) :
  active_info_id == 23 ? (ui_lang == 1 ? gfx_drawstr("MIN DUCK: minimum ducking when voice is present. Cannot exceed Max Duck.") : gfx_drawstr("MIN DUCK: riduzione minima quando c'e' voce. Non puo' superare Max Duck (lo trascina con se').")) :
  active_info_id == 24 ? (ui_lang == 1 ? gfx_drawstr("MAX DUCK (Simple: DUCK): maximum music reduction. Orange mark on VCA meter.") : gfx_drawstr("MAX DUCK (in Simple: DUCK): riduzione massima della musica. Segno arancio sul meter VCA.")) :
  active_info_id == 25 ? (ui_lang == 1 ? gfx_drawstr("PRIO: how strongly VCA pulls music towards Ceiling between Min and Max Duck.") : gfx_drawstr("PRIO: quanto il VCA porta la musica verso il Ceiling, tra Min e Max Duck.")) :
  active_info_id == 26 ? (ui_lang == 1 ? gfx_drawstr("VCA ATTACK: how quickly music ducks.") : gfx_drawstr("VCA ATTACK: rapidita' con cui la musica si abbassa.")) :
  active_info_id == 27 ? (ui_lang == 1 ? gfx_drawstr("HOLD: how long voice remains active across pauses and breaths.") : gfx_drawstr("HOLD: quanto la voce resta 'accesa' tra parole, pause e respiri.")) :
  active_info_id == 28 ? (ui_lang == 1 ? gfx_drawstr("VCA RELEASE (Simple: RELEASE): how fast music recovers.") : gfx_drawstr("VCA RELEASE (in Simple: RIENTRO): velocita' con cui la musica torna su.")) :
  active_info_id == 31 ? (ui_lang == 1 ? gfx_drawstr("AUDITION: OFF = normal out. CARVER / VCA / ALL audition removed material only.") : gfx_drawstr("PREASCOLTO: OFF = uscita normale. CARVER / VCA / TUTTO fanno sentire solo cio' che viene tolto.")) :
  active_info_id == 32 ? (ui_lang == 1 ? gfx_drawstr("VOICE RET: blends dry voice into output (OFF by default). Useful outside DAW.") : gfx_drawstr("VOICE RET: aggiunge la voce all'uscita (OFF di serie). Utile solo fuori dalla DAW.")) :
  active_info_id == 33 ? (ui_lang == 1 ? gfx_drawstr("GLUE: final voice-linked polish; rests at 0 dB.") : gfx_drawstr("GLUE: rifinitura finale vincolata alla voce; a riposo resta a 0 dB.")) :
  active_info_id == 34 ? (ui_lang == 1 ? gfx_drawstr("OUT: final output gain.") : gfx_drawstr("OUT: guadagno finale in uscita.")) :
  active_info_id == 35 ? (ui_lang == 1 ? gfx_drawstr("MIX: dry/wet processing amount (100% = full, 0% = dry).") : gfx_drawstr("MIX: quantita' di processamento (100% = tutto, 0% = musica intatta).")) :
  active_info_id == 50 ? (ui_lang == 1 ? gfx_drawstr("VCA RETURN: STD classic, GRADUAL restores music with a long smooth ramp after Hold.") : gfx_drawstr("RIENTRO VCA: STD classico, GRADUAL riapre la musica con una rampa lunga e morbida dopo l'Hold.")) :
  active_info_id == 51 ? (ui_lang == 1 ? gfx_drawstr("VIEW: FULL complete interface, DOCK compact strip with status and cues.") : gfx_drawstr("VISTA: FULL tutta la GUI, DOCK una striscia con stato e cue da tenere aperta mentre monti.")) :
  active_info_id == 53 ? (ui_lang == 1 ? gfx_drawstr("DBG: toggles VCA diagnostics in footer.") : gfx_drawstr("DBG: mostra o nasconde la diagnostica VCA nel footer.")) :
  active_info_id == 56 ? (ui_lang == 1 ? gfx_drawstr("CUE: ADD/REMOVE at playhead or edit cursor; syncs to #HSC marker. < > jump or select.") : gfx_drawstr("CUE: ADD/REMOVE sul playhead o sul cursore; diventa un marker #HSC che segue i tagli. < > saltano (SALTA) o selezionano.")) :
  active_info_id == 57 ? (ui_lang == 1 ? gfx_drawstr("CLEAR ALL: click 1 arms (CONFIRM?), click 2 within 3s clears all cues. UNDO restores.") : gfx_drawstr("CLEAR ALL: primo clic arma (CONFERMA?), secondo clic entro 3 s cancella tutti i cue. UNDO li rimette.")) :
  active_info_id == 58 ? (quick_gmem_base < 0 ? (ui_lang == 1 ? gfx_drawstr("TIMELINE: jump unavailable on take/input FX. HOLD browses cues.") : gfx_drawstr("TIMELINE: salto non disponibile su take FX o input FX. RESTA FERMO scorre i cue.")) :
    (ui_lang == 1 ? gfx_drawstr("TIMELINE: JUMP moves playhead to cues (Cue Navigator helper); HOLD selects only.") : gfx_drawstr("TIMELINE: SALTA sposta il playhead sui cue (helper Cue Navigator); RESTA FERMO solo li seleziona."))) :
  active_info_id == 59 ? (ui_lang == 1 ? gfx_drawstr("UNDO: reverts last cue add, remove, or clear action.") : gfx_drawstr("UNDO: annulla l'ultima aggiunta, rimozione o cancellazione dei cue.")) :
  active_info_id == 60 ? (ui_lang == 1 ? gfx_drawstr("CUE ROW: cyan = aligned, red = displaced. Click selects, Cmd/Ctrl+click adds, Shift+click range.") : gfx_drawstr("FILA DEI CUE: ciano = al suo posto, rosso = fuori posto. Clic sceglie, Cmd/Ctrl+clic aggiunge, Shift+clic intervallo.")) :
  active_info_id == 77 ? (ui_lang == 1 ? gfx_drawstr("DELETE: removes selected cues and their #HSC markers (Cmd/Ctrl+click or Shift+click for multiple). UNDO restores.") : gfx_drawstr("ELIMINA: toglie i cue selezionati e i loro marker #HSC (Cmd/Ctrl+clic o Shift+clic per piu' cue). UNDO li rimette.")) :
  active_info_id == 61 ? (ui_lang == 1 ? gfx_drawstr("OPENING: music remains open for this duration after ramp, ignoring voice.") : gfx_drawstr("APERTURA: dopo la Rampa la musica resta aperta per questo tempo, ignorando la voce.")) :
  active_info_id == 65 ? gfx_drawstr(#sc_msg0) : active_info_id == 66 ? gfx_drawstr(#sc_msg1) : active_info_id == 67 ? gfx_drawstr(#sc_msg2) :
  active_info_id == 68 ? (ui_lang == 1 ? gfx_drawstr("VOICE INPUTS: visible when track has channels. Plugin I/O, Track channels 6 (SC2) or 8 (SC3).") : gfx_drawstr("FONTI VOCE: compaiono quando la traccia ha i canali. Pulsante I/O del plugin, Track channels 6 (SC2) o 8 (SC3).")) :
  active_info_id == 63 ? (ui_lang == 1 ? gfx_drawstr("LOOKAHEAD: Carver analyzes voice before music (lookahead), adding matching latency (PDC).") : gfx_drawstr("ANTICIPO: il Carver vede la voce prima della musica (lookahead). Aggiunge la stessa latenza (PDC).")) :
  active_info_id == 75 ? (ui_lang == 1 ? gfx_drawstr("HELPER STOPPED: jumps, #HSC markers, and cue realignment disabled. Start ZP Harmonic Space Carver Cue Navigator.") : gfx_drawstr("HELPER SPENTO: salti, marker #HSC, tracce voce e cue rossi non funzionano. Avvia l'azione ZP Harmonic Space Carver Cue Navigator.")) :
  active_info_id == 76 ? (ui_lang == 1 ? gfx_drawstr("MIN = MAX: music always ducks to Max Duck with voice; Ceiling/Prio inactive. Raise Min Duck (e.g. -3 dB).") : gfx_drawstr("MIN = MAX: con la voce la musica scende sempre di Max Duck; Ceiling e Prio non lavorano. Alza Min Duck (es. -3 dB).")) :
  active_info_id == 73 ? (ui_lang == 1 ? gfx_drawstr("DISPLACED: voice beneath cue has moved; cue triggers at wrong point. REALIGN snaps to voice.") : gfx_drawstr("FUORI POSTO: la voce sotto il cue si e' spostata; il cue scatta nel punto sbagliato. RIALLINEA lo porta sulla sua voce.")) :
  active_info_id == 74 ? (ui_lang == 1 ? gfx_drawstr("KEEP HERE: cue stays at current position and locks to current voice below.") : gfx_drawstr("TIENI QUI: il cue resta dov'e' e prende come riferimento la voce che ha sotto adesso.")) :
  active_info_id == 64 ? (ui_lang == 1 ? gfx_drawstr("KNEE: Carver threshold knee softness (0 = hard).") : gfx_drawstr("KNEE: morbidezza dell'ingresso in soglia del Carver (0 = netto).")) :
  active_info_id == 70 ? (ui_lang == 1 ? gfx_drawstr("STARTING POINT: sets Depth, Intens, Spread, Prio, Min/Max Duck. SCORE cinema, FLAT balanced, VOCAL podcast.") : gfx_drawstr("PARTENZA: imposta Depth, Intens, Spread, Prio, Min e Max Duck. SCORE cinema, FLAT equilibrio, VOCAL podcast.")) :
  active_info_id == 71 ? (ui_lang == 1 ? gfx_drawstr("ON/OFF: toggles Carver or VCA (at least one remains active).") : gfx_drawstr("ON/OFF: spegne il Carver o il VCA (resta sempre acceso almeno uno dei due).")) :
  active_info_id == 72 ? (ui_lang == 1 ? gfx_drawstr("BANDS: GR = reduction per band; drag crossover lines (right click = default). SCOPE = waveforms.") : gfx_drawstr("BANDE: GR = riduzione per banda; trascina le linee per i crossover (destro = valore iniziale). SCOPE = forme d'onda.")) :
  (ui_lang == 1 ?
    gfx_drawstr("ZP HARMONIC SPACE CARVER v2.6 - Double-click = default | Shift+click = zero | Shift+drag = fine tune") :
    gfx_drawstr("ZP HARMONIC SPACE CARVER v2.6 - Doppio clic = default | Shift+clic = zero | Shift+drag = precisione"));

  dbg_bx = gfx_w - 60; dbg_by = footer_top + 7; dbg_bw = 44; dbg_bh = max(24, ui_font_small + 8);
  dbg_hover = (mouse_x >= dbg_bx && mouse_x <= dbg_bx + dbg_bw && mouse_y >= dbg_by && mouse_y <= dbg_by + dbg_bh);
  dbg_hover ? active_info_id = 53;
  dbg_hover && mouse_click ? ( slider(53) = 1 - floor(slider(53)); notify_slider(53); debug_enabled = slider(53) >= 0.5; );
  debug_enabled ? ( gfx_r=0.24; gfx_g=0.78; gfx_b=0.90; gfx_a=0.95; ) : ( gfx_r=0.24; gfx_g=0.24; gfx_b=0.28; gfx_a=0.95; );
  gfx_rect(dbg_bx, dbg_by, dbg_bw, dbg_bh);
  gfx_r=0.40; gfx_g=0.40; gfx_b=0.46; gfx_a=1; gfx_rect(dbg_bx, dbg_by, dbg_bw, 1);
  gfx_setfont(5);
  debug_enabled ? (gfx_r=0.05; gfx_g=0.05; gfx_b=0.06;) : (gfx_r=0.72; gfx_g=0.72; gfx_b=0.76;);
  gfx_measurestr("DBG", tw, th); gfx_x=dbg_bx+(dbg_bw-tw)*0.5; gfx_y=dbg_by+(dbg_bh-th)*0.5; gfx_drawstr("DBG");

  debug_enabled && !show_simple ? (
    gfx_setfont(5);
    gfx_r=0.62; gfx_g=0.66; gfx_b=0.74; gfx_x=15; gfx_y=footer_top + max(32, ui_font_base + 12); gfx_drawstr(#vca_ctrl_txt);
    gfx_x=175; gfx_drawstr(#vca_dbg);
  );
);

last_mouse_cap = mouse_cap;

// ZP Shared Bus status: lettura soltanto, nessun heartbeat legato alla GUI.
zp_bus_read();
zp_bus_unified_conn==0 || zp_bus_master_conn==0 ? strcpy(#zp_bus_line,"MB Off") : zp_bus_unified_conn==2 && zp_bus_master_conn==2 ? strcpy(#zp_bus_line,"MB Conn") : strcpy(#zp_bus_line,"MB Old");
view_mode == 0 ? (
  zp_bus_box_w=62; zp_bus_box_x=max(8,dbg_bx-zp_bus_box_w-8); zp_bus_box_y=footer_top+7;
) : (
  zp_bus_box_w=62; zp_bus_box_x=110; zp_bus_box_y=122;
);
gfx_set(0.035,0.045,0.055,0.96); gfx_rect(zp_bus_box_x,zp_bus_box_y,zp_bus_box_w,18);
zp_bus_unified_conn==2 && zp_bus_master_conn==2 ? gfx_set(0.34,0.92,0.66,1) : zp_bus_unified_conn>0 && zp_bus_master_conn>0 ? gfx_set(1.0,0.72,0.20,1) : gfx_set(1.0,0.42,0.34,1);
gfx_setfont(1,"Arial",9,'b'); gfx_x=zp_bus_box_x+7; gfx_y=zp_bus_box_y+4; gfx_drawstr(#zp_bus_line);
