  e_px = ex + 8 + e_aw; e_py = ey + 4; e_k = 1;
  loop(8,
    e_nx = ex + 8 + e_aw + e_rw * e_k / 8; e_ny = ey + 4 + (eh - 7) * (1 - exp(-3 * e_k / 8)) / (1 - exp(-3));
    gfx_line(e_px, ui_sy(e_py), e_nx, ui_sy(e_ny)); e_px = e_nx; e_py = e_ny; e_k += 1;
