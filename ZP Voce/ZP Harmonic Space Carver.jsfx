// ================================================================
@init
// ZP Shared Bus: lettura passiva di profilo/presenza voce e heartbeat proprio.
ZP_BUS_MAGIC = 905026;
ZP_BUS_VERSION = 220;
ZP_BUS_ID = 20;
ZP_BUS_FRESH_SEC = 2;
function zp_bus_boot() (
  gmem[0] != ZP_BUS_MAGIC || gmem[1] < ZP_BUS_VERSION ? (
    gmem[0] = ZP_BUS_MAGIC;
    gmem[1] = ZP_BUS_VERSION;
    gmem[2] = 1;
    gmem[3] = 0;
    gmem[4] = 0;
    gmem[10]=gmem[11]=gmem[12]=gmem[20]=gmem[21]=gmem[22]=0;
    gmem[30]=gmem[31]=gmem[32]=gmem[40]=gmem[41]=gmem[42]=0;
    gmem[50]=gmem[51]=gmem[52]=gmem[60]=gmem[61]=gmem[62]=0;
  );
);
function zp_bus_read() local(now) (
  zp_bus_boot();
  now=time_precise(); zp_bus_now=now;
  zp_bus_profile = max(1, min(6, floor(gmem[2] + 0.5)));
  zp_bus_unified_conn=gmem[10]==905010 ? (now-gmem[11]<=ZP_BUS_FRESH_SEC?2:1) : 0;
  zp_bus_master_conn=gmem[40]==905040 ? (now-gmem[41]<=ZP_BUS_FRESH_SEC?2:1) : 0;
  zp_bus_unified_ok=zp_bus_unified_conn>0; zp_bus_master_ok=zp_bus_master_conn>0;
);
function zp_bus_refresh(plugin_id) (
  zp_bus_boot(); gmem[plugin_id]=905000+plugin_id; gmem[plugin_id+1]=time_precise(); gmem[plugin_id+2]+=1; zp_bus_read();
);
zp_bus_refresh(ZP_BUS_ID);
// ================================================================

db2log = 0.11512925464970228;
log2db = 8.68588963806504;
DECAY = 0.99997;
// MAPPA DELLA MEMORIA (vedi ANTI_REGRESSIONE): 0-15 stati SVF, 16-6159 oscilloscopio,
// 8192-8255 cue, 8320-8383 backup cue, 8400-8431 tabella Partenza, 8440-8442 stato fonti SC,
// 8460-8523 cue selezionati per ELIMINA,
// 16384-49151 lookahead. gmem: vedi quick_service (numeri unici da 8310000).
BUF_SIZE   = 2048;
buf_main_L = 16; buf_sc_L = buf_main_L + BUF_SIZE; buf_out_L = buf_sc_L + BUF_SIZE;
i_init = 0; loop(16, i_init[0] = 0; i_init += 1;);
LA_SIZE = 8192; la_mL = 16384; la_mR = la_mL + LA_SIZE; la_sL = la_mR + LA_SIZE; la_sR = la_sL + LA_SIZE;
la_w = 0; la_samples = -1; la_xf = 0; la_xf_n = 1; la_old = 0;
la_target = min(LA_SIZE - 1, floor(max(0, min(20, slider63)) * 0.001 * srate));
pdc_delay = la_target; pdc_bot_ch = 0; pdc_top_ch = 2;

// Partenza: valori di Low, Mid, High, Intens, Spread, Prio, Min Duck, Max Duck.
preset_tab = 8400; preset_sl = 8424;
preset_sl[0]=13; preset_sl[1]=14; preset_sl[2]=15; preset_sl[3]=16; preset_sl[4]=19; preset_sl[5]=25; preset_sl[6]=23; preset_sl[7]=24;
// SCORE
preset_tab[0]=30; preset_tab[1]=120; preset_tab[2]=40; preset_tab[3]=120; preset_tab[4]=60; preset_tab[5]=20; preset_tab[6]=-1.5; preset_tab[7]=-8;
// FLAT
preset_tab[8]=40; preset_tab[9]=120; preset_tab[10]=50; preset_tab[11]=100; preset_tab[12]=50; preset_tab[13]=55; preset_tab[14]=-3; preset_tab[15]=-15;
// VOCAL
preset_tab[16]=5; preset_tab[17]=30; preset_tab[18]=10; preset_tab[19]=100; preset_tab[20]=30; preset_tab[21]=80; preset_tab[22]=-6; preset_tab[23]=-20;

env_l = 0; env_m = 0; env_h = 0; glue_env = 0; glue_gr = 1.0; glue_smooth_gr = 1.0; glue_meter_gr = 1.0; glue_active = 0;
sc_rms_env = 0; sc_rms_stab_amt = 0;
meter_main_l = 0; meter_main_r = 0; meter_sc_l = 0; meter_sc_r = 0;
meter_out_l = 0; meter_out_r = 0; meter_delta_l= 0; meter_delta_r= 0;
meter_s1 = 0; meter_s2 = 0; meter_s3 = 0;
meter_gr_l = 1; meter_gr_m = 1; meter_gr_h = 1;
sc_act_l = 0; sc_act_m = 0; sc_act_h = 0;
w_pos = 0; last_srate = srate;
last_play_pos = play_position; was_playing = play_state & 1;
// Cue di rientro rapido. Memoria propria da 8192 e inizializzazione UNA volta sola:
// REAPER rilancia @init a ogni Play (niente ext_noinit).
quick_points = 8192; quick_backup = 8320; quick_msel = 8460;
// Selezione multipla per ELIMINA (indici dei cue): si azzera a ogni cambio dell'elenco.
function quick_msel_clear() local(i) ( i = 0; loop(64, quick_msel[i] = 0; i += 1;); quick_msel_n = 0; quick_msel_anchor = -1; );
function quick_msel_count() local(i) (
  quick_msel_n = 0; i = 0; loop(quick_point_count, quick_msel[i] ? (quick_msel_n += 1); i += 1;); quick_msel_n;
);
function quick_insert(t) local(i) (
  quick_point_count < 64 ? (
    i = quick_point_count;
    while (i > 0 && quick_points[i-1] > t) ( quick_points[i] = quick_points[i-1]; i -= 1; );
    quick_points[i] = t; quick_point_count += 1; i;
  ) : -1;
);
function quick_delete(idx) local(i) (
  idx >= 0 && idx < quick_point_count ? (
    i = idx; loop(quick_point_count - idx - 1, quick_points[i] = quick_points[i+1]; i += 1;);
    quick_point_count -= 1; quick_points[quick_point_count] = -1;
  );
);
function quick_sort() local(i, j, v) (
  i = 1;
  loop(max(0, quick_point_count - 1),
    v = quick_points[i]; j = i;
    while (j > 0 && quick_points[j-1] > v) ( quick_points[j] = quick_points[j-1]; j -= 1; );
    quick_points[j] = v; i += 1;
  );
);
function quick_set_status(st) ( quick_status = st; quick_status_t = time_precise(); );
// Aggiunge un cue in t, o lo toglie se ce n'e' gia' uno entro 80 ms. Restituisce 1 se aggiunto.
function quick_toggle_at(t) local(i, found, added) (
  found = -1; i = 0; added = 0; quick_msel_clear();
  loop(quick_point_count, abs(quick_points[i] - t) <= 0.08 ? found = i; i += 1;);
  found >= 0 ? (
    quick_last_action = 2; quick_last_action_pos = quick_points[found];
    quick_delete(found); quick_sel = -1; quick_set_status(2);
  ) : quick_point_count < 64 ? (
    quick_sel = quick_insert(t); added = 1;
    quick_last_action = 1; quick_last_action_pos = t; quick_set_status(1);
  ) : quick_set_status(3);
  quick_gmem_base >= 0 ? gmem[quick_gmem_base+2] = quick_sel;
  added;
);
// Annulla l'ultima modifica. Restituisce 5 (tolto l'ultimo aggiunto), 6 (rimesso), 0 (niente).
function quick_undo() local(i, idx, r) (
  r = 0; quick_msel_clear();
  quick_last_action == 1 ? (
    i = 0; idx = -1;
    loop(quick_point_count, abs(quick_points[i] - quick_last_action_pos) < 0.001 ? idx = i; i += 1;);
    idx >= 0 ? (quick_delete(idx); r = 5;);
  ) : quick_last_action == 2 ? (
    quick_insert(quick_last_action_pos) >= 0 ? r = 6;
  ) : quick_last_action == 3 ? (
    quick_point_count = 0; i = 0; loop(quick_backup_count, quick_insert(quick_backup[i]); i += 1;); r = 6;
  );
  r > 0 ? quick_set_status(r);
  quick_last_action = 0; quick_last_action_pos = -1; quick_sel = -1;
  quick_gmem_base >= 0 ? gmem[quick_gmem_base+2] = -1;
  r;
);
function quick_clear_all() local(i) (
  quick_msel_clear(); quick_backup_count = quick_point_count; i = 0;
  loop(quick_point_count, quick_backup[i] = quick_points[i]; quick_points[i] = -1; i += 1;);
  quick_point_count = 0; quick_sel = -1; quick_last_action = 3; quick_last_action_pos = -1;
  quick_gmem_base >= 0 ? gmem[quick_gmem_base+2] = -1;
  quick_set_status(7);
);
// Elimina i cue selezionati (Cmd/Ctrl o Shift sulla fila) o, senza selezione multipla, il cue selezionato.
// UNDO li rimette tutti (stessa copia di CLEAR ALL). Restituisce quanti ne ha tolti.
function quick_delete_selected() local(i, n) (
  quick_msel_count() == 0 && quick_sel >= 0 && quick_sel < quick_point_count ? (quick_msel[quick_sel] = 1);
  n = quick_msel_count();
  n > 0 ? (
    quick_backup_count = quick_point_count; i = 0;
    loop(quick_point_count, quick_backup[i] = quick_points[i]; i += 1;);
    i = quick_point_count - 1;                 // dall'ultimo al primo: gli indici sotto restano validi
    loop(quick_point_count, quick_msel[i] ? quick_delete(i); i -= 1;);
    quick_last_action = 3; quick_last_action_pos = -1; quick_sel = -1;
    quick_gmem_base >= 0 ? (gmem[quick_gmem_base+2] = -1);
    quick_deleted_n = n; quick_set_status(10);
  );
  quick_msel_clear();
  n;
);
// Collegamento gmem con l'helper Cue Navigator e con le azioni da tastiera.
// base+0 comando GUI->helper, +1 seq, +2 cue selezionato, +3 ack helper, +4 numero cue, +5..+68 cue,
// +69 magic, +70 cursore (risposta helper), +71 routing delle fonti SC (scrive l'helper 1.3).
// Ogni FX ha 72 celle (0-71): niente oltre +71.
// Casella comune per azioni da tastiera e helper (HSC_MB = 3800, celle 3800-3899, libere nello Shared Bus):
// +0 base del Carver destinatario, +1 comando (1 aggiungi/togli, 4 annulla, 5 sostituisci elenco),
// +2 posizione, +3 seq, +4 ack, +5 esito, +6 cue (1..n), +7 numero cue, +10 numero cue nuovi, +11..+74 tempi.
// Gira in @block: funziona in Simple, in Dock e a finestra chiusa.
HSC_MB = 3800;
// Numeri unici: blocchi da 76 celle da 8310000 (0-71 come sopra, 72-73 maschere dei cue fuori posto).
HSC_SLOT_BASE = 8310000; HSC_SLOT_STRIDE = 76;
function quick_service() local(base, i, seq, cmd, res, pos, n) (
  quick_place_cnt -= 1;
  floor(slider(65) + 0.5) != quick_slot ? quick_place_cnt = 0;
  quick_place_cnt <= 0 ? (
    quick_place_cnt = 8;
    quick_host_chain = 0; quick_host_flags = 0;
    quick_host_track = get_host_placement(quick_host_chain, quick_host_flags);
    // solo FX di traccia/master: per take FX o input FX l'indirizzo non sarebbe univoco
    base = (quick_host_flags & 3) ? -1 : 4096 + ((quick_host_track + 2) * 4096) + (quick_host_chain * 72);
    base >= 8300000 ? base = -1;
    // numero unico assegnato dall'helper (1.8+): indirizzo indipendente da progetto, traccia e posizione
    quick_slot = floor(slider(65) + 0.5);
    quick_slot >= 1 && quick_slot <= 900 && base >= 0 ? base = HSC_SLOT_BASE + quick_slot * HSC_SLOT_STRIDE;
    // maschere dei cue fuori posto: nel blocco del numero unico, o nella zona libera della traccia
    quick_mask_addr = base < 0 ? -1 : (quick_slot >= 1 && quick_slot <= 900) ? base + 72 :
                      quick_host_chain < 32 ? base - quick_host_chain * 72 + 4032 + quick_host_chain * 2 : -1;
    base != quick_gmem_base ? (
      quick_gmem_base = base;
      quick_ext_seen = gmem[HSC_MB+3];
    );
  );
  base = quick_gmem_base;
  base >= 0 ? (
    gmem[base+69] != 905243 ? (
      gmem[base+69] = 905243; gmem[base] = 0; gmem[base+1] = 0; gmem[base+2] = -1; gmem[base+3] = 0;
    );
    gmem[base+4] = quick_point_count;
    i = 0; loop(64, gmem[base+5+i] = i < quick_point_count ? quick_points[i] : -1; i += 1;);
    // con il salto attivo la selezione la decide l'helper (cue rispetto al playhead)
    quick_nav_jump ? (quick_sel = floor(gmem[base+2] + 0.5);) : (gmem[base+2] = quick_sel;);
    // risposta dell'helper ad "aggiungi al cursore" (trasporto fermo)
    quick_wait_seq > 0 ? (
      gmem[base+3] == quick_wait_seq ? (
        gmem[base+70] >= 0 ? quick_toggle_at(gmem[base+70]);
        quick_wait_seq = 0;
      ) : time_precise() - quick_wait_t > 1.5 ? (quick_set_status(8); quick_wait_seq = 0;);
    );
    // azioni da tastiera / helper: solo i comandi indirizzati a questo Carver
    seq = gmem[HSC_MB+3];
    seq != quick_ext_seen ? (
      quick_ext_seen = seq;
      gmem[HSC_MB] == base ? (
        cmd = floor(gmem[HSC_MB+1] + 0.5); pos = gmem[HSC_MB+2]; res = 0;
        cmd == 1 ? (
          quick_toggle_at(pos) ? (
            res = 1;
            (play_state & 1) && abs(pos - play_position) < 0.3 ? quick_fire_ext = 1;
          ) : (res = quick_status == 2 ? 2 : 3;);
        ) : cmd == 4 ? (res = quick_undo();
        ) : cmd == 5 ? (
          // 2.6: l'helper sostituisce l'elenco con i marker #HSC della timeline
          n = max(0, min(64, floor(gmem[HSC_MB+10] + 0.5)));
          quick_point_count = 0; i = 0; loop(64, quick_points[i] = -1; i += 1;);
          i = 0; loop(n, gmem[HSC_MB+11+i] >= 0 ? quick_insert(gmem[HSC_MB+11+i]); i += 1;);
          quick_sel = -1; quick_msel_clear(); res = 9;
        );
        // elenco aggiornato subito, prima dell'ack: l'helper legge cue gia' nuovi
        gmem[base+4] = quick_point_count;
        i = 0; loop(64, gmem[base+5+i] = i < quick_point_count ? quick_points[i] : -1; i += 1;);
        gmem[HSC_MB+5] = res; gmem[HSC_MB+6] = quick_sel + 1; gmem[HSC_MB+7] = quick_point_count; gmem[HSC_MB+4] = seq;
      );
    );
  );
  quick_jump_ok = quick_nav_jump && base >= 0;
  quick_sel >= quick_point_count ? quick_sel = -1;
  quick_service_t = time_precise();
);
quick_wait_seq = 0; quick_wait_t = 0;
quick_inited != 2404 ? (
  quick_inited = 2404;
  quick_point_count = 0; quick_backup_count = 0; quick_nav_jump = 1; quick_sel = -1;
  quick_last_action = 0; quick_last_action_pos = -1; quick_status = 0; quick_status_t = 0; quick_clear_arm_t = -10;
  qpi = 0; loop(128, quick_points[qpi] = -1; qpi += 1;);
  quick_msel_clear();
  // il preascolto non sopravvive alla riapertura del progetto (si rischia di renderizzare il "tolto")
  slider31 = 0;
  quick_gmem_base = -1; quick_place_cnt = 0; quick_ext_seen = 0; quick_slot = -1; quick_mask_addr = -1;
);
quick_request = 0; quick_ui_pos = 0; quick_fire_ext = 0;
quick_total_samples = max(1, floor(0.200 * srate));
quick_samples_left = 0; quick_guard_samples_left = 0; quick_start_gr = 1.0;
quick_carver_start_l = 1.0; quick_carver_start_m = 1.0; quick_carver_start_h = 1.0;
quick_last_event_pos = -1;
last_mouse_cap = 0;
last_click_time = -1;
last_click_sl_idx = -1;
ui_drag_id = 0;
ui_drag_start_y = 0;
ui_drag_start_v = 0;
active_info_id = 0;
bridge_last_alive_tick = -1;
bridge_last_alive_t = 0;
bridge_req_seq = 0;
help_warn_until = 0;
ui_lang = 0;
ui_scroll_y = 0;
ui_max_scroll = 0;
ui_scroll_widgets = 0;
prev_delta_mode = 0;
prev_min_duck = slider23; prev_max_duck = slider24;

os_gr_l=0; os_gr_m=0; os_gr_h=0; os_vca_gr=0; os_fat_gr=0; os_glue_gr=0; os_sc_in=-60; os_delta_l=-60;

speech_env = 0; speech_hold_counter = 0; speech_active = 0; speech_state = 0; speech_was_active = 0;
final_vca_gr = 1.0; target_vca_gr = 1.0; vca_meter_gr = 1.0; vca_meter_db = 0;
vca_return_progress = 1.0; vca_return_start_gr = 1.0; vca_return_samples = max(1, floor(1.600 * srate));
prev_release_mode_gradual = 0; release_mode_just_enabled = 0;
meter_fat_gr = 1.0; fat_active = 0; fat_density_env = 0;
c_freq_l = 250; c_freq_h = 4500;
s_eff_dl = 0; s_eff_dm = 0; s_eff_dh = 0; s_vca_amt = 0;
smooth_tc = exp(-1.0 / (0.025 * srate));

main_vca_env = 0;
main_vca_att = exp(-1.0 / (0.003 * srate));
main_vca_rel = exp(-1.0 / (0.080 * srate));
flat_focus_tc = exp(-1.0 / (0.035 * srate));
flat_t_both = 1; flat_t_carver = 0; flat_t_vca = 0;
flat_mix_both = 1; flat_mix_carver = 0; flat_mix_vca = 0;
vca_constraint_id = 0;

function calc_crossover() local(cf_l, cf_h, nyq_guard) (
  // Defensive clamp for edge-case automation/sample-rate transitions.
  nyq_guard = srate * 0.49;
  cf_l = max(20, min(c_freq_l, nyq_guard - 50));
  cf_h = max(cf_l + 50, min(c_freq_h, nyq_guard));
  g1   = tan($pi * cf_l / srate); a1_1 = 1.0 / (1.0 + g1 * (g1 + 1.41421356)); a2_1 = g1 * a1_1; a3_1 = g1 * a2_1;
  g2   = tan($pi * cf_h / srate); a1_2 = 1.0 / (1.0 + g2 * (g2 + 1.41421356)); a2_2 = g2 * a1_2; a3_2 = g2 * a2_2;
);
function svf_split(sig, st1, st2) local(v3, v1, v2, rest) (
  v3 = sig - st1[1]; v1 = a1_1*st1[0] + a2_1*v3; v2 = st1[1] + a2_1*st1[0] + a3_1*v3; st1[0] = 2*v1 - st1[0]; st1[1] = 2*v2 - st1[1]; _low = v2;
  rest = sig - 1.41421356*v1 - v2; v3 = rest - st2[1]; v1 = a1_2*st2[0] + a2_2*v3; v2 = st2[1] + a2_2*st2[0] + a3_2*v3; st2[0] = 2*v1 - st2[0]; st2[1] = 2*v2 - st2[1]; _mid  = v2; _high = rest - 1.41421356*v1 - v2;
);
function amp2db(v) ( v > 0.00001 ? log2db * log(v) : -60.0; );
function knee_factor(env_db, thr_db, knee_half) local(diff, x) (
  diff = env_db - thr_db;
  knee_half < 0.05 ? (diff >= 0 ? 1 : 0) :
  diff <= -knee_half ? 0 : diff >=  knee_half ? 1 : ( x = (diff + knee_half) / (2.0 * knee_half); x * x * (3.0 - 2.0 * x); );
);
function ui_sy(v) ( ui_scroll_widgets ? (v - ui_scroll_y) : v; );
function notify_slider(sl_idx) local(mask, is_read_only) (
  // Avoid undefined EEL bit shifts on high slider indexes.
  is_read_only = (sl_idx >= 36 && sl_idx <= 49) || sl_idx == 54;
  !is_read_only && sl_idx >= 1 && sl_idx <= 64 ? (
    mask = 2 ^ (sl_idx - 1);
    slider_automate(mask);
  );
);
function ui_neutral_value(sl_idx, min_v, max_v, def_v) (
  (min_v <= 0 && max_v >= 0) ? 0 :
  (sl_idx == 8 || sl_idx == 13 || sl_idx == 14 || sl_idx == 15 || sl_idx == 16 || sl_idx == 19 || sl_idx == 25 || sl_idx == 33) ? 0 :
  def_v;
);
function preset_apply(p) local(k) (
  k = 0; loop(8, slider(preset_sl[k]) = preset_tab[p*8 + k]; notify_slider(preset_sl[k]); k += 1;);
  slider(52) = 0; notify_slider(52);
);
function preset_match(p) local(k, ok) (
  ok = slider(52) == 0; k = 0;
  loop(8, abs(slider(preset_sl[k]) - preset_tab[p*8 + k]) > 0.6 ? ok = 0; k += 1;);
  ok;
);
function draw_gr_bar(bx, by, bw, bh, gr_val, sc_act, lbl)
local(gr_db_v, gh, ah, sy, txt_w, txt_h) (
  sy = ui_sy(by);
  gr_db_v = max(-40.0, log2db * log(max(0.00001, gr_val)));
  gh      = (-gr_db_v / 40.0) * bh;
  gfx_r=0.15; gfx_g=0.15; gfx_b=0.18; gfx_a=1; gfx_rect(bx, sy, bw, bh);
  ah = min(bh, sc_act * bh * 1.4);
  ah > 2 ? ( gfx_r=0.42; gfx_g=0.26; gfx_b=0.60; gfx_a=0.5; gfx_rect(bx, sy + bh - ah, bw, ah); );
  gh > 0 ? ( gfx_r=0.66; gfx_g=0.42; gfx_b=0.88; gfx_a=0.9; gfx_rect(bx, sy, bw, gh); );
  gfx_r=0.3; gfx_g=0.3; gfx_b=0.35; gfx_a=1;
  gfx_rect(bx, sy, bw, 1); gfx_rect(bx, sy+bh-1, bw, 1); gfx_rect(bx, sy, 1, bh); gfx_rect(bx+bw-1, sy, 1, bh);
  gfx_setfont(5); gfx_r=0.9; gfx_g=0.9; gfx_b=0.9; gfx_a=1; sprintf(#gr_txt, "%.1f", gr_db_v); gfx_measurestr(#gr_txt, txt_w, txt_h); gfx_x=bx+(bw-txt_w)*0.5; gfx_y=sy-txt_h-4; gfx_drawstr(#gr_txt);
  gfx_r=0.66; gfx_g=0.42; gfx_b=0.88; gfx_measurestr(lbl, txt_w, txt_h); gfx_x=bx+(bw-txt_w)*0.5; gfx_y=sy+bh+6; gfx_drawstr(lbl);
);

function draw_vca_bar(bx, by, bw, bh, vca_gr)
local(vca_db, fill_h, rel, sy, txt_w, txt_h) (
  sy = ui_sy(by);
  vca_db = max(-24.0, log2db * log(max(0.0001, vca_gr)));
  gfx_r=0.15; gfx_g=0.15; gfx_b=0.18; gfx_a=1; gfx_rect(bx, sy, bw, bh);
  rel = min(1.0, (-vca_db / 24.0));
  fill_h = bh * rel;
  fill_h > 1 ? ( gfx_r=0.88; gfx_g=0.22; gfx_b=0.55; gfx_a=0.9; gfx_rect(bx, sy, bw, fill_h); );
  gfx_r=0.3; gfx_g=0.3; gfx_b=0.35; gfx_a=1;
  gfx_rect(bx, sy, bw, 1); gfx_rect(bx, sy+bh-1, bw, 1); gfx_rect(bx, sy, 1, bh); gfx_rect(bx+bw-1, sy, 1, bh);
  gfx_setfont(5); gfx_r=0.9; gfx_g=0.9; gfx_b=0.9; gfx_a=1; sprintf(#vca_txt, "%.1f", vca_db); gfx_measurestr(#vca_txt, txt_w, txt_h); gfx_x=bx+(bw-txt_w)*0.5; gfx_y=sy-txt_h-4; gfx_drawstr(#vca_txt);
  gfx_r=0.88; gfx_g=0.22; gfx_b=0.55; gfx_measurestr("VCA", txt_w, txt_h); gfx_x=bx+(bw-txt_w)*0.5; gfx_y=sy+bh+6; gfx_drawstr("VCA");
);

calc_crossover();

// ================================================================
@block
zp_bus_refresh(ZP_BUS_ID);
// Space Carver comunica contesto mix; non e' requisito del mastering.
gmem[201] = max(0, -log2db * log(max(0.000001, glue_meter_gr)));
// ================================================================
quick_service();
is_playing = play_state & 1; is_jumping = abs(play_position - last_play_pos) > 0.2;
quick_ui_pos = play_position;
quick_total_samples = max(1, floor(slider(56) * 0.001 * srate));
quick_fire = 0;
quick_fire_ext ? (quick_fire_ext = 0; quick_fire = 1;);
quick_request ? (
  quick_request = 0;
  // in Play: al playhead (e il rientro si sente subito); da fermo lo gestisce la GUI con l'helper
  is_playing ? (quick_toggle_at(play_position) ? quick_fire = 1;);
);
!is_jumping && is_playing ? (
  qpi = 0;
  loop(quick_point_count,
    quick_points[qpi] > last_play_pos && quick_points[qpi] <= play_position ? quick_fire = 1;
    qpi += 1;
  );
);
// dopo un salto (anche il ritorno del loop) scatta il cue che sta proprio sul punto di arrivo
is_jumping && is_playing ? (
  qpi = 0;
  loop(quick_point_count,
    quick_points[qpi] >= play_position - 0.005 && quick_points[qpi] <= play_position + samplesblock / srate ? quick_fire = 2;
    qpi += 1;
  );
);
(is_playing && !was_playing) || is_jumping ? (
  env_l = 0; env_m = 0; env_h = 0; glue_env = 0; glue_gr = 1.0; glue_smooth_gr = 1.0; glue_meter_gr = 1.0; glue_active = 0; sc_rms_env = 0; meter_gr_l = 1.0; meter_gr_m = 1.0; meter_gr_h = 1.0;
  meter_main_l = 0; meter_main_r = 0; meter_sc_l = 0; meter_sc_r = 0;
  meter_out_l = 0; meter_out_r = 0; meter_delta_l = 0; meter_delta_r = 0;
  meter_s1 = 0; meter_s2 = 0; meter_s3 = 0;
  sc_act_l = 0; sc_act_m = 0; sc_act_h = 0;
  speech_env = 0; speech_hold_counter = 0; speech_active = 0; speech_state = 0;
  speech_was_active = 0; vca_return_progress = 1.0; vca_return_start_gr = 1.0; prev_release_mode_gradual = 0; release_mode_just_enabled = 0;
  final_vca_gr = 1.0; target_vca_gr = 1.0; vca_meter_gr = 1.0; vca_meter_db = 0;
  main_vca_env = 0; meter_fat_gr = 1.0; fat_density_env = 0;
  os_gr_l=0; os_gr_m=0; os_gr_h=0; os_vca_gr=0; os_fat_gr=0; os_glue_gr=0; os_sc_in=-60; os_delta_l=-60;
  i_clr = 0; loop(16, i_clr[0] = 0; i_clr += 1;);
);
is_jumping ? (quick_samples_left = 0; quick_guard_samples_left = 0;);
quick_fire ? (
  quick_start_gr = final_vca_gr;
  quick_carver_start_l = gr_l; quick_carver_start_m = gr_m; quick_carver_start_h = gr_h;
  quick_fire == 2 ? (quick_start_gr = 1.0; quick_carver_start_l = 1.0; quick_carver_start_m = 1.0; quick_carver_start_h = 1.0;);
  quick_samples_left = quick_total_samples;
  quick_guard_samples_left = 0;
  quick_last_event_pos = play_position;
);
was_playing = is_playing; last_play_pos = play_position;

slider(31) != prev_delta_mode ? (
  slider(31) > 0 ? ( env_l = 0; env_m = 0; env_h = 0; );
  prev_delta_mode = slider(31);
);

// Lookahead: ritarda la musica (e la voce del Voice Return) e lo dichiara a REAPER come PDC.
// cambio di Anticipo: dissolvenza di 20 ms dal ritardo vecchio al nuovo (niente buco nell'audio)
la_target != la_samples ? (
  la_old = max(0, la_samples); la_samples = la_target;
  la_xf_n = max(1, floor(0.020 * srate)); la_xf = la_xf_n;
);

// Motori: Carver+VCA / solo Carver / solo VCA (interruttori ON nella GUI).
flat_focus_mode = min(2, max(0, floor(slider(52))));
flat_focus_mode == 1 ? ( flat_t_both = 0; flat_t_carver = 1; flat_t_vca = 0;
) : flat_focus_mode == 2 ? ( flat_t_both = 0; flat_t_carver = 0; flat_t_vca = 1;
) : ( flat_t_both = 1; flat_t_carver = 0; flat_t_vca = 0; );

// Valori effettivi: il DSP non scrive sui parametri (le forbici le applica la GUI quando li muovi).
c_freq_l_new = slider(11);
c_freq_h_new = max(slider(12), slider(11) + 50);
(c_freq_l_new != c_freq_l || c_freq_h_new != c_freq_h) ? (
    c_freq_l = c_freq_l_new; c_freq_h = c_freq_h_new; calc_crossover();
);

// Dopo il caricamento di un progetto (segnali da @serialize): preascolto spento e Min Duck sistemato.
listen_reset_pending ? ( slider31 = 0; sliderchange(2 ^ 30); listen_reset_pending = 0; );
duck_migrate ? (
  // progetti salvati prima della 2.6.2: Min = Max (o Min piu' profondo) lasciava il VCA fisso
  slider23 <= slider24 + 0.05 ? ( slider23 = max(slider24, -3); sliderchange(2 ^ 22); );
  duck_migrate = 0;
);

main_gain = exp(slider(2) * db2log);
sc1_g = slider(60) >= 0.5 ? exp(slider(3) * db2log) : 0;
sc2_g = slider(61) >= 0.5 ? exp(slider(58) * db2log) : 0;
sc3_g = slider(62) >= 0.5 ? exp(slider(59) * db2log) : 0;

speech_thr_db = slider(6);
thresh_db = slider(7);
sc_rms_stab_amt = max(0.0, min(1.0, slider(8) / 100.0));
low_depth = slider(13);
mid_depth = slider(14);
high_depth = slider(15);
base_int = slider(16) / 100.0;
vca_amt_tgt = slider(25) / 100.0;
carver_attack_ms = slider(17);
carver_release_ms = slider(18);
spread = slider(19) / 100.0;
clash_thr_db = slider(22);
duck_floor_db = max(slider(23), slider(24));   // Min non piu' profondo di Max (effettivo)
max_red_db = slider(24);
vca_attack_ms = slider(26);
vca_hold_ms = slider(27);
vca_release_ms = slider(28);
glue_amt = slider(33) / 100.0;
wet = slider(35) / 100.0;

speech_thr = exp(speech_thr_db * db2log); thresh_v = exp(thresh_db * db2log);
knee_db = max(0, min(12, slider(64))); knee_half = knee_db * 0.5;

eff_dl_tgt = (low_depth / 100.0) * base_int;
eff_dm_tgt = (mid_depth / 100.0) * base_int;
eff_dh_tgt = (high_depth / 100.0) * base_int;

att_coef = exp(-1.0 / max(0.00001, carver_attack_ms * 0.001 * srate)); rel_coef = exp(-1.0 / max(0.00001, carver_release_ms * 0.001 * srate));
clash_thr_v = exp(clash_thr_db * db2log); base_duck_gr = exp(duck_floor_db * db2log); max_red_gr = exp(max_red_db * db2log);
vca_att_coef = exp(-1.0 / max(0.00001, vca_attack_ms * 0.001 * srate)); speech_hold_samp = max(1, floor(vca_hold_ms * 0.001 * srate)); vca_rel_coef = exp(-1.0 / max(0.00001, vca_release_ms * 0.001 * srate)); vca_return_ms = max(1800.0, vca_release_ms * 5.0 + 400.0); vca_return_samples = max(1, floor(vca_return_ms * 0.001 * srate));
// Detector timing is independent from VCA release: release must not lag by the musical return time.
speech_att_ms = min(vca_attack_ms, 12.0);
speech_rel_ms = 35.0 + sc_rms_stab_amt * 25.0;
speech_att_coef = exp(-1.0 / max(0.00001, speech_att_ms * 0.001 * srate));
speech_rel_coef = exp(-1.0 / max(0.00001, speech_rel_ms * 0.001 * srate));
release_mode_gradual = slider(50) >= 0.5;
release_mode_just_enabled = release_mode_gradual && !prev_release_mode_gradual;
prev_release_mode_gradual = release_mode_gradual;

delta_mode = floor(slider(31));
sc_mix_v = slider(32) <= -120 ? 0.0 : exp(slider(32) * db2log);
out_gain = exp(slider(34) * db2log); dry = 1.0 - wet;

// ================================================================
// AGGIORNAMENTO SLIDER OSARA E METER
// ================================================================
os_sc_in = os_sc_in * 0.85 + amp2db(meter_sc_l) * 0.15;
os_delta_l = os_delta_l * 0.85 + amp2db(meter_delta_l) * 0.15;
os_gr_l = os_gr_l * 0.85 + (log2db * log(max(0.0001, meter_gr_l))) * 0.15;
os_gr_m = os_gr_m * 0.85 + (log2db * log(max(0.0001, meter_gr_m))) * 0.15;
os_gr_h = os_gr_h * 0.85 + (log2db * log(max(0.0001, meter_gr_h))) * 0.15;
os_vca_gr = os_vca_gr * 0.85 + (log2db * log(max(0.0001, vca_meter_gr))) * 0.15;
os_fat_gr = os_fat_gr * 0.85 + (log2db * log(max(0.0001, meter_fat_gr))) * 0.15;
os_glue_gr = os_glue_gr * 0.85 + (log2db * log(max(0.0001, glue_meter_gr))) * 0.15;

// Read-only meters: direct slider writes only, no automation events.
slider38 = os_sc_in; slider46 = os_delta_l;
slider42 = os_gr_l; slider43 = os_gr_m; slider44 = os_gr_h;
slider45 = os_vca_gr; slider49 = os_fat_gr; slider54 = os_glue_gr;

slider36 = amp2db(meter_main_l); slider37 = amp2db(meter_main_r); slider39 = amp2db(meter_sc_r);
slider40 = amp2db(meter_out_l); slider41 = amp2db(meter_out_r); slider47 = amp2db(meter_delta_r);

// ================================================================
@slider
// Anticipo (lookahead): latenza dichiarata a REAPER, che la compensa come per ogni plugin.
la_target = min(LA_SIZE - 1, floor(max(0, min(20, slider63)) * 0.001 * srate));
pdc_delay = la_target; pdc_bot_ch = 0; pdc_top_ch = 2;

// ================================================================
@sample
// ================================================================
srate != last_srate ? (
  calc_crossover();
  att_coef = exp(-1.0 / max(0.00001, carver_attack_ms * 0.001 * srate)); rel_coef = exp(-1.0 / max(0.00001, carver_release_ms * 0.001 * srate));
  speech_hold_samp = max(1, floor(vca_hold_ms * 0.001 * srate));
  vca_att_coef = exp(-1.0 / max(0.00001, vca_attack_ms * 0.001 * srate)); vca_rel_coef = exp(-1.0 / max(0.00001, vca_release_ms * 0.001 * srate)); vca_return_ms = max(1800.0, vca_release_ms * 5.0 + 400.0); vca_return_samples = max(1, floor(vca_return_ms * 0.001 * srate));
  speech_att_ms = min(vca_attack_ms, 12.0);
  speech_rel_ms = 35.0 + sc_rms_stab_amt * 25.0;
  speech_att_coef = exp(-1.0 / max(0.00001, speech_att_ms * 0.001 * srate));
  speech_rel_coef = exp(-1.0 / max(0.00001, speech_rel_ms * 0.001 * srate)); smooth_tc = exp(-1.0 / (0.025 * srate));
  main_vca_att = exp(-1.0 / (0.003 * srate));
  main_vca_rel = exp(-1.0 / (0.080 * srate));
  flat_focus_tc = exp(-1.0 / (0.035 * srate));
  last_srate = srate;
);

s_eff_dl = s_eff_dl * smooth_tc + eff_dl_tgt * (1.0 - smooth_tc); s_eff_dm = s_eff_dm * smooth_tc + eff_dm_tgt * (1.0 - smooth_tc);
s_eff_dh = s_eff_dh * smooth_tc + eff_dh_tgt * (1.0 - smooth_tc); s_vca_amt = s_vca_amt * smooth_tc + vca_amt_tgt * (1.0 - smooth_tc);

// Sidechain: somma delle fonti accese (3/4, 5/6, 7/8) con il loro guadagno.
s1a = max(abs(spl2), abs(spl3)) * sc1_g; s1a > meter_s1 ? (meter_s1 = s1a) : (meter_s1 *= DECAY);
s2a = max(abs(spl4), abs(spl5)) * sc2_g; s2a > meter_s2 ? (meter_s2 = s2a) : (meter_s2 *= DECAY);
s3a = max(abs(spl6), abs(spl7)) * sc3_g; s3a > meter_s3 ? (meter_s3 = s3a) : (meter_s3 *= DECAY);
scL = spl2 * sc1_g + spl4 * sc2_g + spl6 * sc3_g;
scR = spl3 * sc1_g + spl5 * sc2_g + spl7 * sc3_g;

// Linea di ritardo sempre attiva (con Anticipo 0 legge il campione appena scritto).
la_mL[la_w] = spl0 * main_gain; la_mR[la_w] = spl1 * main_gain; la_sL[la_w] = scL; la_sR[la_w] = scR;
la_rd = la_w - max(0, la_samples); la_rd < 0 ? la_rd += LA_SIZE;
inL = la_mL[la_rd]; inR = la_mR[la_rd]; retL = la_sL[la_rd]; retR = la_sR[la_rd];
la_xf > 0 ? (
  la_g = la_xf / la_xf_n;
  la_ro = la_w - la_old; la_ro < 0 ? la_ro += LA_SIZE;
  inL = inL * (1 - la_g) + la_mL[la_ro] * la_g; inR = inR * (1 - la_g) + la_mR[la_ro] * la_g;
  retL = retL * (1 - la_g) + la_sL[la_ro] * la_g; retR = retR * (1 - la_g) + la_sR[la_ro] * la_g;
  la_xf -= 1;
);
la_w += 1; la_w >= LA_SIZE ? la_w = 0;

// ------------------------------------------------
// SC RMS STABILIZ. (pre-detection, non comprime il sidechain audio)
// ------------------------------------------------
sc_rms_in = sqrt(0.5 * (scL*scL + scR*scR));
sc_rms_ms = 4.0 + sc_rms_stab_amt * 140.0;
sc_rms_coef = exp(-1.0 / max(0.00001, sc_rms_ms * 0.001 * srate));
sc_rms_env = sc_rms_coef * sc_rms_env + (1.0 - sc_rms_coef) * sc_rms_in;
sc_rms_mix = sc_rms_in * (1.0 - sc_rms_stab_amt) + sc_rms_env * sc_rms_stab_amt;
sc_rms_det = min(sc_rms_in, sc_rms_mix);
sc_det_gain = sc_rms_det / max(sc_rms_in, 0.000001);
sc_det_L = scL * sc_det_gain;
sc_det_R = scR * sc_det_gain;

// Nel silenzio il guadagno del detector non significa niente: la lettura resta a 0 dB.
fat_gr_inst = sc_rms_in > 0.0001 ? min(1.0, sc_det_gain) : 1.0;
meter_fat_gr = fat_gr_inst < meter_fat_gr
  ? (meter_fat_gr * 0.88 + fat_gr_inst * 0.12)
  : (meter_fat_gr * 0.992 + fat_gr_inst * 0.008);

det_sc_abs = sc_rms_det;
det_sc_abs > fat_density_env ? (
  fat_density_env = fat_density_env * 0.92 + det_sc_abs * 0.08;
) : (
  fat_density_env = fat_density_env * 0.995 + det_sc_abs * 0.005;
);

raw_sc_pk = sc_rms_det;
raw_sc_pk > speech_env ? ( speech_env = speech_att_coef * speech_env + (1.0 - speech_att_coef) * raw_sc_pk;
) : ( speech_env = speech_rel_coef * speech_env + (1.0 - speech_rel_coef) * raw_sc_pk; );

speech_env > speech_thr ? ( speech_hold_counter = speech_hold_samp; speech_active = 1; speech_state = 1;
) : ( speech_hold_counter = max(0, speech_hold_counter - 1);
  speech_hold_counter > 0 ? ( speech_active = 1; speech_state = 2; ) : ( speech_active = 0; speech_state = 0; ); );
speech_just_released = speech_was_active && !speech_active;
speech_just_started = !speech_was_active && speech_active;

// ------------------------------------------------
// CARVER MULTIBANDA
// ------------------------------------------------
svf_split(inL, 0,  2); mL_lo=_low; mL_md=_mid; mL_hi=_high;
svf_split(inR, 4,  6); mR_lo=_low; mR_md=_mid; mR_hi=_high;

svf_split(sc_det_L, 8,  10); sL_lo=_low; sL_md=_mid; sL_hi=_high;
svf_split(sc_det_R, 12, 14); sR_lo=_low; sR_md=_mid; sR_hi=_high;

det_l = sqrt(0.5 * (sL_lo*sL_lo + sR_lo*sR_lo)); det_l > env_l ? (env_l = att_coef*env_l + (1-att_coef)*det_l) : (env_l = rel_coef*env_l + (1-rel_coef)*det_l);
det_m = sqrt(0.5 * (sL_md*sL_md + sR_md*sR_md)); det_m > env_m ? (env_m = att_coef*env_m + (1-att_coef)*det_m) : (env_m = rel_coef*env_m + (1-rel_coef)*det_m);
det_h = sqrt(0.5 * (sL_hi*sL_hi + sR_hi*sR_hi)); det_h > env_h ? (env_h = att_coef*env_h + (1-att_coef)*det_h) : (env_h = rel_coef*env_h + (1-rel_coef)*det_h);

env_l_db = amp2db(env_l); env_m_db = amp2db(env_m); env_h_db = amp2db(env_h);
k_l = knee_factor(env_l_db, thresh_db, knee_half); k_m = knee_factor(env_m_db, thresh_db, knee_half); k_h = knee_factor(env_h_db, thresh_db, knee_half);
raw_l = env_l > thresh_v ? (1.0 - thresh_v/env_l) : 0.0; raw_m = env_m > thresh_v ? (1.0 - thresh_v/env_m) : 0.0; raw_h = env_h > thresh_v ? (1.0 - thresh_v/env_h) : 0.0;

gr_l = max(0.0001, 1.0 - (raw_l * s_eff_dl * k_l)); gr_m = max(0.0001, 1.0 - (raw_m * s_eff_dm * k_m)); gr_h = max(0.0001, 1.0 - (raw_h * s_eff_dh * k_h));

spread > 0 ? ( r_l=gr_l; r_m=gr_m; r_h=gr_h; sp2=spread*0.5;
  gr_l = max(0.0001, r_l*(1-spread) + r_m*sp2 + r_h*sp2); gr_m = max(0.0001, r_m*(1-spread) + r_l*sp2 + r_h*sp2); gr_h = max(0.0001, r_h*(1-spread) + r_l*sp2 + r_m*sp2); );
quick_samples_left > 0 ? (
  quick_t = min(1.0, (quick_total_samples - quick_samples_left + 1) / max(1, quick_total_samples));
  gr_l = quick_carver_start_l + (1.0 - quick_carver_start_l) * quick_t;
  gr_m = quick_carver_start_m + (1.0 - quick_carver_start_m) * quick_t;
  gr_h = quick_carver_start_h + (1.0 - quick_carver_start_h) * quick_t;
) : quick_guard_samples_left > 0 ? (gr_l = 1.0; gr_m = 1.0; gr_h = 1.0;);

procL = inL + mL_lo*(gr_l - 1.0) + mL_md*(gr_m - 1.0) + mL_hi*(gr_h - 1.0);
procR = inR + mR_lo*(gr_l - 1.0) + mR_md*(gr_m - 1.0) + mR_hi*(gr_h - 1.0);
carvL = procL; carvR = procR;
vca_constraint_id = 0;

// ------------------------------------------------
// VCA MAIN ENVELOPE
// ------------------------------------------------
main_pk = max(abs(inL), abs(inR));
main_pk > main_vca_env ? ( main_vca_env = main_vca_att * main_vca_env + (1.0 - main_vca_att) * main_pk;
) : ( main_vca_env = main_vca_rel * main_vca_env + (1.0 - main_vca_rel) * main_pk; );

target_vca_gr = 1.0;
dbg_ceiling_gr = 1.0; dbg_after_prio_gr = 1.0; dbg_after_floor_gr = 1.0; dbg_after_max_gr = 1.0;
s_vca_amt > 0 ? (
  tot_main = main_vca_env;
  speech_active ? (
    tot_main > clash_thr_v ? ( target_vca_gr = clash_thr_v / max(0.0001, tot_main); vca_constraint_id = 1;
    ) : ( target_vca_gr = 1.0; );
    dbg_ceiling_gr = target_vca_gr;
    target_vca_gr = 1.0 - ((1.0 - target_vca_gr) * s_vca_amt);
    dbg_after_prio_gr = target_vca_gr;
    target_vca_gr > base_duck_gr ? ( target_vca_gr = base_duck_gr; vca_constraint_id = 2; );
    dbg_after_floor_gr = target_vca_gr;
  );
  target_vca_gr < max_red_gr ? ( target_vca_gr = max_red_gr; vca_constraint_id = 3; );
  target_vca_gr = max(0.0001, target_vca_gr);
  dbg_after_max_gr = target_vca_gr;

  speech_just_started ? vca_return_progress = 1.0;
  quick_samples_left > 0 ? (
    quick_t = min(1.0, (quick_total_samples - quick_samples_left + 1) / max(1, quick_total_samples));
    final_vca_gr = quick_start_gr + (1.0 - quick_start_gr) * quick_t;
    quick_samples_left -= 1;
    quick_samples_left <= 0 ? (final_vca_gr = 1.0; quick_guard_samples_left = floor(max(0, slider(57)) * 0.001 * srate););
  ) : quick_guard_samples_left > 0 ? (
    final_vca_gr = 1.0;
    quick_guard_samples_left -= 1;
  ) : speech_active ? (
    target_vca_gr < final_vca_gr ? ( final_vca_gr = vca_att_coef * final_vca_gr + (1.0 - vca_att_coef) * target_vca_gr;
    ) : ( final_vca_gr = vca_rel_coef * final_vca_gr + (1.0 - vca_rel_coef) * target_vca_gr; );
  ) : release_mode_gradual ? (
    (speech_just_released || (release_mode_just_enabled && final_vca_gr < 0.999)) ? (
      vca_return_progress = 0.0;
      vca_return_start_gr = final_vca_gr;
      release_mode_just_enabled = 0;
    );
    vca_return_progress = min(1.0, vca_return_progress + (1.0 / vca_return_samples));
    // Gradual return: linear long ramp, clearly slower than STD and no acceleration.
    return_shape = vca_return_progress;
    final_vca_gr = vca_return_start_gr + (target_vca_gr - vca_return_start_gr) * return_shape;
  ) : (
    final_vca_gr = vca_rel_coef * final_vca_gr + (1.0 - vca_rel_coef) * target_vca_gr;
  );
  vca_carvL = carvL * final_vca_gr; vca_carvR = carvR * final_vca_gr;
  vca_rawL = inL * final_vca_gr; vca_rawR = inR * final_vca_gr;
) : ( final_vca_gr = 1.0; target_vca_gr = 1.0; );

s_vca_amt <= 0 ? (
  vca_carvL = carvL; vca_carvR = carvR;
  vca_rawL = inL; vca_rawR = inR;
);

flat_mix_both = flat_mix_both * flat_focus_tc + flat_t_both * (1.0 - flat_focus_tc);
flat_mix_carver = flat_mix_carver * flat_focus_tc + flat_t_carver * (1.0 - flat_focus_tc);
flat_mix_vca = flat_mix_vca * flat_focus_tc + flat_t_vca * (1.0 - flat_focus_tc);
flat_mix_sum = max(0.0001, flat_mix_both + flat_mix_carver + flat_mix_vca);
procL = (vca_carvL * flat_mix_both + carvL * flat_mix_carver + vca_rawL * flat_mix_vca) / flat_mix_sum;
procR = (vca_carvR * flat_mix_both + carvR * flat_mix_carver + vca_rawR * flat_mix_vca) / flat_mix_sum;

carver_returning = (gr_l < 0.999) || (gr_m < 0.999) || (gr_h < 0.999) || (meter_gr_l < 0.999) || (meter_gr_m < 0.999) || (meter_gr_h < 0.999);
vca_returning = final_vca_gr < 0.999;
glue_authorized = speech_active || (speech_state > 0) || carver_returning || vca_returning;
(quick_samples_left > 0 || quick_guard_samples_left > 0) ? glue_authorized = 0;
glue_gr = 1.0; glue_active = 0;
glue_drive = max(max(max(1.0 - gr_l, 1.0 - gr_m), 1.0 - gr_h), 1.0 - final_vca_gr);
glue_target_gr = 1.0;
glue_amt > 0 && glue_authorized ? (
  // Slow return glue: sidechain-authorized polish, not peak compression of the music.
  glue_target_gr = max(0.92, 1.0 - glue_amt * min(1.0, glue_drive * 2.0) * 0.10);
  glue_coef = exp(-1.0 / max(0.00001, 0.250 * srate));
  glue_smooth_gr = glue_coef * glue_smooth_gr + (1.0 - glue_coef) * glue_target_gr;
) : (
  glue_smooth_gr = 1.0;
);
glue_gr = glue_smooth_gr;
glue_gr < 0.999 ? ( procL *= glue_gr; procR *= glue_gr; glue_active = 1; );
glue_meter_gr = glue_gr < glue_meter_gr ? (glue_meter_gr * 0.85 + glue_gr * 0.15) : (glue_meter_gr * 0.995 + glue_gr * 0.005);

// Uscita vera (quella che misurano i LIVELLI anche durante il preascolto).
outL = (inL*dry + procL*wet) * out_gain + retL * sc_mix_v;
outR = (inR*dry + procR*wet) * out_gain + retR * sc_mix_v;

// PREASCOLTO: OFF / CARVER / VCA / TUTTO (solo cio' che viene tolto)
carver_removed_L = inL - carvL;
carver_removed_R = inR - carvR;
vca_removed_L = carvL - vca_carvL;
vca_removed_R = carvR - vca_carvR;
all_removed_L = inL - procL;
all_removed_R = inR - procR;
delta_mode == 1 ? ( deltaL = carver_removed_L; deltaR = carver_removed_R;
) : delta_mode == 2 ? ( deltaL = vca_removed_L; deltaR = vca_removed_R;
) : ( deltaL = all_removed_L; deltaR = all_removed_R; );

delta_mode > 0 ? ( finalL = deltaL * out_gain; finalR = deltaR * out_gain; ) : ( finalL = outL; finalR = outR; );

spl0 = finalL; spl1 = finalR;

abs(inL) > meter_main_l ? meter_main_l=abs(inL) : meter_main_l*=DECAY;
abs(inR) > meter_main_r ? meter_main_r=abs(inR) : meter_main_r*=DECAY;
abs(sc_det_L) > meter_sc_l ? meter_sc_l=abs(sc_det_L) : meter_sc_l*=DECAY;
abs(sc_det_R) > meter_sc_r ? meter_sc_r=abs(sc_det_R) : meter_sc_r*=DECAY;
abs(outL) > meter_out_l ? meter_out_l=abs(outL) : meter_out_l*=DECAY;
abs(outR) > meter_out_r ? meter_out_r=abs(outR) : meter_out_r*=DECAY;
abs(deltaL) > meter_delta_l ? meter_delta_l=abs(deltaL) : meter_delta_l*=DECAY;
abs(deltaR) > meter_delta_r ? meter_delta_r=abs(deltaR) : meter_delta_r*=DECAY;

meter_gr_l = gr_l < meter_gr_l ? gr_l : meter_gr_l*0.985 + gr_l*0.015;
meter_gr_m = gr_m < meter_gr_m ? gr_m : meter_gr_m*0.985 + gr_m*0.015;
meter_gr_h = gr_h < meter_gr_h ? gr_h : meter_gr_h*0.985 + gr_h*0.015;
vca_meter_gr = final_vca_gr < vca_meter_gr ? (vca_meter_gr * 0.85  + final_vca_gr * 0.15) : (vca_meter_gr * 0.995 + final_vca_gr * 0.005);

sc_act_l = max(env_l / max(0.0001, thresh_v), sc_act_l * 0.9998);
sc_act_m = max(env_m / max(0.0001, thresh_v), sc_act_m * 0.9998);
sc_act_h = max(env_h / max(0.0001, thresh_v), sc_act_h * 0.9998);

buf_main_L[w_pos] = inL;
// Scope: voce sidechain processata (quella vera usata dal detector)
buf_sc_L[w_pos]   = sc_det_L;
buf_out_L[w_pos]  = finalL;
w_pos += 1;
w_pos >= BUF_SIZE ? w_pos = 0;

speech_was_active = speech_active;

// ================================================================
@serialize
quick_serialize_version = 2602;
file_avail(0) >= 0 ? (
  // caricamento (progetto, undo, preset): il preascolto riparte spento
  listen_reset_pending = 1;
  file_avail(0) > 0 ? (
    file_var(0, quick_serialize_version);
    quick_serialize_version < 2602 ? duck_migrate = 1;
    quick_serialize_version >= 2402 && quick_serialize_version <= 2602 ? (
      file_var(0, quick_point_count);
      quick_point_count = max(0, min(64, floor(quick_point_count)));
      qpi = 0;
      loop(quick_point_count, file_var(0, quick_points[qpi]); qpi += 1;);
      quick_serialize_version >= 2403 ? (
        file_var(0, quick_last_action);
        file_var(0, quick_last_action_pos);
        quick_last_action = max(0, min(2, floor(quick_last_action)));
      ) : (quick_last_action = 0; quick_last_action_pos = -1;);
      quick_serialize_version >= 2404 ? (file_var(0, quick_nav_jump); quick_nav_jump = quick_nav_jump ? 1 : 0;) : (quick_nav_jump = 1;);
      quick_sort(); quick_sel = -1; quick_backup_count = 0; quick_msel_clear();
    ) : (quick_point_count = 0; quick_last_action = 0; quick_last_action_pos = -1;);
  ) : (quick_point_count = 0; quick_last_action = 0; quick_last_action_pos = -1;);
) : (
  file_var(0, quick_serialize_version);
  file_var(0, quick_point_count);
  qpi = 0;
  loop(quick_point_count, file_var(0, quick_points[qpi]); qpi += 1;);
  quick_la_w = quick_last_action == 3 ? 0 : quick_last_action;   // "cancella tutti" si annulla solo in sessione
  file_var(0, quick_la_w);
  file_var(0, quick_last_action_pos);
  file_var(0, quick_nav_jump);
);

@gfx 900 700
// ================================================================

gfx_getchar(); // GUI JSFX: refresh keyboard modifiers used by mouse_cap.
show_simple = floor(slider(4)) == 0;
view_mode = min(1, floor(slider(51)));
DOCK_H = 150;
gfx_layout_init != 1 ? (
  view_mode == 1 ? ( gfx_w = 900; gfx_h = DOCK_H; ) : ( gfx_w < 900 ? gfx_w = 900; gfx_h < 700 ? gfx_h = 700; );
  gfx_layout_init = 1;
  last_view_mode_ui = view_mode;
) : (
  view_mode == 1 ? (
    (gfx_w != 900 || gfx_h != DOCK_H) ? ( gfx_w = 900; gfx_h = DOCK_H; );
  ) : (
    last_view_mode_ui == 1 ? ( gfx_w < 900 ? gfx_w = 900; gfx_h < 700 ? gfx_h = 700; );
  );
  last_view_mode_ui = view_mode;
);
show_simple ? ( gfx_r=0.92; gfx_g=0.94; gfx_b=0.97; gfx_a=1; ) : ( gfx_r=0.08; gfx_g=0.08; gfx_b=0.09; gfx_a=1; );
gfx_rect(0, 0, gfx_w, gfx_h);

// GUI typography fixed to TXT 1: two sizes only, body and section title.
slider(55) = 0;
ui_room_scale = min(1.08, max(1.0, gfx_w / 980.0));
ui_font_base = max(15.0, min(17.0, 15.0 * ui_room_scale));
ui_font_small = ui_font_base;
ui_font_label = ui_font_base;
ui_font_title = max(18.0, min(20.0, 18.0 * ui_room_scale));
gfx_setfont(1, "Arial", ui_font_base);
gfx_setfont(2, "Arial", ui_font_title, 'b');
gfx_setfont(3, "Arial", ui_font_label, 'b');
gfx_setfont(4, "Arial", ui_font_base, 'b');
gfx_setfont(5, "Arial", ui_font_small - 2, 'b');

mouse_down = mouse_cap & 1; mouse_click = mouse_down && !(last_mouse_cap & 1);
mouse_right_click = (mouse_cap & 2) && !(last_mouse_cap & 2);
fine_tune = (mouse_cap & 8) ? 0.05 : 1.0;
active_info_id = 0;
ui_scroll_widgets = 0;
ui_dark_panel = 0;
quick_now = time_precise();

// Polling ponte Cue Navigator (gmem 3900-3919)
b_tick = gmem[3900];
b_tick != bridge_last_alive_tick ? (
  bridge_last_alive_tick = b_tick;
  bridge_last_alive_t = quick_now;
);
bridge_alive = (bridge_last_alive_t > 0 && quick_now - bridge_last_alive_t <= 3.0);
ui_lang = bridge_alive ? floor(gmem[3901] + 0.5) : 0;

// se @block non gira (trasporto fermo senza elaborazione) il servizio dei cue lo fa la GUI
quick_now - quick_service_t > 0.5 ? quick_service();

// JSFX-safe wheel handling: consume the delta each gfx pass.
wheel_delta = mouse_wheel;
mouse_wheel = 0;
debug_enabled = (slider(53) >= 0.5);
footer_h = view_mode == 0 ? (debug_enabled ? max(64, ui_font_base * 4.0) : max(42, ui_font_base * 2.55)) : 0;
footer_y = gfx_h - footer_h;
content_bottom = show_simple ? 560 : 612;
ui_max_scroll = view_mode == 0 ? max(0, content_bottom - footer_y) : 0;
view_mode == 0 ? (
  ui_scroll_y -= wheel_delta * 0.45;
  ui_scroll_y < 0 ? ui_scroll_y = 0;
  ui_scroll_y > ui_max_scroll ? ui_scroll_y = ui_max_scroll;
) : ( ui_scroll_y = 0; );

// Fonti sidechain legate al routing vero. Senza helper: solo i canali della traccia (num_ch).
// Con l'helper Cue Navigator (1.3+): gmem base+71 = 64 + per fonte (pin collegati + 2 * alimentata) * 4^i.
// Stato: 0 non disponibile, 1 ok, 2 segnale ma spenta, 3 accesa senza invio, 4 pin scollegati,
//        5 spenta, 6 accesa non verificata, 7 accesa ma la traccia non ha i canali.
sc_stat = 8440;
sc_hv = quick_gmem_base >= 0 ? gmem[quick_gmem_base+71] : 0;
sc_hv >= 64 ? (sc_route_v = sc_hv; sc_route_t = quick_now; gmem[quick_gmem_base+71] = 0;);
sc_route_fresh = sc_route_v >= 64 && quick_now - sc_route_t < 2.5;
sc_problem = 0;
i = 0;
loop(3,
  sc_bits = sc_route_fresh ? floor((sc_route_v - 64) / (4 ^ i)) % 4 : 0;
  sc_p = sc_bits & 1; sc_f = (sc_bits & 2) > 0;
  sc_av = sc_route_fresh ? (sc_p || num_ch >= 4 + 2 * i) : num_ch >= 4 + 2 * i;
  sc_on = slider(60 + i) >= 0.5;
  sc_stat[i] = !sc_av ? (sc_on ? 7 : 0) : (sc_route_fresh && !sc_p) ? 4 :
               sc_on ? (sc_route_fresh ? (sc_f ? 1 : 3) : 6) : ((sc_route_fresh && sc_f) ? 2 : 5);
  sc_on && (sc_stat[i] == 3 || sc_stat[i] == 4 || sc_stat[i] == 7) ? sc_problem = 1;
  i == 0 ? strcpy(#scn, "SC1") : i == 1 ? strcpy(#scn, "SC2") : strcpy(#scn, "SC3");
  i == 0 ? strcpy(#scc, "3/4") : i == 1 ? strcpy(#scc, "5/6") : strcpy(#scc, "7/8");
  ui_lang == 1 ? (
    sc_stat[i] == 1 ? sprintf(#sc_tmp, "%s: connected and receiving (send or folder child on channels %s).", #scn, #scc) :
    sc_stat[i] == 2 ? sprintf(#sc_tmp, "%s: signal on channels %s but source disabled. Press %s to use.", #scn, #scc, #scn) :
    sc_stat[i] == 3 ? sprintf(#sc_tmp, "%s active but no send or folder child on channels %s: check routing.", #scn, #scc) :
    sc_stat[i] == 4 ? sprintf(#sc_tmp, "%s: plugin pins not connected to track channels (plugin I/O).", #scn) :
    sc_stat[i] == 6 ? sprintf(#sc_tmp, "%s active. Routing unverified: Cue Navigator helper not running.", #scn) :
    sc_stat[i] == 7 ? sprintf(#sc_tmp, "%s active but track has %d channels: %d required (I/O, Track channels).", #scn, num_ch, 4 + 2 * i) :
    sprintf(#sc_tmp, "%s disabled. Field sets input gain.", #scn);
  ) : (
    sc_stat[i] == 1 ? sprintf(#sc_tmp, "%s: collegata e alimentata (invio o traccia figlia sui canali %s).", #scn, #scc) :
    sc_stat[i] == 2 ? sprintf(#sc_tmp, "%s: arriva segnale sui canali %s ma la fonte e' spenta. Premi %s per usarla.", #scn, #scc, #scn) :
    sc_stat[i] == 3 ? sprintf(#sc_tmp, "%s accesa ma nessun invio o traccia figlia arriva sui canali %s: controlla il routing.", #scn, #scc) :
    sc_stat[i] == 4 ? sprintf(#sc_tmp, "%s: i pin del plugin non sono collegati ai canali della traccia (pulsante I/O del plugin).", #scn) :
    sc_stat[i] == 6 ? sprintf(#sc_tmp, "%s accesa. Routing non verificato: l'helper Cue Navigator non e' in esecuzione.", #scn) :
    sc_stat[i] == 7 ? sprintf(#sc_tmp, "%s accesa ma la traccia ha %d canali: ne servono %d (pulsante I/O, Track channels).", #scn, num_ch, 4 + 2 * i) :
    sprintf(#sc_tmp, "%s spenta. Il campo e' il guadagno della fonte.", #scn);
  );
  i == 0 ? strcpy(#sc_msg0, #sc_tmp) : i == 1 ? strcpy(#sc_msg1, #sc_tmp) : strcpy(#sc_msg2, #sc_tmp);
  i += 1;
);
fat_density_disp = min(1.0, fat_density_env / max(0.0001, speech_thr));
fat_db_disp = log2db * log(max(0.0001, meter_fat_gr));
carve_db_disp = max(0, -((slider42 + slider43 + slider44) / 3.0));
duck_db_disp = max(0, -slider45);
quick_status != 0 && quick_now - quick_status_t > 2.5 ? quick_status = 0;
quick_now - quick_clear_arm_t > 3 ? quick_clear_arm_t = -10;

function ui_hit(x, y, w, h) local(my) (
  my = ui_scroll_widgets ? (mouse_y + ui_scroll_y) : mouse_y;
  mouse_x >= x && mouse_x <= x + w && my >= y && my <= y + h;
);

function ui_tab_button(sl_idx, target_val, bx, by, bw, bh, label, info_id) local(val, is_active, is_hover, tw, th, sy, button_font) (
  val = slider(sl_idx);
  bh = max(bh, ui_font_small + 6);
  is_active = (val == target_val);
  sy = ui_sy(by);
  is_hover = ui_hit(bx, by, bw, bh);
  is_hover ? active_info_id = info_id;
  is_hover && mouse_click ? ( slider(sl_idx) = target_val; notify_slider(sl_idx); );
  show_simple && !ui_dark_panel ? (
    gfx_r=0.82; gfx_g=0.86; gfx_b=0.91; gfx_a=1;
    is_active ? ( gfx_r=0.32; gfx_g=0.67; gfx_b=0.83; ) : is_hover ? ( gfx_r=0.74; gfx_g=0.79; gfx_b=0.85; );
    is_active && sl_idx == 31 && target_val > 0 ? ( gfx_r=0.96; gfx_g=0.72; gfx_b=0.22; );
  ) : (
    gfx_r=0.15; gfx_g=0.15; gfx_b=0.18; gfx_a=1;
    is_active ? ( gfx_r=0.14; gfx_g=0.72; gfx_b=0.83; ) : is_hover ? ( gfx_r=0.22; gfx_g=0.22; gfx_b=0.26; );
    is_active && sl_idx == 31 && target_val > 0 ? ( gfx_r=0.92; gfx_g=0.65; gfx_b=0.10; );
  );
  gfx_rect(bx, sy, bw, bh);
  show_simple && !ui_dark_panel ? (gfx_r=0.62; gfx_g=0.68; gfx_b=0.75;) : (gfx_r=0.3; gfx_g=0.3; gfx_b=0.3;);
  gfx_line(bx, sy, bx+bw, sy); gfx_line(bx, sy, bx, sy+bh);
  button_font = 3; gfx_setfont(button_font); gfx_measurestr(label, tw, th);
  (tw > bw - 6 || bh < ui_font_label + 6) ? ( gfx_setfont(5); gfx_measurestr(label, tw, th); );
  is_active ? (gfx_r=0.05; gfx_g=0.05; gfx_b=0.06;) :
              show_simple && !ui_dark_panel ? (gfx_r=0.28; gfx_g=0.31; gfx_b=0.35;) : (gfx_r=0.7; gfx_g=0.7; gfx_b=0.7;);
  gfx_x = bx + (bw-tw)/2; gfx_y = sy + (bh-th)/2; gfx_drawstr(label);
);

// Pulsante d'azione. state: 0 normale, 1 acceso (ciano), 2 allarme (rosso), 3 arancio.
function ui_cue_button(bx, by, bw, bh, label, state, enabled, info_id) local(is_hover, tw, th, sy, clicked, light) (
  sy = ui_sy(by);
  light = show_simple && !ui_dark_panel;
  is_hover = ui_hit(bx, by, bw, bh);
  is_hover ? active_info_id = info_id;
  clicked = is_hover && mouse_click && enabled;
  gfx_a = 1;
  light ? (
    !enabled ? ( gfx_r=0.86; gfx_g=0.88; gfx_b=0.91; ) :
    state == 2 ? ( gfx_r=0.84; gfx_g=0.30; gfx_b=0.26; ) :
    state == 3 ? ( gfx_r=0.96; gfx_g=0.72; gfx_b=0.22; ) :
    state == 1 ? ( gfx_r=0.32; gfx_g=0.67; gfx_b=0.83; ) :
    is_hover ? ( gfx_r=0.74; gfx_g=0.79; gfx_b=0.85; ) : ( gfx_r=0.82; gfx_g=0.86; gfx_b=0.91; );
  ) : (
    !enabled ? ( gfx_r=0.10; gfx_g=0.10; gfx_b=0.12; ) :
    state == 2 ? ( gfx_r=0.78; gfx_g=0.22; gfx_b=0.18; ) :
    state == 3 ? ( gfx_r=0.92; gfx_g=0.65; gfx_b=0.10; ) :
    state == 1 ? ( gfx_r=0.14; gfx_g=0.72; gfx_b=0.83; ) :
    is_hover ? ( gfx_r=0.22; gfx_g=0.22; gfx_b=0.26; ) : ( gfx_r=0.15; gfx_g=0.15; gfx_b=0.18; );
  );
  gfx_rect(bx, sy, bw, bh);
  light ? (gfx_r=0.62; gfx_g=0.68; gfx_b=0.75;) : (gfx_r=0.3; gfx_g=0.3; gfx_b=0.3;);
  gfx_line(bx, sy, bx+bw, sy); gfx_line(bx, sy, bx, sy+bh);
  gfx_setfont(3);
  gfx_measurestr(label, tw, th);
  (tw > bw - 8 || bh < 22) ? ( gfx_setfont(5); gfx_measurestr(label, tw, th); );
  light ? (
    !enabled ? ( gfx_r=0.62; gfx_g=0.66; gfx_b=0.70; ) : state > 0 ? ( gfx_r=0.05; gfx_g=0.07; gfx_b=0.09; ) : ( gfx_r=0.24; gfx_g=0.28; gfx_b=0.33; );
  ) : (
    !enabled ? ( gfx_r=0.38; gfx_g=0.38; gfx_b=0.42; ) : (state == 1 || state == 3) ? ( gfx_r=0.05; gfx_g=0.05; gfx_b=0.06; ) : ( gfx_r=0.86; gfx_g=0.88; gfx_b=0.92; );
  );
  gfx_x = bx + max(4, (bw-tw)/2); gfx_y = sy + (bh-th)/2; gfx_drawstr(label);
  clicked;
);

function ui_help_button(bx, by, bw, bh, pid) local(is_hover, clicked, light, sy, tw, th) (
  sy = ui_sy(by);
  is_hover = ui_hit(bx, by, bw, bh);
  is_hover ? active_info_id = 99;
  clicked = is_hover && mouse_click;
  light = show_simple && !ui_dark_panel;
  light ? (
    gfx_r = is_hover ? 0.30 : 0.22;
    gfx_g = is_hover ? 0.50 : 0.38;
    gfx_b = is_hover ? 0.68 : 0.54;
  ) : (
    gfx_r = is_hover ? 0.16 : 0.12;
    gfx_g = is_hover ? 0.62 : 0.52;
    gfx_b = is_hover ? 0.75 : 0.62;
  );
  gfx_a = 1;
  gfx_rect(bx, sy, bw, bh);
  gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = is_hover ? 1.0 : 0.85;
  gfx_setfont(3);
  gfx_measurestr("?", tw, th);
  gfx_x = bx + (bw - tw) / 2; gfx_y = sy + (bh - th) / 2;
  gfx_drawstr("?");
  clicked ? (
    bridge_alive ? (
      bridge_req_seq += 1;
      gmem[3902] = pid;
      gmem[3903] = bridge_req_seq;
    ) : (
      help_warn_until = quick_now + 4.0;
    );
  );
);

// Trascinamento comune a pomelli e campi: doppio clic/destro = default, Shift+clic = neutro, Shift+drag = fine.
// Forbici, solo quando il valore lo cambi tu (pomelli, mappa, Partenza): Min Duck non piu' profondo di
// Max Duck, crossover alto almeno 50 Hz sopra il basso. Il DSP usa comunque i valori effettivi.
function ui_pairs(sl) (
  sl == 23 && slider(23) < slider(24) ? ( slider(24) = slider(23); notify_slider(24); );
  sl == 24 && slider(23) < slider(24) ? ( slider(23) = slider(24); notify_slider(23); );
  sl == 11 && slider(11) > slider(12) - 50 ? ( slider(12) = min(18000, slider(11) + 50); notify_slider(12); );
  sl == 12 && slider(11) > slider(12) - 50 ? ( slider(11) = max(20, slider(12) - 50); notify_slider(11); );
);

function ui_drag(sl_idx, is_hover, min_v, max_v, def_v) local(val, my, now_t, is_double_click, neutral_v, drag_sens) (
  val = slider(sl_idx);
  my = ui_scroll_widgets ? (mouse_y + ui_scroll_y) : mouse_y;
  is_hover ? (
    mouse_click ? (
      now_t = time_precise();
      is_double_click = (last_click_sl_idx == sl_idx) && (now_t - last_click_time < 0.35);
      last_click_sl_idx = sl_idx; last_click_time = now_t;
      is_double_click ? (
        slider(sl_idx) = def_v; notify_slider(sl_idx); ui_pairs(sl_idx); ui_drag_id = 0; ui_shift_click_pending = 0;
      ) : (
        ui_drag_id = sl_idx; ui_drag_start_y = my; ui_drag_start_v = val; ui_shift_click_pending = mouse_cap & 8;
      );
    );
    mouse_right_click ? ( slider(sl_idx) = def_v; notify_slider(sl_idx); ui_pairs(sl_idx); );
  );
  ui_drag_id == sl_idx && mouse_down ? (
    drag_sens = ((max_v - min_v) / 150.0) * fine_tune;
    val = max(min_v, min(max_v, ui_drag_start_v + (ui_drag_start_y - my) * drag_sens));
    slider(sl_idx) = val; notify_slider(sl_idx); ui_pairs(sl_idx);
  ) : ( ui_drag_id == sl_idx ? (
    ui_shift_click_pending && abs(my - ui_drag_start_y) < 1 ? (
      neutral_v = ui_neutral_value(sl_idx, min_v, max_v, def_v);
      slider(sl_idx) = neutral_v; notify_slider(sl_idx); ui_pairs(sl_idx);
    );
    ui_shift_click_pending = 0;
    ui_drag_id = 0;
  ); );
  slider(sl_idx);
);

function ui_knob(sl_idx, kx, ky, r, min_v, max_v, def_v, label, unit, cr, cg, cb, info_id)
local(lt, val, norm_val, ang_min, ang_max, ang, is_hover, hover_mult, tw, th, sy,
      meter_enabled, meter_db, meter_norm, meter_ang, meter_above, meter_r, tick_x1, tick_y1, tick_x2, tick_y2)
(
  lt = show_simple && !ui_dark_panel;
  sy = ui_sy(ky);
  is_hover = ui_hit(kx-r-12, ky-r-ui_font_label-10, 2*r+24, 2*r+2*ui_font_label+24);
  is_hover ? active_info_id = info_id;
  val = ui_drag(sl_idx, is_hover, min_v, max_v, def_v);
  hover_mult = (is_hover || ui_drag_id == sl_idx) ? 1.4 : 0.8;

  ang_min = 2.356; ang_max = 7.068;
  norm_val = (val - min_v) / max(0.0001, max_v - min_v);
  ang = ang_min + norm_val * (ang_max - ang_min);

  (is_hover || ui_drag_id == sl_idx) ? (
    gfx_r=cr; gfx_g=cg; gfx_b=cb; gfx_a= lt ? 0.12 : 0.08;
    gfx_circle(kx, sy, r+7, 1, 1);
  );

  // Anello live sulle tre soglie: voce (6), bande Carver (7), musica (22).
  meter_enabled = sl_idx == 6 || sl_idx == 7 || sl_idx == 22;
  meter_enabled ? (
    sl_idx == 6 ? meter_db = amp2db(max(0.000001, speech_env)) :
    sl_idx == 7 ? meter_db = max(amp2db(max(0.000001, env_l)), max(amp2db(max(0.000001, env_m)), amp2db(max(0.000001, env_h)))) :
    meter_db = amp2db(max(0.000001, main_vca_env));
    meter_norm = max(0.0, min(1.0, (meter_db - min_v) / max(0.0001, max_v - min_v)));
    meter_ang = ang_min + meter_norm * (ang_max - ang_min);
    meter_above = meter_db >= val;
    meter_r = r + 6;
    gfx_r=0.27; gfx_g=0.28; gfx_b=0.33; gfx_a=0.72;
    gfx_arc(kx, sy, meter_r, ang_min, ang_max, 1);
    gfx_arc(kx, sy, meter_r-1, ang_min, ang_max, 1);
    meter_above ? ( gfx_r=min(1.0, cr*1.28); gfx_g=min(1.0, cg*1.28); gfx_b=min(1.0, cb*1.28); gfx_a=1;
    ) : ( gfx_r=cr*0.72; gfx_g=cg*0.72; gfx_b=cb*0.72; gfx_a=0.72; );
    meter_norm > 0.001 ? ( gfx_arc(kx, sy, meter_r, ang_min, meter_ang, 1); gfx_arc(kx, sy, meter_r-1, ang_min, meter_ang, 1); );
    tick_x1 = kx + cos(ang) * (r + 3); tick_y1 = sy + sin(ang) * (r + 3);
    tick_x2 = kx + cos(ang) * (r + 9); tick_y2 = sy + sin(ang) * (r + 9);
    gfx_r=0.94; gfx_g=0.95; gfx_b=0.98; gfx_a=0.92;
    gfx_line(tick_x1, tick_y1, tick_x2, tick_y2, 1);
  );

  lt ? (gfx_r=0.98; gfx_g=0.99; gfx_b=1.0;) : (gfx_r=0.30; gfx_g=0.32; gfx_b=0.36;);
  gfx_a=1; gfx_circle(kx, sy, r+1, 1, 1);
  lt ? (gfx_r=0.94; gfx_g=0.96; gfx_b=0.98;) : (gfx_r=0.20; gfx_g=0.21; gfx_b=0.24;);
  gfx_circle(kx, sy, r, 1, 1);
  lt ? (gfx_r=1.0; gfx_g=1.0; gfx_b=1.0; gfx_a=0.35;) : (gfx_r=0.48; gfx_g=0.50; gfx_b=0.56; gfx_a=0.22;);
  gfx_circle(kx - r*0.32, sy - r*0.34, max(2, r*0.28), 1, 1);
  gfx_r=min(1, cr*hover_mult); gfx_g=min(1, cg*hover_mult); gfx_b=min(1, cb*hover_mult); gfx_a=1;
  gfx_arc(kx, sy, r-2, ang_min, ang, 3); gfx_arc(kx, sy, r-3, ang_min, ang, 3);
  gfx_r= lt ? 0.18 : 0.9; gfx_g= lt ? 0.20 : 0.9; gfx_b= lt ? 0.24 : 0.9;
  gfx_line(kx, sy, kx + cos(ang)*r, sy + sin(ang)*r);

  gfx_setfont(1);
  lt ? (gfx_r=0.28; gfx_g=0.31; gfx_b=0.36;) : (gfx_r=0.70; gfx_g=0.72; gfx_b=0.78;);
  gfx_measurestr(label, tw, th); gfx_x = kx - tw/2; gfx_y = sy - r - th - 6; gfx_drawstr(label);
  lt ? (gfx_r=0.24; gfx_g=0.28; gfx_b=0.32;) : (gfx_r=0.78; gfx_g=0.80; gfx_b=0.84;);
  sl_idx == 32 && val <= -119.9 ? strcpy(#val_str, "OFF") :
  abs(val) >= 1000 ? sprintf(#val_str, "%.0f %s", val, unit) :
  sprintf(#val_str, "%.1f %s", val, unit);
  gfx_setfont(5); gfx_measurestr(#val_str, tw, th); gfx_x = kx - tw/2; gfx_y = sy + r + 6; gfx_drawstr(#val_str);
);

// Campo numerico trascinabile (guadagno delle fonti sidechain).
function ui_field(sl_idx, fx, fy, fw, fh, min_v, max_v, def_v, enabled, info_id) local(sy, is_hover, val, tw, th) (
  sy = ui_sy(fy);
  is_hover = ui_hit(fx, fy, fw, fh);
  is_hover ? active_info_id = info_id;
  val = ui_drag(sl_idx, is_hover && enabled, min_v, max_v, def_v);
  gfx_a = 1; gfx_r=0.13; gfx_g=0.13; gfx_b=0.16; is_hover && enabled ? (gfx_r=0.20; gfx_g=0.20; gfx_b=0.24;);
  gfx_rect(fx, sy, fw, fh);
  gfx_r=0.30; gfx_g=0.30; gfx_b=0.35; gfx_line(fx, sy+fh-1, fx+fw, sy+fh-1);
  gfx_setfont(5); sprintf(#fld_txt, "%+.1f dB", val); gfx_measurestr(#fld_txt, tw, th);
  enabled ? (gfx_r=0.86; gfx_g=0.88; gfx_b=0.92;) : (gfx_r=0.40; gfx_g=0.40; gfx_b=0.45;);
  gfx_x = fx + (fw - tw) / 2; gfx_y = sy + (fh - th) / 2; gfx_drawstr(#fld_txt);
);

function draw_box(x, y, w, h, title, cr, cg, cb) local(sy) (
  sy = ui_sy(y);
  gfx_a = 1;
  show_simple && !ui_dark_panel ? (gfx_r=0.85; gfx_g=0.89; gfx_b=0.94;) : (gfx_r=0.11; gfx_g=0.11; gfx_b=0.13;);
  gfx_rect(x, sy, w, h);
  gfx_setfont(3); gfx_r=cr; gfx_g=cg; gfx_b=cb; gfx_x = x + 10; gfx_y = sy + 5; gfx_drawstr(title);
  gfx_a = 0.6; gfx_line(x + 10, sy + 24, x + w - 10, sy + 24); gfx_a = 1;
);

function draw_led(x, y, on, label, cr, cg, cb) local(sy) (
  sy = ui_sy(y);
  gfx_a = 1; gfx_r=0.17; gfx_g=0.17; gfx_b=0.20; gfx_circle(x, sy, 5, 1, 1);
  on ? (gfx_r=cr; gfx_g=cg; gfx_b=cb; gfx_circle(x, sy, 5, 1, 1);) : 0;
  gfx_setfont(5);
  on ? (gfx_r=min(1, cr*1.1); gfx_g=min(1, cg*1.1); gfx_b=min(1, cb*1.1);) : (show_simple && !ui_dark_panel ? (gfx_r=0.50; gfx_g=0.55; gfx_b=0.60;) : (gfx_r=0.45; gfx_g=0.45; gfx_b=0.50;));
  gfx_x = x + 10; gfx_y = sy - 7; gfx_drawstr(label);
);

// Barra orizzontale di livello (ampiezza di picco) con etichetta e valore.
function draw_hmeter(x, y, w, h, amp, label, cr, cg, cb) local(sy, db, rel, bw, light) (
  sy = ui_sy(y);
  light = show_simple && !ui_dark_panel;
  db = max(-60, amp2db(amp)); rel = max(0, min(1, (db + 60) / 66));
  bw = w - 92;
  gfx_setfont(5); light ? (gfx_r=0.30; gfx_g=0.35; gfx_b=0.40;) : (gfx_r=0.62; gfx_g=0.64; gfx_b=0.72;);
  gfx_a = 1; gfx_x = x; gfx_y = sy - 3; gfx_drawstr(label);
  light ? (gfx_r=0.76; gfx_g=0.81; gfx_b=0.87;) : (gfx_r=0.16; gfx_g=0.16; gfx_b=0.19;);
  gfx_rect(x + 48, sy, bw, h);
  gfx_r=cr; gfx_g=cg; gfx_b=cb; db > -0.5 ? (gfx_r=0.95; gfx_g=0.25; gfx_b=0.2;);
  rel > 0.002 ? gfx_rect(x + 48, sy, bw * rel, h);
  sprintf(#hm_txt, "%.1f", db);
  light ? (gfx_r=0.24; gfx_g=0.28; gfx_b=0.33;) : (gfx_r=0.80; gfx_g=0.82; gfx_b=0.86;);
  gfx_x = x + 54 + bw; gfx_y = sy - 3; gfx_drawstr(#hm_txt);
);

// Barra di riduzione in dB (Carve / Duck) per Simple e Dock.
function draw_dbbar(x, y, w, h, db, label, cr, cg, cb) local(sy, light) (
  sy = ui_sy(y); light = show_simple && !ui_dark_panel;
  gfx_setfont(5); light ? (gfx_r=0.30; gfx_g=0.35; gfx_b=0.40;) : (gfx_r=0.62; gfx_g=0.64; gfx_b=0.72;);
  gfx_a = 1; gfx_x = x; gfx_y = sy - 3; gfx_drawstr(label);
  light ? (gfx_r=0.76; gfx_g=0.81; gfx_b=0.87;) : (gfx_r=0.16; gfx_g=0.16; gfx_b=0.19;);
  gfx_rect(x + 48, sy, w - 92, h);
  gfx_r=cr; gfx_g=cg; gfx_b=cb; gfx_rect(x + 48, sy, min(w - 92, (db / 18.0) * (w - 92)), h);
  sprintf(#db_txt, "%.1f dB", db);
  light ? (gfx_r=0.24; gfx_g=0.28; gfx_b=0.33;) : (gfx_r=0.80; gfx_g=0.82; gfx_b=0.86;);
  gfx_x = x + w - 40; gfx_y = sy - 3; gfx_drawstr(#db_txt);
);

// Avviso di preascolto (lampeggia): un clic torna all'uscita normale.
function draw_listen_banner(x, y, w, h) local(sy, blink, tw, th) (
  slider(31) > 0 ? (
    sy = ui_sy(y);
    blink = 0.65 + 0.35 * sin(quick_now * 6.0);
    gfx_r=0.92; gfx_g=0.55; gfx_b=0.08; gfx_a=blink; gfx_rect(x, sy, w, h); gfx_a = 1;
    slider(31) == 1 ? strcpy(#lb_txt, "ASCOLTO: CARVER") : slider(31) == 2 ? strcpy(#lb_txt, "ASCOLTO: VCA") : strcpy(#lb_txt, "ASCOLTO: TUTTO");
    gfx_setfont(5); gfx_measurestr(#lb_txt, tw, th);
    gfx_r=0.06; gfx_g=0.05; gfx_b=0.04; gfx_x = x + (w - tw) / 2; gfx_y = sy + (h - th) / 2; gfx_drawstr(#lb_txt);
    ui_hit(x, y, w, h) ? (
      active_info_id = 31;
      mouse_click ? (slider(31) = 0; notify_slider(31););
    );
  );
);

// Cue fuori posto: maschere scritte dall'helper (cue 0-31 e 32-63, in ordine di tempo), all'indirizzo
// quick_mask_addr (blocco del numero unico, o zona libera della traccia senza numero).
function cue_lost(i) ( i < 32 ? floor(quick_lost_m1 / (2 ^ i)) % 2 : floor(quick_lost_m2 / (2 ^ (i - 32))) % 2; );
quick_lost_m1 = 0; quick_lost_m2 = 0; quick_lost_n = 0;
quick_mask_addr >= 0 && sc_route_fresh ? (
  quick_lost_m1 = max(0, gmem[quick_mask_addr]);
  quick_lost_m2 = max(0, gmem[quick_mask_addr + 1]);
  i = 0; loop(quick_point_count, quick_lost_n += cue_lost(i); i += 1;);
);
quick_sel_lost = quick_sel >= 0 && cue_lost(quick_sel);

// Avviso cue fuori posto (lampeggia, non blocca): scattano nel punto sbagliato finche' non li riallinei.
function draw_lost_banner(x, y, w, h) local(sy, blink, tw, th) (
  quick_lost_n > 0 ? (
    sy = ui_sy(y);
    blink = 0.65 + 0.35 * sin(quick_now * 6.0 + 1.5);
    gfx_r=0.86; gfx_g=0.20; gfx_b=0.18; gfx_a=blink; gfx_rect(x, sy, w, h); gfx_a = 1;
    sprintf(#lost_banner_txt, "CUE FUORI POSTO: %d", quick_lost_n);
    gfx_setfont(5); gfx_measurestr(#lost_banner_txt, tw, th);
    gfx_r=1; gfx_g=0.95; gfx_b=0.93; gfx_x = x + (w - tw) / 2; gfx_y = sy + (h - th) / 2; gfx_drawstr(#lost_banner_txt);
    ui_hit(x, y, w, h) ? active_info_id = 73;
  );
);

// Barra QUICK RETURN CUES, identica in Advanced, Simple e Dock. full = con Rampa e Apertura.
function draw_cue_bar(bx, by, bw, full)
local(sy, qx, qy, qh, x, tw, th, i, t0, t1, span, lx, lw, px, cx, best, bestd, m, s, sel_w, tl_w, add_state,
      row_w, del_w, nsel, a)
(
  ui_dark_panel = 1;
  sy = ui_sy(by);
  gfx_a = 1; gfx_r=0.10; gfx_g=0.10; gfx_b=0.12; gfx_rect(bx, sy, bw, full ? 116 : 130);
  gfx_r=0.14; gfx_g=0.72; gfx_b=0.83; gfx_rect(bx, sy, bw, 2);
  gfx_setfont(3); gfx_x = bx + 10; gfx_y = sy + 8; gfx_drawstr("QUICK RETURN CUES");
  sprintf(#quick_count_txt, "  %d / 64", quick_point_count);
  gfx_setfont(5); gfx_r=0.62; gfx_g=0.66; gfx_b=0.73; gfx_y = sy + 10; gfx_drawstr(#quick_count_txt);
  quick_gmem_base < 0 ? (gfx_r=0.85; gfx_g=0.55; gfx_b=0.20; gfx_drawstr(ui_lang == 1 ? "   (take/input FX: jump unavailable)" : "   (take/input FX: salto non disponibile)"));
  quick_lost_n > 0 ? (sprintf(#quick_lost_txt, ui_lang == 1 ? "   %d MISALIGNED" : "   %d FUORI POSTO", quick_lost_n); gfx_r=0.95; gfx_g=0.32; gfx_b=0.28; gfx_drawstr(#quick_lost_txt););
  quick_gmem_base >= 0 && !sc_route_fresh ? (gfx_r=0.92; gfx_g=0.60; gfx_b=0.18; gfx_drawstr(ui_lang == 1 ? "   HELPER OFF" : "   HELPER SPENTO"););
  ui_hit(bx, by, 420, 26) && quick_gmem_base >= 0 && !sc_route_fresh ? active_info_id = 75;

  qx = bx + 10; qy = by + 32; qh = 24;
  sel_w = full ? 170 : 140;
  // < cue selezionato >
  x = qx;
  ui_cue_button(x, qy, 32, qh, "<", 0, quick_point_count > 0, 56) ? (
    quick_jump_ok ? (gmem[quick_gmem_base] = 1; gmem[quick_gmem_base+1] += 1;)
                  : (quick_sel = quick_sel <= 0 ? quick_point_count - 1 : quick_sel - 1;);
  );
  x += 36;
  nsel = quick_msel_count();
  quick_status == 7 ? strcpy(#quick_sel_txt, ui_lang == 1 ? "ALL CLEARED" : "TUTTI CANCELLATI") :
  quick_status == 10 ? sprintf(#quick_sel_txt, ui_lang == 1 ? "DELETED: %d" : "ELIMINATI: %d", quick_deleted_n) :
  nsel > 1 ? sprintf(#quick_sel_txt, ui_lang == 1 ? "%d CUES SEL." : "%d CUE SELEZ.", nsel) :
  quick_sel >= 0 ? (
    m = floor(quick_points[quick_sel] / 60); s = quick_points[quick_sel] - m * 60;
    sprintf(#quick_sel_txt, "CUE %d / %d  %d:%04.1f", quick_sel + 1, quick_point_count, m, s);
  ) : quick_point_count > 0 ? strcpy(#quick_sel_txt, ui_lang == 1 ? "NO CUE SELECTED" : "NESSUN CUE SELEZ.") : strcpy(#quick_sel_txt, ui_lang == 1 ? "NO CUES" : "NESSUN CUE");
  ui_cue_button(x, qy, sel_w, qh, #quick_sel_txt, quick_sel_lost ? 2 : quick_sel >= 0, quick_jump_ok && quick_point_count > 0, quick_sel_lost ? 73 : 56) ? (
    gmem[quick_gmem_base] = 3; gmem[quick_gmem_base+1] += 1;
  );
  x += sel_w + 4;
  ui_cue_button(x, qy, 32, qh, ">", 0, quick_point_count > 0, 56) ? (
    quick_jump_ok ? (gmem[quick_gmem_base] = 2; gmem[quick_gmem_base+1] += 1;)
                  : (quick_sel = quick_sel < 0 || quick_sel >= quick_point_count - 1 ? 0 : quick_sel + 1;);
  );
  x += 32 + 14;
  // ADD / REMOVE, UNDO, CLEAR ALL (il messaggio compare nel pulsante stesso)
  quick_status == 8 ? strcpy(#quick_add_txt, ui_lang == 1 ? "HELPER NEEDED" : "MANCA HELPER") : quick_status == 4 ? strcpy(#quick_add_txt, ui_lang == 1 ? "PRESS PLAY" : "PREMI PLAY") :
  quick_status == 2 ? strcpy(#quick_add_txt, ui_lang == 1 ? "REMOVED" : "TOLTO") : quick_status == 1 ? strcpy(#quick_add_txt, ui_lang == 1 ? "ADDED" : "AGGIUNTO") :
  quick_status == 3 ? strcpy(#quick_add_txt, ui_lang == 1 ? "FULL" : "PIENO") : strcpy(#quick_add_txt, "ADD / REMOVE");
  add_state = quick_status == 1 ? 1 : (quick_status == 8 || quick_status == 3) ? 3 : 0;
  ui_cue_button(x, qy, 110, qh, #quick_add_txt, add_state, 1, 56) ? (
    (play_state & 1) ? (quick_request = 1;) :
    quick_gmem_base >= 0 ? (                                    // da fermo: punto = cursore di REAPER (helper)
      gmem[quick_gmem_base] = 4; gmem[quick_gmem_base+1] += 1;
      quick_wait_seq = gmem[quick_gmem_base+1]; quick_wait_t = quick_now;
    ) : (quick_set_status(4););
  );
  x += 114;
  ui_cue_button(x, qy, 60, qh, (quick_status == 5 || quick_status == 6) ? (ui_lang == 1 ? "DONE" : "FATTO") : "UNDO", 0, quick_last_action > 0, 59) ? quick_undo();
  x += 64;
  quick_clear_armed = quick_clear_arm_t > 0;
  ui_cue_button(x, qy, 80, qh, quick_clear_armed ? (ui_lang == 1 ? "CONFIRM?" : "CONFERMA?") : "CLEAR ALL", quick_clear_armed ? 2 : 0, quick_point_count > 0, 57) ? (
    quick_clear_armed ? (quick_clear_all(); quick_clear_arm_t = -10;) : (quick_clear_arm_t = quick_now;);
  );
  x += 80 + 12;
  // Timeline SALTA / RESTA FERMO
  full ? (
    gfx_setfont(5); gfx_r=0.60; gfx_g=0.60; gfx_b=0.72; gfx_x = x; gfx_y = ui_sy(qy + 5); gfx_drawstr("Timeline");
    x += 58; tl_w = 104;
  ) : (tl_w = 60;);
  ui_cue_button(x, qy, 56, qh, ui_lang == 1 ? "JUMP" : "SALTA", quick_nav_jump, quick_gmem_base >= 0, 58) ? (quick_nav_jump = 1; quick_sel = -1;);
  x += 60;
  ui_cue_button(x, qy, tl_w, qh, full ? (ui_lang == 1 ? "STAY" : "RESTA FERMO") : (ui_lang == 1 ? "STAY" : "FERMO"), !quick_nav_jump, 1, 58) ? (quick_nav_jump = 0;);

  // Fila dei cue: dove sei (playhead rosso) rispetto ai cue. Clic su un punto = selezionalo;
  // Cmd/Ctrl+clic aggiunge o toglie un punto, Shift+clic prende l'intervallo (convenzioni di REAPER).
  // In fondo alla fila: ELIMINA (e RIALLINEA / TIENI QUI se il cue selezionato e' fuori posto).
  lx = qx; row_w = full ? (bw - 130) : (bw - 20);
  del_w = 92; lw = row_w - del_w - 10;
  quick_sel_lost ? lw -= 214;
  ly = by + (full ? 82 : 84);
  gfx_r=0.24; gfx_g=0.24; gfx_b=0.30; gfx_a = 1; gfx_line(lx, ui_sy(ly), lx + lw, ui_sy(ly));
  quick_point_count > 0 ? (
    t0 = min(quick_points[0], quick_ui_pos); t1 = max(quick_points[quick_point_count-1], quick_ui_pos);
    span = max(1, t1 - t0); t0 -= span * 0.02; span *= 1.04;
    best = -1; bestd = 7;
    i = 0;
    loop(quick_point_count,
      cx = lx + (quick_points[i] - t0) / span * lw;
      ui_hit(cx - 6, ly - 7, 12, 14) && abs(mouse_x - cx) < bestd ? (best = i; bestd = abs(mouse_x - cx););
      cue_lost(i) ? (gfx_r=0.95; gfx_g=0.32; gfx_b=0.28;) : (gfx_r=0.14; gfx_g=0.72; gfx_b=0.83;);
      i == quick_sel ? (gfx_circle(cx, ui_sy(ly), 6, 0, 1); gfx_r=1; gfx_g=1; gfx_b=1; gfx_circle(cx, ui_sy(ly), 4, 1, 1);)
                     : (gfx_circle(cx, ui_sy(ly), 4, 1, 1););
      quick_msel[i] ? (gfx_r=1; gfx_g=1; gfx_b=1; gfx_circle(cx, ui_sy(ly), 7, 0, 1); gfx_circle(cx, ui_sy(ly), 4, 1, 1););
      i += 1;
    );
    px = lx + (quick_ui_pos - t0) / span * lw;
    gfx_r=0.95; gfx_g=0.34; gfx_b=0.32; gfx_rect(px - 1, ui_sy(ly - 9), 2, 18);
    best >= 0 ? (
      active_info_id = 60;
      mouse_click ? (
        (mouse_cap & 36) ? (                    // Cmd/Ctrl (4) o Ctrl su Mac (32): aggiungi o togli
          nsel == 0 && quick_sel >= 0 && quick_sel != best ? (quick_msel[quick_sel] = 1);
          quick_msel[best] = !quick_msel[best]; quick_msel_anchor = best;
        ) : (mouse_cap & 8) ? (                 // Shift: intervallo dal punto scelto prima
          a = (quick_msel_anchor >= 0 && quick_msel_anchor < quick_point_count) ? quick_msel_anchor :
              (quick_sel >= 0 ? quick_sel : best);
          quick_msel_clear(); quick_msel_anchor = a;
          i = min(a, best); loop(abs(best - a) + 1, quick_msel[i] = 1; i += 1;);
        ) : (
          quick_msel_clear(); quick_msel_anchor = best;
          quick_jump_ok ? (gmem[quick_gmem_base+2] = best; gmem[quick_gmem_base] = 3; gmem[quick_gmem_base+1] += 1;)
                        : (quick_sel = best;);
        );
        nsel = quick_msel_count();
      );
    );
    gfx_setfont(5); gfx_r=0.50; gfx_g=0.52; gfx_b=0.60;
    m = floor(max(0, t0) / 60); s = max(0, t0) - m * 60; sprintf(#ql_txt, "%d:%04.1f", m, s);
    gfx_x = lx; gfx_y = ui_sy(ly + 8); gfx_drawstr(#ql_txt);
    m = floor((t0 + span) / 60); s = (t0 + span) - m * 60; sprintf(#ql_txt, "%d:%04.1f", m, s);
    gfx_measurestr(#ql_txt, tw, th); gfx_x = lx + lw - tw; gfx_drawstr(#ql_txt);
  ) : (
    gfx_setfont(5); gfx_r=0.50; gfx_g=0.52; gfx_b=0.60; gfx_x = lx; gfx_y = ui_sy(ly + 8);
    gfx_drawstr(ui_lang == 1 ? "No cues: press ADD / REMOVE where music must return instantly." : "Nessun cue: premi ADD / REMOVE dove la musica deve rientrare subito.");
  );

  quick_sel_lost && quick_gmem_base >= 0 ? (
    ui_cue_button(lx + lw + 12, ly - 11, 100, 22, ui_lang == 1 ? "REALIGN" : "RIALLINEA", 2, 1, 73) ? (gmem[quick_gmem_base+2] = quick_sel; gmem[quick_gmem_base] = 6; gmem[quick_gmem_base+1] += 1;);
    ui_cue_button(lx + lw + 116, ly - 11, 96, 22, ui_lang == 1 ? "KEEP HERE" : "TIENI QUI", 0, 1, 74) ? (gmem[quick_gmem_base+2] = quick_sel; gmem[quick_gmem_base] = 7; gmem[quick_gmem_base+1] += 1;);
  );
  nsel > 1 ? sprintf(#quick_del_txt, ui_lang == 1 ? "DELETE %d" : "ELIMINA %d", nsel) : strcpy(#quick_del_txt, ui_lang == 1 ? "DELETE" : "ELIMINA");
  ui_cue_button(lx + row_w - del_w, ly - 11, del_w, 22, #quick_del_txt, nsel > 0 ? 2 : 0,
                quick_point_count > 0 && (nsel > 0 || quick_sel >= 0), 77) ? quick_delete_selected();
  full ? (
    ui_knob(56, bx + bw - 86, by + 70, 12, 10, 250, 200, ui_lang == 1 ? "Ramp" : "Rampa", "ms", 0.95, 0.42, 0.20, 56);
    ui_knob(57, bx + bw - 34, by + 70, 12, 0, 2000, 500, ui_lang == 1 ? "Release" : "Apertura", "ms", 0.95, 0.42, 0.20, 61);
  );
  ui_dark_panel = 0;
);

// ================================================================
// TESTATA (FULL): nome, Partenza, preascolto, profilo, vista
// ================================================================
function draw_header() local(rx, ban_w) (
  gfx_setfont(2);
  show_simple ? (gfx_r=0.18; gfx_g=0.24; gfx_b=0.30;) : (gfx_r=0.8; gfx_g=0.8; gfx_b=0.85;);
  gfx_x = 18; gfx_y = 6; gfx_drawstr("ZP HSC");
  gfx_setfont(5); show_simple ? (gfx_r=0.43; gfx_g=0.49; gfx_b=0.56;) : (gfx_r=0.45; gfx_g=0.45; gfx_b=0.52;);
  gfx_x = 18; gfx_y = 30; show_simple ? gfx_drawstr("Simple  v2.6") : gfx_drawstr("Advanced  v2.6");

  gfx_x = 110; gfx_y = 18; gfx_drawstr(ui_lang == 1 ? "START" : "PARTENZA");
  ui_cue_button(184, 12, 62, 26, "SCORE", preset_match(0), 1, 70) ? preset_apply(0);
  ui_cue_button(250, 12, 54, 26, "FLAT", preset_match(1), 1, 70) ? preset_apply(1);
  ui_cue_button(308, 12, 62, 26, "VOCAL", preset_match(2), 1, 70) ? preset_apply(2);

  rx = gfx_w - 20;
  ui_help_button(rx - 26, 12, 26, 26, 2);
  rx -= 32;
  ui_tab_button(51, 1, rx - 60, 12, 60, 26, "DOCK", 51);
  ui_tab_button(51, 0, rx - 60 - 4 - 56, 12, 56, 26, "FULL", 51);
  ui_tab_button(4, 1, rx - 120 - 16 - 92, 12, 92, 26, "ADVANCED", 4);
  ui_tab_button(4, 0, rx - 228 - 4 - 74, 12, 74, 26, "SIMPLE", 4);
  ban_w = max(120, rx - 306 - 384 - 10);
  slider(31) > 0 && quick_lost_n > 0 ? (
    draw_listen_banner(384, 12, ban_w / 2 - 2, 26); draw_lost_banner(384 + ban_w / 2 + 2, 12, ban_w / 2 - 2, 26);
  ) : (
    draw_listen_banner(384, 12, ban_w, 26); draw_lost_banner(384, 12, ban_w, 26);
  );

  show_simple ? (gfx_r=0.80; gfx_g=0.85; gfx_b=0.91;) : (gfx_r=0.16; gfx_g=0.16; gfx_b=0.20;);
  gfx_a = 1; gfx_line(0, 50, gfx_w, 50);
);

view_mode == 0 ? (
ui_scroll_widgets = 1;
show_simple ? (
  // ================= SIMPLE: i controlli principali dell'Advanced =================
  sx = 18; sw = gfx_w - 36;
  draw_box(sx, 58, sw, 232, ui_lang == 1 ? "PRIMARY CONTROLS" : "CONTROLLI PRINCIPALI", 0.20, 0.36, 0.50);
  gfx_setfont(5); gfx_r=0.36; gfx_g=0.42; gfx_b=0.49; gfx_x = sx + 200; gfx_y = ui_sy(64);
  gfx_drawstr(ui_lang == 1 ? "Same parameters as Advanced: changes here apply to both." : "Gli stessi parametri dell'Advanced: cio' che cambi qui cambia anche la'.");
  sk = (sw - 300) / 5;
  ui_knob(6,  sx + sk * 0.5, 175, 26, -60, 0, -35, ui_lang == 1 ? "Voice" : "Voce", "dB", 0.20, 0.70, 0.40, 6);
  ui_knob(16, sx + sk * 1.5, 175, 26, 0, 150, 100, ui_lang == 1 ? "Space" : "Spazio", "%", 0.16, 0.62, 0.80, 16);
  ui_knob(24, sx + sk * 2.5, 175, 26, -40, 0, -15, "Duck", "dB", 0.84, 0.30, 0.55, 24);
  ui_knob(28, sx + sk * 3.5, 175, 26, 20, 4000, 470, ui_lang == 1 ? "Release" : "Rientro", "ms", 0.84, 0.50, 0.22, 28);
  ui_knob(35, sx + sk * 4.5, 175, 26, 0, 100, 100, "Mix", "%", 0.48, 0.48, 0.52, 35);

  stx = sx + sw - 286;
  gfx_r=0.78; gfx_g=0.83; gfx_b=0.89; gfx_a=1; gfx_rect(stx - 12, ui_sy(92), 1, 186);
  draw_dbbar(stx, 106, 274, 12, carve_db_disp, "CARVE", 0.18, 0.60, 0.80);
  draw_dbbar(stx, 136, 274, 12, duck_db_disp, "DUCK", 0.84, 0.42, 0.24);
  draw_hmeter(stx, 166, 274, 10, max(meter_main_l, meter_main_r), "MAIN", 0.18, 0.75, 0.35);
  draw_hmeter(stx, 190, 274, 10, max(meter_sc_l, meter_sc_r), "VOCE", 0.14, 0.62, 0.80);
  draw_hmeter(stx, 214, 274, 10, max(meter_out_l, meter_out_r), "OUT", 0.18, 0.75, 0.35);
  draw_led(stx + 6, 252, speech_state == 1, "VOCE", 0.18, 0.70, 0.40);
  draw_led(stx + 80, 252, speech_state == 2, "HOLD", 0.90, 0.58, 0.16);
  draw_led(stx + 154, 252, glue_active, "GLUE", 0.62, 0.40, 0.90);
  sc_problem ? (gfx_setfont(5); gfx_r=0.85; gfx_g=0.35; gfx_b=0.20; gfx_x = stx; gfx_y = ui_sy(268); gfx_drawstr(ui_lang == 1 ? "Sidechain: check routing (Advanced, VOICE block)" : "Sidechain: controlla il routing (Advanced, blocco VOCE)"););

  draw_cue_bar(sx, 302, sw, 1);

  draw_box(sx, 430, sw, 64, ui_lang == 1 ? "DELTA AUDITION" : "PREASCOLTO DEL TOLTO", 0.20, 0.36, 0.50);
  ui_tab_button(31, 0, sx + 12, 460, 60, 24, "OFF", 31);
  ui_tab_button(31, 1, sx + 76, 460, 80, 24, "CARVER", 31);
  ui_tab_button(31, 2, sx + 160, 460, 60, 24, "VCA", 31);
  ui_tab_button(31, 3, sx + 224, 460, 74, 24, ui_lang == 1 ? "ALL" : "TUTTO", 31);
  gfx_setfont(5); gfx_r=0.36; gfx_g=0.42; gfx_b=0.49; gfx_x = sx + 312; gfx_y = ui_sy(465);
  slider(31) > 0 ? (gfx_r=0.80; gfx_g=0.45; gfx_b=0.05; gfx_drawstr(ui_lang == 1 ? "Auditioning removed sound only. OFF = normal output." : "Stai ascoltando solo cio' che viene tolto. OFF = uscita normale.")) :
                   gfx_drawstr(ui_lang == 1 ? "OFF = normal output. Meters always display true output." : "OFF = uscita normale. I livelli misurano sempre l'uscita vera.");
) : (
  // ================= ADVANCED =================
  // ---- riga 1: VOCE -> CARVER -> VCA ----
  draw_box(10, 58, 250, 210, "VOCE", 0.20, 0.85, 0.45);
  gfx_setfont(5); gfx_r=0.45; gfx_g=0.45; gfx_b=0.52; gfx_x = 64; gfx_y = ui_sy(65); gfx_drawstr("sidechain");
  // solo le fonti che il routing rende disponibili; sotto, come aprire la successiva
  i = 0; sc_row = 0; sc_hint_done = 0;
  loop(3,
    sy_row = 90 + sc_row * 26;
    sc_on_idx = 60 + i; sc_g_idx = i == 0 ? 3 : i == 1 ? 58 : 59; st = sc_stat[i];
    (st > 0 || i == 0) ? (
      i == 0 ? strcpy(#sc_lbl, "SC1 3/4") : i == 1 ? strcpy(#sc_lbl, "SC2 5/6") : strcpy(#sc_lbl, "SC3 7/8");
      ui_cue_button(18, sy_row, 66, 20, #sc_lbl, slider(sc_on_idx) >= 0.5 ? (st == 7 || st == 4 || st == 3 ? 2 : 1) : 0, 1, 65 + i) ? (
        slider(sc_on_idx) = slider(sc_on_idx) >= 0.5 ? 0 : 1; notify_slider(sc_on_idx);
      );
      ui_field(sc_g_idx, 88, sy_row, 62, 20, -24, 24, 0, slider(sc_on_idx) >= 0.5, 65 + i);
      sc_m = i == 0 ? meter_s1 : i == 1 ? meter_s2 : meter_s3;
