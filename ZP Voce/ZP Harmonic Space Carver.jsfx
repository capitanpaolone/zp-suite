  ui_cue_button(464, 279, 58, 19, "SCOPE", bands_page == 1, 1, 72) ? bands_page = 1;
  mx = 278; my0 = 306; mw = 242; mh = 148;
  gfx_r=0.08; gfx_g=0.08; gfx_b=0.10; gfx_a=1; gfx_rect(mx, ui_sy(my0), mw, mh);
  log_min = log(20); log_tot = log(18000) - log_min;
  xl = mx + mw * (log(max(21, slider(11))) - log_min) / log_tot;
  xh = mx + mw * (log(min(17999, max(slider(12), slider(11) + 50))) - log_min) / log_tot;
  bands_page == 0 ? (
    gfx_r=0.16; gfx_g=0.36; gfx_b=0.60; gfx_a=0.30; gfx_rect(xl, ui_sy(my0), xh - xl, mh);
    h1 = min(mh - 30, (1.0 - meter_gr_l) * mh * 1.5);
    h2 = min(mh - 30, (1.0 - meter_gr_m) * mh * 1.5);
    h3 = min(mh - 30, (1.0 - meter_gr_h) * mh * 1.5);
    gfx_r=0.14; gfx_g=0.72; gfx_b=0.83; gfx_a=0.55; h1 > 0.5 ? gfx_rect(mx, ui_sy(my0), xl - mx, h1);
    gfx_r=0.14; gfx_g=0.52; gfx_b=0.93; gfx_a=0.55; h2 > 0.5 ? gfx_rect(xl, ui_sy(my0), xh - xl, h2);
    gfx_r=0.14; gfx_g=0.72; gfx_b=0.83; gfx_a=0.55; h3 > 0.5 ? gfx_rect(xh, ui_sy(my0), mx + mw - xh, h3);
    gfx_a = 1; gfx_setfont(5);
    slider(11) < 1000 ? sprintf(#freq_l_txt, "%.0f Hz", slider(11)) : sprintf(#freq_l_txt, "%.2fk", slider(11) / 1000.0);
    slider(12) < 1000 ? sprintf(#freq_h_txt, "%.0f Hz", slider(12)) : sprintf(#freq_h_txt, "%.2fk", slider(12) / 1000.0);
    sprintf(#low_txt, "LOW %.1f", slider42); sprintf(#mid_txt, "MID %.1f", slider43); sprintf(#high_txt, "HIGH %.1f", slider44);
    gfx_r=0.28; gfx_g=0.92; gfx_b=0.46; gfx_x = mx + 4; gfx_y = ui_sy(my0 + mh - 34); gfx_drawstr(#low_txt);
    gfx_r=0.34; gfx_g=0.62; gfx_b=1.0; gfx_measurestr(#mid_txt, tw, th); gfx_x = max(xl + 4, (xl + xh - tw) / 2); gfx_y = ui_sy(my0 + mh - 34); gfx_drawstr(#mid_txt);
    gfx_r=0.82; gfx_g=0.84; gfx_b=0.90; gfx_measurestr(#high_txt, tw, th); gfx_x = mx + mw - tw - 4; gfx_y = ui_sy(my0 + mh - 34); gfx_drawstr(#high_txt);
    gfx_r=0.62; gfx_g=0.80; gfx_b=0.90; gfx_measurestr(#freq_l_txt, tw, th); gfx_x = max(mx + 2, min(mx + mw - tw - 2, xl - tw / 2)); gfx_y = ui_sy(my0 + mh - 16); gfx_drawstr(#freq_l_txt);
    gfx_measurestr(#freq_h_txt, tw, th); gfx_x = max(mx + 2, min(mx + mw - tw - 2, xh - tw / 2)); gfx_drawstr(#freq_h_txt);
