  i += 1;
);

low_norm = clamp(low_push / max(0.1, max_curve_db * 2), 0, 1);
mid_norm = clamp(mid_push / max(0.1, max_curve_db * 3), 0, 1);
high_norm = clamp(high_push / max(0.1, max_curve_db * 2), 0, 1);
low_cut_norm = clamp(low_pull / max(0.1, max_curve_db * 2), 0, 1);
high_cut_norm = clamp(high_pull / max(0.1, max_curve_db * 2), 0, 1);
mid_focus_norm = clamp(mid_focus / max(0.1, max_curve_db * 3), 0, 1);

warm_bias = 0.5 * (1 - harm_color);
air_bias = 0.5 * (1 + harm_color);

band_shape_target = clamp(max(low_cut_norm, high_cut_norm) * (0.26 + 0.24 * mid_focus_norm), 0, 1);
// Guardie spettrali piu' conservative: evitano band-limiting eccessivo.
hp_target_hz = 24 + 230 * low_cut_norm * (0.28 + 0.50 * mid_focus_norm);
lp_target_hz = 19800 - 4200 * high_cut_norm * (0.28 + 0.50 * mid_focus_norm);
lp_target_hz -= ultrahigh_guard * 3600;
lp_target_hz = max(hp_target_hz + 1800, lp_target_hz);
hp_target_hz = min(hp_target_hz, 85);
lp_target_hz = max(lp_target_hz, 14000);
(strict_eq_on || capture_live_mode) ? (
  band_shape_target = 0;
  hp_target_hz = 40;
  lp_target_hz = 20000;
);
keep_static_active ? (
  band_shape_target = band_shape_mix;
  hp_target_hz = adaptive_hp_hz;
  lp_target_hz = adaptive_lp_hz;
);
band_coeff = (capture_freeze_mode || keep_static_active) ? 1 : exp(-samplesblock / max(1, srate * 0.12));
adaptive_hp_hz = adaptive_hp_hz * band_coeff + hp_target_hz * (1 - band_coeff);
adaptive_lp_hz = adaptive_lp_hz * band_coeff + lp_target_hz * (1 - band_coeff);
band_shape_mix = band_shape_mix * band_coeff + band_shape_target * (1 - band_coeff);
band_shape_settle = abs(hp_target_hz - adaptive_hp_hz) / 1200 + abs(lp_target_hz - adaptive_lp_hz) / 6000 + abs(band_shape_target - band_shape_mix);
post_shape_scale = (strict_eq_on || capture_live_mode) ? 0.0 : 0.45;
shape_limit_db = max_curve_db * (strict_eq_on ? 1.0 : 0.70);
low_shape_target = clamp((low_shape_err * 4.6 + low_abs_err * 1.2) * eff_match_amt * post_shape_scale, -shape_limit_db, shape_limit_db);
mid_shape_target = clamp((mid_shape_err * 3.2 + mid_abs_err * 0.7) * eff_match_amt * post_shape_scale, -shape_limit_db * 0.45, shape_limit_db * 0.80);
high_shape_target = clamp((high_shape_err * 3.6 + high_abs_err * 0.8) * eff_match_amt * post_shape_scale, -shape_limit_db, shape_limit_db * 0.65);
high_shape_target > 0 ? (
  high_shape_target *= (1 - 0.65 * sibilance_guard) * (1 - 0.70 * ultrahigh_guard) * (1 - 0.55 * ultra_descend_need);
  // Guard: gap HF assoluto elevato = shelf meno affidabile.
  hf_abs_gap = max(0, air_ref_db - air_in_db);
  hf_shelf_suppress = clamp(1.0 - hf_abs_gap / 9.0, 0.0, 1.0);
  high_shape_target *= hf_shelf_suppress;
  // Guard addizionale: se il delta medio globale e' alto, riduci il contributo shelf.
  large_delta_hf_gate = clamp(1.0 - (raw_err_avg_db - 3.5) / 7.0, 0.20, 1.0);
  high_shape_target *= large_delta_hf_gate;
);
strict_eq_on ? (
  low_shape_target = 0;
  mid_shape_target = 0;
  high_shape_target = 0;
);
keep_static_active ? (
  low_shape_target = low_shape_db;
  mid_shape_target = mid_shape_db;
  high_shape_target = high_shape_db;
);
shape_coeff = (capture_freeze_mode || keep_static_active) ? 1 : exp(-samplesblock / max(1, srate * (0.11 + focus_stability_mix * 1.40)));
low_shape_db = low_shape_db * shape_coeff + low_shape_target * (1 - shape_coeff);
mid_shape_db = mid_shape_db * shape_coeff + mid_shape_target * (1 - shape_coeff);
high_shape_db = high_shape_db * shape_coeff + high_shape_target * (1 - shape_coeff);
speech_cut_drive = clamp(max(speech_lowcut_err, 0) / 6, 0, 1);
speech_air_drive = clamp(max(speech_highcut_err, 0) / 6, 0, 1);
speech_presence_drive = clamp(max(speech_presence_err, 0) / 6, 0, 1);
peak_drive = clamp(ref_peak_rel / 8, 0, 1);
speech_peak_err_eff = abs(soft_deadband(ref_peak_err, 1.10));
speech_specificity = clamp((ref_peak_rel - 4.5) / 9.0, 0, 1) * clamp((speech_peak_err_eff - 0.20) / 5.0, 0, 1) * mirror_error_mix;
speech_scale = (strict_eq_on || capture_live_mode) ? 0.0 : 0.16;
speech_mix_target = clamp((max(max(speech_cut_drive, speech_air_drive), speech_presence_drive) * 0.45 + peak_drive * 0.35) * eff_match_amt * speech_specificity * speech_scale, 0, 1);
speech_hp_target = 40 + 420 * speech_cut_drive * (0.30 + 0.70 * max(speech_presence_drive, peak_drive));
speech_hp_target = min(speech_hp_target, 120);
speech_lp_target = 19500 - 4200 * speech_air_drive * (0.20 + 0.55 * max(speech_presence_drive, peak_drive));
speech_lp_target = max(speech_hp_target + 2000, speech_lp_target);
speech_lp_target = max(speech_lp_target, 15000);
speech_presence_freq_target = clamp(band_freq[ref_peak_idx], 220, 3200);
speech_presence_q_target = 1.0 + 2.1 * peak_drive * speech_specificity;
speech_presence_gain_target = clamp((soft_deadband(ref_peak_err, 0.85) * 2.0 + soft_deadband(speech_presence_err, 0.90) * 1.2) * eff_match_amt * speech_specificity * speech_scale, -shape_limit_db * 0.22, shape_limit_db * 0.25);
speech_presence_gain_target > 0 ? (
  speech_presence_gain_target *= (1 - 0.75 * sibilance_guard);
);
speech_body_gain_target = clamp((speech_body_err * 1.05 - max(0, speech_lowcut_err) * 0.75 - max(0, speech_highcut_err) * 0.25) * eff_match_amt * speech_specificity * speech_scale, -shape_limit_db * 0.18, shape_limit_db * 0.28);
strict_eq_on ? (
  speech_mix_target = 0;
  speech_presence_gain_target = 0;
  speech_body_gain_target = 0;
);
keep_static_active ? (
  speech_hp_target = speech_hp_hz;
  speech_lp_target = speech_lp_hz;
  speech_presence_freq_target = speech_presence_hz;
  speech_presence_q_target = speech_presence_q;
  speech_presence_gain_target = speech_presence_db;
  speech_body_gain_target = speech_body_db;
  speech_mix_target = speech_mix;
);
speech_hp_hz = speech_hp_hz * shape_coeff + speech_hp_target * (1 - shape_coeff);
speech_lp_hz = speech_lp_hz * shape_coeff + speech_lp_target * (1 - shape_coeff);
speech_presence_hz = speech_presence_hz * shape_coeff + speech_presence_freq_target * (1 - shape_coeff);
speech_presence_q = speech_presence_q * shape_coeff + speech_presence_q_target * (1 - shape_coeff);
speech_presence_db = speech_presence_db * shape_coeff + speech_presence_gain_target * (1 - shape_coeff);
speech_body_db = speech_body_db * shape_coeff + speech_body_gain_target * (1 - shape_coeff);
speech_mix = speech_mix * shape_coeff + speech_mix_target * (1 - shape_coeff);
shape_settle = (abs(low_shape_target - low_shape_db) + abs(mid_shape_target - mid_shape_db) + abs(high_shape_target - high_shape_db)) / 3
  + abs(speech_hp_target - speech_hp_hz) / 1200
  + abs(speech_lp_target - speech_lp_hz) / 6000
  + abs(speech_presence_gain_target - speech_presence_db) / max(0.1, max_curve_db)
  + abs(speech_body_gain_target - speech_body_db) / max(0.1, max_curve_db)
  + abs(speech_mix_target - speech_mix);
// Air Trim influenza anche lo shelf HF (non solo i peaking band).
high_shape_applied = high_shape_db + air_trim_db * 0.90;
set_lowshelf(shapeL_mem, 0, 220, low_shape_db);
set_peaking(shapeL_mem, 1, 1300, 1.00, mid_shape_db * 0.70);
set_highshelf(shapeL_mem, 2, 4800, high_shape_applied);
set_highpass(shapeL_mem, 3, speech_hp_hz, 0.72);
set_lowpass(shapeL_mem, 4, speech_lp_hz, 0.72);
set_peaking(shapeL_mem, 5, clamp(speech_presence_hz * 0.62, 180, 1100), 0.95, speech_body_db * speech_mix);
set_peaking(shapeL_mem, 6, speech_presence_hz, speech_presence_q, speech_presence_db * speech_mix);
set_lowshelf(shapeR_mem, 0, 220, low_shape_db);
set_peaking(shapeR_mem, 1, 1300, 1.00, mid_shape_db * 0.70);
set_highshelf(shapeR_mem, 2, 4800, high_shape_applied);
set_highpass(shapeR_mem, 3, speech_hp_hz, 0.72);
set_lowpass(shapeR_mem, 4, speech_lp_hz, 0.72);
set_peaking(shapeR_mem, 5, clamp(speech_presence_hz * 0.62, 180, 1100), 0.95, speech_body_db * speech_mix);
set_peaking(shapeR_mem, 6, speech_presence_hz, speech_presence_q, speech_presence_db * speech_mix);
focus_idx = 0;
focus_score = 0;
focus_locality_pick = 0;
i = 0;
loop(NUM_BANDS,
  sc_rel_db = tmp_sc_db[i] - sc_mean_db;
  in_rel_db = tmp_in_db[i] - in_mean_db;
  focus_err_db = sc_rel_db - in_rel_db;
  i > 0 ? (
    focus_left_err = (tmp_sc_db[i - 1] - sc_mean_db) - (tmp_in_db[i - 1] - in_mean_db);
  ) : (
    focus_left_err = focus_err_db;
  );
  i < (NUM_BANDS - 1) ? (
    focus_right_err = (tmp_sc_db[i + 1] - sc_mean_db) - (tmp_in_db[i + 1] - in_mean_db);
  ) : (
    focus_right_err = focus_err_db;
  );
  focus_locality = abs(focus_err_db - 0.5 * (focus_left_err + focus_right_err));
  focus_anchor_penalty = abs(log(band_freq[i] / max(20, focus_freq_hz))) * 0.85 * focus_stability_mix;
  score = abs(focus_err_db) * 2.9 + focus_locality * 2.2 + abs(sc_rel_db) * 0.35 - focus_anchor_penalty;
  score > focus_score ? (
    focus_score = score;
    focus_idx = i;
    focus_err_pick = focus_err_db;
    sc_rel_pick = sc_rel_db;
    focus_locality_pick = focus_locality;
    focus_left_pick = focus_left_err;
    focus_right_pick = focus_right_err;
  );
  i += 1;
);
focus_interp_den = focus_left_pick - 2 * focus_err_pick + focus_right_pick;
focus_interp_offset = abs(focus_interp_den) > 0.0001 ? clamp(0.5 * (focus_left_pick - focus_right_pick) / focus_interp_den, -1, 1) : 0;
focus_freq_target = band_freq[focus_idx];
focus_idx > 0 && focus_interp_offset < 0 ? (
  focus_log_step = log(band_freq[focus_idx] / band_freq[focus_idx - 1]);
  focus_freq_target = exp(log(focus_freq_target) + focus_interp_offset * focus_log_step);
);
focus_idx < (NUM_BANDS - 1) && focus_interp_offset > 0 ? (
  focus_log_step = log(band_freq[focus_idx + 1] / band_freq[focus_idx]);
  focus_freq_target = exp(log(focus_freq_target) + focus_interp_offset * focus_log_step);
);
focus_activity_target = clamp((abs(focus_err_pick) + focus_locality_pick * 1.8 - 1.6) / 5.0, 0, 1) * mirror_peak_mix;
focus_mix_coeff = capture_freeze_mode ? 1 : exp(-samplesblock / max(1, srate * 0.45));
focus_activity_mix = focus_activity_mix * focus_mix_coeff + focus_activity_target * (1 - focus_mix_coeff);
focus_q_target = 1.6 + 7.8 * clamp((abs(focus_err_pick) + focus_locality_pick * 2.5) / 8.8, 0, 1) * focus_activity_mix;
focus_err_eff = soft_deadband(focus_err_pick, 1.05);
focus_mix_drive = max(mirror_peak_mix * 0.65, focus_activity_mix);
focus_drive = (7.0 + 5.0 * clamp(focus_locality_pick / 2.2, 0, 1)) * focus_activity_mix * (1 - 0.55 * focus_stability_mix);
focus_scale = (strict_eq_on || capture_live_mode) ? 0.0 : 0.32;
focus_gain_target = clamp((focus_err_eff * focus_drive) * eff_match_amt * focus_mix_drive * focus_scale, -shape_limit_db * 0.45, shape_limit_db * 0.45);
focus_target_lock = clamp(focus_stability_mix * 0.82, 0, 0.82);
focus_freq_target = focus_freq_target * (1 - focus_target_lock) + focus_freq_hz * focus_target_lock;
focus_q_target = focus_q_target * (1 - focus_target_lock) + focus_q_val * focus_target_lock;
focus_gain_target = focus_gain_target * (1 - focus_target_lock) + focus_gain_db * focus_target_lock;
(focus_freq_target >= 5200 && focus_freq_target <= 9000 && focus_gain_target > 0) ? (
  focus_gain_target *= (1 - 0.70 * sibilance_guard);
);
strict_eq_on ? (
  focus_gain_target = 0;
);
keep_static_active ? (
  focus_freq_target = focus_freq_hz;
  focus_q_target = focus_q_val;
  focus_gain_target = focus_gain_db;
);
focus_coeff = (capture_freeze_mode || keep_static_active) ? 1 : exp(-samplesblock / max(1, srate * (0.18 + focus_stability_mix * 2.20)));
focus_freq_hz = focus_freq_hz * focus_coeff + focus_freq_target * (1 - focus_coeff);
focus_q_val = focus_q_val * focus_coeff + focus_q_target * (1 - focus_coeff);
focus_gain_db = focus_gain_db * focus_coeff + focus_gain_target * (1 - focus_coeff);
focus_settle = abs(focus_freq_target - focus_freq_hz) / 1800 + abs(focus_q_target - focus_q_val) + abs(focus_gain_target - focus_gain_db) / max(0.1, max_curve_db);
set_peaking(focusL_mem, 0, focus_freq_hz, focus_q_val, focus_gain_db);
set_peaking(focusR_mem, 0, focus_freq_hz, focus_q_val, focus_gain_db);

harm_amt_eff = (strict_eq_on || capture_live_mode) ? 0 : harm_amt;
even_target = harm_amt_eff * (0.10 + 0.45 * warm_bias) * (0.30 + 0.70 * (low_norm * 0.55 + mid_norm * 0.45));
odd_target = harm_amt_eff * (0.08 + 0.58 * air_bias) * (0.25 + 0.75 * (mid_norm * 0.35 + high_norm * 0.65));
odd_target *= (1 - 0.70 * sibilance_guard);
odd_target *= (1 - 0.80 * ultrahigh_guard);
odd_target *= (1 - 0.55 * ultra_descend_need);
low_target = harm_amt_eff * warm_bias * low_norm * 0.45;

harm_even = harm_even * harm_coeff + even_target * (1 - harm_coeff);
harm_odd = harm_odd * harm_coeff + odd_target * (1 - harm_coeff);
harm_low = harm_low * harm_coeff + low_target * (1 - harm_coeff);
harm_settle = abs(even_target - harm_even) + abs(odd_target - harm_odd) + abs(low_target - harm_low);
match_settle_db = eq_settle_sum + band_shape_settle + shape_settle + focus_settle;
harm_settle_amt = harm_settle;

read_curve_db = sum_abs / NUM_BANDS + abs(focus_gain_db) * 0.35 + abs(speech_presence_db) * 0.20 + abs(speech_body_db) * 0.15;
target_ref_power = profile_live_weight ? rms_ref : keep_ref_rms;
raw_delta_db = clamp(safe_db(sqrt(max(rms_dry_st, 0))) - safe_db(sqrt(max(rms_ref_st, 0))), -24, 24);
raw_delta_db > delta_live_db ? (
  delta_live_db = delta_live_db * delta_smooth_att + raw_delta_db * (1 - delta_smooth_att);
) : (
  delta_live_db = delta_live_db * delta_smooth_rel + raw_delta_db * (1 - delta_smooth_rel);
);
target_delta_display = profile_live_weight ? delta_live_db : keep_delta_db;
capture_live_mode ? (
  target_delta_display = capture_delta_latch_db;
);
cur_ref_db = safe_db(sqrt(max(target_ref_power, 0)));
ref_display_valid = profile_live_weight ? (ref_active || rms_ref > 0.0000001) : keep_ready;
ref_display_valid ? (
  read_ref_hold_db = cur_ref_db;
  delta_diff_db = target_delta_display - read_delta_hold_db;
  abs(delta_diff_db) <= delta_deadband_db ? (
    delta_step_db = 0;
  ) : delta_diff_db > 0 ? (
    delta_step_db = min(delta_diff_db, delta_slew_up_db_block);
  ) : (
    delta_step_db = max(delta_diff_db, -delta_slew_dn_db_block);
  );
  read_delta_hold_db += delta_step_db;
) : (
  keep_ready ? (
    read_ref_hold_db = cur_ref_db;
    read_delta_hold_db = profile_live_weight ? read_delta_hold_db : keep_delta_db;
  ) : (
    read_ref_hold_db = -240;
    read_delta_hold_db = 0;
  );
);
read_ref_db = read_ref_hold_db;
read_delta_db = read_delta_hold_db;
slider15 = read_curve_db;
slider17 = read_ref_db;
slider16 = safe_db(gm_gain);
read_out_db = safe_db(sqrt(max(rms_out, 0)));
slider18 = read_out_db;
slider24 = read_delta_db;
diag_mode == 3 ? (
  diag_null_ratio = diag_sum_ww > 0.000000000001 ? (diag_sum_wd / diag_sum_ww) : 1;
  diag_offset_db = clamp(log(max(abs(diag_null_ratio), 0.000000000001)) * log2db, -60, 24);
) : (
  diag_offset_db = clamp(safe_db(sqrt(max(diag_rms_proc, 0.000000000001))) - safe_db(sqrt(max(diag_rms_ref, 0.000000000001))), -60, 24);
);
diag_null_rel_db = clamp(safe_db(sqrt(max(diag_rms_null, 0.000000000001))) - safe_db(sqrt(max(diag_rms_ref, 0.000000000001))), -120, 24);
slider108 = diag_mode == 0 ? 0 : diag_offset_db;
slider109 = diag_mode == 0 ? -120 : diag_null_rel_db;
// Calcola e mostra il guadagno di normalizzazione RMS applicato
out_norm_db = safe_db(out_norm_gain);
slider93 = out_norm_db;
i = 0;
loop(NUM_BANDS,
  gfx_eq_snapshot[i] = eq_gain_db[i];
  i += 1;
);
gfx_read_curve_db = read_curve_db;
gfx_read_ref_db = read_ref_db;
gfx_read_out_db = read_out_db;
gfx_read_match_db = safe_db(gm_gain);
gfx_read_delta_db = read_delta_db;
profile_mode == 1 ? (
  capture_progress = 100 * capture_count / max(1, capture_target_samples);
) : (
  capture_progress = keep_ready ? 100 : 0;
);
slider21 = clamp(capture_progress, 0, 100);
gfx_capture_progress = capture_progress;
gfx_profile_mode = profile_mode;
gfx_routing_state = routing_state;
gfx_panic_flash = panic_flash_counter;
gfx_panic_count = panic_count;
gfx_recover_flash = recover_flash_counter;
gfx_recover_count = recover_count;
gfx_follow_fill = profile_mode == 0 ? max(follow_fill_ratio, ref_mix_state) : 1;
gfx_match_settle = match_settle_db;
gfx_harm_settle = harm_settle_amt;
slider98 = clamp(eff_match_amt, 0, 1);
slider99 = clamp(mirror_error_mix, 0, 1);
slider100 = curve_time_sec;
slider101 = clamp(raw_err_avg_db, 0, 12);
follow_ready_keep = (!idle_mode && profile_mode == 0 && ref_active && prog_active
  && gfx_follow_fill >= 0.82
  && ref_mix_state >= 0.78
  && match_settle_db <= 1.35
  && harm_settle_amt <= 0.20
  && mirror_error_mix <= 0.32);
gfx_follow_ready_keep = follow_ready_keep;

routing_wait = routing_state != 0 && !(profile_mode == 2 && keep_ready) && !idle_mode;
ui_status_state = 2;
(panic_flash_counter > 0 || recover_flash_counter > 0 || panic_cooldown_counter > 0 || recover_cooldown_counter > 0 || routing_wait) ? (
  ui_status_state = 0;
) : idle_mode ? (
  ui_status_state = 0;
) : profile_mode == 0 ? (
  (!ref_active || !prog_active || gfx_follow_fill < 0.08) ? (
    ui_status_state = 0;
  ) : follow_ready_keep ? (
    ui_status_state = 2;
  ) : (
    ui_status_state = 1;
  );
) : profile_mode == 1 ? (
  (ref_active && prog_active && capture_progress < 99.5) ? (
    ui_status_state = 1;
  ) : (
    ui_status_state = (capture_progress >= 99.5 || keep_ready) ? 2 : 0;
  );
) : (
  ui_status_state = keep_ready ? 2 : 0;
);
gfx_status_state = ui_status_state;

@sample
raw_dryL = spl0;
raw_dryR = spl1;
raw_scL = spl2;
raw_scR = spl3;
dryL = raw_dryL * in_trim;
dryR = raw_dryR * in_trim;
scL = raw_scL * sc_trim;
scR = raw_scR * sc_trim;

in_mono = 0.5 * (dryL + dryR);
sc_mono = 0.5 * (scL + scR);
capture_dry_p = 0.5 * (dryL * dryL + dryR * dryR);
capture_ref_p = 0.5 * (scL * scL + scR * scR);

diag_ref_abs = diag_ref_abs * 0.999 + (0.5 * (abs(raw_scL) + abs(raw_scR))) * 0.001;
diag_same_abs = diag_same_abs * 0.999 + (0.5 * (abs(raw_scL - raw_dryL) + abs(raw_scR - raw_dryR))) * 0.001;

ref_ctrl = 0.5 * (abs(scL) + abs(scR));
ref_ctrl > ref_gate_env ? (
  ref_gate_env = ref_gate_att * ref_gate_env + (1 - ref_gate_att) * ref_ctrl;
) : (
  ref_gate_env = ref_gate_rel * ref_gate_env + (1 - ref_gate_rel) * ref_ctrl;
);

ref_gate_env > ref_on_thr ? (
  ref_hold_counter = ref_hold_samples;
) : (
  ref_hold_counter = max(0, ref_hold_counter - 1);
);
ref_active = ref_hold_counter > 0;

num_ch < 4 ? (
  routing_state = 3; // track not wide enough for SC routing
) : ref_active ? (
  routing_state = diag_same_abs < (max(diag_ref_abs, 0.000001) * 0.12) ? 2 : 0;
) : diag_ref_abs < 0.00002 ? (
  routing_state = 1; // missing sidechain
) : diag_same_abs < (diag_ref_abs * 0.12) ? (
  routing_state = 2; // mirrored with main input
) : (
  routing_state = 0; // ok
);

abs_in = max(abs(dryL), abs(dryR));
abs_sc = max(abs(scL), abs(scR));
// Rilevazione transiente HF su dry: separa fricative rapide dal contenuto tonale.
sibil_hf_lpL += (dryL - sibil_hf_lpL) * sibil_hf_lp_coeff;
sibil_hf_lpR += (dryR - sibil_hf_lpR) * sibil_hf_lp_coeff;
sibil_hf_probe = 0.5 * (abs(dryL - sibil_hf_lpL) + abs(dryR - sibil_hf_lpR));
sibil_hf_probe > sibil_fast ? (
  sibil_fast = sibil_fast * sibil_fast_att + (1 - sibil_fast_att) * sibil_hf_probe;
) : (
  sibil_fast = sibil_fast * sibil_fast_rel + (1 - sibil_fast_rel) * sibil_hf_probe;
);
sibil_slow = sibil_slow * sibil_slow_coeff + (1 - sibil_slow_coeff) * sibil_hf_probe;
sibil_transient = clamp((sibil_fast - sibil_slow - 0.0025) / 0.020, 0, 1);

prog_ctrl = 0.5 * (abs(dryL) + abs(dryR));
prog_ctrl > prog_gate_env ? (
  prog_gate_env = prog_gate_att * prog_gate_env + (1 - prog_gate_att) * prog_ctrl;
) : (
  prog_gate_env = prog_gate_rel * prog_gate_env + (1 - prog_gate_rel) * prog_ctrl;
);

prog_gate_env > prog_on_thr ? (
  prog_hold_counter = prog_hold_samples;
) : (
  prog_hold_counter = max(0, prog_hold_counter - 1);
);
prog_active = prog_hold_counter > 0;

live_follow_mode && ref_active && prog_active && abs_in > 0.00003 && abs_sc > 0.00003 ? (
  follow_fill_counter = min(follow_fill_target_samples, follow_fill_counter + 1);
) : live_follow_mode ? (
  follow_fill_counter = max(0, follow_fill_counter - follow_fill_release_step);
);
follow_fill_ratio = clamp(follow_fill_counter / max(1, follow_fill_target_samples), 0, 1);

abs_in > in_env ? (
  in_env = env_att * in_env + (1 - env_att) * abs_in;
) : (
  in_env = env_rel * in_env + (1 - env_rel) * abs_in;
);

abs_sc > sc_env ? (
  sc_env = env_att * sc_env + (1 - env_att) * abs_sc;
) : (
  sc_env = env_rel * sc_env + (1 - env_rel) * abs_sc;
);

capture_live_mode && ref_active && prog_active && abs_in > 0.00003 && abs_sc > 0.00003 ? (
  capture_progress_ratio = capture_count / max(1, capture_target_samples);
  capture_sample_weight = capture_progress_ratio > 0.90 ? (
    1 - 0.55 * clamp((capture_progress_ratio - 0.90) / 0.10, 0, 1)
  ) : 1;
  capture_ref_sum += capture_ref_p * capture_sample_weight;
  capture_dry_sum += capture_dry_p * capture_sample_weight;
  capture_weight_sum += capture_sample_weight;
);

i = 0;
loop(NUM_BANDS,
  band_in = biquad_process(bp_in, i, in_mono);
  band_sc = biquad_process(bp_sc, i, sc_mono);
  band_in_p = band_in * band_in;
  band_sc_p = band_sc * band_sc;
  band_profile_coeff = live_follow_mode ? profile_live_coeff : profile_coeff;
  valid_profile_sample = ref_active && prog_active && abs_in > 0.00003 && abs_sc > 0.00003;
  live_follow_mode ? (
    valid_profile_sample ? (
      in_avg[i] = in_avg[i] * band_profile_coeff + band_in_p * (1 - band_profile_coeff);
      sc_avg[i] = sc_avg[i] * band_profile_coeff + band_sc_p * (1 - band_profile_coeff);
    );
  ) : (
    abs_in > 0.00003 ? (
      in_avg[i] = in_avg[i] * band_profile_coeff + band_in_p * (1 - band_profile_coeff);
    );
    ref_active && abs_sc > 0.00003 ? (
      sc_avg[i] = sc_avg[i] * band_profile_coeff + band_sc_p * (1 - band_profile_coeff);
    );
  );
  capture_live_mode && ref_active && prog_active && abs_in > 0.00003 && abs_sc > 0.00003 ? (
    capture_sum[i] += band_sc_p * capture_sample_weight;
    capture_in_sum[i] += band_in_p * capture_sample_weight;
  );
  i += 1;
);

capture_live_mode && ref_active && prog_active && abs_in > 0.00003 && abs_sc > 0.00003 && capture_count < capture_target_samples ? (
  capture_count += 1;
  capture_count >= capture_target_samples ? (
    // Capture timed completato: salva la media reale catturata in Keep.
    dbg_capture_done_count += 1;
    capture_count = capture_target_samples;
    commit_keep_snapshot_from_capture();
    slider21 = 100;
    set_profile_mode(2);
    profile_mode = 2;
  );
);

eqL = dryL;
eqR = dryR;
dsp_active = (panic_cooldown_counter <= 0) && (recover_cooldown_counter <= 0) && (
  !idle_mode &&
  (profile_mode == 2 && keep_ready)
  || (follow_live_mode && follow_profile_ready && ref_active)
  || (capture_live_mode && follow_profile_ready && ref_active)
);

dsp_active ? (
  i = 0;
  loop(NUM_BANDS,
    eqL = biquad_process(eqL_mem, i, eqL);
    eqR = biquad_process(eqR_mem, i, eqR);
    i += 1;
  );
  eqL = biquad_process(shapeL_mem, 0, eqL);
  eqL = biquad_process(shapeL_mem, 1, eqL);
  eqL = biquad_process(shapeL_mem, 2, eqL);
  speechL = eqL;
  speech_mix > 0.02 ? (
    speechL = biquad_process(shapeL_mem, 3, speechL);
    speechL = biquad_process(shapeL_mem, 4, speechL);
    speechL = biquad_process(shapeL_mem, 5, speechL);
    speechL = biquad_process(shapeL_mem, 6, speechL);
    eqL += (speechL - eqL) * speech_mix;
  );
  eqL = biquad_process(focusL_mem, 0, eqL);
  eqR = biquad_process(shapeR_mem, 0, eqR);
  eqR = biquad_process(shapeR_mem, 1, eqR);
  eqR = biquad_process(shapeR_mem, 2, eqR);
  speechR = eqR;
  speech_mix > 0.02 ? (
    speechR = biquad_process(shapeR_mem, 3, speechR);
    speechR = biquad_process(shapeR_mem, 4, speechR);
    speechR = biquad_process(shapeR_mem, 5, speechR);
    speechR = biquad_process(shapeR_mem, 6, speechR);
    eqR += (speechR - eqR) * speech_mix;
  );
  eqR = biquad_process(focusR_mem, 0, eqR);

  (is_bad_audio(eqL) || is_bad_audio(eqR)) ? (
    recover_dsp();
    eqL = dryL;
    eqR = dryR;
  );

  env_src = max(abs(eqL), abs(eqR));
  env_src > harm_env ? (
    harm_env = env_att * harm_env + (1 - env_att) * env_src;
  ) : (
    harm_env = env_rel * harm_env + (1 - env_rel) * env_src;
  );

  dyn_scale = 1 + ((harm_env / 0.14) - 1) * harm_dyn;
  keep_static_active ? (
    dyn_scale = 1;
  );
  dyn_scale = clamp(dyn_scale, 0.55, 1.85);

  hp_lp_L += (eqL - hp_lp_L) * hp_lp_coeff;
  hp_lp_R += (eqR - hp_lp_R) * hp_lp_coeff;
  hiL = eqL - hp_lp_L;
  hiR = eqR - hp_lp_R;

  even_drive = harm_even * dyn_scale;
  odd_drive = harm_odd * dyn_scale;

  odd_termL = (hiL - hiL * hiL * hiL) + (0.15 * hiL * abs(hiL));
  odd_termR = (hiR - hiR * hiR * hiR) + (0.15 * hiR * abs(hiR));
  even_termL = hiL * abs(hiL);
  even_termR = hiR * abs(hiR);

  harm_deltaL = even_drive * 0.32 * even_termL + odd_drive * 0.55 * odd_termL;
  harm_deltaR = even_drive * 0.32 * even_termR + odd_drive * 0.55 * odd_termR;

  low_src = 0.5 * (eqL + eqR);
  low_lp += (low_src - low_lp) * low_lp_coeff;
  low_sat = ((low_lp * 2.4) / (1 + abs(low_lp * 2.4))) * harm_low * dyn_scale;

  wetL = eqL + harm_deltaL + low_sat;
  wetR = eqR + harm_deltaR + low_sat;

  band_hp_coeff = 1 - exp(-2 * $pi * clamp(adaptive_hp_hz, 20, 900) / srate);
  band_lp_coeff2 = 1 - exp(-2 * $pi * clamp(adaptive_lp_hz, 6000, 20000) / srate);
  band_hp_memL += (wetL - band_hp_memL) * band_hp_coeff;
  band_hp_memR += (wetR - band_hp_memR) * band_hp_coeff;
  band_passL = wetL - band_hp_memL;
  band_passR = wetR - band_hp_memR;
  band_lp_memL += (band_passL - band_lp_memL) * band_lp_coeff2;
  band_lp_memR += (band_passR - band_lp_memR) * band_lp_coeff2;
  wetL += (band_lp_memL - wetL) * band_shape_mix;
  wetR += (band_lp_memR - wetR) * band_shape_mix;

  // Filtri di protezione: HP 20Hz e LP 20kHz
  wetL = biquad_process(airlpL_mem, 0, wetL);
  wetR = biquad_process(airlpR_mem, 0, wetR);
  wetL = biquad_process(airlp2L_mem, 0, wetL);
  wetR = biquad_process(airlp2R_mem, 0, wetR);
  wetL = biquad_process(airhpL_mem, 0, wetL);
  wetR = biquad_process(airhpR_mem, 0, wetR);
  wetL = biquad_process(hp20L_mem, 0, wetL);
  wetR = biquad_process(hp20R_mem, 0, wetR);
  wetL = biquad_process(lp20kL_mem, 0, wetL);
  wetR = biquad_process(lp20kR_mem, 0, wetR);

  (is_bad_audio(wetL) || is_bad_audio(wetR)) ? (
    recover_dsp();
    wetL = eqL;
    wetR = eqR;
  );
) : (
  harm_env = 0;
  harm_even = 0;
  harm_odd = 0;
  harm_low = 0;
  hp_lp_L = 0;
  hp_lp_R = 0;
  low_lp = 0;
  band_hp_memL = 0;
  band_hp_memR = 0;
  band_lp_memL = 0;
  band_lp_memR = 0;
  band_shape_mix = 0;
  wetL = dryL;
  wetR = dryR;
);

// Diagnostica match read-only (non influenza il percorso audio)
diag_valid = ref_active && prog_active && abs_in > 0.00003 && abs_sc > 0.00003;
diag_proc_mono = 0.5 * (wetL + wetR);
diag_ref_mono = 0.5 * (scL + scR);
diag_mode == 2 ? (
  // Perceptual mode: approssimazione leggera tipo K-weight (shelf+HP one-pole)
  diag_lp_proc += (diag_proc_mono - diag_lp_proc) * diag_lp_coeff;
  diag_lp_ref += (diag_ref_mono - diag_lp_ref) * diag_lp_coeff;
  diag_hs_proc = diag_proc_mono + (diag_proc_mono - diag_lp_proc) * 1.6;
  diag_hs_ref = diag_ref_mono + (diag_ref_mono - diag_lp_ref) * 1.6;
  diag_hp_proc += (diag_hs_proc - diag_hp_proc) * diag_hp_coeff;
  diag_hp_ref += (diag_hs_ref - diag_hp_ref) * diag_hp_coeff;
  diag_kw_proc = diag_hs_proc - diag_hp_proc;
  diag_kw_ref = diag_hs_ref - diag_hp_ref;
  diag_det_proc_p = diag_kw_proc * diag_kw_proc;
  diag_det_ref_p = diag_kw_ref * diag_kw_ref;
) : (
  diag_det_proc_p = 0.5 * (wetL * wetL + wetR * wetR);
  diag_det_ref_p = 0.5 * (scL * scL + scR * scR);
);
diag_nullL = wetL - scL;
diag_nullR = wetR - scR;
diag_null_p = 0.5 * (diag_nullL * diag_nullL + diag_nullR * diag_nullR);
diag_valid ? (
  diag_rms_proc = diag_rms_proc * diag_coeff + (1 - diag_coeff) * diag_det_proc_p;
  diag_rms_ref = diag_rms_ref * diag_coeff + (1 - diag_coeff) * diag_det_ref_p;
  diag_rms_null = diag_rms_null * diag_coeff + (1 - diag_coeff) * diag_null_p;
  diag_mode == 3 ? (
    diag_sum_wd = diag_sum_wd * diag_coeff + (1 - diag_coeff) * (diag_proc_mono * diag_ref_mono);
    diag_sum_ww = diag_sum_ww * diag_coeff + (1 - diag_coeff) * (diag_proc_mono * diag_proc_mono);
  );
) : (
  diag_rms_proc *= diag_coeff;
  diag_rms_ref *= diag_coeff;
  diag_rms_null *= diag_coeff;
  diag_sum_wd *= diag_coeff;
  diag_sum_ww *= diag_coeff;
);

dry_p = capture_dry_p;
wet_p = 0.5 * (wetL * wetL + wetR * wetR);
rms_ref_src = capture_ref_p;
prog_active ? (
  rms_dry = rms_dry * rms_coeff + (1 - rms_coeff) * dry_p;
  rms_wet = rms_wet * rms_coeff + (1 - rms_coeff) * wet_p;
  rms_dry_st = rms_dry_st * lufs_s_coeff + (1 - lufs_s_coeff) * dry_p;
) : (
  rms_dry_st *= lufs_s_coeff;
);
ref_active ? (
  rms_ref = rms_ref * rms_coeff + (1 - rms_coeff) * rms_ref_src;
  rms_ref_st = rms_ref_st * lufs_s_coeff + (1 - lufs_s_coeff) * rms_ref_src;
) : (
  rms_ref_st *= lufs_s_coeff;
);

monL = monitor_mode == 1 ? (eqL - dryL)
     : monitor_mode == 2 ? (wetL - eqL)
     : (dryL * mix_dry + wetL * mix_wet);

monR = monitor_mode == 1 ? (eqR - dryR)
     : monitor_mode == 2 ? (wetR - eqR)
     : (dryR * mix_dry + wetR * mix_wet);

(follow_live_mode || capture_live_mode) ? (
  follow_entry_mix = follow_entry_mix * follow_entry_att + (1 - follow_entry_att);
  follow_baseL = monitor_mode == 0 ? dryL : 0;
  follow_baseR = monitor_mode == 0 ? dryR : 0;
  monL = follow_baseL + (monL - follow_baseL) * follow_entry_mix;
  monR = follow_baseR + (monR - follow_baseR) * follow_entry_mix;
) : (
  follow_entry_mix = 1;
);

proc_p = 0.5 * (monL * monL + monR * monR);
prog_active ? (
  rms_proc = rms_proc * rms_coeff + (1 - rms_coeff) * proc_p;
  rms_proc_st = rms_proc_st * lufs_s_coeff + (1 - lufs_s_coeff) * proc_p;
) : (
  rms_proc_st *= lufs_s_coeff;
);

gm_target = gm_gain;
gm_on ? (
  target_ref_power = profile_live_weight ? rms_ref : keep_ref_rms;
  target_ref_power_st = profile_live_weight ? rms_ref_st : keep_ref_rms;
  target_delta_gain = profile_live_weight ? read_delta_db : keep_delta_db;
  target_proc_power_st = max(rms_proc_st, 0.0000001);
  prog_active && profile_ready && target_ref_power_st > 0.0000001 ? (
    gm_ref_db_st = safe_db(sqrt(max(target_ref_power_st, 0)));
    gm_ref_db_lt = safe_db(sqrt(max(target_ref_power, 0)));
    gm_proc_db_st = safe_db(sqrt(max(target_proc_power_st, 0)));
    gm_proc_db_lt = safe_db(sqrt(max(rms_proc, 0.0000001)));
    gm_err_db_st = gm_ref_db_st - gm_proc_db_st;
    gm_err_db_lt = gm_ref_db_lt - gm_proc_db_lt;
    gm_err_db = gm_err_db_st * 0.72 + gm_err_db_lt * 0.28;
    abs(gm_err_db) <= 0.25 ? (
      gm_err_db = 0;
    ) : gm_err_db > 0 ? (
      gm_err_db -= 0.25;
    ) : (
      gm_err_db += 0.25;
    );
    gm_err_db *= 0.82;
    gm_err_db += safe_db(target_offset_amp);
    level_target_mode == 1 ? (
      gm_err_db += target_delta_gain;
    );
    gm_target = db_to_amp(gm_err_db);
    gm_target = clamp(gm_target, 0.35, 2.80);
  ) : (
    gm_target = 1;
  );
);
last_gm_on != gm_on ? (
  // evita reset/strappi quando Auto Level viene attivato durante playback
  gm_target = gm_gain;
  last_gm_on = gm_on;
);
gm_target = 1 + (gm_target - 1) * gm_mix_state;

gm_target < gm_gain ? (
  gm_gain = gm_att * gm_gain + (1 - gm_att) * gm_target;
) : (
  gm_gain = gm_rel * gm_gain + (1 - gm_rel) * gm_target;
);

// ============================================
// AUTOMATIC GAIN CONTROL: Mantiene il livello dell'input
// ============================================
// Questo stadio compensa automaticamente le variazioni di livello
// causate da EQ, Harmonics e altri processi, mantenendo l'output
// allo stesso livello RMS dell'input originale.
// Applicato dopo tutti i processi ma prima del gain manuale.
agc_lo = db_to_amp(-agc_range_db);
agc_hi = db_to_amp(agc_range_db);
out_norm_on && rms_proc > 0.0000001 && rms_dry > 0.0000001 ? (
  // Quando AutoLvl e' attivo, allinea AGC allo stesso target (reference),
  // evitando conflitto tra gm_gain e out_norm_gain.
  rms_at_norm = rms_proc * gm_gain * gm_gain;
  agc_ref_rms = (gm_on && profile_ready) ? (profile_live_weight ? rms_ref : keep_ref_rms) : rms_dry;
  agc_ref_rms = max(agc_ref_rms, 0.0000001);
  out_norm_target = sqrt(agc_ref_rms / max(rms_at_norm, 0.0000001));
  out_norm_target *= agc_trim_amp;
  out_norm_target = clamp(out_norm_target, agc_lo, agc_hi);
  out_norm_gain < out_norm_target ? (
    out_norm_gain = out_norm_gain * agc_att + (1 - agc_att) * out_norm_target;
  ) : (
    out_norm_gain = out_norm_gain * agc_rel + (1 - agc_rel) * out_norm_target;
  );
) : out_norm_on ? (
  out_norm_gain = out_norm_gain * agc_idle + (1 - agc_idle) * 1.0;
) : (
  out_norm_gain = 1;
);

outL = monL * gm_gain * out_norm_gain * out_gain;
outR = monR * gm_gain * out_norm_gain * out_gain;

// Guard rail AGC: evita overshoot nel controllo RMS
agc_peak = max(abs(outL), abs(outR));
agc_floor = max(agc_lo, 0.40);
agc_peak > 0.86 && out_norm_gain > agc_floor ? (
  agc_safe = clamp(0.86 / max(0.000001, agc_peak), agc_floor / max(0.000001, out_norm_gain), 1.0);
  out_norm_gain *= agc_safe;
  out_norm_gain = clamp(out_norm_gain, agc_lo, agc_hi);
  outL = monL * gm_gain * out_norm_gain * out_gain;
  outR = monR * gm_gain * out_norm_gain * out_gain;
);

out_peak = max(abs(outL), abs(outR));
safety_target = out_peak > 0.98 ? (0.98 / out_peak) : 1;
safety_target < safety_gain ? (
  safety_gain = safety_gain * safety_att + (1 - safety_att) * safety_target;
) : (
  safety_gain = safety_gain * safety_rel + (1 - safety_rel) * safety_target;
);
outL *= safety_gain;
outR *= safety_gain;

startup_mix = startup_mix * startup_att + (1 - startup_att);
bypassL = dryL * out_gain;
bypassR = dryR * out_gain;
outL = bypassL + (outL - bypassL) * startup_mix;
outR = bypassR + (outR - bypassR) * startup_mix;

init_guard_mix = init_guard_mix * init_guard_att + (1 - init_guard_att);
outL = bypassL + (outL - bypassL) * init_guard_mix;
outR = bypassR + (outR - bypassR) * init_guard_mix;

init_guard_mix < 0.9995 ? (
  outL = prev_outL * init_declick_coeff + outL * (1 - init_declick_coeff);
  outR = prev_outR * init_declick_coeff + outR * (1 - init_declick_coeff);
);

prev_outL = outL;
prev_outR = outR;

outL = sanitize_audio(outL);
outR = sanitize_audio(outR);
// A/B listen puro: POST FX vs Sidechain Ref.
ref_listenL = sanitize_audio(scL);
ref_listenR = sanitize_audio(scR);
listen_target = listen_mode >= 1 ? 1 : 0;
listen_ab_mix = listen_ab_mix * listen_xfade_coeff + listen_target * (1 - listen_xfade_coeff);
outL = outL * (1 - listen_ab_mix) + ref_listenL * listen_ab_mix;
outR = outR * (1 - listen_ab_mix) + ref_listenR * listen_ab_mix;

out_p = 0.5 * (outL * outL + outR * outR);
prog_active ? (
  rms_out = rms_out * rms_coeff + (1 - rms_coeff) * out_p;
);

out_abs = max(abs(outL), abs(outR));
read_out_db = safe_db(sqrt(max(rms_out, 0)));
out_abs > out_env ? (
  out_env = env_att * out_env + (1 - env_att) * out_abs;
) : (
  out_env = env_rel * out_env + (1 - env_rel) * out_abs;
);

spl0 = outL;
spl1 = outR;
spl2 = 0;
spl3 = 0;

@gfx 760 470
gfx_set(0.08, 0.09, 0.11, 1);
gfx_rect(0, 0, gfx_w, gfx_h);

ui_mode = clamp(floor(slider19 + 0.5), 0, 1);
mouse_down = mouse_cap & 1;
profile_mode = clamp(floor(slider20 + 0.5), 0, 2);
strict_eq_on = slider97 >= 0.5;
diag_mode = clamp(floor(slider107 + 0.5), 0, 3);
listen_mode = floor(slider104);

gfx_setfont(1, "Arial", 18);
gfx_r = 0.93; gfx_g = 0.95; gfx_b = 0.98; gfx_a = 1;
gfx_x = 22; gfx_y = 18;
gfx_drawstr("Tone Mirror EQ Pro");
gfx_setfont(1, "Arial", 13);
gfx_r = 0.60; gfx_g = 0.66; gfx_b = 0.74;
gfx_x = 24; gfx_y = 42;
gfx_drawstr("Profilo medio sidechain + broad EQ + harmonics + level match");

gfx_setfont(1, "Arial", 12);
routing_state == 0 ? (
  gfx_r = 0.36; gfx_g = 0.84; gfx_b = 0.56;
  gfx_x = 24; gfx_y = 60;
  gfx_drawstr("Routing: Reference sidechain OK");
) : routing_state == 3 ? (
  gfx_r = 0.96; gfx_g = 0.72; gfx_b = 0.26;
  gfx_x = 24; gfx_y = 60;
  gfx_drawstr("Routing: la traccia deve avere 4 canali");
) : routing_state == 1 ? (
  gfx_r = 0.96; gfx_g = 0.72; gfx_b = 0.26;
  gfx_x = 24; gfx_y = 60;
  gfx_drawstr("Routing: nessun segnale su Reference 3/4");
) : (
  gfx_r = 0.96; gfx_g = 0.64; gfx_b = 0.26;
  gfx_x = 24; gfx_y = 60;
  gfx_drawstr("Routing: Reference sta leggendo lo stesso segnale di Input");
);

gfx_setfont(1, "Arial", 11);
routing_state == 0 ? (
  gfx_r = 0.54; gfx_g = 0.60; gfx_b = 0.68;
  gfx_x = 24; gfx_y = 76;
  gfx_drawstr("Ingresso audio su 1/2, reference su 3/4, uscita misurata su 1/2.");
) : routing_state == 3 ? (
  gfx_r = 0.82; gfx_g = 0.84; gfx_b = 0.88;
  gfx_x = 24; gfx_y = 76;
  gfx_drawstr("Quick fix: imposta Track channels = 4, poi assegna Reference L/R ai canali 3/4.");
) : routing_state == 1 ? (
  gfx_r = 0.82; gfx_g = 0.84; gfx_b = 0.88;
  gfx_x = 24; gfx_y = 76;
  gfx_drawstr("Quick fix: send della sorgente verso 3/4, non 1/2. In Keep puoi ancora usare il profilo catturato.");
) : (
  gfx_r = 0.82; gfx_g = 0.84; gfx_b = 0.88;
  gfx_x = 24; gfx_y = 76;
  gfx_drawstr("Quick fix: lascia il programma su 1/2 e manda il reference solo su 3/4.");
);

  jsfx_btn_w = 80;
  lite_btn_w = 80;
  ab_btn_w = 92;
  strict_btn_w = 104;
  profile_btn_w = 76;
  top_gap = 10;
  profile_gap = 8;
  right_margin = 20;
  mode_btn_y = 92;
  lite_title_y = 132;
  lite_text_y1 = 168;
  lite_text_y2 = 190;
  lite_text_y3 = 216;
  lite_text_y4 = 238;
  lite_text_y5 = 260;
  status_y = 176;
  metrics_box_y = 330;
  metrics_box_h = 104;
  metrics_y1 = 352;
  metrics_y2 = 378;
  metrics_y3 = 404;
  metrics_warn_y = 424;
  preset_btn_y = 286;
  preset_btn_w = 104;
  preset_btn_h = 22;
  preset_btn_gap = 8;
  preset_1_x = 30;
  preset_2_x = preset_1_x + preset_btn_w + preset_btn_gap;
  preset_3_x = preset_2_x + preset_btn_w + preset_btn_gap;
  preset_row2_y = preset_btn_y + preset_btn_h + 6;
  preset_4_x = 30;
  preset_5_x = preset_4_x + preset_btn_w + preset_btn_gap;
  preset_diag_x = preset_5_x + preset_btn_w + preset_btn_gap;
  preset_diag_w = 118;

  jsfx_btn_x = gfx_w - right_margin - jsfx_btn_w;
  strict_btn_x = jsfx_btn_x - top_gap - strict_btn_w;
  ab_btn_x = strict_btn_x - top_gap - ab_btn_w;
  lite_btn_x = ab_btn_x - top_gap - lite_btn_w;
  keep_btn_x = lite_btn_x - 14 - profile_btn_w;
  capture_btn_x = keep_btn_x - profile_gap - profile_btn_w;
  follow_btn_x = capture_btn_x - profile_gap - profile_btn_w;
  clear_btn_x = follow_btn_x - profile_gap - profile_btn_w;

  ui_action_button(clear_btn_x, mode_btn_y, profile_btn_w, 28, "Clear");
  follow_btn_state = (!idle_mode && profile_mode == 0) ? 2 : 0;
  ui_profile_button(0, follow_btn_x, mode_btn_y, profile_btn_w, 28, "Follow", follow_btn_state);
  capture_state = (!idle_mode && profile_mode == 1) ? (
    capture_count < capture_target_samples ? 1 : 2
  ) : ((!idle_mode && profile_mode == 2) ? 2 : 0);
  ui_profile_button(1, capture_btn_x, mode_btn_y, profile_btn_w, 28, "Capture", capture_state);
  ui_profile_button(2, keep_btn_x, mode_btn_y, profile_btn_w, 28, "Keep", (!idle_mode && profile_mode == 2) ? 2 : 0);
  ui_toggle_button(strict_btn_x, mode_btn_y, strict_btn_w, 28, strict_eq_on ? "Strict EQ ON" : "Strict EQ OFF", strict_eq_on) ? (
    slider97 = strict_eq_on ? 0 : 1;
  );
  ui_toggle_button(ab_btn_x, mode_btn_y, ab_btn_w, 28, listen_mode ? "AB: REF" : "AB: POST", listen_mode) ? (
    slider104 = listen_mode ? 0 : 1;
  );
  ui_button(0, lite_btn_x, mode_btn_y, lite_btn_w, 28, "Lite", ui_mode == 0);
  ui_button(1, jsfx_btn_x, mode_btn_y, jsfx_btn_w, 28, "JSFX", ui_mode == 1);

  gfx_setfont(1, "Arial", 22);
  gfx_r = 0.93; gfx_g = 0.95; gfx_b = 0.98;
  gfx_x = 28; gfx_y = lite_title_y;
  gfx_drawstr("Lite Mode");
  gfx_setfont(1, "Arial", 15);
  gfx_r = 0.68; gfx_g = 0.72; gfx_b = 0.78;
  gfx_x = 30; gfx_y = lite_text_y1;
  gfx_drawstr("I controlli nativi dei slider sono visibili.");
  gfx_x = 30; gfx_y = lite_text_y2;
  gfx_drawstr("GUI pesante disattivata: usiamo solo il pannello leggero per stabilizzare il DSP.");
  gfx_x = 30; gfx_y = lite_text_y3;
  routing_state == 0 ? gfx_drawstr("Routing sidechain OK.") : routing_state == 3 ? gfx_drawstr("La traccia deve avere 4 canali per usare il sidechain.") : routing_state == 1 ? gfx_drawstr("Manca segnale su Reference 3/4.") : gfx_drawstr("Reference e Input stanno leggendo la stessa sorgente.");
  gfx_x = 30; gfx_y = lite_text_y4;
  idle_mode ? gfx_drawstr("Profile memory: Idle") : profile_mode == 0 ? gfx_drawstr("Profile memory: Follow") : profile_mode == 1 ? gfx_drawstr(sprintf(#,"Profile memory: Capture %.0f%%", slider21)) : gfx_drawstr("Profile memory: Keep");
  gfx_x = 30; gfx_y = lite_text_y5;
  gfx_drawstr("Capture: Timed");

  gfx_setfont(1, "Arial", 11);
  gfx_r = 0.58; gfx_g = 0.64; gfx_b = 0.72;
  gfx_x = 30; gfx_y = preset_btn_y - 18;
  gfx_drawstr("Preset guida");
  ui_toggle_button(preset_1_x, preset_btn_y, preset_btn_w, preset_btn_h, "Vicino", safe_preset_last == 1) ? (
    apply_safe_preset(1);
  );
  ui_toggle_button(preset_2_x, preset_btn_y, preset_btn_w, preset_btn_h, "Distante", safe_preset_last == 2) ? (
    apply_safe_preset(2);
  );
  ui_toggle_button(preset_3_x, preset_btn_y, preset_btn_w, preset_btn_h, "Voce Stabile", safe_preset_last == 3) ? (
    apply_safe_preset(3);
  );
  ui_toggle_button(preset_4_x, preset_row2_y, preset_btn_w, preset_btn_h, "Basse Ctrl", safe_preset_last == 4) ? (
    apply_safe_preset(4);
  );
  ui_toggle_button(preset_5_x, preset_row2_y, preset_btn_w, preset_btn_h, "Aria Ctrl", safe_preset_last == 5) ? (
    apply_safe_preset(5);
  );
  strcpy(#diag_btn_txt, diag_mode == 1 ? "Diag RMS" : diag_mode == 2 ? "Diag Perc" : diag_mode == 3 ? "Diag Null" : "Diag Off");
  ui_toggle_button(preset_diag_x, preset_row2_y, preset_diag_w, preset_btn_h, #diag_btn_txt, diag_mode > 0) ? (
    slider107 = (diag_mode + 1) % 4;
  );
  preset_hover = 0;
  mouse_y >= preset_btn_y && mouse_y < preset_btn_y + preset_btn_h ? (
    mouse_x >= preset_1_x && mouse_x < preset_1_x + preset_btn_w ? preset_hover = 1;
    mouse_x >= preset_2_x && mouse_x < preset_2_x + preset_btn_w ? preset_hover = 2;
    mouse_x >= preset_3_x && mouse_x < preset_3_x + preset_btn_w ? preset_hover = 3;
  );
  mouse_y >= preset_row2_y && mouse_y < preset_row2_y + preset_btn_h ? (
    mouse_x >= preset_4_x && mouse_x < preset_4_x + preset_btn_w ? preset_hover = 4;
    mouse_x >= preset_5_x && mouse_x < preset_5_x + preset_btn_w ? preset_hover = 5;
    mouse_x >= preset_diag_x && mouse_x < preset_diag_x + preset_diag_w ? preset_hover = 6;
  );
  preset_hover > 0 ? (
    overlay_y = gfx_h - 96;
    gfx_r = 0.15; gfx_g = 0.16; gfx_b = 0.19; gfx_a = 0.98;
    gfx_rect(22, overlay_y, gfx_w - 44, 18);
    gfx_setfont(1, "Arial", 10);
    gfx_r = 0.74; gfx_g = 0.80; gfx_b = 0.88; gfx_a = 1;
    gfx_x = 30; gfx_y = overlay_y + 2;
    preset_hover == 1 ? gfx_drawstr("Vicino: correzione morbida per materiali gia' simili.");
    preset_hover == 2 ? gfx_drawstr("Distante: piu' spazio di correzione per mismatch evidente.");
    preset_hover == 3 ? gfx_drawstr("Voce Stabile: meno inseguimento dell'articolazione in Follow.");
    preset_hover == 4 ? gfx_drawstr("Basse Controllate: limita gonfiore low-end durante il match.");
    preset_hover == 5 ? gfx_drawstr("Aria Controllata: attenua 10k+ e riduce altissime/sibilanti.");
    preset_hover == 6 ? gfx_drawstr("Diag Match: clic per ciclare Off/RMS/Perceptual/Null Hunter.");
  );

  status_x = gfx_w - 190;
  gfx_setfont(1, "Arial", 13);
  gfx_r = 0.72; gfx_g = 0.76; gfx_b = 0.82;
  gfx_x = status_x + 26; gfx_y = status_y - 2;
  gfx_drawstr("Stato Preascolto");
  gfx_status_state == 0 ? (
    gfx_r = 0.94; gfx_g = 0.30; gfx_b = 0.24;
    strcpy(#status_txt, "Rosso: aspetta");
  ) : gfx_status_state == 1 ? (
    gfx_r = 0.96; gfx_g = 0.76; gfx_b = 0.22;
    strcpy(#status_txt, "Giallo: arrivo");
  ) : (
    gfx_r = 0.30; gfx_g = 0.84; gfx_b = 0.42;
    (gfx_follow_ready_keep && profile_mode == 0) ? (
      strcpy(#status_txt, "Verde: pronto Keep");
    ) : (
      strcpy(#status_txt, "Verde: ascolta");
    );
  );
  gfx_a = 1;
  gfx_circle(status_x + 10, status_y + 8, 8, 1, 1);
  gfx_r = 0.90; gfx_g = 0.92; gfx_b = 0.96;
  gfx_x = status_x + 26; gfx_y = status_y + 12;
  gfx_drawstr(#status_txt);
  gfx_setfont(1, "Arial", 11);
  gfx_r = 0.56; gfx_g = 0.62; gfx_b = 0.70;
  gfx_x = status_x + 26; gfx_y = status_y + 32;
  sprintf(#st1, "Fill %.0f%% | EQ %.2f dB", gfx_follow_fill * 100, gfx_match_settle); gfx_drawstr(#st1);
  gfx_x = status_x + 26; gfx_y = status_y + 48;
  sprintf(#st2, "Harm %.2f", gfx_harm_settle); gfx_drawstr(#st2);
