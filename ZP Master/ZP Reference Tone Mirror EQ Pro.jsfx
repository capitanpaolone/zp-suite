i = 0;
loop(NUM_BANDS,
  edge_taper = (i < 3 || i > 27) ? 0.86 : (i < 6 || i > 24) ? 0.92 : 1.0;
  band_weight[i] = edge_taper;
  i += 1;
);

i = 0;
loop(NUM_BANDS,
  in_avg[i] = 0;
  sc_avg[i] = 0;
  eq_gain_db[i] = 0;
  eq_target_db[i] = 0;
  // Se c'era un profilo salvato, ripristina dai slider persistiti
  slider92 >= 0.5 ? (
    keep_avg[i] = slider(30 + i);
    keep_in_avg[i] = slider(61 + i);
  ) : (
    keep_avg[i] = 0;
    keep_in_avg[i] = 0;
  );
  capture_sum[i] = 0;
  i += 1;
);

