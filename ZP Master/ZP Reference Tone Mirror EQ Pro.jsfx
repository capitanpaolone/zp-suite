  tm_hover_tip == 1 ? strcpy(#tm_foot, "Match %: intensita' della curva di allineamento timbrico verso il Reference.")
  : tm_hover_tip == 2 ? strcpy(#tm_foot, "Max Curve (dB): tetto massimo di correzione per banda (valori moderati = suono piu' naturale).")
  : tm_hover_tip == 3 ? strcpy(#tm_foot, "Band Q: piu' basso = curve larghe e morbide; piu' alto = matching piu' selettivo.")
  : tm_hover_tip == 4 ? strcpy(#tm_foot, "Capture Win (s): durata della finestra di analisi per Follow e Capture Timed.")
  : tm_hover_tip == 5 ? strcpy(#tm_foot, "Input Trim (dB): regola il livello di ingresso della traccia 1/2 prima del matching.")
  : tm_hover_tip == 6 ? strcpy(#tm_foot, "Air 10k+ (dB): rifinitura sulle altissime; valori negativi ammorbidiscono sibilanti/aria.")
  : tm_hover_tip == 7 ? strcpy(#tm_foot, "Air LP (Hz): filtro passa-basso di rifinitura sulle altissime frequenze.")
  : tm_hover_tip == 8 ? strcpy(#tm_foot, "Air HP (Hz): filtro passa-alto di rifinitura per controllare il peso sulle basse.")
  : tm_hover_tip == 9 ? strcpy(#tm_foot, "Harmonics (%): supporto armonico dinamico opzionale post-EQ.")
  : tm_hover_tip == 10 ? strcpy(#tm_foot, "Harm Color: bilancia armoniche pari (calore) e dispari (presenza).")
  : tm_hover_tip == 11 ? strcpy(#tm_foot, "AGC Trim (dB): offset manuale applicato al target dell'Automatic Gain Control.")
  : tm_hover_tip == 12 ? strcpy(#tm_foot, "AGC Range (dB): escursione massima consentita al livellatore automatico di uscita.")
  : tm_hover_tip == 13 ? strcpy(#tm_foot, "Dry / Wet (%): miscela tra segnale originale e voce allineata al Reference.")
  : tm_hover_tip == 14 ? strcpy(#tm_foot, "Out Gain (dB): guadagno manuale finale dopo AGC e limiter di sicurezza.")
  : tm_hover_tip == 21 ? strcpy(#tm_foot, "Preset Vicino: correzione morbida per riprese gia' simili al Reference.")
  : tm_hover_tip == 22 ? strcpy(#tm_foot, "Preset Distante: piu' margine di correzione per microfoni o stanze molto diversi.")
  : tm_hover_tip == 23 ? strcpy(#tm_foot, "Preset Voce Stabile: riduce l'inseguimento dei singoli fonemi in Follow.")
  : tm_hover_tip == 24 ? strcpy(#tm_foot, "Preset Basse Ctrl: limita il gonfiore in gamma bassa durante il matching.")
  : strcpy(#tm_foot, "Preset Aria Ctrl: contiene 10k+ se emergono sibilanti o brillantezza eccessiva.");
) : routing_state == 3 ? (
  gfx_set(0.96, 0.78, 0.36, 1);
  strcpy(#tm_foot, ui_lang == 0 ? "Quick fix: apri il Pin Connector, porta la traccia a 4 canali e invia il Reference sui canali 3/4." : "Quick fix: open Pin Connector, set track to 4 channels, and send Reference to channels 3/4.");
) : routing_state == 1 ? (
  gfx_set(0.96, 0.78, 0.36, 1);
  strcpy(#tm_foot, ui_lang == 0 ? "Quick fix: manda il send della traccia Reference su 3/4 (in Keep il profilo salvato funziona anche senza SC)." : "Quick fix: route Reference track send to 3/4 (in Keep mode the saved profile works even without live SC).");
) : routing_state == 2 ? (
