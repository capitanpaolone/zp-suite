  abs_weight = (i <= 10) ? 0.65 : (i >= 27 ? 0.28 : (i >= 22 ? 0.78 : 1.20));
  tone_err_db = shape_err_eff * 0.45 + abs_err_eff * abs_weight;
  tone_drive = strict_eq_on ? 0.95 : (1.00 + 0.45 * clamp((abs(shape_err_eff) + abs(abs_err_eff)) / 7, 0, 1));
