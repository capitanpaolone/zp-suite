  // In Follow/Capture fai entrare le alte in modo progressivo: evita la "campana" transitoria.
  high_stage = 1;
  live_follow_mode ? (
    band_freq[i] >= 10000 ? (
      high_stage = clamp((follow_fill_ratio - 0.68) / 0.32, 0, 1);
    ) : (band_freq[i] >= 6300) ? (
      high_stage = clamp((follow_fill_ratio - 0.35) / 0.65, 0, 1);
    );
  );
  diff_db *= high_stage;
  // Protezione basse: evita high-pass "invisibile" troppo aggressivo.
  i <= 6 ? (
    diff_db = max(diff_db, -(0.7 + 0.08 * max_curve_db));
  ) : i <= 10 ? (
    diff_db = max(diff_db, -(1.2 + 0.10 * max_curve_db));
