// Gate transiente sibilanti: riduce SOLO i boost HF in presenza di "s/sc/x".
hf_sibil_gate = 1 - 0.88 * sibil_transient;

i = 0;
loop(NUM_BANDS,
  in_band_db = tmp_in_db[i] - in_mean_db;
  sc_band_db = tmp_sc_db[i] - sc_mean_db;
  shape_err_db = sc_band_db - in_band_db;
  abs_err_db = tmp_sc_db[i] - tmp_in_db[i];
