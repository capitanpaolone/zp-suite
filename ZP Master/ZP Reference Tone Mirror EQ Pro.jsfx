);

function commit_keep_snapshot_from_live()
local(i) (
  i = 0;
  loop(NUM_BANDS,
    keep_avg[i] = sc_avg[i];
    keep_in_avg[i] = in_avg[i];
    i += 1;
  );
  i = 0;
  loop(NUM_BANDS,
    slider(30 + i) = safe_db(sqrt(max(keep_avg[i], 0)));
    slider(61 + i) = safe_db(sqrt(max(keep_in_avg[i], 0)));
    i += 1;
  );
  keep_ref_rms = rms_ref;
  keep_dry_rms = rms_dry;
  keep_delta_db = read_delta_db;
  keep_ready = 1;
  slider92 = 1;
  capture_count = 0;
  capture_progress = 100;
  slider21 = 100;
);

function commit_keep_snapshot_from_capture()
local(i, inv_count) (
  inv_count = 1 / max(0.000001, capture_weight_sum);

  i = 0;
  loop(NUM_BANDS,
    keep_avg[i] = capture_sum[i] * inv_count;
    keep_in_avg[i] = capture_in_sum[i] * inv_count;
    i += 1;
  );

  i = 0;
  loop(NUM_BANDS,
    slider(30 + i) = safe_db(sqrt(max(keep_avg[i], 0)));
    slider(61 + i) = safe_db(sqrt(max(keep_in_avg[i], 0)));
    i += 1;
  );

  keep_ref_rms = capture_ref_sum * inv_count;
  keep_dry_rms = capture_dry_sum * inv_count;
  keep_delta_db = clamp(
    safe_db(sqrt(max(keep_dry_rms, 0.0000001)))
    - safe_db(sqrt(max(keep_ref_rms, 0.0000001))),
    -24, 24
  );

  keep_ready = 1;
  slider92 = 1;
  capture_count = 0;
  capture_weight_sum = 0;
  capture_progress = 100;
  slider21 = 100;
);

function set_profile_mode(new_mode)
local(mask) (
  new_mode != profile_mode ? (
    dbg_mode_switch_count += 1;
  );
  // Arm DSP only on Follow/Capture. Keep non arma da solo.
  (new_mode == 0 || new_mode == 1) ? (
    engine_armed = 1;
  );
  new_mode == 0 ? (
    // Follow: riparte live e sblocca eventuale profilo Keep
    keep_ready = 0;
    slider92 = 0;
  );
  new_mode == 1 ? (
    // Capture Timed unico: flush Follow + reset accumulo
    clear_live_cache();
    reset_capture_profile();
  );
  new_mode == 2 && profile_mode != 2 ? (
    // Keep manuale: congela lo stato live raggiunto in Follow/Capture
    (engine_armed && (profile_mode == 0 || (profile_mode == 1 && capture_count < capture_target_samples))) ? (
      commit_keep_snapshot_from_live();
    );
  );
  slider20 = new_mode;
  mask = profile_mode_mask;
  sliderchange(mask);
  slider_automate(mask);
);

