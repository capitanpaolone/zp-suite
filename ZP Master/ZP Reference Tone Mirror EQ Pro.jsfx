    keep_avg[i] = slider(30 + i);
    keep_in_avg[i] = slider(61 + i);
  ) : (
    keep_avg[i] = 0;
    keep_in_avg[i] = 0;
  );
  capture_sum[i] = 0;
  i += 1;
);

