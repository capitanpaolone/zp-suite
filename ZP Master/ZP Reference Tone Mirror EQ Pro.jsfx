    // Distante
    slider4 = 92;
    slider5 = 12;
    slider6 = 0.52;
    slider7 = 0;
    slider11 = 1;
    slider22 = 0;
    slider23 = 14;
    slider97 = 1;
    slider102 = -0.8;
    slider103 = 18000;
    slider106 = 30;
  ) : preset_id == 3 ? (
    // Voce Stabile
    slider4 = 84;
    slider5 = 9;
    slider6 = 0.48;
    slider7 = 0;
    slider11 = 1;
    slider22 = 0;
    slider23 = 12;
    slider97 = 1;
    slider102 = -1.2;
    slider103 = 17000;
    slider106 = 40;
  ) : preset_id == 4 ? (
    // Basse Controllate
    slider4 = 86;
    slider5 = 8;
    slider6 = 0.50;
    slider7 = 0;
    slider11 = 1;
    slider22 = 0;
    slider23 = 12;
    slider97 = 1;
