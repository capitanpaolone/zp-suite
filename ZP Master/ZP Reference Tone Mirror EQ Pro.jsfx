function clamp(x, lo, hi) (
  x < lo ? lo : x > hi ? hi : x;
);

function safe_amp(x) (
  x != x ? 0.000000000001 : clamp(abs(x), 0.000000000001, 1000000);
);

function safe_db(x) (
  clamp(log(safe_amp(x)) * log2db, -240, 24);
);

function db_to_amp(x) (
  exp(x * db2log);
);

function mean_range(base, first_idx, last_idx)
local(i, sum, cnt) (
  sum = 0;
  cnt = max(1, last_idx - first_idx + 1);
  i = first_idx;
  loop(cnt,
    sum += base[i];
    i += 1;
  );
  sum / cnt;
);

function soft_deadband(x, thr)
local(ax) (
  ax = abs(x);
  ax <= thr ? 0 : (x > 0 ? ax - thr : -(ax - thr));
);

function sanitize_audio(x) (
  x != x ? 0 : x > 4 ? 4 : x < -4 ? -4 : x;
);

function is_bad_audio(x) (
  (x != x) || abs(x) > 32;
);

function reset_filter_states_n(base, count)
local(i, off) (
  i = 0;
  loop(count,
    off = i * 9;
    base[off + 5] = 0;
    base[off + 6] = 0;
    base[off + 7] = 0;
    base[off + 8] = 0;
    i += 1;
  );
);

function panic_reset()
local(i) (
  reset_filter_states_n(bp_in, NUM_BANDS);
  reset_filter_states_n(bp_sc, NUM_BANDS);
  reset_filter_states_n(eqL_mem, NUM_BANDS);
  reset_filter_states_n(eqR_mem, NUM_BANDS);
  reset_filter_states_n(shapeL_mem, SHAPE_FILTERS);
  reset_filter_states_n(shapeR_mem, SHAPE_FILTERS);
  reset_filter_states_n(focusL_mem, 1);
  reset_filter_states_n(focusR_mem, 1);
  reset_filter_states_n(hp20L_mem, 1);
  reset_filter_states_n(hp20R_mem, 1);
  reset_filter_states_n(lp20kL_mem, 1);
  reset_filter_states_n(lp20kR_mem, 1);
  reset_filter_states_n(airlpL_mem, 1);
  reset_filter_states_n(airlpR_mem, 1);
  reset_filter_states_n(airlp2L_mem, 1);
  reset_filter_states_n(airlp2R_mem, 1);
  reset_filter_states_n(airhpL_mem, 1);
  reset_filter_states_n(airhpR_mem, 1);
  i = 0;
  loop(NUM_BANDS,
    in_avg[i] = 0;
    sc_avg[i] = 0;
    eq_gain_db[i] = 0;
    eq_target_db[i] = 0;
    i += 1;
  );
  in_env = 0; sc_env = 0; out_env = 0;
  rms_dry = 0; rms_wet = 0; rms_ref = 0; rms_proc = 0; rms_out = 0;
  rms_dry_st = 0; rms_ref_st = 0; rms_proc_st = 0;
  gm_gain = 1; gm_target = 1; out_norm_gain = 1;
  gm_mix_state = 0;
  ref_mix_state = 0;
  safety_gain = 1;
  startup_mix = 0;
  follow_entry_mix = 0;
  init_guard_mix = 0;
  prev_outL = 0;
  prev_outR = 0;
  capture_ref_sum = 0;
  capture_dry_sum = 0;
  diag_rms_proc = 0;
  diag_rms_ref = 0;
  diag_rms_null = 0;
  diag_lp_proc = 0;
  diag_lp_ref = 0;
  diag_hp_proc = 0;
  diag_hp_ref = 0;
  diag_sum_wd = 0;
  diag_sum_ww = 0;
  harm_env = 0; harm_even = 0; harm_odd = 0; harm_low = 0;
  hp_lp_L = 0; hp_lp_R = 0; low_lp = 0;
  band_hp_memL = 0; band_hp_memR = 0;
  band_lp_memL = 0; band_lp_memR = 0;
  adaptive_hp_hz = 40;
  adaptive_lp_hz = 18000;
  band_shape_mix = 0;
  band_shape_settle = 0;
  low_shape_db = 0;
  mid_shape_db = 0;
  high_shape_db = 0;
  focus_freq_hz = 1450;
  focus_q_val = 1.2;
  focus_gain_db = 0;
  focus_activity_mix = 0;
  focus_stability_mix = 0;
  follow_hold_mix = 0;
  mirror_delta_slow = 0;
