  // Anti-gonfiore basse: se l'input e' gia' piu' carico sotto, frena boost e favorisci taglio lieve.
  live_follow_mode && i <= 8 ? (
    low_excess = clamp((-low_abs_err - 0.60) / 6.00, 0, 1);
    diff_db > 0 ? (
      diff_db *= (1 - 0.55 * low_excess);
    ) : (
      diff_db *= (1 + 0.30 * low_excess);
    );
  );
  // Cap dinamico low-end: limita i boost sotto ~220 Hz quando il low risulta gia' sovra-rappresentato.
  i <= 8 ? (
    low_abs_guard = clamp((-low_abs_err - 0.45) / 5.50, 0, 1);
    low_shape_guard = clamp((-low_shape_err - 0.35) / 4.50, 0, 1);
    low_guard_mix = max(low_abs_guard, low_shape_guard * 0.85);
    low_band_focus = clamp((220 - band_freq[i]) / 180, 0, 1);
    low_guard_mix > 0 ? (
      low_boost_cap_db = (0.95 + 0.06 * max_curve_db)
        - low_guard_mix * (1.35 + 0.12 * max_curve_db)
