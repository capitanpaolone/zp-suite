dbg_mode_switch_count = 0;
dbg_capture_done_count = 0;
air_params_dirty = 1;
engine_armed = 0; // Default: IDLE finche' utente non preme Follow/Capture
idle_mode = 1;
listen_ab_mix = 0;
listen_xfade_coeff = 0.999;
safe_preset_last = floor(slider105 + 0.5);
safe_preset_last < 0 ? safe_preset_last = 0;
safe_preset_last > 5 ? safe_preset_last = 5;

slider_show(all_sliders_mask, ui_mode >= 0.5 ? 1 : 0);
slider_show(view_slider_mask, 0);
init_ui_mode = ui_mode;
last_ui_mode = ui_mode;

function clamp(x, lo, hi) (
  x < lo ? lo : x > hi ? hi : x;
);

function safe_amp(x) (
  x != x ? 0.000000000001 : clamp(abs(x), 0.000000000001, 1000000);
);

function safe_db(x) (
  clamp(log(safe_amp(x)) * log2db, -240, 24);
);

function db_to_amp(x) (
  exp(x * db2log);
);

function mean_range(base, first_idx, last_idx)
local(i, sum, cnt) (
  sum = 0;
  cnt = max(1, last_idx - first_idx + 1);
  i = first_idx;
  loop(cnt,
    sum += base[i];
    i += 1;
  );
  sum / cnt;
);

function soft_deadband(x, thr)
local(ax) (
  ax = abs(x);
  ax <= thr ? 0 : (x > 0 ? ax - thr : -(ax - thr));
);

function sanitize_audio(x) (
  x != x ? 0 : x > 4 ? 4 : x < -4 ? -4 : x;
);

function is_bad_audio(x) (
  (x != x) || abs(x) > 32;
);

function reset_filter_states_n(base, count)
local(i, off) (
  i = 0;
  loop(count,
    off = i * 9;
    base[off + 5] = 0;
    base[off + 6] = 0;
    base[off + 7] = 0;
    base[off + 8] = 0;
    i += 1;
  );
);

