  i >= 27 ? (
    ultrah_cut_guard_db = (1.0 + 0.10 * max_curve_db) + ultrahigh_guard * (2.8 + 0.35 * max_curve_db);
    diff_db = max(diff_db, -ultrah_cut_guard_db);
    // Cap boost molto conservativo nelle ultrahigh.
    ultrah_boost_cap_db = 0.20 + 0.03 * max_curve_db - ultrahigh_guard * (1.50 + 0.25 * max_curve_db);
    // Hard gate: se il reference scende o non c'e' presenza alta affidabile, vieta il boost.
    (ultra_descend_need > 0.18 || ultra_ref_presence < 0.32) ? (
