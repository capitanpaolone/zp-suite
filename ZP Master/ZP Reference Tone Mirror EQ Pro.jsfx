local(mask) (
  ui_mode = clamp(floor(new_mode), 0, 1);
  slider19 = ui_mode;
  mask = view_slider_mask;
  apply_ui_visibility(ui_mode);
  sliderchange(mask);
  slider_automate(mask);
);

