    slider103 = 17500;
    slider106 = 75;
  ) : preset_id == 5 ? (
    // Aria Controllata
    slider4 = 84;
    slider5 = 8;
    slider6 = 0.50;
    slider7 = 0;
    slider11 = 1;
    slider22 = 0;
    slider23 = 10;
    slider97 = 0;
    slider102 = -2.5;
    slider103 = 14000;
    slider106 = 35;
  );
  air_params_dirty = 1;
  safe_preset_last = preset_id;
  slider105 = preset_id;
);

function freq_to_norm(freq)
local(minf, maxf, lmin, lmax) (
  minf = 40;
  maxf = 18000;
  lmin = log(minf);
  lmax = log(maxf);
  clamp((log(clamp(freq, minf, maxf)) - lmin) / max(0.000001, lmax - lmin), 0, 1);
);

function ui_bar(x, y, w, h, val, r, g, b)
local(fillw) (
  gfx_r = 0.10; gfx_g = 0.11; gfx_b = 0.13; gfx_a = 1; gfx_rect(x, y, w, h);
  fillw = clamp(val, 0, 1) * (w - 2);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = 0.95; gfx_rect(x + 1, y + 1, fillw, h - 2);
);

function ui_button(id, x, y, w, h, txt, active)
local(over, clicked, tw, th) (
  over = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  clicked = over && (mouse_cap & 1) && !last_mouse_cap;
  active ? (
    gfx_r = 0.16; gfx_g = 0.49; gfx_b = 0.85;
  ) : over ? (
    gfx_r = 0.22; gfx_g = 0.24; gfx_b = 0.28;
  ) : (
    gfx_r = 0.15; gfx_g = 0.16; gfx_b = 0.19;
  );
  gfx_a = 1; gfx_rect(x, y, w, h);
  gfx_r = active ? 0.95 : 0.78; gfx_g = active ? 0.98 : 0.80; gfx_b = active ? 1.00 : 0.84;
  gfx_setfont(1, "Arial", 15);
  gfx_measurestr(txt, tw, th);
  gfx_x = x + (w - tw) * 0.5;
  gfx_y = y + (h - th) * 0.5 - 1;
  gfx_drawstr(txt);
  clicked ? (
    set_ui_mode(id);
  );
);

function ui_profile_button(id, x, y, w, h, txt, state)
local(over, clicked, tw, th) (
  over = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  clicked = over && (mouse_cap & 1) && !last_mouse_cap;
  // state: 0=off, 1=in progress (capture running), 2=active/complete
  state == 2 ? (
    gfx_r = 0.20; gfx_g = 0.58; gfx_b = 0.36;  // Verde - completo
  ) : state == 1 ? (
    gfx_r = 0.96; gfx_g = 0.64; gfx_b = 0.22;  // Arancio - in cattura
  ) : over ? (
    gfx_r = 0.22; gfx_g = 0.24; gfx_b = 0.28;  // Grigio hover
  ) : (
    gfx_r = 0.15; gfx_g = 0.16; gfx_b = 0.19;  // Grigio spento
  );
  gfx_a = 1; gfx_rect(x, y, w, h);
  gfx_r = state >= 1 ? 0.96 : 0.80; gfx_g = state >= 1 ? 0.98 : 0.82; gfx_b = state >= 1 ? 0.96 : 0.86;
  gfx_setfont(1, "Arial", 13);
  gfx_measurestr(txt, tw, th);
  gfx_x = x + (w - tw) * 0.5;
  gfx_y = y + (h - th) * 0.5 - 1;
  gfx_drawstr(txt);
  clicked ? (
    set_profile_mode(id);
  );
);

function ui_action_button(x, y, w, h, txt)
local(over, clicked, tw, th, disabled) (
  disabled = 0;
  over = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  clicked = over && (mouse_cap & 1) && !last_mouse_cap && !disabled;
  disabled ? (
    gfx_r = 0.35; gfx_g = 0.35; gfx_b = 0.35;
  ) : over ? (
    gfx_r = 0.68; gfx_g = 0.33; gfx_b = 0.22;
  ) : (
    gfx_r = 0.56; gfx_g = 0.27; gfx_b = 0.19;
  );
  gfx_a = 1; gfx_rect(x, y, w, h);
  gfx_r = disabled ? 0.60 : 0.96; 
  gfx_g = disabled ? 0.60 : 0.90; 
  gfx_b = disabled ? 0.60 : 0.86;
  gfx_setfont(1, "Arial", 13);
  gfx_measurestr(txt, tw, th);
  gfx_x = x + (w - tw) * 0.5;
  gfx_y = y + (h - th) * 0.5 - 1;
  gfx_drawstr(txt);
  clicked ? (
    dbg_clear_count += 1;
    reset_capture_profile();
    clear_live_cache();
    set_profile_mode(0);
    profile_mode = 0;
    engine_armed = 0;
    idle_mode = 1;
    slider26 = 0;
    sliderchange(clear_cache_mask);
    slider_automate(clear_cache_mask);
  );
);

function ui_toggle_button(x, y, w, h, txt, active)
local(over, clicked, tw, th) (
  over = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  clicked = over && (mouse_cap & 1) && !last_mouse_cap;
  active ? (
    gfx_r = 0.18; gfx_g = 0.56; gfx_b = 0.34;
  ) : over ? (
    gfx_r = 0.22; gfx_g = 0.24; gfx_b = 0.28;
  ) : (
    gfx_r = 0.15; gfx_g = 0.16; gfx_b = 0.19;
  );
  gfx_a = 1; gfx_rect(x, y, w, h);
  gfx_r = active ? 0.96 : 0.82; gfx_g = active ? 0.98 : 0.84; gfx_b = active ? 0.96 : 0.88;
  gfx_setfont(1, "Arial", 12);
  gfx_measurestr(txt, tw, th);
  gfx_x = x + (w - tw) * 0.5;
  gfx_y = y + (h - th) * 0.5 - 1;
  gfx_drawstr(txt);
  clicked;
);

function biquad_process(base, idx, x)
local(off, y) (
  off = idx * 9;
  y = base[off + 0] * x
    + base[off + 1] * base[off + 5]
    + base[off + 2] * base[off + 6]
    - base[off + 3] * base[off + 7]
    - base[off + 4] * base[off + 8];
  base[off + 6] = base[off + 5];
  base[off + 5] = x;
  base[off + 8] = base[off + 7];
  base[off + 7] = y;
  y;
);

function set_bandpass(base, idx, freq, q)
local(off, w0, sw, cw, alpha, a0inv) (
  off = idx * 9;
  w0 = 2 * $pi * clamp(freq, 20, 0.45 * srate) / srate;
  sw = sin(w0);
  cw = cos(w0);
  alpha = sw / max(0.0001, (2 * q));
  a0inv = 1 / max(0.000001, 1 + alpha);
  base[off + 0] = alpha * a0inv;
  base[off + 1] = 0;
  base[off + 2] = -alpha * a0inv;
  base[off + 3] = (-2 * cw) * a0inv;
  base[off + 4] = (1 - alpha) * a0inv;
);

function set_lowpass(base, idx, freq, q)
local(off, w0, sw, cw, alpha, b0, b1, b2, a0, a1, a2, a0inv) (
  off = idx * 9;
  w0 = 2 * $pi * clamp(freq, 20, 0.45 * srate) / srate;
  sw = sin(w0);
  cw = cos(w0);
  alpha = sw / max(0.0001, (2 * q));
  b0 = (1 - cw) * 0.5;
  b1 = 1 - cw;
  b2 = (1 - cw) * 0.5;
  a0 = 1 + alpha;
  a1 = -2 * cw;
  a2 = 1 - alpha;
  a0inv = 1 / max(0.000001, a0);
  base[off + 0] = b0 * a0inv;
  base[off + 1] = b1 * a0inv;
  base[off + 2] = b2 * a0inv;
  base[off + 3] = a1 * a0inv;
  base[off + 4] = a2 * a0inv;
);

function set_highpass(base, idx, freq, q)
local(off, w0, sw, cw, alpha, b0, b1, b2, a0, a1, a2, a0inv) (
  off = idx * 9;
  w0 = 2 * $pi * clamp(freq, 20, 0.45 * srate) / srate;
  sw = sin(w0);
  cw = cos(w0);
  alpha = sw / max(0.0001, (2 * q));
  b0 = (1 + cw) * 0.5;
  b1 = -(1 + cw);
  b2 = (1 + cw) * 0.5;
  a0 = 1 + alpha;
  a1 = -2 * cw;
  a2 = 1 - alpha;
  a0inv = 1 / max(0.000001, a0);
  base[off + 0] = b0 * a0inv;
  base[off + 1] = b1 * a0inv;
  base[off + 2] = b2 * a0inv;
  base[off + 3] = a1 * a0inv;
  base[off + 4] = a2 * a0inv;
);

function set_peaking(base, idx, freq, q, gain_db)
local(off, w0, sw, cw, alpha, A, a0, a0inv) (
  off = idx * 9;
  w0 = 2 * $pi * clamp(freq, 20, 0.45 * srate) / srate;
  sw = sin(w0);
  cw = cos(w0);
  alpha = sw / max(0.0001, (2 * q));
  A = 10 ^ (gain_db / 40);
  a0 = 1 + alpha / max(0.000001, A);
  a0inv = 1 / max(0.000001, a0);
  base[off + 0] = (1 + alpha * A) * a0inv;
  base[off + 1] = (-2 * cw) * a0inv;
  base[off + 2] = (1 - alpha * A) * a0inv;
  base[off + 3] = (-2 * cw) * a0inv;
  base[off + 4] = (1 - alpha / max(0.000001, A)) * a0inv;
);

function set_lowshelf(base, idx, freq, gain_db)
local(off, w0, sw, cw, A, alpha, beta, b0, b1, b2, a0, a1, a2, a0inv) (
  off = idx * 9;
  w0 = 2 * $pi * clamp(freq, 20, 0.45 * srate) / srate;
  sw = sin(w0);
  cw = cos(w0);
  A = 10 ^ (gain_db / 40);
  alpha = sw / 2 * sqrt(2);
  beta = 2 * sqrt(max(0.000001, A)) * alpha;
  b0 = A * ((A + 1) - (A - 1) * cw + beta);
  b1 = 2 * A * ((A - 1) - (A + 1) * cw);
  b2 = A * ((A + 1) - (A - 1) * cw - beta);
  a0 = (A + 1) + (A - 1) * cw + beta;
  a1 = -2 * ((A - 1) + (A + 1) * cw);
  a2 = (A + 1) + (A - 1) * cw - beta;
  a0inv = 1 / max(0.000001, a0);
  base[off + 0] = b0 * a0inv;
  base[off + 1] = b1 * a0inv;
  base[off + 2] = b2 * a0inv;
  base[off + 3] = a1 * a0inv;
  base[off + 4] = a2 * a0inv;
);

function set_highshelf(base, idx, freq, gain_db)
local(off, w0, sw, cw, A, alpha, beta, b0, b1, b2, a0, a1, a2, a0inv) (
  off = idx * 9;
  w0 = 2 * $pi * clamp(freq, 20, 0.45 * srate) / srate;
  sw = sin(w0);
  cw = cos(w0);
  A = 10 ^ (gain_db / 40);
  alpha = sw / 2 * sqrt(2);
  beta = 2 * sqrt(max(0.000001, A)) * alpha;
  b0 = A * ((A + 1) + (A - 1) * cw + beta);
  b1 = -2 * A * ((A - 1) + (A + 1) * cw);
  b2 = A * ((A + 1) + (A - 1) * cw - beta);
  a0 = (A + 1) - (A - 1) * cw + beta;
  a1 = 2 * ((A - 1) - (A + 1) * cw);
  a2 = (A + 1) - (A - 1) * cw - beta;
  a0inv = 1 / max(0.000001, a0);
  base[off + 0] = b0 * a0inv;
  base[off + 1] = b1 * a0inv;
  base[off + 2] = b2 * a0inv;
  base[off + 3] = a1 * a0inv;
  base[off + 4] = a2 * a0inv;
);

@slider
in_trim = db_to_amp(slider1);
sc_trim = db_to_amp(slider29);
profile_s = slider3;
match_amt = slider4 / 100;
max_curve_db = slider5;
band_q = slider6;
harm_amt = slider7 / 100;
harm_color = slider8 / 100;
harm_dyn = slider9 / 100;
harm_hp_hz = slider10;
gm_on = slider2 >= 0.5;  // Auto Level Match (Ref vs Proc)
out_gain = db_to_amp(slider12);
out_norm_on = slider11 >= 0.5;  // Automatic Gain Control (Output RMS)
agc_trim_amp = db_to_amp(slider22);
agc_range_db = max(1, slider23);
mix_wet = slider13 / 100;
mix_dry = 1 - mix_wet;
monitor_mode = floor(slider14);
ui_mode = clamp(floor(slider19 + 0.5), 0, 1);
profile_mode = clamp(floor(slider20 + 0.5), 0, 2);
target_offset_amp = db_to_amp(slider94);
level_target_mode = floor(slider95);
debug_overlay_on = slider96 >= 0.5;
strict_eq_on = slider97 >= 0.5;
delta_stability = clamp(slider25 / 100, 0, 1);
auto_clean_on_start = slider27 >= 0.5;
capture_mode = 0;  // Capture semplificato: solo Timed
capture_sens = clamp(slider28 / 100, 0.25, 2.0);
air_trim_db = slider102;
air_lp_hz = slider103;
air_hp_hz = slider106;
air_params_dirty = 1;
diag_mode = clamp(floor(slider107 + 0.5), 0, 3);
diag_tc_s = clamp(0.22 + 0.012 * profile_s, 0.12, 1.20);
diag_coeff = exp(-1 / max(1, srate * diag_tc_s));
diag_lp_coeff = 1 - exp(-2 * $pi * 1500 / max(1, srate));
diag_hp_coeff = 1 - exp(-2 * $pi * 38 / max(1, srate));
listen_mode = floor(slider104);
safe_preset_sel = clamp(floor(slider105 + 0.5), 0, 5);
safe_preset_sel > 0 && safe_preset_sel != safe_preset_last ? (
  apply_safe_preset(safe_preset_sel);
);
listen_xfade_coeff = exp(-1 / max(1, srate * 0.015));

clear_cache_req = slider26 >= 0.5;
clear_cache_req ? (
  dbg_clear_count += 1;
  reset_capture_profile();
  clear_live_cache();
  set_profile_mode(0);
  profile_mode = 0;
  engine_armed = 0;
  idle_mode = 1;
  slider26 = 0;
  sliderchange(clear_cache_mask);
  slider_automate(clear_cache_mask);
);

ui_mode != last_ui_mode ? (
  apply_ui_visibility(ui_mode);
);

profile_coeff = exp(-1 / max(1, srate * max(8, profile_s)));
profile_fast_coeff = exp(-1 / max(1, srate * max(2.5, profile_s * 0.45)));
profile_hold_coeff = exp(-1 / max(1, srate * max(30, profile_s * 12)));
rms_coeff = exp(-1 / max(1, srate * 1.20));
lufs_s_coeff = exp(-1 / max(1, srate * 3.00));
gm_att = exp(-1 / max(1, srate * 0.90));
gm_rel = exp(-1 / max(1, srate * 2.80));
gm_mix_att = exp(-1 / max(1, srate * 1.20));
gm_mix_rel = exp(-1 / max(1, srate * 3.20));
agc_att = exp(-1 / max(1, srate * 1.40));
agc_rel = exp(-1 / max(1, srate * 4.20));
agc_idle = exp(-1 / max(1, srate * 0.60));
safety_att = exp(-1 / max(1, srate * 0.003));
safety_rel = exp(-1 / max(1, srate * 0.090));
startup_att = exp(-1 / max(1, srate * 0.040));
follow_entry_att = exp(-1 / max(1, srate * 0.120));
init_guard_att = exp(-1 / max(1, srate * 0.090));
init_declick_coeff = exp(-1 / max(1, srate * 0.004));
env_att = exp(-1 / max(1, srate * 0.01));
env_rel = exp(-1 / max(1, srate * 0.20));
ref_gate_att = exp(-1 / max(1, srate * 0.03));
ref_gate_rel = exp(-1 / max(1, srate * 0.40));
prog_gate_att = exp(-1 / max(1, srate * 0.02));
prog_gate_rel = exp(-1 / max(1, srate * 0.25));
ref_mix_att = exp(-1 / max(1, srate * 0.90));
ref_mix_rel = exp(-1 / max(1, srate * 1.80));
ref_hold_samples = floor(max(1, srate * 1.20));
prog_hold_samples = floor(max(1, srate * 0.70));
ref_on_thr = 0.00012;
prog_on_thr = 0.00008;
capture_target_samples = floor(max(1, srate * max(5, profile_s)));
panic_hold_samples = floor(max(1, srate * 2.5));
panic_cooldown_samples = floor(max(1, srate * (profile_s + 0.35)));
recover_hold_samples = floor(max(1, srate * 0.12));
follow_fill_target_samples = floor(max(1, srate * max(4, profile_s * 0.35)));
follow_ready_samples = floor(max(1, srate * max(2, profile_s * 0.18)));
follow_blend_samples = floor(max(1, srate * max(3, profile_s * 0.28)));
follow_fill_release_step = 0.25;
delta_att_sec = (1.5 + profile_s * 0.15) + delta_stability * (6.0 + profile_s * 1.0);
delta_rel_sec = (2.5 + profile_s * 0.25) + delta_stability * (9.0 + profile_s * 1.4);
delta_smooth_att = exp(-1 / max(1, srate * delta_att_sec));
delta_smooth_rel = exp(-1 / max(1, srate * delta_rel_sec));
delta_deadband_db = 0.10 + 0.50 * delta_stability;
delta_slew_up_db_s = max(0.12, 2.50 - 2.32 * delta_stability);
delta_slew_dn_db_s = max(0.08, 1.60 - 1.48 * delta_stability);
// Detector transiente HF (sibilanti): attacco rapido, rilascio medio.
sibil_hf_lp_coeff = 1 - exp(-2 * $pi * 4200 / srate);
sibil_fast_att = exp(-1 / max(1, srate * 0.003));
sibil_fast_rel = exp(-1 / max(1, srate * 0.040));
sibil_slow_coeff = exp(-1 / max(1, srate * 0.120));

profile_mode != profile_mode_prev ? (
  profile_mode == 1 ? (
    // Capture timed follow-like: reset cache e timer, poi segue live.
    clear_live_cache();
    reset_capture_profile();
    capture_delta_latch_db = read_delta_db;
  );
  profile_mode_prev = profile_mode;
);

profile_mode != follow_mode_prev ? (
  (profile_mode == 0 || profile_mode == 1) ? (
    follow_entry_mix = 0;
    follow_fill_counter = 0;
    follow_fill_ratio = 0;
    follow_fill_mix = 0;
  ) : (
    follow_entry_mix = 1;
  );
  follow_mode_prev = profile_mode;
);

hp_lp_coeff = 1 - exp(-2 * $pi * clamp(harm_hp_hz, 40, 0.45 * srate) / srate);
low_lp_coeff = 1 - exp(-2 * $pi * 140 / srate);

i = 0;
loop(NUM_BANDS,
  set_bandpass(bp_in, i, band_freq[i], band_q);
  set_bandpass(bp_sc, i, band_freq[i], band_q);
  i += 1;
);

// Configura filtri di protezione: HP 20Hz (Q 0.72) e LP 20kHz (Q 0.72)
set_highpass(hp20L_mem, 0, 20, 0.72);
set_highpass(hp20R_mem, 0, 20, 0.72);
set_lowpass(lp20kL_mem, 0, 20000, 0.72);
set_lowpass(lp20kR_mem, 0, 20000, 0.72);
// Se Air Trim e' negativo, stringe leggermente anche il LP effettivo.
air_lp_eff_hz = clamp(air_lp_hz + min(air_trim_db, 0) * 650, 5000, 20000);
set_lowpass(airlpL_mem, 0, air_lp_eff_hz, 0.72);
set_lowpass(airlpR_mem, 0, air_lp_eff_hz, 0.72);
set_lowpass(airlp2L_mem, 0, air_lp_eff_hz, 0.72);
set_lowpass(airlp2R_mem, 0, air_lp_eff_hz, 0.72);
set_highpass(airhpL_mem, 0, air_hp_hz, 0.72);
set_highpass(airhpR_mem, 0, air_hp_hz, 0.72);

@block
air_params_dirty ? (
  air_trim_db = slider102;
  air_lp_hz = slider103;
  air_hp_hz = slider106;
  air_lp_eff_hz = clamp(air_lp_hz + min(air_trim_db, 0) * 650, 5000, 20000);
  set_lowpass(airlpL_mem, 0, air_lp_eff_hz, 0.72);
  set_lowpass(airlpR_mem, 0, air_lp_eff_hz, 0.72);
  set_lowpass(airlp2L_mem, 0, air_lp_eff_hz, 0.72);
  set_lowpass(airlp2R_mem, 0, air_lp_eff_hz, 0.72);
  set_highpass(airhpL_mem, 0, air_hp_hz, 0.72);
  set_highpass(airhpR_mem, 0, air_hp_hz, 0.72);
  air_params_dirty = 0;
);

idle_mode = engine_armed ? 0 : 1;
diag_mode = clamp(floor(slider107 + 0.5), 0, 3);

transport_running = ((play_state & 1) || (play_state & 4));
auto_clean_on_start && transport_running && !transport_was_running ? (
  clear_live_cache();
);
transport_was_running = transport_running;

// Delta Stability ora controlla direttamente la velocita' di adattamento EQ.
// Basso = piu' rapido, alto = piu' stabile/lento.
curve_time_sec = 0.20 + 2.80 * delta_stability;
curve_coeff = exp(-samplesblock / max(1, srate * curve_time_sec));
harm_coeff = exp(-samplesblock / max(1, srate * 0.14));
gm_mix_att_blk = exp(-samplesblock / max(1, srate * 1.20));
gm_mix_rel_blk = exp(-samplesblock / max(1, srate * 3.20));
ref_mix_att_blk = exp(-samplesblock / max(1, srate * 0.90));
ref_mix_rel_blk = exp(-samplesblock / max(1, srate * 1.80));
delta_slew_up_db_block = delta_slew_up_db_s * samplesblock / max(1, srate);
delta_slew_dn_db_block = delta_slew_dn_db_s * samplesblock / max(1, srate);
panic_flash_counter = max(0, panic_flash_counter - samplesblock);
panic_cooldown_counter = max(0, panic_cooldown_counter - samplesblock);
recover_flash_counter = max(0, recover_flash_counter - samplesblock);
recover_cooldown_counter = max(0, recover_cooldown_counter - samplesblock);

capture_live_mode = !idle_mode && profile_mode == 1 && !keep_ready;
follow_live_mode = !idle_mode && profile_mode == 0;
live_follow_mode = follow_live_mode || capture_live_mode;
capture_freeze_mode = 0; // In Capture si deve sentire l'EQ che si muove
keep_static_active = (!idle_mode && profile_mode == 2 && keep_ready);  // statico solo in Keep
capture_freeze_mode ? (
  curve_coeff = 1;
  harm_coeff = 1;
);

profile_mode == 2 || (profile_mode == 1 && keep_ready) ? (
  profile_live_weight = 0;
) : (
  profile_live_weight = 1;
);

live_follow_mode ? (
  follow_profile_ready = follow_fill_counter >= follow_ready_samples;
  follow_blend_ratio = clamp(follow_fill_counter / max(1, follow_blend_samples), 0, 1);
  fill_t = clamp((follow_blend_ratio - 0.08) / 0.92, 0, 1);
  profile_fill_mix = fill_t * fill_t * (3 - 2 * fill_t);
) : (
  follow_profile_ready = 1;
  follow_blend_ratio = 1;
  profile_fill_mix = 1;
);

profile_live_weight ? (
  profile_ready = ref_active && follow_profile_ready;
) : (
  profile_ready = keep_ready;
);
idle_mode ? (
  profile_ready = 0;
);

gm_on && profile_ready ? (
  gm_mix_state = gm_mix_state * gm_mix_att_blk + (1 - gm_mix_att_blk);
) : (
  gm_mix_state = gm_mix_state * gm_mix_rel_blk;
);

profile_ready ? (
  ref_mix_state = ref_mix_state * ref_mix_att_blk + (1 - ref_mix_att_blk);
) : (
  ref_mix_state = ref_mix_state * ref_mix_rel_blk;
);
eff_match_amt = match_amt * ref_mix_state * profile_fill_mix;
live_follow_mode ? (
  capture_live_mode ? (
    // In Capture deve convergere e stabilizzarsi, non inseguire troppo.
    follow_match_floor = 0.12 + 0.16 * capture_sens; // circa 0.16..0.44
  ) : (
    // In Follow resta reattivo ma meno aggressivo di prima.
    follow_match_floor = 0.28 + 0.18 * capture_sens; // circa 0.33..0.64
  );
  follow_match_floor = clamp(follow_match_floor, 0.10, 0.64);
  follow_match_drive = follow_match_floor + (1 - follow_match_floor) * mirror_error_mix;
  eff_match_amt *= follow_match_drive;
);
// Se routing sidechain non e' valido in live mode, non applicare matching.
live_follow_mode && routing_state != 0 ? (
  eff_match_amt = 0;
);
// In Follow, quando siamo molto vicini al target, blocca il chasing fine.
follow_live_mode && follow_fill_ratio >= 0.98 ? (
  follow_settle_gate = clamp((mirror_error_mix - 0.03) / 0.18, 0, 1);
  // Evita stallo: in zona "quasi match" riduce il chasing ma non lo blocca.
  read_curve_db > 0.12 ? (
    eff_match_amt *= (0.70 + 0.30 * follow_settle_gate);
  );
);

sum_abs = 0;
sum_sc = 0;
sum_in = 0;
mirror_err_sum = 0;
raw_err_sum = 0;
mirror_peak_err = 0;
low_push = 0;
mid_push = 0;
high_push = 0;
low_pull = 0;
high_pull = 0;
mid_focus = 0;
eq_settle_sum = 0;
sibil_ref_sum = 0;
sibil_in_sum = 0;
sibil_count = 0;
ultrah_ref_sum = 0;
ultrah_in_sum = 0;
ultrah_count = 0;

i = 0;
loop(NUM_BANDS,
  in_src = profile_live_weight ? in_avg[i] : keep_in_avg[i];
  in_band_db = safe_db(sqrt(max(in_src, 0)));
  src_ref = profile_live_weight ? sc_avg[i] : keep_avg[i];
  sc_band_db = safe_db(sqrt(max(src_ref, 0)));
  tmp_in_db[i] = in_band_db;
  tmp_sc_db[i] = sc_band_db;
  (band_freq[i] >= 5500 && band_freq[i] <= 8500) ? (
    sibil_ref_sum += sc_band_db;
    sibil_in_sum += in_band_db;
    sibil_count += 1;
  );
  band_freq[i] >= 10000 ? (
    ultrah_ref_sum += sc_band_db;
    ultrah_in_sum += in_band_db;
    ultrah_count += 1;
  );
  sum_in += in_band_db;
  sum_sc += sc_band_db;
  i += 1;
);

in_mean_db = sum_in / NUM_BANDS;
sc_mean_db = sum_sc / NUM_BANDS;

sub_ref_db = mean_range(tmp_sc_db, 0, 10);
sub_in_db = mean_range(tmp_in_db, 0, 10);
body_ref_db = mean_range(tmp_sc_db, 11, 17);
body_in_db = mean_range(tmp_in_db, 11, 17);
presence_ref_db = mean_range(tmp_sc_db, 18, 24);
presence_in_db = mean_range(tmp_in_db, 18, 24);
air_ref_db = mean_range(tmp_sc_db, 25, 30);
air_in_db = mean_range(tmp_in_db, 25, 30);
low_abs_err = sub_ref_db - sub_in_db;
mid_abs_err = ((body_ref_db + presence_ref_db) * 0.5) - ((body_in_db + presence_in_db) * 0.5);
high_abs_err = air_ref_db - air_in_db;
low_shape_err = (sub_ref_db - sc_mean_db) - (sub_in_db - in_mean_db);
mid_shape_err = (((body_ref_db + presence_ref_db) * 0.5) - sc_mean_db) - (((body_in_db + presence_in_db) * 0.5) - in_mean_db);
high_shape_err = (air_ref_db - sc_mean_db) - (air_in_db - in_mean_db);
speech_lowcut_err = (presence_ref_db - sub_ref_db) - (presence_in_db - sub_in_db);
speech_highcut_err = (presence_ref_db - air_ref_db) - (presence_in_db - air_in_db);
speech_body_err = body_ref_db - body_in_db;
speech_presence_err = (presence_ref_db - ((body_ref_db + air_ref_db) * 0.5)) - (presence_in_db - ((body_in_db + air_in_db) * 0.5));
sibil_ref_db = sibil_count > 0 ? (sibil_ref_sum / sibil_count) : air_ref_db;
sibil_in_db = sibil_count > 0 ? (sibil_in_sum / sibil_count) : air_in_db;
sibil_abs_err = sibil_ref_db - sibil_in_db;
// Guard dinamico: attivo quando l'input e' gia' piu' brillante del riferimento sulle sibilanti.
sibilance_guard = clamp((-sibil_abs_err - 0.35) / 3.50, 0, 1);
ultrah_ref_db = ultrah_count > 0 ? (ultrah_ref_sum / ultrah_count) : air_ref_db;
ultrah_in_db = ultrah_count > 0 ? (ultrah_in_sum / ultrah_count) : air_in_db;
ultrah_abs_err = ultrah_ref_db - ultrah_in_db;
// Guard dinamico altissime: attivo quando 10k+ supera il reference.
ultrahigh_guard = clamp((-ultrah_abs_err - 0.05) / 3.20, 0, 1);
ultra_ref_lo_db = mean_range(tmp_sc_db, 25, 26);   // 6.3k-8k
ultra_ref_hi_db = mean_range(tmp_sc_db, 28, 30);   // 12.5k-20k
ultra_in_lo_db = mean_range(tmp_in_db, 25, 26);
ultra_in_hi_db = mean_range(tmp_in_db, 28, 30);
ultra_tilt_ref_db = ultra_ref_hi_db - ultra_ref_lo_db;
ultra_tilt_in_db = ultra_in_hi_db - ultra_in_lo_db;
ultra_tilt_err_db = ultra_tilt_ref_db - ultra_tilt_in_db;
// Quanto serve una discesa extra oltre 10k (reference piu' discendente dell'input).
ultra_descend_need = clamp((-ultra_tilt_err_db - 0.20) / 5.00, 0, 1);
// Confidenza presenza reale in alto nel reference: se bassa, vieta boost sopra 10k.
ultra_ref_presence = clamp((ultra_ref_hi_db - (sc_mean_db - 22)) / 8, 0, 1);
ultra_in_presence = clamp((ultra_in_hi_db - (in_mean_db - 22)) / 8, 0, 1);
// Clamp "spalla" 9k-16k: quando input ha una shoulder piu' alta del reference, frena ulteriormente.
ultra_shoulder_err_db = (ultra_in_hi_db - ultra_in_lo_db) - (ultra_ref_hi_db - ultra_ref_lo_db);
ultra_shoulder_guard = clamp((ultra_shoulder_err_db - 0.10) / 3.00, 0, 1);
// Lock pendenza diretta 10k -> 20k: evita "spalla alta" che resta dopo il matching.
ultra_roll_ref_db = tmp_sc_db[27] - tmp_sc_db[30];
ultra_roll_in_db = tmp_in_db[27] - tmp_in_db[30];
ultra_roll_need = clamp((ultra_roll_ref_db - ultra_roll_in_db - 0.15) / 3.60, 0, 1);
// Preview debug del cap HF effettivo (senza dipendere dal loop bande).
dbg_ultrah_cap10_db = 0.20 + 0.03 * max_curve_db - ultrahigh_guard * (1.50 + 0.25 * max_curve_db);
(ultra_descend_need > 0.18 || ultra_ref_presence < 0.32) ? (
  dbg_ultrah_cap10_db = min(dbg_ultrah_cap10_db, -0.10);
);
dbg_ultrah_cap10_db -= ultra_shoulder_guard * (1.40 + 0.20 * max_curve_db);
dbg_ultrah_cap10_db -= ultra_roll_need * (1.20 + 0.16 * max_curve_db);
dbg_ultrah_cap12_db = min(dbg_ultrah_cap10_db, 0.06 + 0.02 * max_curve_db - ultra_roll_need * (1.10 + 0.18 * max_curve_db));
ref_peak_idx = 0;
ref_peak_rel = -240;
ref_peak_err = 0;
i = 0;
loop(NUM_BANDS,
  shape_err_probe = soft_deadband((tmp_sc_db[i] - sc_mean_db) - (tmp_in_db[i] - in_mean_db), 0.15);
  abs_err_probe = soft_deadband(tmp_sc_db[i] - tmp_in_db[i], 0.25);
  raw_err_sum += abs(tmp_sc_db[i] - tmp_in_db[i]);
  mirror_err_sum += abs(abs_err_probe) + 0.60 * abs(shape_err_probe);
  mirror_peak_err = max(mirror_peak_err, abs(abs_err_probe));
  sc_rel_db = tmp_sc_db[i] - sc_mean_db;
  peak_err_db = tmp_sc_db[i] - tmp_in_db[i];
  sc_rel_db > ref_peak_rel ? (
    ref_peak_rel = sc_rel_db;
    ref_peak_idx = i;
    ref_peak_err = peak_err_db;
  );
  i += 1;
);
mirror_delta = mirror_err_sum / NUM_BANDS;
raw_err_avg_db = raw_err_sum / NUM_BANDS;
mirror_broad_mix = clamp((mirror_delta - 0.45) / 1.40, 0, 1);
mirror_peak_mix = clamp((mirror_peak_err - 1.80) / 5.50, 0, 1);
mirror_error_mix = max(mirror_broad_mix, mirror_peak_mix * 0.90);
mirror_flat = mirror_delta < 0.50 && mirror_peak_err < 1.80
  && abs(low_abs_err) < 0.75
  && abs(mid_abs_err) < 0.75
  && abs(high_abs_err) < 0.75;
mirror_flat ? (
  mirror_error_mix = 0;
);
mirror_delta_err = abs(mirror_delta - mirror_delta_slow);
mirror_peak_err_slow = abs(mirror_peak_err - mirror_peak_slow);
mirror_follow_change = mirror_delta_err + mirror_peak_err_slow * 0.35;
follow_stability_target = live_follow_mode && follow_fill_ratio >= 0.98 ? clamp((0.30 - mirror_follow_change) / 0.30, 0, 1) * clamp((mirror_error_mix - 0.08) / 0.45, 0, 1) : 0;
follow_stability_coeff = exp(-samplesblock / max(1, srate * 1.20));
focus_stability_mix = focus_stability_mix * follow_stability_coeff + follow_stability_target * (1 - follow_stability_coeff);
mirror_slow_coeff = exp(-samplesblock / max(1, srate * 0.90));
mirror_delta_slow = mirror_delta_slow * mirror_slow_coeff + mirror_delta * (1 - mirror_slow_coeff);
mirror_peak_slow = mirror_peak_slow * mirror_slow_coeff + mirror_peak_err * (1 - mirror_slow_coeff);
follow_change_drive = live_follow_mode ? clamp((mirror_follow_change - 0.018) / 0.16, 0, 1) * clamp((mirror_error_mix - 0.03) / 0.34, 0, 1) : 0;
follow_hold_target = live_follow_mode && follow_fill_ratio >= 0.98 ? clamp((0.045 - mirror_follow_change) / 0.045, 0, 1) : 0;
follow_hold_mix < follow_hold_target ? (
  follow_hold_coeff = exp(-samplesblock / max(1, srate * 0.85));
) : (
  follow_hold_coeff = exp(-samplesblock / max(1, srate * 0.14));
);
follow_hold_mix = follow_hold_mix * follow_hold_coeff + follow_hold_target * (1 - follow_hold_coeff);
profile_live_coeff = profile_coeff + (profile_fast_coeff - profile_coeff) * (follow_change_drive * 0.55);
profile_live_coeff = profile_live_coeff * (1 - follow_hold_mix) + profile_hold_coeff * follow_hold_mix;
live_follow_mode ? (
  // Delta Stability ora influisce anche sulla velocita' reale di inseguimento.
  // Alto = piu' stabile/lento, basso = piu' rapido.
  profile_live_coeff = profile_live_coeff * (0.90 + 0.10 * delta_stability) + profile_hold_coeff * (0.10 * delta_stability);
);
strict_eq_on && live_follow_mode ? (
  // In Strict EQ solo un leggero smoothing extra.
  profile_live_coeff = profile_live_coeff * 0.96 + profile_hold_coeff * 0.04;
);
live_follow_mode ? (
  // Cap della costante di analisi live: evita risposta troppo lenta con finestre lunghe.
  live_analysis_tc = clamp(0.70 + 5.80 * delta_stability + 0.07 * min(profile_s, 30), 0.9, 9.5);
  live_analysis_coeff = exp(-1 / max(1, srate * live_analysis_tc));
