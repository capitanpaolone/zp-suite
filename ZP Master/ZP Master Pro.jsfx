  gm_macro_in=0.5*(abs(_scL)+abs(_scR));
  comp_detect>=0.5?(
    gm_macro_env=mt_rms_c*gm_macro_env+(1-mt_rms_c)*gm_macro_in*gm_macro_in;
    gm_macro_det=sqrt(max(gm_macro_env,0.000000000001));
  ):(
    gm_macro_in>gm_macro_env?gm_macro_env=gm_macro_in:(gm_macro_env=mt_rms_c*gm_macro_env+(1-mt_rms_c)*gm_macro_in);
    gm_macro_det=gm_macro_env;
  );

  gm_micro_env = _det>gm_micro_env ? gm_micro_att_c*gm_micro_env+(1-gm_micro_att_c)*_det : gm_micro_rel_c*gm_micro_env+(1-gm_micro_rel_c)*_det;
  gm_rms_sig=0.5*(_scL*_scL+_scR*_scR);
  gm_rms_env=0.997*gm_rms_env+0.003*gm_rms_sig;
  gm_crest=gain2db(max(gm_micro_env,0.000000000001))-gain2db(sqrt(max(gm_rms_env,0.000000000001)));

  _over=gm_macro_det/max(mt_thr_g,0.000000000001);
  _macro_tgt=0;
  _over>1?(
    comp_knee>=0.5?(_ov_db=gain2db(_over);_macro_tgt=_ov_db-_ov_db/max(1,mt_ratio_eff)-tanh_fast(_ov_db*0.5)*0.3;):(_macro_tgt=gain2db(_over)-gain2db(_over)/max(1,mt_ratio_eff););
    _macro_tgt=clamp(_macro_tgt*(0.55+0.35*gm_depth_eff)*(1-0.35*gm_frag_eff),0,gm_macro_cap);
  );
  gm_macro_gr_db=_macro_tgt>gm_macro_gr_db ? _macro_tgt+gm_macro_att_c*(gm_macro_gr_db-_macro_tgt) : _macro_tgt+gm_macro_rel_c*(gm_macro_gr_db-_macro_tgt);

  _mover=gm_micro_env/max(gm_micro_thr_g,0.000000000001);
  _micro_tgt=0;
  _mover>1?(
    _movdb=gain2db(_mover);
    _micro_tgt=clamp((_movdb-_movdb/max(1,1.4+mt_ratio_eff*0.18))*gm_frag_eff*gm_depth_eff,0,gm_micro_cap);
  );
  gm_micro_gr_db=_micro_tgt>gm_micro_gr_db ? _micro_tgt+gm_micro_att_c*(gm_micro_gr_db-_micro_tgt) : _micro_tgt+gm_micro_rel_c*(gm_micro_gr_db-_micro_tgt);

  _crest_tgt=clamp((gm_crest-gm_crest_db)*0.22*gm_depth_eff*gm_frag_eff,0,gm_crest_cap);
  gm_crest_gr_db=_crest_tgt>gm_crest_gr_db ? _crest_tgt+gm_crest_att_c*(gm_crest_gr_db-_crest_tgt) : _crest_tgt+gm_crest_rel_c*(gm_crest_gr_db-_crest_tgt);

  mt_gr_db=gm_macro_gr_db+gm_micro_gr_db+gm_crest_gr_db;
  _cg=db2gain(-mt_gr_db)*mt_makeup_g;mt_fb_det=xL*_cg;xL*=_cg;xR*=_cg;
  gm_prevL=_scL;gm_prevR=_scR;
  pk_comp_env=pk_decay(max(abs(xL),abs(xR)),pk_comp_env);
):(
  mt_gr_db=0;gm_macro_gr_db=0;gm_micro_gr_db=0;gm_crest_gr_db=0;gm_prevL=xL;gm_prevR=xR;
  pk_comp_env=pk_decay(max(abs(xL),abs(xR)),pk_comp_env);
);

// 3. TONE GUARD
tone_on>=0.5?(
  _dryToneL=xL;_dryToneR=xR;
  tone_lp1L += tone_c1*(xL-tone_lp1L); tone_lp1R += tone_c1*(xR-tone_lp1R);
  _tb1L=tone_lp1L; _tb1R=tone_lp1R;
  _trem1L=xL-_tb1L; _trem1R=xR-_tb1R;
  tone_lp2L += tone_c2*(_trem1L-tone_lp2L); tone_lp2R += tone_c2*(_trem1R-tone_lp2R);
  _tb2L=tone_lp2L; _tb2R=tone_lp2R;
  _trem2L=_trem1L-_tb2L; _trem2R=_trem1R-_tb2R;
  tone_lp3L += tone_c3*(_trem2L-tone_lp3L); tone_lp3R += tone_c3*(_trem2R-tone_lp3R);
  _tb3L=tone_lp3L; _tb3R=tone_lp3R;
  _tb4L=_trem2L-_tb3L; _tb4R=_trem2R-_tb3R;

  _tp1=0.5*(_tb1L*_tb1L+_tb1R*_tb1R);
  _tp2=0.5*(_tb2L*_tb2L+_tb2R*_tb2R);
  _tp3=0.5*(_tb3L*_tb3L+_tb3R*_tb3R);
  _tp4=0.5*(_tb4L*_tb4L+_tb4R*_tb4R);

  tone_prime_pending&&(_tp1+_tp2+_tp3+_tp4>0.00000001)?(
    tone_e1=_tp1;tone_e2=_tp2;tone_e3=_tp3;tone_e4=_tp4;
    tone_prime_pending=0;
  ):(
    tone_e1=_tp1>tone_e1?tone_env_att*tone_e1+(1-tone_env_att)*_tp1:tone_env_rel*tone_e1+(1-tone_env_rel)*_tp1;
    tone_e2=_tp2>tone_e2?tone_env_att*tone_e2+(1-tone_env_att)*_tp2:tone_env_rel*tone_e2+(1-tone_env_rel)*_tp2;
    tone_e3=_tp3>tone_e3?tone_env_att*tone_e3+(1-tone_env_att)*_tp3:tone_env_rel*tone_e3+(1-tone_env_rel)*_tp3;
    tone_e4=_tp4>tone_e4?tone_env_att*tone_e4+(1-tone_env_att)*_tp4:tone_env_rel*tone_e4+(1-tone_env_rel)*_tp4;
  );

  _ta1=gain2db(sqrt(max(tone_e1,0.000000000001)));
  _ta2=gain2db(sqrt(max(tone_e2,0.000000000001)));
  _ta3=gain2db(sqrt(max(tone_e3,0.000000000001)));
  _ta4=gain2db(sqrt(max(tone_e4,0.000000000001)));
  _toff=((_ta1-tone_t1)+(_ta2-tone_t2)+(_ta3-tone_t3)+(_ta4-tone_t4))*0.25;
  _te1=(_ta1-_toff)-tone_t1; _te2=(_ta2-_toff)-tone_t2;
  _te3=(_ta3-_toff)-tone_t3; _te4=(_ta4-_toff)-tone_t4;
  tone_gd1=clamp(-_te1*tone_amount_w,-2.4,0.4);
  tone_gd2=clamp(-_te2*tone_amount_w,-3.0,0.6);
  tone_gd3=clamp(-_te3*tone_amount_w,-3.0,0.6);
  tone_gd4=clamp(-_te4*tone_amount_w,-2.4,0.4);
  tone_eq_w1=clamp(abs(tone_gain1)/6,0,1);
  tone_eq_w2=clamp(abs(tone_gain2)/6,0,1);
  tone_eq_w3=clamp(abs(tone_gain3)/6,0,1);
  tone_eq_w4=clamp(abs(tone_gain4)/6,0,1);
  tone_eq_gd1=clamp(-max(0,_te1)*tone_eq_amount_w*tone_eq_w1,-3.0,0);
  tone_eq_gd2=clamp(-max(0,_te2)*tone_eq_amount_w*tone_eq_w2,-3.0,0);
  tone_eq_gd3=clamp(-max(0,_te3)*tone_eq_amount_w*tone_eq_w3,-3.0,0);
  tone_eq_gd4=clamp(-max(0,_te4)*tone_eq_amount_w*tone_eq_w4,-3.0,0);
  tone_ui_target1=tone_t1; tone_ui_target2=tone_t2;
  tone_ui_target3=tone_t3; tone_ui_target4=tone_t4;
  tone_dyn_on<0.5?(
    tone_gd1=tone_gd2=tone_gd3=tone_gd4=0;
    tone_ui_actual1=tone_t1;tone_ui_actual2=tone_t2;tone_ui_actual3=tone_t3;tone_ui_actual4=tone_t4;
    tone_ui_corr1=tone_ui_corr2=tone_ui_corr3=tone_ui_corr4=0;
  ):(
    tone_silent=_tp1+_tp2+_tp3+_tp4<0.000000000001;
    tone_silent?(
      tone_ui_actual1=tone_ui_actual1*tone_graph_rel_c+tone_t1*(1-tone_graph_rel_c);
      tone_ui_actual2=tone_ui_actual2*tone_graph_rel_c+tone_t2*(1-tone_graph_rel_c);
      tone_ui_actual3=tone_ui_actual3*tone_graph_rel_c+tone_t3*(1-tone_graph_rel_c);
      tone_ui_actual4=tone_ui_actual4*tone_graph_rel_c+tone_t4*(1-tone_graph_rel_c);
      tone_ui_corr1*=tone_graph_rel_c;tone_ui_corr2*=tone_graph_rel_c;
      tone_ui_corr3*=tone_graph_rel_c;tone_ui_corr4*=tone_graph_rel_c;
    ):(
      tone_gc=(_ta1-_toff)>tone_ui_actual1?tone_graph_att_c:tone_graph_rel_c;
      tone_ui_actual1=tone_ui_actual1*tone_gc+(_ta1-_toff)*(1-tone_gc);
      tone_gc=(_ta2-_toff)>tone_ui_actual2?tone_graph_att_c:tone_graph_rel_c;
      tone_ui_actual2=tone_ui_actual2*tone_gc+(_ta2-_toff)*(1-tone_gc);
      tone_gc=(_ta3-_toff)>tone_ui_actual3?tone_graph_att_c:tone_graph_rel_c;
      tone_ui_actual3=tone_ui_actual3*tone_gc+(_ta3-_toff)*(1-tone_gc);
      tone_gc=(_ta4-_toff)>tone_ui_actual4?tone_graph_att_c:tone_graph_rel_c;
      tone_ui_actual4=tone_ui_actual4*tone_gc+(_ta4-_toff)*(1-tone_gc);
      tone_gc=abs(tone_gd1)>abs(tone_ui_corr1)?tone_graph_att_c:tone_graph_rel_c;
      tone_ui_corr1=tone_ui_corr1*tone_gc+tone_gd1*(1-tone_gc);
      tone_gc=abs(tone_gd2)>abs(tone_ui_corr2)?tone_graph_att_c:tone_graph_rel_c;
      tone_ui_corr2=tone_ui_corr2*tone_gc+tone_gd2*(1-tone_gc);
      tone_gc=abs(tone_gd3)>abs(tone_ui_corr3)?tone_graph_att_c:tone_graph_rel_c;
      tone_ui_corr3=tone_ui_corr3*tone_gc+tone_gd3*(1-tone_gc);
      tone_gc=abs(tone_gd4)>abs(tone_ui_corr4)?tone_graph_att_c:tone_graph_rel_c;
      tone_ui_corr4=tone_ui_corr4*tone_gc+tone_gd4*(1-tone_gc);
    );
  );
  tone_eq_dyn_on<0.5?(
    tone_eq_gd1=tone_eq_gd2=tone_eq_gd3=tone_eq_gd4=0;
    tone_ui_eq_corr1=tone_ui_eq_corr2=tone_ui_eq_corr3=tone_ui_eq_corr4=0;
  ):(
    tone_gc=abs(tone_eq_gd1)>abs(tone_ui_eq_corr1)?tone_graph_att_c:tone_graph_rel_c;
    tone_ui_eq_corr1=tone_ui_eq_corr1*tone_gc+tone_eq_gd1*(1-tone_gc);
    tone_gc=abs(tone_eq_gd2)>abs(tone_ui_eq_corr2)?tone_graph_att_c:tone_graph_rel_c;
    tone_ui_eq_corr2=tone_ui_eq_corr2*tone_gc+tone_eq_gd2*(1-tone_gc);
    tone_gc=abs(tone_eq_gd3)>abs(tone_ui_eq_corr3)?tone_graph_att_c:tone_graph_rel_c;
    tone_ui_eq_corr3=tone_ui_eq_corr3*tone_gc+tone_eq_gd3*(1-tone_gc);
    tone_gc=abs(tone_eq_gd4)>abs(tone_ui_eq_corr4)?tone_graph_att_c:tone_graph_rel_c;
    tone_ui_eq_corr4=tone_ui_eq_corr4*tone_gc+tone_eq_gd4*(1-tone_gc);
  );
  tone_tg1=db2gain(tone_gd1+tone_eq_gd1);tone_tg2=db2gain(tone_gd2+tone_eq_gd2);
  tone_tg3=db2gain(tone_gd3+tone_eq_gd3);tone_tg4=db2gain(tone_gd4+tone_eq_gd4);
  tone_g1=(tone_tg1<tone_g1?tone_att_c:tone_rel_c)*tone_g1+(1-(tone_tg1<tone_g1?tone_att_c:tone_rel_c))*tone_tg1;
  tone_g2=(tone_tg2<tone_g2?tone_att_c:tone_rel_c)*tone_g2+(1-(tone_tg2<tone_g2?tone_att_c:tone_rel_c))*tone_tg2;
  tone_g3=(tone_tg3<tone_g3?tone_att_c:tone_rel_c)*tone_g3+(1-(tone_tg3<tone_g3?tone_att_c:tone_rel_c))*tone_tg3;
  tone_g4=(tone_tg4<tone_g4?tone_att_c:tone_rel_c)*tone_g4+(1-(tone_tg4<tone_g4?tone_att_c:tone_rel_c))*tone_tg4;

  xL=_tb1L*tone_g1+_tb2L*tone_g2+_tb3L*tone_g3+_tb4L*tone_g4;
  xR=_tb1R*tone_g1+_tb2R*tone_g2+_tb3R*tone_g3+_tb4R*tone_g4;
  xL=tone_pk1L.biquad_tick(xL);xR=tone_pk1R.biquad_tick(xR);
  xL=tone_pk2L.biquad_tick(xL);xR=tone_pk2R.biquad_tick(xR);
  xL=tone_pk3L.biquad_tick(xL);xR=tone_pk3R.biquad_tick(xR);
  xL=tone_pk4L.biquad_tick(xL);xR=tone_pk4R.biquad_tick(xR);
  tone_gr_db=max(max(max(abs(tone_gd1+tone_eq_gd1),abs(tone_gd2+tone_eq_gd2)),abs(tone_gd3+tone_eq_gd3)),abs(tone_gd4+tone_eq_gd4));
  tone_gr_db=max(tone_gr_db,max(max(abs(tone_gain1_eff),abs(tone_gain2_eff)),max(abs(tone_gain3_eff),abs(tone_gain4_eff))));
):(
  tone_g1=tone_g2=tone_g3=tone_g4=1;
  tone_tg1=tone_tg2=tone_tg3=tone_tg4=1;
  tone_gd1=tone_gd2=tone_gd3=tone_gd4=0;
  tone_eq_gd1=tone_eq_gd2=tone_eq_gd3=tone_eq_gd4=0;
  tone_ui_actual1=tone_t1;tone_ui_actual2=tone_t2;tone_ui_actual3=tone_t3;tone_ui_actual4=tone_t4;
  tone_ui_target1=tone_t1;tone_ui_target2=tone_t2;tone_ui_target3=tone_t3;tone_ui_target4=tone_t4;
  tone_ui_corr1=tone_ui_corr2=tone_ui_corr3=tone_ui_corr4=0;
  tone_ui_eq_corr1=tone_ui_eq_corr2=tone_ui_eq_corr3=tone_ui_eq_corr4=0;
  tone_gr_db=0;
);

// 4. LIMITER pre-gain
xL*=lim_pre_g;xR*=lim_pre_g;
_lim_detL=xL;_lim_detR=xR;

// 5. LIMITER (lookahead)
lim_on>=0.5?(
  _tp=isp_peak(_lim_detL,_lim_detR,gm_lim_prevL,gm_lim_prevR,gm_isp_mode);
  _rp=lim_ceiling_g;
  lim_rel_idx<lim_rel_spl?(_rp=lim_ceiling_g+(lim_rel_start-lim_ceiling_g)*lim_rel_win(lim_rel_idx/lim_rel_spl);lim_rel_idx+=1;);
  lim_peak=max(_rp,_tp);
  lim_peak<lim_ceiling_g?(lim_peak=lim_ceiling_g;lim_rel_start=lim_ceiling_g;lim_rel_idx=srate;):(_tp==lim_peak)?(
    lim_peak*=1.002;lim_rel_start=lim_peak;lim_rel_idx=0;
    i=1;startpeak=lim_ceiling_g;foundabove=0;foundintersection=0;intersectionindex=-1;bestcorrection=-1;bestindex=lim_look_spl-1;beststartpeak=lim_ceiling_g;
    while(i<lim_look_spl&&!foundintersection)(
      win=lim_att_win(1-i/lim_look_spl);rpos=writepos-i;rpos<0?rpos+=max_look_spl;
      op=max(bufPeak[rpos],lim_ceiling_g);nsp=lim_peak+(op-lim_peak)/(1-win);
      nsp>startpeak?(diff=(nsp-startpeak)*(1-win);(bestcorrection<0||diff<bestcorrection)?(bestcorrection=diff;bestindex=i;beststartpeak=nsp;);startpeak=nsp;intersectionindex=i;foundabove=1;):foundabove?(foundintersection=1;);i+=1;
    );
    foundintersection?(
      i=0;while(i<intersectionindex)(win=lim_att_win(1-i/lim_look_spl);rpos=writepos-i;rpos<0?rpos+=max_look_spl;bufPeak[rpos]=startpeak+(lim_peak-startpeak)*win;i+=1;);
    ):(
      i=0;while(i<bestindex)(win=lim_att_win(1-i/lim_look_spl);rpos=writepos-i;rpos<0?rpos+=max_look_spl;np=beststartpeak+(lim_peak-beststartpeak)*win;fr=1-i/max(1,bestindex);fw=1-(1-fr)*(1-fr);bufPeak[rpos]+=(np-bufPeak[rpos])*fw;i+=1;);
    );
  );
  bufL[writepos]=xL;bufR[writepos]=xR;bufPeak[writepos]=max(lim_peak,lim_ceiling_g);
  writepos+=1;writepos>=max_look_spl?writepos=0;
  rpos=writepos-lim_look_spl;rpos<0?rpos+=max_look_spl;
  op=max(bufPeak[rpos],lim_ceiling_g);
  lim_dist_B=lim_scale(op,lim_ceiling_g);lim_dist_A=lim_distc(op,lim_ceiling_g);
  xL=lim_dist(bufL[rpos]);xR=lim_dist(bufR[rpos]);
  lim_sat_w>0?(_op=max(abs(xL),abs(xR));_ip=max(abs(bufL[rpos]),abs(bufR[rpos]));lim_gain=_op/max(_ip,0.000000000001);):(lim_gain=lim_ceiling_g/op;);
  _pk=max(abs(xL),abs(xR));_pk>lim_ceiling_g?(_sc=lim_ceiling_g/_pk;xL*=_sc;xR*=_sc;);
):(lim_gain=1;);
gm_lim_prevL=_lim_detL;gm_lim_prevR=_lim_detR;
pk_lim_env=pk_decay(max(abs(xL),abs(xR)),pk_lim_env);

// 5. OUTPUT
pk_pre_env=pk_decay(max(abs(xL),abs(xR)),pk_pre_env);
outL=xL;outR=xR;

// Capture Lock operativo: misura RMS full-range sul segnale pre-auto, salva il livello medio,
// poi ricalcola solo il trim quando cambi preset/target. NON ricattura.
out_cal_state_i=clamp(floor(out_cal_state+0.5),0,2);
_mode=clamp(floor(out_mode+0.5),0,3);
out_cal_sig=0.5*(outL*outL+outR*outR);

out_cal_state_i==1 && _mode>0 && out_auto_db_on>=0.5?(
  meter_play_state && out_cal_sig > 0.000000000001 ? (
    out_cal_sum += out_cal_sig;
    out_cal_count += 1;
    out_cal_progress = min(100, 100 * out_cal_count / max(1, out_cal_target_spl));
    out_cal_lufs_avg = gain2db(sqrt(max(out_cal_sum / max(1,out_cal_count), 0.000000000001)));

    out_cal_count >= out_cal_target_spl ? (
      out_cal_lufs_avg = gain2db(sqrt(max(out_cal_sum / max(1,out_cal_count), 0.000000000001)));
      out_cal_trim = clamp(out_capture_target_db() - out_cal_lufs_avg, -out_trim_cap, out_trim_cap);
      out_cal_smooth_trim = out_cal_trim;
      out_cal_progress = 100;
      out_cal_state = 2;
      sliderchange(slider_mask(32));
      sliderchange(slider_mask(33));
    );
  ) : (
    out_cal_progress = min(99.9, 100 * out_cal_count / max(1, out_cal_target_spl));
  );
);

out_cal_state_i=clamp(floor(out_cal_state+0.5),0,2);
_mode=clamp(floor(out_mode+0.5),0,3);
(_mode==0 || out_auto_db_on<0.5)?(
  out_cal_smooth_trim = 0 + out_cal_smooth_c*(out_cal_smooth_trim-0);
  out_trim_db = 0 + out_trim_c*(out_trim_db-0);
):out_cal_state_i==2?(
  // In LOCK il valore catturato resta fisso. Cambiando POD/AUD/MIX/BRD/RAD
  // cambia soltanto il target, quindi viene ricalcolato il trim.
  out_cal_count > 0 ? (
    out_cal_lufs_avg = gain2db(sqrt(max(out_cal_sum / max(1,out_cal_count), 0.000000000001)));
  );
  out_cal_trim = clamp(out_capture_target_db() - out_cal_lufs_avg, -out_trim_cap, out_trim_cap);
  out_cal_smooth_trim = out_cal_trim + out_cal_smooth_c*(out_cal_smooth_trim-out_cal_trim);
  out_trim_db = out_cal_smooth_trim;
):(
  out_cal_smooth_trim = 0 + out_cal_smooth_c*(out_cal_smooth_trim-0);
  _err=0;
  !meter_prime_pending?(
    _mono=mono_lufs_comp();
    _mode==1?(
      _lref=cur_lufs_i>-80?cur_lufs_i+_mono:cur_lufs_s+_mono;
      _err=_lref>-80?out_target_lufs-_lref:0;
    ):_mode==2?(
      _err=rms_db>-80?out_target_rms-rms_db:0;
    ):(
      _lref=cur_lufs_i>-80?cur_lufs_i+_mono:cur_lufs_s+_mono;
      _le=_lref>-80?out_lr_lufs_target()-_lref:0;
      _re=rms_db>-80?out_lr_rms_target()-rms_db:0;
      _err=(_le+_re)*0.5;
    );
  );
  _tgt_trim=clamp(_err,-out_trim_cap,out_trim_cap);
  meter_just_primed?(out_trim_db=_tgt_trim;meter_just_primed=0;):(out_trim_db=_tgt_trim+out_trim_c*(out_trim_db-_tgt_trim););
);
out_auto_g=db2gain(out_trim_db);
outL*=out_auto_g;outR*=out_auto_g;

// Manual output makeup is final makeup, after Auto dB/Capture and before final safety.
outL*=out_man_g;outR*=out_man_g;

// Final safety limiter: last stage after manual/auto output gain.
_out_detL=outL;_out_detR=outR;
out_final_lim_on>=0.5?(
  _fpk=isp_peak(outL,outR,gm_out_prevL,gm_out_prevR,gm_isp_mode);
  _fpk>out_final_ceil_g?(
    out_final_lim_gain=min(out_final_lim_gain,out_final_ceil_g/max(_fpk,0.000000000001));
  ):(
    out_final_lim_gain=min(1,1+(out_final_lim_gain-1)*out_final_rel_c);
  );
  outL*=out_final_lim_gain;outR*=out_final_lim_gain;
  _fpk=isp_peak(outL,outR,gm_out_prevL*out_final_lim_gain,gm_out_prevR*out_final_lim_gain,gm_isp_mode);
  _fpk>out_final_ceil_g?(
    _fsc=out_final_ceil_g/max(_fpk,0.000000000001);
    outL*=_fsc;outR*=_fsc;out_final_lim_gain*=_fsc;
  );
  out_final_gr_db=max(0,-gain2db(max(out_final_lim_gain,0.000000000001)));
):(
  out_final_lim_gain=1;out_final_gr_db=0;
);
gm_out_prevL=_out_detL;gm_out_prevR=_out_detR;
play_declick_remaining>0?(
  _pdg=1-play_declick_remaining/play_declick_total;
  _pdg=_pdg*_pdg*(3-2*_pdg);
  outL*=_pdg;outR*=_pdg;
  play_declick_remaining-=1;
);
spl0=outL;spl1=outR;

// 6. METERING
meter_reset_pending?(
  rms_env=0.000000001;lufs_i_sum=0;lufs_i_count=0;
  phase_l_env=0.000000001;phase_r_env=0.000000001;phase_lr_env=0;ui_phase_corr=0;ui_phase_level_db=-100;
  lufs_m_env=0.000000001;lufs_s_env=0.000000001;lufs_i_env=0.000000001;
  cur_lufs_m=-100;cur_lufs_s=-100;cur_lufs_i=-100;rms_db=-100;
  target_lufs_env=0.000000001;target_rms_env=0.000000001;
  target_lufs_db=-100;target_rms_db=-100;target_meter_prime=1;
  out_peak_hold_dbfs=-100;out_peak_max_dbfs=-100;out_peak_hold_spl=0;
  out_peak_l_dbfs=-100;out_peak_r_dbfs=-100;ui_out_peak_l_dbfs=-100;ui_out_peak_r_dbfs=-100;
  ms_m_env=0.000000001;ms_s_env=0.000000001;ui_ms_mid_db=-100;ui_ms_side_db=-100;ui_ms_width_db=-100;
  meter_prime_pending=1;meter_just_primed=0;
  memset(lra_hist,0,LRA_BINS);lra_tick_cnt=0;lra_reco_cnt=0;ui_lra=0;
  meter_reset_pending=0;
);
pk_out_env=pk_decay(max(abs(outL),abs(outR)),pk_out_env);
tp1L=0.75*outL_prev+0.25*outL;tp2L=0.5*outL_prev+0.5*outL;tp3L=0.25*outL_prev+0.75*outL;
tp1R=0.75*outR_prev+0.25*outR;tp2R=0.5*outR_prev+0.5*outR;tp3R=0.25*outR_prev+0.75*outR;
tp_l_max=max(max(abs(outL),abs(tp1L)),max(abs(tp2L),abs(tp3L)));
tp_r_max=max(max(abs(outR),abs(tp1R)),max(abs(tp2R),abs(tp3R)));
tp_max=max(max(max(abs(outL),abs(outR)),max(abs(tp1L),abs(tp1R))),max(max(abs(tp2L),abs(tp2R)),max(abs(tp3L),abs(tp3R))));
out_peak_dbfs=gain2db(max(tp_max,0.000000000001));
out_peak_l_dbfs=gain2db(max(tp_l_max,0.000000000001));
out_peak_r_dbfs=gain2db(max(tp_r_max,0.000000000001));
meter_play_state?(
  out_peak_dbfs>out_peak_max_dbfs?out_peak_max_dbfs=out_peak_dbfs;
  out_peak_dbfs>out_peak_hold_dbfs||out_peak_hold_dbfs<=-90?(
    out_peak_hold_dbfs=out_peak_dbfs;
    out_peak_hold_spl=floor(0.55*srate);
  ):out_peak_hold_spl>0?(
    out_peak_hold_spl-=1;
  ):(
    out_peak_hold_dbfs=max(out_peak_dbfs,out_peak_hold_dbfs-12/max(1,srate));
  );
):(
  out_peak_hold_dbfs=out_peak_dbfs;
);
outL_prev=outL;outR_prev=outR;
sig_rms=0.5*(outL*outL+outR*outR);
_ms_m=(outL+outR)*0.70710678;_ms_s=(outL-outR)*0.70710678;
ms_m_env=_ms_m*_ms_m+meter_rms_c*(ms_m_env-_ms_m*_ms_m);
ms_s_env=_ms_s*_ms_s+meter_rms_c*(ms_s_env-_ms_s*_ms_s);
phase_l_env=outL*outL+phase_c*(phase_l_env-outL*outL);
phase_r_env=outR*outR+phase_c*(phase_r_env-outR*outR);
phase_lr_env=outL*outR+phase_c*(phase_lr_env-outL*outR);
ui_phase_level_db=gain2db(sqrt(max(0.5*(phase_l_env+phase_r_env),0.000000000001)));
ui_phase_corr=ui_phase_level_db>-80?clamp(phase_lr_env/sqrt(max(phase_l_env*phase_r_env,0.000000000001)),-1,1):0;
kmL=meter_hpL.biquad_tick(outL);kmL=meter_hsL.biquad_tick(kmL);
kmR=meter_hpR.biquad_tick(outR);kmR=meter_hsR.biquad_tick(kmR);
ke=kmL*kmL+kmR*kmR;
meter_prime_pending&&(sig_rms>0.00000001||ke>0.00000001)?(
  rms_env=sig_rms;lufs_m_env=ke;lufs_s_env=ke;lufs_i_env=ke;
  lufs_i_sum=ke;lufs_i_count=1;meter_prime_pending=0;meter_just_primed=1;
):(
  rms_env   =sig_rms +meter_rms_c*(rms_env-sig_rms);
  lufs_m_env=ke+meter_lufs_m_c*(lufs_m_env-ke);
  lufs_s_env=ke+meter_lufs_s_c*(lufs_s_env-ke);
);
rms_db=gain2db(sqrt(max(rms_env,0.000000000001)));
cur_lufs_m=LUFS_CAL_DB-0.691+10*log(max(lufs_m_env,0.000000000001))/log(10);
cur_lufs_s=LUFS_CAL_DB-0.691+10*log(max(lufs_s_env,0.000000000001))/log(10);
target_meter_prime&&(sig_rms>0.00000001||ke>0.00000001)?(
  target_lufs_env=ke;
  target_rms_env=sig_rms;
  target_meter_prime=0;
):(
  target_lufs_env=ke+target_meter_c*(target_lufs_env-ke);
  target_rms_env=sig_rms+target_meter_c*(target_rms_env-sig_rms);
);
target_lufs_db=LUFS_CAL_DB-0.691+10*log(max(target_lufs_env,0.000000000001))/log(10);
target_rms_db=gain2db(sqrt(max(target_rms_env,0.000000000001)));
meter_play_state?(
  cur_lufs_m>-70?(lufs_i_sum+=ke;lufs_i_count+=1;);
  lufs_i_count>0?(cur_lufs_i=LUFS_CAL_DB-0.691+10*log(max(lufs_i_sum/lufs_i_count,0.000000000001))/log(10);):(cur_lufs_i=-100;);
):(lufs_i_env=ke+meter_lufs_i_c*(lufs_i_env-ke);cur_lufs_i=LUFS_CAL_DB-0.691+10*log(max(lufs_i_env,0.000000000001))/log(10););

ui_in_db=gain2db(pk_in_env);ui_comp_gr=max(0,mt_gr_db);
ui_lim_gr=max(0,-gain2db(max(lim_gain,0.000000000001)));
ui_pre_db=gain2db(pk_pre_env);ui_out_db=gain2db(pk_out_env);
_mono_ui=mono_lufs_comp();

// MONO ANALYSIS is deliberately analysis-only. It models the nominal
// 3 dB reduction of a mono deliverable without touching the actual signal,
// Auto dB, limiter behaviour, gain staging or routing.
_mono_analysis_db=ui_mono_analysis>=0.5?-3.0:0;
ui_global_lufs_m=cur_lufs_m+_mono_ui+_mono_analysis_db;
ui_global_lufs_s=cur_lufs_s+_mono_ui+_mono_analysis_db;
ui_global_lufs_i=cur_lufs_i+_mono_ui+_mono_analysis_db;
ui_global_rms_db=rms_db+_mono_analysis_db;
ui_out_trim_db=out_trim_db;ui_out_pre_auto_dbfs=ui_pre_db;
ui_out_peak_dbfs=out_peak_hold_dbfs+_mono_analysis_db;
ui_out_peak_l_dbfs=out_peak_l_dbfs+_mono_analysis_db;
ui_out_peak_r_dbfs=out_peak_r_dbfs+_mono_analysis_db;
ui_ms_mid_db=gain2db(sqrt(max(ms_m_env,0.000000000001)));
ui_ms_side_db=gain2db(sqrt(max(ms_s_env,0.000000000001)));
ui_ms_width_db=ui_ms_side_db-ui_ms_mid_db;
ui_out_peak_max_dbfs=out_peak_max_dbfs;ui_tone_gr=tone_gr_db;ui_tape_amt=tape_on>=0.5?abs(tape_drive-0.5)*2+abs(tape_bump)*0.4:0;ui_final_gr=out_final_gr_db;
// Post-Master density: crest breve ricavato dall'uscita reale dopo Final Limiter.
ui_final_crest=max(0,ui_out_db-ui_global_rms_db);
ui_final_density=min(100,max(0,100-ui_final_crest*3.5));
ui_target_mode=clamp(floor(out_mode+0.5),0,3);
ui_target_err_db=0;ui_target_valid=0;
ui_target_mode==1?(
  _tref=target_lufs_db+_mono_ui+_mono_analysis_db;
  _rawref=(out_auto_db_on<0.5 ? cur_lufs_s+_mono_ui : (cur_lufs_i>-80?cur_lufs_i+_mono_ui:cur_lufs_s+_mono_ui))+_mono_analysis_db;
  _tref>-80?(ui_target_err_db=_tref-out_target_lufs;ui_target_raw_err_db=_rawref-out_target_lufs;ui_target_valid=1;);
):ui_target_mode==2?(
  target_rms_db>-80?(ui_target_err_db=(target_rms_db+_mono_analysis_db)-out_target_rms;ui_target_raw_err_db=(rms_db+_mono_analysis_db)-out_target_rms;ui_target_valid=1;);
):ui_target_mode==3?(
  _tref=target_lufs_db+_mono_ui+_mono_analysis_db;
  _rawref=(cur_lufs_i>-80?cur_lufs_i+_mono_ui:cur_lufs_s+_mono_ui)+_mono_analysis_db;
  _te1=_tref>-80?_tref-out_lr_lufs_target():0;
  _te2=target_rms_db>-80?(target_rms_db+_mono_analysis_db)-out_lr_rms_target():0;
  _raw1=_rawref>-80?_rawref-out_lr_lufs_target():0;
  _raw2=rms_db>-80?(rms_db+_mono_analysis_db)-out_lr_rms_target():0;
  (_tref>-80 || target_rms_db>-80)?(ui_target_err_db=(_te1+_te2)*0.5;ui_target_raw_err_db=(_raw1+_raw2)*0.5;ui_target_valid=1;);
);

// LRA
lra_tick_cnt+=1;lra_tick_cnt>=lra_tick_rate?(lra_tick_cnt=0;meter_play_state?(
  _lb=floor((cur_lufs_s+70)*LRA_BPD+0.5);_lb>=0&&_lb<LRA_BINS?lra_hist[_lb]+=1;
  lra_reco_cnt+=1;lra_reco_cnt>=30?(lra_reco_cnt=0;
    _ws=0;_wc=0;_b=0;loop(LRA_BINS,_c=lra_hist[_b];_c>0?(_ws+=_b*_c;_wc+=_c;);_b+=1;);
    _wc>5?(_gb=max(0,floor(_ws/_wc)-200);_gt=0;_b=_gb;loop(LRA_BINS-_gb,_gt+=lra_hist[_b];_b+=1;);
      _gt>=10?(_p10=_gt*0.10;_p95=_gt*0.95;
        _cum=0;_b=_gb;while(_b<LRA_BINS&&_cum<_p10)(_cum+=lra_hist[_b];_b+=1;);_blo=max(_gb,_b-1);
        _cum=0;_b=_gb;while(_b<LRA_BINS&&_cum<_p95)(_cum+=lra_hist[_b];_b+=1;);_bhi=max(_blo,_b-1);
        ui_lra=max(0,(_bhi-_blo)*0.1););););
  );
);
ext_gr_meter=mt_gr_db;

@gfx 900 1345

// ═══════════════════════════════════════════════════════════════════
// ZP Master Pro — GUI  (VUC v4.0 style)  v0.2
// ═══════════════════════════════════════════════════════════════════

// ── GUI helpers ────────────────────────────────────────────────
function set_ui_slider(sl_idx,v) local(m)(
  // slider66 e' soltanto uno specchio host: non deve richiamare @slider,
  // perche' @slider esegue compute_params() e reinizializza variabili GUI/mouse.
  sl_idx==66 ? (
    nav_measure_mode=max(0,min(2,floor(nav_mode_selected+0.5)));
  ) : (
    slider(sl_idx)=v;m=slider_mask(sl_idx);sliderchange(m);slider_automate(m);dsp_needs_update=1;
  );
);
function set_nav_mode(v) local(next_mode,old_mode)(
  // mouse_click e' gia' un fronte: nessun debounce basato su time_precise(),
  // che a trasporto fermo puo' non avanzare.
  next_mode=max(0,min(2,floor(v+0.5)));
  old_mode=max(0,min(2,floor(nav_mode_selected+0.5)));
  next_mode!=old_mode ? (
    nav_mode_selected=next_mode;
    // Aggiornamento immediato per GUI e logica anche quando @block non gira.
    nav_mode_i=next_mode;
    nav_measure_mode=next_mode;
    // Entrare in MANUAL non avvia mai una misura: serve RESET MEASURE.
    next_mode==0 ? nav_manual_complete=1 : nav_reset_window();
  );
);
function set_nav_time(v) local(m)(
  nav_time_selected=max(0,min(60,floor(v+0.5)));
  nav_measure_time=nav_time_selected;
  m=slider_mask(65);sliderchange(m);
);
function reset_out_cal()(
  out_cal_sum=0;out_cal_count=0;out_cal_progress=0;out_cal_smooth_trim=0;out_cal_lufs_avg=-100;
  set_ui_slider(32,0);set_ui_slider(33,0);
);
function prime_out_cal()(
  // NEW/CAP e' l'unico comando che azzera davvero la cattura.
  out_cal_sum=0;out_cal_count=0;out_cal_progress=0;out_cal_smooth_trim=0;out_cal_lufs_avg=-100;
  set_ui_slider(33,0);set_ui_slider(32,1);
);
function refresh_out_cal_trim()(
  out_cal_state_i=clamp(floor(out_cal_state+0.5),0,2);
  out_cal_state_i>=2?(
    out_cal_trim=clamp(out_capture_target_db()-out_cal_lufs_avg,-out_trim_cap,out_trim_cap);
    set_ui_slider(33,out_cal_trim);
  );
);
function request_meter_refresh() local(j)(
  // GUI refresh only: do not re-prime the Auto dB detector.
  avg_lufs_disp=-999;avg_rms_disp=-999;avg_peak_disp=-999;
  disp_lufs_m=-999;disp_lufs_s=-999;disp_lra=-999;avg_hold_frames=4;
  out_peak_hold_dbfs=-100;out_peak_max_dbfs=-100;out_peak_hold_spl=0;
  out_peak_l_dbfs=-100;out_peak_r_dbfs=-100;ui_out_peak_l_dbfs=-100;ui_out_peak_r_dbfs=-100;
  ms_m_env=0.000000001;ms_s_env=0.000000001;ui_ms_mid_db=-100;ui_ms_side_db=-100;ui_ms_width_db=-100;
  ui_out_peak_dbfs=-100;ui_out_peak_max_dbfs=-100;ui_lra=0;
  j=0;loop(20,pkh_base[j]=-90;j+=1;);
);
function ui_set_hover(id) ( ui_hover_id=id; );
function hit(x,y,w,h) ( mouse_x>=x&&mouse_x<=(x+w)&&mouse_y>=y&&mouse_y<=(y+h) );

function show_slider_range(lo,hi) local(j)(
  j=lo;
  loop(hi-lo+1,
    slider_show(slider_mask(j),1);
    j+=1;
  );
);

function apply_host_slider_visibility(show_host)
local(i)(
  ui_host_visibility_state!=show_host?(
    i=1;
    loop(55,
      slider_show(slider_mask(i),0);
      i+=1;
    );
    // JSFX mode keeps only View visible in the native panel so @gfx stays reachable.
    slider_show(slider_mask(34), show_host);
    // Always hide internal Smart Cap sliders (32, 33)
    slider_show(slider_mask(32),0);
    slider_show(slider_mask(33),0);
    ui_host_visibility_state=show_host;
  );
);

// One-time @gfx init
gfx_init_done?0:(
  gfx_init_done=1;
  // @gfx deve essere autonoma da @block: deriva il modo anche a STOP.
  nav_mode_i=max(0,min(2,floor(nav_mode_selected+0.5)));
  nav_measure_mode=nav_mode_i;
  avg_lufs_disp=-999;avg_rms_disp=-999;avg_peak_disp=-999;
  disp_lufs_m=-999;disp_lufs_s=-999;disp_lra=-999;
  avg_hold_frames=0;ui_prev_play_state=0;
);

// Freeze MEASURE display on stop / reset on play start
play_state>0?(
  ui_prev_play_state==0?(
    avg_lufs_disp=-999;avg_rms_disp=-999;avg_peak_disp=-999;
    disp_lufs_m=-999;disp_lufs_s=-999;disp_lra=-999;avg_hold_frames=4;
  );
  avg_hold_frames>0?avg_hold_frames-=1:(
    avg_lufs_disp=ui_global_lufs_i;avg_rms_disp=ui_global_rms_db;
    avg_peak_disp=ui_out_peak_dbfs;disp_lufs_m=ui_global_lufs_m;
    disp_lufs_s=ui_global_lufs_s;disp_lra=ui_lra;
  );
):(
  ui_prev_play_state>0?(
    i=0;loop(20,pkh_base[i]=-90;i+=1;);
    ui_global_lufs_m=-100;ui_global_lufs_s=-100;ui_global_lufs_i=-100;
    ui_global_rms_db=-100;ui_out_peak_dbfs=-100;
    meter_prime_pending=1;meter_just_primed=0;
    out_trim_db=0;out_auto_g=1;
  );
);
ui_prev_play_state=play_state;

gfx_set(0.09,0.08,0.07,1);gfx_rect(0,0,gfx_w,gfx_h);
btn_down=mouse_cap&1;
mouse_click=btn_down&&!ui_prev_mouse_down;
mouse_release=!btn_down&&ui_prev_mouse_down;
fine_tune=(mouse_cap&8)?0.08:1.0;
mouse_release&&(knob_active_sl==26||knob_active_sl==28)?request_meter_refresh();
!btn_down?knob_active_sl=0;
ui_hover_id=0;
auto_help_open=0;

// ── gfx_ext_flags: GUI mode = hide native param panel ────────────
gfx_ext_flags = floor(gfx_view+0.5)==0 ? (1|2|4|8) : 0;
apply_host_slider_visibility(floor(gfx_view+0.5)==1 ? 1 : 0);

// Altezza reale del flusso: Header + Engine + Meter + Navigator + footer.
// Lo scroll generale deve conoscere il Navigator, senza overlay sul viewport.
BASE_W=900;BASE_H=1345;
PX0=14;PX=PX0;KR=21;KS=86;
PH=150;  // engine panel height extra
TIP_H=38;
HDR_H=67;
ENGINE_LAYOUT_H=PH+260+26+18+18;
METER_LAYOUT_H=PH+218;
NAV_LAYOUT_H=320;
ui_show_engine=ui_show_engine>=0.5;
ui_show_meter=ui_show_meter>=0.5;
ui_show_nav=ui_show_nav>=0.5;
content_w=max(BASE_W,gfx_w);
content_h=HDR_H+8
  +(ui_show_engine?ENGINE_LAYOUT_H+4:0)
  +(ui_show_meter?METER_LAYOUT_H+10:0)
  +(ui_show_nav?NAV_LAYOUT_H+10:0)
  +TIP_H+18;
content_h=max(HDR_H+TIP_H+40,content_h);

// ── Scroll (VUC style): wheel delta + drag bars ────────────────
  _sc_max_y=max(0,content_h-gfx_h);
  _sc_max_x=max(0,content_w-gfx_w);
floor(gfx_view+0.5)==0?(
  _wdelta=mouse_wheel-last_mouse_wheel;
  _hwdelta=mouse_hwheel-last_mouse_hwheel;
  (mouse_cap&8)?(_hwdelta+=_wdelta;_wdelta=0;);

  _sc_max_y>0?(ui_scroll_y_tgt-=_wdelta*0.35;);
  _sc_max_x>0?(ui_scroll_x_tgt+=_hwdelta*0.35;);

  last_mouse_wheel=mouse_wheel;
  last_mouse_hwheel=mouse_hwheel;

  // drag vertical scrollbar thumb
  (scroll_drag_mode==1)&&btn_down?(
    _track_h=max(1,gfx_h-TIP_H-HDR_H);
    _thumb_h=max(22,floor(_track_h*gfx_h/max(1,content_h)));
    _usable=max(1,_track_h-_thumb_h);
    _newp=max(0,min(_usable,mouse_y-scroll_drag_off));
    ui_scroll_y_tgt=(_newp/_usable)*_sc_max_y;
  );

  // drag horizontal scrollbar thumb
  (scroll_drag_mode==2)&&btn_down?(
    _htrack_w=max(1,gfx_w-(_sc_max_y>0?12:2));
    _hthumb_w=max(22,floor(_htrack_w*gfx_w/max(1,content_w)));
    _husable=max(1,_htrack_w-_hthumb_w);
    _hnewp=max(0,min(_husable,mouse_x-scroll_drag_off));
    ui_scroll_x_tgt=(_hnewp/_husable)*_sc_max_x;
  );

  !btn_down?scroll_drag_mode=0;

  ui_scroll_x_tgt=max(0,min(_sc_max_x,ui_scroll_x_tgt));
  ui_scroll_y_tgt=max(0,min(_sc_max_y,ui_scroll_y_tgt));
  ui_scroll_x += (ui_scroll_x_tgt-ui_scroll_x)*0.28;
  ui_scroll_y += (ui_scroll_y_tgt-ui_scroll_y)*0.28;
):(
  ui_scroll_x=0;ui_scroll_y=0;
  ui_scroll_x_tgt=0;ui_scroll_y_tgt=0;
  scroll_drag_mode=0;
  last_mouse_wheel=mouse_wheel;
  last_mouse_hwheel=mouse_hwheel;
);
_sx=floor(gfx_view+0.5)==0?-floor(ui_scroll_x+0.5):0;
_sy=floor(gfx_view+0.5)==0?-floor(ui_scroll_y+0.5):0;

PW=content_w-PX0*2;

// ═══════════════════════════════════════════════════════════════════
// JSFX ACCESSIBILITY VIEW  (OSARA-friendly parameter table)
// ═══════════════════════════════════════════════════════════════════

function draw_knob_arc(cx,cy,r,pct,ena)
local(start,span,steps,i,a1,a2,x1,y1,x2,y2,rr)(
  rr=r+4;start=-2.356;span=4.712;steps=26;
  gfx_set(0.24,0.27,0.30,ena?0.50:0.28);
  i=0;loop(steps,
    a1=start+(i/steps)*span;a2=start+((i+1)/steps)*span;
    x1=cx+rr*sin(a1);y1=cy-rr*cos(a1);
    x2=cx+rr*sin(a2);y2=cy-rr*cos(a2);
    gfx_line(x1,y1,x2,y2,1);
    x1=cx+(rr+1)*sin(a1);y1=cy-(rr+1)*cos(a1);
    x2=cx+(rr+1)*sin(a2);y2=cy-(rr+1)*cos(a2);
    gfx_line(x1,y1,x2,y2,1);
    i+=1;
  );
  ena?gfx_set(mod_r*0.50+0.42,mod_g*0.38+0.54,mod_b*0.30+0.60,1.00):gfx_set(0.44,0.44,0.48,0.64);
  i=0;loop(max(1,floor(steps*pct)),
    a1=start+(i/steps)*span;a2=start+((i+1)/steps)*span;
    x1=cx+rr*sin(a1);y1=cy-rr*cos(a1);
    x2=cx+rr*sin(a2);y2=cy-rr*cos(a2);
    gfx_line(x1,y1,x2,y2,1);
    x1=cx+(rr+1)*sin(a1);y1=cy-(rr+1)*cos(a1);
    x2=cx+(rr+1)*sin(a2);y2=cy-(rr+1)*cos(a2);
    gfx_line(x1,y1,x2,y2,1);
    i+=1;
  );
);

// ── ui_knob (VUC style) ────────────────────────────────────────
function ui_knob(sl_idx,cx,cy,r,minv,maxv,defv,label,hover_id)
local(val,hover,pct,angle,nx,ny,_tw,_th,new_val,rng,dbl,ena,_vf,_lf,
      meter_on,meter_db,meter_pct,meter_ang,meter_r,tick_ang)(
  val=slider(sl_idx);rng=maxv-minv;ena=(ui_enable>=0.5);
  pct=max(0,min(1,(val-minv)/max(0.0001,rng)));
  hover=(mouse_x-cx)*(mouse_x-cx)+(mouse_y-cy)*(mouse_y-cy)<=(r+6)*(r+6);
  ena&&hover?ui_set_hover(hover_id);
  ena&&hover&&mouse_click?(
    dbl=(hover_id==last_dbl_id)&&(time_precise()-last_dbl_time<0.38);
    dbl?(set_ui_slider(sl_idx,defv);val=defv;pct=max(0,min(1,(val-minv)/max(0.0001,rng)));knob_active_sl=0;):(
      knob_active_sl=sl_idx;knob_drag_y0=mouse_y;knob_drag_v0=val;);
    last_dbl_id=hover_id;last_dbl_time=time_precise();
  );
  ena&&knob_active_sl==sl_idx&&btn_down?(
    new_val=max(minv,min(maxv,knob_drag_v0+(knob_drag_y0-mouse_y)*fine_tune*rng/160));
    abs(new_val-val)>0.0002?(set_ui_slider(sl_idx,new_val);val=new_val;pct=max(0,min(1,(val-minv)/max(0.0001,rng))););
  );
  // Live detector ring for compressor threshold and limiter ceiling.
  meter_on=sl_idx==7||sl_idx==2;
  meter_on?(
    meter_db=sl_idx==7?gain2db(max(gm_macro_det,0.000000000001)):
                         gain2db(max(_tp,0.000000000001));
    meter_pct=max(0,min(1,(meter_db-minv)/max(0.0001,rng)));
    meter_ang=2.356+meter_pct*4.712;meter_r=r+5;
    gfx_set(0.24,0.25,0.29,ena?0.72:0.35);
    gfx_arc(cx,cy,meter_r,2.356,7.068,1);gfx_arc(cx,cy,meter_r+1,2.356,7.068,1);
    meter_db>=val?gfx_set(mod_r*0.35+0.60,mod_g*0.30+0.62,mod_b*0.24+0.68,ena?1:0.45):
                  gfx_set(mod_r*0.42+0.18,mod_g*0.38+0.18,mod_b*0.38+0.20,ena?0.72:0.35);
    gfx_arc(cx,cy,meter_r,2.356,meter_ang,1);gfx_arc(cx,cy,meter_r+1,2.356,meter_ang,1);
    tick_ang=2.356+pct*4.712;gfx_set(0.94,0.95,0.98,ena?0.92:0.40);
    gfx_line(cx+cos(tick_ang)*(meter_r-2),cy+sin(tick_ang)*(meter_r-2),
             cx+cos(tick_ang)*(meter_r+2),cy+sin(tick_ang)*(meter_r+2),1);
  );
  draw_knob_arc(cx,cy,r,pct,ena);
  !ena?gfx_set(0.13,0.13,0.14,1):knob_active_sl==sl_idx?gfx_set(mod_r*0.40+0.02,mod_g*0.30+0.02,mod_b*0.38+0.02,1):gfx_set(mod_r*0.22+0.02,mod_g*0.18+0.02,mod_b*0.22+0.02,1);
  gfx_circle(cx,cy,r,1,1);
  !ena?gfx_set(0.34,0.34,0.38,0.75):gfx_set(mod_r*0.82+0.16,mod_g*0.82+0.16,mod_b*0.82+0.16,0.96);gfx_circle(cx,cy,r,0,1);
  angle=-2.356+pct*4.712;nx=cx+(r-2)*sin(angle);ny=cy-(r-2)*cos(angle);
  !ena?gfx_set(0.45,0.45,0.48,0.85):gfx_set(mod_r*0.45+0.48,mod_g*0.34+0.62,mod_b*0.24+0.72,1);gfx_line(cx,cy,nx,ny,1);
  _vf=ui_knob_value_font>0?ui_knob_value_font:12;
  _lf=ui_knob_label_font>0?ui_knob_label_font:12;
  gfx_setfont(1,"Arial",_vf);gfx_set(0.92,0.92,0.94,1);
  abs(val)>=100?sprintf(#_vk,"%.0f",val):abs(val)>=10?sprintf(#_vk,"%.1f",val):sprintf(#_vk,"%.2f",val);
  gfx_measurestr(#_vk,_tw,_th);gfx_x=cx-_tw*0.5;gfx_y=cy-r-17;gfx_drawstr(#_vk);
  !ena?gfx_set(0.45,0.45,0.48,0.85):gfx_set(mod_r*0.54+0.38,mod_g*0.36+0.44,mod_b*0.32+0.46,1);
  gfx_setfont(1,"Arial",_lf);
  gfx_measurestr(label,_tw,_th);gfx_x=cx-_tw*0.5;gfx_y=cy+r+4;gfx_drawstr(label);
);

// ── ui_opt ─────────────────────────────────────────────────────
function ui_opt(sl_idx,this_val,label,x,y,w,h,hover_id)
local(hover,sel,_tw,_th,_fs,ena)(
  ena=(ui_enable>=0.5);
  sel=floor(slider(sl_idx)+0.5)==this_val;
  hover=ena&&hit(x,y,w,h);hover?ui_set_hover(hover_id);
  ena&&!ui_render_only&&hover&&mouse_click?set_ui_slider(sl_idx,this_val);
  !ena?gfx_set(0.09,0.10,0.11,1):sel?gfx_set(mod_r*0.55,mod_g*0.50,mod_b*0.55,1):gfx_set(0.12,0.16,0.22,1);gfx_rect(x,y,w,h);
  _fs=h>=19?11:10;
  !ena?gfx_set(0.42,0.43,0.46,0.95):gfx_set(0.88,0.92,0.96,1);gfx_setfont(1,"Arial",_fs,'b');
  gfx_measurestr(label,_tw,_th);gfx_x=x+floor((w-_tw)*0.5);gfx_y=y+floor((h-_th)*0.5);gfx_drawstr(label);
);

function ui_mini_fader(sl_idx,x,y,w,h,minv,maxv,defv,label,hover_id)
local(hover,ena,val,pct,newpct,newv,_tw,_th)(
  ena=(ui_enable>=0.5);val=slider(sl_idx);pct=clamp((val-minv)/max(0.0000001,maxv-minv),0,1);
  hover=ena&&hit(x,y,w,h);hover?ui_set_hover(hover_id);
  !ui_render_only&&hover&&btn_down?(
    newpct=clamp((mouse_x-x)/max(1,w),0,1);
    (mouse_cap&4)?newpct=clamp((defv-minv)/max(0.0000001,maxv-minv),0,1);
    newv=minv+newpct*(maxv-minv);
    set_ui_slider(sl_idx,newv);
    pct=newpct;val=newv;
  );
  gfx_set(0.045,0.055,0.060,1);gfx_rect(x,y,w,h);
  ena?gfx_set(mod_r*0.46+0.12,mod_g*0.46+0.12,mod_b*0.46+0.12,1):gfx_set(0.11,0.11,0.12,1);
  gfx_rect(x,y,floor(w*pct),h);
  hover?gfx_set(mod_r,mod_g,mod_b,1):gfx_set(mod_r,mod_g,mod_b,0.62);
  gfx_rect(x,y,w,1);gfx_rect(x,y+h-1,w,1);
  gfx_setfont(1,"Arial",10,'b');gfx_set(0.84,0.88,0.90,0.98);
  sprintf(#_mf,"%s %.0f",label,val);
  gfx_measurestr(#_mf,_tw,_th);gfx_x=x+4;gfx_y=y+floor((h-_th)*0.5);gfx_drawstr(#_mf);
);

// ── ui_toggle_btn ──────────────────────────────────────────────
function ui_toggle_btn(sl_idx,x,y,w,h,lbl,ar,ag,ab,hover_id)
local(state,hover,_tw,_th,ena)(
  state=floor(slider(sl_idx)+0.5);ena=(ui_enable>=0.5);
  hover=hit(x,y,w,h);ena&&hover?ui_set_hover(hover_id);
  ena&&!ui_render_only&&hover&&mouse_click?(set_ui_slider(sl_idx,1-state);state=1-state;);
  !ena?gfx_set(0.11,0.11,0.12,1):state?gfx_set(ar*0.40,ag*0.35,ab*0.40,1):gfx_set(0.10,0.12,0.14,1);gfx_rect(x,y,w,h);
  !ena?gfx_set(0.24,0.24,0.27,1):state?gfx_set(ar,ag,ab,1):gfx_set(0.28,0.28,0.32,1);
  gfx_rect(x,y,w,1);gfx_rect(x,y,1,h);gfx_rect(x+w-1,y,1,h);gfx_rect(x,y+h-1,w,1);
  !ena?gfx_set(0.48,0.48,0.52,0.85):state?gfx_set(1,1,1,1):gfx_set(0.40,0.40,0.44,1);
  gfx_setfont(1,"Arial",10,'b');gfx_measurestr(lbl,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5);gfx_y=y+floor((h-_th)*0.5);gfx_drawstr(lbl);
);

function ui_tone_din_button(x,y,w,h,hover_id)
local(state,hover,_tw,_th)(
  state=tone_points_dyn>=0.5?1:0;
  hover=hit(x,y,w,h);hover?ui_set_hover(hover_id);
  !ui_render_only&&hover&&mouse_click?(
    tone_points_dyn=1-state;
    state=1-state;
    dsp_needs_update=1;
  );
  state?gfx_set(0.10,0.42,0.34,1):hover?gfx_set(0.16,0.16,0.18,1):gfx_set(0.08,0.08,0.09,1);
  gfx_rect(x,y,w,h);
  state?gfx_set(0.38,0.96,0.78,1):hover?gfx_set(0.70,0.72,0.76,1):gfx_set(0.28,0.30,0.34,0.95);
  gfx_rect(x,y,w,1);gfx_rect(x,y+h-1,w,1);
  gfx_rect(x,y,1,h);gfx_rect(x+w-1,y,1,h);
  state?gfx_set(0.76,1.00,0.92,1):hover?gfx_set(0.88,0.90,0.94,0.96):gfx_set(0.56,0.58,0.62,0.96);
  gfx_setfont(1,"Arial",9,'b');gfx_measurestr("DIN",_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5);gfx_y=y+floor((h-_th)*0.5);gfx_drawstr("DIN");
);

