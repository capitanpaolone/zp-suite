  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx2;gfx_y=_y;gfx_drawstr("Auto MU");
  floor(slider(19)+0.5)?(gfx_set(0.26,0.92,0.36,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr("ON")):(gfx_set(0.46,0.46,0.50,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr("off"));
  _y+=_rh;

  // Row 15
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx1;gfx_y=_y;gfx_drawstr("LIM on");
  floor(slider(15)+0.5)?(gfx_set(0.92,0.24,0.24,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr("ON")):(gfx_set(0.46,0.46,0.50,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr("off"));
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx2;gfx_y=_y;gfx_drawstr("Tape Bias");
  sprintf(#_jv,"%.2f",slider(20));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  _y+=_rh;

  // Row 16
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx1;gfx_y=_y;gfx_drawstr("View mode");
  floor(gfx_view+0.5)==1?(gfx_set(0.36,0.60,0.92,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr("JSFX")):(gfx_set(0.92,0.94,0.96,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr("GUI"));
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx2;gfx_y=_y;gfx_drawstr("Head Freq [Hz]");
  sprintf(#_jv,"%.2f",slider(21));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr(#_jv);

  // Tip bar
  gfx_set(0.09,0.08,0.07,1);gfx_rect(0,gfx_h-TIP_H,gfx_w,TIP_H);
  gfx_set(0.16,0.44,0.86,0.45);gfx_rect(0,gfx_h-TIP_H,gfx_w,1);
  gfx_setfont(1,"Arial",11);gfx_set(0.66,0.75,0.80,1);gfx_x=8;gfx_y=gfx_h-17;
  gfx_drawstr("JSFX mode: parametri visibili per OSARA — clicca GUI per la vista grafica");

):(  // ══════════════════════════════════════════════════════════════════
// FULL GUI VIEW
// ══════════════════════════════════════════════════════════════════
PX=PX0+_sx;

// ══════════════════════════════════════════════════════════════════
// HEADER
// ══════════════════════════════════════════════════════════════════
gfx_set(0.11,0.10,0.09,1);gfx_rect(0,_sy,gfx_w,HDR_H);
gfx_set(0.16,0.50,0.92,1);gfx_rect(0,_sy,gfx_w,3);
gfx_set(0.18,0.20,0.24,1);gfx_rect(0,_sy+HDR_H-1,gfx_w,1);
gfx_setfont(1,"Arial",21,'b');gfx_set(0.94,0.96,0.98,1);
gfx_x=PX;gfx_y=8+_sy;gfx_drawstr("ZP Master Pro");
gfx_setfont(1,"Arial",13,'b');gfx_set(0.50,0.66,0.92,1);
gfx_x=PX;gfx_y=39+_sy;gfx_drawstr("Master Processor | v2.45 Circular Threshold Meters - di Paolo Balestri");

// Header module ON buttons
ui_enable=1;
_bx=PX+PW-363;_by=12+_sy;
mod_r=0.66;mod_g=0.68;mod_b=0.70;
ui_toggle_btn(13,_bx,     _by,52,20,"TAPE",0.66,0.68,0.70,501);
mod_r=0.86;mod_g=0.54;mod_b=0.14;
ui_toggle_btn(14,_bx+57,  _by,60,20,"COMP",0.86,0.54,0.14,502);
mod_r=0.98;mod_g=0.68;mod_b=0.22;
ui_enable=_comp_on;
ui_toggle_btn(55,_bx+122, _by,54,20,"GLUE",0.98,0.68,0.22,505);
ui_enable=1;
mod_r=0.18;mod_g=0.78;mod_b=0.68;
ui_toggle_btn(35,_bx+181,_by,54,20,"TONE",0.18,0.78,0.68,504);
mod_r=0.90;mod_g=0.24;mod_b=0.24;
ui_toggle_btn(15,_bx+240,_by,52,20,"LIM", 0.90,0.24,0.24,503);
// View tabs
_bx2=PX+PW-63;
gfx_setfont(1,"Arial",10);
floor(gfx_view+0.5)==0?gfx_set(0.16,0.44,0.90,1):gfx_set(0.14,0.14,0.18,1);gfx_rect(_bx2,_by,29,20);
gfx_set(0.80,0.84,0.92,1);gfx_measurestr("GUI",_tw,_th);gfx_x=_bx2+floor((29-_tw)*0.5);gfx_y=_by+floor((20-_th)*0.5);gfx_drawstr("GUI");
hit(_bx2,_by,29,20)&&mouse_click?set_ui_slider(34,0);
floor(gfx_view+0.5)==1?gfx_set(0.16,0.44,0.90,1):gfx_set(0.14,0.14,0.18,1);gfx_rect(_bx2+31,_by,32,20);
gfx_set(0.80,0.84,0.92,1);gfx_measurestr("JSFX",_tw,_th);gfx_x=_bx2+31+floor((32-_tw)*0.5);gfx_y=_by+floor((20-_th)*0.5);gfx_drawstr("JSFX");
hit(_bx2+31,_by,32,20)&&mouse_click?set_ui_slider(34,1);

// Panel visibility: visual layout only, never changes DSP or metering.
_vby=39+_sy;_vbw=46;_vbg=4;_vbx=PX+PW-(_vbw*3+_vbg*2+68);
ui_show_engine?gfx_set(0.18,0.50,0.90,1):gfx_set(0.12,0.14,0.18,1);gfx_rect(_vbx,_vby,_vbw,18);
gfx_setfont(1,"Arial",9,'b');gfx_set(0.88,0.92,0.96,1);gfx_x=_vbx+7;gfx_y=_vby+5;gfx_drawstr("ENGINE");
hit(_vbx,_vby,_vbw,18)&&mouse_click?(ui_show_engine=1-ui_show_engine;ui_scroll_y_tgt=0;ui_scroll_y=0;);
_vbx2=_vbx+_vbw+_vbg;
ui_show_meter?gfx_set(0.18,0.50,0.90,1):gfx_set(0.12,0.14,0.18,1);gfx_rect(_vbx2,_vby,_vbw,18);
gfx_set(0.88,0.92,0.96,1);gfx_x=_vbx2+8;gfx_y=_vby+5;gfx_drawstr("METER");
hit(_vbx2,_vby,_vbw,18)&&mouse_click?(ui_show_meter=1-ui_show_meter;ui_scroll_y_tgt=0;ui_scroll_y=0;);
_vbx3=_vbx2+_vbw+_vbg;
ui_show_nav?gfx_set(0.18,0.50,0.90,1):gfx_set(0.12,0.14,0.18,1);gfx_rect(_vbx3,_vby,_vbw,18);
gfx_set(0.88,0.92,0.96,1);gfx_x=_vbx3+12;gfx_y=_vby+5;gfx_drawstr("NAV");
hit(_vbx3,_vby,_vbw,18)&&mouse_click?(ui_show_nav=1-ui_show_nav;ui_scroll_y_tgt=0;ui_scroll_y=0;);

// ══════════════════════════════════════════════════════════════════
// ENGINE PANEL
// ══════════════════════════════════════════════════════════════════
ENG_Y=HDR_H+4+_sy;COMP_GR_GAP=26;TONE_ACT_GAP=18;LIM_GR_GAP=18;ENG_H=PH+260+COMP_GR_GAP+TONE_ACT_GAP+LIM_GR_GAP;
ui_show_engine ? (
mod_r=0.20;mod_g=0.54;mod_b=0.92;
draw_shell(PX,ENG_Y,PW,ENG_H,"ENGINE");
_tape_on=floor(slider(13)+0.5);
_comp_on=floor(slider(14)+0.5);
_lim_on=floor(slider(15)+0.5);

// Engine rows: four equal bands from top content to the utility buttons.
ERX=PX+5; ERY0=ENG_Y+34; ERW=395; ERH=77; ERC=39;
ky1=ERY0+ERC; ky2=ERY0+ERH+ERC; ky3=ERY0+ERH*2+COMP_GR_GAP+ERC; ky4=ERY0+ERH*3+COMP_GR_GAP+TONE_ACT_GAP+ERC;
ki=PX+82;KS=64;

// Row 1 (TAPE): Drive · Tilt · Shape · Flutter · Bump
draw_engine_row_band(ERX,ERY0,ERW,ERH,"TAPE",0.66,0.68,0.70);
ui_enable=_tape_on;mod_r=0.66;mod_g=0.68;mod_b=0.70;
ui_knob(1,  ki,      ky1,KR,  0,     1, 0.5,"DRIVE",  1001);
ui_knob(6,  ki+KS,   ky1,KR,  0,     1, 0.5,"TILT",   1006);
ui_knob(10, ki+KS*2, ky1,KR,  0.0001,0.9999,0.5,"SHAPE",1010);
ui_knob(11, ki+KS*3, ky1,KR,  0,     1,   0,"FLUTTER",1011);
ui_knob(12, ki+KS*4, ky1,KR,  0,     1,0.25,"BUMP",   1012);

// Row 2 (COMP): C.Thr · C.Rat · SC HPF
draw_engine_row_band(ERX,ERY0+ERH,ERW,ERH,"COMP",0.86,0.54,0.14);
ui_enable=_comp_on;mod_r=0.86;mod_g=0.54;mod_b=0.14;
ui_knob(7, ki,       ky2,KR,-60,    0,-14,"C.THR", 1007);
ui_knob(8, ki+KS,    ky2,KR,  1,   20,2.6,"C.RAT", 1008);
ui_knob(9, ki+KS*2,  ky2,KR,  0,10000,  0,"SC HPF",1009);
_cbw=54;_cbh=18;_cbg=6;_cbx=ki+KS*3-16;_cby=ERY0+ERH+17;
ui_enable=_comp_on;mod_r=0.26;mod_g=0.72;mod_b=0.36;
ui_toggle_btn(16,_cbx,          _cby,_cbw,_cbh,"SOFT",0.86,0.72,0.22,1020);
ui_toggle_btn(17,_cbx+_cbw+_cbg,_cby,_cbw,_cbh,"RMS", 0.62,0.46,0.90,1021);
ui_toggle_btn(18,_cbx,          _cby+_cbh+_cbg,_cbw,_cbh,"FFW",0.86,0.54,0.14,1022);
ui_toggle_btn(19,_cbx+_cbw+_cbg,_cby+_cbh+_cbg,_cbw,_cbh,"AMU",0.26,0.72,0.36,1023);
_cmpgry=ERY0+ERH*2+2;
gfx_set(0.12,0.09,0.06,1);gfx_rect(ERX+48,_cmpgry-2,ERW-50,14);
mod_r=0.86;mod_g=0.54;mod_b=0.14;
draw_hsegs_gr(ERX+58,_cmpgry,ERW-72,9,ui_comp_gr,0,"CMP");
gfx_set(0.86*0.62+0.34,0.54*0.62+0.34,0.14*0.62+0.34,0.78);gfx_rect(ERX+48,_cmpgry+12,ERW-50,1);

// Row 3 (TONE): Tone Guard + Tape Bias
draw_engine_row_band(ERX,ERY0+ERH*2+COMP_GR_GAP,ERW,ERH,"TONE",0.18,0.78,0.68);
ui_enable=floor(slider(35)+0.5);mod_r=0.18;mod_g=0.78;mod_b=0.68;
ui_knob(36, ki,       ky3,KR, -3,    8, 0.0,"SLOPE", 1041);
ui_enable=floor(slider(35)+0.5) && (tone_points_dyn>=0.5 || tone_eq_dyn>=0.5);mod_r=0.18;mod_g=0.78;mod_b=0.68;
ui_knob(37, ki+KS,    ky3,KR,  0,  100,  35,"AMT",   1042);
ui_knob(38, ki+KS*2,  ky3,KR, 20, 2000, 250,"ATK",   1043);
ui_knob(39, ki+KS*3,  ky3,KR,100, 6000,1800,"REL",   1044);
ui_enable=_tape_on;mod_r=0.66;mod_g=0.68;mod_b=0.70;
ui_knob(20, ki+KS*4,  ky3,KR,  0,    1, 0.5,"BIAS",  1024);
_toneacty=ERY0+ERH*3+COMP_GR_GAP+4;
_toneon_read=floor(slider(35)+0.5);
_tonedyn_read=_toneon_read*((tone_points_dyn>=0.5 || tone_eq_dyn>=0.5)?1:0);
_toneeqpos=(max(0,tone_gain1_eff)+max(0,tone_gain2_eff)+max(0,tone_gain3_eff)+max(0,tone_gain4_eff))*_toneon_read;
_toneeqneg=(max(0,-tone_gain1_eff)+max(0,-tone_gain2_eff)+max(0,-tone_gain3_eff)+max(0,-tone_gain4_eff))*_toneon_read;
_tonedynpos=(max(0,tone_ui_corr1+tone_ui_eq_corr1)+max(0,tone_ui_corr2+tone_ui_eq_corr2)+max(0,tone_ui_corr3+tone_ui_eq_corr3)+max(0,tone_ui_corr4+tone_ui_eq_corr4))*_tonedyn_read;
_tonedynneg=(max(0,-tone_ui_corr1-tone_ui_eq_corr1)+max(0,-tone_ui_corr2-tone_ui_eq_corr2)+max(0,-tone_ui_corr3-tone_ui_eq_corr3)+max(0,-tone_ui_corr4-tone_ui_eq_corr4))*_tonedyn_read;
_tonecx=ERX+48+floor((ERW-50)*0.5);_tonebw=ERW-50;_tonehalfw=floor(_tonebw*0.5);
_toneeqy=_toneacty;_tonedyny=_toneacty+7;_tonebarh=4;
gfx_set(0.04,0.07,0.07,1);gfx_rect(_tonecx-_tonehalfw,_toneacty-2,_tonebw,16);
gfx_set(0.09,0.16,0.14,1);gfx_rect(_tonecx,_toneeqy,_tonehalfw,_tonebarh);gfx_rect(_tonecx,_tonedyny,_tonehalfw,_tonebarh);
gfx_set(0.16,0.06,0.06,1);gfx_rect(_tonecx-_tonehalfw,_toneeqy,_tonehalfw,_tonebarh);gfx_rect(_tonecx-_tonehalfw,_tonedyny,_tonehalfw,_tonebarh);
