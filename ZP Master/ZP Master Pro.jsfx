  inputSampleL+=tape_hysteresisL*applyHysteresis;
  applyHysteresis=(1-abs(inputSampleR))*(1-abs(inputSampleR))*0.012;
  tape_hysteresisR=clamp(tape_hysteresisR+(inputSampleR*abs(inputSampleR)),-0.011449,0.011449)*0.999;
  inputSampleR+=tape_hysteresisR*applyHysteresis;

