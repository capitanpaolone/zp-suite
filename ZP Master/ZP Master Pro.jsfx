  gfx_set(0.98,0.74,0.32,1);gfx_x=_hpx+24;gfx_y=_hpy+226;gfx_drawstr("DEP = quantita' di glue. FRG = piu' lavoro verso micro e crest.");
  gfx_set(0.72,0.82,0.92,1);gfx_x=_hpx+24;gfx_y=_hpy+258;gfx_drawstr("Texture: SM morbido, API punch, SSA piu' compatto.");
  gfx_set(0.72,0.92,0.82,1);gfx_x=_hpx+24;gfx_y=_hpy+290;gfx_drawstr("ISP OFF/2x/4x e' detection interpolata globale, non uno stadio audio.");
  gfx_set(0.88,0.78,0.62,1);gfx_x=_hpx+24;gfx_y=_hpy+334;gfx_drawstr("A/B: AMU e Glue possono alzare la loudness percepita.");
