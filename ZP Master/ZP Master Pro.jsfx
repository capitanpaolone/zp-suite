    tape_compEncL=tape_compEncL*(1-tape_iir_enc_freq)+dubly*tape_iir_enc_freq;
    inputSampleL+=highPart*tape_compEncL*tape_dubly_amt;
  );
  tape_iirEncR=tape_iirEncR*(1-tape_iir_enc_freq)+inputSampleR*tape_iir_enc_freq;
  highPart=((inputSampleR-tape_iirEncR)*2.848)+tape_avgEncR;
  tape_avgEncR=(inputSampleR-tape_iirEncR)*1.152;
  highPart=clamp(highPart,-1,1); dubly=abs(highPart);
  dubly>0?(
    adjust=log(1+255*dubly)/2.40823996531;
    adjust>0?dubly/=adjust;
    tape_compEncR=tape_compEncR*(1-tape_iir_enc_freq)+dubly*tape_iir_enc_freq;
