  state?gfx_set(0.76,1.00,0.92,1):hover?gfx_set(0.88,0.90,0.94,0.96):gfx_set(0.56,0.58,0.62,0.96);
  gfx_setfont(1,"Arial",9,'b');gfx_measurestr("EQD",_tw,_th);
