    );
    count+=floor(offset);
    inputSampleR=tape_dR[count-(count>999?1000:0)]*(1-(offset-floor(offset)));
    inputSampleR+=tape_dR[count+1-(count+1>999?1000:0)]*(offset-floor(offset));
