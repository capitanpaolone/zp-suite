  zp_bus_unified_1175>=zp_bus_unified_la2 && zp_bus_unified_1175>=zp_bus_unified_major ? sprintf(#zp_bus_detail,"Compressione elevata per %s: valuta alleggerimento nel 1175",#zp_bus_profile_text) :
