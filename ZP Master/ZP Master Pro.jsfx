  state?gfx_set(0.38,0.96,0.78,1):hover?gfx_set(0.70,0.72,0.76,1):gfx_set(0.28,0.30,0.34,0.95);
  gfx_rect(x,y,w,1);gfx_rect(x,y+h-1,w,1);
