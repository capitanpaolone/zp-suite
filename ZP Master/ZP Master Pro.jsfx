function tone_reset_freqs_gfx()
(
  set_ui_slider(36,0.0);
  set_ui_slider(42,40); set_ui_slider(43,425); set_ui_slider(44,2120); set_ui_slider(45,20000);
  set_ui_slider(47,0); set_ui_slider(48,0); set_ui_slider(49,0); set_ui_slider(50,0);
  tone_preset=0;
  dsp_needs_update=1;
);

function tone_reset_all_gfx()
(
  set_ui_slider(36,0.0); set_ui_slider(37,0); set_ui_slider(38,250); set_ui_slider(39,1800);
  tone_reset_freqs_gfx();
  set_ui_slider(47,0); set_ui_slider(48,0); set_ui_slider(49,0); set_ui_slider(50,0);
  tone_points_dyn=0;
  tone_eq_dyn=0;
  tone_preset=0;
  dsp_needs_update=1;
);

function ui_tone_rst_button(x,y,w,h,hover_id)
local(hover,_tw,_th)(
  hover=hit(x,y,w,h);hover?ui_set_hover(hover_id);
  hover&&mouse_click?(
    tone_rst_down_time=time_precise();
    tone_rst_hold_done=0;
  );
  hover&&btn_down&&tone_rst_down_time>0&&!tone_rst_hold_done&&(time_precise()-tone_rst_down_time)>0.5?(
    tone_reset_all_gfx();
    tone_rst_hold_done=1;
  );
  mouse_release&&tone_rst_down_time>0?(
    hover&&!tone_rst_hold_done?tone_reset_freqs_gfx();
    tone_rst_down_time=0;
    tone_rst_hold_done=0;
  );
  hover?gfx_set(0.22,0.16,0.16,1):gfx_set(0.08,0.08,0.09,1);
  gfx_rect(x,y,w,h);
  hover?gfx_set(0.86,0.60,0.56,1):gfx_set(0.36,0.32,0.34,0.95);
  gfx_rect(x,y,w,1);gfx_rect(x,y+h-1,w,1);
  gfx_rect(x,y,1,h);gfx_rect(x+w-1,y,1,h);
  hover?gfx_set(1.00,0.86,0.82,1):gfx_set(0.62,0.62,0.66,0.96);
  gfx_setfont(1,"Arial",9,'b');gfx_measurestr("RST",_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5);gfx_y=y+floor((h-_th)*0.5);gfx_drawstr("RST");
);

function apply_tone_manual_flat_gfx()
(
  set_ui_slider(35,1);
  set_ui_slider(36,0.0); set_ui_slider(37,0); set_ui_slider(38,250); set_ui_slider(39,1800);
  set_ui_slider(42,90); set_ui_slider(43,425); set_ui_slider(44,2120); set_ui_slider(45,9000);
  set_ui_slider(47,0); set_ui_slider(48,0); set_ui_slider(49,0); set_ui_slider(50,0);
  tone_preset=0;
  dsp_needs_update=1;
);

function apply_tone_preset_gfx(val)
(
  floor(tone_preset+0.5)==val ? (
    apply_tone_manual_flat_gfx();
  ) : (
    set_ui_slider(35,1);
    set_ui_slider(42,90); set_ui_slider(43,425); set_ui_slider(44,2120); set_ui_slider(45,9000);
    set_ui_slider(47,0); set_ui_slider(48,0); set_ui_slider(49,0); set_ui_slider(50,0);
    val==1 ? (set_ui_slider(36,0.0); set_ui_slider(37,0);  set_ui_slider(38,250); set_ui_slider(39,1800););
    val==2 ? (set_ui_slider(36,1.0); set_ui_slider(37,35); set_ui_slider(38,250); set_ui_slider(39,1800););
    val==3 ? (set_ui_slider(36,2.2); set_ui_slider(37,45); set_ui_slider(38,320); set_ui_slider(39,2400););
    val==4 ? (set_ui_slider(36,0.2); set_ui_slider(37,40); set_ui_slider(38,180); set_ui_slider(39,1500););
    tone_preset=val;
    dsp_needs_update=1;
  );
);

function ui_tone_preset_button(val,x,y,w,h,label,hover_id)
local(selected,hover,_tw,_th)(
  selected=floor(tone_preset+0.5)==val;
  hover=hit(x,y,w,h);hover?ui_set_hover(hover_id);
  !ui_render_only&&hover&&mouse_click?apply_tone_preset_gfx(val);
  selected?gfx_set(0.10,0.42,0.34,1):hover?gfx_set(0.15,0.42,0.38,1):gfx_set(0.08,0.18,0.17,1);
  gfx_rect(x,y,w,h);
  selected?gfx_set(0.38,0.96,0.78,1):gfx_set(0.26,0.78,0.70,0.95);
  gfx_rect(x,y,w,1);gfx_rect(x,y+h-1,w,1);
  gfx_rect(x,y,1,h);gfx_rect(x+w-1,y,1,h);
  selected?gfx_set(0.76,1.00,0.92,1):gfx_set(0.82,0.96,0.92,0.96);
  gfx_setfont(1,"Arial",9,'b');gfx_measurestr(label,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5);gfx_y=y+floor((h-_th)*0.5);gfx_drawstr(label);
);

// ── draw_shell (VUC module panel) ─────────────────────────────
function draw_shell(px,py,pw,ph,title)
local(act,_tw,_th)(
  gfx_set(0.12,0.11,0.09,1);gfx_rect(px,py,pw,ph);
  gfx_set(mod_r,mod_g,mod_b,1);gfx_rect(px,py,pw,2);gfx_rect(px,py+ph-2,pw,2);
  gfx_rect(px,py,2,ph);gfx_rect(px+pw-2,py,2,ph);
  gfx_setfont(1,"Arial",13,'b');gfx_set(mod_r*0.6+0.28,mod_g*0.4+0.36,mod_b*0.2+0.56,1);
  gfx_x=px+12;gfx_y=py+8;gfx_drawstr(title);
);

function draw_engine_row_band(x,y,w,h,lbl,rr,gg,bb)
local(_tw,_th)(
  gfx_set(0.075+rr*0.055,0.065+gg*0.040,0.058+bb*0.045,0.86);gfx_rect(x,y,w,h);
  gfx_set(rr*0.50+0.24,gg*0.50+0.24,bb*0.50+0.24,0.22);gfx_rect(x+50,y+5,w-58,h-10);
  gfx_set(rr*0.62+0.34,gg*0.62+0.34,bb*0.62+0.34,0.78);gfx_rect(x+48,y+h-1,w-50,1);
  gfx_set(rr*0.62+0.34,gg*0.62+0.34,bb*0.62+0.34,0.34);gfx_rect(x+48,y+4,1,h-8);
  gfx_setfont(1,"Arial",11,'b');gfx_set(rr*0.76+0.32,gg*0.76+0.32,bb*0.76+0.32,1);
  gfx_measurestr(lbl,_tw,_th);gfx_x=x+8;gfx_y=y+floor((h-_th)*0.5);gfx_drawstr(lbl);
);

function draw_output_row_band(x,y,w,h,lbl,rr,gg,bb)
local(_tw,_th)(
  gfx_set(0.055+rr*0.022,0.052+gg*0.017,0.050+bb*0.020,0.72);gfx_rect(x,y,w,h);
  gfx_set(rr*0.55+0.28,gg*0.55+0.28,bb*0.55+0.28,0.54);gfx_rect(x+48,y+h+2,w-50,1);
  gfx_set(rr,gg,bb,0.18);gfx_rect(x+48,y+4,1,h-8);
  gfx_setfont(1,"Arial",11,'b');gfx_set(rr*0.70+0.28,gg*0.70+0.28,bb*0.70+0.28,0.98);
  gfx_measurestr(lbl,_tw,_th);gfx_x=x+8;gfx_y=y+6;gfx_drawstr(lbl);
);

// ── draw_hsegs_gr (GR bar meter) ──────────────────────────────
function draw_hsegs_gr(bx,by,bw,bh,gr,pkh_slot,label)
local(ns,gp,sw,i,sg,ip,ph,_tw,_th,_lx,_ly)(
  ns=20;gp=1;sw=max(1,floor((bw-(ns-1)*gp)/ns));
  ph=pkh_base[pkh_slot];
  gr>ph?(ph=gr;):(ph-=PEAK_DECAY*0.5;ph=max(ph,0););pkh_base[pkh_slot]=ph;
  gfx_set(0.05,0.05,0.07,1);gfx_rect(bx,by,bw,bh);
  i=0;loop(ns,sg=(i/(ns-1.0))*24.0;
    ip=(!gr>=sg)&&(ph>=sg)&&(ph<sg+24.0/(ns-1.0));
    ip?gfx_set(1.0,1.0,1.0,0.88):gr>=sg?gfx_set(mod_r*0.50+0.12,mod_g*0.22+0.06,mod_b*0.52+0.30,0.88):gfx_set(mod_r*0.06,mod_g*0.04,mod_b*0.08,0.30);
    gfx_rect(bx+(ns-1-i)*(sw+gp),by,sw,bh);i+=1;);
  gfx_setfont(1,"Arial",9);gfx_set(0.64,0.72,0.78,1);
  gr>0?sprintf(#_gr,"%s %.1f",label,gr):sprintf(#_gr,"%s --",label);
  gfx_measurestr(#_gr,_tw,_th);
  _lx=bx+bw-_tw-2; _lx<bx?(_lx=bx;);
  _ly=by-11;
  gfx_x=_lx;gfx_y=_ly;gfx_drawstr(#_gr);
);

// ── draw_vseg (LIVE vertical meter) ───────────────────────────
function draw_vseg(bx,by,bw,bh,db,label,nr,ng,nb)
local(ns,gap,sh,i,sv,ion,sr,sg,sb,_tw,_th)(
  ns=24;gap=2;sh=max(1,floor((bh-(ns-1)*gap)/ns));i=0;
  loop(ns,sv=-60.0+(i/23.0)*66.0;
    sv>0?(sr=0.92;sg=0.12;sb=0.12;):sv>-9?(sr=0.90;sg=0.76;sb=0.10;):(sr=nr;sg=ng;sb=nb;);
    ion=db>=sv;
    gfx_r=sr*(ion?1.0:0.12);gfx_g=sg*(ion?1.0:0.12);gfx_b=sb*(ion?1.0:0.12);gfx_a=ion?0.95:0.35;
    gfx_rect(bx,by+bh-(i+1)*(sh+gap)+gap,bw,sh);i+=1;);
  gfx_setfont(1,"Arial",10);gfx_set(0.52,0.62,0.58,1);
  gfx_measurestr(label,_tw,_th);gfx_x=bx+(bw-_tw)*0.5;gfx_y=by+bh+5;gfx_drawstr(label);
  db>-60?sprintf(#_vv,"%.1f",db):sprintf(#_vv,"--");gfx_set(0.90,0.96,0.92,1);
  gfx_setfont(1,"Arial",15,'b');
  gfx_measurestr(#_vv,_tw,_th);gfx_x=bx+(bw-_tw)*0.5;gfx_y=by-_th-8;gfx_drawstr(#_vv);
);

// ── draw_vseg_dense (compact LIVE meter inspired by ZP Loudness Meter) ──
function zp_meter_db_norm(db)
local(v)(
  v=clamp(db,-60,6);
  pow((v+60)/66,1.35);
);

function draw_meter_db_axis(x,y,h)
local(i,db,yy,_tw,_th)(
  gfx_setfont(1,"Arial",9,'b');
  i=0;
  loop(7,
    i==0?(db=0;);
    i==1?(db=-6;);
    i==2?(db=-12;);
    i==3?(db=-24;);
    i==4?(db=-36;);
    i==5?(db=-48;);
    i==6?(db=-60;);
    yy=y+h-floor(zp_meter_db_norm(db)*h);
    gfx_set(0.58,0.70,0.76,0.90);gfx_rect(x-7,yy,6,1);
    gfx_set(0.72,0.84,0.88,0.98);sprintf(#_dbax,"%.0f",db);gfx_measurestr(#_dbax,_tw,_th);
    gfx_x=x;gfx_y=yy-floor(_th*0.5);gfx_drawstr(#_dbax);
    i+=1;
  );
);

function draw_vseg_dense(bx,by,bw,bh,db,label,nr,ng,nb)
local(ns,gap,sh,i,sv,ion,sr,sg,sb,_tw,_th,_yy,_fillh)(
  ns=42;gap=1;sh=max(1,floor((bh-(ns-1)*gap)/ns));
  gfx_set(0.035,0.040,0.046,1);gfx_rect(bx-1,by-1,bw+2,bh+2);
  i=0;
  loop(ns,
    sv=-60.0+(i/(ns-1.0))*66.0;
    sv>0?(sr=0.94;sg=0.14;sb=0.14;):sv>-9?(sr=0.90;sg=0.74;sb=0.10;):(sr=nr;sg=ng;sb=nb;);
    ion=db>=sv;
    gfx_r=sr*(ion?1.0:0.10);gfx_g=sg*(ion?1.0:0.10);gfx_b=sb*(ion?1.0:0.10);gfx_a=ion?0.96:0.32;
    _yy=by+bh-(i+1)*(sh+gap)+gap;
    gfx_rect(bx,_yy,bw,sh);
    i+=1;
  );
  _fillh=floor(zp_meter_db_norm(db)*bh);
  _fillh>0?(gfx_set(nr,ng,nb,0.12);gfx_rect(bx,by+bh-_fillh,bw,_fillh););
  gfx_setfont(1,"Arial",9,'b');gfx_set(0.58,0.68,0.64,0.98);
  gfx_measurestr(label,_tw,_th);gfx_x=bx+floor((bw-_tw)*0.5);gfx_y=by+bh+5;gfx_drawstr(label);
);

function draw_vseg_dense_stereo_tp(bx,by,bw,bh,dbL,dbR,label,nr,ng,nb)
local(ns,gap,sh,i,sv,ionL,ionR,sr,sg,sb,_tw,_th,_yy,_lw,_rw,_rx)(
  ns=42;gap=1;sh=max(1,floor((bh-(ns-1)*gap)/ns));
  _lw=max(3,floor((bw-1)*0.5));_rw=max(3,bw-_lw-1);_rx=bx+_lw+1;
  gfx_set(0.035,0.040,0.046,1);gfx_rect(bx-1,by-1,bw+2,bh+2);
  gfx_set(0.18,0.22,0.20,0.90);gfx_rect(bx+_lw,by,1,bh);
  i=0;
  loop(ns,
    sv=-60.0+(i/(ns-1.0))*66.0;
    sv>0?(sr=0.94;sg=0.14;sb=0.14;):sv>-9?(sr=0.90;sg=0.74;sb=0.10;):(sr=nr;sg=ng;sb=nb;);
    _yy=by+bh-(i+1)*(sh+gap)+gap;
    ionL=dbL>=sv;
    gfx_r=sr*(ionL?1.0:0.10);gfx_g=sg*(ionL?1.0:0.10);gfx_b=sb*(ionL?1.0:0.10);gfx_a=ionL?0.96:0.32;
    gfx_rect(bx,_yy,_lw,sh);
    ionR=dbR>=sv;
    gfx_r=sr*(ionR?1.0:0.10);gfx_g=sg*(ionR?1.0:0.10);gfx_b=sb*(ionR?1.0:0.10);gfx_a=ionR?0.96:0.32;
    gfx_rect(_rx,_yy,_rw,sh);
    i+=1;
  );
  gfx_setfont(1,"Arial",7,'b');gfx_set(0.76,0.90,0.78,0.95);
  gfx_measurestr("L",_tw,_th);gfx_x=bx+floor((_lw-_tw)*0.5);gfx_y=by+2;gfx_drawstr("L");
  gfx_measurestr("R",_tw,_th);gfx_x=_rx+floor((_rw-_tw)*0.5);gfx_y=by+2;gfx_drawstr("R");
  gfx_setfont(1,"Arial",9,'b');gfx_set(0.58,0.68,0.64,0.98);
  gfx_measurestr(label,_tw,_th);gfx_x=bx+floor((bw-_tw)*0.5);gfx_y=by+bh+5;gfx_drawstr(label);
);

function draw_live_ms_indicator(x,y,w,h)
local(cx,half,corr,fill,mid_x,side_x,_tw,_th,width_txt_x)(
  w>120?(
    hit(x,y,w,h)?ui_set_hover(9063);
    gfx_set(0.040,0.048,0.052,1);gfx_rect(x,y,w,h);
    gfx_set(0.18,0.50,0.90,0.22);gfx_rect(x,y,w,1);gfx_rect(x,y+h-1,w,1);
    gfx_setfont(1,"Arial",8,'b');
    gfx_set(0.72,0.82,0.88,0.95);gfx_x=x+5;gfx_y=y+3;gfx_drawstr("MONO");
    gfx_measurestr("ST",_tw,_th);gfx_x=x+w-_tw-5;gfx_y=y+3;gfx_drawstr("ST");
    mid_x=x+43;side_x=x+w-43;
    cx=floor((mid_x+side_x)*0.5);half=max(10,floor((side_x-mid_x)*0.5));
    gfx_set(0.11,0.10,0.10,1);gfx_rect(cx-half,y+6,half,5);
    gfx_set(0.08,0.14,0.12,1);gfx_rect(cx,y+6,half,5);
    corr=clamp(ui_phase_corr,-1,1);
    fill=floor(abs(corr)*half);
    corr<0?gfx_set(0.92,0.24,0.24,0.86):corr<0.25?gfx_set(0.92,0.74,0.24,0.86):gfx_set(0.22,0.82,0.42,0.88);
    corr<0?gfx_rect(cx-fill,y+6,fill,5):gfx_rect(cx,y+6,fill,5);
    gfx_set(0.86,0.92,0.90,0.90);gfx_rect(cx-1,y+3,2,h-6);
    gfx_setfont(1,"Arial",8,'b');
    sprintf(#_msw,"S-M %.1f",ui_ms_width_db);
    gfx_set(0.72,0.55,1.00,0.95);gfx_measurestr(#_msw,_tw,_th);
    width_txt_x=x+floor((w-_tw)*0.5);gfx_x=width_txt_x;gfx_y=y+h-11;gfx_drawstr(#_msw);
  );
);

function tone_scope_y(v,y,h) local(vv)(
  vv=clamp(v,-18,18);
  y+floor(h*0.52-vv*(h*0.34/18));
);

function tone_user_y(v,y,h) local(vv)(
  vv=clamp(v,-6,6);
  y+floor(h*0.52-vv*(h*0.40/6));
);

function tone_freq_to_x(freq,x,w) local(lmin,lmax,p)(
  lmin=log(40);lmax=log(20000);
  p=(log(clamp(freq,40,20000))-lmin)/max(0.0001,lmax-lmin);
  x+floor(clamp(p,0,1)*w);
);

function tone_x_to_freq(mx,x,w) local(lmin,lmax,p)(
  lmin=log(40);lmax=log(20000);
  p=clamp((mx-x)/max(1,w),0,1);
  exp(lmin+p*(lmax-lmin));
);

function draw_tone_guard_strip(x,y,w,h)
local(i,scope_x,scope_w,scope_y,scope_h,actual,target,corr,freq,user,user_eff,px,sy,ty,uy,fill,bar_y,dyn_y,_tw,_th,hover,active_pt,nf,ng,lx,ly,ltx,lty,psx,psy,ptx,pty,label_y,value_y,cr,cg,cb,_dbl)(
  scope_x=x+10;scope_w=w-20;scope_y=y+34;scope_h=h-64;
  gfx_set(0.045,0.060,0.058,1);gfx_rect(x,y,w,h);
  gfx_set(0.10,0.34,0.31,0.78);gfx_rect(x,y,w,1);gfx_rect(x,y+h-1,w,1);
  gfx_setfont(1,"Arial",12,'b');gfx_set(0.62,0.96,0.90,1);
  gfx_x=x+6;gfx_y=y+5;gfx_drawstr("TONE SLOPE MAP");
  gfx_setfont(1,"Arial",9,'b');gfx_set(0.66,0.76,0.74,0.90);
  gfx_x=x+w-78;gfx_y=y+6;gfx_drawstr("FREQ POINTS");
  gfx_set(0.060,0.078,0.078,1);gfx_rect(scope_x,scope_y,scope_w,scope_h);
  gfx_set(0.13,0.18,0.18,1);gfx_rect(scope_x+3,scope_y+floor(scope_h*0.52),scope_w-6,1);
  !btn_down?tone_drag_pt=0;
  i=0;
  loop(4,
    i==0?(actual=tone_ui_actual1;target=tone_ui_target1;corr=tone_ui_corr1+tone_ui_eq_corr1;freq=tone_f1c;user=tone_gain1;strcpy(#_tl,"LOW"););
    i==1?(actual=tone_ui_actual2;target=tone_ui_target2;corr=tone_ui_corr2+tone_ui_eq_corr2;freq=tone_f2c;user=tone_gain2;strcpy(#_tl,"L-M"););
    i==2?(actual=tone_ui_actual3;target=tone_ui_target3;corr=tone_ui_corr3+tone_ui_eq_corr3;freq=tone_f3c;user=tone_gain3;strcpy(#_tl,"M-H"););
    i==3?(actual=tone_ui_actual4;target=tone_ui_target4;corr=tone_ui_corr4+tone_ui_eq_corr4;freq=tone_f4c;user=tone_gain4;strcpy(#_tl,"HIGH"););
    user_eff=clamp(user,-6,6);
    i==0?(cr=0.42;cg=0.96;cb=0.70;);
    i==1?(cr=0.35;cg=0.78;cb=1.00;);
    i==2?(cr=0.98;cg=0.78;cb=0.34;);
    i==3?(cr=0.80;cg=0.62;cb=1.00;);
    px=tone_freq_to_x(freq,scope_x,scope_w);
    sy=tone_scope_y(actual,scope_y,scope_h);
    ty=tone_scope_y(target,scope_y,scope_h);
    uy=tone_user_y(user_eff,scope_y,scope_h);
    hover=((mouse_x-px)*(mouse_x-px)+(mouse_y-uy)*(mouse_y-uy))<81;
    hover?ui_set_hover(9100+i);
    hover&&mouse_click?(
      _dbl=(9100+i==last_dbl_id)&&(time_precise()-last_dbl_time<0.38);
      _dbl?(
        i==0?set_ui_slider(47,0);
        i==1?set_ui_slider(48,0);
        i==2?set_ui_slider(49,0);
        i==3?set_ui_slider(50,0);
        user=0;user_eff=0;uy=tone_user_y(0,scope_y,scope_h);
        tone_drag_pt=0;
      ):(
        tone_drag_pt=i+1;
      );
      last_dbl_id=9100+i;last_dbl_time=time_precise();
    );
    tone_drag_pt==i+1&&btn_down?(
      nf=tone_x_to_freq(mouse_x,scope_x,scope_w);
      i==0?set_ui_slider(42,clamp(nf,40,min(250,slider(43)/1.08)));
      i==1?set_ui_slider(43,clamp(nf,max(180,slider(42)*1.08),min(1200,slider(44)/1.08)));
      i==2?set_ui_slider(44,clamp(nf,max(800,slider(43)*1.08),min(15000,slider(45)/1.08)));
      i==3?set_ui_slider(45,clamp(nf,max(4000,slider(44)*1.08),20000));
      ng=clamp((scope_y+floor(scope_h*0.52)-mouse_y)*(6/(scope_h*0.40)),-6,6);
      i==0?set_ui_slider(47,ng);
      i==1?set_ui_slider(48,ng);
      i==2?set_ui_slider(49,ng);
      i==3?set_ui_slider(50,ng);
      user=ng;user_eff=clamp(user,-6,6);uy=tone_user_y(user_eff,scope_y,scope_h);
    );
    active_pt=hover||tone_drag_pt==i+1;
    i>0?(
      gfx_set(0.18,0.64,0.58,0.52);gfx_line(ptx,pty,px,ty,1);
      gfx_set(0.86,0.96,0.92,0.66);gfx_line(psx,psy,px,sy,1);
    );
    gfx_set(cr*0.65,cg*0.72,cb*0.68,active_pt?1:0.62);gfx_circle(px,ty,active_pt?5:4,1,1);
    gfx_set(0.86,0.96,0.92,0.95);gfx_circle(px,sy,3,1,1);
    gfx_set(0.24,0.42,0.38,0.65);gfx_line(px,tone_user_y(0,scope_y,scope_h),px,uy,1);
    active_pt?gfx_set(cr,cg,cb,1):gfx_set(0.78,0.90,0.84,0.62);
    gfx_circle(px,uy,active_pt?5:4,1,1);
    gfx_set(0.02,0.03,0.03,0.85);gfx_circle(px,uy,active_pt?5:4,0,1);
    fill=min(22,abs(corr)*7);
    bar_y=y+h-17;
    corr< -0.02?(gfx_set(0.92,0.30,0.18,0.90);gfx_rect(px-fill,bar_y,fill,5);):
    corr> 0.02?(gfx_set(0.20,0.82,0.66,0.90);gfx_rect(px,bar_y,fill,5););
    abs(corr)>0.04?(
      gfx_setfont(1,"Arial",10,'b');
      sprintf(#_dyn,"DYN %+.1f",corr);
      gfx_measurestr(#_dyn,_tw,_th);
      dyn_y=y+h-11;
      gfx_set(0.02,0.03,0.03,0.82);
      gfx_rect(clamp(px-floor(_tw*0.5)-2,scope_x,scope_x+scope_w-_tw-4),dyn_y-1,_tw+4,_th+2);
      corr<0?gfx_set(1.00,0.42,0.30,active_pt?1:0.92):gfx_set(0.36,0.96,0.78,active_pt?1:0.92);
      gfx_x=clamp(px-floor(_tw*0.5),scope_x,scope_x+scope_w-_tw);
      gfx_y=dyn_y;
      gfx_drawstr(#_dyn);
    );
    label_y=(i==1||i==3)?y+36:y+27;
    value_y=(i==1||i==3)?y+h-42:y+h-30;
    gfx_setfont(1,"Arial",10,'b');
    active_pt?gfx_set(cr,cg,cb,1):gfx_set(0.74,0.84,0.82,0.90);
    gfx_measurestr(#_tl,_tw,_th);lx=clamp(px-floor(_tw*0.5),scope_x,scope_x+scope_w-_tw);gfx_x=lx;gfx_y=label_y;gfx_drawstr(#_tl);
    gfx_setfont(1,"Arial",13,'b');
    sprintf(#_hz,"%.0f  %+.1f",freq,user_eff);
    active_pt?gfx_set(cr,cg,cb,1):gfx_set(0.78,0.86,0.84,0.82);
    gfx_measurestr(#_hz,_tw,_th);gfx_x=clamp(px-floor(_tw*0.5),scope_x,scope_x+scope_w-_tw);gfx_y=value_y;gfx_drawstr(#_hz);
    ptx=px;pty=ty;psx=px;psy=sy;
    i+=1;
  );
);

// ── ui_out_preset ──────────────────────────────────────────────
function ui_out_preset(pidx,label,x,y,w,h,hid,lufs,rms,maxtrm,speed,mkp,mode)
local(hover,sel,_tw,_th)(
  sel=out_preset_sel==pidx;
  hover=hit(x,y,w,h);hover?ui_set_hover(hid);
  !ui_render_only&&hover&&mouse_click?(
    set_ui_slider(23,lufs);set_ui_slider(24,rms);set_ui_slider(25,maxtrm);
    set_ui_slider(29,clamp((lufs+rms)*0.5,-29,-9));
    set_ui_slider(27,speed);set_ui_slider(26,mkp);
    set_ui_slider(22,mode);
    out_link_on=0;
    // Non resettare la cattura: in LOCK si ricalcola solo il trim per il nuovo preset.
    refresh_out_cal_trim();
    out_preset_sel=pidx;
  );
  sel?gfx_set(0.14,0.38,0.80,1):gfx_set(0.10,0.14,0.22,1);gfx_rect(x,y,w,h);
  sel?(gfx_set(0.32,0.64,0.98,1);gfx_rect(x,y,w,1);gfx_rect(x,y+h-1,w,1);gfx_rect(x,y,1,h);gfx_rect(x+w-1,y,1,h););
  sel?gfx_set(1,1,1,1):gfx_set(0.72,0.84,0.98,0.88);
  gfx_setfont(1,"Arial",10,'b');gfx_measurestr(label,_tw,_th);
  gfx_x=x+floor((w-_tw)*0.5);gfx_y=y+floor((h-_th)*0.5);gfx_drawstr(label);
);

function reset_output_defaults_gfx()
(
  set_ui_slider(22,0); set_ui_slider(23,-16); set_ui_slider(24,-18); set_ui_slider(29,-17);
  set_ui_slider(25,6); set_ui_slider(27,1.2); set_ui_slider(26,0);
  set_ui_slider(28,0); set_ui_slider(30,1); set_ui_slider(31,30); set_ui_slider(46,0);
  out_preset_sel=0;
  out_link_on=0;
  out_link_anchor_in=0;
  out_link_anchor_mkp=0;
  reset_out_cal();
  dsp_needs_update=1;
);


floor(gfx_view+0.5)==1?(
  PX=PX0;

  gfx_set(0.11,0.10,0.09,1);gfx_rect(0,0,gfx_w,HDR_H);
  gfx_set(0.16,0.50,0.92,1);gfx_rect(0,0,gfx_w,3);
  gfx_set(0.18,0.20,0.24,1);gfx_rect(0,HDR_H-1,gfx_w,1);
  gfx_setfont(1,"Arial",16,'b');gfx_set(0.90,0.92,0.96,1);
  gfx_x=PX;gfx_y=11;gfx_drawstr("ZP Master Pro");
  gfx_setfont(1,"Arial",10);gfx_set(0.38,0.50,0.72,1);
gfx_x=PX;gfx_y=36;gfx_drawstr("Master Processor | v2.45 Circular Threshold Meters - di Paolo Balestri");

  // View tabs header
  _bx2=PX+PW-63;_byt=12;
  gfx_set(0.14,0.14,0.18,1);gfx_rect(_bx2,_byt,29,20);
  gfx_set(0.80,0.84,0.92,1);gfx_setfont(1,"Arial",10);
  gfx_measurestr("GUI",_tw,_th);gfx_x=_bx2+floor((29-_tw)*0.5);gfx_y=_byt+floor((20-_th)*0.5);gfx_drawstr("GUI");
  hit(_bx2,_byt,29,20)&&mouse_click?set_ui_slider(34,0);
  gfx_set(0.16,0.44,0.90,1);gfx_rect(_bx2+31,_byt,32,20);
  gfx_set(1,1,1,1);gfx_measurestr("JSFX",_tw,_th);gfx_x=_bx2+31+floor((32-_tw)*0.5);gfx_y=_byt+floor((20-_th)*0.5);gfx_drawstr("JSFX");
  hit(_bx2+31,_byt,32,20)&&mouse_click?set_ui_slider(34,1);

  // Parameter table — two columns
  _cx1=PX+8;_cx2=PX+8+floor(gfx_w*0.5);_rh=20;_voff=182;
  _y=HDR_H+8;
  gfx_setfont(1,"Arial",10,'b');gfx_set(0.36,0.60,0.92,1);
  gfx_x=_cx1;gfx_y=_y;gfx_drawstr("PARAMETRO");
  gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr("VALORE");
  gfx_x=_cx2;gfx_y=_y;gfx_drawstr("PARAMETRO");
  gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr("VALORE");
  _y+=_rh-2;gfx_set(0.20,0.28,0.40,0.70);gfx_rect(PX,_y,PW,1);_y+=4;

  gfx_setfont(1,"Arial",9);

  // ── Engine section header (col 1)
  gfx_setfont(1,"Arial",9,'b');gfx_set(0.26,0.72,0.36,0.90);gfx_x=_cx1;gfx_y=_y;gfx_drawstr("ENGINE");
  // Meter section header (col 2): misura IN e OUT.
  gfx_set(0.20,0.54,0.92,0.90);gfx_x=_cx2;gfx_y=_y;gfx_drawstr("METER");
  _y+=_rh;gfx_setfont(1,"Arial",9);

  // Row 1
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx1;gfx_y=_y;gfx_drawstr("Tape Drive");
  sprintf(#_jv,"%.2f",slider(1));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx2;gfx_y=_y;gfx_drawstr("Auto Mode");
  _am=floor(slider(22)+0.5);sprintf(#_jv,"%s",_am==0?"Off":_am==1?"LUFS":_am==2?"RMS":"L+R");gfx_set(0.92,0.94,0.96,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  _y+=_rh;

  // Row 2
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx1;gfx_y=_y;gfx_drawstr("Ceiling [dBFS]");
  sprintf(#_jv,"%.2f",slider(2));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx2;gfx_y=_y;gfx_drawstr("Target LUFS");
  sprintf(#_jv,"%.1f",slider(23));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  _y+=_rh;

  // Row 3
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx1;gfx_y=_y;gfx_drawstr("Release [ms]");
  sprintf(#_jv,"%.1f",slider(3));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx2;gfx_y=_y;gfx_drawstr("Target RMS");
  sprintf(#_jv,"%.1f",slider(24));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  _y+=_rh;

  // Row 4
