    tape_dL[tape_gcount]=inputSampleL;
    count=tape_gcount; offset=tape_flut_depth+(tape_flut_depth*sin(tape_sweepL));
    tape_sweepL+=tape_nextmaxL*tape_flut_frequency;
    tape_sweepL>$pi*2?(
      tape_sweepL-=$pi*2;
      flutA=0.24+(tape_fpdL/tape_UINT32_MAX*0.74); tape_fpdL=rand(tape_UINT32_MAX);
      flutB=0.24+(tape_fpdL/tape_UINT32_MAX*0.74);
      abs(flutA-sin(tape_sweepR+tape_nextmaxR))<abs(flutB-sin(tape_sweepR+tape_nextmaxR))?tape_nextmaxL=flutA:tape_nextmaxL=flutB;
    );
    count+=floor(offset);
    inputSampleL=tape_dL[count-(count>999?1000:0)]*(1-(offset-floor(offset)));
    inputSampleL+=tape_dL[count+1-(count+1>999?1000:0)]*(offset-floor(offset));
    tape_dR[tape_gcount]=inputSampleR;
    count=tape_gcount; offset=tape_flut_depth+(tape_flut_depth*sin(tape_sweepR));
    tape_sweepR+=tape_nextmaxR*tape_flut_frequency;
    tape_sweepR>$pi*2?(
      tape_sweepR-=$pi*2;
      flutA=0.24+(tape_fpdR/tape_UINT32_MAX*0.74); tape_fpdR=rand(tape_UINT32_MAX);
      flutB=0.24+(tape_fpdR/tape_UINT32_MAX*0.74);
