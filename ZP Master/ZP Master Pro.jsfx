draw_meter_db_axis(ix+34,_in_meter_y,_in_meter_h);
ui_in_db>-60?sprintf(#_inv,"%.1f",ui_in_db):strcpy(#_inv,"--");
gfx_setfont(1,"Arial",10,'b');gfx_set(0.90,0.86,0.98,0.95);
gfx_measurestr(#_inv,_tw,_th);gfx_x=ix+floor((in_w-_tw)*0.5);gfx_y=bx_y+24;gfx_drawstr(#_inv);

// AUTO TRIM indicator
aw>44?(
  gfx_set(0.09,0.08,0.07,1);gfx_rect(ax,bx_y,aw,bx_h);
  gfx_set(0.18,0.50,0.90,0.20);gfx_rect(ax,bx_y,aw,1);
  gfx_setfont(1,"Arial",10,'b');auto_apply?gfx_set(0.58,0.72,0.94,0.98):gfx_set(0.46,0.62,0.54,0.95);gfx_x=ax+6;gfx_y=bx_y+6;
  auto_apply?gfx_drawstr("AUTO DB"):gfx_drawstr("TARGET");
  _td=ui_out_trim_db;_tn=clamp(_td/max(0.1,out_trim_max),-1,1);
  _tm=ax+floor(aw*0.5);_ty=bx_y+46;
  gfx_set(0.12,0.14,0.17,1);gfx_rect(ax+7,_ty,aw-14,13);
  gfx_set(0.34,0.38,0.44,1);gfx_rect(_tm,_ty-2,1,17);
  _tf=floor(abs(_tn)*(aw*0.5-9));
  _td>=0?gfx_set(0.20,0.72,0.34,0.90):gfx_set(0.90,0.32,0.26,0.90);
  _td>=0?gfx_rect(_tm,_ty+3,_tf,7):gfx_rect(_tm-_tf,_ty+3,_tf,7);
  gfx_setfont(1,"Arial",15,'b');
  _td>=0?gfx_set(0.58,0.96,0.66,1):gfx_set(1.0,0.58,0.50,1);
  sprintf(#_ot,"%+.1f",_td);gfx_measurestr(#_ot,_tw,_th);gfx_x=ax+floor((aw-_tw)*0.5);gfx_y=bx_y+23;gfx_drawstr(#_ot);
  gfx_setfont(1,"Arial",10,'b');gfx_set(0.78,0.86,0.90,1);
  gfx_x=ax+6;gfx_y=bx_y+71;gfx_drawstr("NO A");
  sprintf(#_op,"%.1f",ui_out_pre_auto_dbfs);gfx_measurestr(#_op,_tw,_th);gfx_x=ax+aw-_tw-6;gfx_y=bx_y+71;gfx_drawstr(#_op);
  gfx_x=ax+6;gfx_y=bx_y+94;gfx_drawstr("AUTO");
  sprintf(#_oa,"%.1f",ui_out_peak_dbfs);gfx_measurestr(#_oa,_tw,_th);gfx_x=ax+aw-_tw-6;gfx_y=bx_y+94;gfx_drawstr(#_oa);
  gfx_setfont(1,"Arial",9);gfx_set(0.40,0.48,0.54,0.80);gfx_x=ax+6;gfx_y=bx_y+116;gfx_drawstr("dBTP hold");

  // GLUE tachometer (psycho-visual guardrail)
  _lra_n=clamp((6.0-ui_lra)/6.0,0,1);
  _gr_n=clamp((ui_comp_gr+ui_lim_gr)/14.0,0,1);
  _tr_n=clamp(abs(ui_out_trim_db)/max(0.1,out_trim_max),0,1);
  _glue=clamp(_lra_n*0.45+_gr_n*0.30+_tr_n*0.25,0,1);
  // Posizionato più in alto per lasciare spazio a LOCK box
  _tx=ax+6;_ty=bx_y+115;_tw=max(20,aw-12);_th=9;
  hit(_tx,_ty,_tw,_th+24)?ui_set_hover(9062);
  gfx_set(0.07,0.07,0.08,1);gfx_rect(_tx,_ty,_tw,_th);
  _gw=floor(_tw*0.60);_yw=floor(_tw*0.25);_rw=_tw-_gw-_yw;
  gfx_set(0.18,0.58,0.26,0.50);gfx_rect(_tx,_ty,_gw,_th);
  gfx_set(0.86,0.66,0.12,0.50);gfx_rect(_tx+_gw,_ty,_yw,_th);
  gfx_set(0.90,0.26,0.22,0.55);gfx_rect(_tx+_gw+_yw,_ty,_rw,_th);
  _px=_tx+floor(_glue*(_tw-1));
  gfx_set(0.95,0.95,0.98,0.95);gfx_rect(_px,_ty-2,1,_th+4);
  gfx_setfont(1,"Arial",9,'b');
  _glue<0.60?(gfx_set(0.52,0.88,0.58,0.95);strcpy(#_st,"LOW")):_glue<0.85?(gfx_set(0.98,0.84,0.32,0.95);strcpy(#_st,"MID")):(gfx_set(1.0,0.50,0.42,0.95);strcpy(#_st,"HIGH"));
  sprintf(#_dn,"GLUE %s",#_st);gfx_x=_tx;gfx_y=_ty+12;gfx_drawstr(#_dn);
);

// LOCK box (Smart Cap) - angolo inferiore sinistro, sotto AUTO dB
out_cal_state_i=(auto_apply==0||auto_tm==0)?0:clamp(floor(out_cal_state+0.5),0,2);
// Coordinate: sotto AUTO dB, addossato a MEASURE dimezzata
_scap_x=ax;
_scap_y=bx_y+floor(bx_h*0.55);
_scap_w=aw;
_scap_h=bx_h-floor(bx_h*0.55)-5;
out_cal_state_i==0?(
  // OFF - Capture mode
  gfx_set(0.08,0.10,0.12,1);gfx_rect(_scap_x,_scap_y,_scap_w,_scap_h);
  gfx_set(0.18,0.50,0.90,0.30);gfx_rect(_scap_x,_scap_y,_scap_w,1);gfx_rect(_scap_x,_scap_y+_scap_h-1,_scap_w,1);
  // Titolo
  gfx_setfont(1,"Arial",9,'b');gfx_set(0.50,0.66,0.88,0.95);gfx_x=_scap_x+6;gfx_y=_scap_y+4;
  (auto_apply==0||auto_tm==0)?gfx_drawstr("MANUAL"):gfx_drawstr("CAPTURE");
  (auto_apply==0||auto_tm==0)?(
    gfx_setfont(1,"Arial",16,'b');gfx_set(0.72,0.78,0.84,0.95);
    auto_tm>0?strcpy(#_capoff,"TARGET"):strcpy(#_capoff,"AUTO OFF");
    gfx_measurestr(#_capoff,_tw,_th);gfx_x=_scap_x+floor((_scap_w-_tw)*0.5);gfx_y=_scap_y+31;gfx_drawstr(#_capoff);
  ):(
    ui_enable=1;mod_r=0.20;mod_g=0.54;mod_b=0.92;
    ui_knob(31,_scap_x+38,_scap_y+55,12,20,90,30,"SEC",9016);
    // Valore
    gfx_setfont(1,"Arial",18,'b');gfx_set(0.58,0.96,0.66,1);
    sprintf(#_scap_val,"%+.1f",0.0);gfx_measurestr(#_scap_val,_tw,_th);
    gfx_x=_scap_x+floor(_scap_w*0.45);gfx_y=_scap_y+28;gfx_drawstr(#_scap_val);
    // Pulsante CAP
    _cap_btn_w=46;_cap_btn_h=18;
    _cap_btn_x=_scap_x+_scap_w-_cap_btn_w-6;
    _cap_btn_y=_scap_y+floor(_scap_h*0.5)-floor(_cap_btn_h*0.5);
    hit(_cap_btn_x,_cap_btn_y,_cap_btn_w,_cap_btn_h)?gfx_set(0.22,0.52,0.92,1):gfx_set(0.16,0.36,0.72,1);
    gfx_rect(_cap_btn_x,_cap_btn_y,_cap_btn_w,_cap_btn_h);
    gfx_setfont(1,"Arial",9,'b');gfx_set(1,1,1,0.95);
    gfx_measurestr("CAP",_tw,_th);gfx_x=_cap_btn_x+floor((_cap_btn_w-_tw)*0.5);gfx_y=_cap_btn_y+floor((_cap_btn_h-_th)*0.5);gfx_drawstr("CAP");
    hit(_cap_btn_x,_cap_btn_y,_cap_btn_w,_cap_btn_h)?(ui_set_hover(9050);mouse_click?prime_out_cal(););
  );
):out_cal_state_i==1?(
  // CAPTURING
  gfx_set(0.12,0.10,0.06,1);gfx_rect(_scap_x,_scap_y,_scap_w,_scap_h);
  gfx_set(0.92,0.76,0.28,0.50);gfx_rect(_scap_x,_scap_y,_scap_w,1);gfx_rect(_scap_x,_scap_y+_scap_h-1,_scap_w,1);
  gfx_setfont(1,"Arial",9,'b');gfx_set(0.92,0.76,0.28,0.95);gfx_x=_scap_x+6;gfx_y=_scap_y+4;gfx_drawstr("CAPTURING...");
  ui_enable=1;mod_r=0.92;mod_g=0.76;mod_b=0.28;
  ui_knob(31,_scap_x+38,_scap_y+55,12,20,90,30,"SEC",9016);
  gfx_setfont(1,"Arial",16,'b');gfx_set(0.92,0.76,0.28,1);
  sprintf(#_scap_val,"%+.1f",out_cal_lufs_avg);gfx_measurestr(#_scap_val,_tw,_th);
  gfx_x=_scap_x+floor(_scap_w*0.45);gfx_y=_scap_y+28;gfx_drawstr(#_scap_val);
  // Progress bar
  _prog_w=floor((_scap_w-12)*out_cal_progress*0.01);
  gfx_set(0.10,0.14,0.20,1);gfx_rect(_scap_x+6,_scap_y+_scap_h-14,_scap_w-12,6);
  gfx_set(0.92,0.76,0.28,1);gfx_rect(_scap_x+6,_scap_y+_scap_h-14,_prog_w,6);
):(
  // LOCK
  gfx_set(0.06,0.14,0.10,1);gfx_rect(_scap_x,_scap_y,_scap_w,_scap_h);
  gfx_set(0.28,0.82,0.48,0.50);gfx_rect(_scap_x,_scap_y,_scap_w,1);gfx_rect(_scap_x,_scap_y+_scap_h-1,_scap_w,1);
  gfx_setfont(1,"Arial",9,'b');gfx_set(0.34,0.90,0.48,0.95);gfx_x=_scap_x+6;gfx_y=_scap_y+4;gfx_drawstr("LOCK");
  ui_enable=1;mod_r=0.28;mod_g=0.82;mod_b=0.48;
  ui_knob(31,_scap_x+38,_scap_y+55,12,20,90,30,"SEC",9016);
  gfx_setfont(1,"Arial",18,'b');out_cal_trim>=0?gfx_set(0.58,0.96,0.66,1):gfx_set(1.0,0.58,0.50,1);
  sprintf(#_scap_val,"%+.1f",out_cal_trim);gfx_measurestr(#_scap_val,_tw,_th);
  gfx_x=_scap_x+floor(_scap_w*0.45);gfx_y=_scap_y+28;gfx_drawstr(#_scap_val);
  // Pulsante NEW
