file_var(0,nav_last_comp);file_var(0,nav_last_1175);file_var(0,nav_last_la2);file_var(0,nav_last_major);file_var(0,nav_last_lim);
file_var(0,nav_last_density);file_var(0,nav_last_flow_bus);file_var(0,nav_last_master_work);file_var(0,nav_last_final_density);file_var(0,nav_last_bright);file_var(0,nav_last_crest);file_var(0,nav_last_vog);file_var(0,nav_last_brown);
file_var(0,nav_last_ana_drive);file_var(0,nav_last_ana_gain);file_var(0,nav_last_ana_mix);
file_var(0,nav_last_sp_harm);file_var(0,nav_last_sp_body);file_var(0,nav_last_sp_presence);file_var(0,nav_last_sp_bright);file_var(0,nav_last_sp_output);
