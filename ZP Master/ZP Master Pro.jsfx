  tape_iirDecL=tape_iirDecL*(1-tape_iir_dec_freq)+inputSampleL*tape_iir_dec_freq;
  highPart=((inputSampleL-tape_iirDecL)*2.628)+tape_avgDecL; tape_avgDecL=(inputSampleL-tape_iirDecL)*1.372;
  highPart=clamp(highPart,-1,1); dubly=abs(highPart);
  dubly>0?(adjust=log(1+255*dubly)/2.40823996531; adjust>0?dubly/=adjust; tape_compDecL=tape_compDecL*(1-tape_iir_dec_freq)+dubly*tape_iir_dec_freq; inputSampleL+=highPart*tape_compDecL*tape_outly_amt;);
  tape_iirDecR=tape_iirDecR*(1-tape_iir_dec_freq)+inputSampleR*tape_iir_dec_freq;
  highPart=((inputSampleR-tape_iirDecR)*2.628)+tape_avgDecR; tape_avgDecR=(inputSampleR-tape_iirDecR)*1.372;
  highPart=clamp(highPart,-1,1); dubly=abs(highPart);
  dubly>0?(adjust=log(1+255*dubly)/2.40823996531; adjust>0?dubly/=adjust; tape_compDecR=tape_compDecR*(1-tape_iir_dec_freq)+dubly*tape_iir_dec_freq; inputSampleR+=highPart*tape_compDecR*tape_outly_amt;);

