  _hclose&&mouse_click?(auto_help_open=0;);

  gfx_setfont(1,"Arial",17,'b');
  gfx_set(0.78,0.88,0.94,1);gfx_x=_hpx+24;gfx_y=_hpy+82;gfx_drawstr("TARGET non cambia gain: mostra solo la distanza dal riferimento.");
  gfx_setfont(1,"Arial",16);
  gfx_set(0.84,0.86,0.86,1);gfx_x=_hpx+34;gfx_y=_hpy+118;gfx_drawstr("Il nuovo MATCH e' lento: media LUFS/RMS circa 4.5 secondi.");
  gfx_x=_hpx+34;gfx_y=_hpy+150;gfx_drawstr("Cosi' ignora molti transienti e segnala l'energia reale del passaggio.");
  gfx_set(0.98,0.74,0.32,1);gfx_x=_hpx+24;gfx_y=_hpy+194;gfx_drawstr("MATCH negativo: sei sotto target. MATCH positivo: sei sopra target.");
  gfx_set(0.72,0.92,0.82,1);gfx_x=_hpx+24;gfx_y=_hpy+238;gfx_drawstr("AUTO usa lo stesso riferimento, ma applica gain entro MAXTRM.");
  gfx_x=_hpx+24;gfx_y=_hpy+270;gfx_drawstr("Il numero grande a sinistra e' il gain che Auto dB sta applicando.");
  gfx_set(0.72,0.82,0.92,1);gfx_x=_hpx+24;gfx_y=_hpy+314;gfx_drawstr("SPEED regola la velocita' del movimento di gain, non il target.");
  gfx_set(0.88,0.78,0.62,1);gfx_x=_hpx+24;gfx_y=_hpy+358;gfx_drawstr("La visuale puo' sembrare opposta: MATCH descrive l'errore, AUTO mostra la correzione.");
);

// ── Scrollbar indicators (GUI mode) ──────────────────────────────
(_sc_max_y>0||_sc_max_x>0)&&gfx_h>100?(
  // Vertical bar
  _sb_w=8;_sb_x=gfx_w-_sb_w-2;
  _sb_h=gfx_h-TIP_H-HDR_H;
  _sb_h>20&&_sc_max_y>0?(
    gfx_set(0.10,0.09,0.08,0.60);gfx_rect(_sb_x,HDR_H,_sb_w,_sb_h);
    _sb_pct=ui_scroll_y/max(1,_sc_max_y);
    _sb_th=max(22,floor(_sb_h*gfx_h/max(1,content_h)));
    _sb_py=HDR_H+floor(_sb_pct*(_sb_h-_sb_th));
    _sb_over=hit(_sb_x,HDR_H,_sb_w,_sb_h);
    _sb_thumb_over=hit(_sb_x,_sb_py,_sb_w,_sb_th);
    mouse_click&&_sb_thumb_over?(scroll_drag_mode=1;scroll_drag_off=mouse_y-_sb_py;);
    mouse_click&&_sb_over&&!_sb_thumb_over?(
      _page=floor(_sb_th*0.85);
      mouse_y<_sb_py?(ui_scroll_y_tgt-=_page):(ui_scroll_y_tgt+=_page);
    );
    _sb_thumb_over||scroll_drag_mode==1?gfx_set(0.38,0.50,0.72,0.85):gfx_set(0.30,0.40,0.58,0.65);
    gfx_rect(_sb_x,_sb_py,_sb_w,_sb_th);
  );
  // Horizontal bar
  _sh_h=8;_sh_x=0;_sh_y=gfx_h-TIP_H-_sh_h-1;_sh_w=gfx_w-(_sc_max_y>0?12:2);
  _sh_w>20&&_sc_max_x>0?(
    gfx_set(0.10,0.09,0.08,0.60);gfx_rect(_sh_x,_sh_y,_sh_w,_sh_h);
    _sh_pct=ui_scroll_x/max(1,_sc_max_x);
    _sh_tw=max(22,floor(_sh_w*gfx_w/max(1,content_w)));
    _sh_px=_sh_x+floor(_sh_pct*(_sh_w-_sh_tw));
    _sh_over=hit(_sh_x,_sh_y,_sh_w,_sh_h);
    _sh_thumb_over=hit(_sh_px,_sh_y,_sh_tw,_sh_h);
    mouse_click&&_sh_thumb_over?(scroll_drag_mode=2;scroll_drag_off=mouse_x-_sh_px;);
    mouse_click&&_sh_over&&!_sh_thumb_over?(
      _hpage=floor(_sh_tw*0.85);
      mouse_x<_sh_px?(ui_scroll_x_tgt-=_hpage):(ui_scroll_x_tgt+=_hpage);
    );
    _sh_thumb_over||scroll_drag_mode==2?gfx_set(0.38,0.50,0.72,0.85):gfx_set(0.30,0.40,0.58,0.65);
    gfx_rect(_sh_px,_sh_y,_sh_tw,_sh_h);
  );
);

