nav_density_comp=nav_avg_1175+nav_avg_la2+nav_avg_major;
nav_dom_value=-1;nav_second_value=-1;nav_dom_id=0;nav_second_id=0;
nav_rank_contribution(nav_density_brown,4);nav_rank_contribution(nav_density_ana,5);nav_rank_contribution(nav_density_spoken,7);nav_rank_contribution(nav_density_comp,8);
nav_density_dom_id=nav_dom_id;nav_density_second_id=nav_second_id;

// Tolleranze specifiche per profilo. Voiceover/ADR sono intenzionalmente
// piu' severe; Spot/Radio accettano maggiore densita' e trattamento.
zp_target_effective_profile==1 ? (nav_vog_warn=66;nav_spoken_warn=68;nav_rms_ceiling=-15;nav_severe_comp_delta=2.5;nav_comp_sum_factor=1.55;) :
zp_target_effective_profile==2 ? (nav_vog_warn=60;nav_spoken_warn=62;nav_rms_ceiling=-17;nav_severe_comp_delta=1.5;nav_comp_sum_factor=1.45;) :
zp_target_effective_profile==3 ? (nav_vog_warn=68;nav_spoken_warn=70;nav_rms_ceiling=-16;nav_severe_comp_delta=2.0;nav_comp_sum_factor=1.55;) :
zp_target_effective_profile==4 ? (nav_vog_warn=82;nav_spoken_warn=85;nav_rms_ceiling=-12;nav_severe_comp_delta=3.5;nav_comp_sum_factor=1.85;) :
zp_target_effective_profile==5 ? (nav_vog_warn=96;nav_spoken_warn=96;nav_rms_ceiling=-9;nav_severe_comp_delta=5.0;nav_comp_sum_factor=2.15;) :
                                  (nav_vog_warn=94;nav_spoken_warn=94;nav_rms_ceiling=-9;nav_severe_comp_delta=4.5;nav_comp_sum_factor=2.10;);
nav_comp_total=nav_avg_1175+nav_avg_la2+nav_avg_major;
nav_flag_comp=nav_avg_comp>target_comp_max || nav_comp_total>target_comp_max*nav_comp_sum_factor;
nav_flag_lim=nav_avg_lim>target_limiter_warn;
nav_flag_bright=nav_avg_bright>target_brightness+target_brightness_tol;
nav_flag_dark=nav_avg_bright<target_brightness-target_brightness_tol;
nav_flag_spoken=nav_avg_vog>nav_vog_warn || nav_avg_sp_output>nav_spoken_warn || nav_avg_sp_bright>nav_spoken_warn;
nav_flag_density=nav_avg_density>target_density_max;
nav_flag_density_low=nav_avg_density<target_density_min;
nav_flag_crest=nav_avg_crest<target_crest_min || nav_avg_crest>target_crest_max;
nav_flag_rms=nav_avg_rms>nav_rms_ceiling;
nav_severe_comp=nav_avg_comp>target_comp_max+nav_severe_comp_delta || nav_comp_total>target_comp_max*(nav_comp_sum_factor+0.55);
nav_severe_lim=nav_avg_lim>target_limiter_warn+2;
nav_severe_bright=nav_avg_bright>target_brightness+target_brightness_tol+4;
nav_severe_spoken=nav_avg_vog>95 || nav_avg_sp_output>96 || nav_avg_sp_bright>96;
nav_severe_density=nav_avg_density>target_density_max+10;
nav_severe_crest=nav_avg_crest<target_crest_min-4;
nav_severe_rms=nav_avg_rms>nav_rms_ceiling+4;
nav_warning_count=nav_flag_comp+nav_flag_lim+nav_flag_bright+nav_flag_dark+nav_flag_spoken+nav_flag_density+nav_flag_density_low+nav_flag_crest+nav_flag_rms;
nav_severe_count=nav_severe_comp+nav_severe_lim+nav_severe_bright+nav_severe_spoken+nav_severe_density+nav_severe_crest+nav_severe_rms;
nav_extreme_cluster=(nav_flag_comp+nav_flag_bright+nav_flag_spoken+nav_flag_density)>=3;
// LUFS manuale ha priorita' quando il tecnico seleziona esplicitamente LUFS.
nav_profile_lufs=zp_target_effective_profile==1?-16:zp_target_effective_profile==2?-18:zp_target_effective_profile==3?-18:zp_target_effective_profile==4?-16:zp_target_effective_profile==5?-14:-12;
nav_manual_lufs=floor(out_mode+0.5)==1;
nav_target_lufs=nav_manual_lufs?out_target_lufs:nav_profile_lufs;
nav_lufs_available=nav_avg_lufs>-70;
nav_lufs_delta=nav_lufs_available?nav_avg_lufs-nav_target_lufs:0;
nav_target_tolerance=1.05;
nav_flag_level_low=nav_lufs_available && nav_lufs_delta < -nav_target_tolerance;
nav_flag_level_high=nav_lufs_available && nav_lufs_delta > nav_target_tolerance;
nav_target_state=!nav_lufs_available?0:nav_flag_level_low?0:abs(nav_lufs_delta)<=nav_target_tolerance?1:nav_lufs_delta>max(2,nav_target_tolerance*2.5)?3:2;
// Decision support is measurement-led. The profile supplies target ranges,
// but a compression recommendation requires real RMS/crest/master-work evidence.
nav_rms_low=nav_avg_rms<nav_rms_ceiling-4;
nav_rms_hot=nav_avg_rms>nav_rms_ceiling;
nav_crest_tight=nav_avg_crest<target_crest_min;
nav_master_work_high=nav_avg_master_work>35;
nav_measured_overcompressed=nav_crest_tight && (nav_rms_hot||nav_master_work_high||nav_comp_total>target_comp_max);
nav_measured_light=nav_flag_density_low && (nav_rms_low||nav_flag_level_low||nav_avg_crest>target_crest_max);
// Valori leggibili per dominio e rilevamento dei moduli eccessivi.
nav_tone_brown_pct=min(100,max(0,nav_avg_brown/12*100));
nav_tone_ana_pct=min(100,max(0,nav_avg_ana_drive*nav_avg_ana_mix*0.01));
nav_tone_sp_bright_pct=min(100,max(0,nav_avg_sp_bright));
nav_tone_sp_vog_pct=min(100,max(0,nav_avg_vog));
nav_density_ana_pct=nav_tone_ana_pct;
nav_density_brown_pct=min(100,max(0,nav_avg_brown/10*100));
nav_density_spoken_pct=min(100,max(0,nav_avg_sp_output*0.40+nav_avg_vog*0.30+nav_avg_sp_harm*0.30));
nav_1175_too=nav_avg_1175>max(3,target_comp_max*0.75);
nav_la2_too=nav_avg_la2>max(3,target_comp_max*0.75);
nav_major_too=nav_avg_major>max(3,target_comp_max*0.75);
nav_ana_too=nav_avg_ana_drive>70 && nav_avg_ana_mix>60;
nav_brown_too=nav_tone_brown_pct>75 && (nav_flag_bright||nav_flag_dark);
nav_spoken_too=nav_spoken_fresh && (nav_avg_sp_presence>70||nav_avg_sp_bright>70||nav_avg_vog>70||nav_avg_sp_harm>80) && (nav_flag_bright||nav_flag_density);
nav_spoken_result_flag=nav_spoken_fresh && (nav_spoken_too || (nav_flag_spoken && (nav_flag_bright||nav_flag_density)));
nav_has_valid_measure && nav_mode_i==0&&nav_manual_complete ? nav_measure_state=3 :
nav_has_valid_measure && (!(play_state&1) || !nav_source_fresh || !nav_signal_useful) ? nav_measure_state=4 :
nav_has_valid_measure && nav_mode_i>0&&nav_measure_progress<1 ? nav_measure_state=2 :
nav_has_valid_measure ? nav_measure_state=3 :
!(play_state&1) ? (nav_measure_state=nav_useful_time>0?4:0;) :
nav_useful_time<=0 ? nav_measure_state=0 :
nav_useful_time<min(2,nav_required_seconds*0.20) ? nav_measure_state=1 :
nav_measure_progress<1 ? nav_measure_state=2 : nav_measure_state=3;

// Un solo messaggio principale, ordinato per priorita' tecnica.
nav_primary_code=0;
nav_gravity=0;
!nav_has_valid_measure && zp_bus_unified_conn==0 ? (nav_primary_code=1;nav_gravity=2;) :
!nav_has_valid_measure && nav_measure_progress<1 ? (nav_primary_code=2;nav_gravity=1;) :
nav_flag_level_low ? (nav_primary_code=9;nav_gravity=abs(nav_lufs_delta)>3?2:1;) :
nav_flag_level_high ? (nav_primary_code=10;nav_gravity=abs(nav_lufs_delta)>3?2:1;) :
nav_flag_comp ? (nav_primary_code=3;nav_gravity=nav_severe_count>0||nav_warning_count>=3||nav_extreme_cluster?2:1;) :
nav_flag_lim ? (nav_primary_code=4;nav_gravity=nav_severe_count>0||nav_warning_count>=3?2:1;) :
nav_flag_bright||nav_flag_dark||nav_spoken_result_flag ? (nav_primary_code=5;nav_gravity=nav_severe_count>0||nav_warning_count>=3?2:1;) :
nav_flag_density||nav_flag_density_low||nav_flag_crest||nav_flag_rms ? (nav_primary_code=6;nav_gravity=nav_severe_count>0||nav_warning_count>=3?2:1;) :
nav_avg_density>(target_density_min+target_density_max)*0.5 && nav_avg_comp<1.5 && nav_avg_vog<10 ? (nav_primary_code=7;nav_gravity=1;) :
nav_primary_code=8;
last_srate!=srate?(
  compute_params();
  last_srate=srate;
);
meter_play_state=play_state&1;
meter_play_state&&!meter_prev_play_state?(
  rms_env=0.000000001;lufs_i_sum=0;lufs_i_count=0;
  lufs_m_env=0.000000001;lufs_s_env=0.000000001;lufs_i_env=0.000000001;
  target_lufs_env=0.000000001;target_rms_env=0.000000001;
  target_lufs_db=-100;target_rms_db=-100;target_meter_prime=1;
  meter_prime_pending=1;meter_just_primed=0;
  out_fast_remaining=out_fast_samples;
  out_peak_hold_dbfs=-100;out_peak_max_dbfs=-100;out_peak_hold_spl=0;
  out_peak_l_dbfs=-100;out_peak_r_dbfs=-100;ui_out_peak_l_dbfs=-100;ui_out_peak_r_dbfs=-100;
  ms_m_env=0.000000001;ms_s_env=0.000000001;ui_ms_mid_db=-100;ui_ms_side_db=-100;ui_ms_width_db=-100;
  outL_prev=spl0;outR_prev=spl1;
  gm_prevL=spl0;gm_prevR=spl1;gm_lim_prevL=spl0;gm_lim_prevR=spl1;gm_out_prevL=spl0;gm_out_prevR=spl1;
  tone_prime_pending=1;
