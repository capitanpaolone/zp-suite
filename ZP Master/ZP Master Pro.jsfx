ui_opt(22,2,"RMS", tx+7+(bbw+bbg)*3, bby,bbw,bbh,9012);
ui_opt(22,3,"L+R", tx+7+(bbw+bbg)*4, bby,bbw,bbh,9013);
_rstx=tx+7+(bbw+bbg)*5;
hit(_rstx,bby,bbw,bbh)?gfx_set(0.52,0.18,0.18,1):gfx_set(0.26,0.12,0.12,1);gfx_rect(_rstx,bby,bbw,bbh);
gfx_setfont(1,"Arial",10,'b');gfx_set(0.88,0.56,0.56,1);gfx_measurestr("RST",_tw,_th);
gfx_x=_rstx+floor((bbw-_tw)*0.5);gfx_y=bby+floor((bbh-_th)*0.5);gfx_drawstr("RST");
hit(_rstx,bby,bbw,bbh)&&mouse_click?(
  reset_output_defaults_gfx();
);
_tbx=tx+7;_tby=bby+24;_tbw=vx-tx-18;_tbh=11;
hit(_tbx,_tby,_tbw,_tbh+12)?ui_set_hover(9018);
gfx_set(0.065,0.075,0.080,1);gfx_rect(_tbx,_tby,_tbw,_tbh);
_tcx=_tbx+floor(_tbw*0.5);_thalf=floor((_tbw-14)*0.5);
_okdb=0.8;_softdb=1.6;
_okhalf=max(8,floor(_okdb/6*_thalf));
_softhalf=max(_okhalf+4,floor(_softdb/6*_thalf));
gfx_set(0.20,0.10,0.10,0.62);gfx_rect(_tbx+7,_tby+3,_thalf-_softhalf,5);
gfx_set(0.20,0.10,0.10,0.62);gfx_rect(_tcx+_softhalf,_tby+3,_thalf-_softhalf,5);
gfx_set(0.46,0.34,0.10,0.72);gfx_rect(_tcx-_softhalf,_tby+2,_softhalf-_okhalf,7);
gfx_set(0.46,0.34,0.10,0.72);gfx_rect(_tcx+_okhalf,_tby+2,_softhalf-_okhalf,7);
ui_target_valid&&auto_tm>0?(
  _terr=clamp(ui_target_err_db,-6,6);
  _dist=abs(_terr);
  _dist<=_okdb?gfx_set(0.16,0.58,0.28,0.96):gfx_set(0.12,0.42,0.22,0.82);
  gfx_rect(_tcx-_okhalf,_tby+1,_okhalf*2,8);
  gfx_set(0.62,1.00,0.68,_dist<=_okdb?1:0.80);gfx_rect(_tcx-_okhalf,_tby,1,_tbh);gfx_rect(_tcx+_okhalf,_tby,1,_tbh);
  _dist>_okdb?(
    _tf=floor((_dist-_okdb)/(6-_okdb)*(_thalf-_okhalf));
    _tf=min(_thalf-_okhalf,_tf);
    _dist<=_softdb?gfx_set(0.92,0.76,0.24,0.92):gfx_set(0.92,0.30,0.22,0.92);
    _terr>=0?gfx_rect(_tcx+_okhalf,_tby+3,_tf,5):gfx_rect(_tcx-_okhalf-_tf,_tby+3,_tf,5);
  );
  gfx_setfont(1,"Arial",10,'b');
  gfx_set(0.74,0.78,0.70,0.92);
  gfx_measurestr("MATCH",_mlw,_mlh);
  gfx_x=_tcx-floor(_mlw*0.5);gfx_y=_tby+12;gfx_drawstr("MATCH");
  gfx_setfont(1,"Arial",18,'b');
  _dist<=_okdb?gfx_set(0.72,1.00,0.76,1):_dist<=_softdb?gfx_set(1.00,0.88,0.34,1):gfx_set(1.00,0.52,0.42,1);
  sprintf(#_tgt,"%+.1f",ui_target_err_db);
  gfx_measurestr(#_tgt,_tw,_th);gfx_x=_tcx-floor(_tw*0.5);gfx_y=_tby+22;gfx_drawstr(#_tgt);
):(
  gfx_set(0.12,0.42,0.22,0.58);gfx_rect(_tcx-_okhalf,_tby+2,_okhalf*2,7);
  gfx_set(0.50,0.92,0.56,0.62);gfx_rect(_tcx-_okhalf,_tby,1,_tbh);gfx_rect(_tcx+_okhalf,_tby,1,_tbh);
  gfx_setfont(1,"Arial",10,'b');gfx_set(0.44,0.48,0.52,0.78);
  gfx_measurestr("MATCH",_mlw,_mlh);gfx_x=_tcx-floor(_mlw*0.5);gfx_y=_tby+12;gfx_drawstr("MATCH");
  gfx_setfont(1,"Arial",18,'b');gfx_set(0.50,0.56,0.60,0.90);
  gfx_measurestr("--",_tw,_th);gfx_x=_tcx-floor(_tw*0.5);gfx_y=_tby+22;gfx_drawstr("--");
);

// PHASE detector lives under the Auto dB / Target distance meter.
_phx=tx+7;_phy=_tby+48;_phw=_tbw;_phh=20;
hit(_phx,_phy,_phw,_phh)?ui_set_hover(9061);
gfx_set(0.07,0.08,0.08,1);gfx_rect(_phx,_phy,_phw,_phh);
