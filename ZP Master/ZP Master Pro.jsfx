out_link_on = out_link_on>=0.5 ? 1 : 0;
// LINK must resume from the currently visible Gain In/Out values.
// Persisted anchors can otherwise make the first Gain In move jump Gain Out.
out_link_anchor_in = clamp(out_intrim,-12,12);
out_link_anchor_mkp = clamp(out_makeup,-12,12);
dsp_needs_update=1;

@block
// Master Pro presenza, heartbeat e supervisione passiva della catena.
zp_bus_refresh(ZP_BUS_ID);
// Lettura coerente: il publisher committa sequence/heartbeat dopo il payload.
// Se il sequence cambia durante la copia, il frame precedente resta valido.
zp_u_seq0=gmem[12];
zp_u_exp=gmem[101];zp_u_1175=gmem[102];zp_u_la2=gmem[103];zp_u_major=gmem[104];zp_u_brown=gmem[105];zp_u_lim=gmem[106];
