// 2. GLUE MATRIX COMPRESSOR
comp_on>=0.5?(
  mt_sc_hpf_on?(_scL=xL-mt_sc_lpL;mt_sc_lpL+=mt_sc_hpf_c*(xL-mt_sc_lpL);_scR=xR-mt_sc_lpR;mt_sc_lpR+=mt_sc_hpf_c*(xR-mt_sc_lpR);):(_scL=xL;_scR=xR;);
  _isp_det=isp_peak(_scL,_scR,gm_prevL,gm_prevR,gm_isp_mode);
