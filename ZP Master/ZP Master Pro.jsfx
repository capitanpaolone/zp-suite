        stuck<1?inputSampleL=inputSampleL*stuck+(tape_gslew[x]/0.975)*(1-stuck);
        stuck=abs(inputSampleR-(tape_gslew[x+1]/0.975))/tape_under_bias;
        stuck<1?inputSampleR=inputSampleR*stuck+(tape_gslew[x+1]/0.975)*(1-stuck);
      );
      (inputSampleL-tape_gslew[x])>tape_gslew[x+2]?inputSampleL=tape_gslew[x]+tape_gslew[x+2];
      -(inputSampleL-tape_gslew[x])>tape_gslew[x+2]?inputSampleL=tape_gslew[x]-tape_gslew[x+2];
      tape_gslew[x]=inputSampleL*0.975;
