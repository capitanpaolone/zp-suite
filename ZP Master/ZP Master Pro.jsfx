// ============================================================
// ZP Master Pro  v2.45 Circular Threshold Meters
// Paolo Balestri — 2026
//
// Master processor:
//   ENGINE  — Tape Glue → Glue Matrix Compressor → Tone Guard → Lookahead Limiter
//   OUTPUT  — LUFS/LRA/RMS/TP metering + auto-trim + final safety limiter
//
// Tape Glue uses DSP adapted from chmaha "Oxide & Seek Tape Emulation",
// itself based on Airwindows "ToTape9" by Chris Johnson.
// JSFX tape port is GPLv3; original Airwindows DSP is MIT.
//
// Sliders 1-21: ENGINE   Sliders 22-34: OUTPUT/VIEW   Sliders 35-55: PRO
// ============================================================

desc:ZP Master Pro Glue Matrix - Master Processor - Paolo Balestri
tags: mastering master processor tape compressor tone guard limiter lufs rms true peak paolo balestri zio paolo
options:gmem=ZPVoiceoverSharedBus
//autror: Paolo Balestri - Zio Paolo
//variant: v2.45 - live detector rings for compressor threshold and limiter ceiling
//
// Glue Matrix:
//   DEP aumenta la quantita' complessiva di glue.
//   FRG frammenta il lavoro fra macro, micro e crest glue.
//   Texture sceglie il carattere: SM morbido, API punch, SSA compatto.
//   ISP Guard usa picchi interpolati 2x/4x per tenere limiter e safety lontani dal soffitto.
// Contatto: social@paolobalestri.com

// ─── ENGINE ────────────────────────────────────────────────────
slider1:tape_drive=0.5<0,1,0.01>Tape Drive
slider2:lim_ceiling=-1<-9,-0.1,0.1>Ceiling [dB]
slider3:lim_rel=90<5,500,1>Release [ms]
slider4:lim_look=8<0,60,0.1>Lookahead [ms]
slider5:lim_pregain=0<-12,12,0.1>Pre-Gain [dB]
slider6:tape_tilt=0.5<0,1,0.01>Tape Tilt
slider7:comp_thresh=-14<-60,0,0.1>Comp Threshold [dB]
slider8:comp_ratio=2.6<1,20,0.1>Comp Ratio
slider9:comp_sc_hpf=0<0,10000,1>SC HPF [Hz]
slider10:tape_shape=0.5<0.0001,0.9999,0.01>Tape Shape
slider11:tape_flutter=0<0,1,0.01>Flutter
slider12:tape_bump=0.25<0,1,0.01>Head Bump
slider13:tape_on=1<0,1,1{Bypass,On}>Tape Glue
slider14:comp_on=1<0,1,1{Bypass,On}>Compressor
slider15:lim_on=1<0,1,1{Bypass,On}>Limiter
slider16:comp_knee=1<0,1,1{Hard,Soft}>Knee
slider17:comp_detect=1<0,1,1{Peak,RMS}>Detection
slider18:comp_ff=1<0,1,1{Feedback,Feedfwd}>Feed Mode
slider19:comp_automu=1<0,1,1{No,Yes}>Auto Makeup
slider20:tape_bias=0.5<0,1,0.01>Tape Bias
slider21:tape_bump_hz=68.75<25,200,0.01>Head Frequency [Hz]

// ─── OUTPUT ────────────────────────────────────────────────────
slider22:out_mode=0<0,3,1{Off,LUFS,RMS,L+R}>Auto Trim Mode
slider23:out_target_lufs=-16<-30,-9,0.1>Target LUFS
slider24:out_target_rms=-18<-40,-9,0.1>Target RMS
slider25:out_trim_max=6<0,12,0.1>Max Auto Trim [dB]
slider26:out_makeup=0<-12,12,0.1>Gain Out [dB]
slider27:out_speed=1.2<0.1,10,0.1>Trim Speed [s]
slider28:out_intrim=0<-12,12,0.1>Gain In [dB]
slider29:out_target_lr=-17<-29,-9,0.1>Target L+R [dB]
slider30:out_final_lim_on=1<0,1,1{Off,On}>Final Limiter
slider31:out_capture_seconds=30<20,90,1>Capture Time [s]
slider32:out_cal_state=0<0,2,1{Off,Prime,Lock}>Auto dB Cal
slider33:out_cal_trim=0<-12,12,0.1>Calibrated Trim [dB]

// ─── VIEW ──────────────────────────────────────────────────────
slider34:gfx_view=0<0,1,1{GUI,JSFX}>View

// ─── PRO MODULES ───────────────────────────────────────────────
slider35:tone_on=0<0,1,1{Bypass,On}>Tone Guard
slider36:tone_slope=0.0<-3,8,0.1>Tone Slope [dB/oct]
slider37:tone_amount=35<0,100,1>Tone Amount [%]
slider38:tone_attack=250<20,2000,1>Tone Attack [ms]
slider39:tone_release=1800<100,6000,10>Tone Release [ms]
slider40:tape_flutter_speed=0.5<0,1,0.01>Flutter Speed
slider41:tape_output=0.5<0,1,0.01>Tape Output
slider42:tone_freq1=90<40,250,1>Tone Low Point [Hz]
slider43:tone_freq2=425<180,1200,1>Tone Low-Mid Point [Hz]
slider44:tone_freq3=2120<800,15000,1>Tone Mid-High Point [Hz]
slider45:tone_freq4=9000<4000,20000,1>Tone High Point [Hz]
slider46:out_auto_db_on=1<0,1,1{Target,Auto}>Auto dB Apply
slider47:tone_gain1=0<-6,6,0.1>Tone Low Gain [dB]
slider48:tone_gain2=0<-6,6,0.1>Tone Low-Mid Gain [dB]
slider49:tone_gain3=0<-6,6,0.1>Tone Mid-High Gain [dB]
slider50:tone_gain4=0<-6,6,0.1>Tone High Gain [dB]
slider51:glue_depth=50<0,100,1>Glue Matrix Depth [%]
slider52:glue_texture=1<0,2,1{Smooth,API,SSA}>Glue Texture
slider53:isp_guard=2<0,2,1{Off,2x,4x}>ISP Guard
slider54:glue_frag=60<0,100,1>Glue Fragmentation [%]
slider55:glue_on=1<0,1,1{Bypass,On}>Glue Matrix
slider56:target_profile=0<0,6,1{Bus/Auto,VOICEOVER,ADR,ELEARNING,PODCAST,SPOT,RADIO}>[Target] Profile
slider57:target_comp_max=5<0,12,0.1>[Target] Compression max [dB]
slider58:target_density_min=45<0,100,1>[Target] Density min [%]
slider59:target_density_max=65<0,100,1>[Target] Density max [%]
slider60:target_brightness=-11<-30,12,0.5>[Target] Brightness [dB]
slider61:target_brightness_tol=5<1,15,0.5>[Target] Brightness tolerance [dB]
slider62:target_crest_min=7<0,30,0.5>[Target] Crest min [dB]
slider63:target_crest_max=17<0,30,0.5>[Target] Crest max [dB]
slider64:target_limiter_warn=2<0,8,0.1>-[Target] Limiter warning [dB]
slider65:nav_measure_time=20<0,60,1>-Navigator Measure Time [s]
slider66:nav_measure_mode=0<0,2,1{MANUAL,LIVE,AUTO}>-Navigator Measure Mode

@init
// ZP Shared Bus supervisor: diagnostica soltanto, nessun cambio DSP.
ZP_BUS_MAGIC = 905026;
ZP_BUS_VERSION = 220;
ZP_BUS_ID = 40;
// Heartbeat indica soltanto che il plugin e' vivo. Una pausa audio non equivale
// a plugin assente; il timeout tollera stop, silenzi e scheduling del motore.
ZP_BUS_FRESH_SEC = 12;
// Layout visibility. In a new instance the METER is always available.
// Existing projects preserve their view choices; if all panels were hidden,
// METER is restored so the plugin never opens as an empty black window.
ui_layout_schema != 2 ? (
  ui_layout_schema == 0 ? (
    ui_show_engine=1;
    ui_show_meter=1;
    ui_show_nav=1;
    ui_mono_analysis=0;
  ) : (
    ui_show_meter=1;
    ui_mono_analysis=0;
  );
  ui_layout_schema=2;
);
(ui_show_engine<0.5 && ui_show_meter<0.5 && ui_show_nav<0.5) ? ui_show_meter=1;
function zp_bus_boot() (
  gmem[0] != ZP_BUS_MAGIC || gmem[1] < ZP_BUS_VERSION ? (
    gmem[0] = ZP_BUS_MAGIC;
    gmem[1] = ZP_BUS_VERSION;
    gmem[2] = 1;
    gmem[3] = 0;
    gmem[4] = 0;
    gmem[10]=gmem[11]=gmem[12]=gmem[20]=gmem[21]=gmem[22]=0;
    gmem[30]=gmem[31]=gmem[32]=gmem[40]=gmem[41]=gmem[42]=0;
    gmem[50]=gmem[51]=gmem[52]=gmem[60]=gmem[61]=gmem[62]=0;
  );
);
function zp_bus_read() local(now) (
  zp_bus_boot();
  now=time_precise(); zp_bus_now=now;
  zp_bus_profile = max(1, min(6, floor(gmem[2] + 0.5)));
  zp_bus_unified_conn=gmem[10]==905010 ? (now-gmem[11]<=ZP_BUS_FRESH_SEC?2:1) : 0;
  zp_bus_space_conn=gmem[20]==905020 ? (now-gmem[21]<=ZP_BUS_FRESH_SEC?2:1) : 0;
  zp_bus_spoken_conn=gmem[30]==905030 ? (now-gmem[31]<=ZP_BUS_FRESH_SEC?2:1) : 0;
  zp_bus_master_conn=gmem[40]==905040 ? (now-gmem[41]<=ZP_BUS_FRESH_SEC?2:1) : 0;
  zp_bus_voice_conn=gmem[50]==905050 ? (now-gmem[51]<=ZP_BUS_FRESH_SEC?2:1) : 0;
  zp_bus_music_conn=gmem[60]==905060 ? (now-gmem[61]<=ZP_BUS_FRESH_SEC?2:1) : 0;
  zp_bus_unified_ok=zp_bus_unified_conn>0; zp_bus_space_ok=zp_bus_space_conn>0;
  zp_bus_spoken_ok=zp_bus_spoken_conn>0; zp_bus_master_ok=zp_bus_master_conn>0;
  zp_bus_voice_probe_ok=zp_bus_voice_conn>0; zp_bus_music_probe_ok=zp_bus_music_conn>0;
  zp_connection_state = (zp_bus_unified_conn==0 || zp_bus_voice_conn==0) ? 0 : (zp_bus_unified_conn==2 && zp_bus_voice_conn==2 ? 2 : 1);
  gmem[3]=zp_connection_state;
);
function zp_bus_refresh(plugin_id) (
  zp_bus_boot();
  gmem[plugin_id]=905000+plugin_id;
  gmem[plugin_id+1]=time_precise();
  gmem[plugin_id+2]+=1;
  zp_bus_read();
);
// ZP Target Engine: matrice iniziale modificabile. I valori sono solo analitici.
function zp_target_load_defaults(p) (
  p == 1 ? (target_comp_max=5; target_density_min=45; target_density_max=65; target_brightness=-11; target_brightness_tol=5; target_crest_min=7; target_crest_max=17; target_limiter_warn=2;) :
  p == 2 ? (target_comp_max=4; target_density_min=40; target_density_max=60; target_brightness=-12; target_brightness_tol=5; target_crest_min=8; target_crest_max=18; target_limiter_warn=1;) :
  p == 3 ? (target_comp_max=5; target_density_min=45; target_density_max=65; target_brightness=-10; target_brightness_tol=4; target_crest_min=7; target_crest_max=16; target_limiter_warn=1.5;) :
  p == 4 ? (target_comp_max=6; target_density_min=55; target_density_max=75; target_brightness=-9; target_brightness_tol=5; target_crest_min=6; target_crest_max=14; target_limiter_warn=2;) :
  p == 5 ? (target_comp_max=8; target_density_min=70; target_density_max=90; target_brightness=-7; target_brightness_tol=5; target_crest_min=4; target_crest_max=11; target_limiter_warn=4;) :
           (target_comp_max=8; target_density_min=72; target_density_max=92; target_brightness=-6; target_brightness_tol=5; target_crest_min=3; target_crest_max=10; target_limiter_warn=4;);
  target_matrix_profile=p;
);
function zp_raise_finding(code, severity) (
  zp_bus_findings += 1;
  severity > zp_bus_severity || zp_bus_warning == 0 ? (
    zp_bus_warning=code;
    zp_bus_severity=severity;
  );
);
// Navigator Measure Engine: accumulatore osservativo e persistente.
// Non modifica parametri, DSP o stato degli altri plugin.
function nav_reset_measure() (
  nav_useful_time=0; nav_sum_comp=0; nav_sum_1175=0; nav_sum_la2=0; nav_sum_major=0;
  nav_sum_lim=0; nav_sum_density=0; nav_sum_flow_bus=0; nav_sum_master_work=0; nav_sum_final_density=0; nav_sum_bright=0; nav_sum_crest=0; nav_sum_vog=0;
  nav_sum_brown=0; nav_sum_ana_drive=0; nav_sum_ana_gain=0; nav_sum_ana_mix=0;
  nav_sum_sp_harm=0; nav_sum_sp_body=0; nav_sum_sp_presence=0; nav_sum_sp_bright=0; nav_sum_sp_output=0;
  nav_sum_rms=0; nav_sum_lufs=0; nav_sum_lufs_db=0; nav_lufs_time=0; nav_sum_lra=0;
  nav_sum_sq_comp=0; nav_sum_sq_density=0; nav_sum_sq_bright=0; nav_sum_sq_lim=0; nav_sum_sq_lufs=0;
  nav_measure_state=0; nav_measure_progress=0; nav_primary_code=0;
  nav_has_valid_measure=0;
  nav_manual_complete=0;
  nav_last_comp=0;nav_last_1175=0;nav_last_la2=0;nav_last_major=0;nav_last_lim=0;
  nav_last_density=0;nav_last_flow_bus=0;nav_last_master_work=0;nav_last_final_density=0;nav_last_bright=0;nav_last_crest=0;nav_last_vog=0;nav_last_brown=0;
  nav_last_ana_drive=0;nav_last_ana_gain=0;nav_last_ana_mix=0;
  nav_last_sp_harm=0;nav_last_sp_body=0;nav_last_sp_presence=0;nav_last_sp_bright=0;nav_last_sp_output=0;
  nav_last_rms=-100;nav_last_lufs=-100;nav_last_lra=0;nav_last_confidence=0;
);
function nav_reset_window() (
  nav_useful_time=0;nav_sum_comp=0;nav_sum_1175=0;nav_sum_la2=0;nav_sum_major=0;
  nav_sum_lim=0;nav_sum_density=0;nav_sum_flow_bus=0;nav_sum_master_work=0;nav_sum_final_density=0;nav_sum_bright=0;nav_sum_crest=0;nav_sum_vog=0;
  nav_sum_brown=0;nav_sum_ana_drive=0;nav_sum_ana_gain=0;nav_sum_ana_mix=0;
  nav_sum_sp_harm=0;nav_sum_sp_body=0;nav_sum_sp_presence=0;nav_sum_sp_bright=0;nav_sum_sp_output=0;
  nav_sum_rms=0;nav_sum_lufs=0;nav_sum_lufs_db=0;nav_lufs_time=0;nav_sum_lra=0;
  nav_sum_sq_comp=0;nav_sum_sq_density=0;nav_sum_sq_bright=0;nav_sum_sq_lim=0;nav_sum_sq_lufs=0;
  nav_measure_progress=0;
);
function nav_rank_contribution(value, module_id) (
  value>nav_dom_value ? (
    nav_second_value=nav_dom_value; nav_second_id=nav_dom_id;
    nav_dom_value=value; nav_dom_id=module_id;
  ) : value>nav_second_value ? (
    nav_second_value=value; nav_second_id=module_id;
  );
);
zp_bus_refresh(ZP_BUS_ID);

ext_tail_size=-1;
ext_noinit=1;

// ── Math helpers ───────────────────────────────────────────────
function db2gain(x)  ( 10^(x*0.05) );
function gain2db(x)  ( 20*log(max(x,0.000000000001))/log(10) );
function clamp(x,lo,hi) ( x<lo?lo:(x>hi?hi:x) );
function slider_mask(n) ( 2^(n-1) );
function mono_lufs_comp() ( num_ch < 2 ? 3.0 : 0.0 );
function out_lr_lufs_target() ( clamp(out_target_lr + 1, -30, -9) );
function out_lr_rms_target()  ( clamp(out_target_lr - 1, -40, -9) );
function tone_onepole_coef(freq) local(f) ( f=clamp(freq,5,srate*0.45); 1-exp(-2*$pi*f/srate); );
function tone_oct_from_1k(freq) ( log(max(freq,1)/1000)/log(2) );
function out_capture_target_db() local(m,lc)(
  m=clamp(floor(out_mode+0.5),0,3);
  lc=mono_lufs_comp();
  m==1 ? out_target_lufs-lc :
  m==2 ? out_target_rms :
  m==3 ? (((out_lr_lufs_target()-lc)+out_lr_rms_target())*0.5) :
  out_target_lufs-lc;
);

function tanh_fast(x) (
  x>3?0.995:x<-3?-0.995:x*(27+x*x)/(27+9*x*x);
);

// ── K-weighting biquad (BS.1770) ──────────────────────────────
function biquad_set_hp(fc,q)
instance(a0,a1,a2,b1,b2)
local(w0,c,s,alpha,b0n,b1n,b2n,a0n,a1n,a2n)(
  w0=2*$pi*fc/srate;c=cos(w0);s=sin(w0);alpha=s/(2*q);
  b0n=(1+c)*0.5;b1n=-(1+c);b2n=(1+c)*0.5;
  a0n=1+alpha;a1n=-2*c;a2n=1-alpha;
  a0=b0n/a0n;a1=b1n/a0n;a2=b2n/a0n;b1=a1n/a0n;b2=a2n/a0n;
);
function biquad_set_hs(fc,q,dbgain)
instance(a0,a1,a2,b1,b2)
local(A,w0,c,s,alpha,beta,b0n,b1n,b2n,a0n,a1n,a2n)(
  A=10^(dbgain/40);w0=2*$pi*fc/srate;c=cos(w0);s=sin(w0);
  alpha=s/(2*q);beta=2*sqrt(A)*alpha;
  b0n=A*((A+1)+(A-1)*c+beta);b1n=-2*A*((A-1)+(A+1)*c);b2n=A*((A+1)+(A-1)*c-beta);
  a0n=(A+1)-(A-1)*c+beta;a1n=2*((A-1)-(A+1)*c);a2n=(A+1)-(A-1)*c-beta;
  a0=b0n/a0n;a1=b1n/a0n;a2=b2n/a0n;b1=a1n/a0n;b2=a2n/a0n;
);
function biquad_set_peak(fc,q,dbgain)
instance(a0,a1,a2,b1,b2)
local(A,w0,c,s,alpha,b0n,b1n,b2n,a0n,a1n,a2n)(
  A=10^(dbgain/40);w0=2*$pi*clamp(fc,5,srate*0.45)/srate;c=cos(w0);s=sin(w0);
  alpha=s/(2*max(0.05,q));
  b0n=1+alpha*A;b1n=-2*c;b2n=1-alpha*A;
  a0n=1+alpha/A;a1n=-2*c;a2n=1-alpha/A;
  a0=b0n/a0n;a1=b1n/a0n;a2=b2n/a0n;b1=a1n/a0n;b2=a2n/a0n;
);
function biquad_tick(x)
instance(a0,a1,a2,b1,b2,x1,x2,y1,y2)
local(y)(
  y=a0*x+a1*x1+a2*x2-b1*y1-b2*y2;
  x2=x1;x1=x;y2=y1;y1=y;y;
);

// ── Limiter helpers ───────────────────────────────────────────
function lim_att_win(r)  ( 0.5-0.5*cos(r*$pi) );
function lim_rel_win(r)  ( 0.5+0.5*cos(r*$pi) );
function lim_dist(x)     ( lim_dist_B*x/(lim_dist_A*abs(x)+1) );
function lim_scale(pk,lm)( (lm/max(pk,0.000000000001))^(1-lim_sat_w) );
function lim_distc(pk,lm)( (1-(lm/max(pk,0.000000000001))^lim_sat_w)/max(lm,0.000000000001) );
function pk_decay(pk,env) local(v)( v=max(pk,0.000000000001); v>env?v:v+pk_dc*(env-v); );
function isp_peak(curL,curR,prevL,prevR,mode)
local(p,m1L,m1R,m2L,m2R,m3L,m3R)(
  p=max(abs(curL),abs(curR));
  mode>=1 ? (
    m2L=0.5*prevL+0.5*curL; m2R=0.5*prevR+0.5*curR;
    p=max(p,max(abs(m2L),abs(m2R)));
  );
  mode>=2 ? (
    m1L=0.75*prevL+0.25*curL; m1R=0.75*prevR+0.25*curR;
    m3L=0.25*prevL+0.75*curL; m3R=0.25*prevR+0.75*curR;
    p=max(p,max(max(abs(m1L),abs(m1R)),max(abs(m3L),abs(m3R))));
  );
  p;
);

function clear_lim_buf() local(i)(
  i=0;loop(max_look_spl,bufL[i]=0;bufR[i]=0;
  bufPeak[i]=max(db2gain(lim_ceiling),0.000000000001);i+=1;);
  writepos=0;lim_gain=1;
  lim_rel_start=max(db2gain(lim_ceiling),0.000000000001);
  lim_rel_idx=srate;
);

function tape_clear_delay() local(i)(
  i=0;loop(1002,tape_dL[i]=0;tape_dR[i]=0;i+=1;);
  tape_gcount=999;
);

// ── Compute all DSP params from sliders ───────────────────────
function compute_params()(
  // Tape Glue (Oxide & Seek / Airwindows ToTape9 family)
  tape_overallscale=srate/44100;
  tape_spacing=floor(tape_overallscale);
  tape_spacing<1?tape_spacing=1;
  tape_spacing>16?tape_spacing=16;
  tape_slewsing=floor(tape_overallscale*2);
  tape_slewsing<2?tape_slewsing=2;
  tape_slewsing>32?tape_slewsing=32;
  tape_input_gain=(tape_drive*2)^2;
  tape_dubly_amt=tape_tilt*2;
  tape_outly_amt=(1-tape_tilt)*-2;
  tape_outly_amt<-1?tape_outly_amt=-1;
  tape_iir_enc_freq=(1-tape_shape)/tape_overallscale;
  tape_iir_dec_freq=tape_shape/tape_overallscale;
  tape_flut_depth=(tape_flutter^6)*tape_overallscale*50;
  tape_flut_depth>498?tape_flut_depth=498;
  tape_flut_frequency=(0.02*(tape_flutter_speed^3))/tape_overallscale;
  tape_bias_amt=(tape_bias*2)-1;
  tape_under_bias=((tape_bias_amt^4)*0.25)/tape_overallscale;
  tape_over_bias=((1-tape_bias_amt)^3)/tape_overallscale;
  tape_bias_amt>0?tape_under_bias=0;
  tape_bias_amt<0?tape_over_bias=1/tape_overallscale;
  tape_gslew[26]=tape_over_bias;
  _ob=tape_over_bias*1.618033988749894848204586;
  tape_gslew[23]=_ob; _ob*=1.618033988749894848204586;
  tape_gslew[20]=_ob; _ob*=1.618033988749894848204586;
  tape_gslew[17]=_ob; _ob*=1.618033988749894848204586;
  tape_gslew[14]=_ob; _ob*=1.618033988749894848204586;
  tape_gslew[11]=_ob; _ob*=1.618033988749894848204586;
  tape_gslew[8]=_ob;  _ob*=1.618033988749894848204586;
  tape_gslew[5]=_ob;  _ob*=1.618033988749894848204586;
  tape_gslew[2]=_ob;
  tape_head_drive=(tape_bump*0.1)/tape_overallscale;
  tape_head_mix=tape_bump*0.5;
  tape_h_freq=(((sqrt((tape_bump_hz-25)/175)^2)*175)+25)/srate;
  tape_h_freq_b=tape_h_freq*0.9375;
  tape_h_res=0.618033988749894848204586;
  _K=tan($pi*tape_h_freq);
  _norm=1/(1+_K/tape_h_res+_K*_K);
  tape_hA_a0=_K/tape_h_res*_norm;
  tape_hA_a1=0;
  tape_hA_a2=-tape_hA_a0;
  tape_hA_b1=2*(_K*_K-1)*_norm;
  tape_hA_b2=(1-_K/tape_h_res+_K*_K)*_norm;
  _K=tan($pi*tape_h_freq_b);
  _norm=1/(1+_K/tape_h_res+_K*_K);
  tape_hB_a0=_K/tape_h_res*_norm;
  tape_hB_a1=0;
  tape_hB_a2=-tape_hB_a0;
  tape_hB_b1=2*(_K*_K-1)*_norm;
  tape_hB_b2=(1-_K/tape_h_res+_K*_K)*_norm;
  tape_output_gain=tape_output*2;

  // Compressor
  mt_thr_g    =db2gain(comp_thresh);
  mt_ratio_eff=max(1,comp_ratio);
  mt_automu_db=comp_automu?((abs(comp_thresh)-(abs(comp_thresh)/max(1,mt_ratio_eff-1)))*0.28):0;
  mt_makeup_g =db2gain(mt_automu_db);
  mt_rms_c    =comp_detect?exp(-1000/(10*srate)):exp(-1000/(0.25*srate));
  mt_rel_lin  =18/srate;
  mt_sc_hpf_on=comp_sc_hpf>=20?1:0;
  mt_sc_hpf_c =exp(-2*$pi*min(max(comp_sc_hpf,20),srate*0.45)/srate);
  gm_depth     =clamp(glue_depth*0.01,0,1);
  gm_frag      =clamp(glue_frag*0.01,0,1);
  gm_texture   =clamp(floor(glue_texture+0.5),0,2);
  gm_glue_on   =glue_on>=0.5?1:0;
  gm_isp_mode  =clamp(floor(isp_guard+0.5),0,2);
  gm_depth_eff =gm_depth*gm_glue_on;
  gm_frag_eff  =gm_frag*gm_glue_on;
  gm_texture_eff=gm_glue_on?gm_texture:0;
  gm_macro_att =gm_texture_eff==1?0.010:(gm_texture_eff==2?0.018:0.030);
  gm_macro_rel =gm_texture_eff==1?0.140:(gm_texture_eff==2?0.220:0.320);
  gm_micro_att =gm_texture_eff==1?0.00045:(gm_texture_eff==2?0.00075:0.00120);
  gm_micro_rel =gm_texture_eff==1?0.040:(gm_texture_eff==2?0.075:0.110);
  gm_crest_att =gm_texture_eff==1?0.00120:(gm_texture_eff==2?0.00180:0.00300);
  gm_crest_rel =gm_texture_eff==1?0.075:(gm_texture_eff==2?0.110:0.160);
  gm_macro_att_c=exp(-1/(max(0.00001,gm_macro_att)*srate));
  gm_macro_rel_c=exp(-1/(max(0.00001,gm_macro_rel)*srate));
  gm_micro_att_c=exp(-1/(max(0.00001,gm_micro_att)*srate));
  gm_micro_rel_c=exp(-1/(max(0.00001,gm_micro_rel)*srate));
  gm_crest_att_c=exp(-1/(max(0.00001,gm_crest_att)*srate));
  gm_crest_rel_c=exp(-1/(max(0.00001,gm_crest_rel)*srate));
  gm_macro_cap=1.5+gm_depth_eff*3.0;
  gm_micro_cap=(0.35+gm_frag_eff*1.25)*gm_depth_eff;
  gm_crest_cap=(0.45+gm_frag_eff*1.55)*gm_depth_eff;
  gm_micro_thr_g=mt_thr_g*db2gain(3.0-4.0*gm_frag_eff);
  gm_crest_db=5.5-2.5*gm_frag_eff;

  // Limiter
  lim_ceiling_g=db2gain(lim_ceiling);
  lim_look_spl =floor(max(1,min(max_look_spl-2,ceil(lim_look*srate*0.001))));
  pdc_delay=lim_on?max(0,lim_look_spl-1):0;
  pdc_bot_ch=0;pdc_top_ch=2;
  lim_rel_spl=ceil(max(1,lim_rel)*srate*0.001);
  lim_pre_g  =db2gain(lim_pregain);
  lim_sat_w  =0;
  (lim_look_spl!=last_lim_look||lim_on!=last_lim_on)?(
    clear_lim_buf();
    last_lim_look=lim_look_spl;last_lim_on=lim_on;
  );

  // Gain In
  intrim_g=db2gain(out_intrim);

  // Output
  out_man_g  =db2gain(out_makeup);
  out_trim_c =exp(-1/(max(0.1,out_speed)*srate));
  out_trim_cap=out_trim_max;
  out_fast_tau=max(0.008,min(0.060,out_speed*0.035));
  out_fast_c=exp(-1/(out_fast_tau*srate));
  out_fast_samples=floor(max(1.50,min(6.00,out_speed*2.00))*srate);
  out_cal_smooth_c=exp(-1/(max(0.2,out_speed)*srate));
  out_cal_target_spl=floor(max(1, srate * clamp(out_capture_seconds,20,90)));
  out_final_ceil_g=out_final_lim_on>=0.5?(lim_on>=0.5?lim_ceiling_g:db2gain(-1)):1;
  out_final_rel_c=exp(-1/(0.120*srate));

  // Tone Guard: DIN OFF = static slope/EQ, DIN ON = dynamic spectral guard.
  tone_dyn_on=tone_points_dyn>=0.5?1:0;
  tone_eq_dyn_on=tone_eq_dyn>=0.5?1:0;
  tone_amount_w=tone_dyn_on ? tone_amount*0.01 : 0;
  tone_eq_amount_w=tone_eq_dyn_on ? tone_amount*0.01 : 0;
  tone_point_amount_w=1;
  tone_f1c=clamp(tone_freq1,40,250);
  tone_f2c=clamp(tone_freq2,max(180,tone_f1c*1.08),1200);
  tone_f3c=clamp(tone_freq3,max(800,tone_f2c*1.08),15000);
  tone_f4c=clamp(tone_freq4,max(4000,tone_f3c*1.08),20000);
  tone_c1=tone_onepole_coef(sqrt(tone_f1c*tone_f2c));
  tone_c2=tone_onepole_coef(sqrt(tone_f2c*tone_f3c));
  tone_c3=tone_onepole_coef(sqrt(tone_f3c*tone_f4c));
  tone_att_c=exp(-1/(max(1,tone_attack)*0.001*srate));
  tone_rel_c=exp(-1/(max(1,tone_release)*0.001*srate));
  tone_env_att=exp(-1/(0.120*srate));
  tone_env_rel=exp(-1/(1.400*srate));
  tone_graph_att_c=exp(-1/(max(0.02,tone_attack*0.001)*srate));
  tone_graph_rel_c=exp(-1/(max(0.05,tone_release*0.001)*srate));
  tone_t1=-tone_slope*tone_oct_from_1k(tone_f1c);
  tone_t2=-tone_slope*tone_oct_from_1k(tone_f2c);
  tone_t3=-tone_slope*tone_oct_from_1k(tone_f3c);
  tone_t4=-tone_slope*tone_oct_from_1k(tone_f4c);
  tone_focus_q=0.85;
  tone_static_slope_w=tone_dyn_on ? 0 : 1;
  tone_gain1_eff=clamp(tone_gain1*tone_point_amount_w+tone_t1*tone_static_slope_w,-6,6);
  tone_gain2_eff=clamp(tone_gain2*tone_point_amount_w+tone_t2*tone_static_slope_w,-6,6);
  tone_gain3_eff=clamp(tone_gain3*tone_point_amount_w+tone_t3*tone_static_slope_w,-6,6);
  tone_gain4_eff=clamp(tone_gain4*tone_point_amount_w+tone_t4*tone_static_slope_w,-6,6);
  tone_pk1L.biquad_set_peak(tone_f1c,tone_focus_q,tone_gain1_eff);
  tone_pk1R.biquad_set_peak(tone_f1c,tone_focus_q,tone_gain1_eff);
  tone_pk2L.biquad_set_peak(tone_f2c,tone_focus_q,tone_gain2_eff);
  tone_pk2R.biquad_set_peak(tone_f2c,tone_focus_q,tone_gain2_eff);
  tone_pk3L.biquad_set_peak(tone_f3c,tone_focus_q,tone_gain3_eff);
  tone_pk3R.biquad_set_peak(tone_f3c,tone_focus_q,tone_gain3_eff);
  tone_pk4L.biquad_set_peak(tone_f4c,tone_focus_q,tone_gain4_eff);
  tone_pk4R.biquad_set_peak(tone_f4c,tone_focus_q,tone_gain4_eff);

  // Meter coefficients
  pk_dc          =exp(-1/(0.18*srate));
  meter_rms_c    =exp(-1/(0.300*srate));
  phase_c        =exp(-1/(0.220*srate));
  meter_lufs_m_c =exp(-1/(0.400*srate));
  meter_lufs_s_c =exp(-1/(3.000*srate));
  meter_lufs_i_c =exp(-1/(0.500*srate));
  target_meter_c =exp(-1/(4.500*srate));
);

// ── Memory ────────────────────────────────────────────────────
max_look_spl=ceil(srate*0.08)+8;
bufL=0;bufR=bufL+max_look_spl;bufPeak=bufR+max_look_spl;
writepos=0;last_lim_look=-1;last_lim_on=-1;
clear_lim_buf();
pkh_base=bufPeak+max_look_spl+4;
PEAK_DECAY=0.55;i=0;loop(20,pkh_base[i]=-90;i+=1;);
LRA_BINS=1024;LRA_BPD=10;
lra_hist=pkh_base+24;memset(lra_hist,0,LRA_BINS);
lra_tick_rate=max(1,floor(srate/10));lra_tick_cnt=0;lra_reco_cnt=0;ui_lra=0;

// Tape Glue memory/state (Oxide & Seek / ToTape9 family)
tape_mem=lra_hist+LRA_BINS+16;
tape_dL=tape_mem; tape_mem+=1002;
tape_dR=tape_mem; tape_mem+=1002;
tape_gslew=tape_mem; tape_mem+=27;
tape_avg32L=tape_mem; tape_mem+=33; tape_avg32R=tape_mem; tape_mem+=33;
tape_avg16L=tape_mem; tape_mem+=17; tape_avg16R=tape_mem; tape_mem+=17;
tape_avg8L=tape_mem; tape_mem+=9; tape_avg8R=tape_mem; tape_mem+=9;
tape_avg4L=tape_mem; tape_mem+=5; tape_avg4R=tape_mem; tape_mem+=5;
tape_avg2L=tape_mem; tape_mem+=3; tape_avg2R=tape_mem; tape_mem+=3;
tape_post32L=tape_mem; tape_mem+=33; tape_post32R=tape_mem; tape_mem+=33;
tape_post16L=tape_mem; tape_mem+=17; tape_post16R=tape_mem; tape_mem+=17;
tape_post8L=tape_mem; tape_mem+=9; tape_post8R=tape_mem; tape_mem+=9;
tape_post4L=tape_mem; tape_mem+=5; tape_post4R=tape_mem; tape_mem+=5;
tape_post2L=tape_mem; tape_mem+=3; tape_post2R=tape_mem; tape_mem+=3;
tape_intermediateL=tape_mem; tape_mem+=18; tape_intermediateR=tape_mem; tape_mem+=18;
tape_slewL=tape_mem; tape_mem+=34; tape_slewR=tape_mem; tape_mem+=34;
tape_UINT32_MAX=4294967295;
tape_fpdL=rand(tape_UINT32_MAX); tape_fpdR=rand(tape_UINT32_MAX);
tape_compEncL=1; tape_compEncR=1; tape_compDecL=1; tape_compDecR=1;
tape_sweepL=$pi; tape_sweepR=$pi; tape_nextmaxL=0.5; tape_nextmaxR=0.5;
tape_gcount=999; tape_avgPos=0;
tape_clear_delay();

// Runtime
lim_gain=1;out_trim_db=0;out_auto_g=1;
play_declick_total=1;play_declick_remaining=0;
out_final_lim_gain=1;out_final_gr_db=0;
mt_env=0;mt_gr_db=0;mt_fb_det=0;mt_sc_lpL=mt_sc_lpR=0;
gm_macro_env=0;gm_micro_env=0;gm_rms_env=0;gm_macro_gr_db=0;gm_micro_gr_db=0;gm_crest_gr_db=0;
gm_prevL=0;gm_prevR=0;gm_lim_prevL=0;gm_lim_prevR=0;gm_out_prevL=0;gm_out_prevR=0;gm_meter_gr=0;
env_follow=0;os_prevL=0;os_prevR=0;
rms_dry=0;rms_wet=0;gm_smooth=1;gain_match_val=1;
out_fast_c=0.9;out_fast_samples=0;out_fast_remaining=0;
out_cal_sum=0;out_cal_count=0;out_cal_progress=0;out_cal_target_spl=floor(max(1, srate * clamp(out_capture_seconds,20,90)));
out_cal_smooth_trim=0;out_cal_confirm_time=0;out_cal_lufs_avg=-100;
meter_reset_pending=0;
tone_lp1L=tone_lp1R=tone_lp2L=tone_lp2R=tone_lp3L=tone_lp3R=0;
tone_e1=tone_e2=tone_e3=tone_e4=0.000000001;
tone_g1=tone_g2=tone_g3=tone_g4=1;
tone_tg1=tone_tg2=tone_tg3=tone_tg4=1;
tone_gd1=tone_gd2=tone_gd3=tone_gd4=0;
tone_eq_dyn=0;tone_eq_gd1=tone_eq_gd2=tone_eq_gd3=tone_eq_gd4=0;
tone_ui_actual1=tone_ui_actual2=tone_ui_actual3=tone_ui_actual4=0;
tone_ui_target1=tone_ui_target2=tone_ui_target3=tone_ui_target4=0;
tone_ui_corr1=tone_ui_corr2=tone_ui_corr3=tone_ui_corr4=0;
tone_ui_eq_corr1=tone_ui_eq_corr2=tone_ui_eq_corr3=tone_ui_eq_corr4=0;
tone_prime_pending=1;tone_gr_db=0;
last_srate=-1;
hpL_x1=hpL_x2=hpL_y1=hpL_y2=0;hpR_x1=hpR_x2=hpR_y1=hpR_y2=0;
lpL_x1=lpL_x2=lpL_y1=lpL_y2=0;lpR_x1=lpR_x2=lpR_y1=lpR_y2=0;
rms_env=0.000000001;
phase_l_env=0.000000001;phase_r_env=0.000000001;phase_lr_env=0;ui_phase_corr=0;ui_phase_level_db=-100;
lufs_m_env=0.000000001;lufs_s_env=0.000000001;lufs_i_env=0.000000001;
lufs_i_sum=0;lufs_i_count=0;
cur_lufs_m=-100;cur_lufs_s=-100;cur_lufs_i=-100;rms_db=-100;
target_lufs_env=0.000000001;target_rms_env=0.000000001;
target_lufs_db=-100;target_rms_db=-100;target_meter_prime=1;
meter_prime_pending=1;meter_just_primed=0;meter_prev_play_state=0;
LUFS_CAL_DB=0.7;
pk_in_env=0.000000001;in_rms_env=0.000000001;pk_comp_env=0.000000001;
pk_lim_env=0.000000001;pk_out_env=0.000000001;pk_pre_env=0.000000001;
outL_prev=0;outR_prev=0;out_peak_dbfs=-100;out_peak_hold_dbfs=-100;out_peak_max_dbfs=-100;out_peak_hold_spl=0;
out_peak_l_dbfs=-100;out_peak_r_dbfs=-100;ui_out_peak_l_dbfs=-100;ui_out_peak_r_dbfs=-100;
ui_comp_gr=0;ui_lim_gr=0;ui_in_db=-100;ui_out_db=-100;ui_pre_db=-100;
ui_out_trim_db=0;ui_out_pre_auto_dbfs=-100;ui_out_peak_dbfs=-100;
ui_target_err_db=0;ui_target_valid=0;ui_target_mode=0;
ui_target_raw_err_db=0;
ui_out_peak_max_dbfs=-100;ui_tone_gr=0;ui_tape_amt=0;ui_final_gr=0;
ui_global_lufs_m=-100;ui_global_lufs_s=-100;ui_global_lufs_i=-100;
ui_global_rms_db=-100;ui_final_density=0;ui_final_crest=30;
ms_m_env=0.000000001;ms_s_env=0.000000001;ui_ms_mid_db=-100;ui_ms_side_db=-100;ui_ms_width_db=-100;

// K-weighting
meter_hpL.biquad_set_hp(60,0.707);meter_hsL.biquad_set_hs(4000,0.707,4.0);
meter_hpR.biquad_set_hp(60,0.707);meter_hsR.biquad_set_hs(4000,0.707,4.0);

// GUI
knob_active_sl=0;btn_down=0;mouse_click=0;fine_tune=1;
tone_rst_down_time=0;tone_rst_hold_done=0;
ui_hover_id=0;ui_prev_mouse_down=0;ui_render_only=0;
last_dbl_id=-1;last_dbl_time=0;
out_preset_sel=0;
tone_preset=0;
tone_points_dyn=0;
out_link_on=0;
out_link_anchor_in=out_intrim;
out_link_anchor_mkp=out_makeup;
gfx_init_done=0;
ui_host_visibility_state=-1;
last_mouse_wheel=0;last_mouse_hwheel=0;

compute_params();

@slider
compute_params();
slider_show(slider_mask(32),0);
slider_show(slider_mask(33),0);
// I target appartengono al Target Engine e non devono occupare la testata
// nativa sopra la GUI. Restano parametri di progetto, ma la vista e' compatta.
slider_show(slider_mask(56),0);
slider_show(slider_mask(57),0);
slider_show(slider_mask(58),0);
slider_show(slider_mask(59),0);
slider_show(slider_mask(60),0);
slider_show(slider_mask(61),0);
slider_show(slider_mask(62),0);
slider_show(slider_mask(63),0);
slider_show(slider_mask(64),0);

@serialize
file_var(0,ui_show_engine);
file_var(0,ui_show_meter);
file_var(0,ui_show_nav);
file_var(0,ui_mono_analysis);
file_var(0,ui_layout_schema);
// Persistenza completa Capture Lock: stato LOCK, RMS catturato e trim devono
// riaprirsi identici nel progetto, senza nuova cattura.
file_var(0,out_cal_state);
file_var(0,out_cal_trim);
file_var(0,out_cal_sum);
file_var(0,out_cal_count);
file_var(0,out_cal_progress);
