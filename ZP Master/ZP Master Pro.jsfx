mouse_click&&(hit(_target_btn_x,bby,bbw,bbh)||hit(_auto_btn_x,bby,bbw,bbh))&&floor(slider(22)+0.5)==0?set_ui_slider(22,1);
auto_tm=floor(slider(22)+0.5);
