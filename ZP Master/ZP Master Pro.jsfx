  gfx_setfont(1,"Arial",16);
  gfx_set(0.84,0.86,0.86,1);gfx_x=_hpx+34;gfx_y=_hpy+118;gfx_drawstr("COMP accende il compressore principale: soglia, ratio, knee, RMS/Peak e AMU.");
  gfx_x=_hpx+34;gfx_y=_hpy+150;gfx_drawstr("GLUE aggiunge macro lento, micro picchi e crest transienti.");
