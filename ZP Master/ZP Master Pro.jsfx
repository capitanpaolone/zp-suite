  _y+=_rh;

  // Row 8
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx1;gfx_y=_y;gfx_drawstr("Comp Ratio");
  sprintf(#_jv,"%.2f",slider(8));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx2;gfx_y=_y;gfx_drawstr("Target L+R");
  sprintf(#_jv,"%.1f",slider(29));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  _y+=_rh;

  // Row 9
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx1;gfx_y=_y;gfx_drawstr("SC HPF [Hz]");
  sprintf(#_jv,"%.0f",slider(9));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx2;gfx_y=_y;gfx_drawstr("Final Limiter");
  floor(slider(30)+0.5)?(gfx_set(0.26,0.92,0.36,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr("ON")):(gfx_set(0.46,0.46,0.50,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr("off"));
  _y+=_rh;

  // Row 10
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx1;gfx_y=_y;gfx_drawstr("Tape Shape");
  sprintf(#_jv,"%.2f",slider(10));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  // col 2 toggles section
  gfx_setfont(1,"Arial",9,'b');gfx_set(0.86,0.54,0.14,0.90);gfx_x=_cx2;gfx_y=_y;gfx_drawstr("SWITCH");
  _y+=_rh;gfx_setfont(1,"Arial",9);

  // Row 11
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx1;gfx_y=_y;gfx_drawstr("Flutter");
  sprintf(#_jv,"%.2f",slider(11));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr(#_jv);
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx2;gfx_y=_y;gfx_drawstr("SOFT knee");
  floor(slider(16)+0.5)?(gfx_set(0.90,0.82,0.22,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr("ON")):(gfx_set(0.46,0.46,0.50,1);gfx_x=_cx2+_voff;gfx_y=_y;gfx_drawstr("off"));
  _y+=_rh;

  // Row 12
  gfx_set(0.62,0.72,0.82,1);gfx_x=_cx1;gfx_y=_y;gfx_drawstr("Head Bump");
  sprintf(#_jv,"%.2f",slider(12));gfx_set(0.92,0.94,0.96,1);gfx_x=_cx1+_voff;gfx_y=_y;gfx_drawstr(#_jv);
