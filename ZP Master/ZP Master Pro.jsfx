    tape_hB_sL1=headBiqSampleL*tape_hB_a1-headBumpSampleL*tape_hB_b1+tape_hB_sL2;
    tape_hB_sL2=headBiqSampleL*tape_hB_a2-headBumpSampleL*tape_hB_b2;
    headBiqSampleR=tape_headBumpR*tape_hA_a0+tape_hA_sR1;
    tape_hA_sR1=tape_headBumpR*tape_hA_a1-headBiqSampleR*tape_hA_b1+tape_hA_sR2;
    tape_hA_sR2=tape_headBumpR*tape_hA_a2-headBiqSampleR*tape_hA_b2;
    headBumpSampleR=headBiqSampleR*tape_hB_a0+tape_hB_sR1;
    tape_hB_sR1=headBiqSampleR*tape_hB_a1-headBumpSampleR*tape_hB_b1+tape_hB_sR2;
    tape_hB_sR2=headBiqSampleR*tape_hB_a2-headBumpSampleR*tape_hB_b2;
  );
