  clear_lim_buf();
  play_declick_total=max(1,(lim_on>=0.5?lim_look_spl:0)+floor(0.005*srate));
  play_declick_remaining=play_declick_total;
);
meter_prev_play_state=meter_play_state;
dsp_needs_update?(compute_params();dsp_needs_update=0;);

@sample

// 0. IN TRIM
xL=spl0*intrim_g; xR=spl1*intrim_g;
pk_in_env=pk_decay(max(abs(xL),abs(xR)),pk_in_env);
in_sig_rms=0.5*(xL*xL+xR*xR);
in_rms_env=in_sig_rms+meter_rms_c*(in_rms_env-in_sig_rms);
ui_bus_local_crest=max(0,gain2db(max(pk_in_env,0.000000000001))-gain2db(sqrt(max(in_rms_env,0.000000000001))));
ui_bus_local_density=min(100,max(0,100-ui_bus_local_crest*3.5));

// 1. TAPE GLUE
tape_on>=0.5?(
  inputSampleL=xL*tape_input_gain;
  inputSampleR=xR*tape_input_gain;

  // Dubly encode: level-dependent high-frequency tape emphasis.
  tape_iirEncL=tape_iirEncL*(1-tape_iir_enc_freq)+inputSampleL*tape_iir_enc_freq;
  highPart=((inputSampleL-tape_iirEncL)*2.848)+tape_avgEncL;
  tape_avgEncL=(inputSampleL-tape_iirEncL)*1.152;
  highPart=clamp(highPart,-1,1); dubly=abs(highPart);
