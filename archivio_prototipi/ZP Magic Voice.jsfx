@init
ext_noinit = 1;
ui_lang = 0;
help_bridge_last_alive_t = -100;

// ---------------- ZP Shared Bus ----------------
ZP_BUS_MAGIC = 905026;
ZP_BUS_VERSION = 220;
ZP_BUS_ID = 35;
ZP_BUS_FRESH_SEC = 12;

function zp_bus_boot() (
  gmem[0] != ZP_BUS_MAGIC || gmem[1] < ZP_BUS_VERSION ? (
    gmem[0] = ZP_BUS_MAGIC;
    gmem[1] = ZP_BUS_VERSION;
    gmem[2] = 1;
  );
);
function zp_bus_read() local(now) (
  zp_bus_boot();
  now = time_precise();
  zp_bus_master_conn = gmem[40] == 905040 ? (now - gmem[41] <= ZP_BUS_FRESH_SEC ? 2 : 1) : 0;
  zp_bus_probe_conn  = gmem[50] == 905050 ? (now - gmem[51] <= ZP_BUS_FRESH_SEC ? 2 : 1) : 0;
);
function zp_bus_refresh(plugin_id) (
  zp_bus_boot();
  gmem[plugin_id] = 905000 + plugin_id;
  gmem[plugin_id + 1] = time_precise();
  gmem[plugin_id + 2] += 1;
);
zp_bus_boot();
zp_bus_read();

function db2lin(db) ( 10 ^ (db * 0.05); );
function lin2db(lin) ( 20 * log10(max(lin, 0.0000001)); );
function clamp(v, mn, mx) ( max(mn, min(mx, v)); );

// ---------------- State ----------------
opt_env = 0; rcomp_env = 0;
drcA_env = 0; drcB_env = 0; drcC_env = 0; drcD_env = 0;
drcA_gr_db = 0; drcB_gr_db = 0; drcC_gr_db = 0; drcD_gr_db = 0;
deq_e0 = 0; deq_e1 = 0; deq_e2 = 0; deq_e3 = 0; deq_e4 = 0;
deq_gdb0 = 0; deq_gdb1 = 0; deq_gdb2 = 0; deq_gdb3 = 0; deq_gdb4 = 0;
deq_gr_db = 0;
dbal_low_env = 0.01; dbal_mid_env = 0.01; dbal_hi_env = 0.01;
dbal_act_pct = 0;
g_lo = 1; g_mid = 1; g_hi = 1;
t_lo = 0.38; t_mid = 0.42; t_hi = 0.20;
gm_rms_in = 0.001; gm_rms_out = 0.001; gm_gain = 1.0;
tp_prevL = 0; tp_prevR = 0; tp_gr = 1.0; tp_gr_smooth = 1.0; tp_meter_peak = 0;

ui_rms_in_sq = 0; ui_rms_out_sq = 0; ui_rms_in_db = -60; ui_rms_out_db = -60;
ui_peak_gr_db = 0; ui_gr_opt = 0; ui_gr_rc = 0; ui_pk_lvl_db = -90; ui_pk_thr_db = -20;
ui_drc_gr_db = 0; ui_drcA = 0; ui_drcB = 0; ui_drcC = 0; ui_drcD = 0;
ui_deq_lo = 0; ui_deq_hi = 0;
ui_deq0 = 0; ui_deq1 = 0; ui_deq2 = 0; ui_deq3 = 0; ui_deq4 = 0;
ui_sh_lo = 0.33; ui_sh_mid = 0.44; ui_sh_hi = 0.23;
ui_tp_gr_db = 0; ui_gm_db = 0;

