options:no_meter


@init

// =====================================================

<?
  nch = max(max_nch,64);
  sinc_sz = 32;
  use_mem_sinc = sinc_sz>32;

  printf("sinc_sz = %d;\n",sinc_sz);

 function do_all_channels(fmt) local(p x c) global(nch) (
   p=x=0;
   while (x < nch) (
     p+=1;
     x>0 ? printf("num_ch > %d ? ( ",x);
     c = x>=24 ? 8 : x>=8 ? 4 : 2;
     loop(c, printf(fmt,x,x); x+=1);
     printf("\n");
   );
   loop(p-1,printf(")"));
 );
?>

WANT_INTEGRATED_ALWAYS=0;

FONT_SZ_MIN=12;
FONT_SZ_MAX=16;
BG_COLOR=$x000000;
GRID_COLOR=$x7f7f7f;
TEXT_COLOR=$xffffff;
PEAK_COLOR=$x3fff3f;
PEAK_CLIP_COLOR=$xff0000;
PEAK_NOW_COLOR=$x33d6ff;
RMS_COLOR=$x7f7f7f;
LUFS_COLOR=$x00bfff;
LUFS_HIST_COLOR=$x005f7f;
RED_COLOR=$xff0000;
YELLOW_COLOR=$xffff00;
MONO_COLOR=$xffa500;
SIDEBAR_BG=$x1a1a2e;
SIDEBAR_BTN=$x2a2a4e;
SIDEBAR_HOV=$x3a3a6e;
SIDEBAR_ACC=$x00bfff;
RESET_BTN_COLOR=$x6a6253;
RESET_BTN_HOVER=$x7a715f;

PEAK_METER_DECAY=0.150;
LOUD_METER_UPDATE=0.100;
LOUD_METER_SPEED=0.075;

UI_SLIDER_MASK=(1<<42)-1;
UI_HIDDEN_SLIDER_MASK =
  (1<<0)|(1<<1)|(1<<2)|(1<<3)|(1<<4)|(1<<5)|(1<<6)|(1<<7)|(1<<8)|(1<<9)|
  (1<<12)|(1<<13)|(1<<15)|(1<<16)|(1<<17)|(1<<18)|
  (1<<23)|(1<<24)|(1<<25)|(1<<26)|(1<<27)|(1<<28);
slider_show(UI_HIDDEN_SLIDER_MASK,0);

ext_noinit=1;
ext_nodenorm=1;
gfx_ext_retina=max(gfx_ext_retina,1);

sliders_showing=0;

NUM_BINS=1024;
BINS_PER_DB=10;
DB_PER_BIN=1/BINS_PER_DB;

// Sidebar state
sidebar_open=1;
sidebar_w=180;
sidebar_drag=-1;
sidebar_drag_val=0;
sidebar_drag_y0=0;
last_play_state=0;
quick_knob=0;
quick_knob_y0=0;
quick_knob_v0=0;
reset_pressing=0;
reset_press_t=0;
reset_long_done=0;
tip_active=0;
ref_edit=0;
#ref_edit_buf="";
ref_dbl_t=0;
ref_dbl_target=0;
last_click_t2=0;
last_click_target2=0;
sidebar_scroll=0;  // scroll offset sidebar in px

function alloc(sz) global()
(
  memset((this.top+=sz)-sz,0,sz);
);

function sinc_gen_val() global(srate sinc_sz) local(sincpos windowpos) instance(slice_pos) (
  windowpos = (2.0 * $pi / sinc_sz) * slice_pos;
  sincpos = $pi * (slice_pos - sinc_sz * .5);
  slice_pos += 1;
  (0.53836 - cos(windowpos)*0.46164) * sin(sincpos) / sincpos;
);

function sinc_gen_slice(cs, o*) instance(sinc_gen_val slice_pos) local(x) global(sinc_sz) (
  slice_pos = cs;
<?
  use_mem_sinc ? (
    printf("o.v = alloc(sinc_sz);  loop(x=0;sinc_sz, o.v[x] = sinc_gen_val(); x+=1); ");
  ) : (
    loop(x=0;sinc_sz, printf("o.v%02d = sinc_gen_val();%s",x,(x&3)==3?"\n": " "); x += 1)
  );
?>
);

function sinc_init() global(srate) instance(sinc_gen_slice) (
  sinc_gen_slice(srate < 96000 ? .25 : .5,this.s1);
  srate < 96000 ? (
    sinc_gen_slice(.5, this.s2);
    sinc_gen_slice(.75, this.s3);
  );
);

<?
 function emit_sinc(hist, t) (
   use_mem_sinc ? (
    printf("abs(mem_multiply_sum(%s.v,%s.h,sinc_sz))",t,hist);
   ) : (
     printf("abs(");
     loop(x=0;sinc_sz, printf("%s.h%02d * %s.v%02d%s",hist,x,t,x,x==sinc_sz-1?"":(x&3)==3?" +\n":" + "); x+=1);
     printf(")");
   );
 );
?>

function init(chidx)
(
  this.chan=chidx;
  this.wt = chidx < 3 || num_ch < 6 ? 1 : chidx == 3 ? 0 : sqrt(2);
  this.f1p1=this.f1p2=this.f2p1=this.f2p2=0;
  this.pkval=this.hipkval=this.clips=0;
  this.clip_decay_t=0;   // timestamp ultimo clip
  this.ch_lufs_sum=this.ch_rms_sum=0;
  <?
    use_mem_sinc ? (
      printf("this.h = alloc(sinc_sz);\n");
    ) : (
      loop(x=0;sinc_sz, printf("this.h%02d =%s",x,x==sinc_sz-1 ? " 0" : (x&7)==7 ? "\n" : " "); x+=1);
    );
  ?>
);

function decay()
(
  this.pkval *= pk_decay;
);

function reset_clips()
(
  this.clips=0;
  this.clip_decay_t=0;
);

function reset_hold() global(peak_hold_val peak_hold_t) (
  peak_hold_val[this.chan]=0;
  peak_hold_t[this.chan]=0;
);

function copypks() global(pk hipk clip_cnt clip_decay_t_arr peak_hold_val peak_hold_t) (
  pk[this.chan] = this.pkval;
  hipk[this.chan] = this.hipkval;
  clip_cnt[this.chan] = this.clips;
  clip_decay_t_arr[this.chan] = this.clip_decay_t;
  // Aggiorna hold: se nuovo picco più alto, registra tempo
  this.pkval > peak_hold_val[this.chan] ? (
    peak_hold_val[this.chan] = this.pkval;
    peak_hold_t[this.chan] = time_precise();
  );
);

function proc(lspl)
  local(pspl f1p0 f2p0)
  instance(wt ch_rms_sum ch_lufs_sum pkval hipkval clips clip_decay_t
           f1p1 f1p2 f2p1 f2p2)
  global(f1a1 f1a2 f1b0 f1b1 f1b2
         f2a1 f2a2 f2b0 f2b1 f2b2
         srate cfg_peak
         lval rval win_pos global_peak sinc_sz
         sinc.s1* sinc.s2* sinc.s3*
         )
(
  cfg_peak == 1 || cfg_peak == 2 ? (
    <?
      use_mem_sinc ? (
        printf("mem_insert_shuffle(this.h, sinc_sz, lspl);");
      ) : (
        loop(x=sinc_sz-1;sinc_sz-1, printf("this.h%02d = this.h%02d;%s",x,x-1, (x&3)==0 ? "\n" : " "); x-= 1; );
        printf(" this.h00 = lspl;");
      );
    ?>
    pspl = max(
        abs(this.h<? printf(use_mem_sinc ? "[%d]" : "%02d",sinc_sz/2) ?>),
        <? emit_sinc("this","sinc.s1") ?>
       );
    srate < 96000 ? pspl = max(pspl,max( <? emit_sinc("this","sinc.s2") ?>, <? emit_sinc("this","sinc.s3") ?>));
  ) :
  cfg_peak == 3 || cfg_peak == 4 ? (
    pspl=abs(lspl);
  );
  cfg_peak ? (
    pspl > pkval ? (
      pkval=pspl;
      pspl > hipkval ? (
        hipkval=pspl;
        global_peak = max(global_peak,pspl);
      );
    );
    pspl > 1.0 ? (
      clips += 1;
      clip_decay_t = time_precise();  // registra timestamp clip
    );
  );

  win_pos == 0 ? ch_rms_sum=ch_lufs_sum=0;

  rval += (ch_rms_sum += lspl*lspl);

  lspl *= wt;

  f1p0=lspl-f1a1*f1p1-f1a2*f1p2;
  lspl=f1b0*f1p0+f1b1*f1p1+f1b2*f1p2;
  f1p2=f1p1;
  f1p1=f1p0;

  f2p0=lspl-f2a1*f2p1-f2a2*f2p2;
  lspl=f2b0*f2p0+f2b1*f2p1+f2b2*f2p2;
  f2p2=f2p1;
  f2p1=f2p0;

  lval += (ch_lufs_sum += lspl*lspl);
);

function init_lufs_filters()
  local(Vh Vb db f0 Q K a0)
  global(f1a1 f1a2 f1b0 f1b1 f1b2
         f2a1 f2a2 f2b0 f2b1 f2b2 srate)
(
  db=3.999843853973347;
  f0=1681.974450955533;
  Q=0.7071752369554196;
  K=tan($pi*f0/srate);
  Vh=pow(10, db/20);
  Vb=pow(Vh, 0.4996667741545416);
  a0=1+K/Q+K*K;
  f1a1=2*(K*K-1)/a0;
  f1a2=(1-K/Q+K*K)/a0;
  f1b0=(Vh+Vb*K/Q+K*K)/a0;
  f1b1=2*(K*K-Vh)/a0;
  f1b2=(Vh-Vb*K/Q+K*K)/a0;

  f0=38.13547087602444;
  Q=0.5003270373238773;
  K=tan($pi*f0/srate);
  f2a1=2*(K*K-1)/(1+K/Q+K*K);
  f2a2=(1-K/Q+K*K)/(1+K/Q+K*K);
  f2b0=1;
  f2b1=-2;
  f2b2=1;
);

function Reset()
(
  init_lufs_filters();

  alloc.top=0;
  pk=alloc(<?printf("%d",nch)?>);
  hipk=alloc(<?printf("%d",nch)?>);
  clip_cnt=alloc(<?printf("%d",nch)?>);
  clip_decay_t_arr=alloc(<?printf("%d",nch)?>);
  peak_hold_val=alloc(<?printf("%d",nch)?>);
  peak_hold_t=alloc(<?printf("%d",nch)?>);
  peak_now_db_disp=alloc(<?printf("%d",nch)?>);
  sinc.sinc_init();

  m_win_cnt=0.4/LOUD_METER_UPDATE;
  s_win_cnt=3/LOUD_METER_UPDATE;

  win_pos=0;
  win_cnt=0;
  win_len=(LOUD_METER_UPDATE*srate)|0;
  i_win_len=1/(m_win_cnt*win_len);
  i_win_len2=1/(s_win_cnt*win_len);

  rms_m_sum=0;
  rms_m_db=-100;
  rms_m_db_max=-100;
  rms_i_sum=0;
  rms_i_sum_cnt=0;
  rms_i_db=-100;

  lufs_m_sum=0;
  lufs_m_sum_max=0;
  lufs_m_db=-100;
  lufs_s_sum=0;
  lufs_s_sum_max=0;
  lufs_s_db=-100;
  lufs_a_sum=0;
  lufs_a_sum_cnt=0;
  lufs_b_sum=0;
  lufs_b_sum_cnt=0;
  lra_db_diff = 0;
  lra_db_hi = lra_db_lo = lufs_i_db = lufs_m_db = lufs_s_db = -100;

  last_t=0;
  th_lufs_i=th_lufs_s=th_lufs_m=th_rms_i=th_rms_m=0;

  cur_buf=0;
  cur_buf2=0;
  rms_buf=alloc(m_win_cnt);
  lufs_buf=alloc(m_win_cnt);
  lufs_buf2=alloc(s_win_cnt);
  lufs_a_hist=alloc(2*NUM_BINS);
  lufs_b_hist=alloc(NUM_BINS);
  db_hist=alloc(75);
  db_hist_max=0;

  global_peak = 0;

  <? do_all_channels("ch%d.init(%d); "); ?>;
  i=0;
  loop(nch, peak_now_db_disp[i]=-150; i+=1;);
);

Reset();


@block

want_reset =
  (num_ch > 0 && num_ch != last_nch) ||
  srate != last_sr;
last_nch=num_ch;
last_sr=srate;

cfg_reinit && (play_state&1) ? (
  abs(play_position-last_play_pos) > 0.1 ? want_reset=1;
  last_play_pos=play_position+samplesblock/srate;
);

want_reset ? Reset();

// Reset completo allo stop (solo su transizione play->stop)
cfg_clip_reset_stop && !(play_state&1) && last_play_state ? (
  Reset();
  last_play_pos=play_position;
);
last_play_state = play_state&1;

pk_decay=pow(0.5, samplesblock/srate/max(0.05,cfg_meter_response));

<? do_all_channels("ch%d.decay(); "); ?>;

function make_output_slider(b, base) ( cfg_out_auto>=2 && !(cfg_out_auto&1) ? base - b : b );
outparm_lufs_m = make_output_slider(lufs_m_db + (cfg_mono ? -3 : 0),-100);
outparm_lufs_s = make_output_slider(lufs_s_db + (cfg_mono ? -3 : 0),-100);
outparm_lufs_i = make_output_slider(lufs_i_db + (cfg_mono ? -3 : 0),-100);
outparm_lufs_lra = make_output_slider(lra_db_diff,100);
outparm_peak = make_output_slider(global_peak > 0 ? log(global_peak)*20/log(10) : -150,-150);
outparm_rms_m = make_output_slider(rms_m_db + (cfg_mono ? -3 : 0),-100);
outparm_rms_i = make_output_slider(rms_i_db + (cfg_mono ? -3 : 0),-100);

cfg_out_auto ? slider_automate(
  cfg_out_auto > 2 ? (2^(29 + floor((cfg_out_auto-3)/2))) : (
    2^29 | 2^30 | 2^31 | 2^32 | 2^33 | 2^34 | 2^35 | 0
  )
);


@sample

rval=lval=0;

<? do_all_channels("ch%d.proc(spl%d); "); ?>;

(win_pos += 1) >= win_len ? (
  win_pos=0;
  win_cnt += 1;

  prev_rval=rms_buf[cur_buf];
  rms_buf[cur_buf]=rval;

  prev_lval=lufs_buf[cur_buf];
  lufs_buf[cur_buf]=lval;

  prev_lval2=lufs_buf2[cur_buf2];
  lufs_buf2[cur_buf2]=lval;

  (cur_buf += 1) >= m_win_cnt ? cur_buf=0;
  (cur_buf2 += 1) >= s_win_cnt ? cur_buf2=0;

  rms_m_sum += (rval-prev_rval)*i_win_len;
  lufs_m_sum += (lval-prev_lval)*i_win_len;
  lufs_s_sum += (lval-prev_lval2)*i_win_len2;

  WANT_INTEGRATED_ALWAYS || (play_state&1) ? (
    rms_i_sum += rms_m_sum;
    rms_i_sum_cnt += 1;
    rms_i_sum > 0 && rms_i_sum_cnt >= m_win_cnt ? (
      rms_i_db=log(rms_i_sum/rms_i_sum_cnt)*10/log(10);
    ) : (
      rms_i_db=-100;
    );
  );

  rms_m_sum > 0 && win_cnt >= m_win_cnt ? (
    rms_m_db=log(rms_m_sum)*10/log(10);
    rms_m_db > rms_m_db_max ? rms_m_db_max=rms_m_db;
  ) : (
    rms_m_db=-100;
  );

  lufs_m_sum > 0 && win_cnt >= m_win_cnt ? (
    lufs_m_sum > lufs_m_sum_max ? lufs_m_sum_max=lufs_m_sum;
    lufs_m_db=-0.691+log(lufs_m_sum)*10/log(10);

    a = WANT_INTEGRATED_ALWAYS || (play_state&1) ? ((lufs_m_db+70)*BINS_PER_DB)|0 : -1;
    a >= 0 ? (
      a >= NUM_BINS ? a=NUM_BINS-1;
      lufs_a_sum += lufs_m_sum;
      lufs_a_sum_cnt += 1;
      lufs_a_hist[2*a] += 1;
      lufs_a_hist[2*a+1] += lufs_m_sum;
      db_hist_max = max(db_hist_max,db_hist[min(a*DB_PER_BIN,74)] += 1);

      lufs_a_db=-0.691+log(lufs_a_sum/lufs_a_sum_cnt)*10/log(10);
      lufs_a_gate=((lufs_a_db-10+70)*BINS_PER_DB)|0;
      lufs_i_sum=0;
      lufs_i_cnt=0;
      bin=max(lufs_a_gate,0);
      loop(NUM_BINS-bin,
        lufs_i_cnt += lufs_a_hist[2*bin];
        lufs_i_sum += lufs_a_hist[2*bin+1];
        bin += 1;
      );
      lufs_i_db=lufs_i_sum > 0 ? -0.691+log(lufs_i_sum/lufs_i_cnt)*10/log(10) : -100;
    );
  ) : (
    lufs_m_db=-100;
  );

  lufs_s_sum > 0 && win_cnt >= s_win_cnt ? (
    lufs_s_sum > lufs_s_sum_max ? lufs_s_sum_max=lufs_s_sum;
    lufs_s_db=-0.691+log(lufs_s_sum)*10/log(10);

    b = WANT_INTEGRATED_ALWAYS || (play_state&1) ? ((lufs_s_db+70)*BINS_PER_DB)|0 : -1;
    b >= 0 ? (
      b >= NUM_BINS ? b=NUM_BINS-1;
      lufs_b_sum += lufs_s_sum;
      lufs_b_sum_cnt += 1;
      lufs_b_hist[b] += 1;

      lufs_b_db=-0.691+log(lufs_b_sum/lufs_b_sum_cnt)*10/log(10);
      lufs_b_gate=((lufs_b_db-20+70)*BINS_PER_DB)|0;

      lra_cnt=0;
      bin=max(lufs_b_gate,0);
      loop(NUM_BINS-bin,
        lra_cnt += lufs_b_hist[bin];
        bin += 1;
      );
      lra_cnt >= 20 ? (
        lra_cnt_lo=lra_cnt_hi=0;
        bin=lufs_b_gate;
        while(bin < NUM_BINS && lra_cnt_lo < lra_cnt*0.10)
        (
          lra_cnt_lo += lufs_b_hist[bin];
          bin += 1;
        );
        bin_lo=bin-1;
        bin=NUM_BINS-1;
        while(bin >= lufs_b_gate && lra_cnt_hi < lra_cnt*0.05)
        (
          lra_cnt_hi += lufs_b_hist[bin];
          bin -= 1;
        );
        bin_hi=bin+1;
        lra_db_lo=bin_lo*DB_PER_BIN-70;
        lra_db_hi=bin_hi*DB_PER_BIN-70;
        lra_db_diff = lra_db_hi-lra_db_lo;
      );
    );
  ) : (
    lufs_s_db=-100;
  );
);


@gfx 420 400

<? do_all_channels("ch%d.copypks(); ");?>;

t=time_precise();
draw_dt = last_t ? (t-last_t) : LOUD_METER_SPEED;
speed = last_t ? 1.0-pow(0.5, draw_dt/LOUD_METER_SPEED) : 1;
last_t=t;

// has_click calcolato subito — deve essere disponibile durante tutto il drawing
has_click = (mouse_cap&1) && !(last_cap&1) ? 1 : 0;
last_cap=mouse_cap;
tip_active=0;
#tip_msg="";

gfx_clear=((BG_COLOR&$xff)<<16)|(BG_COLOR&$xff00)|((BG_COLOR&$xff0000)>>16);

zoom_i=floor(cfg_zoom+0.5);
zoom_mul = zoom_i <= 0 ? 1.17 : zoom_i == 2 ? 1.47 : zoom_i >= 3 ? 1.67 : 1.32;

fsz=FONT_SZ_MIN+min(gfx_w/100,FONT_SZ_MAX-FONT_SZ_MIN);
fsz *= (1.0+cfg_textsize/10) * zoom_mul;
gfx_ext_retina > 1 ? fsz *= 1.5;
// fsz_sb = font fisso per sidebar, non influenzato da cfg_textsize
fsz_sb=FONT_SZ_MIN+min(gfx_w/100,FONT_SZ_MAX-FONT_SZ_MIN);
fsz_sb *= zoom_mul;
gfx_ext_retina > 1 ? fsz_sb *= 1.5;
gfx_setfont(1,"Arial",fsz);
gfx_setfont(2,"Arial",fsz*0.85);
gfx_setfont(3,"Arial",fsz_sb*0.9);
gfx_setfont(4,"Arial",fsz_sb*0.78);
rsz=2*gfx_ext_retina;

xu=gfx_texth*3/4;
yu=gfx_texth*7/8;

use_alt_view = !(gfx_ext_flags&1);
layout_mode=floor(cfg_layout+0.5);
use_alt_view ? layout_mode=0;
layout_mode == 0 ? (
  gfx_w < 520 || gfx_h < 260 ? layout_mode=1 :
  gfx_h > gfx_w*1.18 ? layout_mode=3 :
  gfx_w > gfx_h*1.15 ? layout_mode=4 :
  layout_mode=1;
);
is_compact = layout_mode == 1;
is_vertical = layout_mode == 3;
is_horizontal = layout_mode == 4;
is_standard = layout_mode == 2;

HDR_H = is_compact ? max(34, gfx_texth*2.8) :
        is_horizontal ? max(42, gfx_texth*3.0) :
        is_vertical ? max(64, gfx_texth*4.8) :
        max(48, gfx_texth*3.4);

// ---- SIDEBAR ----
// Beta6: nella vista nuova i controlli diventano un drawer alto, non sidebar laterale.
sidebar_allowed = !use_alt_view;
SB_W = (cfg_sidebar && sidebar_allowed) ? min(max(150, sidebar_w*zoom_mul), gfx_w*0.44) : 0;
SB_TAB = 14; // tab visibile anche quando chiusa

// area meter (a destra della sidebar)
meter_x0 = SB_W;
meter_w  = gfx_w - SB_W;

want_vu = gfx_h-HDR_H > yu*7;
want_axis = gfx_h-HDR_H > yu*10 && meter_w > xu*14;
want_capt = gfx_h-HDR_H > yu*4;
want_max = gfx_h-HDR_H > yu*3;

full_nch = cfg_mono ? 1 : max(num_ch,2);
chan_bank_size = is_vertical ? 8 : is_horizontal ? 16 : is_compact ? 8 : 16;
meter_w < 560 ? chan_bank_size = min(chan_bank_size,8);
chan_mode=floor(cfg_chan_view+0.5);
chan_mode == 0 ? (
  (full_nch > chan_bank_size || is_vertical || is_horizontal) ? chan_mode=2 : chan_mode=1;
);
chan_start=0;
chan_count=full_nch;
chan_mode == 2 ? (
  bank_i=floor(cfg_chan_bank+0.5);
  chan_start=min(max(0,bank_i*chan_bank_size),max(0,full_nch-chan_bank_size));
  chan_count=min(chan_bank_size,full_nch-chan_start);
);
(chan_mode == 3 || chan_mode == 4) ? (
  best_ch=0;
  best_score=-1;
  _ci=0;
  loop(full_nch,
    _score = chan_mode == 4 ? (clip_cnt[_ci] > 0 ? 1000 + pk[_ci] : pk[_ci]) : pk[_ci];
    _score > best_score ? (best_score=_score; best_ch=_ci;);
    _ci += 1;
  );
  chan_start=floor(best_ch/chan_bank_size)*chan_bank_size;
  chan_count=min(chan_bank_size,full_nch-chan_start);
);
chan_count=max(1,chan_count);
nch = chan_count;

xl = meter_x0 + xu;
xr = xu;
!use_alt_view ? xr += max(14,gfx_texth*0.95) + 4;
want_axis ? xl += gfx_texth*2;

yhi=HDR_H+yu*0.6;
ylo=gfx_h-yu;
y0 = want_vu ? gfx_h-yu*5 : max(HDR_H+yu*3,gfx_h/2-yu*3/4);
vh = max(1,y0-yhi);
yt = (want_vu ? y0+yu : gfx_h/2)|0;

want_peak = cfg_peak ? 1 : 0;
want_rms_m = cfg_rms_m ? 1 : 0;
want_rms_i = cfg_rms_i ? 1 : 0;
want_lufs_m = cfg_lufs_m ? 1 : 0;
want_lufs_s = cfg_lufs_s ? 1 : 0;
want_lra = cfg_lra ? 1 : 0;
want_lufs_i = cfg_lufs_i ? 1 : 0;

is_compact ? (
  want_rms_m=0;
  want_rms_i=0;
  want_lra=0;
);
is_horizontal ? (
  want_rms_i=0;
);

cols=want_peak*nch+want_rms_m+want_rms_i+
  want_lufs_m+want_lufs_s+want_lra*0.5+want_lufs_i;

colw = cols ? (gfx_w-xl-xr)/cols : (gfx_w-SB_W);
while(colw < xu*3 && cols > want_lufs_i) (
  want_peak ? ( want_peak=0; cols -= nch; ) :
  want_rms_m ? ( want_rms_m=0; cols -= 1; ) :
  want_rms_i ? ( want_rms_i=0; cols -= 1; ) :
  want_lufs_m ? ( want_lufs_m=0; cols -= 1; ) :
  want_lufs_s ? ( want_lufs_s=0; cols -= 1; ) :
  want_lra ? ( want_lra=0; cols -= 0.5; );
  colw=(gfx_w-xl-xr)/cols;
);

want_abbr = colw < gfx_texth*4;

x = gfx_w - xr - colw/2;

function draw_str(ts tx ty tc)
(
  gfx_x=tx;
  gfx_y=ty;
  gfx_drawstr(ts,tc|256,tx,ty);
);

function format_dbv(hv)
(
  hv <= -72 ? "" : sprintf(#, "%+.1f", hv);
);
function format_db(v)
(
  v <= 10^(-72/20) ? "" : format_dbv(log(v)*20/log(10));
);
function scale_db1(v) global(cfg_yscale)
(
  v <= -72 ? 0 : v >= 0 ? 1 : pow(v*1/72+1,cfg_yscale);
);
function scale_v(v) global(cfg_yscale)
(
  v <= 10^(-72/20) ? 0 : v >= 1 ? 1 : pow(log(v)*20/log(10)/72+1,cfg_yscale);
);

function set_color(trgb)
(
  gfx_set((trgb&$xff0000)/$xff0000,(trgb&$xff00)/$xff00,(trgb&$xff)/$xff);
);
function set_alert_color(tdb, trgb)
(
  (cfg_alert == 2 || cfg_alert == 3) && tdb >= cfg_red ?
    set_color(RED_COLOR) :
  (cfg_alert == 1 || cfg_alert == 3) && tdb >= cfg_yellow ?
    set_color(YELLOW_COLOR) :
    set_color(trgb);
);
function set_text_alert_color(tdb)
(
  want_vu ? set_color(TEXT_COLOR) : set_alert_color(tdb, TEXT_COLOR);
);

function draw_grid(db hhi hlo) local(th)
(
  th=scale_db1(db)*vh;
  hlo < 0 || hhi < 0 || (th > hlo+gfx_texth*5/4 && th < hhi-gfx_texth*5/4) ? (
    gfx_line(xl,y0-th,gfx_w-xr,y0-th);
    sprintf(#num,"%+.0f",db);
    want_axis ? draw_str(#num,meter_x0+2,y0-th,4);
    th;
  ) : (
    -1;
  );
);

function draw_histogram(txlo, txhi, lasty, lasttw, y, tw)
(
  gfx_triangle(txlo-lasttw,y0-lasty,txlo-tw,y0-y,txlo,y0-lasty,txlo,y0-y);
  gfx_triangle(txhi+lasttw,y0-lasty,txhi+tw,y0-y,txhi,y0-lasty,txhi,y0-y);
  gfx_line(txlo-lasttw,y0-lasty,txlo-tw,y0-y);
  gfx_line(txhi+lasttw,y0-lasty,txhi+tw,y0-y);
);

function draw_hdr_tile(label value tx ty tw th cr cg cb)
local(_tw, _th)
(
  tw > 24 && th > 18 ? (
    gfx_set(0.075,0.085,0.10,1);
    gfx_rect(tx,ty,tw,th);
    gfx_set(cr,cg,cb,0.45);
    gfx_rect(tx,ty,tw,1);
    gfx_rect(tx,ty+th-1,tw,1);
    gfx_setfont(4,"Arial",max(8,fsz*0.62),'b');
    gfx_set(cr*0.45+0.40,cg*0.45+0.40,cb*0.45+0.40,0.92);
    gfx_x=tx+5; gfx_y=ty+3; gfx_drawstr(label);
    gfx_setfont(2,"Arial",max(10,fsz*0.92),'b');
    gfx_set(0.90,0.96,0.94,1);
    gfx_measurestr(value,_tw,_th);
    gfx_x=tx+tw-_tw-5; gfx_y=ty+th-_th-4; gfx_drawstr(value);
  );
);

function draw_hbar(label value tx ty tw th norm cr cg cb)
local(_tw, _th, _fill, _fill_x, _fill_w, _bar_h)
(
  tw > 36 && th > 16 ? (
    gfx_set(0.060,0.068,0.080,1);
    gfx_rect(tx,ty,tw,th);
    gfx_set(cr,cg,cb,0.35);
    gfx_rect(tx,ty,tw,1);
    gfx_rect(tx,ty+th-1,tw,1);
    gfx_setfont(2,"Arial",max(10,fsz*0.86),'b');
    gfx_measurestr(value,_tw,_th);
    _fill_x=tx+max(64,min(82,tw*0.42));
    _fill_w=max(8,tw-(_fill_x-tx)-_tw-22);
    _fill=floor(max(0,min(1,norm))*_fill_w);
    _bar_h=max(4,floor(th*0.28));
    _fill > 0 ? (
      gfx_set(cr,cg,cb,0.92);
      gfx_rect(_fill_x,ty+floor(th*0.36),_fill,_bar_h);
      gfx_set(1,1,1,0.07);
      gfx_rect(_fill_x,ty+floor(th*0.36),_fill,2);
    );
    gfx_setfont(4,"Arial",max(8,fsz*0.60),'b');
    gfx_set(cr*0.50+0.40,cg*0.50+0.40,cb*0.50+0.40,0.95);
    gfx_x=tx+7; gfx_y=ty+floor((th-gfx_texth)*0.5); gfx_drawstr(label);
    gfx_setfont(2,"Arial",max(10,fsz*0.86),'b');
    gfx_set(0.90,0.96,0.94,1);
    gfx_x=tx+tw-_tw-8; gfx_y=ty+floor((th-_th)*0.5); gfx_drawstr(value);
  );
);

function fill_roundrect(tx ty tw th rr)
(
  rr=max(1,min(rr,min(tw,th)*0.5));
  gfx_rect(tx+rr,ty,tw-rr*2,th);
  gfx_rect(tx,ty+rr,tw,th-rr*2);
  gfx_circle(tx+rr,ty+rr,rr,1,1);
  gfx_circle(tx+tw-rr,ty+rr,rr,1,1);
  gfx_circle(tx+rr,ty+th-rr,rr,1,1);
  gfx_circle(tx+tw-rr,ty+th-rr,rr,1,1);
);

function draw_chip(label tx ty tw th active)
local(_tw, _th, _hov)
(
  _hov=mouse_x>=tx && mouse_x<=tx+tw && mouse_y>=ty && mouse_y<=ty+th;
  active ? gfx_set(_hov ? 0.20 : 0.14,_hov ? 0.38 : 0.28,_hov ? 0.60 : 0.46,1) :
           gfx_set(_hov ? 0.105 : 0.070,_hov ? 0.118 : 0.078,_hov ? 0.140 : 0.090,1);
  gfx_rect(tx,ty,tw,th);
  active ? gfx_set(0.24,0.62,0.96,_hov ? 1.0 : 0.90) : gfx_set(_hov ? 0.40 : 0.20,_hov ? 0.50 : 0.22,_hov ? 0.62 : 0.26,_hov ? 1.0 : 0.90);
  gfx_rect(tx,ty,tw,1);
  gfx_rect(tx,ty+th-1,tw,1);
  _hov ? (
    gfx_set(0.80,0.94,1.0,0.28);
    gfx_rect(tx+1,ty+1,tw-2,th-2);
  );
  gfx_setfont(4,"Arial",max(7,min(fsz*0.58,th*0.58)),'b');
  active ? gfx_set(0.88,0.96,1.0,1) : gfx_set(_hov ? 0.80 : 0.58,_hov ? 0.90 : 0.66,_hov ? 0.98 : 0.72,_hov ? 1.0 : 0.92);
  gfx_measurestr(label,_tw,_th);
  gfx_x=tx+floor((tw-_tw)*0.5);
  gfx_y=ty+floor((th-_th)*0.5);
  gfx_drawstr(label);
);

function chip_hit(tx ty tw th) global(mouse_x mouse_y)
(
  mouse_x>=tx && mouse_x<=tx+tw && mouse_y>=ty && mouse_y<=ty+th;
);

function draw_color_chip(label tx ty tw th cr cg cb)
local(_tw, _th, _hov, _mul)
(
  _hov=mouse_x>=tx && mouse_x<=tx+tw && mouse_y>=ty && mouse_y<=ty+th;
  _mul=_hov ? 1.28 : 1.0;
  gfx_set(cr*_mul,cg*_mul,cb*_mul,1);
  gfx_rect(tx,ty,tw,th);
  gfx_set(min(1,cr*1.55),min(1,cg*1.55),min(1,cb*1.55),_hov ? 1.0 : 0.80);
  gfx_rect(tx,ty,tw,1);
  gfx_rect(tx,ty+th-1,tw,1);
  _hov ? (
    gfx_set(0.88,0.94,1.0,0.24);
    gfx_rect(tx+1,ty+1,tw-2,th-2);
  );
  gfx_setfont(4,"Arial",max(7,min(fsz*0.58,th*0.58)),'b');
  gfx_set(0.90,0.96,1.0,1);
  gfx_measurestr(label,_tw,_th);
  gfx_x=tx+floor((tw-_tw)*0.5);
  gfx_y=ty+floor((th-_th)*0.5);
  gfx_drawstr(label);
);

function draw_quick_knob(label value tx ty tw th minv maxv active)
local(cx, cy, r, pct, ang_min, ang_max, ang, nx, ny, _tw, _th, _fs1, _fs2, _ow, _oh, _ox, _oy)
(
  cx=tx+tw*0.5;
  cy=ty+th*0.64;
  r=max(9,min(tw*0.18,th*0.23));
  pct=max(0,min(1,(value-minv)/max(0.0001,maxv-minv)));
  gfx_set(0.035,0.042,0.052,1);
  fill_roundrect(tx,ty,tw,th,4);
  gfx_set(0.16,0.50,0.92,active ? 0.44 : 0.18);
  gfx_rect(tx,ty,tw,1);
  gfx_rect(tx,ty+th-1,tw,1);
  active ? (
    gfx_set(0.34,0.96,0.72,0.16);
    gfx_circle(cx,cy,r+9,1,1);
  );
  gfx_set(0.055,0.066,0.078,1);
  gfx_circle(cx,cy,r,1,1);
  gfx_set(0.62,0.78,0.92,0.90);
  gfx_circle(cx,cy,r,0,1);
  ang_min=-2.356;
  ang_max=2.356;
  ang=ang_min+pct*(ang_max-ang_min);
  gfx_set(0.32,0.40,0.48,0.75);
  gfx_arc(cx,cy,r+5,ang_min,ang_max,2);
  gfx_set(0.48,0.98,0.78,1);
  gfx_arc(cx,cy,r+5,ang_min,ang,3);
  nx=cx+(r-2)*sin(ang);
  ny=cy-(r-2)*cos(ang);
  gfx_set(0.86,0.92,0.96,1);
  gfx_line(cx,cy,nx,ny,1);
  _fs1=max(8,min(fsz*0.54,th*0.22));
  _fs2=max(10,min(fsz*0.68,th*0.28));
  gfx_setfont(4,"Arial",_fs1,'b');
  gfx_set(0.58,0.70,0.78,0.95);
  gfx_measurestr(label,_tw,_th);
  gfx_x=tx+floor((tw-_tw)*0.5);
  gfx_y=ty+2;
  gfx_drawstr(label);
  active ? (
    gfx_setfont(4,"Arial",_fs2,'b');
    sprintf(#_qk_val,"%.1f",value);
    gfx_measurestr(#_qk_val,_tw,_th);
    _ow=_tw+20;
    _oh=_th+12;
    _ox=tx-_ow-7;
    _ox < 4 ? _ox=tx+tw+7;
    _oy=cy-_oh*0.5;
    gfx_set(0.94,0.97,0.92,0.96);
    fill_roundrect(_ox,_oy,_ow,_oh,3);
    gfx_set(0.48,0.98,0.78,0.95);
    gfx_rect(_ox,_oy,_ow,2);
    gfx_set(0.05,0.07,0.08,1);
    gfx_x=_ox+floor((_ow-_tw)*0.5);
    gfx_y=_oy+floor((_oh-_th)*0.5);
    gfx_drawstr(#_qk_val);
  );
);

function draw_tip_bar()
local(_tw, _th, _tx, _ty, _w, _h)
(
  tip_active ? (
    _h=max(24,min(36,fsz*1.50));
    _w=min(gfx_w-18,max(220,strlen(#tip_msg)*fsz*0.52));
    _tx=9;
    _ty=gfx_h-_h-6;
    gfx_set(0.045,0.052,0.060,0.96);
    fill_roundrect(_tx,_ty,_w,_h,5);
    gfx_set(0.16,0.50,0.92,0.50);
    gfx_rect(_tx,_ty,_w,1);
    gfx_rect(_tx,_ty+_h-1,_w,1);
    gfx_setfont(4,"Arial",max(10,fsz*0.65));
    gfx_set(0.78,0.88,0.94,0.98);
    gfx_measurestr(#tip_msg,_tw,_th);
    gfx_x=_tx+8;
    gfx_y=_ty+floor((_h-_th)*0.5);
    gfx_drawstr(#tip_msg);
  );
);

// Header v44: title, signature, quick menu and core readouts.
gfx_set(0.055,0.060,0.070,1);
gfx_rect(0,0,gfx_w,HDR_H);
gfx_set(0.16,0.50,0.92,0.95);
gfx_rect(0,0,gfx_w,3);
gfx_set(0.18,0.20,0.24,1);
gfx_rect(0,HDR_H-1,gfx_w,1);

#layout_lbl = "AUTO";
layout_mode == 1 ? #layout_lbl = "COMPACT";
layout_mode == 2 ? #layout_lbl = "STANDARD";
layout_mode == 3 ? #layout_lbl = "VERTICAL";
layout_mode == 4 ? #layout_lbl = "HORIZONTAL";
#zoom_lbl = "100%";
zoom_i <= 0 ? #zoom_lbl = "90%";
zoom_i == 2 ? #zoom_lbl = "115%";
zoom_i >= 3 ? #zoom_lbl = "130%";
chan_count < full_nch ? sprintf(#chan_lbl,"CH %d-%d/%d",chan_start+1,chan_start+chan_count,full_nch) : sprintf(#chan_lbl,"%d CH",full_nch);

_hdr_lufs_i = cfg_mono ? lufs_i_db-3 : lufs_i_db;
_hdr_lufs_s = cfg_mono ? lufs_s_db-3 : lufs_s_db;
_hdr_lufs_m = cfg_mono ? lufs_m_db-3 : lufs_m_db;
_hdr_tp = global_peak > 0 ? log(global_peak)*20/log(10) : -150;
_hdr_rms_m = cfg_mono ? rms_m_db-3 : rms_m_db;
_hdr_lufs_i > -99 ? sprintf(#hdr_i,"%+.1f",_hdr_lufs_i) : sprintf(#hdr_i,"--");
_hdr_lufs_s > -99 ? sprintf(#hdr_s,"%+.1f",_hdr_lufs_s) : sprintf(#hdr_s,"--");
_hdr_lufs_m > -99 ? sprintf(#hdr_m,"%+.1f",_hdr_lufs_m) : sprintf(#hdr_m,"--");
_hdr_tp > -149 ? sprintf(#hdr_tp,"%+.1f",_hdr_tp) : sprintf(#hdr_tp,"--");
_hdr_rms_m > -99 ? sprintf(#hdr_rms_m,"%+.1f",_hdr_rms_m) : sprintf(#hdr_rms_m,"--");
sprintf(#hdr_lra,"%.1f",lra_db_diff);

_hx=SB_W+10;
_hy=6;
_hw=max(40,gfx_w-SB_W-20);
_hdr_btn_h=max(22,min(30,HDR_H-12));
_hdr_btn_w=max(54,min(72,gfx_texth*4.4));
_hdr_gap=6;
_rst_w=max(62,min(86,gfx_texth*5.0));
_rst_x=SB_W+gfx_w-SB_W-10-_rst_w;
_menu_x=_rst_x-_hdr_btn_w-_hdr_gap;
_sum_w = (_menu_x-_hx) > 470 ? 258 : (_menu_x-_hx) > 340 ? 190 : 0;
_sum_x = _sum_w > 0 ? _menu_x-_sum_w-_hdr_gap : _menu_x;
_title_room=_sum_x-_hx-8;
_title_room < 90 ? #_top_title="ZP LM" :
_title_room < 330 ? #_top_title="ZP Loudness" :
                    #_top_title="ZP Loudness Meter Multichannel";

gfx_setfont(4,"Arial",max(16,min(fsz*0.90,HDR_H*0.42)),'b');
gfx_set(0.94,0.96,0.98,1);
gfx_x=_hx;
gfx_y=_hy+1;
gfx_drawstr(#_top_title);
_title_room > 150 ? (
  gfx_setfont(4,"Arial",max(11,min(fsz*0.64,HDR_H*0.28)),'b');
  gfx_set(0.50,0.66,0.92,1);
  gfx_x=_hx;
  gfx_y=_hy+max(20,gfx_texth+5);
  _title_room < 270 ? gfx_drawstr("v44 - di Paolo Balestri") :
                      gfx_drawstr("Loudness & Channel Meter | v44 - di Paolo Balestri");
);

_sum_w > 0 ? (
  gfx_set(0.040,0.046,0.056,1);
  fill_roundrect(_sum_x,_hy,_sum_w,_hdr_btn_h,4);
  gfx_set(0.16,0.50,0.92,0.28);
  gfx_rect(_sum_x,_hy,_sum_w,1);
  gfx_setfont(4,"Arial",max(10,min(fsz*0.66,_hdr_btn_h*0.46)),'b');
  gfx_set(0.72,0.84,0.92,0.98);
  sprintf(#_top_sum1,"TP red %.1f  LU red %.1f",cfg_tp_red,cfg_lufs_red);
  gfx_x=_sum_x+7; gfx_y=_hy+3; gfx_drawstr(#_top_sum1);
  gfx_setfont(4,"Arial",max(10,min(fsz*0.62,_hdr_btn_h*0.42)));
  cfg_clip_reset_stop ? #_arst="AutoRST on" : #_arst="AutoRST off";
  cfg_meter_response < 0.32 ? #_rsp="Fast" : cfg_meter_response < 1.05 ? #_rsp="Mid" : #_rsp="Slow";
  sprintf(#_top_sum2,"%s  |  %s",#_arst,#_rsp);
  gfx_set(0.68,0.78,0.86,1);
  gfx_x=_sum_x+7; gfx_y=_hy+_hdr_btn_h-gfx_texth-1; gfx_drawstr(#_top_sum2);
  chip_hit(_sum_x,_hy,_sum_w,_hdr_btn_h) ? (
    tip_active=1;
    #tip_msg="Soglie colore: TP regola il rosso dei meter, LU regola gli avvisi loudness. Il giallo occupa 4 segmenti prima del rosso.";
  );
);
draw_chip("MENU",_menu_x,_hy,_hdr_btn_w,_hdr_btn_h,cfg_sidebar);
chip_hit(_menu_x,_hy,_hdr_btn_w,_hdr_btn_h) ? (
  tip_active=1;
  #tip_msg="MENU: apre i controlli rapidi senza cambiare la vista AUTO.";
);
has_click && chip_hit(_menu_x,_hy,_hdr_btn_w,_hdr_btn_h) ? (
  cfg_sidebar=!cfg_sidebar;
  slider_automate(1<<22);
  has_click=0;
);

_rst_hover=chip_hit(_rst_x,_hy,_rst_w,_hdr_btn_h);
_rst_hover ? (
  tip_active=1;
  #tip_msg="RESET: click breve azzera le misure. Tieni premuto 0,5 s per attivare o disattivare autoreset allo stop.";
);
cfg_clip_reset_stop ? gfx_set(0.22,0.31,0.16,1) : gfx_set(0.25,0.10,0.10,1);
_rst_hover ? gfx_set(0.42,0.16,0.14,1);
gfx_rect(_rst_x,_hy,_rst_w,_hdr_btn_h);
cfg_clip_reset_stop ? gfx_set(0.62,0.88,0.46,0.90) : gfx_set(0.86,0.28,0.24,0.80);
gfx_rect(_rst_x,_hy,_rst_w,1);
gfx_rect(_rst_x,_hy+_hdr_btn_h-1,_rst_w,1);
gfx_setfont(4,"Arial",max(8,min(fsz*0.56,_hdr_btn_h*0.58)),'b');
gfx_set(0.96,0.82,0.78,1);
gfx_measurestr("RESET",_tw,_th);
gfx_x=_rst_x+floor((_rst_w-_tw)*0.5);
gfx_y=_hy+floor((_hdr_btn_h-_th)*0.5);
gfx_drawstr("RESET");
cfg_clip_reset_stop ? (
  gfx_setfont(4,"Arial",max(6,min(fsz*0.36,_hdr_btn_h*0.36)),'b');
  gfx_set(0.72,0.96,0.58,0.98);
  gfx_x=_rst_x+4;
  gfx_y=_hy+_hdr_btn_h-gfx_texth-1;
  gfx_drawstr("AUTO");
);
has_click && _rst_hover ? (
  reset_pressing=1;
  reset_press_t=t;
  reset_long_done=0;
  has_click=0;
);
reset_pressing && (mouse_cap&1) ? (
  !reset_long_done && t-reset_press_t >= 0.5 ? (
    cfg_clip_reset_stop=!cfg_clip_reset_stop;
    slider_automate(1<<19);
    reset_long_done=1;
  );
);
reset_pressing && !(mouse_cap&1) ? (
  !reset_long_done ? Reset();
  reset_pressing=0;
);
gfx_setfont(1,"Arial",fsz);

want_vu ? (
  set_color(GRID_COLOR);

  ty0=draw_grid(0,-1,-1);
  ty12=draw_grid(-12,-1,-1);
  ty24=draw_grid(-24,-1,-1);
  ty48=draw_grid(-48,-1,-1);

  ty6=draw_grid(-6,ty0,ty12);
  ty18=draw_grid(-18,ty12,ty24);
  ty36=draw_grid(-36,ty24,ty48);
  ty60=draw_grid(-60,ty48,0);

  ty3=draw_grid(-3,ty0,ty6 >= 0 ? ty6 : ty12);
  ty30=draw_grid(-30,ty24,ty36 >= 0 ? ty36 : ty24);
  ty42=draw_grid(-42,ty36 >= 0 ? ty36 : ty24,ty48);

  set_color(TEXT_COLOR);
  gfx_line(xl,y0,gfx_w-xr,y0);
);

// ---- Linea di riferimento 1 ----
cfg_ref1_show && cfg_ref1_db > -72 ? (
  rl_th = scale_db1(cfg_ref1_db)*vh;
  rl_y = (y0-rl_th)|0;
  cfg_ref1_color==0 ? set_color(TEXT_COLOR) :
  cfg_ref1_color==1 ? set_color(MONO_COLOR) :
                      set_color(LUFS_COLOR);
  gfx_a=0.9;
  gfx_line(xl,rl_y,gfx_w-xr,rl_y);
  gfx_line(xl,rl_y+1,gfx_w-xr,rl_y+1);
  gfx_a=0.75;
  sprintf(#rl1,"%+.0f",cfg_ref1_db);
  gfx_x=xl+2; gfx_y=rl_y-gfx_texth;
  gfx_drawstr(#rl1,1,xl+30,rl_y);
  gfx_a=1;
);
// ---- Linea di riferimento 2 ----
cfg_ref2_show && cfg_ref2_db > -72 ? (
  rl_th = scale_db1(cfg_ref2_db)*vh;
  rl_y = (y0-rl_th)|0;
  cfg_ref2_color==0 ? set_color(TEXT_COLOR) :
  cfg_ref2_color==1 ? set_color(MONO_COLOR) :
                      set_color(LUFS_COLOR);
  gfx_a=0.9;
  gfx_line(xl,rl_y,gfx_w-xr,rl_y);
  gfx_line(xl,rl_y+1,gfx_w-xr,rl_y+1);
  gfx_a=0.75;
  sprintf(#rl2,"%+.0f",cfg_ref2_db);
  gfx_x=xl+2; gfx_y=rl_y-gfx_texth;
  gfx_drawstr(#rl2,1,xl+30,rl_y);
  gfx_a=1;
);


// ============================================================
// DRAW METERS
// ============================================================

want_lufs_i ? (
  want_capt ? (
    set_color(TEXT_COLOR);
    draw_str(!want_abbr ? "LUFS-I" : "L-I",x,yt,5);
  );
  lufs_a_sum > 0 ? (
    lufs_i_db > -100 ? (
      db = cfg_mono ? lufs_i_db-3 : lufs_i_db;
      want_vu ? (
        th_lufs_i += (scale_db1(db)-th_lufs_i)*speed;
        th=(vh*th_lufs_i)|0;
        set_alert_color(db,LUFS_COLOR);
        gfx_rect(x-colw/4,y0-th,colw/2,th);
      );
      set_text_alert_color(db);
      draw_str(format_dbv(db),x,ylo,5);
    );
  );
  x -= colw;
);

want_lra ? (
  want_capt ? (
    set_color(TEXT_COLOR);
    draw_str("LRA",x+colw/4,yt,5);
  );
  lra_db_diff > 0 ? (
    want_vu ? (
      dblo = cfg_mono ? lra_db_lo-3 : lra_db_lo;
      dbhi = cfg_mono ? lra_db_hi-3 : lra_db_hi;
      th_lo=(scale_db1(dblo)*vh)|0;
      th_hi=(scale_db1(dbhi)*vh)|0;
      set_color(LUFS_COLOR);
      gfx_rect(x+colw*3/32,y0-th_hi,colw*5/16,rsz);
      gfx_rect(x+colw*3/32,y0-th_lo,colw*5/16,rsz);
      gfx_rect(x+colw*9/32,y0-th_hi,colw/8,th_hi-th_lo+rsz);
    );
    set_color(TEXT_COLOR);
    draw_str(sprintf(#,"%.1f",lra_db_diff + 0.01),x+colw/4,ylo,5);
  );

  x -= colw/2;
);

want_lufs_s ? (
  want_capt ? (
    set_color(TEXT_COLOR);
    draw_str(!want_abbr ? "LUFS-S" : "L-S",x,yt,5);
  );
  lufs_s_db > -100 ? (
    db = cfg_mono ? lufs_s_db-3 : lufs_s_db;
    want_vu ? (
      th_lufs_s += (scale_db1(db)-th_lufs_s)*speed;
      th=(vh*th_lufs_s)|0;
      set_alert_color(db,LUFS_COLOR);
      gfx_rect(x-colw/4,y0-th,colw/2,th);
    );
    set_text_alert_color(db);
    draw_str(format_dbv(db),x,ylo,5);
  );
  lufs_s_sum_max > 0 ? (
    db=-0.691+log(lufs_s_sum_max)*10/log(10);
    cfg_mono ? db -= 3;
    want_vu ? (
      set_alert_color(db,LUFS_COLOR);
      gfx_rect(x-colw/4,y0-scale_db1(db)*vh,colw/2,rsz);
    );
    want_max ? (
      set_text_alert_color(db);
      draw_str(format_dbv(db),x,yhi,5);
    );
  );
  x -= colw;
);

want_lufs_m ? (
  want_capt ? (
    set_color(TEXT_COLOR);
    draw_str(!want_abbr ? "LUFS-M" : "L-M",x,yt,5);
  );
  lufs_m_db > -100 ? (
    db = cfg_mono ? lufs_m_db-3 : lufs_m_db;
    want_vu ? (
      th_lufs_m += (scale_db1(db)-th_lufs_m)*speed;
      th=(vh*th_lufs_m)|0;
      set_alert_color(db,LUFS_COLOR);
      gfx_rect(x-colw/4,y0-th,colw/2,th);
    );
    set_text_alert_color(db);
    draw_str(format_dbv(db),x,ylo,5);
  );
  lufs_m_sum_max > 0 ? (
    db=-0.691+log(lufs_m_sum_max)*10/log(10);
    cfg_mono ? db -= 3;
    want_vu ? (
      set_alert_color(db,LUFS_COLOR);
      gfx_rect(x-colw/4,y0-scale_db1(db)*vh,colw/2,rsz);
    );
    want_max ? (
      set_text_alert_color(db);
      draw_str(format_dbv(db),x,yhi,5);
    );
  );
  cfg_lufs_m == 2 && want_vu && db_hist_max > 0 ? (
    set_color(LUFS_HIST_COLOR);
    txlo=x-colw/4-3;
    txhi=x+colw/4+2;
    maxtw=colw/4-2;
    lasty=lasttw=0;
    d=cnt=0;
    loop(75,
      db = cfg_mono ? d-70-3 : d-70;
      y=scale_db1(db-0.5)*vh;
      y > lasty ? (
        tw=(cnt/db_hist_max*maxtw)|0;
        tw > 0 || lasttw > 0 ? (
          draw_histogram(txlo,txhi,lasty,lasttw,y,tw);
        );
        lasty=y;
        lasttw=tw;
        cnt=0;
      );
      cnt += db_hist[d];
      d += 1;
    );
  );
  x -= colw;
);

want_rms_i ? (
  want_capt ? (
    set_color(TEXT_COLOR);
    draw_str(!want_abbr ? "RMS-I" : "R-I",x,yt,5);
  );
  rms_i_db > -100 ? (
    db = cfg_mono ? rms_i_db-3 : rms_i_db;
    want_vu ? (
      th_rms_i += (scale_db1(db)-th_rms_i)*speed;
      th=(vh*th_rms_i)|0;
      set_color(RMS_COLOR);
      gfx_rect(x-colw/4,y0-th,colw/2,th);
    );
    set_color(TEXT_COLOR);
    draw_str(format_dbv(db),x,ylo,5);
  );
  x -= colw;
);

want_rms_m ? (
  want_capt ? (
    set_color(TEXT_COLOR);
    draw_str(!want_abbr ? "RMS-M" : "R-M",x,yt,5);
  );
  rms_m_db > -100 ? (
    db = cfg_mono ? rms_m_db-3 : rms_m_db;
    want_vu ? (
      th_rms_m += (scale_db1(db)-th_rms_m)*speed;
      th=(vh*th_rms_m)|0;
      set_color(RMS_COLOR);
      gfx_rect(x-colw/4,y0-th,colw/2,th);
    );
    set_color(TEXT_COLOR);
    draw_str(format_dbv(db),x,ylo,5);
  );
  rms_m_db_max > -100 ? (
    db = cfg_mono ? rms_m_db_max-3 : rms_m_db_max;
    want_vu ? (
      set_color(RMS_COLOR);
      gfx_rect(x-colw/4,y0-scale_db1(db)*vh,colw/2,rsz);
    );
    want_max ? (
      set_color(TEXT_COLOR);
      draw_str(format_dbv(db),x,yhi,5);
    );
  );
  x -= colw;
);

// ---- PEAK / CLIP ----
want_peak ? (
  // Coordinate zona nomi: riga sopra "Peak Clips"
  nm_h = gfx_texth + 4;
  nm_y = yt - nm_h - 2;  // sopra l'etichetta tipo

  want_capt ? (
    set_color(GRID_COLOR);
    // label tipo peak rimosso (sovrappone la bottom bar)
  );

  disp_ch=nch-1;
  loop(nch,
    ch=chan_start+disp_ch;
    // Clip state
    clips = clip_cnt[ch];
    clip_age = cfg_clip_decay > 0 && clip_decay_t_arr[ch] > 0 ?
                 t - clip_decay_t_arr[ch] : 0;
    clip_visible = cfg_clip_decay <= 0 || clip_age < cfg_clip_decay;
    has_clips = clips > 0 && clip_visible;
    _pk_hold_alpha=1;

    // VU bar
    pk[ch] > 0 ? (
      pv=pk[ch];
      want_vu ? (
        th=(vh*scale_v(pv))|0;
        set_color(PEAK_COLOR);
        gfx_rect(x-colw/4,y0-th,colw/2,th);
      );
      cfg_peak == 1 || cfg_peak == 3 ? (
        peak_age = cfg_clip_decay > 0 && peak_hold_t[ch] > 0 ?
                     t - peak_hold_t[ch] : 0;
        peak_show = cfg_clip_decay <= 0 || peak_age < cfg_clip_decay || peak_hold_val[ch] <= 0;
        peak_disp_v = cfg_clip_decay > 0 ? peak_hold_val[ch] : pv;
        cfg_clip_decay > 0 && peak_age > 0 ?
          _pk_hold_alpha = max(0.15, 1.0 - peak_age/max(cfg_clip_decay,0.001)) : _pk_hold_alpha=1;
      );
      // ---- Valori dB in cima alla barra: MAX (hold) + NOW (attuale) ----
      want_max ? (
        gfx_setfont(2,"Arial",fsz*0.85);
        _pk_db = log(pv)*20/log(10);
        _pk_sm = peak_now_db_disp[ch];
        _pk_alpha_up = min(1, speed*2.0 + 0.12); // salita sempre reattiva
        _pk_alpha_dn = cfg_peak_now_hold <= 0 ? _pk_alpha_up :
                       (1.0 - pow(0.5, draw_dt/max(0.001,cfg_peak_now_hold)));
        _pk_db >= _pk_sm ?
          _pk_sm += (_pk_db - _pk_sm) * _pk_alpha_up :
          _pk_sm += (_pk_db - _pk_sm) * _pk_alpha_dn;
        peak_now_db_disp[ch] = _pk_sm;
        _pk_dx = max(7, colw*0.18);
        _pk_disp_v = cfg_clip_decay > 0 ? peak_hold_val[ch] : hipk[ch];
        _pk_disp_v > 0 ? (
          _pk_hold_db = log(_pk_disp_v)*20/log(10);
          set_color(_pk_hold_db > 0 ? PEAK_CLIP_COLOR : PEAK_COLOR);
          gfx_a=_pk_hold_alpha;
          draw_str(format_dbv(_pk_hold_db), x-_pk_dx, yhi, 5);
          gfx_a=1;
        );
        set_color(PEAK_NOW_COLOR);
        draw_str(format_dbv(_pk_sm), x+_pk_dx, yhi, 5);
        gfx_setfont(1,"Arial",fsz);
      );
    );
    hipk[ch] > 0 ? (
      hv=hipk[ch];
      want_vu ? (
        set_color(hv > 1 ? PEAK_CLIP_COLOR : PEAK_COLOR);
        gfx_a=_pk_hold_alpha;
        gfx_rect(x-colw/4,y0-vh*scale_v(hv),colw/2,rsz);
        gfx_a=1;
      );
    );

    // ---- Numero canale in fondo (ylo): rosso se clip + label "CH" sopra ----
    want_capt ? (
      gfx_setfont(2,"Arial",fsz*0.85);
      set_color(has_clips ? PEAK_CLIP_COLOR : PEAK_COLOR);
      draw_str(sprintf(#_num,"%d",ch+1), x, ylo - gfx_texth/2, 5);
      // "CH" sopra il numero, in grigio dimmed
      set_color(GRID_COLOR);
      draw_str("CH", x, ylo - gfx_texth*2, 5);
      gfx_setfont(1,"Arial",fsz);
    );
    x -= colw;
    disp_ch -= 1;
  );
);

// Beta11 alternate view: Channel Overview as the main workspace, with quick controls in the header/rail.
use_alt_view ? (
  _view_x=SB_W;
  _view_y=HDR_H;
  _view_w=gfx_w-SB_W;
  _view_h=gfx_h-HDR_H;
  gfx_set(0.025,0.028,0.034,1);
  gfx_rect(_view_x,_view_y,_view_w,_view_h);
  gfx_set(0.16,0.50,0.92,0.32);
  gfx_rect(_view_x,_view_y,_view_w,1);
  gfx_rect(_view_x,_view_y+_view_h-1,_view_w,1);

  _rail_w = cfg_sidebar ? max(88,min(118,gfx_texth*7.0)) : 0;
  _pad = 8;
  _gap = 8;
  _content_x = _view_x + _pad;
  _content_y = _view_y + _pad;
  _content_w = max(40,_view_w - _rail_w - _pad*(cfg_sidebar ? 3 : 2));
  _content_h = max(40,_view_h - _pad*2);

  _show_meas = cfg_show_measure_block && _content_w >= 285;
  _measure_w = _show_meas ? max(126,min(186,floor(_content_w*0.28))) : 0;
  _ch_x = _content_x + (_show_meas ? _measure_w + _gap : 0);
  _ch_y = _content_y;
  _ch_w = _content_w - (_show_meas ? _measure_w + _gap : 0);
  _ch_h = _content_h;

  _show_meas ? (
    chip_hit(_content_x,_content_y,_measure_w,_content_h) ? (
      tip_active=1;
      #tip_msg="MEASURE: riepilogo LUFS, LRA, True Peak e RMS momentary. Il colore segue le soglie LU/TP impostate.";
    );
    gfx_set(0.045,0.052,0.064,1);
    gfx_rect(_content_x,_content_y,_measure_w,_content_h);
    gfx_set(0.16,0.50,0.92,0.22);
    gfx_rect(_content_x,_content_y,_measure_w,1);
    gfx_rect(_content_x+_measure_w-1,_content_y,1,_content_h);
    gfx_setfont(4,"Arial",max(8,fsz*0.62),'b');
    gfx_set(0.48,0.58,0.66,0.95);
    gfx_x=_content_x+7; gfx_y=_content_y+6; gfx_drawstr("MEASURE");

    _hb_gap=max(4,floor(gfx_texth*0.28));
    _hb_h=max(19,min(34,floor((_content_h-gfx_texth-22-_hb_gap*5)/6)));
    _hb_y=_content_y+gfx_texth+15;
    _hb_w=_measure_w-14;
    _li_red=_hdr_lufs_i >= cfg_lufs_red;
    _li_yel=!_li_red && _hdr_lufs_i >= cfg_lufs_red - cfg_lufs_yellow_margin;
    _li_red ? (_lr=0.92; _lg=0.12; _lb=0.12;) : _li_yel ? (_lr=0.94; _lg=0.76; _lb=0.20;) : (_lr=0.18; _lg=0.50; _lb=0.90;);
    draw_hbar("LUFS-I",#hdr_i,_content_x+7,_hb_y,_hb_w,_hb_h,(_hdr_lufs_i+60)/60,_lr,_lg,_lb);
    _ls_red=_hdr_lufs_s >= cfg_lufs_red;
    _ls_yel=!_ls_red && _hdr_lufs_s >= cfg_lufs_red - cfg_lufs_yellow_margin;
    _ls_red ? (_lr=0.92; _lg=0.12; _lb=0.12;) : _ls_yel ? (_lr=0.94; _lg=0.76; _lb=0.20;) : (_lr=0.18; _lg=0.50; _lb=0.90;);
    draw_hbar("LUFS-S",#hdr_s,_content_x+7,_hb_y+(_hb_h+_hb_gap),_hb_w,_hb_h,(_hdr_lufs_s+60)/60,_lr,_lg,_lb);
    _lm_red=_hdr_lufs_m >= cfg_lufs_red;
    _lm_yel=!_lm_red && _hdr_lufs_m >= cfg_lufs_red - cfg_lufs_yellow_margin;
    _lm_red ? (_lr=0.92; _lg=0.12; _lb=0.12;) : _lm_yel ? (_lr=0.94; _lg=0.76; _lb=0.20;) : (_lr=0.22; _lg=0.72; _lb=0.98;);
    draw_hbar("LUFS-M",#hdr_m,_content_x+7,_hb_y+(_hb_h+_hb_gap)*2,_hb_w,_hb_h,(_hdr_lufs_m+60)/60,_lr,_lg,_lb);
    draw_hbar("LRA",#hdr_lra,_content_x+7,_hb_y+(_hb_h+_hb_gap)*3,_hb_w,_hb_h,min(1,lra_db_diff/24),0.92,0.76,0.28);
    draw_hbar("TRUE PK",#hdr_tp,_content_x+7,_hb_y+(_hb_h+_hb_gap)*4,_hb_w,_hb_h,(_hdr_tp+60)/60,0.16,0.80,0.36);
    draw_hbar("RMS-M",#hdr_rms_m,_content_x+7,_hb_y+(_hb_h+_hb_gap)*5,_hb_w,_hb_h,(_hdr_rms_m+60)/60,0.52,0.56,0.62);

  );

  gfx_set(0.060,0.068,0.080,1);
  gfx_rect(_ch_x,_ch_y,_ch_w,_ch_h);
  chip_hit(_ch_x,_ch_y,_ch_w,_ch_h) ? (
    tip_active=1;
    #tip_msg="CHANNEL OVERVIEW: livelli canale live. Scala verde, 4 segmenti gialli di preallarme, rosso alla soglia TP.";
  );
  gfx_set(0.16,0.50,0.92,0.25);
  gfx_rect(_ch_x,_ch_y,_ch_w,1);
  gfx_rect(_ch_x,_ch_y+_ch_h-1,_ch_w,1);

  _main_fs=max(9,fsz*0.72);
  _desc_fs=max(8,_main_fs*0.90);
  _num_fs=max(10,fsz*0.86);
  gfx_setfont(4,"Arial",_main_fs,'b');
  gfx_set(0.54,0.66,0.74,0.98);
  gfx_x=_ch_x+9; gfx_y=_ch_y+7; gfx_drawstr("CHANNEL OVERVIEW");
  gfx_setfont(4,"Arial",_desc_fs,'b');
  gfx_set(0.38,0.46,0.52,0.92);
  gfx_x=_ch_x+9; gfx_y=_ch_y+gfx_texth+7; gfx_drawstr(#chan_lbl);

  gfx_setfont(4,"Arial",_desc_fs,'b');
  gfx_set(0.70,0.86,0.74,0.95);
  sprintf(#_tp_head,"TP %s",#hdr_tp);
  gfx_measurestr(#_tp_head,_tw,_th);
  gfx_x=_ch_x+_ch_w-_tw-10; gfx_y=_ch_y+7; gfx_drawstr(#_tp_head);

  _meter_top=_ch_y+max(42,gfx_texth*2.6);
  _meter_bot=_ch_y+_ch_h-max(22,gfx_texth*1.8);
  _meter_h=max(20,_meter_bot-_meter_top);
  _axis_w=max(32,min(48,gfx_texth*2.8));
  _meter_area_x=_ch_x+_axis_w;
  _meter_area_w=max(40,_ch_w-_axis_w-10);
  _meter_gap=max(2,min(8,floor(_meter_area_w/(chan_count*18+1))));
  _meter_w=max(8,min(92,floor((_meter_area_w-24-(chan_count-1)*_meter_gap)/chan_count)));
  _meter_total=chan_count*_meter_w+(chan_count-1)*_meter_gap;
  _meter_x0=_meter_area_x+floor((_meter_area_w-_meter_total)*0.5);

  gfx_set(1,1,1,0.055);
  _gy=0;
  loop(5,
    _grid_y=_meter_top+floor(_meter_h*_gy/4);
    gfx_rect(_meter_area_x,_grid_y,_ch_x+_ch_w-_meter_area_x-8,1);
    _gy += 1;
  );
  gfx_setfont(4,"Arial",_desc_fs);
  gfx_set(0.42,0.50,0.58,0.95);
  _ai=0;
  loop(6,
    _axis_db=-60+_ai*12;
    _axis_y=_meter_top+_meter_h-floor(((_axis_db+60)/66)*_meter_h);
    sprintf(#_axis_lbl,"%+.0f",_axis_db);
    gfx_measurestr(#_axis_lbl,_tw,_th);
    gfx_x=_ch_x+_axis_w-_tw-8;
    gfx_y=_axis_y-floor(_th*0.5);
    gfx_drawstr(#_axis_lbl);
    _ai += 1;
  );

  _ci=0;
  loop(chan_count,
    _ch=chan_start+_ci;
    _bar_x=_meter_x0+_ci*(_meter_w+_meter_gap);
    _pv=pk[_ch];
    _cur_db=_pv > 0 ? log(_pv)*20/log(10) : -150;
    _clip=clip_cnt[_ch] > 0;

    gfx_set(0.095,0.112,0.140,1);
    gfx_rect(_bar_x,_meter_top,_meter_w,_meter_h);
    _seg_n=max(10,min(30,floor(_meter_h/5)));
    _seg_gap=1;
    _seg_h=max(1,floor((_meter_h-(_seg_n-1)*_seg_gap)/_seg_n));
    _seg_step=66/max(1,_seg_n-1);
    _si=0;
    loop(_seg_n,
      _seg_db=-60.0+(_si/max(1,_seg_n-1))*66.0;
      _lit=_cur_db >= _seg_db;
      _seg_db >= cfg_tp_red ? (_sr=0.92; _sg=0.12; _sb=0.12;) :
      _seg_db >= cfg_tp_red - _seg_step*4.25 ? (_sr=0.94; _sg=0.76; _sb=0.20;) :
                                              (_sr=0.18; _sg=0.90; _sb=0.34;);
      gfx_set(_sr*(_lit ? 1.0 : 0.16),_sg*(_lit ? 1.0 : 0.16),_sb*(_lit ? 1.0 : 0.16),_lit ? 0.96 : 0.34);
      _seg_y=_meter_top+_meter_h-(_si+1)*(_seg_h+_seg_gap)+_seg_gap;
      gfx_rect(_bar_x,_seg_y,_meter_w,_seg_h);
      _si += 1;
    );
    gfx_set(0,0,0,0.28);
    gfx_rect(_bar_x+floor(_meter_w*0.5),_meter_top,1,_meter_h);
    _clip ? (
      gfx_set(1.0,0.12,0.10,1);
      gfx_rect(_bar_x,_meter_top-4,_meter_w,3);
    );

    gfx_setfont(4,"Arial",_num_fs,'b');
    _cur_db > -149 ? sprintf(#_tp_ch,"%.1f",_cur_db) : #_tp_ch="--";
    _cur_db >= cfg_tp_red ? gfx_set(1.0,0.62,0.58,1) :
    _cur_db >= cfg_tp_red - _seg_step*4.25 ? gfx_set(1.0,0.86,0.45,1) :
                                            gfx_set(0.78,0.88,0.82,0.95);
    gfx_measurestr(#_tp_ch,_tw,_th);
    gfx_x=_bar_x+floor((_meter_w-_tw)*0.5); gfx_y=_meter_top-_th-4; gfx_drawstr(#_tp_ch);

    gfx_setfont(4,"Arial",_desc_fs);
    gfx_set(0.55,0.62,0.68,0.92);
    sprintf(#_ch_num,"%d",_ch+1);
    gfx_measurestr(#_ch_num,_tw,_th);
    gfx_x=_bar_x+floor((_meter_w-_tw)*0.5); gfx_y=_meter_top+_meter_h+5; gfx_drawstr(#_ch_num);
    _ci += 1;
  );

  cfg_sidebar ? (
    _rail_x=_view_x+_view_w-_rail_w-_pad;
    _rail_y=_view_y+_pad;
    _rail_h=_view_h-_pad*2;
    gfx_set(0.040,0.046,0.056,1);
    gfx_rect(_rail_x,_rail_y,_rail_w,_rail_h);
    gfx_set(0.16,0.50,0.92,0.22);
    gfx_rect(_rail_x,_rail_y,1,_rail_h);

    _rail_gap=_rail_h < 380 ? 3 : 6;
    _rail_btn_h=max(18,min(24,gfx_texth+6));
    _knob_h=max(34,min(48,floor((_rail_h-_rail_btn_h*6-_rail_gap*8-18)/2)));
    _rb_y=_rail_y+7;
    draw_chip("MEASURE",_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h,cfg_show_measure_block);
    chip_hit(_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h) ? (tip_active=1; #tip_msg="MEAS: mostra o nasconde il blocco LUFS/LRA/True Peak a sinistra.";);
    has_click && chip_hit(_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h) ? (cfg_show_measure_block=!cfg_show_measure_block; slider_automate(1<<41); has_click=0;);
    _rb_y += _rail_btn_h+_rail_gap+18;

    _k_x=_rail_x+6;
    _k_w=_rail_w-12;
    _tp_cx=_k_x+_k_w*0.5;
    _tp_cy=_rb_y+_knob_h*0.60;
    _tp_r=max(11,min(_k_w*0.36,_knob_h*0.34));
    _tp_hover=chip_hit(_k_x,_rb_y,_k_w,_knob_h);
    _tp_hover || quick_knob==37 ? (tip_active=1; #tip_msg="TP RED: soglia dove i meter canale diventano rossi. Trascina su/giu' per regolare, Shift per fine, doppio click per scrivere.";);
    has_click && _tp_hover ? (
      t-last_click_t2 < 0.70 && last_click_target2==37 ? (
        ref_edit=7; sprintf(#ref_edit_buf,"%.1f",cfg_tp_red); quick_knob=0; last_click_t2=0;
      ) : (
        quick_knob=37; quick_knob_y0=mouse_y; quick_knob_v0=cfg_tp_red;
        last_click_t2=t; last_click_target2=37;
      );
      has_click=0;
    );
    quick_knob==37 && (mouse_cap&1) ? (
      _fine = (mouse_cap&8) ? 0.25 : 1.0;
      cfg_tp_red=max(-12,min(0,quick_knob_v0+(quick_knob_y0-mouse_y)*12/150*_fine));
    );
    draw_quick_knob("TP RED",cfg_tp_red,_k_x,_rb_y,_k_w,_knob_h,-12,0,quick_knob==37 || _tp_hover);
    _rb_y += _knob_h+_rail_gap;

    _lu_cx=_k_x+_k_w*0.5;
    _lu_cy=_rb_y+_knob_h*0.60;
    _lu_r=max(11,min(_k_w*0.36,_knob_h*0.34));
    _lu_hover=chip_hit(_k_x,_rb_y,_k_w,_knob_h);
    _lu_hover || quick_knob==39 ? (tip_active=1; #tip_msg="LU RED: soglia di avviso loudness per LUFS-I, LUFS-S e LUFS-M. Shift per fine, doppio click per scrivere.";);
    has_click && _lu_hover ? (
      t-last_click_t2 < 0.70 && last_click_target2==39 ? (
        ref_edit=8; sprintf(#ref_edit_buf,"%.1f",cfg_lufs_red); quick_knob=0; last_click_t2=0;
      ) : (
        quick_knob=39; quick_knob_y0=mouse_y; quick_knob_v0=cfg_lufs_red;
        last_click_t2=t; last_click_target2=39;
      );
      has_click=0;
    );
    quick_knob==39 && (mouse_cap&1) ? (
      _fine = (mouse_cap&8) ? 0.25 : 1.0;
      cfg_lufs_red=max(-40,min(0,quick_knob_v0+(quick_knob_y0-mouse_y)*40/180*_fine));
    );
    draw_quick_knob("LU RED",cfg_lufs_red,_k_x,_rb_y,_k_w,_knob_h,-40,0,quick_knob==39 || _lu_hover);
    _rb_y += _knob_h+_rail_gap;

    cfg_meter_response < 0.32 ? #_resp_lbl="FAST" : cfg_meter_response < 1.05 ? #_resp_lbl="MID" : #_resp_lbl="SLOW";
    cfg_meter_response < 0.32 ? draw_color_chip(#_resp_lbl,_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h,0.34,0.12,0.50) :
    cfg_meter_response < 1.05 ? draw_color_chip(#_resp_lbl,_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h,0.12,0.30,0.56) :
                                draw_color_chip(#_resp_lbl,_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h,0.06,0.14,0.30);
    chip_hit(_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h) ? (tip_active=1; #tip_msg="Risposta meter: FAST e' piu' chirurgico, SLOW e' piu' medio/leggibile.";);
    has_click && chip_hit(_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h) ? (
      cfg_meter_response < 0.32 ? cfg_meter_response=0.65 :
      cfg_meter_response < 1.05 ? cfg_meter_response=1.25 :
      cfg_meter_response=0.20;
      slider_automate(1<<40);
      has_click=0;
    );
    _rb_y += _rail_btn_h+_rail_gap;
    draw_chip(cfg_reinit ? "PLAY" : "NO PL",_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h,cfg_reinit);
    chip_hit(_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h) ? (tip_active=1; #tip_msg="PLAY: reset automatico quando riparte il playback.";);
    has_click && chip_hit(_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h) ? (cfg_reinit=!cfg_reinit; slider_automate(1<<10); has_click=0;);
    _rb_y += _rail_btn_h+_rail_gap;
    draw_chip(cfg_mono ? "MONO" : "ST",_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h,cfg_mono);
    chip_hit(_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h) ? (tip_active=1; #tip_msg="MONO/ST: forza l'analisi mono o usa i canali reali.";);
    has_click && chip_hit(_rail_x+5,_rb_y,_rail_w-10,_rail_btn_h) ? (cfg_mono=!cfg_mono; slider_automate(1<<11); has_click=0;);
  );
  !(mouse_cap&1) && quick_knob > 0 ? (
    quick_knob==37 ? slider_automate(1<<36);
    quick_knob==39 ? slider_automate(1<<38);
    quick_knob=0;
  );

  gfx_setfont(1,"Arial",fsz);
);


// ============================================================
// KEYBOARD INPUT — ref_edit (1=L1 2=L2 3=Decay 4=Yellow 5=Red 6=PeakNOWhold 7=TP red 8=LU red)
// ============================================================
k_raw = gfx_getchar();
while (k_raw > 0) (
  ref_edit > 0 ? (
    k_raw == 13 || k_raw == 27 ? (
      k_raw == 13 && strlen(#ref_edit_buf) > 0 ? (
        match("%f", #ref_edit_buf, ref_parsed) <= 0 ? ref_parsed = 0;
        ref_edit==1 ? cfg_ref1_db  = max(-72, min(0,  ref_parsed));
        ref_edit==2 ? cfg_ref2_db  = max(-72, min(0,  ref_parsed));
        ref_edit==3 ? cfg_clip_decay = max(0,  min(30, ref_parsed));
        ref_edit==4 ? cfg_yellow   = max(-60, min(0,  ref_parsed));
        ref_edit==5 ? cfg_red      = max(-60, min(0,  ref_parsed));
        ref_edit==6 ? cfg_peak_now_hold = max(0,  min(3, ref_parsed));
        ref_edit==7 ? (cfg_tp_red = max(-12, min(0, ref_parsed)); slider_automate(1<<36););
        ref_edit==8 ? (cfg_lufs_red = max(-40, min(0, ref_parsed)); slider_automate(1<<38););
      );
      ref_edit=0; #ref_edit_buf="";
    ) :
    (k_raw == 8 || k_raw == 127 || k_raw == 6579564) ? (
      ref_buf_len = strlen(#ref_edit_buf);
      ref_buf_len > 0 ? str_setchar(#ref_edit_buf, ref_buf_len-1, 0);
    ) :
    ((k_raw >= 48 && k_raw <= 57) || k_raw == 45 || k_raw == 46) ? (
      strlen(#ref_edit_buf) < 7 ? str_setchar(#ref_edit_buf, strlen(#ref_edit_buf), k_raw);
    );
  );
  k_raw = gfx_getchar();
);

// ============================================================
// MOUSE / CLICK — has_click calcolato all'inizio del @gfx
// ============================================================

// ============================================================
// SIDEBAR
// ============================================================
cfg_sidebar && sidebar_allowed ? (
  gfx_set((SIDEBAR_BG&$xff0000)/$xff0000,(SIDEBAR_BG&$xff00)/$xff00,(SIDEBAR_BG&$xff)/$xff,0.96);
  gfx_rect(0,0,SB_W,gfx_h);

  set_color(SIDEBAR_ACC);
  gfx_line(SB_W-1,0,SB_W-1,gfx_h);

  gfx_setfont(4,"Arial",fsz_sb*0.78);
  set_color(TEXT_COLOR);

  // Mouse wheel scroll dentro la sidebar
  mouse_x >= 0 && mouse_x <= SB_W ? (
    mouse_wheel != 0 ? (
      sidebar_scroll -= mouse_wheel / 12;
      mouse_wheel = 0;
    );
  );

  sb_y = 8 - sidebar_scroll;
  sb_x = 8;
  sb_lw = SB_W - 16;
  sb_bw = SB_W - 16;
  sb_bh = 9;
  sb_pad = 22;

  // Scissor: imposta clipping verticale per non disegnare fuori dalla sidebar
  gfx_mode = 0;
  // Disegna tutto con offset — gli elementi fuori dallo schermo semplicemente non sono visibili

  gfx_setfont(3,"Arial",fsz_sb*0.9);
  set_color(SIDEBAR_ACC);
  gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("Controls",1,sb_x+sb_lw,sb_y+gfx_texth);
  sb_y += gfx_texth + 6;

  set_color(GRID_COLOR);
  gfx_line(sb_x,sb_y,sb_x+sb_lw,sb_y);
  sb_y += 4;

  gfx_setfont(4,"Arial",fsz_sb*0.78);


  // ---- PEAK / CLIP ----
  set_color(GRID_COLOR);
  gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("PEAK / CLIP",1,sb_x+sb_lw,sb_y+gfx_texth);
  sb_y += gfx_texth + 3;

  // Toggle: Reset on stop
  set_color(SIDEBAR_BTN);
  gfx_rect(sb_x,sb_y,sb_bw,gfx_texth+4);
  set_color(cfg_clip_reset_stop ? TEXT_COLOR : GRID_COLOR);
  gfx_x=sb_x+4; gfx_y=sb_y+2;
  gfx_drawstr(cfg_clip_reset_stop ? "Rst on stop: ON" : "Rst on stop: off",1,sb_x+sb_lw,sb_y+gfx_texth+4);
  has_click && mouse_x>=sb_x && mouse_x<=sb_x+sb_bw && mouse_y>=sb_y && mouse_y<=sb_y+gfx_texth+4 ? (cfg_clip_reset_stop=!cfg_clip_reset_stop; has_click=0;);
  sb_y += gfx_texth + 8;

  // Slider: Decay
  set_color(TEXT_COLOR);
  gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("Decay (s)",1,sb_x+sb_lw*0.6,sb_y+gfx_texth);
  // Valore: doppio click per editare
  dec_vx=sb_x+sb_lw*0.62; dec_vy=sb_y; dec_vw=sb_lw*0.38;
  ref_edit==3 ? (
    set_color(SIDEBAR_ACC); gfx_rect(dec_vx-1,dec_vy-1,dec_vw+2,gfx_texth+2);
    set_color(SIDEBAR_BTN); gfx_rect(dec_vx,dec_vy,dec_vw,gfx_texth);
    set_color(TEXT_COLOR); gfx_x=dec_vx+2; gfx_y=dec_vy;
    sprintf(#ref_disp,"%s|",#ref_edit_buf);
    gfx_drawstr(#ref_disp,1,dec_vx+dec_vw,dec_vy+gfx_texth);
  ) : (
    set_color(SIDEBAR_ACC);
    gfx_x=dec_vx; gfx_y=dec_vy;
    sprintf(#sb_tmp,"%.1f",cfg_clip_decay); gfx_drawstr(#sb_tmp,1,dec_vx+dec_vw,dec_vy+gfx_texth);
    has_click && mouse_x>=dec_vx && mouse_x<=dec_vx+dec_vw && mouse_y>=dec_vy && mouse_y<=dec_vy+gfx_texth ? (
      t-last_click_t2 < 0.4 && last_click_target2==3 ? (
        ref_edit=3; #ref_edit_buf=""; has_click=0;
      );
      last_click_t2=t; last_click_target2=3;
    );
  );
  sb_y += gfx_texth+1;
  sb_frac=(cfg_clip_decay-0)/30; set_color(SIDEBAR_BTN); gfx_rect(sb_x,sb_y,sb_bw,sb_bh);
  set_color(SIDEBAR_ACC); gfx_a=0.7; sb_frac>0 ? gfx_rect(sb_x,sb_y,sb_bw*sb_frac,sb_bh); gfx_a=1;
  sb_hx=sb_x+sb_bw*sb_frac; set_color(TEXT_COLOR); gfx_rect(max(sb_x,sb_hx-2),sb_y-1,4,sb_bh+2);
  ref_edit!=3 ? (
    sidebar_drag==1 && mouse_cap&1 ? (cfg_clip_decay=max(0,min(30,(mouse_x-sb_x)/sb_bw*30)););
    !(mouse_cap&1) && sidebar_drag==1 ? sidebar_drag=-1;
    mouse_cap&1 && sidebar_drag<0 && abs(mouse_x-sb_hx)<=6 && mouse_y>=sb_y-2 && mouse_y<=sb_y+sb_bh+2 ? sidebar_drag=1;
  );
  sb_y += sb_bh+11;

  // Slider: NOW hold (tenuta valore NOW peak)
  set_color(TEXT_COLOR);
  gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("NOW hold (s)",1,sb_x+sb_lw*0.6,sb_y+gfx_texth);
  now_vx=sb_x+sb_lw*0.62; now_vy=sb_y; now_vw=sb_lw*0.38;
  ref_edit==6 ? (
    set_color(SIDEBAR_ACC); gfx_rect(now_vx-1,now_vy-1,now_vw+2,gfx_texth+2);
    set_color(SIDEBAR_BTN); gfx_rect(now_vx,now_vy,now_vw,gfx_texth);
    set_color(TEXT_COLOR); gfx_x=now_vx+2; gfx_y=now_vy;
    sprintf(#ref_disp,"%s|",#ref_edit_buf);
    gfx_drawstr(#ref_disp,1,now_vx+now_vw,now_vy+gfx_texth);
  ) : (
    set_color(PEAK_NOW_COLOR);
    gfx_x=now_vx; gfx_y=now_vy;
    sprintf(#sb_tmp,"%.2f",cfg_peak_now_hold); gfx_drawstr(#sb_tmp,1,now_vx+now_vw,now_vy+gfx_texth);
    has_click && mouse_x>=now_vx && mouse_x<=now_vx+now_vw && mouse_y>=now_vy && mouse_y<=now_vy+gfx_texth ? (
      t-last_click_t2 < 0.4 && last_click_target2==6 ? (
        ref_edit=6; #ref_edit_buf=""; has_click=0;
      );
      last_click_t2=t; last_click_target2=6;
    );
  );
  sb_y += gfx_texth+1;
  sb_frac=(cfg_peak_now_hold-0)/3; set_color(SIDEBAR_BTN); gfx_rect(sb_x,sb_y,sb_bw,sb_bh);
  set_color(PEAK_NOW_COLOR); gfx_a=0.7; sb_frac>0 ? gfx_rect(sb_x,sb_y,sb_bw*sb_frac,sb_bh); gfx_a=1;
  sb_hx=sb_x+sb_bw*sb_frac; set_color(TEXT_COLOR); gfx_rect(max(sb_x,sb_hx-2),sb_y-1,4,sb_bh+2);
  ref_edit!=6 ? (
    sidebar_drag==5 && mouse_cap&1 ? (cfg_peak_now_hold=max(0,min(3,(mouse_x-sb_x)/sb_bw*3)););
    !(mouse_cap&1) && sidebar_drag==5 ? sidebar_drag=-1;
    mouse_cap&1 && sidebar_drag<0 && abs(mouse_x-sb_hx)<=6 && mouse_y>=sb_y-2 && mouse_y<=sb_y+sb_bh+2 ? sidebar_drag=5;
  );
  sb_y += sb_bh+11;

  // ---- LUFS ALERTS ----
  set_color(GRID_COLOR);
  gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("LUFS ALERTS",1,sb_x+sb_lw,sb_y+gfx_texth);
  sb_y += gfx_texth + 3;

  // Toggle: Alert mode (cycles 0=off 1=yellow 2=red 3=both)
  set_color(SIDEBAR_BTN);
  gfx_rect(sb_x,sb_y,sb_bw,gfx_texth+4);
  set_color(cfg_alert==0 ? GRID_COLOR : TEXT_COLOR);
  gfx_x=sb_x+4; gfx_y=sb_y+2;
  cfg_alert==0 ? gfx_drawstr("Alert: off",1,sb_x+sb_lw,sb_y+gfx_texth+4) :
  cfg_alert==1 ? gfx_drawstr("Alert: yellow",1,sb_x+sb_lw,sb_y+gfx_texth+4) :
  cfg_alert==2 ? gfx_drawstr("Alert: red",1,sb_x+sb_lw,sb_y+gfx_texth+4) :
                 gfx_drawstr("Alert: both",1,sb_x+sb_lw,sb_y+gfx_texth+4);
  has_click && mouse_x>=sb_x && mouse_x<=sb_x+sb_bw && mouse_y>=sb_y && mouse_y<=sb_y+gfx_texth+4 ? (
    cfg_alert=(cfg_alert+1)%4; has_click=0;
  );
  sb_y += gfx_texth + 8;

  // Slider: Yellow
  set_color(TEXT_COLOR);
  gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("Yellow (dBLUFS)",1,sb_x+sb_lw*0.6,sb_y+gfx_texth);
  // Valore: doppio click per editare
  yel_vx=sb_x+sb_lw*0.62; yel_vy=sb_y; yel_vw=sb_lw*0.38;
  ref_edit==4 ? (
    set_color(SIDEBAR_ACC); gfx_rect(yel_vx-1,yel_vy-1,yel_vw+2,gfx_texth+2);
    set_color(SIDEBAR_BTN); gfx_rect(yel_vx,yel_vy,yel_vw,gfx_texth);
    set_color(TEXT_COLOR); gfx_x=yel_vx+2; gfx_y=yel_vy;
    sprintf(#ref_disp,"%s|",#ref_edit_buf);
    gfx_drawstr(#ref_disp,1,yel_vx+yel_vw,yel_vy+gfx_texth);
  ) : (
    set_color(SIDEBAR_ACC);
    gfx_x=yel_vx; gfx_y=yel_vy;
    sprintf(#sb_tmp,"%.0f",cfg_yellow); gfx_drawstr(#sb_tmp,1,yel_vx+yel_vw,yel_vy+gfx_texth);
    has_click && mouse_x>=yel_vx && mouse_x<=yel_vx+yel_vw && mouse_y>=yel_vy && mouse_y<=yel_vy+gfx_texth ? (
      t-last_click_t2 < 0.4 && last_click_target2==4 ? (
        ref_edit=4; #ref_edit_buf=""; has_click=0;
      );
      last_click_t2=t; last_click_target2=4;
    );
  );
  sb_y += gfx_texth+1;
  sb_frac=(cfg_yellow+60)/60; set_color(SIDEBAR_BTN); gfx_rect(sb_x,sb_y,sb_bw,sb_bh);
  set_color(YELLOW_COLOR); gfx_a=0.7; sb_frac>0 ? gfx_rect(sb_x,sb_y,sb_bw*sb_frac,sb_bh); gfx_a=1;
  sb_hx=sb_x+sb_bw*sb_frac; set_color(TEXT_COLOR); gfx_rect(max(sb_x,sb_hx-2),sb_y-1,4,sb_bh+2);
  ref_edit!=4 ? (
    sidebar_drag==2 && mouse_cap&1 ? (cfg_yellow=max(-60,min(0,(mouse_x-sb_x)/sb_bw*60-60)););
    !(mouse_cap&1) && sidebar_drag==2 ? sidebar_drag=-1;
    mouse_cap&1 && sidebar_drag<0 && abs(mouse_x-sb_hx)<=6 && mouse_y>=sb_y-2 && mouse_y<=sb_y+sb_bh+2 ? sidebar_drag=2;
  );
  sb_y += sb_bh+11;

  // Slider: Red
  set_color(TEXT_COLOR);
  gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("Red (dBLUFS)",1,sb_x+sb_lw*0.6,sb_y+gfx_texth);
  // Valore: doppio click per editare
  red_vx=sb_x+sb_lw*0.62; red_vy=sb_y; red_vw=sb_lw*0.38;
  ref_edit==5 ? (
    set_color(SIDEBAR_ACC); gfx_rect(red_vx-1,red_vy-1,red_vw+2,gfx_texth+2);
    set_color(SIDEBAR_BTN); gfx_rect(red_vx,red_vy,red_vw,gfx_texth);
    set_color(TEXT_COLOR); gfx_x=red_vx+2; gfx_y=red_vy;
    sprintf(#ref_disp,"%s|",#ref_edit_buf);
    gfx_drawstr(#ref_disp,1,red_vx+red_vw,red_vy+gfx_texth);
  ) : (
    set_color(SIDEBAR_ACC);
    gfx_x=red_vx; gfx_y=red_vy;
    sprintf(#sb_tmp,"%.0f",cfg_red); gfx_drawstr(#sb_tmp,1,red_vx+red_vw,red_vy+gfx_texth);
    has_click && mouse_x>=red_vx && mouse_x<=red_vx+red_vw && mouse_y>=red_vy && mouse_y<=red_vy+gfx_texth ? (
      t-last_click_t2 < 0.4 && last_click_target2==5 ? (
        ref_edit=5; #ref_edit_buf=""; has_click=0;
      );
      last_click_t2=t; last_click_target2=5;
    );
  );
  sb_y += gfx_texth+1;
  sb_frac=(cfg_red+60)/60; set_color(SIDEBAR_BTN); gfx_rect(sb_x,sb_y,sb_bw,sb_bh);
  set_color(RED_COLOR); gfx_a=0.7; sb_frac>0 ? gfx_rect(sb_x,sb_y,sb_bw*sb_frac,sb_bh); gfx_a=1;
  sb_hx=sb_x+sb_bw*sb_frac; set_color(TEXT_COLOR); gfx_rect(max(sb_x,sb_hx-2),sb_y-1,4,sb_bh+2);
  ref_edit!=5 ? (
    sidebar_drag==3 && mouse_cap&1 ? (cfg_red=max(-60,min(0,(mouse_x-sb_x)/sb_bw*60-60)););
    !(mouse_cap&1) && sidebar_drag==3 ? sidebar_drag=-1;
    mouse_cap&1 && sidebar_drag<0 && abs(mouse_x-sb_hx)<=6 && mouse_y>=sb_y-2 && mouse_y<=sb_y+sb_bh+2 ? sidebar_drag=3;
  );
  sb_y += sb_bh+11;

  // ---- DISPLAY ----
  set_color(GRID_COLOR);
  gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("DISPLAY",1,sb_x+sb_lw,sb_y+gfx_texth);
  sb_y += gfx_texth + 3;

  // Slider: Y scale
  set_color(TEXT_COLOR);
  gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("Y scale",1,sb_x+sb_lw*0.6,sb_y+gfx_texth);
  set_color(SIDEBAR_ACC);
  gfx_x=sb_x+sb_lw*0.62; gfx_y=sb_y;
  sprintf(#sb_tmp,"%.1f",cfg_yscale); gfx_drawstr(#sb_tmp,1,sb_x+sb_lw,sb_y+gfx_texth);
  sb_y += gfx_texth+1;
  sb_frac=(cfg_yscale-0.5)/3.5; set_color(SIDEBAR_BTN); gfx_rect(sb_x,sb_y,sb_bw,sb_bh);
  set_color(SIDEBAR_ACC); gfx_a=0.7; sb_frac>0 ? gfx_rect(sb_x,sb_y,sb_bw*sb_frac,sb_bh); gfx_a=1;
  sb_hx=sb_x+sb_bw*sb_frac; set_color(TEXT_COLOR); gfx_rect(max(sb_x,sb_hx-2),sb_y-1,4,sb_bh+2);
  sidebar_drag==4 && mouse_cap&1 ? (cfg_yscale=max(0.5,min(4.0,(mouse_x-sb_x)/sb_bw*3.5+0.5)););
  !(mouse_cap&1) && sidebar_drag==4 ? sidebar_drag=-1;
  mouse_cap&1 && sidebar_drag<0 && abs(mouse_x-sb_hx)<=6 && mouse_y>=sb_y-2 && mouse_y<=sb_y+sb_bh+2 ? sidebar_drag=4;
  sb_y += sb_bh+11;

  // Toggle: Force mono
  set_color(SIDEBAR_BTN);
  gfx_rect(sb_x,sb_y,sb_bw,gfx_texth+4);
  set_color(cfg_mono ? TEXT_COLOR : GRID_COLOR);
  gfx_x=sb_x+4; gfx_y=sb_y+2;
  gfx_drawstr(cfg_mono ? "Force mono: ON" : "Force mono: off",1,sb_x+sb_lw,sb_y+gfx_texth+4);
  has_click && mouse_x>=sb_x && mouse_x<=sb_x+sb_bw && mouse_y>=sb_y && mouse_y<=sb_y+gfx_texth+4 ? (cfg_mono=!cfg_mono; has_click=0;);
  sb_y += gfx_texth + 8;

  // ---- REF LINES ----
  set_color(GRID_COLOR);
  gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("REF LINES",1,sb_x+sb_lw,sb_y+gfx_texth);
  sb_y += gfx_texth + 3;

  // --- Linea 1 ---
  // Toggle show
  set_color(SIDEBAR_BTN); gfx_rect(sb_x,sb_y,sb_bw,gfx_texth+4);
  set_color(cfg_ref1_show ? TEXT_COLOR : GRID_COLOR); gfx_x=sb_x+4; gfx_y=sb_y+2;
  gfx_drawstr(cfg_ref1_show ? "Line 1: ON" : "Line 1: off",1,sb_x+sb_lw,sb_y+gfx_texth+4);
  has_click && mouse_x>=sb_x && mouse_x<=sb_x+sb_bw && mouse_y>=sb_y && mouse_y<=sb_y+gfx_texth+4 ? (cfg_ref1_show=!cfg_ref1_show; has_click=0;);
  sb_y += gfx_texth + 6;

  // Slider level linea 1 + doppio click per input
  set_color(TEXT_COLOR); gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("L1 level",1,sb_x+sb_lw*0.6,sb_y+gfx_texth);
  // Area valore: rilevamento doppio click
  ref1_vx=sb_x+sb_lw*0.62; ref1_vy=sb_y; ref1_vw=sb_lw*0.38;
  ref_edit==1 ? (
    // Modalità input attiva per L1: mostra campo editabile
    set_color(SIDEBAR_ACC); gfx_rect(ref1_vx-1,ref1_vy-1,ref1_vw+2,gfx_texth+2);
    set_color(SIDEBAR_BTN); gfx_rect(ref1_vx,ref1_vy,ref1_vw,gfx_texth);
    set_color(TEXT_COLOR); gfx_x=ref1_vx+2; gfx_y=ref1_vy;
    sprintf(#ref_disp,"%s|",#ref_edit_buf);
    gfx_drawstr(#ref_disp,1,ref1_vx+ref1_vw,ref1_vy+gfx_texth);
  ) : (
    set_color(cfg_ref1_color==1 ? MONO_COLOR : cfg_ref1_color==2 ? LUFS_COLOR : TEXT_COLOR);
    gfx_x=ref1_vx; gfx_y=ref1_vy;
    sprintf(#sb_tmp,"%.1f",cfg_ref1_db); gfx_drawstr(#sb_tmp,1,ref1_vx+ref1_vw,ref1_vy+gfx_texth);
    // Doppio click sul valore
    has_click && mouse_x>=ref1_vx && mouse_x<=ref1_vx+ref1_vw && mouse_y>=ref1_vy && mouse_y<=ref1_vy+gfx_texth ? (
      t-last_click_t2 < 0.4 && last_click_target2==1 ? (
        ref_edit=1; #ref_edit_buf=""; has_click=0;
      );
      last_click_t2=t; last_click_target2=1;
    );
  );
  sb_y += gfx_texth+1;
  sb_frac=(cfg_ref1_db+72)/72;
  set_color(SIDEBAR_BTN); gfx_rect(sb_x,sb_y,sb_bw,sb_bh);
  set_color(cfg_ref1_color==1 ? MONO_COLOR : cfg_ref1_color==2 ? LUFS_COLOR : TEXT_COLOR);
  gfx_a=0.7; sb_frac>0 ? gfx_rect(sb_x,sb_y,sb_bw*sb_frac,sb_bh); gfx_a=1;
  sb_hx=sb_x+sb_bw*sb_frac; set_color(TEXT_COLOR); gfx_rect(max(sb_x,sb_hx-2),sb_y-1,4,sb_bh+2);
  ref_edit!=1 ? (
    sidebar_drag==6 && mouse_cap&1 ? (cfg_ref1_db=max(-72,min(0,(mouse_x-sb_x)/sb_bw*72-72)););
    !(mouse_cap&1) && sidebar_drag==6 ? sidebar_drag=-1;
    mouse_cap&1 && sidebar_drag<0 && abs(mouse_x-sb_hx)<=6 && mouse_y>=sb_y-2 && mouse_y<=sb_y+sb_bh+2 ? sidebar_drag=6;
  );
  sb_y += sb_bh+6;

  // Toggle colore linea 1 (cicla white→orange→cyan)
  set_color(SIDEBAR_BTN);
  gfx_rect(sb_x,sb_y,sb_bw,gfx_texth+4);
  set_color(TEXT_COLOR); gfx_x=sb_x+4; gfx_y=sb_y+2;
  cfg_ref1_color==0 ? gfx_drawstr("L1 color: white",1,sb_x+sb_lw,sb_y+gfx_texth+4) :
  cfg_ref1_color==1 ? gfx_drawstr("L1 color: orange",1,sb_x+sb_lw,sb_y+gfx_texth+4) :
                      gfx_drawstr("L1 color: cyan",1,sb_x+sb_lw,sb_y+gfx_texth+4);
  has_click && mouse_x>=sb_x && mouse_x<=sb_x+sb_bw && mouse_y>=sb_y && mouse_y<=sb_y+gfx_texth+4 ? (cfg_ref1_color=(cfg_ref1_color+1)%3; has_click=0;);
  sb_y += gfx_texth + 10;

  // --- Linea 2 ---
  set_color(SIDEBAR_BTN); gfx_rect(sb_x,sb_y,sb_bw,gfx_texth+4);
  set_color(cfg_ref2_show ? TEXT_COLOR : GRID_COLOR); gfx_x=sb_x+4; gfx_y=sb_y+2;
  gfx_drawstr(cfg_ref2_show ? "Line 2: ON" : "Line 2: off",1,sb_x+sb_lw,sb_y+gfx_texth+4);
  has_click && mouse_x>=sb_x && mouse_x<=sb_x+sb_bw && mouse_y>=sb_y && mouse_y<=sb_y+gfx_texth+4 ? (cfg_ref2_show=!cfg_ref2_show; has_click=0;);
  sb_y += gfx_texth + 6;

  // Slider level linea 2 + doppio click per input
  set_color(TEXT_COLOR); gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("L2 level",1,sb_x+sb_lw*0.6,sb_y+gfx_texth);
  ref2_vx=sb_x+sb_lw*0.62; ref2_vy=sb_y; ref2_vw=sb_lw*0.38;
  ref_edit==2 ? (
    set_color(SIDEBAR_ACC); gfx_rect(ref2_vx-1,ref2_vy-1,ref2_vw+2,gfx_texth+2);
    set_color(SIDEBAR_BTN); gfx_rect(ref2_vx,ref2_vy,ref2_vw,gfx_texth);
    set_color(TEXT_COLOR); gfx_x=ref2_vx+2; gfx_y=ref2_vy;
    sprintf(#ref_disp,"%s|",#ref_edit_buf);
    gfx_drawstr(#ref_disp,1,ref2_vx+ref2_vw,ref2_vy+gfx_texth);
  ) : (
    set_color(cfg_ref2_color==1 ? MONO_COLOR : cfg_ref2_color==2 ? LUFS_COLOR : TEXT_COLOR);
    gfx_x=ref2_vx; gfx_y=ref2_vy;
    sprintf(#sb_tmp,"%.1f",cfg_ref2_db); gfx_drawstr(#sb_tmp,1,ref2_vx+ref2_vw,ref2_vy+gfx_texth);
    has_click && mouse_x>=ref2_vx && mouse_x<=ref2_vx+ref2_vw && mouse_y>=ref2_vy && mouse_y<=ref2_vy+gfx_texth ? (
      t-last_click_t2 < 0.4 && last_click_target2==2 ? (
        ref_edit=2; #ref_edit_buf=""; has_click=0;
      );
      last_click_t2=t; last_click_target2=2;
    );
  );
  sb_y += gfx_texth+1;
  sb_frac=(cfg_ref2_db+72)/72;
  set_color(SIDEBAR_BTN); gfx_rect(sb_x,sb_y,sb_bw,sb_bh);
  set_color(cfg_ref2_color==1 ? MONO_COLOR : cfg_ref2_color==2 ? LUFS_COLOR : TEXT_COLOR);
  gfx_a=0.7; sb_frac>0 ? gfx_rect(sb_x,sb_y,sb_bw*sb_frac,sb_bh); gfx_a=1;
  sb_hx=sb_x+sb_bw*sb_frac; set_color(TEXT_COLOR); gfx_rect(max(sb_x,sb_hx-2),sb_y-1,4,sb_bh+2);
  ref_edit!=2 ? (
    sidebar_drag==7 && mouse_cap&1 ? (cfg_ref2_db=max(-72,min(0,(mouse_x-sb_x)/sb_bw*72-72)););
    !(mouse_cap&1) && sidebar_drag==7 ? sidebar_drag=-1;
    mouse_cap&1 && sidebar_drag<0 && abs(mouse_x-sb_hx)<=6 && mouse_y>=sb_y-2 && mouse_y<=sb_y+sb_bh+2 ? sidebar_drag=7;
  );
  sb_y += sb_bh+6;

  // Toggle colore linea 2
  set_color(SIDEBAR_BTN);
  gfx_rect(sb_x,sb_y,sb_bw,gfx_texth+4);
  set_color(TEXT_COLOR); gfx_x=sb_x+4; gfx_y=sb_y+2;
  cfg_ref2_color==0 ? gfx_drawstr("L2 color: white",1,sb_x+sb_lw,sb_y+gfx_texth+4) :
  cfg_ref2_color==1 ? gfx_drawstr("L2 color: orange",1,sb_x+sb_lw,sb_y+gfx_texth+4) :
                      gfx_drawstr("L2 color: cyan",1,sb_x+sb_lw,sb_y+gfx_texth+4);
  has_click && mouse_x>=sb_x && mouse_x<=sb_x+sb_bw && mouse_y>=sb_y && mouse_y<=sb_y+gfx_texth+4 ? (cfg_ref2_color=(cfg_ref2_color+1)%3; has_click=0;);
  sb_y += gfx_texth + 10;

  // ---- INTEGRATION ----
  set_color(GRID_COLOR);
  gfx_x=sb_x; gfx_y=sb_y;
  gfx_drawstr("INTEGRATION",1,sb_x+sb_lw,sb_y+gfx_texth);
  sb_y += gfx_texth + 3;

  // Toggle: Reset on play
  set_color(SIDEBAR_BTN);
  gfx_rect(sb_x,sb_y,sb_bw,gfx_texth+4);
  set_color(cfg_reinit ? TEXT_COLOR : GRID_COLOR);
  gfx_x=sb_x+4; gfx_y=sb_y+2;
  gfx_drawstr(cfg_reinit ? "Reset on play: ON" : "Reset on play: off",1,sb_x+sb_lw,sb_y+gfx_texth+4);
  has_click && mouse_x>=sb_x && mouse_x<=sb_x+sb_bw && mouse_y>=sb_y && mouse_y<=sb_y+gfx_texth+4 ? (cfg_reinit=!cfg_reinit; has_click=0;);
  sb_y += gfx_texth + 8;

  sb_y += 4;

  sb_y += gfx_texth + sb_pad;

  // ---- Scrollbar laterale ----
  sb_content_h = sb_y + sidebar_scroll;  // altezza totale contenuto
  sb_max_scroll = max(0, sb_content_h - gfx_h + 8);
  sidebar_scroll = max(0, min(sb_max_scroll, sidebar_scroll));

  sb_max_scroll > 0 ? (
    _sbr_x = SB_W - 9;
    _sbr_h = gfx_h - 4;
    _sbr_thumb_h = max(20, _sbr_h * gfx_h / sb_content_h);
    _sbr_thumb_y = 2 + (sidebar_scroll / sb_max_scroll) * (_sbr_h - _sbr_thumb_h);
    set_color(SIDEBAR_BTN);
    gfx_rect(_sbr_x, 2, 3, _sbr_h);
    set_color(SIDEBAR_ACC);
    gfx_a = 0.7;
    gfx_rect(_sbr_x, _sbr_thumb_y, 3, _sbr_thumb_h);
    gfx_a = 1;
  );
);

// ---- RESET ALL verticale a destra (fisso, fuori da numeri/etichette) ----
!use_alt_view ? (
rst_w = max(14, gfx_texth*0.95);
rst_h = max(84, gfx_texth*6.4);
rst_x = gfx_w - rst_w - 2;
rst_y = (gfx_h*0.46 - rst_h*0.5)|0;
rst_y = max(yhi + gfx_texth*2, min(gfx_h - rst_h - gfx_texth*4.8, rst_y));
rst_hover = mouse_x >= rst_x && mouse_x <= rst_x+rst_w && mouse_y >= rst_y && mouse_y <= rst_y+rst_h;
set_color(rst_hover ? RESET_BTN_HOVER : RESET_BTN_COLOR);
gfx_a=0.9;
gfx_rect(rst_x, rst_y, rst_w, rst_h);
gfx_a=1;
set_color(TEXT_COLOR);
gfx_setfont(4,"Arial",max(8,fsz_sb*0.70));

// Etichetta verticale: lettere una sotto l'altra
#rst_lbl = "RESET ALL";
_ri=0;
_ry=rst_y+3;
loop(strlen(#rst_lbl),
  _rc = str_getchar(#rst_lbl,_ri);
  _rc == 32 ? (
    _ry += gfx_texth*0.40;
  ) : (
    #rst_ch="";
    str_setchar(#rst_ch,0,_rc);
    str_setchar(#rst_ch,1,0);
    gfx_x=rst_x+rst_w/2;
    gfx_y=_ry;
    gfx_drawstr(#rst_ch,1|4,rst_x+rst_w-1,_ry+gfx_texth);
    _ry += gfx_texth*0.70;
  );
  _ri += 1;
);

has_click && rst_hover ? (
  Reset();
  has_click=0;
);
gfx_setfont(1,"Arial",fsz);
);


want_axis && !use_alt_view ? (
  set_color(MONO_COLOR);
  tc1=(gfx_w-gfx_texth*27/16)|0;
  tc2=(gfx_w-gfx_texth*21/16)|0;
  tr=(gfx_texth*7/16)|0;
  cfg_mono ? gfx_mode = 1;
  gfx_circle(tc1,yt,tr,cfg_mono?1:0,0);
  gfx_circle(tc2,yt,tr,cfg_mono?1:0,0);
  cfg_mono ? (
    set_color(BG_COLOR);
    gfx_x=tc1-tr; gfx_y=yt-tr+1;
    gfx_drawstr("M",1|4|256,tc2+tr,yt+tr+1);
  );
  has_click && abs(mouse_x-(tc1+tc2)/2) <= tr*3/2+1 && abs(mouse_y-yt) <= tr+1 ? (
    cfg_mono=!cfg_mono;
    slider_automate(1<<11);
    has_click=0;
  );
);

(want_axis || sliders_showing) && !use_alt_view ? (
  set_color(TEXT_COLOR);
  tx=gfx_w-gfx_texth*3/2;
  gfx_rect(gfx_x=tx-gfx_texth/2,gfx_y=ylo-gfx_texth/2,gfx_texth+1,gfx_texth+1,0);
  gfx_drawstr("?",1|4,gfx_x+gfx_texth+1,gfx_y+gfx_texth+1);
  has_click && abs(mouse_x-tx) < gfx_texth/2 && abs(mouse_y-ylo) < gfx_texth/2 ? (
    sliders_showing = slider_show(UI_SLIDER_MASK,-1) > 0;
    has_click=0;
  );
);

// ---- TAB toggle sidebar (sempre visibile sul bordo sinistro) ----
sidebar_allowed ? (
  tab_w = 14;
  tab_h = 36;
  tab_x = cfg_sidebar ? SB_W : 0;
  tab_y = (gfx_h - tab_h) / 2;
  gfx_set((SIDEBAR_BG&$xff0000)/$xff0000,(SIDEBAR_BG&$xff00)/$xff00,(SIDEBAR_BG&$xff)/$xff,0.96);
  gfx_rect(tab_x, tab_y, tab_w, tab_h);
  set_color(SIDEBAR_ACC);
  gfx_rect(tab_x, tab_y, 1, tab_h);
  gfx_rect(tab_x + tab_w - 1, tab_y, 1, tab_h);
  gfx_rect(tab_x, tab_y, tab_w, 1);
  gfx_rect(tab_x, tab_y + tab_h - 1, tab_w, 1);
  set_color(TEXT_COLOR);
  gfx_setfont(4,"Arial",10);
  gfx_x = tab_x + 2; gfx_y = tab_y + tab_h/2 - gfx_texth/2;
  cfg_sidebar ? gfx_drawstr("«",1,tab_x+tab_w,tab_y+tab_h/2+gfx_texth/2) :
                gfx_drawstr("»",1,tab_x+tab_w,tab_y+tab_h/2+gfx_texth/2);
  has_click && mouse_x >= tab_x && mouse_x <= tab_x+tab_w && mouse_y >= tab_y && mouse_y <= tab_y+tab_h ? (
    cfg_sidebar = !cfg_sidebar;
    has_click = 0;
  );
);

ref_edit==7 ? (
  tip_active=1;
  sprintf(#tip_msg,"Inserisci TP RED e premi INVIO: %s",#ref_edit_buf);
);
ref_edit==8 ? (
  tip_active=1;
  sprintf(#tip_msg,"Inserisci LU RED e premi INVIO: %s",#ref_edit_buf);
);

draw_tip_bar();

// Mini UI dedicata per "Show embedded UI in TCP/MCP".
// Evita di comprimere la vista completa dentro lo spazio minuscolo del mixer.
(gfx_ext_flags&1) ? (
  gfx_ext_flags = gfx_ext_flags | 512; // click sull'embedded: lascia aprire la UI completa a REAPER
  gfx_set(0.025,0.030,0.040,1);
  gfx_rect(0,0,gfx_w,gfx_h);
  gfx_set(0.12,0.45,0.82,0.90);
  gfx_rect(0,0,gfx_w,max(2,gfx_h*0.035));

  _emb_pad=max(2,min(5,floor(gfx_w*0.05)));
  _emb_top=max(13,min(24,floor(gfx_h*0.24)));
  _emb_bot=max(10,min(18,floor(gfx_h*0.18)));
  _emb_h=max(8,gfx_h-_emb_top-_emb_bot-_emb_pad);
  _emb_x=_emb_pad;
  _emb_w=max(8,gfx_w-_emb_pad*2);

  gfx_setfont(4,"Arial",max(7,min(12,floor(gfx_h*0.16))),'b');
  gfx_set(0.72,0.86,0.96,0.98);
  gfx_x=_emb_pad;
  gfx_y=max(1,floor((_emb_top-gfx_texth)*0.35));
  gfx_w < 58 ? gfx_drawstr("ZP") : gfx_drawstr("ZP Loud");

  gfx_setfont(4,"Arial",max(7,min(13,floor(gfx_h*0.18))),'b');
  gfx_set(0.90,0.96,0.94,1);
  gfx_measurestr(#hdr_tp,_tw,_th);
  gfx_x=max(_emb_pad,gfx_w-_tw-_emb_pad);
  gfx_y=max(1,_emb_top-_th-1);
  gfx_drawstr(#hdr_tp);

  _emb_n=max(1,min(chan_count,8));
  _emb_gap=max(1,min(3,floor(_emb_w/22)));
  _emb_bar_w=max(3,floor((_emb_w-(_emb_n-1)*_emb_gap)/_emb_n));
  _emb_total=_emb_n*_emb_bar_w+(_emb_n-1)*_emb_gap;
  _emb_x += floor((_emb_w-_emb_total)*0.5);
  _emb_i=0;
  loop(_emb_n,
    _emb_ch=chan_start+_emb_i;
    _emb_pv=pk[_emb_ch];
    _emb_db=_emb_pv > 0 ? log(_emb_pv)*20/log(10) : -150;
    _emb_norm=max(0,min(1,(_emb_db+60)/66));
    _emb_bx=_emb_x+_emb_i*(_emb_bar_w+_emb_gap);
    gfx_set(0.08,0.10,0.13,1);
    gfx_rect(_emb_bx,_emb_top,_emb_bar_w,_emb_h);
    _emb_db >= cfg_tp_red ? gfx_set(0.92,0.14,0.12,0.96) :
    _emb_db >= cfg_tp_red - cfg_tp_yellow_margin ? gfx_set(0.94,0.76,0.20,0.96) :
                                                   gfx_set(0.18,0.88,0.34,0.96);
    _emb_fh=max(1,floor(_emb_h*_emb_norm));
    gfx_rect(_emb_bx,_emb_top+_emb_h-_emb_fh,_emb_bar_w,_emb_fh);
    gfx_set(0,0,0,0.28);
    gfx_rect(_emb_bx+floor(_emb_bar_w*0.5),_emb_top,1,_emb_h);
    _emb_i += 1;
  );

  gfx_setfont(4,"Arial",max(7,min(11,floor(gfx_h*0.14))));
  gfx_set(0.58,0.68,0.74,0.95);
  gfx_x=_emb_pad;
  gfx_y=gfx_h-gfx_texth-1;
  gfx_w < 54 ? gfx_drawstr(#chan_lbl) : (
    sprintf(#_emb_lbl,"%s  RMS %s",#chan_lbl,#hdr_rms_m);
    gfx_drawstr(#_emb_lbl);
  );
);

// Reset gestito dal pulsante dedicato

// ============================================================
// SERIALIZE — salva/carica nomi canali nel progetto REAPER
// ============================================================
@serialize
file_var(0, _ser_ver);
_ser_ver != 1 ? _ser_ver = 1;
