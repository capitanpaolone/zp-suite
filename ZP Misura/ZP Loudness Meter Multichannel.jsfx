options:no_meter gmem=ZPVoiceoverSharedBus


@init

help_bridge_alive = 0;
help_warn_until = 0;
ui_lang = 0;

function help_bridge_open(plugin_id) (
  zp_hb_ok ? (
    gmem[3902] = plugin_id;
    gmem[3903] += 1;
    help_warn_until = 0;
  ) : (
    help_warn_until = time_precise() + 4.0;
  );
);

// =====================================================

<?
  nch = max(max_nch,64);
  sinc_sz = 32;
  use_mem_sinc = sinc_sz>32;

  printf("sinc_sz = %d;\n",sinc_sz);

 function do_all_channels(fmt) local(p x c) global(nch) (
   p=x=0;
   while (x < nch) (
     p+=1;
     x>0 ? printf("num_ch > %d ? ( ",x);
     c = x>=24 ? 8 : x>=8 ? 4 : 2;
     loop(c, printf(fmt,x,x); x+=1);
     printf("\n");
   );
   loop(p-1,printf(")"));
 );
?>

WANT_INTEGRATED_ALWAYS=0;

FONT_SZ_MIN=12;
FONT_SZ_MAX=16;
BG_COLOR=$x000000;
GRID_COLOR=$x7f7f7f;
TEXT_COLOR=$xffffff;
PEAK_COLOR=$x3fff3f;
PEAK_CLIP_COLOR=$xff0000;
PEAK_NOW_COLOR=$x33d6ff;
RMS_COLOR=$x7f7f7f;
LUFS_COLOR=$x00bfff;
LUFS_HIST_COLOR=$x005f7f;
RED_COLOR=$xff0000;
YELLOW_COLOR=$xffff00;
MONO_COLOR=$xffa500;
SIDEBAR_BG=$x1a1a2e;
SIDEBAR_BTN=$x2a2a4e;
SIDEBAR_HOV=$x3a3a6e;
SIDEBAR_ACC=$x00bfff;
RESET_BTN_COLOR=$x6a6253;
RESET_BTN_HOVER=$x7a715f;

PEAK_METER_DECAY=0.150;
LOUD_METER_UPDATE=0.100;
LOUD_METER_SPEED=0.075;

UI_SLIDER_MASK = 2 ^ 45 - 1;
slider_show(UI_SLIDER_MASK, 0);

function set_sl(idx, val) local(m) (
  slider(idx) = val;
  m = 2 ^ (idx - 1);
  sliderchange(m);
  slider_automate(m);
);

ext_noinit=1;
ext_nodenorm=1;
gfx_ext_retina=max(gfx_ext_retina,1);

sliders_showing=0;

NUM_BINS=1024;
BINS_PER_DB=10;
DB_PER_BIN=1/BINS_PER_DB;
HIST_LEN=600;

// UI v45 state
last_play_state=0;
ui_drag=0;
ui_drag_y0=0;
ui_drag_v0=0;
reset_pressing=0;
reset_press_t=0;
reset_long_done=0;
tip_active=0;
#tip_msg="";
gear_open=0;
g_box_x=-9999; g_box_y=-9999; g_box_w=0; g_box_h=0;
g_btn_x=-9999; g_btn_y=-9999; g_btn_w=0; g_btn_h=0;
lock_flash_t=-10;
lock_warn_t=-10;
hist_active_t=-10;
ref_edit=0;
#ref_edit_buf="";
last_click_t2=0;
last_click_target2=0;
help_bridge_last_alive_t=-10;

function alloc(sz) global()
(
  memset((this.top+=sz)-sz,0,sz);
);

function sinc_gen_val() global(srate sinc_sz) local(sincpos windowpos) instance(slice_pos) (
  windowpos = (2.0 * $pi / sinc_sz) * slice_pos;
  sincpos = $pi * (slice_pos - sinc_sz * .5);
  slice_pos += 1;
  (0.53836 - cos(windowpos)*0.46164) * sin(sincpos) / sincpos;
);

function sinc_gen_slice(cs, o*) instance(sinc_gen_val slice_pos) local(x) global(sinc_sz) (
  slice_pos = cs;
<?
  use_mem_sinc ? (
    printf("o.v = alloc(sinc_sz);  loop(x=0;sinc_sz, o.v[x] = sinc_gen_val(); x+=1); ");
  ) : (
    loop(x=0;sinc_sz, printf("o.v%02d = sinc_gen_val();%s",x,(x&3)==3?"\n": " "); x += 1)
  );
?>
);

function sinc_init() global(srate) instance(sinc_gen_slice) (
  sinc_gen_slice(srate < 96000 ? .25 : .5,this.s1);
  srate < 96000 ? (
    sinc_gen_slice(.5, this.s2);
    sinc_gen_slice(.75, this.s3);
  );
);

<?
 function emit_sinc(hist, t) (
   use_mem_sinc ? (
    printf("abs(mem_multiply_sum(%s.v,%s.h,sinc_sz))",t,hist);
   ) : (
     printf("abs(");
     loop(x=0;sinc_sz, printf("%s.h%02d * %s.v%02d%s",hist,x,t,x,x==sinc_sz-1?"":(x&3)==3?" +\n":" + "); x+=1);
     printf(")");
   );
 );
?>

function init(chidx)
(
  this.chan=chidx;
  this.wt = chidx < 3 || num_ch < 6 ? 1 : chidx == 3 ? 0 : sqrt(2);
  this.f1p1=this.f1p2=this.f2p1=this.f2p2=0;
  this.pkval=this.hipkval=this.clips=0;
  this.clip_decay_t=0;   // timestamp ultimo clip
  this.ch_lufs_sum=this.ch_rms_sum=0;
  <?
    use_mem_sinc ? (
      printf("this.h = alloc(sinc_sz);\n");
    ) : (
      loop(x=0;sinc_sz, printf("this.h%02d =%s",x,x==sinc_sz-1 ? " 0" : (x&7)==7 ? "\n" : " "); x+=1);
    );
  ?>
);

function decay()
(
  this.pkval *= pk_decay;
);

function reset_clips()
(
  this.clips=0;
  this.clip_decay_t=0;
);

function reset_hold() global(peak_hold_val peak_hold_t) (
  peak_hold_val[this.chan]=0;
  peak_hold_t[this.chan]=0;
);

function clear_pk_clip()
(
  this.hipkval=0;
  this.clips=0;
  this.clip_decay_t=0;
);

function copypks() global(pk hipk clip_cnt clip_decay_t_arr peak_hold_val peak_hold_t) (
  pk[this.chan] = this.pkval;
  hipk[this.chan] = this.hipkval;
  clip_cnt[this.chan] = this.clips;
  clip_decay_t_arr[this.chan] = this.clip_decay_t;
  // Aggiorna hold: se nuovo picco più alto, registra tempo
  this.pkval > peak_hold_val[this.chan] ? (
    peak_hold_val[this.chan] = this.pkval;
    peak_hold_t[this.chan] = time_precise();
  );
);

function proc(lspl)
  local(pspl f1p0 f2p0)
  instance(wt ch_rms_sum ch_lufs_sum pkval hipkval clips clip_decay_t
           f1p1 f1p2 f2p1 f2p2)
  global(f1a1 f1a2 f1b0 f1b1 f1b2
         f2a1 f2a2 f2b0 f2b1 f2b2
         srate cfg_peak
         lval rval win_pos global_peak sinc_sz
         sinc.s1* sinc.s2* sinc.s3*
         )
(
  cfg_peak == 1 || cfg_peak == 2 ? (
    <?
      use_mem_sinc ? (
        printf("mem_insert_shuffle(this.h, sinc_sz, lspl);");
      ) : (
        loop(x=sinc_sz-1;sinc_sz-1, printf("this.h%02d = this.h%02d;%s",x,x-1, (x&3)==0 ? "\n" : " "); x-= 1; );
        printf(" this.h00 = lspl;");
      );
    ?>
    pspl = max(
        abs(this.h<? printf(use_mem_sinc ? "[%d]" : "%02d",sinc_sz/2) ?>),
        <? emit_sinc("this","sinc.s1") ?>
       );
    srate < 96000 ? pspl = max(pspl,max( <? emit_sinc("this","sinc.s2") ?>, <? emit_sinc("this","sinc.s3") ?>));
  ) :
  cfg_peak == 3 || cfg_peak == 4 ? (
    pspl=abs(lspl);
  );
  cfg_peak ? (
    pspl > pkval ? (
      pkval=pspl;
      pspl > hipkval ? (
        hipkval=pspl;
        global_peak = max(global_peak,pspl);
      );
    );
    pspl > 1.0 ? (
      clips += 1;
      clip_decay_t = time_precise();  // registra timestamp clip
    );
  );

  win_pos == 0 ? ch_rms_sum=ch_lufs_sum=0;

  rval += (ch_rms_sum += lspl*lspl);

  lspl *= wt;

  f1p0=lspl-f1a1*f1p1-f1a2*f1p2;
  lspl=f1b0*f1p0+f1b1*f1p1+f1b2*f1p2;
  f1p2=f1p1;
  f1p1=f1p0;

  f2p0=lspl-f2a1*f2p1-f2a2*f2p2;
  lspl=f2b0*f2p0+f2b1*f2p1+f2b2*f2p2;
  f2p2=f2p1;
  f2p1=f2p0;

  lval += (ch_lufs_sum += lspl*lspl);
);

function init_lufs_filters()
  local(Vh Vb db f0 Q K a0)
  global(f1a1 f1a2 f1b0 f1b1 f1b2
         f2a1 f2a2 f2b0 f2b1 f2b2 srate)
(
  db=3.999843853973347;
  f0=1681.974450955533;
  Q=0.7071752369554196;
  K=tan($pi*f0/srate);
  Vh=pow(10, db/20);
  Vb=pow(Vh, 0.4996667741545416);
  a0=1+K/Q+K*K;
  f1a1=2*(K*K-1)/a0;
  f1a2=(1-K/Q+K*K)/a0;
  f1b0=(Vh+Vb*K/Q+K*K)/a0;
  f1b1=2*(K*K-Vh)/a0;
  f1b2=(Vh-Vb*K/Q+K*K)/a0;

  f0=38.13547087602444;
  Q=0.5003270373238773;
  K=tan($pi*f0/srate);
  f2a1=2*(K*K-1)/(1+K/Q+K*K);
  f2a2=(1-K/Q+K*K)/(1+K/Q+K*K);
  f2b0=1;
  f2b1=-2;
  f2b2=1;
);

function Reset()
(
  init_lufs_filters();

  alloc.top=0;
  pk=alloc(<?printf("%d",nch)?>);
  hipk=alloc(<?printf("%d",nch)?>);
  clip_cnt=alloc(<?printf("%d",nch)?>);
  clip_decay_t_arr=alloc(<?printf("%d",nch)?>);
  peak_hold_val=alloc(<?printf("%d",nch)?>);
  peak_hold_t=alloc(<?printf("%d",nch)?>);
  peak_now_db_disp=alloc(<?printf("%d",nch)?>);
  sinc.sinc_init();

  m_win_cnt=0.4/LOUD_METER_UPDATE;
  s_win_cnt=3/LOUD_METER_UPDATE;

  win_pos=0;
  win_cnt=0;
  win_len=(LOUD_METER_UPDATE*srate)|0;
  i_win_len=1/(m_win_cnt*win_len);
  i_win_len2=1/(s_win_cnt*win_len);

  rms_m_sum=0;
  rms_m_db=-100;
  rms_m_db_max=-100;
  rms_i_sum=0;
  rms_i_sum_cnt=0;
  rms_i_db=-100;

  lufs_m_sum=0;
  lufs_m_sum_max=0;
  lufs_m_db=-100;
  lufs_s_sum=0;
  lufs_s_sum_max=0;
  lufs_s_db=-100;
  lufs_a_sum=0;
  lufs_a_sum_cnt=0;
  lufs_b_sum=0;
  lufs_b_sum_cnt=0;
  lra_db_diff = 0;
  lra_db_hi = lra_db_lo = lufs_i_db = lufs_m_db = lufs_s_db = -100;

  last_t=0;
  th_lufs_i=th_lufs_s=th_lufs_m=th_rms_i=th_rms_m=0;

  cur_buf=0;
  cur_buf2=0;
  rms_buf=alloc(m_win_cnt);
  lufs_buf=alloc(m_win_cnt);
  lufs_buf2=alloc(s_win_cnt);
  lufs_a_hist=alloc(2*NUM_BINS);
  lufs_b_hist=alloc(NUM_BINS);
  db_hist=alloc(75);
  db_hist_max=0;
  hist_s=alloc(HIST_LEN);
  hist_m=alloc(HIST_LEN);
  ch_pk_hold=alloc(<?printf("%d",nch)?>);
  ch_pk_hold_t=alloc(<?printf("%d",nch)?>);
  ch_bar_sm=alloc(<?printf("%d",nch)?>);
  hist_wr=0;
  hist_cnt=0;
  hist_active_t=-10;

  global_peak = 0;

  <? do_all_channels("ch%d.init(%d); "); ?>;
  i=0;
  loop(HIST_LEN, hist_s[i]=-100; hist_m[i]=-100; i+=1;);
  i=0;
  loop(<?printf("%d",nch)?>,
    peak_now_db_disp[i]=-150;
    ch_pk_hold[i]=-150;
    ch_pk_hold_t[i]=0;
    ch_bar_sm[i]=-150;
    i+=1;
  );
);

function reset_peaks_only() local(i) (
  global_peak = 0;
  i = 0;
  loop(<?printf("%d",nch)?>,
    hipk[i] = 0;
    clip_cnt[i] = 0;
    clip_decay_t_arr[i] = 0;
    peak_hold_val[i] = 0;
    peak_hold_t[i] = 0;
    ch_pk_hold[i] = -150;
    ch_pk_hold_t[i] = 0;
    i += 1;
  );
  <? do_all_channels("ch%d.clear_pk_clip(); "); ?>;
);

Reset();

// ---- ZP Shared Bus v3.1 (telemetria passiva Loudness Meter, ptype=12) ----
function zp3_boot() (
  gmem[1000] != 905300 || gmem[1001] < 300 ? (
    gmem[1000] = 905300;
    gmem[1001] = 300;
    gmem[1002] = 64;
    gmem[1003] = 32;
  );
);
function zp3_clear_slot() local(zp3_cb) (
  zp3_slot >= 0 && zp3_slot < 64 ? (
    zp3_cb = 1024 + zp3_slot * 32;
    gmem[zp3_cb + 3] == zp3_prev_key ? (
      gmem[zp3_cb] = 0;
      gmem[zp3_cb + 2] = 0;
    );
  );
  zp3_slot = -1;
  zp3_prev_key = -1;
);
function zp3_claim(zp3_pt) local(zp3_now, zp3_key, zp3_h, zp3_i, zp3_s, zp3_b, zp3_m, zp3_found) (
  zp3_boot();
  zp3_now = time_precise();
  zp3_fx = 0; zp3_hf = 0;
  zp3_tr = get_host_placement(zp3_fx, zp3_hf);
  zp3_key = max(0, zp3_tr + 2) * 1024 + max(0, zp3_fx) * 16 + zp3_pt;
  zp3_prev_key >= 0 && zp3_prev_key != zp3_key ? zp3_clear_slot();
  zp3_found = -1;
  zp3_slot >= 0 && zp3_slot < 64 ? (
    zp3_b = 1024 + zp3_slot * 32;
    gmem[zp3_b] == 905301 && gmem[zp3_b + 3] == zp3_key ? (zp3_found = zp3_slot;);
  );
  zp3_found < 0 ? (
    zp3_i = 0;
    loop(64,
      zp3_found < 0 ? (
        zp3_b = 1024 + zp3_i * 32;
        gmem[zp3_b] == 905301 && gmem[zp3_b + 3] == zp3_key ? (zp3_found = zp3_i;);
      );
      zp3_i += 1;
    );
  );
  zp3_found < 0 ? (
    zp3_h = (max(0, zp3_tr + 2) * 13 + max(0, zp3_fx) * 7 + zp3_pt * 3) % 64;
    zp3_i = 0;
    loop(64,
      zp3_found < 0 ? (
        zp3_s = (zp3_h + zp3_i) % 64;
        zp3_b = 1024 + zp3_s * 32;
        zp3_m = gmem[zp3_b];
        (zp3_m != 905301 || (zp3_now - gmem[zp3_b + 1]) > 2.5) ? (zp3_found = zp3_s;);
      );
      zp3_i += 1;
    );
  );
  zp3_slot = zp3_found;
  zp3_prev_key = zp3_key;
  zp3_slot >= 0 ? (
    zp3_b = 1024 + zp3_slot * 32;
    zp3_seq = max(zp3_seq, floor(gmem[zp3_b + 2] + 0.5));
    zp3_b;
  ) : -1;
);
zp3_prev_key <= 0 ? (zp3_slot = -1; zp3_prev_key = -1;);
zp3_boot();


@block

want_reset =
  (num_ch > 0 && num_ch != last_nch) ||
  srate != last_sr;
last_nch=num_ch;
last_sr=srate;

cfg_reinit && (play_state&1) ? (
  abs(play_position-last_play_pos) > 0.1 ? want_reset=1;
  last_play_pos=play_position+samplesblock/srate;
);

want_reset ? Reset();

// Reset completo allo stop (solo su transizione play->stop)
cfg_clip_reset_stop && !(play_state&1) && last_play_state ? (
  Reset();
  last_play_pos=play_position;
);
last_play_state = play_state&1;

pk_decay=pow(0.5, samplesblock/srate/max(0.05,cfg_meter_response));

<? do_all_channels("ch%d.decay(); "); ?>;

function make_output_slider(b, base) ( cfg_out_auto>=2 && !(cfg_out_auto&1) ? base - b : b );
outparm_lufs_m = make_output_slider(lufs_m_db + (cfg_mono ? -3 : 0),-100);
outparm_lufs_s = make_output_slider(lufs_s_db + (cfg_mono ? -3 : 0),-100);
outparm_lufs_i = make_output_slider(lufs_i_db + (cfg_mono ? -3 : 0),-100);
outparm_lufs_lra = make_output_slider(lra_db_diff,100);
outparm_peak = make_output_slider(global_peak > 0 ? log(global_peak)*20/log(10) : -150,-150);
outparm_rms_m = make_output_slider(rms_m_db + (cfg_mono ? -3 : 0),-100);
outparm_rms_i = make_output_slider(rms_i_db + (cfg_mono ? -3 : 0),-100);

cfg_out_auto ? slider_automate(
  cfg_out_auto > 2 ? (2^(29 + floor((cfg_out_auto-3)/2))) : (
    2^29 | 2^30 | 2^31 | 2^32 | 2^33 | 2^34 | 2^35 | 0
  )
);

zp3_b = zp3_claim(12);
zp3_b >= 0 ? (
  zp3_mo = cfg_mono ? -3 : 0;
  zp3_ls = lufs_s_db + zp3_mo;
  zp3_li = lufs_i_db + zp3_mo;
  zp3_lm = lufs_m_db + zp3_mo;
  zp3_tp = global_peak > 0 ? log(global_peak) * 20 / log(10) : -150;
  gmem[zp3_b + 3] = zp3_prev_key;
  gmem[zp3_b + 4] = 12;
  gmem[zp3_b + 5] = zp3_tr;
  gmem[zp3_b + 6] = zp3_fx;
  gmem[zp3_b + 7] = zp3_hf;
  gmem[zp3_b + 8] = 3;
  gmem[zp3_b + 9] = (zp3_tp > cfg_tp_red ? 33 : 1);
  gmem[zp3_b + 10] = 0;
  gmem[zp3_b + 11] = 0;
  gmem[zp3_b + 12] = 0;
  gmem[zp3_b + 13] = 0;
  gmem[zp3_b + 14] = 0;
  gmem[zp3_b + 15] = 0;
  gmem[zp3_b + 16] = 0;
  gmem[zp3_b + 17] = zp3_ls;
  gmem[zp3_b + 18] = zp3_li;
  gmem[zp3_b + 19] = zp3_tp;
  gmem[zp3_b + 20] = zp3_li > -90 ? (zp3_li - cfg_lufs_red) : 0;
  gmem[zp3_b + 21] = zp3_lm > -55 ? min(100, max(0, (zp3_lm + 55) * 2.5)) : 0;
  gmem[zp3_b + 22] = -1;
  gmem[zp3_b + 23] = -99;
  gmem[zp3_b + 24] = zp3_lm;
  gmem[zp3_b + 25] = lra_db_diff;
  gmem[zp3_b + 26] = cfg_lufs_red;
  gmem[zp3_b + 27] = cfg_tol_lu;
  gmem[zp3_b + 28] = cfg_tp_red;
  gmem[zp3_b + 29] = cfg_mono;
  gmem[zp3_b + 30] = 0;
  gmem[zp3_b + 31] = 0;
  gmem[zp3_b] = 905301;
  gmem[zp3_b + 1] = time_precise();
  zp3_seq += 1;
  gmem[zp3_b + 2] = zp3_seq;
);


@sample

rval=lval=0;

<? do_all_channels("ch%d.proc(spl%d); "); ?>;

(win_pos += 1) >= win_len ? (
  win_pos=0;
  win_cnt += 1;

  prev_rval=rms_buf[cur_buf];
  rms_buf[cur_buf]=rval;

  prev_lval=lufs_buf[cur_buf];
  lufs_buf[cur_buf]=lval;

  prev_lval2=lufs_buf2[cur_buf2];
  lufs_buf2[cur_buf2]=lval;

  (cur_buf += 1) >= m_win_cnt ? cur_buf=0;
  (cur_buf2 += 1) >= s_win_cnt ? cur_buf2=0;

  rms_m_sum += (rval-prev_rval)*i_win_len;
  lufs_m_sum += (lval-prev_lval)*i_win_len;
  lufs_s_sum += (lval-prev_lval2)*i_win_len2;

  WANT_INTEGRATED_ALWAYS || (play_state&1) ? (
    rms_i_sum += rms_m_sum;
    rms_i_sum_cnt += 1;
    rms_i_sum > 0 && rms_i_sum_cnt >= m_win_cnt ? (
      rms_i_db=log(rms_i_sum/rms_i_sum_cnt)*10/log(10);
    ) : (
      rms_i_db=-100;
    );
  );

  rms_m_sum > 0 && win_cnt >= m_win_cnt ? (
    rms_m_db=log(rms_m_sum)*10/log(10);
    rms_m_db > rms_m_db_max ? rms_m_db_max=rms_m_db;
  ) : (
    rms_m_db=-100;
  );

  lufs_m_sum > 0 && win_cnt >= m_win_cnt ? (
    lufs_m_sum > lufs_m_sum_max ? lufs_m_sum_max=lufs_m_sum;
    lufs_m_db=-0.691+log(lufs_m_sum)*10/log(10);

    a = WANT_INTEGRATED_ALWAYS || (play_state&1) ? ((lufs_m_db+70)*BINS_PER_DB)|0 : -1;
    a >= 0 ? (
      a >= NUM_BINS ? a=NUM_BINS-1;
      lufs_a_sum += lufs_m_sum;
      lufs_a_sum_cnt += 1;
      lufs_a_hist[2*a] += 1;
      lufs_a_hist[2*a+1] += lufs_m_sum;
      db_hist_max = max(db_hist_max,db_hist[min(a*DB_PER_BIN,74)] += 1);

      lufs_a_db=-0.691+log(lufs_a_sum/lufs_a_sum_cnt)*10/log(10);
      lufs_a_gate=((lufs_a_db-10+70)*BINS_PER_DB)|0;
      lufs_i_sum=0;
      lufs_i_cnt=0;
      bin=max(lufs_a_gate,0);
      loop(NUM_BINS-bin,
        lufs_i_cnt += lufs_a_hist[2*bin];
        lufs_i_sum += lufs_a_hist[2*bin+1];
        bin += 1;
      );
      lufs_i_db=lufs_i_sum > 0 ? -0.691+log(lufs_i_sum/lufs_i_cnt)*10/log(10) : -100;
    );
  ) : (
    lufs_m_db=-100;
  );

  lufs_s_sum > 0 && win_cnt >= s_win_cnt ? (
    lufs_s_sum > lufs_s_sum_max ? lufs_s_sum_max=lufs_s_sum;
    lufs_s_db=-0.691+log(lufs_s_sum)*10/log(10);

    b = WANT_INTEGRATED_ALWAYS || (play_state&1) ? ((lufs_s_db+70)*BINS_PER_DB)|0 : -1;
    b >= 0 ? (
      b >= NUM_BINS ? b=NUM_BINS-1;
      lufs_b_sum += lufs_s_sum;
      lufs_b_sum_cnt += 1;
      lufs_b_hist[b] += 1;

      lufs_b_db=-0.691+log(lufs_b_sum/lufs_b_sum_cnt)*10/log(10);
      lufs_b_gate=((lufs_b_db-20+70)*BINS_PER_DB)|0;

      lra_cnt=0;
      bin=max(lufs_b_gate,0);
      loop(NUM_BINS-bin,
        lra_cnt += lufs_b_hist[bin];
        bin += 1;
      );
      lra_cnt >= 20 ? (
        lra_cnt_lo=lra_cnt_hi=0;
        bin=lufs_b_gate;
        while(bin < NUM_BINS && lra_cnt_lo < lra_cnt*0.10)
        (
          lra_cnt_lo += lufs_b_hist[bin];
          bin += 1;
        );
        bin_lo=bin-1;
        bin=NUM_BINS-1;
        while(bin >= lufs_b_gate && lra_cnt_hi < lra_cnt*0.05)
        (
          lra_cnt_hi += lufs_b_hist[bin];
          bin -= 1;
        );
        bin_hi=bin+1;
        lra_db_lo=bin_lo*DB_PER_BIN-70;
        lra_db_hi=bin_hi*DB_PER_BIN-70;
        lra_db_diff = lra_db_hi-lra_db_lo;
      );
    );
  ) : (
    lufs_s_db=-100;
  );

  // Nastro storico anti-deriva 60s (10 Hz; si congela in silenzio/pausa)
  ((play_state & 1) || lufs_m_db > -60 || lufs_s_db > -60) ? (
    hist_s[hist_wr] = lufs_s_db;
    hist_m[hist_wr] = lufs_m_db;
    (hist_wr += 1) >= HIST_LEN ? (hist_wr = 0);
    hist_cnt < HIST_LEN ? ( hist_cnt += 1; );
    hist_active_t = time_precise();
  );
);


@gfx 268 580
<? do_all_channels("ch%d.copypks(); ");?>;

t = time_precise();
draw_dt = last_t ? max(0.001, min(0.25, t - last_t)) : LOUD_METER_SPEED;
speed = last_t ? 1.0 - pow(0.5, draw_dt / LOUD_METER_SPEED) : 1.0;
last_t = t;

ret = max(1.0, gfx_ext_retina);
W = max(24.0, gfx_w / ret);
H = max(24.0, gfx_h / ret);
mx = mouse_x / ret;
my = mouse_y / ret;

// Ponte guida Suite (gmem 3900 = battito Cue Navigator, 3901 = lingua)
zp_hb = gmem[3900];
zp_hb_now = time_precise();
!zp_hb_seen ? ( zp_hb_last = zp_hb; zp_hb_seen = 1; zp_hb_t = -10; ) : zp_hb != zp_hb_last ? ( zp_hb_last = zp_hb; zp_hb_t = zp_hb_now; );
zp_hb_ok = zp_hb > 0 && zp_hb_now - zp_hb_t < 3;
help_bridge_alive = zp_hb_ok;
zp_hb_ok ? ( help_bridge_last_alive_t = t; ui_lang = gmem[3901] == 1 ? 1 : 0; ) :
           ( t - help_bridge_last_alive_t > 3.0 ? ( ui_lang = 0; ); );

has_click = (mouse_cap & 1) && !(last_cap & 1) ? 1 : 0;
has_rclick = (mouse_cap & 2) && !(last_rcap & 2) ? 1 : 0;
last_cap = mouse_cap & 1;
last_rcap = mouse_cap & 2;
tip_active = 0;
#tip_msg = "";

// ============================================================
// HELPER UI v45 (definiti prima di ogni chiamata in @gfx)
// ============================================================
function clamp(x, lo, hi) ( x < lo ? lo : x > hi ? hi : x; );
function msg(it, en) ( ui_lang == 1 ? en : it; );
function meter_db_to_norm(db) ( pow(clamp((db + 60.0) / 63.0, 0.0, 1.0), 1.55); );
function lufs_col_norm(val, tgt, lo_sp, hi_sp) ( clamp((val - (tgt - lo_sp)) / max(0.1, lo_sp + hi_sp), 0.0, 1.0); );

function l_px(v) ( floor((v) * ret + 0.5); );
function l_rect(x, y, w, h) ( gfx_rect(l_px(x), l_px(y), max(1, l_px(w)), max(1, l_px(h))); );
function l_frame(x, y, w, h) local(X, Y, W0, H0, bw) (
  X = l_px(x); Y = l_px(y);
  W0 = max(2, l_px(w)); H0 = max(2, l_px(h));
  bw = max(1, floor(ret * 0.55 + 0.5));
  gfx_rect(X, Y, W0, bw);
  gfx_rect(X, Y + H0 - bw, W0, bw);
  gfx_rect(X, Y, bw, H0);
  gfx_rect(X + W0 - bw, Y, bw, H0);
);
function l_line(x1, y1, x2, y2) ( gfx_line(x1 * ret, y1 * ret, x2 * ret, y2 * ret, 1); );
function l_circ(x, y, r, f) ( gfx_circle(x * ret, y * ret, max(1, r * ret), f, 1); );
function l_font(id, sz, flg) ( gfx_setfont(id, "Arial", max(7, floor(sz * ret + 0.5)), flg); );
function l_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / ret; );
function l_th() local(tw, th) ( gfx_measurestr("Ag", tw, th); th / ret; );
function l_txt(x, y, s) ( gfx_x = l_px(x); gfx_y = l_px(y); gfx_drawstr(s); );
function l_txtc(cx, y, s) ( l_txt(cx - l_tw(s) * 0.5, y, s); );
function l_txtr(xr, y, s) ( l_txt(xr - l_tw(s), y, s); );
function l_txtclip(x, y, r_lim, b_lim, s) ( gfx_x = l_px(x); gfx_y = l_px(y); gfx_drawstr(s, 0, l_px(r_lim), l_px(b_lim)); );
function l_hit(x, y, w, h) ( mx >= x && mx <= x + w && my >= y && my <= y + h; );

function draw_tooltip_box(win_w, win_h, tip_s, dark)
local(slen, max_tw, lh, pos, rem, cut, best_sp, ci, ch_c, nlines, bx, by, bw, bh, li, max_lw) (
  l_font(4, 12, 'b');
  lh = max(15, ceil(l_th() + 3));
  max_tw = max(120, win_w - 32);
  slen = strlen(tip_s);
  nlines = 0; max_lw = 0; pos = 0;
  strcpy(#_tl0, ""); strcpy(#_tl1, ""); strcpy(#_tl2, "");
  while (pos < slen && nlines < 3) (
    while (pos < slen && str_getchar(tip_s, pos) == 32) ( pos += 1; );
    rem = slen - pos;
    rem > 0 ? (
      strcpy_substr(#_tcur, tip_s, pos, rem);
      (l_tw(#_tcur) <= max_tw || nlines == 2) ? (
        cut = rem;
      ) : (
        cut = rem; best_sp = -1; ci = 1;
        while (ci < rem) (
          ch_c = str_getchar(tip_s, pos + ci);
          ch_c == 32 ? (
            strcpy_substr(#_ttmp, tip_s, pos, ci);
            l_tw(#_ttmp) <= max_tw ? ( best_sp = ci; ) : ( ci = rem; );
          );
          ci += 1;
        );
        best_sp > 0 ? ( cut = best_sp; ) : (
          // nessun spazio: taglia per larghezza
          cut = max(1, floor(rem * max_tw / max(1, l_tw(#_tcur))));
        );
      );
      strcpy_substr(#_tcur, tip_s, pos, cut);
      max_lw = max(max_lw, l_tw(#_tcur));
      nlines == 0 ? strcpy(#_tl0, #_tcur) : nlines == 1 ? strcpy(#_tl1, #_tcur) : strcpy(#_tl2, #_tcur);
      nlines += 1;
      pos += cut;
    );
  );
  nlines > 0 ? (
    bw = min(win_w - 12, max_lw + 22);
    bh = nlines * lh + 12;
    bx = floor((win_w - bw) * 0.5);
    by = max(4, win_h - bh - 6);
    gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = dark ? 0.55 : 0.22; l_rect(bx + 2, by + 3, bw, bh);
    gfx_r = pn_r; gfx_g = pn_g; gfx_b = pn_b; gfx_a = 0.98; l_rect(bx, by, bw, bh);
    gfx_r = acc_r; gfx_g = acc_g; gfx_b = acc_b; gfx_a = 0.95; l_frame(bx, by, bw, bh);
    gfx_r = txt_r; gfx_g = txt_g; gfx_b = txt_b; gfx_a = 1.0;
    li = 0;
    loop(nlines,
      l_txtclip(bx + 11, by + 6 + li * lh, bx + bw - 8, by + bh - 4, li == 0 ? #_tl0 : li == 1 ? #_tl1 : #_tl2);
      li += 1;
    );
  );
);

function set_palette(dark) (
  dark ? (
    bg_r = 0.055; bg_g = 0.063; bg_b = 0.082;
    pn_r = 0.092; pn_g = 0.106; pn_b = 0.138;
    well_r = 0.042; well_g = 0.049; well_b = 0.068;
    btn_r = 0.140; btn_g = 0.162; btn_b = 0.212;
    brd_r = 0.220; brd_g = 0.265; brd_b = 0.350;
    txt_r = 0.945; txt_g = 0.960; txt_b = 0.990;
    sub_r = 0.560; sub_g = 0.635; sub_b = 0.745;
    acc_r = 0.240; acc_g = 0.640; acc_b = 0.980;
    grn_r = 0.240; grn_g = 0.880; grn_b = 0.480;
    cyn_r = 0.340; cyn_g = 0.760; cyn_b = 0.980;
    amb_r = 0.980; amb_g = 0.740; amb_b = 0.220;
    red_r = 0.980; red_g = 0.320; red_b = 0.300;
  ) : (
    bg_r = 0.920; bg_g = 0.940; bg_b = 0.970;
    pn_r = 0.972; pn_g = 0.982; pn_b = 0.996;
    well_r = 0.865; well_g = 0.895; well_b = 0.935;
    btn_r = 0.840; btn_g = 0.880; btn_b = 0.935;
    brd_r = 0.660; brd_g = 0.720; brd_b = 0.810;
    txt_r = 0.095; txt_g = 0.125; txt_b = 0.175;
    sub_r = 0.340; sub_g = 0.410; sub_b = 0.505;
    acc_r = 0.095; acc_g = 0.440; acc_b = 0.840;
    grn_r = 0.075; grn_g = 0.545; grn_b = 0.255;
    cyn_r = 0.075; cyn_g = 0.460; cyn_b = 0.780;
    amb_r = 0.760; amb_g = 0.450; amb_b = 0.040;
    red_r = 0.800; red_g = 0.140; red_b = 0.140;
  );
);

function set_target_col(val, tgt, tol) (
  val <= -95 ? ( gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; ) :
  abs(val - tgt) <= tol ? ( gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; ) :
  (val - tgt) < -tol ? ( gfx_r = cyn_r; gfx_g = cyn_g; gfx_b = cyn_b; ) :
  (val - tgt) <= (tol + 1.5) ? ( gfx_r = amb_r; gfx_g = amb_g; gfx_b = amb_b; ) :
                               ( gfx_r = red_r; gfx_g = red_g; gfx_b = red_b; );
);

function set_tp_col(tp_db, has_clip) (
  (has_clip || tp_db > 0.0 || tp_db >= cfg_tp_red) ? ( gfx_r = red_r; gfx_g = red_g; gfx_b = red_b; ) :
  (tp_db >= cfg_tp_red - cfg_tp_yellow_margin) ? ( gfx_r = amb_r; gfx_g = amb_g; gfx_b = amb_b; ) :
                                                 ( gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; );
);

function lock_current_target() local(cand, nv) (
  cand = _hdr_lufs_i > -60 ? _hdr_lufs_i :
         _hdr_lufs_s > -60 ? _hdr_lufs_s :
         _hdr_lufs_m > -60 ? _hdr_lufs_m : -150;
  cand > -60 ? (
    nv = clamp(floor(cand * 10.0 + 0.5) * 0.1, -40.0, 0.0);
    set_sl(39, nv);
    lock_flash_t = t;
    lock_warn_t = -10;
  ) : (
    lock_warn_t = t;
  );
);

function draw_btn(x, y, w, h, lbl, fsz, on, cr, cg, cb, allow_i) local(hov, tw, th, ty) (
  hov = allow_i && l_hit(x, y, w, h);
  on ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = is_dark ? (hov ? 0.34 : 0.22) : (hov ? 0.24 : 0.16);
    l_rect(x, y, w, h);
    gfx_a = hov ? 1.0 : 0.88;
    l_frame(x, y, w, h);
  ) : (
    gfx_r = btn_r; gfx_g = btn_g; gfx_b = btn_b; gfx_a = hov ? 1.0 : 0.88;
    l_rect(x, y, w, h);
    gfx_r = hov ? cr : brd_r; gfx_g = hov ? cg : brd_g; gfx_b = hov ? cb : brd_b; gfx_a = hov ? 0.95 : 0.85;
    l_frame(x, y, w, h);
  );
  l_font(3, fsz, 'b');
  gfx_r = on ? txt_r : (hov ? txt_r : sub_r);
  gfx_g = on ? txt_g : (hov ? txt_g : sub_g);
  gfx_b = on ? txt_b : (hov ? txt_b : sub_b);
  gfx_a = 1.0;
  tw = l_tw(lbl); th = l_th();
  ty = y + (h - th) * 0.5;
  tw <= w - 4 ? l_txtc(x + w * 0.5, ty, lbl) : l_txtclip(x + 2, ty, x + w - 2, y + h, lbl);
  hov && has_click;
);

function draw_rst_btn(x, y, w, h, allow_i, dark) local(hov, fsz, th, tw) (
  hov = allow_i && l_hit(x, y, w, h);
  hov ? (
    tip_active = 1;
    #tip_msg = msg("RST: click breve azzera misure e storico. Tieni 0,5 s per AutoRST allo stop.",
                   "RST: short click clears meters/history. Hold 0.5 s for AutoRST on stop.");
  );
  cfg_clip_reset_stop ? (
    gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = dark ? (hov ? 0.34 : 0.22) : (hov ? 0.24 : 0.16);
    l_rect(x, y, w, h);
    gfx_a = hov ? 1.0 : 0.88; l_frame(x, y, w, h);
  ) : (
    gfx_r = red_r; gfx_g = red_g; gfx_b = red_b; gfx_a = dark ? (hov ? 0.32 : 0.18) : (hov ? 0.22 : 0.12);
    l_rect(x, y, w, h);
    gfx_a = hov ? 0.95 : 0.68; l_frame(x, y, w, h);
  );
  has_click && hov ? (
    reset_pressing = 1; reset_press_t = t; reset_long_done = 0; has_click = 0;
  );
  reset_pressing && (mouse_cap & 1) ? (
    !reset_long_done && (t - reset_press_t) >= 0.5 ? (
      set_sl(20, !cfg_clip_reset_stop);
      reset_long_done = 1;
    );
  );
  reset_pressing && !(mouse_cap & 1) ? (
    !reset_long_done ? Reset();
    reset_pressing = 0;
  );
  fsz = w < 38 ? 9.5 : 10.5;
  l_font(3, fsz, 'b');
  gfx_r = txt_r; gfx_g = txt_g; gfx_b = txt_b; gfx_a = 1.0;
  th = l_th();
  strcpy(#_rlbl, cfg_clip_reset_stop ? (w < 40 ? "RST·A" : "RST·AU") : "RST");
  l_txtc(x + w * 0.5, y + (h - th) * 0.5, #_rlbl);
);

function draw_gear_btn(x, y, w, h, allow_i, dark) local(hov, cx, cy, r_in, r_out, k, a) (
  g_btn_x = x; g_btn_y = y; g_btn_w = w; g_btn_h = h;
  hov = l_hit(x, y, w, h);
  hov ? (
    tip_active = 1;
    #tip_msg = msg("Impostazioni: tolleranza +/-LU, TP RED, velocita' meter, mono/stereo, storico, tema.",
                   "Settings: +/-LU tolerance, TP RED, meter speed, mono/stereo, history, theme.");
  );
  gear_open ? (
    gfx_r = acc_r; gfx_g = acc_g; gfx_b = acc_b; gfx_a = dark ? 0.32 : 0.20; l_rect(x, y, w, h);
    gfx_a = 0.95; l_frame(x, y, w, h);
  ) : (
    gfx_r = btn_r; gfx_g = btn_g; gfx_b = btn_b; gfx_a = hov ? 1.0 : 0.88; l_rect(x, y, w, h);
    gfx_r = hov ? acc_r : brd_r; gfx_g = hov ? acc_g : brd_g; gfx_b = hov ? acc_b : brd_b; gfx_a = 0.85; l_frame(x, y, w, h);
  );
  has_click && hov ? ( gear_open = !gear_open; has_click = 0; );
  cx = x + w * 0.5; cy = y + h * 0.5;
  r_in = min(w, h) * 0.21; r_out = min(w, h) * 0.33;
  gfx_r = gear_open || hov ? txt_r : sub_r;
  gfx_g = gear_open || hov ? txt_g : sub_g;
  gfx_b = gear_open || hov ? txt_b : sub_b;
  gfx_a = 1.0;
  k = 0;
  loop(6,
    a = k * $pi / 3.0;
    l_line(cx + cos(a) * r_in, cy + sin(a) * r_in, cx + cos(a) * r_out, cy + sin(a) * r_out);
    k += 1;
  );
  l_circ(cx, cy, r_in, 0);
  l_circ(cx, cy, max(1.2, r_in * 0.38), 1);
);

function draw_help_btn(x, y, w, h, allow_i, dark) local(hov, th) (
  hov = allow_i && l_hit(x, y, w, h);
  hov ? (
    tip_active = 1;
    #tip_msg = msg("?: apre la guida di ZP Loudness Meter nel browser.", "?: opens ZP Loudness Meter guide in browser.");
  );
  gfx_r = btn_r; gfx_g = btn_g; gfx_b = btn_b; gfx_a = hov ? 1.0 : 0.88; l_rect(x, y, w, h);
  gfx_r = hov ? acc_r : brd_r; gfx_g = hov ? acc_g : brd_g; gfx_b = hov ? acc_b : brd_b; gfx_a = 0.85; l_frame(x, y, w, h);
  l_font(3, 11.5, 'b');
  gfx_r = hov ? acc_r : txt_r; gfx_g = hov ? acc_g : txt_g; gfx_b = hov ? acc_b : txt_b; gfx_a = 1.0;
  th = l_th();
  l_txtc(x + w * 0.5, y + (h - th) * 0.5, "?");
  has_click && hov ? ( help_bridge_open(9); has_click = 0; );
);

function draw_target_pill(x, y, w, h, tgt, allow_i, dark) local(hov, fine, nv, th) (
  hov = allow_i && l_hit(x, y, w, h);
  hov ? (
    tip_active = 1;
    #tip_msg = msg("TARGET LUFS: trascina (Shift fine), rotella o doppio clic per scrivere.",
                   "TARGET LUFS: drag (Shift fine), wheel or double-click to type.");
  );
  ref_edit == 8 ? (
    gfx_r = acc_r; gfx_g = acc_g; gfx_b = acc_b; gfx_a = dark ? 0.25 : 0.16; l_rect(x, y, w, h);
    gfx_a = 1.0; l_frame(x, y, w, h);
    sprintf(#_tp_s, "%s|", #ref_edit_buf);
  ) : (
    gfx_r = well_r; gfx_g = well_g; gfx_b = well_b; gfx_a = 1.0; l_rect(x, y, w, h);
    gfx_r = hov || ui_drag == 39 ? acc_r : brd_r; gfx_g = hov || ui_drag == 39 ? acc_g : brd_g; gfx_b = hov || ui_drag == 39 ? acc_b : brd_b;
    gfx_a = hov || ui_drag == 39 ? 0.95 : 0.80; l_frame(x, y, w, h);
    w >= 112 ? sprintf(#_tp_s, "TARGET %.1f LU", tgt) :
    w >= 84  ? sprintf(#_tp_s, "TGT %.1f LU", tgt) :
               sprintf(#_tp_s, "%.1f LU", tgt);
  );
  l_font(3, w < 92 ? 10 : 10.5, 'b');
  gfx_r = ref_edit == 8 || hov ? acc_r : txt_r;
  gfx_g = ref_edit == 8 || hov ? acc_g : txt_g;
  gfx_b = ref_edit == 8 || hov ? acc_b : txt_b;
  gfx_a = 1.0;
  th = l_th();
  l_txtc(x + w * 0.5, y + (h - th) * 0.5, #_tp_s);

  allow_i && hov && mouse_wheel != 0 ? (
    fine = (mouse_cap & 8) ? 0.1 : 0.5;
    nv = clamp(floor((cfg_lufs_red + (mouse_wheel > 0 ? fine : -fine)) * 10.0 + 0.5) * 0.1, -40.0, 0.0);
    set_sl(39, nv);
    mouse_wheel = 0;
  );
  has_click && hov ? (
    (t - last_click_t2 < 0.45 && last_click_target2 == 8) ? (
      ref_edit = 8; #ref_edit_buf = ""; ui_drag = 0; last_click_t2 = 0;
    ) : (
      ui_drag = 39; ui_drag_y0 = my; ui_drag_v0 = cfg_lufs_red;
      last_click_t2 = t; last_click_target2 = 8;
    );
    has_click = 0;
  );
  allow_i && ui_drag == 39 && (mouse_cap & 1) ? (
    fine = (mouse_cap & 8) ? 0.25 : 1.0;
    nv = clamp(floor((ui_drag_v0 + (ui_drag_y0 - my) * 0.14 * fine) * 10.0 + 0.5) * 0.1, -40.0, 0.0);
    abs(nv - cfg_lufs_red) >= 0.05 ? set_sl(39, nv);
  );
  allow_i && has_rclick && hov ? ( set_sl(39, -18.0); );
);

function draw_lock_btn(x, y, w, h, allow_i, dark) local(hov, fl_ok, fl_wrn, cr, cg, cb, th) (
  hov = allow_i && l_hit(x, y, w, h);
  hov ? (
    tip_active = 1;
    #tip_msg = msg("SEGUI QUI: cattura subito il LUFS attuale come nuovo TARGET da mantenere.",
                   "LOCK NOW: captures current LUFS as the new session TARGET to follow.");
  );
  fl_ok = (t - lock_flash_t) < 0.7;
  fl_wrn = (t - lock_warn_t) < 0.9;
  fl_ok ? ( cr = grn_r; cg = grn_g; cb = grn_b; ) :
  fl_wrn ? ( cr = amb_r; cg = amb_g; cb = amb_b; ) :
           ( cr = acc_r; cg = acc_g; cb = acc_b; );
  gfx_r = cr; gfx_g = cg; gfx_b = cb;
  gfx_a = dark ? (fl_ok ? 0.36 : hov ? 0.30 : 0.18) : (fl_ok ? 0.26 : hov ? 0.22 : 0.13);
  l_rect(x, y, w, h);
  gfx_a = fl_ok || hov ? 1.0 : 0.85; l_frame(x, y, w, h);
  l_font(3, w < 72 ? 9.5 : 10, 'b');
  gfx_r = fl_ok ? grn_r : fl_wrn ? amb_r : txt_r;
  gfx_g = fl_ok ? grn_g : fl_wrn ? amb_g : txt_g;
  gfx_b = fl_ok ? grn_b : fl_wrn ? amb_b : txt_b;
  gfx_a = 1.0;
  th = l_th();
  fl_wrn ? strcpy(#_lk_s, msg("SILENZIO", "NO AUDIO")) :
  fl_ok  ? strcpy(#_lk_s, msg("AGGANC.", "LOCKED")) :
           strcpy(#_lk_s, msg("SEGUI QUI", "LOCK NOW"));
  l_txtc(x + w * 0.5, y + (h - th) * 0.5, #_lk_s);
  has_click && hov ? ( lock_current_target(); has_click = 0; );
);

function tgt_step_val(idx) (
  idx <= 0 ? -24.0 :
  idx == 1 ? -21.0 :
  idx == 2 ? -18.0 :
  idx == 3 ? -16.0 :
  idx == 4 ? -14.0 :
  idx == 5 ? -12.0 :
  idx == 6 ? -10.0 :
  idx == 7 ?  -8.0 : -6.0;
);

function tgt_nearest_idx(val) local(ti, best_i, best_d, td) (
  best_i = 0; best_d = 999.0; ti = 0;
  loop(9,
    td = abs(val - tgt_step_val(ti));
    td < best_d ? ( best_d = td; best_i = ti; );
    ti += 1;
  );
  best_i;
);

function tgt_step_down(val) local(ti, out_i) (
  out_i = 0; ti = 8;
  loop(9,
    tgt_step_val(ti) < val - 0.05 && out_i == 0 ? ( out_i = ti + 1; );
    ti -= 1;
  );
  out_i > 0 ? out_i - 1 : 0;
);

function tgt_step_up(val) local(ti, out_i) (
  out_i = -1; ti = 0;
  loop(9,
    tgt_step_val(ti) > val + 0.05 && out_i < 0 ? ( out_i = ti; );
    ti += 1;
  );
  out_i >= 0 ? out_i : 8;
);

function draw_target_rotor(x, y, w, h, tgt, allow_i, dark)
local(hov, cur_i, exact, ang0, ang_span, pos_f, ang_cur, cx, cy, kr,
      ti, ta, tx_t, ty_t, px0, py0, px1, py1, rx, rw, bw_s, bh_s, by_s,
      hov_m, hov_p, ni, th, sx_b, sw_b, sy_b, sh_b, seg_w, sx_i, hov_s, clicked_sub) (
  cur_i = tgt_nearest_idx(tgt);
  exact = abs(tgt - tgt_step_val(cur_i)) < 0.05;
  // Arco rotore 259 gradi: -24 a ore 7:30 (0.78*pi), -14 a ore 12 (1.50*pi), -6 a ore 4:30 (2.22*pi)
  ang0 = $pi * 0.78;
  ang_span = $pi * 1.44;
  // Posizione continua approssimata se target e' fuori scatto (es. -23.0 o SEGUI QUI)
  pos_f = exact ? cur_i : clamp((tgt + 24.0) / 18.0 * 8.0, 0.0, 8.0);
  ang_cur = ang0 + (pos_f / 8.0) * ang_span;

  hov = allow_i && l_hit(x, y, w, h);
  hov ? (
    tip_active = 1;
    #tip_msg = msg("ROTORE TARGET (9 scatti): trascina, rotella o -/+ per -24, -21, -18, -16, -14, -12, -10, -8, -6 LUFS (clic destro = -18).",
                   "TARGET ROTOR (9 steps): drag, wheel or -/+ for -24, -21, -18, -16, -14, -12, -10, -8, -6 LUFS (right-click = -18).");
  );

  gfx_r = well_r; gfx_g = well_g; gfx_b = well_b; gfx_a = 1.0; l_rect(x, y, w, h);
  gfx_r = hov || ui_drag == 40 ? acc_r : brd_r;
  gfx_g = hov || ui_drag == 40 ? acc_g : brd_g;
  gfx_b = hov || ui_drag == 40 ? acc_b : brd_b;
  gfx_a = hov || ui_drag == 40 ? 0.95 : 0.80; l_frame(x, y, w, h);

  clicked_sub = 0;

  h < 28 ? (
    // Modalita' compatta inline (Barra Orizzontale Bassa, h ~ 20)
    kr = clamp(h * 0.36, 6.0, 8.0);
    cx = x + kr + 5; cy = y + h * 0.5;
    gfx_r = btn_r; gfx_g = btn_g; gfx_b = btn_b; gfx_a = 1.0; l_circ(cx, cy, kr, 1);
    gfx_r = exact ? grn_r : acc_r; gfx_g = exact ? grn_g : acc_g; gfx_b = exact ? grn_b : acc_b; gfx_a = 0.85; l_circ(cx, cy, kr, 0);
    l_line(cx + cos(ang_cur) * (kr * 0.20), cy + sin(ang_cur) * (kr * 0.20),
           cx + cos(ang_cur) * (kr * 0.88), cy + sin(ang_cur) * (kr * 0.88));

    rx = cx + kr + 5; rw = max(40, x + w - rx - 3);
    bw_s = 16; bh_s = max(14, h - 4); by_s = y + (h - bh_s) * 0.5;
    hov_m = allow_i && l_hit(rx, by_s, bw_s, bh_s);
    hov_p = allow_i && l_hit(rx + rw - bw_s, by_s, bw_s, bh_s);
    draw_btn(rx, by_s, bw_s, bh_s, "-", 10, 0, acc_r, acc_g, acc_b, allow_i && tgt > -23.95) ? (
      set_sl(39, tgt_step_val(tgt_step_down(tgt))); has_click = 0; clicked_sub = 1;
    );
    draw_btn(rx + rw - bw_s, by_s, bw_s, bh_s, "+", 10, 0, acc_r, acc_g, acc_b, allow_i && tgt < -6.05) ? (
      set_sl(39, tgt_step_val(tgt_step_up(tgt))); has_click = 0; clicked_sub = 1;
    );
    exact ? sprintf(#_rt_s, "%.0f LU", tgt) : sprintf(#_rt_s, "%.1f LU", tgt);
    l_font(3, 9.5, 'b');
    gfx_r = exact ? grn_r : acc_r; gfx_g = exact ? grn_g : acc_g; gfx_b = exact ? grn_b : acc_b; gfx_a = 1.0;
    th = l_th();
    l_txtc(rx + rw * 0.5, y + (h - th) * 0.5, #_rt_s);
  ) : (
    // Modalita' hardware completa (Studio Larga / Side Dock, h ~ 34..38)
    kr = clamp(h * 0.31, 9.5, 12.5);
    cx = x + kr + 10; cy = y + h * 0.5 + 0.5;

    // 9 tacche luminose attorno all'arco del rotore
    ti = 0;
    loop(9,
      ta = ang0 + (ti / 8.0) * ang_span;
      tx_t = cx + cos(ta) * (kr + 3.4);
      ty_t = cy + sin(ta) * (kr + 3.4);
      ti == cur_i && exact ? (
        gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = 1.0;
        l_circ(tx_t, ty_t, 1.8, 1);
      ) : (
        ti <= cur_i ? ( gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = dark ? 0.55 : 0.45; )
                    : ( gfx_r = dim_r; gfx_g = dim_g; gfx_b = dim_b; gfx_a = dark ? 0.65 : 0.55; );
        l_circ(tx_t, ty_t, 1.15, 1);
      );
      ti += 1;
    );

    // Corpo rotore + ghiera + lancetta
    gfx_r = dark ? 0.14 : 0.88; gfx_g = dark ? 0.16 : 0.90; gfx_b = dark ? 0.19 : 0.93; gfx_a = 1.0;
    l_circ(cx, cy, kr, 1);
    gfx_r = hov || ui_drag == 40 ? acc_r : (exact ? grn_r : brd_r);
    gfx_g = hov || ui_drag == 40 ? acc_g : (exact ? grn_g : brd_g);
    gfx_b = hov || ui_drag == 40 ? acc_b : (exact ? grn_b : brd_b);
    gfx_a = 0.92; l_circ(cx, cy, kr, 0);
    gfx_r = dark ? 0.22 : 0.78; gfx_g = dark ? 0.25 : 0.81; gfx_b = dark ? 0.29 : 0.85; gfx_a = 0.90;
    l_circ(cx, cy, max(2.2, kr * 0.26), 1);

    px0 = cx + cos(ang_cur) * (kr * 0.24); py0 = cy + sin(ang_cur) * (kr * 0.24);
    px1 = cx + cos(ang_cur) * (kr * 0.88); py1 = cy + sin(ang_cur) * (kr * 0.88);
    gfx_r = exact ? grn_r : acc_r; gfx_g = exact ? grn_g : acc_g; gfx_b = exact ? grn_b : acc_b; gfx_a = 1.0;
    l_line(px0, py0, px1, py1);
    l_circ(px1, py1, 1.2, 1);

    // Zona destra: riga superiore (-  VALORE LUFS  +) + riga inferiore (scala cliccabile 9 tacche -24..-6)
    rx = cx + kr + 10; rw = max(72, x + w - rx - 5);
    bw_s = 20; bh_s = 16; by_s = y + 3;
    draw_btn(rx, by_s, bw_s, bh_s, "-", 11, 0, acc_r, acc_g, acc_b, allow_i && tgt > -23.95) ? (
      set_sl(39, tgt_step_val(tgt_step_down(tgt))); has_click = 0; clicked_sub = 1;
    );
    draw_btn(rx + rw - bw_s, by_s, bw_s, bh_s, "+", 11, 0, acc_r, acc_g, acc_b, allow_i && tgt < -6.05) ? (
      set_sl(39, tgt_step_val(tgt_step_up(tgt))); has_click = 0; clicked_sub = 1;
    );

    exact ? sprintf(#_rt_s, "%.0f LUFS", tgt) : sprintf(#_rt_s, "%.1f LUFS", tgt);
    l_font(3, rw >= 136 ? 11.5 : 10.5, 'b');
    gfx_r = exact ? grn_r : acc_r; gfx_g = exact ? grn_g : acc_g; gfx_b = exact ? grn_b : acc_b; gfx_a = 1.0;
    th = l_th();
    l_txtc(rx + rw * 0.5, by_s + (bh_s - th) * 0.5, #_rt_s);

    // Scala inferiore 9 scatti cliccabili (-24 ... -6)
    sy_b = y + h - 12; sh_b = 9;
    l_font(4, 7.5, 'b');
    gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 0.85;
    l_txt(rx, sy_b, "-24");
    l_txtr(rx + rw, sy_b, "-6");

    sx_b = rx + 20; sw_b = max(36, rw - 35);
    seg_w = sw_b / 9.0;
    ti = 0;
    loop(9,
      sx_i = sx_b + ti * seg_w;
      hov_s = allow_i && l_hit(sx_i, sy_b - 1, seg_w, sh_b + 2);
      hov_s && has_click ? (
        set_sl(39, tgt_step_val(ti)); has_click = 0; clicked_sub = 1;
      );
      ti == cur_i && exact ? (
        gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = 1.0;
        l_rect(sx_i + 1, sy_b + 1, max(2, seg_w - 2), sh_b - 2);
      ) : hov_s ? (
        gfx_r = acc_r; gfx_g = acc_g; gfx_b = acc_b; gfx_a = 0.85;
        l_rect(sx_i + 1, sy_b + 2, max(2, seg_w - 2), sh_b - 4);
      ) : (
        ti < cur_i ? ( gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = dark ? 0.34 : 0.28; )
                   : ( gfx_r = dim_r; gfx_g = dim_g; gfx_b = dim_b; gfx_a = dark ? 0.45 : 0.38; );
        l_rect(sx_i + 1, sy_b + 3, max(2, seg_w - 2), max(2, sh_b - 6));
      );
      ti += 1;
    );
  );

  // Interazioni dirette sul rotore: rotella, trascinamento a scatti, clic destro reset (-18)
  allow_i && hov && mouse_wheel != 0 ? (
    ni = mouse_wheel > 0 ? tgt_step_up(tgt) : tgt_step_down(tgt);
    set_sl(39, tgt_step_val(ni));
    mouse_wheel = 0;
  );
  allow_i && !clicked_sub && has_click && hov ? (
    ui_drag = 40; ui_drag_y0 = my; ui_drag_v0 = cur_i;
    has_click = 0;
  );
  allow_i && ui_drag == 40 && (mouse_cap & 1) ? (
    ni = clamp(floor(ui_drag_v0 + (ui_drag_y0 - my) / 14.0 + 0.5), 0, 8);
    abs(tgt_step_val(ni) - cfg_lufs_red) >= 0.05 ? set_sl(39, tgt_step_val(ni));
  );
  allow_i && has_rclick && hov ? ( set_sl(39, -18.0); );
);

function draw_hero_card(x, y, w, h, val_i, tgt, tol, dark, compact)
local(diff, has_v, bx, bw, bh_s, pad_h, tr_x, tr_w, tr_y, tr_h, g0, g1, nx, nw, nh,
      lbl_sz, bdg_sz, h_sz, d_sz, dw_d, avail_mid, sc_m, top_y0, bot_y1, mid_y, dh_d) (
  has_v = val_i > -95;
  diff = val_i - tgt;

  gfx_r = pn_r; gfx_g = pn_g; gfx_b = pn_b; gfx_a = 1.0; l_rect(x, y, w, h);
  set_target_col(val_i, tgt, tol); gfx_a = 0.92; l_rect(x, y, 3, h);
  gfx_r = brd_r; gfx_g = brd_g; gfx_b = brd_b; gfx_a = 0.85; l_frame(x, y, w, h);

  pad_h = w < 195 ? 7 : 10;
  !has_v ? strcpy(#_st_s, msg("ATTESA", "WAIT")) :
  abs(diff) <= tol ? strcpy(#_st_s, w < 195 ? "OK" : "IN TARGET") :
  diff < -tol ? strcpy(#_st_s, msg("SOTTO", "LOW")) :
  diff <= (tol + 1.5) ? strcpy(#_st_s, msg("ALTO", "WARM")) :
                        strcpy(#_st_s, msg("OLTRE", "OVER"));

  // Dimensioni font proporzionali a larghezza e altezza della card
  lbl_sz = clamp(min(h * 0.145, w * 0.056), 9.5, 14.5);
  bdg_sz = clamp(lbl_sz * 0.90, 8.5, 13.0);
  h_sz = compact ? clamp(min(h * 0.42, w * 0.175), 18, 34) : clamp(min(h * 0.46, w * 0.21), 22, 60);
  d_sz = clamp(h_sz * 0.56, 13, 32);

  // Top row: LUFS-I label + badge stato
  l_font(4, lbl_sz, 'b');
  gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1.0;
  w >= 210 ? sprintf(#_hlbl, "LUFS-I  (±%.1f)", tol) : strcpy(#_hlbl, "LUFS-I");
  l_txt(x + pad_h, y + 5, #_hlbl);

  l_font(4, bdg_sz, 'b');
  bw = l_tw(#_st_s) + 12; bh_s = max(14, ceil(bdg_sz + 6));
  bx = x + w - pad_h - bw;
  set_target_col(val_i, tgt, tol); gfx_a = dark ? 0.22 : 0.14; l_rect(bx, y + 4, bw, bh_s);
  gfx_a = 0.88; l_frame(bx, y + 4, bw, bh_s);
  gfx_a = 1.0; l_txtc(bx + bw * 0.5, y + 4 + (bh_s - l_th()) * 0.5, #_st_s);

  // Middle row: numero HERO + delta scarto (adattati per non sovrapporsi mai)
  has_v ? sprintf(#_hval, "%.1f", val_i) : strcpy(#_hval, "--");
  has_v ? sprintf(#_hdl, "%+.1f", diff) : strcpy(#_hdl, "--");
  l_font(1, h_sz, 'b');
  nw = l_tw(#_hval);
  l_font(2, d_sz, 'b');
  dw_d = l_tw(#_hdl);
  avail_mid = max(60, w - pad_h * 2 - 14);
  (nw + dw_d) > avail_mid ? (
    sc_m = avail_mid / max(1, nw + dw_d);
    h_sz = max(16, h_sz * sc_m);
    d_sz = max(11, d_sz * sc_m);
  );
  tr_h = h >= 54 ? clamp(floor(h * 0.095), 7, 11) : 0;
  top_y0 = y + bh_s + 5;
  bot_y1 = h >= 54 ? (y + h - tr_h - 8) : (y + h - 4);
  l_font(1, h_sz, 'b');
  nh = l_th();
  mid_y = top_y0 + max(0, (bot_y1 - top_y0 - nh) * 0.5);
  set_target_col(val_i, tgt, tol); gfx_a = 1.0;
  l_txt(x + pad_h, mid_y, #_hval);
  nw = l_tw(#_hval);
  (w >= 250 && (nw + dw_d + 42) < avail_mid) ? (
    l_font(4, clamp(lbl_sz, 9.5, 13.5), 0); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 0.85;
    l_txt(x + pad_h + nw + 5, mid_y + nh - l_th() - 2, "LUFS");
  );

  l_font(2, d_sz, 'b');
  dh_d = l_th();
  set_target_col(val_i, tgt, tol); gfx_a = 1.0;
  l_txtr(x + w - pad_h, mid_y + (nh - dh_d) * 0.35, #_hdl);
  (w >= 195 && (bot_y1 - (mid_y + (nh - dh_d) * 0.35 + dh_d)) >= 9) ? (
    l_font(4, clamp(lbl_sz * 0.85, 8.5, 11.5), 0); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 0.80;
    l_txtr(x + w - pad_h, mid_y + (nh - dh_d) * 0.35 + dh_d + 1, w >= 230 ? "scarto Δ LU" : "Δ LU");
  );

  // Bottom spirit level bar (±6 LU)
  h >= 54 ? (
    tr_x = x + pad_h; tr_w = w - pad_h * 2; tr_y = y + h - tr_h - 5;
    gfx_r = well_r; gfx_g = well_g; gfx_b = well_b; gfx_a = 1.0; l_rect(tr_x, tr_y, tr_w, tr_h);
    g0 = clamp((-tol + 6.0) / 12.0, 0.0, 1.0);
    g1 = clamp((tol + 6.0) / 12.0, 0.0, 1.0);
    gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = dark ? 0.28 : 0.24;
    l_rect(tr_x + g0 * tr_w, tr_y, max(2, (g1 - g0) * tr_w), tr_h);
    gfx_r = txt_r; gfx_g = txt_g; gfx_b = txt_b; gfx_a = 0.35;
    l_rect(tr_x + tr_w * 0.5, tr_y - 1, 1, tr_h + 2);
    has_v ? (
      nx = tr_x + clamp((diff + 6.0) / 12.0, 0.0, 1.0) * tr_w;
      set_target_col(val_i, tgt, tol); gfx_a = 1.0;
      l_rect(nx - 2.5, tr_y - 2, 5, tr_h + 4);
    );
  );
);

function draw_stat_card(x, y, w, h, lbl, val_s, cr, cg, cb, badge_s, br, bg, bb, allow_i, dark)
local(hov, pad_s, bdw, th, l_sz, v_sz, l_h, avail_w, avail_h, vw) (
  hov = allow_i && l_hit(x, y, w, h);
  gfx_r = pn_r; gfx_g = pn_g; gfx_b = pn_b; gfx_a = 1.0; l_rect(x, y, w, h);
  gfx_r = hov ? br : brd_r; gfx_g = hov ? bg : brd_g; gfx_b = hov ? bb : brd_b; gfx_a = hov ? 0.90 : 0.80; l_frame(x, y, w, h);
  pad_s = w < 90 ? 5 : 8;
  l_sz = clamp(min(h * 0.22, w * 0.11), 8.5, 14.0);
  l_font(4, l_sz, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1.0;
  l_h = l_th();
  l_txt(x + pad_s, y + 3.5, lbl);
  strlen(badge_s) > 0 ? (
    l_font(4, clamp(l_sz * 0.85, 7.5, 11.5), 'b'); bdw = l_tw(badge_s) + 8;
    gfx_r = br; gfx_g = bg; gfx_b = bb; gfx_a = dark ? 0.90 : 0.85;
    l_rect(x + w - pad_s - bdw, y + 3, bdw, max(11, ceil(l_h)));
    gfx_r = 0.98; gfx_g = 0.98; gfx_b = 0.99; gfx_a = 1.0;
    l_txtc(x + w - pad_s - bdw * 0.5, y + 3.5, badge_s);
  );
  avail_w = max(36, w - pad_s * 2);
  avail_h = max(14, h - l_h - 8);
  v_sz = clamp(min(avail_h * 0.82, avail_w * 0.28), 13.5, 42.0);
  l_font(2, v_sz, 'b');
  vw = l_tw(val_s);
  vw > avail_w ? (
    v_sz = max(11.5, v_sz * (avail_w / max(1, vw)));
    l_font(2, v_sz, 'b');
  );
  gfx_r = cr; gfx_g = cg; gfx_b = cb; gfx_a = 1.0;
  th = l_th();
  l_txt(x + pad_s, y + l_h + 4 + max(0, (avail_h - th) * 0.5), val_s);
  hov && has_click;
);

function draw_v_meters(x, y, w, h, vis_ch, ch_start, full_ch, tgt, tol, val_s, val_i, dark, allow_i)
local(top_band, ax_w, lufs_w, ch_box_x, ch_box_w, bar_top, bar_bot, bar_h, gap_c, bar_w, tot_w, bx0,
      i, ch, pv, cur_db, norm_v, seg_n, seg_h, seg_g, si, sdb, sy, sh, lit, sr, sg, sb, h_y, tp_y,
      cx_c, ly_0, ly_1, ly_t, lufs_x, lufs_bx, lufs_bw, s_norm, sy_s, iy_i, prev_ly,
      k, adb, ay, bank_cnt, prev_x, next_x, ch_has_clip) (

  gfx_r = pn_r; gfx_g = pn_g; gfx_b = pn_b; gfx_a = 1.0; l_rect(x, y, w, h);
  gfx_r = brd_r; gfx_g = brd_g; gfx_b = brd_b; gfx_a = 0.82; l_frame(x, y, w, h);

  top_band = full_ch > vis_ch ? 18 : 0;
  top_band > 0 ? (
    bank_cnt = ceil(full_ch / vis_ch);
    sprintf(#_bnk_s, "CH %d-%d / %d", ch_start + 1, ch_start + vis_ch, full_ch);
    l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1.0;
    l_txtc(x + w * 0.5, y + 4, #_bnk_s);
    prev_x = x + 6; next_x = x + w - 24;
    draw_btn(prev_x, y + 2, 18, 14, "<", 9, 0, acc_r, acc_g, acc_b, allow_i) ? (
      set_sl(18, 2);
      set_sl(19, (floor(cfg_chan_bank + 0.5) - 1 + bank_cnt) % bank_cnt);
      has_click = 0;
    );
    draw_btn(next_x, y + 2, 18, 14, ">", 9, 0, acc_r, acc_g, acc_b, allow_i) ? (
      set_sl(18, 2);
      set_sl(19, (floor(cfg_chan_bank + 0.5) + 1) % bank_cnt);
      has_click = 0;
    );
  );

  ax_w = w >= 185 ? 24 : 18;
  lufs_w = w >= 210 ? 54 : w >= 165 ? 44 : 36;
  ch_box_x = x + ax_w + 2;
  ch_box_w = max(32, w - ax_w - lufs_w - 8);
  bar_top = y + top_band + 18;
  bar_bot = y + h - 18;
  bar_h = max(24, bar_bot - bar_top);

  // Griglia orizzontale dB + scala asse sinistro
  l_font(4, 8.5, 0);
  prev_ly = -9999;
  k = 0;
  loop(7,
    adb = k == 0 ? 0 : k == 1 ? -6 : k == 2 ? -12 : k == 3 ? -18 : k == 4 ? -24 : k == 5 ? -36 : -48;
    ay = bar_bot - meter_db_to_norm(adb) * bar_h;
    gfx_r = txt_r; gfx_g = txt_g; gfx_b = txt_b; gfx_a = adb == 0 ? 0.20 : 0.08;
    l_line(ch_box_x, ay, ch_box_x + ch_box_w, ay);
    abs(ay - prev_ly) >= 12 ? (
      gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 0.85;
      sprintf(#_axd, "%d", adb);
      l_txtr(ch_box_x - 3, ay - 5, #_axd);
      prev_ly = ay;
    );
    k += 1;
  );

  // Calcolo larghezza barre canali
  gap_c = vis_ch <= 2 ? 8 : vis_ch <= 4 ? 5 : 3;
  bar_w = clamp(floor((ch_box_w - 8 - (vis_ch - 1) * gap_c) / vis_ch), 7, 36);
  tot_w = vis_ch * bar_w + (vis_ch - 1) * gap_c;
  bx0 = ch_box_x + floor((ch_box_w - tot_w) * 0.5);

  seg_n = clamp(floor(bar_h / 3.5), 10, 44);
  seg_g = 1;
  seg_h = max(1.2, (bar_h - (seg_n - 1) * seg_g) / seg_n);

  i = 0;
  loop(vis_ch,
    ch = ch_start + i;
    cx_c = bx0 + i * (bar_w + gap_c);
    pv = pk[ch];
    cur_db = (cfg_peak > 0 && pv > 0) ? (log(pv) * 20.0 / log(10.0)) : -150;
    norm_v = meter_db_to_norm(cur_db);
    ch_has_clip = cfg_peak > 0 && clip_cnt[ch] > 0;

    gfx_r = well_r; gfx_g = well_g; gfx_b = well_b; gfx_a = 1.0;
    l_rect(cx_c, bar_top, bar_w, bar_h);

    si = 0;
    loop(seg_n,
      sdb = -60.0 + (si / max(1, seg_n - 1)) * 63.0;
      lit = cfg_peak > 0 && cur_db >= sdb;
      sdb >= cfg_tp_red ? ( sr = red_r; sg = red_g; sb = red_b; ) :
      sdb >= cfg_tp_red - cfg_tp_yellow_margin ? ( sr = amb_r; sg = amb_g; sb = amb_b; ) :
                                                 ( sr = grn_r; sg = grn_g; sb = grn_b; );
      gfx_r = sr; gfx_g = sg; gfx_b = sb;
      gfx_a = lit ? 0.96 : (dark ? 0.14 : 0.16);
      sy = bar_bot - (si + 1) * (seg_h + seg_g) + seg_g;
      l_rect(cx_c + 1, sy, max(2, bar_w - 2), seg_h);
      si += 1;
    );

    // Floating Peak Hold cap
    cfg_peak > 0 && ch_pk_hold[ch] > -60 ? (
      h_y = bar_bot - meter_db_to_norm(ch_pk_hold[ch]) * bar_h;
      set_tp_col(ch_pk_hold[ch], ch_has_clip); gfx_a = 1.0;
      l_rect(cx_c, h_y - 1, bar_w, 2);
    );

    // Spia CLIP o numero picco in cima
    ch_has_clip ? (
      gfx_r = red_r; gfx_g = red_g; gfx_b = red_b; gfx_a = 1.0;
      l_rect(cx_c, bar_top - 4, bar_w, 3);
      allow_i && has_click && l_hit(cx_c - 2, bar_top - 16, bar_w + 4, 18) ? ( reset_peaks_only(); has_click = 0; );
    );
    bar_w >= 20 && cfg_peak > 0 && ch_pk_hold[ch] > -70 ? (
      l_font(4, 8, 'b');
      set_tp_col(ch_pk_hold[ch], ch_has_clip); gfx_a = 0.95;
      sprintf(#_pkch, "%.1f", ch_pk_hold[ch]);
      l_txtc(cx_c + bar_w * 0.5, bar_top - 15, #_pkch);
    );

    // Etichetta canale sotto
    l_font(4, 9, 'b');
    gfx_r = ch_has_clip ? red_r : sub_r; gfx_g = ch_has_clip ? red_g : sub_g; gfx_b = ch_has_clip ? red_b : sub_b; gfx_a = 1.0;
    cfg_mono ? strcpy(#_ch_lbl, "M") :
    full_ch == 2 ? strcpy(#_ch_lbl, ch == 0 ? "L" : "R") :
                   sprintf(#_ch_lbl, "%d", ch + 1);
    l_txtc(cx_c + bar_w * 0.5, bar_bot + 3, #_ch_lbl);
    i += 1;
  );

  // Linea orizzontale TP RED attraverso tutti i canali
  cfg_peak > 0 ? (
    tp_y = bar_bot - meter_db_to_norm(cfg_tp_red) * bar_h;
    gfx_r = red_r; gfx_g = red_g; gfx_b = red_b; gfx_a = 0.85;
    l_line(bx0 - 3, tp_y, bx0 + tot_w + 3, tp_y);
  );

  // Separatore verticale e colonna dedicata LUFS-S / I centrata su TARGET (±tol verde)
  lufs_x = x + w - lufs_w - 2;
  gfx_r = brd_r; gfx_g = brd_g; gfx_b = brd_b; gfx_a = 0.55;
  l_line(lufs_x, y + top_band + 6, lufs_x, y + h - 6);

  lufs_bw = clamp(lufs_w - 16, 12, 24);
  lufs_bx = lufs_x + floor((lufs_w - lufs_bw) * 0.5);
  gfx_r = well_r; gfx_g = well_g; gfx_b = well_b; gfx_a = 1.0;
  l_rect(lufs_bx, bar_top, lufs_bw, bar_h);

  // Fascia verde ±tol centrata sul target (scala finestra: tgt-16 .. tgt+8)
  ly_0 = bar_bot - lufs_col_norm(tgt - tol, tgt, 16.0, 8.0) * bar_h;
  ly_1 = bar_bot - lufs_col_norm(tgt + tol, tgt, 16.0, 8.0) * bar_h;
  gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = dark ? 0.22 : 0.20;
  l_rect(lufs_bx - 4, ly_1, lufs_bw + 8, max(2, ly_0 - ly_1));

  // Barra live LUFS-S
  val_s > -95 ? (
    s_norm = lufs_col_norm(val_s, tgt, 16.0, 8.0);
    sy_s = bar_bot - s_norm * bar_h;
    set_target_col(val_s, tgt, tol); gfx_a = 0.92;
    l_rect(lufs_bx + 2, sy_s, max(4, lufs_bw - 4), max(1, bar_bot - sy_s));
  );

  // Tacca centrale Target e cursore orizzontale LUFS-I
  ly_t = bar_bot - lufs_col_norm(tgt, tgt, 16.0, 8.0) * bar_h;
  gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = 0.85;
  l_line(lufs_bx - 5, ly_t, lufs_bx + lufs_bw + 5, ly_t);

  val_i > -95 ? (
    iy_i = bar_bot - lufs_col_norm(val_i, tgt, 16.0, 8.0) * bar_h;
    gfx_r = dark ? 0.96 : 0.08; gfx_g = dark ? 0.98 : 0.12; gfx_b = dark ? 1.0 : 0.18; gfx_a = 0.98;
    l_rect(lufs_bx - 4, iy_i - 1.2, lufs_bw + 8, 2.4);
  );

  l_font(4, 8, 'b'); gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = 0.95;
  sprintf(#_tgh, "%.0f", tgt);
  l_txtc(lufs_bx + lufs_bw * 0.5, bar_top - 15, #_tgh);
  gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1.0;
  l_txtc(lufs_bx + lufs_bw * 0.5, bar_bot + 3, "S / I");
);

function draw_h_meters(x, y, w, h, vis_ch, ch_start, full_ch, tgt, tol, val_s, val_i, dark, allow_i)
local(ch_n, row_h, gap_r, i, ch, ry, lbl_w, val_w, bx, bw, pv, cur_db, nv, hx, tx_r,
      ly_x, ly_w, g0, g1, sx, ix, ch_has_clip) (
  gfx_r = pn_r; gfx_g = pn_g; gfx_b = pn_b; gfx_a = 1.0; l_rect(x, y, w, h);
  gfx_r = brd_r; gfx_g = brd_g; gfx_b = brd_b; gfx_a = 0.82; l_frame(x, y, w, h);

  ch_n = min(vis_ch, 2);
  gap_r = 4;
  row_h = max(10, floor((h - 12 - gap_r * ch_n) / (ch_n + 1)));
  lbl_w = 24; val_w = 38;
  bx = x + lbl_w + 6;
  bw = max(30, w - lbl_w - val_w - 14);

  i = 0;
  loop(ch_n,
    ch = ch_start + i;
    ry = y + 6 + i * (row_h + gap_r);
    pv = pk[ch];
    cur_db = (cfg_peak > 0 && pv > 0) ? (log(pv) * 20.0 / log(10.0)) : -150;
    ch_has_clip = cfg_peak > 0 && clip_cnt[ch] > 0;

    l_font(4, 8.5, 'b'); gfx_r = ch_has_clip ? red_r : sub_r; gfx_g = ch_has_clip ? red_g : sub_g; gfx_b = ch_has_clip ? red_b : sub_b; gfx_a = 1.0;
    cfg_mono ? strcpy(#_hlb, "M") : full_ch == 2 ? strcpy(#_hlb, ch == 0 ? "L" : "R") : sprintf(#_hlb, "C%d", ch + 1);
    l_txt(x + 6, ry + (row_h - l_th()) * 0.5, #_hlb);

    gfx_r = well_r; gfx_g = well_g; gfx_b = well_b; gfx_a = 1.0; l_rect(bx, ry, bw, row_h);
    cfg_peak > 0 ? (
      nv = meter_db_to_norm(cur_db);
      nv > 0 ? (
        cur_db >= cfg_tp_red ? ( gfx_r = red_r; gfx_g = red_g; gfx_b = red_b; ) :
        cur_db >= cfg_tp_red - cfg_tp_yellow_margin ? ( gfx_r = amb_r; gfx_g = amb_g; gfx_b = amb_b; ) :
                                                      ( gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; );
        gfx_a = 0.94; l_rect(bx + 1, ry + 1, max(1, (bw - 2) * nv), max(2, row_h - 2));
      );
      ch_pk_hold[ch] > -60 ? (
        hx = bx + meter_db_to_norm(ch_pk_hold[ch]) * bw;
        set_tp_col(ch_pk_hold[ch], ch_has_clip); gfx_a = 1.0;
        l_rect(hx - 1, ry, 2, row_h);
      );
      tx_r = bx + meter_db_to_norm(cfg_tp_red) * bw;
      gfx_r = red_r; gfx_g = red_g; gfx_b = red_b; gfx_a = 0.80;
      l_line(tx_r, ry - 1, tx_r, ry + row_h + 1);
    );

    l_font(4, 8.5, 'b');
    set_tp_col(ch_pk_hold[ch], ch_has_clip); gfx_a = 0.95;
    ch_pk_hold[ch] > -70 ? sprintf(#_hpk, "%.1f", ch_pk_hold[ch]) : strcpy(#_hpk, "--");
    l_txtr(x + w - 6, ry + (row_h - l_th()) * 0.5, #_hpk);
    i += 1;
  );

  // Riga inferiore: barra orizzontale LUFS-S/I con corridoio verde ±tol attorno al target
  ry = y + 6 + ch_n * (row_h + gap_r);
  l_font(4, 8.5, 'b'); gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = 1.0;
  l_txt(x + 6, ry + (row_h - l_th()) * 0.5, "S/I");
  ly_x = bx; ly_w = bw;
  gfx_r = well_r; gfx_g = well_g; gfx_b = well_b; gfx_a = 1.0; l_rect(ly_x, ry, ly_w, row_h);
  g0 = lufs_col_norm(tgt - tol, tgt, 12.0, 6.0);
  g1 = lufs_col_norm(tgt + tol, tgt, 12.0, 6.0);
  gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = dark ? 0.22 : 0.20;
  l_rect(ly_x + g0 * ly_w, ry - 1, max(2, (g1 - g0) * ly_w), row_h + 2);
  val_s > -95 ? (
    sx = ly_x + lufs_col_norm(val_s, tgt, 12.0, 6.0) * ly_w;
    set_target_col(val_s, tgt, tol); gfx_a = 0.90;
    l_rect(ly_x + 1, ry + 2, max(2, sx - ly_x - 1), max(2, row_h - 4));
  );
  gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = 0.85;
  l_line(ly_x + lufs_col_norm(tgt, tgt, 12.0, 6.0) * ly_w, ry - 1, ly_x + lufs_col_norm(tgt, tgt, 12.0, 6.0) * ly_w, ry + row_h + 1);
  val_i > -95 ? (
    ix = ly_x + lufs_col_norm(val_i, tgt, 12.0, 6.0) * ly_w;
    gfx_r = dark ? 0.96 : 0.08; gfx_g = dark ? 0.98 : 0.12; gfx_b = dark ? 1.0 : 0.18; gfx_a = 0.98;
    l_rect(ix - 1.2, ry - 1, 2.4, row_h + 2);
  );
  l_font(4, 8.5, 'b'); set_target_col(val_s, tgt, tol); gfx_a = 1.0;
  val_s > -95 ? sprintf(#_hsi, "%.1f", val_s) : strcpy(#_hsi, "--");
  l_txtr(x + w - 6, ry + (row_h - l_th()) * 0.5, #_hsi);
);

function draw_history_ribbon(x, y, w, h, tgt, tol, val_i, dark, rng_lu, show_time_ticks)
local(px, py, pw, ph, cy_t, y_top_g, y_bot_g, y_li, mono_off, k, idx, vs, vm, cx, cy, pm_x, pm_y, ps_x, ps_y,
      live_ok, x_tick, gt, hdr_x2) (
  gfx_r = pn_r; gfx_g = pn_g; gfx_b = pn_b; gfx_a = 1.0; l_rect(x, y, w, h);
  gfx_r = brd_r; gfx_g = brd_g; gfx_b = brd_b; gfx_a = 0.82; l_frame(x, y, w, h);

  l_hit(x, y, w, h) ? (
    tip_active = 1;
    #tip_msg = msg("DERIVA 60s: andamento LUFS-S (media 3s) rispetto al TARGET. Fascia verde = in target (±tol); sopra stai spingendo, sotto stai calando; linea sottile = LUFS-I.",
                   "DRIFT 60s: 3s Short-Term LUFS vs TARGET over the last 60s. Green band = on target (±tol); above = too hot, below = dropping; thin line = LUFS-I.");
  );

  l_font(4, 8.5, 'b');
  gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1.0;
  l_txt(x + 8, y + 3.5, msg("DERIVA 60s", "DRIFT 60s"));
  live_ok = (t - hist_active_t) < 0.6;
  gfx_r = live_ok ? grn_r : amb_r; gfx_g = live_ok ? grn_g : amb_g; gfx_b = live_ok ? grn_b : amb_b; gfx_a = 0.95;
  l_circ(x + 76, y + 8, 2.5, 1);
  hdr_x2 = x + 84;
  !live_ok ? (
    l_font(4, 8, 'b');
    l_txt(hdr_x2, y + 3.5, hist_cnt > 0 ? msg("FERMO", "PAUSED") : msg("IN ATTESA", "WAITING"));
    hdr_x2 += 56;
  ) : (
    l_font(4, 8, 'b');
    l_txt(hdr_x2, y + 3.5, "LIVE");
    hdr_x2 += 32;
  );
  w >= 260 ? (
    l_font(4, 8, 0); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 0.82;
    l_txtclip(hdr_x2, y + 3.5, x + w - 48, y + 16, msg("LUFS-S 3s vs Target · verde ±tol", "3s LUFS-S vs Target · green ±tol"));
  );
  l_font(4, 8, 0); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 0.85;
  sprintf(#_drng, "±%.0f LU", rng_lu);
  l_txtr(x + w - 8, y + 3.5, #_drng);

  px = x + 6; py = y + 17; pw = max(20, w - 12); ph = max(18, h - 22 - (show_time_ticks ? 12 : 0));
  gfx_r = well_r; gfx_g = well_g; gfx_b = well_b; gfx_a = 1.0; l_rect(px, py, pw, ph);

  // Griglia +/- meta' scala + etichette + / TGT / - sul lato sinistro
  gt = rng_lu * 0.5;
  y_top_g = py + ph * (0.5 - gt / (2.0 * rng_lu));
  y_bot_g = py + ph * (0.5 + gt / (2.0 * rng_lu));
  gfx_r = txt_r; gfx_g = txt_g; gfx_b = txt_b; gfx_a = 0.08;
  l_line(px, y_top_g, px + pw, y_top_g);
  l_line(px, y_bot_g, px + pw, y_bot_g);
  ph >= 46 ? (
    l_font(4, 7.5, 0); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 0.65;
    l_txt(px + 3, py + 2, msg("+ ALTO", "+ HOT"));
    l_txt(px + 3, py + ph * 0.5 - 5, "TGT");
    l_txt(px + 3, py + ph - 11, msg("- BASSO", "- LOW"));
  );

  show_time_ticks ? (
    l_font(4, 8, 0);
    k = 0;
    loop(3,
      x_tick = k == 0 ? px + 2 : k == 1 ? px + pw * 0.5 : px + pw - 2;
      k == 1 ? ( gfx_r = txt_r; gfx_g = txt_g; gfx_b = txt_b; gfx_a = 0.08; l_line(x_tick, py, x_tick, py + ph); );
      gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 0.78;
      k == 0 ? l_txt(px + 2, py + ph + 2, "-60s") :
      k == 1 ? l_txtc(px + pw * 0.5, py + ph + 2, "-30s") :
               l_txtr(px + pw - 2, py + ph + 2, "NOW");
      k += 1;
    );
  );

  // Corridoio verde ±tol centrato sul target
  y_top_g = py + ph * clamp(0.5 - tol / (2.0 * rng_lu), 0.0, 1.0);
  y_bot_g = py + ph * clamp(0.5 + tol / (2.0 * rng_lu), 0.0, 1.0);
  gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = dark ? 0.18 : 0.16;
  l_rect(px, y_top_g, pw, max(2, y_bot_g - y_top_g));
  cy_t = py + ph * 0.5;
  gfx_a = 0.55; l_line(px, cy_t, px + pw, cy_t);

  // Linea orizzontale LUFS-I di confronto
  val_i > -95 ? (
    y_li = py + ph * clamp(0.5 - (val_i - tgt) / (2.0 * rng_lu), 0.0, 1.0);
    gfx_r = dark ? 0.92 : 0.12; gfx_g = dark ? 0.96 : 0.18; gfx_b = dark ? 1.0 : 0.25; gfx_a = 0.42;
    l_line(px, y_li, px + pw, y_li);
  );

  mono_off = cfg_mono ? -3.0 : 0.0;

  // Pass 1: traccia tenue LUFS-M
  hist_cnt >= 2 ? (
    pm_x = -1; k = 0;
    loop(hist_cnt,
      idx = hist_wr - hist_cnt + k;
      idx < 0 ? ( idx += HIST_LEN; );
      vm = hist_m[idx];
      vm > -72 ? (
        vm += mono_off;
        cx = px + pw - (hist_cnt - 1 - k) * pw / (HIST_LEN - 1);
        cy = py + ph * clamp(0.5 - (vm - tgt) / (2.0 * rng_lu), 0.0, 1.0);
        pm_x >= 0 ? (
          gfx_r = acc_r; gfx_g = acc_g; gfx_b = acc_b; gfx_a = dark ? 0.28 : 0.24;
          l_line(pm_x, pm_y, cx, cy);
        );
        pm_x = cx; pm_y = cy;
      ) : ( pm_x = -1; );
      k += 1;
    );

    // Pass 2: curva principale LUFS-S colorata per fascia target
    ps_x = -1; k = 0;
    loop(hist_cnt,
      idx = hist_wr - hist_cnt + k;
      idx < 0 ? ( idx += HIST_LEN; );
      vs = hist_s[idx];
      vs > -72 ? (
        vs += mono_off;
        cx = px + pw - (hist_cnt - 1 - k) * pw / (HIST_LEN - 1);
        cy = py + ph * clamp(0.5 - (vs - tgt) / (2.0 * rng_lu), 0.0, 1.0);
        ps_x >= 0 ? (
          set_target_col(vs, tgt, tol); gfx_a = 0.96;
          l_line(ps_x, ps_y, cx, cy);
          l_line(ps_x, ps_y + 0.85, cx, cy + 0.85);
        );
        ps_x = cx; ps_y = cy;
      ) : ( ps_x = -1; );
      k += 1;
    );
    ps_x >= 0 ? (
      idx = hist_wr - 1; idx < 0 ? ( idx += HIST_LEN; );
      set_target_col(hist_s[idx] + mono_off, tgt, tol); gfx_a = 1.0;
      l_circ(ps_x, ps_y, 2.5, 1);
    );
  );
);

function draw_gear_drawer(btn_r, btn_b, dark, vis_ch, full_ch, is_strip_m)
local(ncols, dw, dh, dx, dy, rh, gap_y, rows_n, col_w, i_row, c_x, c_y,
      tol_next, spd_next, mode_next, k) (
  ncols = (W >= 540 && H < 210) ? 3 : (W >= 360 && H < 360) ? 2 : 1;
  dw = ncols == 3 ? min(W - 12, 580) : ncols == 2 ? min(W - 12, 412) : min(W - 12, 238);
  rh = ncols == 3 ? 18 : 21;
  gap_y = ncols == 3 ? 3 : 4;
  rows_n = ceil(11 / ncols);
  dh = 10 + rows_n * (rh + gap_y);
  dx = clamp(btn_r - dw, 6, max(6, W - dw - 6));
  dy = clamp(btn_b + 4, 6, max(6, H - dh - 6));

  g_box_x = dx; g_box_y = dy; g_box_w = dw; g_box_h = dh;

  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = dark ? 0.45 : 0.16; l_rect(dx + 2, dy + 3, dw, dh);
  gfx_r = pn_r; gfx_g = pn_g; gfx_b = pn_b; gfx_a = 0.98; l_rect(dx, dy, dw, dh);
  gfx_r = acc_r; gfx_g = acc_g; gfx_b = acc_b; gfx_a = 0.95; l_frame(dx, dy, dw, dh);

  col_w = (dw - 14 - (ncols - 1) * 6) / ncols;
  i_row = 0;

  // 0: TARGET +/- 0.5
  c_x = dx + 7; c_y = dy + 5;
  l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; l_txt(c_x, c_y + 3, "TARGET");
  draw_btn(c_x + col_w - 112, c_y, 24, rh, "-", 10, 0, acc_r, acc_g, acc_b, 1) ? ( set_sl(39, clamp(cfg_lufs_red - 0.5, -40, 0)); has_click = 0; );
  sprintf(#_gv, "%.1f", cfg_lufs_red);
  l_font(3, 10, 'b'); gfx_r = txt_r; gfx_g = txt_g; gfx_b = txt_b; gfx_a = 1; l_txtc(c_x + col_w - 56, c_y + 3, #_gv);
  draw_btn(c_x + col_w - 24, c_y, 24, rh, "+", 10, 0, acc_r, acc_g, acc_b, 1) ? ( set_sl(39, clamp(cfg_lufs_red + 0.5, -40, 0)); has_click = 0; );

  // 1: TOLL ±LU
  i_row += 1; c_x = dx + 7 + (i_row % ncols) * (col_w + 6); c_y = dy + 5 + floor(i_row / ncols) * (rh + gap_y);
  l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; l_txt(c_x, c_y + 3, "TOLL ±LU");
  sprintf(#_gv, "±%.1f LU", cfg_tol_lu);
  draw_btn(c_x + col_w - 92, c_y, 92, rh, #_gv, 9.5, 1, grn_r, grn_g, grn_b, 1) ? (
    tol_next = cfg_tol_lu < 0.7 ? 1.0 : cfg_tol_lu < 1.2 ? 1.5 : cfg_tol_lu < 1.7 ? 2.0 : cfg_tol_lu < 2.2 ? 2.5 : 0.5;
    set_sl(44, tol_next); has_click = 0;
  );

  // 2: TP RED +/- 0.5 & clic per scrivere
  i_row += 1; c_x = dx + 7 + (i_row % ncols) * (col_w + 6); c_y = dy + 5 + floor(i_row / ncols) * (rh + gap_y);
  l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; l_txt(c_x, c_y + 3, "TP RED");
  draw_btn(c_x + col_w - 112, c_y, 24, rh, "-", 10, 0, red_r, red_g, red_b, 1) ? ( set_sl(37, clamp(cfg_tp_red - 0.5, -12, 0)); has_click = 0; );
  ref_edit == 7 ? sprintf(#_gv, "%s|", #ref_edit_buf) : sprintf(#_gv, "%.1f dB", cfg_tp_red);
  draw_btn(c_x + col_w - 86, c_y, 60, rh, #_gv, 9.5, ref_edit == 7, red_r, red_g, red_b, 1) ? (
    ref_edit = 7; #ref_edit_buf = ""; has_click = 0;
  );
  draw_btn(c_x + col_w - 24, c_y, 24, rh, "+", 10, 0, red_r, red_g, red_b, 1) ? ( set_sl(37, clamp(cfg_tp_red + 0.5, -12, 0)); has_click = 0; );

  // 3: METER SPEED
  i_row += 1; c_x = dx + 7 + (i_row % ncols) * (col_w + 6); c_y = dy + 5 + floor(i_row / ncols) * (rh + gap_y);
  l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; l_txt(c_x, c_y + 3, "METER");
  strcpy(#_gv, cfg_meter_response < 0.32 ? "FAST" : cfg_meter_response < 1.05 ? "MID" : "SLOW");
  draw_btn(c_x + col_w - 92, c_y, 92, rh, #_gv, 9.5, 1, acc_r, acc_g, acc_b, 1) ? (
    spd_next = cfg_meter_response < 0.32 ? 0.65 : cfg_meter_response < 1.05 ? 1.25 : 0.20;
    set_sl(41, spd_next); has_click = 0;
  );

  // 4: PLAY RST
  i_row += 1; c_x = dx + 7 + (i_row % ncols) * (col_w + 6); c_y = dy + 5 + floor(i_row / ncols) * (rh + gap_y);
  l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; l_txt(c_x, c_y + 3, "PLAY RST");
  draw_btn(c_x + col_w - 92, c_y, 92, rh, cfg_reinit ? "ON" : "OFF", 9.5, cfg_reinit, grn_r, grn_g, grn_b, 1) ? (
    set_sl(11, !cfg_reinit); has_click = 0;
  );

  // 5: AUTO RST STOP
  i_row += 1; c_x = dx + 7 + (i_row % ncols) * (col_w + 6); c_y = dy + 5 + floor(i_row / ncols) * (rh + gap_y);
  l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; l_txt(c_x, c_y + 3, "AUTO RST");
  draw_btn(c_x + col_w - 92, c_y, 92, rh, cfg_clip_reset_stop ? "STOP: ON" : "STOP: OFF", 9.5, cfg_clip_reset_stop, grn_r, grn_g, grn_b, 1) ? (
    set_sl(20, !cfg_clip_reset_stop); has_click = 0;
  );

  // 6: MONO / ST
  i_row += 1; c_x = dx + 7 + (i_row % ncols) * (col_w + 6); c_y = dy + 5 + floor(i_row / ncols) * (rh + gap_y);
  l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; l_txt(c_x, c_y + 3, msg("ANALISI", "INPUT"));
  draw_btn(c_x + col_w - 92, c_y, 92, rh, cfg_mono ? "MONO (-3 LU)" : "STEREO / MCH", 9, cfg_mono, amb_r, amb_g, amb_b, 1) ? (
    set_sl(12, !cfg_mono); has_click = 0;
  );

  // 7: DERIVA 60s
  i_row += 1; c_x = dx + 7 + (i_row % ncols) * (col_w + 6); c_y = dy + 5 + floor(i_row / ncols) * (rh + gap_y);
  l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; l_txt(c_x, c_y + 3, "DERIVA 60s");
  draw_btn(c_x + col_w - 92, c_y, 92, rh, cfg_show_history >= 0.5 ? "ON" : "OFF", 9.5, cfg_show_history >= 0.5, grn_r, grn_g, grn_b, 1) ? (
    set_sl(45, cfg_show_history >= 0.5 ? 0 : 1); has_click = 0;
  );

  // 8: TEMA (etichetta orientata all'azione: dice a quale tema passi premendolo)
  i_row += 1; c_x = dx + 7 + (i_row % ncols) * (col_w + 6); c_y = dy + 5 + floor(i_row / ncols) * (rh + gap_y);
  l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; l_txt(c_x, c_y + 3, msg("PASSA A", "SWITCH TO"));
  draw_btn(c_x + col_w - 92, c_y, 92, rh, cfg_theme >= 0.5 ? msg("CHIARO", "LIGHT") : msg("SCURO", "DARK"), 9.5, 0, acc_r, acc_g, acc_b, 1) ? (
    set_sl(43, cfg_theme >= 0.5 ? 0 : 1); has_click = 0;
  );

  // 9: CANALI (AUTO/ALL/BANKS/WORST/CLIPS)
  i_row += 1; c_x = dx + 7 + (i_row % ncols) * (col_w + 6); c_y = dy + 5 + floor(i_row / ncols) * (rh + gap_y);
  l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; l_txt(c_x, c_y + 3, msg("CANALI", "CH VIEW"));
  mode_next = floor(cfg_chan_view + 0.5);
  strcpy(#_gv, mode_next == 0 ? "AUTO" : mode_next == 1 ? "ALL" : mode_next == 2 ? "BANKS" : mode_next == 3 ? "WORST" : "CLIPS");
  draw_btn(c_x + col_w - 92, c_y, 92, rh, #_gv, 9.5, 0, acc_r, acc_g, acc_b, 1) ? (
    set_sl(18, (mode_next + 1) % 5); has_click = 0;
  );

  // 10: SLIDER OSARA
  i_row += 1; c_x = dx + 7 + (i_row % ncols) * (col_w + 6); c_y = dy + 5 + floor(i_row / ncols) * (rh + gap_y);
  l_font(4, 9, 'b'); gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 1; l_txt(c_x, c_y + 3, "OSARA");
  draw_btn(c_x + col_w - 92, c_y, 92, rh, sliders_showing ? msg("NASCONDI", "HIDE SLID") : msg("SLIDER JSFX", "SHOW SLID"), 9, sliders_showing, amb_r, amb_g, amb_b, 1) ? (
    sliders_showing = !sliders_showing;
    k = 1;
    loop(45,
      slider_show(2 ^ (k - 1), sliders_showing ? 1 : 0);
      k += 1;
    );
    has_click = 0;
  );
);

// ============================================================
// LETTURE CORRENTI E PEAK HOLD PER FRAME
// ============================================================
is_dark = cfg_theme >= 0.5;
set_palette(is_dark);

_hdr_lufs_i = (lufs_a_sum > 0 && lufs_i_db > -99) ? (cfg_mono ? lufs_i_db - 3 : lufs_i_db) : -150;
_hdr_lufs_s = (lufs_s_db > -99) ? (cfg_mono ? lufs_s_db - 3 : lufs_s_db) : -150;
_hdr_lufs_m = (lufs_m_db > -99) ? (cfg_mono ? lufs_m_db - 3 : lufs_m_db) : -150;
_hdr_tp     = (cfg_peak > 0 && global_peak > 0) ? (log(global_peak) * 20.0 / log(10.0)) : -150;
_hdr_rms_m  = (rms_m_db > -99) ? (cfg_mono ? rms_m_db - 3 : rms_m_db) : -150;

_hdr_lufs_i > -95 ? sprintf(#hdr_i, "%.1f", _hdr_lufs_i) : strcpy(#hdr_i, "--");
_hdr_lufs_s > -95 ? sprintf(#hdr_s, "%.1f", _hdr_lufs_s) : strcpy(#hdr_s, "--");
_hdr_lufs_m > -95 ? sprintf(#hdr_m, "%.1f", _hdr_lufs_m) : strcpy(#hdr_m, "--");
_hdr_tp     > -99 ? sprintf(#hdr_tp, "%.1f", _hdr_tp) : strcpy(#hdr_tp, cfg_peak > 0 ? "--" : "OFF");
_hdr_rms_m  > -95 ? sprintf(#hdr_rms_m, "%.1f", _hdr_rms_m) : strcpy(#hdr_rms_m, "--");
lra_db_diff > 0   ? sprintf(#hdr_lra, "%.1f LU", lra_db_diff) : strcpy(#hdr_lra, "--");

full_ch = cfg_mono ? 1 : max(num_ch, 2);
any_clip = 0;
_ci = 0;
loop(full_ch,
  _pv = pk[_ci];
  _cdb = (cfg_peak > 0 && _pv > 0) ? (log(_pv) * 20.0 / log(10.0)) : -150;
  _cdb >= ch_pk_hold[_ci] ? (
    ch_pk_hold[_ci] = _cdb;
    ch_pk_hold_t[_ci] = t;
  ) : (
    (t - ch_pk_hold_t[_ci] > 1.8) ? (
      ch_pk_hold[_ci] = max(_cdb, ch_pk_hold[_ci] - 14.0 * draw_dt);
    );
  );
  clip_cnt[_ci] > 0 ? ( any_clip += clip_cnt[_ci]; );
  _ci += 1;
);

// Keyboard input (ref_edit 7=TP RED, 8=TARGET LUFS; ESC chiude gear)
k_raw = gfx_getchar();
while (k_raw > 0) (
  k_raw == 44 ? ( k_raw = 46; );
  ref_edit > 0 ? (
    (k_raw == 13 || k_raw == 27) ? (
      (k_raw == 13 && strlen(#ref_edit_buf) > 0) ? (
        match("%f", #ref_edit_buf, ref_parsed) <= 0 ? ( ref_parsed = 0; );
        ref_edit == 7 ? set_sl(37, clamp(ref_parsed, -12.0, 0.0));
        ref_edit == 8 ? set_sl(39, clamp(floor(ref_parsed * 10.0 + 0.5) * 0.1, -40.0, 0.0));
      );
      ref_edit = 0; #ref_edit_buf = "";
    ) : (k_raw == 8 || k_raw == 127 || k_raw == 6579564) ? (
      strlen(#ref_edit_buf) > 0 ? str_setchar(#ref_edit_buf, strlen(#ref_edit_buf) - 1, 0);
    ) : (
      ((k_raw >= 48 && k_raw <= 57) || k_raw == 46 || (k_raw == 45 && strlen(#ref_edit_buf) == 0)) ? (
        strlen(#ref_edit_buf) < 7 ? str_setchar(#ref_edit_buf, strlen(#ref_edit_buf), k_raw);
      );
    );
  ) : (
    k_raw == 27 && gear_open ? ( gear_open = 0; );
  );
  k_raw = gfx_getchar();
);

!(mouse_cap & 1) ? ( ui_drag = 0; );

// Partizione delle 4 viste responsive
is_embedded = (gfx_ext_flags & 1) != 0;
is_strip    = !is_embedded && (W >= 460 && H < 220);
is_wide     = !is_embedded && !is_strip && (W >= 460 && W > H * 1.05);
is_side     = !is_embedded && !is_strip && !is_wide;

// Selezione canali visibili / banchi
chan_bank_size = (is_side && W < 280) ? 4 : 8;
chan_mode = floor(cfg_chan_view + 0.5);
chan_mode == 0 ? ( full_ch > chan_bank_size ? ( chan_mode = 2; ) : ( chan_mode = 1; ); );
chan_start = 0;
vis_ch = full_ch;
chan_mode == 2 ? (
  bank_i = floor(cfg_chan_bank + 0.5);
  chan_start = min(max(0, bank_i * chan_bank_size), max(0, full_ch - chan_bank_size));
  vis_ch = min(chan_bank_size, full_ch - chan_start);
) : (chan_mode == 3 || chan_mode == 4) ? (
  best_ch = 0; best_score = -1; _ci = 0;
  loop(full_ch,
    _score = chan_mode == 4 ? (clip_cnt[_ci] > 0 ? 1000 + pk[_ci] : pk[_ci]) : pk[_ci];
    _score > best_score ? ( best_score = _score; best_ch = _ci; );
    _ci += 1;
  );
  chan_start = floor(best_ch / chan_bank_size) * chan_bank_size;
  vis_ch = min(chan_bank_size, full_ch - chan_start);
);
vis_ch = max(1, vis_ch);

// Gestione isolata click sul cassetto impostazioni
gear_open && has_click ? (
  (!l_hit(g_box_x, g_box_y, g_box_w, g_box_h) && !l_hit(g_btn_x, g_btn_y, g_btn_w, g_btn_h)) ? (
    gear_open = 0;
    has_click = 0;
  );
);
ui_allow = !gear_open;

tgt = cfg_lufs_red;
tol = cfg_tol_lu;

// Sfondo finestra
gfx_r = bg_r; gfx_g = bg_g; gfx_b = bg_b; gfx_a = 1.0;
gfx_rect(0, 0, gfx_w, gfx_h);

// ============================================================
// VISTA 1: EMBEDDED TCP / MCP (con LUFS-I + TP + barre)
// ============================================================
is_embedded ? (
  gfx_ext_flags = gfx_ext_flags | 512;
  set_target_col(_hdr_lufs_i, tgt, tol); gfx_a = 0.95; l_rect(0, 0, W, max(2, H * 0.03));

  pad = max(2, min(4, floor(W * 0.04)));
  top_h = max(16, min(28, floor(H * 0.24)));
  bot_h = max(12, min(18, floor(H * 0.16)));
  emb_h = max(8, H - top_h - bot_h - pad);

  l_font(3, clamp(floor(W * 0.16), 8, 12), 'b');
  set_target_col(_hdr_lufs_i, tgt, tol); gfx_a = 1.0;
  l_txt(pad, 3, #hdr_i);

  W >= 54 ? (
    l_font(4, clamp(floor(W * 0.13), 7.5, 10.5), 'b');
    set_tp_col(_hdr_tp, any_clip > 0); gfx_a = 1.0;
    l_txtr(W - pad, 4, #hdr_tp);
  );

  // Barre verticali canali (+ piccola colonna LUFS-S a destra se W >= 56)
  si_w = W >= 56 ? max(5, floor(W * 0.12)) : 0;
  em_n = min(vis_ch, 8);
  em_w = max(6, W - pad * 2 - (si_w > 0 ? si_w + 3 : 0));
  em_gap = max(1, min(3, floor(em_w / 22)));
  em_bw = max(2, floor((em_w - (em_n - 1) * em_gap) / em_n));
  em_tot = em_n * em_bw + (em_n - 1) * em_gap;
  em_x = pad + floor((em_w - em_tot) * 0.5);

  _ei = 0;
  loop(em_n,
    _ch = chan_start + _ei;
    _pv = pk[_ch];
    _cdb = (cfg_peak > 0 && _pv > 0) ? (log(_pv) * 20.0 / log(10.0)) : -150;
    _nv = meter_db_to_norm(_cdb);
    _bx = em_x + _ei * (em_bw + em_gap);
    gfx_r = well_r; gfx_g = well_g; gfx_b = well_b; gfx_a = 1.0; l_rect(_bx, top_h, em_bw, emb_h);
    _nv > 0 ? (
      _cdb >= cfg_tp_red ? ( gfx_r = red_r; gfx_g = red_g; gfx_b = red_b; ) :
      _cdb >= cfg_tp_red - cfg_tp_yellow_margin ? ( gfx_r = amb_r; gfx_g = amb_g; gfx_b = amb_b; ) :
                                                  ( gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; );
      gfx_a = 0.95; l_rect(_bx, top_h + emb_h * (1.0 - _nv), em_bw, max(1, emb_h * _nv));
    );
    clip_cnt[_ch] > 0 ? ( gfx_r = red_r; gfx_g = red_g; gfx_b = red_b; gfx_a = 1.0; l_rect(_bx, top_h - 2, em_bw, 2); );
    _ei += 1;
  );

  // Linea TP RED nell'embedded
  gfx_r = red_r; gfx_g = red_g; gfx_b = red_b; gfx_a = 0.75;
  _eytp = top_h + emb_h * (1.0 - meter_db_to_norm(cfg_tp_red));
  l_line(em_x, _eytp, em_x + em_tot, _eytp);

  si_w > 0 ? (
    _sx = W - pad - si_w;
    gfx_r = well_r; gfx_g = well_g; gfx_b = well_b; gfx_a = 1.0; l_rect(_sx, top_h, si_w, emb_h);
    _ey0 = top_h + emb_h * (1.0 - lufs_col_norm(tgt + tol, tgt, 16.0, 8.0));
    _ey1 = top_h + emb_h * (1.0 - lufs_col_norm(tgt - tol, tgt, 16.0, 8.0));
    gfx_r = grn_r; gfx_g = grn_g; gfx_b = grn_b; gfx_a = 0.25; l_rect(_sx, _ey0, si_w, max(2, _ey1 - _ey0));
    _hdr_lufs_s > -95 ? (
      _sn = lufs_col_norm(_hdr_lufs_s, tgt, 16.0, 8.0);
      set_target_col(_hdr_lufs_s, tgt, tol); gfx_a = 0.95;
      l_rect(_sx + 1, top_h + emb_h * (1.0 - _sn), max(2, si_w - 2), max(1, emb_h * _sn));
    );
  );

  l_font(4, clamp(floor(H * 0.12), 7, 10), 0);
  gfx_r = sub_r; gfx_g = sub_g; gfx_b = sub_b; gfx_a = 0.95;
  sprintf(#_embs, "S %s", #hdr_s);
  l_txtc(W * 0.5, H - l_th() - 1, #_embs);
) :

// ============================================================
// VISTA 2: VERTICAL SIDE DOCK (PREDEFINITA ANTI-DERIVA)
// ============================================================
is_side ? (
  pad = W < 220 ? 5 : 8;
  gap = W < 220 ? 4 : 6;
  iw = W - pad * 2;

  // Testata 30 px
  hdr_h = 30;
  gfx_r = pn_r; gfx_g = pn_g; gfx_b = pn_b; gfx_a = 1.0; l_rect(0, 0, W, hdr_h);
  gfx_r = acc_r; gfx_g = acc_g; gfx_b = acc_b; gfx_a = 0.95; l_rect(0, 0, W, 3);
  gfx_r = brd_r; gfx_g = brd_g; gfx_b = brd_b; gfx_a = 0.70; l_line(0, hdr_h, W, hdr_h);

  bw_h = 20; by_h = 6;
  hw_q = 20; hw_g = 22; hw_r = W < 220 ? 34 : 44;
  hx_q = W - pad - hw_q;
  hx_g = hx_q - 4 - hw_g;
  hx_r = hx_g - 4 - hw_r;
  W >= 246 ? (
    hw_d = 48; hx_d = hx_r - 4 - hw_d;
    ui_allow && l_hit(hx_d, by_h, hw_d, bw_h) ? (
      tip_active = 1;
      #tip_msg = msg("DERIVA: attiva/nasconde il grafico storico 60s (LUFS-S vs Target).",
                     "DRIFT: show/hide the 60s history graph (LUFS-S vs Target).");
    );
    draw_btn(hx_d, by_h, hw_d, bw_h, msg("DERIVA", "DRIFT"), 8, cfg_show_history >= 0.5, grn_r, grn_g, grn_b, ui_allow) ? (
      set_sl(45, cfg_show_history >= 0.5 ? 0 : 1); has_click = 0;
    );
  );
  draw_rst_btn(hx_r, by_h, hw_r, bw_h, ui_allow, is_dark);
  draw_gear_btn(hx_g, by_h, hw_g, bw_h, ui_allow, is_dark);
  draw_help_btn(hx_q, by_h, hw_q, bw_h, ui_allow, is_dark);

  l_font(3, W < 220 ? 11 : 12, 'b');
  gfx_r = txt_r; gfx_g = txt_g; gfx_b = txt_b; gfx_a = 1.0;
  l_txt(pad, 9, W < 275 ? "ZP LUFS" : "ZP LOUDNESS");

  // Barra Target libero + SEGUI QUI + Rotore 9 scatti (-24 / -21 / -18 / -16 / -14 / -12 / -10 / -8 / -6)
  tgt_y = hdr_h + 5;
  tgt_h = 66;
  gfx_r = pn_r; gfx_g = pn_g; gfx_b = pn_b; gfx_a = 1.0; l_rect(pad, tgt_y, iw, tgt_h);
  gfx_r = brd_r; gfx_g = brd_g; gfx_b = brd_b; gfx_a = 0.80; l_frame(pad, tgt_y, iw, tgt_h);

  tp_w = floor((iw - 12) * 0.57);
  lk_w = iw - 12 - tp_w;
  draw_target_pill(pad + 4, tgt_y + 4, tp_w, 21, tgt, ui_allow, is_dark);
  draw_lock_btn(pad + 8 + tp_w, tgt_y + 4, lk_w, 21, ui_allow, is_dark);

  // Rotore a scatti discreti (-24..-6 LUFS)
  draw_target_rotor(pad + 4, tgt_y + 28, iw - 8, 34, tgt, ui_allow, is_dark);

  // Card Hero LUFS-I (scala con altezza finestra)
  hero_y = tgt_y + tgt_h + gap;
  hero_h = H < 460 ? 60 : clamp(floor(H * 0.16), 72, 132);
  draw_hero_card(pad, hero_y, iw, hero_h, _hdr_lufs_i, tgt, tol, is_dark, H < 460);

  // Griglia 2x2 sempre visibile (LUFS-S, TRUE PK, LUFS-M, LRA)
  stat_y = hero_y + hero_h + gap;
  stat_h = H < 460 ? 34 : clamp(floor(H * 0.092), 38, 82);
  cw2 = (iw - gap) * 0.5;
  set_target_col(_hdr_lufs_s, tgt, tol); scr = gfx_r; scg = gfx_g; scb = gfx_b;
  draw_stat_card(pad, stat_y, cw2, stat_h, "LUFS-S", #hdr_s, scr, scg, scb, "", 0, 0, 0, 0, is_dark);

  set_tp_col(_hdr_tp, any_clip > 0); tcr = gfx_r; tcg = gfx_g; tcb = gfx_b;
  ui_allow && l_hit(pad + cw2 + gap, stat_y, cw2, stat_h) ? (
    tip_active = 1;
    #tip_msg = msg("TRUE PK: clicca qui per azzerare solo picchi massimi e clip senza perdere LUFS-I.",
                   "TRUE PK: click here to clear peaks & clips without resetting LUFS-I.");
  );
  draw_stat_card(pad + cw2 + gap, stat_y, cw2, stat_h, "TRUE PK", #hdr_tp, tcr, tcg, tcb, any_clip > 0 ? "CLIP" : "", red_r, red_g, red_b, ui_allow, is_dark) ? (
    reset_peaks_only(); has_click = 0;
  );

  stat_y2 = stat_y + stat_h + gap;
  set_target_col(_hdr_lufs_m, tgt, tol); mcr = gfx_r; mcg = gfx_g; mcb = gfx_b;
  draw_stat_card(pad, stat_y2, cw2, stat_h, "LUFS-M", #hdr_m, mcr, mcg, mcb, "", 0, 0, 0, 0, is_dark);
  draw_stat_card(pad + cw2 + gap, stat_y2, cw2, stat_h, "LRA", #hdr_lra, acc_r, acc_g, acc_b, "", 0, 0, 0, 0, is_dark);

  // Pozzo meter verticali + Nastro Deriva 60s
  vm_y = stat_y2 + stat_h + gap;
  show_hist_s = cfg_show_history >= 0.5 && (H - vm_y) >= 180;
  hist_h = show_hist_s ? clamp(floor((H - vm_y - pad - gap) * 0.36), 72, 134) : 0;
  vm_h = max(68, H - vm_y - pad - (show_hist_s ? hist_h + gap : 0));

  draw_v_meters(pad, vm_y, iw, vm_h, vis_ch, chan_start, full_ch, tgt, tol, _hdr_lufs_s, _hdr_lufs_i, is_dark, ui_allow);

  show_hist_s ? (
    draw_history_ribbon(pad, vm_y + vm_h + gap, iw, hist_h, tgt, tol, _hdr_lufs_i, is_dark, 8.0, W >= 230 && hist_h >= 88);
  );
) :

// ============================================================
// VISTA 3: BARRA ORIZZONTALE BASSA (CONSOLE STRIP)
// ============================================================
is_strip ? (
  pad = 6; gap = 6;
  hdr_h = 28;
  gfx_r = pn_r; gfx_g = pn_g; gfx_b = pn_b; gfx_a = 1.0; l_rect(0, 0, W, hdr_h);
  gfx_r = acc_r; gfx_g = acc_g; gfx_b = acc_b; gfx_a = 0.95; l_rect(0, 0, W, 3);
  gfx_r = brd_r; gfx_g = brd_g; gfx_b = brd_b; gfx_a = 0.70; l_line(0, hdr_h, W, hdr_h);

  l_font(3, 11, 'b'); gfx_r = txt_r; gfx_g = txt_g; gfx_b = txt_b; gfx_a = 1.0;
  l_txt(pad + 2, 7.5, "ZP LOUDNESS");

  // Pulsanti destra
  draw_help_btn(W - pad - 20, 4, 20, 20, ui_allow, is_dark);
  draw_gear_btn(W - pad - 44, 4, 20, 20, ui_allow, is_dark);
  draw_rst_btn(W - pad - 88, 4, 40, 20, ui_allow, is_dark);

  // Target + SEGUI QUI + rotore 9 scatti in testata
  sx = pad + 96;
  draw_target_pill(sx, 4, 92, 20, tgt, ui_allow, is_dark);
  draw_lock_btn(sx + 96, 4, 72, 20, ui_allow, is_dark);
  sx += 174;
  W >= 540 ? (
    draw_target_rotor(sx, 4, 134, 20, tgt, ui_allow, is_dark);
  );

  // Corpo console strip
  cy = hdr_h + 5; ch = max(44, H - cy - 5);
  hw_s = clamp(floor(W * 0.27), 150, 310);
  draw_hero_card(pad, cy, hw_s, ch, _hdr_lufs_i, tgt, tol, is_dark, ch < 62);

  sw_blk = clamp(floor(W * 0.36), 190, 440);
  sx0 = pad + hw_s + gap;
  cw4 = (sw_blk - gap) * 0.5;
  sh2 = (ch - 4) * 0.5;
  set_target_col(_hdr_lufs_s, tgt, tol);
  draw_stat_card(sx0, cy, cw4, sh2, "LUFS-S", #hdr_s, gfx_r, gfx_g, gfx_b, "", 0, 0, 0, 0, is_dark);
  set_tp_col(_hdr_tp, any_clip > 0);
  draw_stat_card(sx0 + cw4 + gap, cy, cw4, sh2, "TRUE PK", #hdr_tp, gfx_r, gfx_g, gfx_b, any_clip > 0 ? "CLIP" : "", red_r, red_g, red_b, ui_allow, is_dark) ? (
    reset_peaks_only(); has_click = 0;
  );
  set_target_col(_hdr_lufs_m, tgt, tol);
  draw_stat_card(sx0, cy + sh2 + 4, cw4, sh2, "LUFS-M", #hdr_m, gfx_r, gfx_g, gfx_b, "", 0, 0, 0, 0, is_dark);
  draw_stat_card(sx0 + cw4 + gap, cy + sh2 + 4, cw4, sh2, "LRA", #hdr_lra, acc_r, acc_g, acc_b, "", 0, 0, 0, 0, is_dark);

  hx0 = sx0 + sw_blk + gap;
  hw_m = max(80, W - pad - hx0);
  draw_h_meters(hx0, cy, hw_m, ch, vis_ch, chan_start, full_ch, tgt, tol, _hdr_lufs_s, _hdr_lufs_i, is_dark, ui_allow);
) :

// ============================================================
// VISTA 4: STUDIO LARGA (NUMERI + STORICO + METERS)
// ============================================================
(
  pad = 8; gap = 8;
  hdr_h = 34;
  gfx_r = pn_r; gfx_g = pn_g; gfx_b = pn_b; gfx_a = 1.0; l_rect(0, 0, W, hdr_h);
  gfx_r = acc_r; gfx_g = acc_g; gfx_b = acc_b; gfx_a = 0.95; l_rect(0, 0, W, 3);
  gfx_r = brd_r; gfx_g = brd_g; gfx_b = brd_b; gfx_a = 0.72; l_line(0, hdr_h, W, hdr_h);

  l_font(3, 12.5, 'b'); gfx_r = txt_r; gfx_g = txt_g; gfx_b = txt_b; gfx_a = 1.0;
  l_txt(pad + 2, 10, "ZP LOUDNESS");

  // Controlli a destra
  draw_help_btn(W - pad - 22, 7, 22, 20, ui_allow, is_dark);
  draw_gear_btn(W - pad - 48, 7, 22, 20, ui_allow, is_dark);
  draw_rst_btn(W - pad - 96, 7, 44, 20, ui_allow, is_dark);
  thm_x = W - pad - 156;
  ui_allow && l_hit(thm_x, 7, 56, 20) ? (
    tip_active = 1;
    #tip_msg = is_dark ? msg("Clic per passare al tema CHIARO.", "Click to switch to LIGHT theme.") : msg("Clic per passare al tema SCURO.", "Click to switch to DARK theme.");
  );
  draw_btn(thm_x, 7, 56, 20, is_dark ? msg("CHIARO", "LIGHT") : msg("SCURO", "DARK"), 8.5, 0, acc_r, acc_g, acc_b, ui_allow) ? (
    set_sl(43, is_dark ? 0 : 1); has_click = 0;
  );
  drv_x = thm_x - 58;
  ui_allow && l_hit(drv_x, 7, 54, 20) ? (
    tip_active = 1;
    #tip_msg = msg("DERIVA: mostra o nasconde il grafico storico 60s (LUFS-S vs Target).",
                   "DRIFT: show or hide the 60s history graph (LUFS-S vs Target).");
  );
  draw_btn(drv_x, 7, 54, 20, msg("DERIVA", "DRIFT"), 8.5, cfg_show_history >= 0.5, grn_r, grn_g, grn_b, ui_allow) ? (
    set_sl(45, cfg_show_history >= 0.5 ? 0 : 1); has_click = 0;
  );

  // Target + SEGUI QUI in testata (il rotore 9 scatti sta fisso sopra la colonna sinistra, sempre visibile)
  sx = pad + 106;
  draw_target_pill(sx, 7, 102, 20, tgt, ui_allow, is_dark);
  draw_lock_btn(sx + 106, 7, 72, 20, ui_allow, is_dark);

  // Area contenuto: colonna sinistra FISSA (numeri stabili) + eventuale DERIVA + meter canali che si allargano
  cy = hdr_h + 8; ch = max(120, H - cy - 8);
  left_w = clamp(floor(min(248, W * 0.48)), 198, 248);
  right_min_w = clamp(vis_ch <= 2 ? 156 : 112 + vis_ch * 18, 150, floor((W - pad * 2 - left_w - gap * 2) * 0.60));
  show_hist_w = cfg_show_history >= 0.5 && (W - pad * 2 - left_w - right_min_w - gap * 2) >= 130;

  // Rotore target a 9 scatti fisso in cima alla colonna sinistra (-24 / -21 / -18 / -16 / -14 / -12 / -10 / -8 / -6)
  p5_h = 36;
  draw_target_rotor(pad, cy, left_w, p5_h, tgt, ui_allow, is_dark);

  // Colonna sinistra: Hero LUFS-I + griglia S/TP/M/LRA/RMS (larghezza fissa, mai galleggiante)
  cy_l = cy + p5_h + 5;
  ch_l = max(100, ch - p5_h - 5);
  hero_hw = H < 300 ? 60 : clamp(floor(ch_l * 0.30), 68, 108);
  draw_hero_card(pad, cy_l, left_w, hero_hw, _hdr_lufs_i, tgt, tol, is_dark, H < 300);
  sy_w = cy_l + hero_hw + 6;
  rem_h = ch_l - hero_hw - 6;
  row3_h = clamp(floor((rem_h - 12) / 3), 36, 68);
  cw_l = (left_w - 6) * 0.5;

  set_target_col(_hdr_lufs_s, tgt, tol);
  draw_stat_card(pad, sy_w, cw_l, row3_h, "LUFS-S", #hdr_s, gfx_r, gfx_g, gfx_b, "", 0, 0, 0, 0, is_dark);
  set_tp_col(_hdr_tp, any_clip > 0);
  ui_allow && l_hit(pad + cw_l + 6, sy_w, cw_l, row3_h) ? (
    tip_active = 1; #tip_msg = msg("TRUE PK: clicca per azzerare solo picchi/clip senza perdere LUFS-I.", "TRUE PK: click to clear peaks/clips without resetting LUFS-I.");
  );
  draw_stat_card(pad + cw_l + 6, sy_w, cw_l, row3_h, "TRUE PK", #hdr_tp, gfx_r, gfx_g, gfx_b, any_clip > 0 ? "CLIP" : "", red_r, red_g, red_b, ui_allow, is_dark) ? (
    reset_peaks_only(); has_click = 0;
  );

  sy_w += row3_h + 6;
  set_target_col(_hdr_lufs_m, tgt, tol);
  draw_stat_card(pad, sy_w, cw_l, row3_h, "LUFS-M", #hdr_m, gfx_r, gfx_g, gfx_b, "", 0, 0, 0, 0, is_dark);
  draw_stat_card(pad + cw_l + 6, sy_w, cw_l, row3_h, "LRA", #hdr_lra, acc_r, acc_g, acc_b, "", 0, 0, 0, 0, is_dark);

  sy_w += row3_h + 6;
  draw_stat_card(pad, sy_w, left_w, max(28, ch - (sy_w - cy)), "RMS-M", #hdr_rms_m, sub_r, sub_g, sub_b, "", 0, 0, 0, 0, is_dark);

  // Centro (Deriva opzionale) + Destra (Meter canali: unica zona che si allarga per multicanale)
  show_hist_w ? (
    mid_x = pad + left_w + gap;
    mid_w = W - pad * 2 - left_w - right_min_w - gap * 2;
    draw_history_ribbon(mid_x, cy, mid_w, ch, tgt, tol, _hdr_lufs_i, is_dark, 10.0, 1);
    draw_v_meters(W - pad - right_min_w, cy, right_min_w, ch, vis_ch, chan_start, full_ch, tgt, tol, _hdr_lufs_s, _hdr_lufs_i, is_dark, ui_allow);
  ) : (
    vm_x = pad + left_w + gap;
    draw_v_meters(vm_x, cy, W - pad - vm_x, ch, vis_ch, chan_start, full_ch, tgt, tol, _hdr_lufs_s, _hdr_lufs_i, is_dark, ui_allow);
  );
);

// Cassetto impostazioni overlay (sempre disegnato per ultimo)
gear_open && !is_embedded ? (
  draw_gear_drawer(g_btn_x + g_btn_w, g_btn_y + g_btn_h, is_dark, vis_ch, full_ch, is_strip);
);

// Avviso guida o tooltip fluttuante leggibile in basso (con ritorno a capo automatico)
(t < help_warn_until) ? (
  tip_active = 1;
  #tip_msg = msg("Apri Cue Navigator o la guida da ZP Studio Suite", "Open Cue Navigator or ZP Suite help");
);
!is_embedded && !gear_open && tip_active && strlen(#tip_msg) > 0 ? (
  draw_tooltip_box(W, H, #tip_msg, is_dark);
);

// ============================================================
// SERIALIZE — salva/carica versione serializzata nel progetto REAPER
// ============================================================
@serialize
file_var(0, _ser_ver);
_ser_ver != 1 ? _ser_ver = 1;
